.cook-container {
  padding-bottom: 200rpx;
}

.greet-card {
  background: linear-gradient(135deg, #FFF8F2 0%, #FFFFFF 100%);
  border: 2rpx solid #F4EFE6;
  margin-bottom: 20rpx;
}

.greet-title {
  font-size: 32rpx;
  color: #8C918D;
  margin-bottom: 12rpx;
}

.target-date-highlight {
  font-size: 44rpx;
  font-weight: 800;
  color: #E6683B;
  margin-bottom: 16rpx;
}

.cook-tag-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.cook-tag {
  background-color: #FDF1EA;
  color: #E6683B;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 大厨端双视图切换 Tab */
.cook-view-tabs {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F4EFE6;
}

.cook-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #7D827E;
  border-radius: 18rpx;
  transition: all 0.2s;
}

.cook-tab-active {
  background-color: #2C5E43;
  color: #FFFFFF;
}

/* 备注高亮大卡片 */
.notes-highlight-card {
  background-color: #FFFDF9;
  border: 2rpx solid #FADCB2;
  border-left: 10rpx solid #E6683B;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.notes-badge {
  font-size: 28rpx;
  font-weight: 700;
  color: #E6683B;
  margin-bottom: 10rpx;
}

.notes-content {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D312E;
  line-height: 1.5;
}

/* 菜品大字号卡片 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D312E;
  margin-bottom: 20rpx;
}

.dishes-big-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-big-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #FAF8F5;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid #F4EFE6;
}

.dish-num {
  width: 48rpx;
  height: 48rpx;
  background-color: #2C5E43;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.dish-big-thumb-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #F4EFE6;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.dish-big-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-big-emoji {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.dish-big-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D312E;
}

.dish-taste-label {
  font-size: 24rpx;
  color: #8C918D;
}

/* 买菜打勾清单 */
.shopping-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.check-tip {
  font-size: 24rpx;
  color: #2C5E43;
  font-weight: 600;
}

.check-list {
  display: flex;
  flex-direction: column;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #F4EFE6;
  transition: all 0.2s;
}

.check-item:last-child {
  border-bottom: none;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #D5CEBE;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  flex-shrink: 0;
}

.checkbox-symbol {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
}

.item-text-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}

.item-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2D312E;
}

.item-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #E6683B;
}

/* 已打勾状态 */
.item-checked {
  opacity: 0.45;
}

.item-checked .check-box {
  background-color: #2C5E43;
  border-color: #2C5E43;
}

.item-checked .item-name {
  text-decoration: line-through;
}

.warm-tip-box {
  background-color: #F4EFE6;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #6D736E;
  line-height: 1.5;
}

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.shopping-progress-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.progress-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.progress-label {
  font-size: 26rpx;
  color: #7D827E;
}

.progress-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C5E43;
}

.progress-btn {
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 18rpx 32rpx;
  margin: 0;
  line-height: 1.4;
}

.btn-copy-sm {
  background-color: #F4EFE6;
  color: #2C5E43;
  border: 2rpx solid #2C5E43;
}

.btn-all-done {
  background: linear-gradient(135deg, #3B7B58 0%, #2C5E43 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(44, 94, 67, 0.3);
}

.cook-bottom-bar {
  width: 100%;
}

.copy-btn {
  width: 100%;
  font-size: 32rpx;
  padding: 22rpx 0;
}
