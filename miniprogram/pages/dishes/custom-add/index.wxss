.custom-add-container {
  padding-bottom: 160rpx;
}

.banner-notice {
  background: #FDF9F0;
  border: 2rpx solid #F4EAD3;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #B5651D;
  margin-bottom: 8rpx;
}

.notice-desc {
  font-size: 22rpx;
  color: #7D7565;
  line-height: 1.5;
}

.form-card {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 36rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.group-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.group-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D312E;
  margin-bottom: 16rpx;
  display: block;
}

.char-count {
  font-size: 22rpx;
  color: #8C918D;
}

.input-name {
  background: #FAF8F5;
  border: 2rpx solid #EFEAE0;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2D312E;
}

/* 分类单选网格 */
.category-radio-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cat-radio-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FAF8F5;
  border: 2rpx solid #EFEAE0;
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  transition: all 0.2s;
}

.cat-radio-icon {
  font-size: 36rpx;
}

.cat-radio-label {
  font-size: 26rpx;
  color: #555A56;
}

.radio-active {
  background: #FFF8F2;
  border-color: #E6683B;
  box-shadow: 0 4rpx 12rpx rgba(230, 104, 59, 0.12);
}

.radio-active .cat-radio-label {
  color: #E6683B;
  font-weight: 600;
}

/* 口味多选 */
.taste-chips-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.taste-chip {
  padding: 12rpx 28rpx;
  background: #FAF8F5;
  border: 2rpx solid #EFEAE0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #555A56;
  transition: all 0.2s;
}

.taste-active {
  background: #FDF0ED;
  border-color: #E6683B;
  color: #E6683B;
  font-weight: 600;
}

/* 耗时选项 */
.time-radio-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.time-pill {
  text-align: center;
  background: #FAF8F5;
  border: 2rpx solid #EFEAE0;
  border-radius: 16rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #555A56;
  transition: all 0.2s;
}

.time-active {
  background: #FFF8F2;
  border-color: #E6683B;
  color: #E6683B;
  font-weight: 600;
}

/* 底部提交栏 */
.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx env(safe-area-inset-bottom);
  background: rgba(255, 253, 247, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-submit-dish {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
}
