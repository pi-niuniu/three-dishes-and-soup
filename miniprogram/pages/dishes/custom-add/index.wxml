<view class="container custom-add-container">
  <!-- 提示条幅：明确无图、生活美学自动匹配 -->
  <view class="banner-notice card">
    <view class="notice-title">💡 极简纯文字录入 · 零图片上传</view>
    <view class="notice-desc">输入菜名与分类，系统自动为您匹配精致生活美学餐盘插图与专属 Emoji，安全合规，全家同步。</view>
  </view>

  <!-- 表单内容 -->
  <view class="form-card card">
    <!-- 菜名输入 -->
    <view class="form-group">
      <view class="group-title-row">
        <text class="group-label">菜品名称</text>
        <text class="char-count">{{ dishName.length }}/20</text>
      </view>
      <input 
        class="input-name" 
        placeholder="例如：奶奶牌红烧土豆、大厨秘制蒜香排骨" 
        value="{{ dishName }}" 
        maxlength="20"
        bindinput="handleNameInput" 
      />
    </view>

    <!-- 分类单选 -->
    <view class="form-group">
      <text class="group-label">所属分类</text>
      <view class="category-radio-grid">
        <block wx:for="{{ categoryOptions }}" wx:key="key">
          <view 
            class="cat-radio-item {{ selectedCategory === item.key ? 'radio-active' : '' }}" 
            bindtap="selectCategory" 
            data-cat="{{ item.key }}"
          >
            <text class="cat-radio-icon">{{ item.icon }}</text>
            <text class="cat-radio-label">{{ item.label }}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 口味标签多选 -->
    <view class="form-group">
      <view class="group-title-row">
        <text class="group-label">口味特色 (最多选 3 个)</text>
      </view>
      <view class="taste-chips-grid">
        <block wx:for="{{ tasteOptions }}" wx:key="*this">
          <view 
            class="taste-chip {{ selectedTastes.includes(item) ? 'taste-active' : '' }}" 
            bindtap="toggleTaste" 
            data-taste="{{ item }}"
          >
            {{ item }}
          </view>
        </block>
      </view>
    </view>

    <!-- 制作耗时 -->
    <view class="form-group">
      <text class="group-label">预计烹饪耗时</text>
      <view class="time-radio-row">
        <block wx:for="{{ timeOptions }}" wx:key="minutes">
          <view 
            class="time-pill {{ selectedTime === item.minutes ? 'time-active' : '' }}" 
            bindtap="selectTime" 
            data-minutes="{{ item.minutes }}"
          >
            {{ item.label }}
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 底部提交按钮 -->
  <view class="bottom-submit-bar">
    <button 
      class="btn-submit-dish btn-primary" 
      disabled="{{ submitting || !dishName }}" 
      bindtap="handleSubmit"
    >
      确认保存至私房菜库
    </button>
  </view>
</view>
