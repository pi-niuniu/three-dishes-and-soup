/* 顶部精美生活美学品牌导航栏 */
.custom-nav-bar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: rgba(255, 253, 247, 0.96);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(244, 239, 230, 0.6);
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.brand-capsule {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #FFFFFF 0%, #FDFBF7 100%);
  border: 2rpx solid #F0EAE1;
  border-radius: 44rpx;
  padding: 10rpx 24rpx 10rpx 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(215, 185, 145, 0.16);
  transition: transform 0.2s ease;
}

.brand-pot-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(230, 104, 59, 0.25));
}

.brand-text-box {
  display: inline-flex;
  align-items: center;
}

.brand-part-one {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E2320;
  letter-spacing: 2rpx;
}

.brand-part-dot {
  font-size: 32rpx;
  font-weight: 900;
  color: #E6683B;
  margin: 0 8rpx;
}

.brand-part-two {
  font-size: 32rpx;
  font-weight: 700;
  color: #E6683B;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(230, 104, 59, 0.15);
}

.brand-sparkle {
  font-size: 26rpx;
  margin-left: 10rpx;
}

.custom-nav-container {
  padding-top: 20rpx !important;
}

.season-hero {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAF6EE 100%);
  border: 2rpx solid #F4EFE6;
}

.season-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.season-badge {
  background-color: #E6683B;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.region-text {
  font-size: 24rpx;
  color: #8C918D;
}

.season-slogan {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E2320;
  margin-bottom: 24rpx;
  line-height: 1.45;
  letter-spacing: 1.2rpx;
}

.seasonal-box {
  background-color: rgba(255, 255, 255, 0.85);
  border-radius: 20rpx;
  padding: 20rpx;
}

.seasonal-title {
  font-size: 24rpx;
  color: #2C5E43;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.ingredient-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ing-tag {
  background-color: #EAF3EC;
  color: #2C5E43;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 日期切换 */
.date-section {
  margin-top: 8rpx;
}

.date-tabs {
  display: flex;
  gap: 16rpx;
}

.date-tab {
  flex: 1;
  background-color: #FAF8F5;
  border: 2rpx solid #F4EFE6;
  border-radius: 24rpx;
  padding: 20rpx 16rpx;
  transition: all 0.2s ease;
}

.date-active {
  background-color: #FFF8F2;
  border-color: #E6683B;
  box-shadow: 0 4rpx 12rpx rgba(230, 104, 59, 0.16);
}

.date-tab-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E2320;
  margin-bottom: 6rpx;
  letter-spacing: 0.8rpx;
}

.date-active .date-tab-title {
  color: #E6683B;
}

.date-tab-sub {
  font-size: 22rpx;
  color: #7D827E;
  letter-spacing: 0.4rpx;
}

/* 模式选择 */
.mode-section {
  margin-top: 8rpx;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #555A56;
}

.portion-badge {
  font-size: 22rpx;
  color: #E6683B;
  background-color: #FDF1EA;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.mode-grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.mode-card {
  background-color: #FAF8F5;
  border: 2rpx solid #F4EFE6;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.mode-active {
  background-color: #FFF8F2;
  border-color: #E6683B;
  box-shadow: 0 4rpx 12rpx rgba(230, 104, 59, 0.16);
}

.mode-combo {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E2320;
  margin-bottom: 8rpx;
  letter-spacing: 0.8rpx;
}

.mode-active .mode-combo {
  color: #E6683B;
}

.mode-desc {
  font-size: 22rpx;
  color: #7D827E;
  line-height: 1.4;
  letter-spacing: 0.4rpx;
}

.portion-explain {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #6E7470;
  background-color: #F4EFE6;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* 操作区 */
.action-section {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-roll-btn {
  width: 94%;
  font-size: 36rpx;
  letter-spacing: 2rpx;
  padding: 26rpx 0;
}

.sub-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8C918D;
  text-align: center;
}
