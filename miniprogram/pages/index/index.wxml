<!-- 顶部精美生活美学品牌导航栏 -->
<view class="custom-nav-bar" style="padding-top: {{ statusBarHeight }}px;">
  <view class="custom-nav-inner" style="height: {{ navBarHeight }}px;">
    <view class="nav-brand-group">
      <view class="brand-capsule">
        <text class="brand-pot-icon">🍲</text>
        <view class="brand-text-box">
          <text class="brand-part-one">四季三餐</text>
          <text class="brand-part-dot">·</text>
          <text class="brand-part-two">好好吃饭</text>
        </view>
        <text class="brand-sparkle">🌱</text>
      </view>
      <text class="nav-greeting-sub">{{ greetingText }}</text>
    </view>
    <view class="season-pill-badge">
      <text class="pill-region">川渝食令</text>
      <text class="pill-dot">·</text>
      <text class="pill-term">{{ seasonName }}季</text>
    </view>
  </view>
</view>

<view class="container custom-nav-container">
  <!-- 1. 节气美学看板卡片 -->
  <view class="season-hero card">
    <view class="season-watermark-seal">
      <text class="seal-char">{{ seasonName }}</text>
    </view>
    
    <view class="season-header">
      <view class="season-badge">{{ currentMonthText }}金秋 · {{ seasonName }}</view>
      <view class="solar-term-tag">{{ solarTermText }}</view>
    </view>

    <view class="season-slogan">“顺时而食，每天配一桌可口家常菜”</view>
    <view class="season-sub-desc">初秋燥气渐生，烹制讲究温润养胃，多选时蔬脆藕与清甜瓜果。</view>
    
    <!-- 当季优选食材气泡流 -->
    <view class="seasonal-box">
      <view class="seasonal-box-header">
        <text class="seasonal-title">🌿 当季鲜润食材推荐：</text>
        <text class="seasonal-tip">时令新鲜 · 菜市优选</text>
      </view>
      <view class="ingredient-tags">
        <block wx:for="{{ seasonalIngredients }}" wx:key="id">
          <view class="ing-tag">
            <text class="ing-emoji">{{ item.emoji }}</text>
            <text class="ing-name">{{ item.name }}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 2. 【全新亮点】今日主厨灵感尝鲜 (高清实拍大图横滑流) -->
  <view class="inspiration-section card">
    <view class="inspiration-header">
      <view class="inspiration-title-wrap">
        <text class="inspire-sparkle">✨</text>
        <text class="inspire-title">今日灵感尝鲜 · 抢先预览</text>
        <text class="inspire-hot-badge">当季热选</text>
      </view>
      <text class="inspire-scroll-tip">左右滑动 ➔</text>
    </view>

    <scroll-view class="inspiration-scroll" scroll-x="true" enable-flex="true">
      <block wx:for="{{ inspirationDishes }}" wx:key="id">
        <view 
          class="inspire-card {{ pinnedDishId === item.id ? 'inspire-card-pinned' : '' }}" 
          bindtap="openDishPreview" 
          data-id="{{ item.id }}"
        >
          <view class="inspire-thumb-wrap">
            <image 
              class="inspire-thumb" 
              src="{{ item.thumbUrl }}" 
              mode="aspectFill" 
              lazy-load="true"
            />
            <view class="inspire-role-badge">{{ item.categoryName }}</view>
            <view wx:if="{{ pinnedDishId === item.id }}" class="inspire-pinned-badge">
              <text>✨ 已指定排入</text>
            </view>
          </view>
          <view class="inspire-meta">
            <view class="inspire-name">{{ item.name }}</view>
            <view class="inspire-sub-row">
              <text class="inspire-taste">{{ item.tasteText }}</text>
              <text class="inspire-time">{{ item.cookingTimeMinutes }}min</text>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 3. 就餐安排时间 (生活感备餐日程) -->
  <view class="date-section card">
    <view class="section-header-row">
      <view class="section-title">用餐安排时间</view>
      <view class="schedule-tip">💡 提前排餐，留足采买时间</view>
    </view>

    <view class="date-tabs">
      <view 
        class="date-tab {{ targetDay === 'tomorrow' ? 'date-active' : '' }}" 
        bindtap="switchTargetDay" 
        data-day="tomorrow"
      >
        <view class="date-tab-header">
          <text class="date-tab-main-title">📅 明天做饭</text>
          <text class="date-tab-tag">推荐</text>
        </view>
        <view class="date-tab-date">{{ tomorrowText }} · {{ tomorrowWeekText }}</view>
        <view class="date-tab-sub">提前发单，给大厨留足早市买菜时间</view>
      </view>

      <view 
        class="date-tab {{ targetDay === 'today' ? 'date-active' : '' }}" 
        bindtap="switchTargetDay" 
        data-day="today"
      >
        <view class="date-tab-header">
          <text class="date-tab-main-title">⚡ 今天做饭</text>
          <text class="date-tab-tag-normal">即时</text>
        </view>
        <view class="date-tab-date">{{ todayText }} · {{ todayWeekText }}</view>
        <view class="date-tab-sub">临时排餐，快手烹饪轻松享用</view>
      </view>
    </view>
  </view>

  <!-- 4. 视觉化餐盘模式矩阵 (4大场景) -->
  <view class="mode-section card">
    <view class="section-header-row">
      <view class="section-title-wrap">
        <text class="section-title">用餐模式</text>
        <text class="section-sub-label">挑选心仪餐盘组合</text>
      </view>
      <view class="portion-badge">🍲 2人午晚两餐足量</view>
    </view>
    
    <view class="mode-grid-2x2">
      <!-- 3菜1汤 (推荐) -->
      <view 
        class="mode-card {{ currentMode === 'hearty_3_1' ? 'mode-active' : '' }}" 
        bindtap="switchMode" 
        data-mode="hearty_3_1"
      >
        <view class="mode-card-top">
          <text class="mode-combo">3 菜 1 汤</text>
          <text class="mode-badge-rec">力荐</text>
        </view>
        <!-- 餐盘视觉化迷你图示 -->
        <view class="plate-visual-strip">
          <text class="plate-item">🥩大荤</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🍳小荤</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🥬素</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🥣汤</text>
        </view>
        <view class="mode-desc">荤素黄金比，全家营养均衡滋润</view>
      </view>

      <!-- 2菜1汤 -->
      <view 
        class="mode-card {{ currentMode === 'routine_2_1' ? 'mode-active' : '' }}" 
        bindtap="switchMode" 
        data-mode="routine_2_1"
      >
        <view class="mode-card-top">
          <text class="mode-combo">2 菜 1 汤</text>
          <text class="mode-badge-gray">精简</text>
        </view>
        <view class="plate-visual-strip">
          <text class="plate-item">🍗大荤</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🥗时蔬</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🥣靓汤</text>
        </view>
        <view class="mode-desc">省心清爽，两人食分量刚刚好</view>
      </view>

      <!-- 3个菜 (无汤) -->
      <view 
        class="mode-card {{ currentMode === 'three_dishes' ? 'mode-active' : '' }}" 
        bindtap="switchMode" 
        data-mode="three_dishes"
      >
        <view class="mode-card-top">
          <text class="mode-combo">3 个菜</text>
          <text class="mode-badge-gray">干香</text>
        </view>
        <view class="plate-visual-strip">
          <text class="plate-item">🥩大荤</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🍳副荤</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🥬清炒</text>
        </view>
        <view class="mode-desc">下饭干香菜品，无需耗时煲汤</view>
      </view>

      <!-- 3个炒菜 -->
      <view 
        class="mode-card {{ currentMode === 'three_stir_fries' ? 'mode-active' : '' }}" 
        bindtap="switchMode" 
        data-mode="three_stir_fries"
      >
        <view class="mode-card-top">
          <text class="mode-combo">3 个炒菜</text>
          <text class="mode-badge-gray">镬气</text>
        </view>
        <view class="plate-visual-strip">
          <text class="plate-item">🔥爆炒</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🍳家常</text>
          <text class="plate-plus">+</text>
          <text class="plate-item">🥬快手</text>
        </view>
        <view class="mode-desc">大火爆炒镬气足，20分钟快速出锅</view>
      </view>
    </view>
    
    <view class="portion-explain">
      <text class="explain-icon">💡</text>
      <text class="explain-text">大厨中午统一烧制，自动算足两人“午餐现吃 + 晚餐保温复热”的充沛分量，绿叶青菜建议午间吃完。</text>
    </view>
  </view>

  <!-- 5. 【全新亮点】今日调味微调胶囊 (可选微调) -->
  <view class="flavor-section card">
    <view class="section-header-row">
      <view class="section-title">今日调味倾向 (可选微调)</view>
      <view class="flavor-tip">智能纳入搭配推荐</view>
    </view>
    <view class="flavor-capsule-row">
      <view 
        class="flavor-capsule {{ selectedFlavor === 'classic_spicy' ? 'flavor-active' : '' }}" 
        bindtap="toggleQuickFlavor" 
        data-flavor="classic_spicy"
      >
        <text class="flavor-emoji">🌶️</text>
        <text class="flavor-text">川渝下饭·开胃</text>
      </view>
      <view 
        class="flavor-capsule {{ selectedFlavor === 'light_healthy' ? 'flavor-active' : '' }}" 
        bindtap="toggleQuickFlavor" 
        data-flavor="light_healthy"
      >
        <text class="flavor-emoji">🌿</text>
        <text class="flavor-text">清淡少油·低盐</text>
      </view>
      <view 
        class="flavor-capsule {{ selectedFlavor === 'warm_soup' ? 'flavor-active' : '' }}" 
        bindtap="toggleQuickFlavor" 
        data-flavor="warm_soup"
      >
        <text class="flavor-emoji">🥣</text>
        <text class="flavor-text">滋补润燥·暖胃</text>
      </view>
      <view 
        class="flavor-capsule {{ selectedFlavor === 'quick_speed' ? 'flavor-active' : '' }}" 
        bindtap="toggleQuickFlavor" 
        data-flavor="quick_speed"
      >
        <text class="flavor-emoji">⚡</text>
        <text class="flavor-text">30min快手做</text>
      </view>
    </view>
  </view>

  <!-- 6. 触发生成主行动按钮 -->
  <view class="action-section">
    <button class="btn-primary main-roll-btn" bindtap="handleGenerateMenu">
      <text class="btn-sparkle">✨</text>
      <text wx:if="{{ pinnedInspirationDish }}">生成包含【{{ pinnedInspirationDish.name }}】的【{{ targetDay === 'tomorrow' ? '明天' : '今天' }}】菜单</text>
      <text wx:else>生成【{{ targetDay === 'tomorrow' ? '明天' : '今天' }}】家常菜单</text>
    </button>
    <view class="action-sub-tips">
      <view class="tip-item">
        <text class="tip-icon">🔒</text>
        <text>单菜可锁定</text>
      </view>
      <text class="tip-dot">·</text>
      <view class="tip-item">
        <text class="tip-icon">🔄</text>
        <text>随时换一道</text>
      </view>
      <text class="tip-dot">·</text>
      <view class="tip-item">
        <text class="tip-icon">📲</text>
        <text>一键发大厨买菜</text>
      </view>
    </view>
  </view>
</view>

<!-- 菜品详情与置顶排餐弹窗 Modal -->
<view wx:if="{{ showDishModal }}" class="dish-modal-mask" bindtap="closeDishModal">
  <view class="dish-modal-content" catchtap="preventBubble">
    <view class="modal-dish-img-wrap">
      <image class="modal-dish-img" src="{{ previewDish.thumbUrl }}" mode="aspectFill" />
      <view class="modal-close-btn" bindtap="closeDishModal">✕</view>
      <view class="modal-dish-emoji">{{ previewDish.dishEmoji || '🍲' }}</view>
    </view>
    
    <view class="modal-dish-body">
      <view class="modal-title-row">
        <text class="modal-dish-name">{{ previewDish.name }}</text>
        <text class="modal-time-badge">⏱️ {{ previewDish.cookingTimeMinutes }}分钟</text>
      </view>
      
      <view class="modal-taste-tags">
        <text wx:for="{{ previewDish.taste }}" wx:key="*this" class="modal-taste-tag">{{ item }}</text>
        <text class="modal-method-tag">{{ previewDish.cookingMethod === 'stir_fry' ? '爆炒' : (previewDish.cookingMethod === 'boil_soup' ? '煲汤' : '家常') }}</text>
      </view>

      <view class="modal-ing-box">
        <view class="modal-ing-title">主要食材：</view>
        <view class="modal-ing-list">
          <text wx:for="{{ previewDish.ingredients }}" wx:key="name" class="modal-ing-chip">
            {{ item.name }} ({{ item.amount }}{{ item.unit }})
          </text>
        </view>
      </view>

      <view class="modal-action-row">
        <button 
          class="modal-pin-btn {{ pinnedDishId === previewDish.id ? 'btn-unpin' : 'btn-pin' }}" 
          bindtap="togglePinPreviewDish"
        >
          {{ pinnedDishId === previewDish.id ? '✕ 取消指定排餐' : '✨ 优先排入今日餐桌' }}
        </button>
      </view>
    </view>
  </view>
</view>
