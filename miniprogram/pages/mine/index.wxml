<view class="container mine-container">
  <!-- 4人家庭空间卡片 -->
  <view class="family-card card">
    <!-- 未加入家庭状态 -->
    <block wx:if="{{ !family }}">
      <view class="fam-empty-box">
        <view class="fam-header">
          <view class="fam-icon">🏡</view>
          <view class="fam-title-wrap">
            <view class="fam-title">家庭厨房空间</view>
            <view class="fam-sub">支持 1~4 人共享每日做菜历史与私房菜库</view>
          </view>
        </view>
        <view class="fam-actions">
          <view class="create-row">
            <input 
              class="fam-name-input" 
              placeholder="自定义厨房名称 (如：温馨小家食堂)" 
              value="{{ newFamilyNameInput }}" 
              bindinput="handleFamilyNameInput" 
              maxlength="15"
            />
            <button class="btn-create-fam" bindtap="handleCreateFamily">创建厨房</button>
          </view>
          <view class="divider-text">或输入家人分享的口令</view>
          <view class="join-row">
            <input 
              class="join-code-input" 
              type="number" 
              maxlength="6" 
              placeholder="输入 6 位家庭邀请口令" 
              value="{{ joinCodeInput }}" 
              bindinput="handleJoinCodeInput" 
            />
            <button class="btn-join-fam" bindtap="handleJoinFamily">加入厨房</button>
          </view>
        </view>
      </view>
    </block>

    <!-- 已绑定家庭状态 (上限 4 人) -->
    <block wx:else>
      <view class="fam-active-box">
        <view class="fam-header">
          <view class="fam-icon">🍳</view>
          <view class="fam-title-wrap">
            <view class="fam-title">{{ family.name || '温馨小家食堂' }}</view>
            <view class="fam-badge">家庭成员 ({{ family.members.length }}/4 人)</view>
          </view>
        </view>

        <!-- 成员头像列表 -->
        <view class="members-grid">
          <block wx:for="{{ family.members }}" wx:key="openid">
            <view class="member-chip">
              <view class="member-avatar">
                <text>{{ item.role === 'creator' ? '👨‍🍳' : '🥣' }}</text>
              </view>
              <view class="member-name">{{ item.nickName }}</view>
              <view wx:if="{{ item.role === 'creator' }}" class="role-tag">房主</view>
            </view>
          </block>
        </view>

        <!-- 邀请码与复制口令 -->
        <view class="invite-banner">
          <view class="invite-left">
            <text class="invite-label">动态邀请口令 (24小时有效)</text>
            <text class="invite-code">{{ family.inviteCode }}</text>
          </view>
          <view class="invite-actions">
            <button class="btn-copy-code" bindtap="handleCopyInviteCode">复制口令</button>
            <button wx:if="{{ currentUser.role === 'creator' }}" class="btn-refresh-code" bindtap="handleRefreshInviteCode">刷新</button>
          </view>
        </view>

        <view class="fam-bottom-bar">
          <text class="fam-leave-btn" bindtap="handleLeaveFamily">
            {{ currentUser.role === 'creator' ? '解散/退出家庭' : '退出家庭厨房' }}
          </text>
        </view>
      </view>
    </block>
  </view>

  <!-- 辣度偏好 -->
  <view class="setting-card card">
    <view class="card-title">🌶️ 辣度接受度</view>
    <view class="spicy-options">
      <block wx:for="{{ spicyLevels }}" wx:key="level">
        <view 
          class="spicy-pill {{ preferences.spicyLevel === item.level ? 'pill-active' : '' }}"
          bindtap="setSpicyLevel"
          data-level="{{ item.level }}"
        >
          {{ item.label }}
        </view>
      </block>
    </view>
  </view>

  <!-- 忌口与不吃食材 -->
  <view class="setting-card card">
    <view class="card-title">🚫 忌口食材（算法自动排除）</view>
    <view class="disliked-chips">
      <block wx:for="{{ commonAvoids }}" wx:key="*this">
        <view 
          class="avoid-chip {{ dislikedMap[item] ? 'avoid-active' : '' }}"
          bindtap="toggleAvoid"
          data-item="{{ item }}"
        >
          <text>{{ item }}</text>
          <text class="avoid-mark">{{ dislikedMap[item] ? '✓' : '+' }}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 默认开饭模式 -->
  <view class="setting-card card">
    <view class="card-title">🍲 默认餐桌模式</view>
    <view class="mode-select-grid">
      <block wx:for="{{ availableModes }}" wx:key="key">
        <view 
          class="mode-pill {{ preferences.defaultMode === item.key ? 'pill-active' : '' }}"
          bindtap="setDefaultMode"
          data-key="{{ item.key }}"
        >
          {{ item.name }}
        </view>
      </block>
    </view>
  </view>

  <!-- 数据管理与重置 -->
  <view class="setting-card card">
    <view class="card-title">⚙️ 数据管理</view>
    <view class="manage-row" bindtap="handleClearHistory">
      <text class="row-label">清空吃饭历史记录 (重新开始防重)</text>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 版本信息与版权声明 -->
  <view class="version-footer">
    <text class="version-text">四季三餐 · 好好吃饭 v{{ version }}</text>
    <text class="version-sub">精选 125 道家常料理 · 时令生鲜智能搭配</text>
  </view>
</view>
