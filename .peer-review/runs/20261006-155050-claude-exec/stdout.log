    }\n851\t\n852\t      return {\n853\t        success: true,\n854\t        family: {\n855\t          id: family._id || familyId,\n856\t          _id: family._id || familyId,\n857\t          ...family\n858\t        }\n859\t      };\n860\t    }\n861\t\n862\t    default:\n863\t      return { success: false, error: `不支持的操作类型: ${action}` };\n864\t  }"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"96fcf506-858a-4120-970b-a4ba3832ac83","timestamp":"2026-10-06T07:57:16.017Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","content":"        return { success: true, message: '已退出家庭厨房空间' };\n      });\n    }\n\n    /**\n     * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n     */\n    case 'refreshInviteCode': {\n      const { familyId } = event;\n      if (!familyId) return { success: false, error: '缺少 familyId' };\n\n      const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n      if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n      const family = famRes.data;\n      if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n        return { success: false, error: '无权操作非本人所属家庭' };\n      }\n\n      const newCode = await generateUniqueInviteCode();\n      const newExpiry = now + 24 * 60 * 60 * 1000;\n\n      await db.collection('families').doc(familyId).update({\n        data: {\n          inviteCode: newCode,\n          inviteExpiredAt: newExpiry,\n          updatedAt: now\n        }\n      });\n\n      return {\n        success: true,\n        inviteCode: newCode,\n        inviteExpiredAt: newExpiry\n      };\n    }\n\n    /**\n     * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n     */\n    case 'getFamily': {\n      const { familyId } = event;\n      if (!familyId) return { success: false, error: '缺少 familyId' };\n\n      const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n      if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n      const family = famRes.data;\n      if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n        return { success: false, error: '无权查看非本人所属家庭详情' };\n      }\n\n      return {\n        success: true,\n        family: {\n          id: family._id || familyId,\n          _id: family._id || familyId,\n          ...family\n        }\n      };\n    }\n\n    default:\n      return { success: false, error: `不支持的操作类型: ${action}` };\n  }","numLines":65,"startLine":800,"totalLines":950}}}
