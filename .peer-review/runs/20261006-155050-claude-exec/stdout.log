ut_tokens":1812,"cache_read_input_tokens":97337,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1812},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"ef5f34f4-c23a-4b04-9440-19d4cad74c6e","timestamp":"2026-10-06T07:56:07.966Z","request_id":"req_011CfkdDrFEWofK3YrqZTA4E","wire_tool_inputs":{"toolu_01VNYwxyTk2b97zvhA8Aah4j":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","old_string":"      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n    return {\n      success: false,\n      error: errMsg\n    };\n  }\n};","new_string":"      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n}\n\nfunction toErrorResult(err) {\n  const errMsg = typeof err === 'string' ? err : (err?.message || err?.errMsg || '家庭空间管理失败');\n  return {\n    success: false,\n    error: errMsg\n  };\n}\n\nexports.main = async (event, context) => {\n  await ensureCollections();\n\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  try {\n    return await handleAction(event, openid);\n  } catch (err) {\n    // 集合缺失（新环境 / 被误删）：强制自愈建表后重试一次，事务失败时无半途写入，重试安全\n    if (isCollectionNotExistError(err)) {\n      console.warn('[familyManage] 检测到集合不存在，自愈建表后重试:', err);\n      await ensureCollections(true);\n      try {\n        return await handleAction(event, openid);\n      } catch (retryErr) {\n        return toErrorResult(retryErr);\n      }\n    }\n    return toErrorResult(err);\n  }\n};"}}}
