{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Md6CMZKA4tWZ6FRBuhTGjt","type":"tool_result","content":"474\t     */\n475\t    case 'joinFamily': {\n476\t      // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n477\t      const rateLimitCheck = await checkJoinRateLimit(openid, now);\n478\t      if (!rateLimitCheck.allowed) {\n479\t        return { success: false, error: rateLimitCheck.error };\n480\t      }\n481\t\n482\t      const cleanCode = normalizeInviteCode(event.inviteCode);\n483\t      if (!cleanCode || cleanCode.length !== 6) {\n484\t        await recordJoinFailure(openid, now);\n485\t        return { success: false, error: '请输入正确的6位家庭邀请口令' };\n486\t      }\n487\t\n488\t      const memberNickName = (event.nickName || '家人').trim();\n489\t      const nickSec = await checkTextSecurity(memberNickName, openid);\n490\t      if (!nickSec.pass) return { success: false, error: nickSec.error };\n491\t\n492\t      // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n493\t      const codeStr = String(cleanCode);\n494\t      const codeNum = Number(cleanCode);\n495\t\n496\t      let matchedFamilies = [];\n497\t      let queryError = null;\n498\t\n499\t      try {\n500\t        const strRes = await db.collection('families').where({ inviteCode: codeStr }).get();\n501\t        if (strRes && strRes.data && strRes.data.length > 0) {\n502\t          matchedFamilies = matchedFamilies.concat(strRes.data);\n503\t        }\n504\t      } catch (err) {\n505\t        console.warn('[familyManage] 字符串口令查询异常:', err);\n506\t        queryError = err;\n507\t      }\n508\t\n509\t      if (!isNaN(codeNum)) {\n510\t        try {\n511\t          const numRes = await db.collection('families').where({ inviteCode: codeNum }).get();\n512\t          if (numRes && numRes.data && numRes.data.length > 0) {\n513\t            for (const doc of numRes.data) {\n514\t              const docId = doc._id || doc.id;\n515\t              if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n