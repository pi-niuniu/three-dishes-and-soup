{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UveuWvnxnD9Qpi8VAHd4X8","type":"tool_result","content":"264\tasync function handleAction(event, openid) {\n265\t  const { action } = event;\n266\t  const now = Date.now();\n267\t\n268\t  switch (action) {\n269\t    /**\n270\t     * 1. 创建家庭空间\n271\t     */\n272\t    case 'createFamily': {\n273\t      const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n274\t      const nickName = (event.nickName || '房主').trim();\n275\t\n276\t      // 安全合规校验：家庭名称与昵称\n277\t      const nameSec = await checkTextSecurity(familyName, openid);\n278\t      if (!nameSec.pass) return { success: false, error: nameSec.error };\n279\t\n280\t      const nickSec = await checkTextSecurity(nickName, openid);\n281\t      if (!nickSec.pass) return { success: false, error: nickSec.error };\n282\t\n283\t      // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n284\t      const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n285\t      let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n286\t        ? String(event.inviteCode).trim()\n287\t        : null;\n288\t      if (inviteCode) {\n289\t        const dupRes = await db.collection('families').where({\n290\t          inviteCode,\n291\t          inviteExpiredAt: _.gt(now)\n292\t        }).get().catch(() => null);\n293\t        if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n294\t          inviteCode = await generateUniqueInviteCode();\n295\t        }\n296\t      } else {\n297\t        inviteCode = await generateUniqueInviteCode();\n298\t      }\n299\t      const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n300\t        ? Number(event.inviteExpiredAt)\n301\t        : (now + 24 * 60 * 60 * 1000); // 24小时过期\n302\t\n303\t      return await db.runTransaction(async transaction => {\n304\t        const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n305\t        \n306\t        let user = null;\n307\t        try {\n308\t          const uRes = await userDocRef.get();\n309\t          user = (uRes && uRes.data) ? uRes.data : null;\n310\t        } catch (e) {\n311\t          if (isNotFoundError(e)) {\n312\t            user = null;\n313\t          } else {\n314\t            console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n315\t            throw e;\n316\t          }\n317\t        }\n318\t        if (!user) {\n319\t          user = { openid, nickName: nickName || '房主' };\n320\t        }\n321\t\n322\t        // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n323\t        if (user.familyId) {\n324\t          try {\n325\t            const oldFamilyId = user.familyId;\n326\t            const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n327\t            let oldFamRes = null;\n328\t            try {\n329\t              oldFamRes = await oldFamDocRef.get();\n330\t            } catch (famErr) {\n331\t              if (isNotFoundError(famErr)) {\n332\t                oldFamRes = null;\n333\t              } else {\n334\t                throw famErr;\n335\t              }\n336\t            }\n337\t            if (oldFamRes && oldFamRes.data) {\n338\t              const oldFamily = oldFamRes.data;\n339\t              const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n340\t              const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n341\t\n342\t              if (remainingMembers.length === 0) {\n343\t                await oldFamDocRef.remove();\n344\t              } else {\n345\t                let newCreatorOpenid = oldFamily.creatorOpenid;\n346\t                if (oldFamily.creatorOpenid === openid) {\n347\t                  newCreatorOpenid = remainingMembers[0].openid;\n348\t                  remainingMembers[0].role = 'creator';\n349\t                  await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n350\t                    data: { role: 'creator', updatedAt: now }\n351\t                  }).catch(() => {});\n352\t                }\n353\t\n354\t                await oldFamDocRef.update({\n355\t                  data: {\n356\t                    creatorOpenid: newCreatorOpenid,\n357\t                    members: remainingMembers,\n358\t                    memberOpenids: remainingOpenids,\n359\t                    updatedAt: now\n360\t                  }\n361\t                });\n362\t              }\n363\t            }\n364\t          } catch (e) {\n365\t            console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n366\t            throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n367\t          }\n368\t        }\n369\t\n370\t        const familyData = {\n371\t          id: familyId,\n372\t          name: familyName,\n373\t          creatorOpenid: openid,\n374\t          members: [\n375\t            {\n376\t              openid,\n377\t              nickName: nickName || user.nickName || '房主',\n378\t              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n379\t              role: 'creator',\n380\t              joinedAt: now\n381\t            }\n382\t          ],\n383\t          memberOpenids: [openid],\n384\t          inviteCode,\n385\t          inviteExpiredAt,\n386\t          createdAt: now,\n387\t          updatedAt: now\n388\t        };\n389\t\n390\t        // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n391\t        await transaction.collection('families').doc(familyId).set({ data: familyData });\n392\t\n393\t        // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n394\t        await transaction.collection('users').doc(`user_${openid}`).set({\n395\t          data: {\n396\t            openid,\n397\t            nickName: nickName || user.nickName || '房主',\n398\t            avatarUrl: event.avatarUrl || user.avatarUrl || '',\n399\t            familyId,\n400\t            role: 'creator',\n401\t            createdAt: (user && user.createdAt) || now,\n402\t            updatedAt: now\n403\t          }\n404\t        });\n405\t\n406\t        return {\n407\t          success: true,\n408\t          openid,\n409\t          family: {\n410\t            id: familyId,\n411\t            _id: familyId,\n412\t            ...familyData\n413\t          }\n414\t        };\n415\t      });\n416\t    }\n417\t\n418\t    /**\n419\t     * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n420\t     */\n421\t    case 'joinFamily': {\n422\t      // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n423\t      const rateLimitCheck = await checkJoinRateLimit(openid, now);\n424\t      if (!rateLimitCheck.allowed) {\n425\t        return { success: false, error: rateLimitCheck.error };\n426\t      }\n427\t\n428\t      const cleanCode = normalizeInviteCode(event.inviteCode);\n429\t      if (!cleanCode || cleanCode.length !== 6) {\n430\t        await recordJoinFailure(openid, now);\n431\t        return { success: false, error: '请输入正确的6位家庭邀请口令' };\n432\t      }\n433\t\n434\t      const memberNickName = (event.nickName || '家人').trim();\n435\t      const nickSec = await checkTextSecurity(memberNickName, openid);\n436\t      if (!nickSec.pass) return { success: false, error: nickSec.error };\n437\t\n438\t      // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n439\t      const codeStr = String(cleanCode);\n440\t      const codeNum = Number(cleanCode);\n441\t\n442\t      let matchedFamilies = [];\n443\t      let queryError = null;\n444\t\n445\t      try {\n446\t        const strRes = await db.collection('families').where({ inviteCode: codeStr }).get();\n447\t        if (strRes && strRes.data && strRes.data.length > 0) {\n448\t          matchedFamilies = matchedFamilies.concat(strRes.data);\n449\t        }\n450\t      } catch (err) {\n451\t        console.warn('[familyManage] 字符串口令查询异常:', err);\n452\t        queryError = err;\n453\t      }\n454\t\n455\t      if (!isNaN(codeNum)) {\n456\t        try {\n457\t          const numRes = await db.collection('families').where({ inviteCode: codeNum }).get();\n458\t          if (numRes && numRes.data && numRes.data.length > 0) {\n459\t            for (const doc of numRes.data) {\n460\t              const docId = doc._id || doc.id;\n461\t              if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n462\t                matchedFamilies.push(doc);\n463\t              }"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"480a71c8-29c4-45c0-ad6c-74119fa9f139","timestamp":"2026-10-06T07:56:16.202Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","content":"async function handleAction(event, openid) {\n  const { action } = event;\n  const now = Date.now();\n\n  switch (action) {\n    /**\n     * 1. 创建家庭空间\n     */\n    case 'createFamily': {\n      const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n      const nickName = (event.nickName || '房主').trim();\n\n      // 安全合规校验：家庭名称与昵称\n      const nameSec = await checkTextSecurity(familyName, openid);\n      if (!nameSec.pass) return { success: false, error: nameSec.error };\n\n      const nickSec = await checkTextSecurity(nickName, openid);\n      if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n      // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n      const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n      let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n        ? String(event.inviteCode).trim()\n        : null;\n      if (inviteCode) {\n        const dupRes = await db.collection('families').where({\n          inviteCode,\n          inviteExpiredAt: _.gt(now)\n        }).get().catch(() => null);\n        if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n          inviteCode = await generateUniqueInviteCode();\n        }\n      } else {\n        inviteCode = await generateUniqueInviteCode();\n      }\n      const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n        ? Number(event.inviteExpiredAt)\n        : (now + 24 * 60 * 60 * 1000); // 24小时过期\n\n      return await db.runTransaction(async transaction => {\n        const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n        \n        let user = null;\n        try {\n          const uRes = await userDocRef.get();\n          user = (uRes && uRes.data) ? uRes.data : null;\n        } catch (e) {\n          if (isNotFoundError(e)) {\n            user = null;\n          } else {\n            console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n            throw e;\n          }\n        }\n        if (!user) {\n          user = { openid, nickName: nickName || '房主' };\n        }\n\n        // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n        if (user.familyId) {\n          try {\n            const oldFamilyId = user.familyId;\n            const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n            let oldFamRes = null;\n            try {\n              oldFamRes = await oldFamDocRef.get();\n            } catch (famErr) {\n              if (isNotFoundError(famErr)) {\n                oldFamRes = null;\n              } else {\n                throw famErr;\n              }\n            }\n            if (oldFamRes && oldFamRes.data) {\n              const oldFamily = oldFamRes.data;\n              const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n              const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n\n              if (remainingMembers.length === 0) {\n                await oldFamDocRef.remove();\n              } else {\n                let newCreatorOpenid = oldFamily.creatorOpenid;\n                if (oldFamily.creatorOpenid === openid) {\n                  newCreatorOpenid = remainingMembers[0].openid;\n                  remainingMembers[0].role = 'creator';\n                  await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                    data: { role: 'creator', updatedAt: now }\n                  }).catch(() => {});\n                }\n\n                await oldFamDocRef.update({\n                  data: {\n                    creatorOpenid: newCreatorOpenid,\n                    members: remainingMembers,\n                    memberOpenids: remainingOpenids,\n                    updatedAt: now\n                  }\n                });\n              }\n            }\n          } catch (e) {\n            console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n            throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n          }\n        }\n\n        const familyData = {\n          id: familyId,\n          name: familyName,\n          creatorOpenid: openid,\n          members: [\n            {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n              role: 'creator',\n              joinedAt: now\n            }\n          ],\n          memberOpenids: [openid],\n          inviteCode,\n          inviteExpiredAt,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n        await transaction.collection('families').doc(familyId).set({ data: familyData });\n\n        // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n        await transaction.collection('users').doc(`user_${openid}`).set({\n          data: {\n            openid,\n            nickName: nickName || user.nickName || '房主',\n            avatarUrl: event.avatarUrl || user.avatarUrl || '',\n            familyId,\n            role: 'creator',\n            createdAt: (user && user.createdAt) || now,\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          openid,\n          family: {\n            id: familyId,\n            _id: familyId,\n            ...familyData\n          }\n        };\n      });\n    }\n\n    /**\n     * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n     */\n    case 'joinFamily': {\n      // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n      const rateLimitCheck = await checkJoinRateLimit(openid, now);\n      if (!rateLimitCheck.allowed) {\n        return { success: false, error: rateLimitCheck.error };\n      }\n\n      const cleanCode = normalizeInviteCode(event.inviteCode);\n      if (!cleanCode || cleanCode.length !== 6) {\n        await recordJoinFailure(openid, now);\n        return { success: false, error: '请输入正确的6位家庭邀请口令' };\n      }\n\n      const memberNickName = (event.nickName || '家人').trim();\n      const nickSec = await checkTextSecurity(memberNickName, openid);\n      if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n      // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n      const codeStr = String(cleanCode);\n      const codeNum = Number(cleanCode);\n\n      let matchedFamilies = [];\n      let queryError = null;\n\n      try {\n        const strRes = await db.collection('families').where({ inviteCode: codeStr }).get();\n        if (strRes && strRes.data && strRes.data.length > 0) {\n          matchedFamilies = matchedFamilies.concat(strRes.data);\n        }\n      } catch (err) {\n        console.warn('[familyManage] 字符串口令查询异常:', err);\n        queryError = err;\n      }\n\n      if (!isNaN(codeNum)) {\n        try {\n          const numRes = await db.collection('families').where({ inviteCode: codeNum }).get();\n          if (numRes && numRes.data && numRes.data.length > 0) {\n            for (const doc of numRes.data) {\n              const docId = doc._id || doc.id;\n              if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n                matchedFamilies.push(doc);\n              }","numLines":200,"startLine":264,"totalLines":885}}}
