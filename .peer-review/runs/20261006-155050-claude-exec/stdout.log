: column;\n  gap: 16rpx;\n}\n\n.create-row, .join-row {\n  display: flex;\n  gap: 12rpx;\n}\n\n.fam-name-input, .join-code-input {\n  flex: 1;\n  background: #FFF;\n  border: 2rpx solid #EFEAE0;\n  border-radius: 16rpx;\n  padding: 12rpx 20rpx;\n  font-size: 26rpx;\n  color: #2D312E;\n}\n\n.btn-create-fam, .btn-join-fam {\n  background: #2C5E43;\n  color: #FFF;\n  font-size: 24rpx;\n  font-weight: 600;\n  padding: 0 24rpx;\n  height: 68rpx;\n  line-height: 68rpx;\n  border-radius: 16rpx;\n  margin: 0;\n}\n\n.btn-join-fam {\n  background: #E6683B;\n}\n\n.divider-text {\n  text-align: center;\n  font-size: 20rpx;\n  color: #B5B9B6;\n  margin: 4rpx 0;\n}\n\n/* 成员头像网格 */\n.members-grid {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 20rpx;\n  margin-bottom: 24rpx;\n}\n\n.member-chip {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  position: relative;\n}\n\n.member-avatar {\n  width: 76rpx;\n  height: 76rpx;\n  border-radius: 50%;\n  background: #FFF;\n  border: 2rpx solid #EFEAE0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 40rpx;\n  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);\n}\n\n.member-name {\n  font-size: 20rpx;\n  color: #555A56;\n  margin-top: 8rpx;\n  max-width: 90rpx;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.role-tag {\n  position: absolute;\n  top: -8rpx;\n  right: -8rpx;\n  background: #E6683B;\n  color: #FFF;\n  font-size: 16rpx;\n  padding: 2rpx 8rpx;\n  border-radius: 8rpx;\n}\n\n/* 邀请码条幅 */\n.invite-banner {\n  background: #FFFDF8;\n  border: 2rpx dashed #E6DFD3;\n  border-radius: 16rpx;\n  padding: 16rpx 20rpx;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20rpx;\n}\n\n.invite-left {\n  display: flex;\n  flex-direction: column;\n}\n\n.invite-label {\n  font-size: 20rpx;\n  color: #8C918D;\n}\n\n.invite-code {\n  font-size: 34rpx;\n  font-weight: 700;\n  color: #2C5E43;\n  letter-spacing: 4rpx;\n}\n\n.invite-actions {\n  display: flex;\n  gap: 12rpx;\n}\n\n.btn-copy-code, .btn-refresh-code {\n  font-size: 22rpx;\n  padding: 8rpx 20rpx;\n  border-radius: 12rpx;\n  line-height: 1.5;\n  margin: 0;\n}\n\n.btn-copy-code {\n  background: #2C5E43;\n  color: #FFF;\n}\n\n.btn-refresh-code {\n  background: #FAF8F5;\n  color: #8C918D;\n  border: 1rpx solid #EFEAE0;\n}\n\n.fam-bottom-bar {\n  text-align: right;\n  padding-top: 8rpx;\n}\n\n.fam-leave-btn {\n  font-size: 22rpx;\n  color: #C0C4C1;\n  text-decoration: underline;\n}\n\n.user-card {\n  padding: 36rpx;\n  background: linear-gradient(135deg, #FFFFFF 0%, #FAF6EE 100%);\n  border: 2rpx solid #F4EFE6;\n}\n\n.user-info {\n  display: flex;\n  align-items: center;\n  gap: 24rpx;\n}\n\n.user-avatar {\n  font-size: 64rpx;\n  background-color: #F4EFE6;\n  width: 96rpx;\n  height: 96rpx;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.user-name {\n  font-size: 34rpx;\n  font-weight: 700;\n  color: #2D312E;\n  margin-bottom: 6rpx;\n}\n\n.user-sub {\n  font-size: 24rpx;\n  color: #8C918D;\n}\n\n.setting-card {\n  margin-bottom: 24rpx;\n}\n\n.card-title {\n  font-size: 28rpx;\n  font-weight: 600;\n  color: #555A56;\n  margin-bottom: 20rpx;\n}\n\n/* 辣度选项 */\n.spicy-options {\n  display: flex;\n  gap: 16rpx;\n}\n\n.spicy-pill {\n  flex: 1;\n  text-align: center;\n  background-color: #FAF8F5;\n  border: 2rpx solid #F4EFE6;\n  border-radius: 20rpx;\n  padding: 16rpx 0;\n  font-size: 26rpx;\n  color: #555A56;\n  transition: all 0.2s;\n}\n\n.pill-active {\n  background-color: #FFF8F2;\n  border-color: #E6683B;\n  color: #E6683B;\n  font-weight: 600;\n  box-shadow: 0 4rpx 12rpx rgba(230, 104, 59, 0.15);\n}\n\n/* 忌口标签 */\n.disliked-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16rpx;\n}\n\n.avoid-chip {\n  display: flex;\n  align-items: center;\n  gap: 8rpx;\n  background-color: #FAF8F5;\n  border: 1rpx solid #F4EFE6;\n  padding: 12rpx 24rpx;\n  border-radius: 30rpx;\n  font-size: 26rpx;\n  color: #555A56;\n}\n\n.avoid-active {\n  background-color: #FDF0ED;\n  border-color: #E6683B;\n  color: #E6683B;\n  font-weight: 600;\n}\n\n.avoid-mark {\n  font-size: 22rpx;\n}\n\n/* 模式网格 */\n.mode-select-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16rpx;\n}\n\n.mode-pill {\n  text-align: center;\n  background-color: #FAF8F5;\n  border: 2rpx solid #F4EFE6;\n  border-radius: 20rpx;\n  padding: 20rpx 0;\n  font-size: 28rpx;\n  color: #555A56;\n  transition: all 0.2s;\n}\n\n.mode-pill.pill-active {\n  background-color: #FFF8F2;\n  border-color: #E6683B;\n  color: #E6683B;\n  font-weight: 700;\n  box-shadow: 0 4rpx 12rpx rgba(230, 104, 59, 0.15);\n}\n\n/* 管理行 */\n.manage-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12rpx 0;\n}\n\n.row-label {\n  font-size: 28rpx;\n  color: #E6683B;\n}\n\n.row-arrow {\n  font-size: 36rpx;\n  color: #C0C4C1;\n}\n\n/* 版本与页脚声明 */\n.version-footer {\n  margin-top: 48rpx;\n  margin-bottom: 40rpx;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8rpx;\n}\n\n.version-text {\n  font-size: 24rpx;\n  font-weight: 500;\n  color: #8C918D;\n  letter-spacing: 1rpx;\n}\n\n.version-sub {\n  font-size: 20rpx;\n  color: #B5B9B6;\n  letter-spacing: 0.5rpx;\n}\n\n","structuredPatch":[{"oldStart":143,"oldLines":6,"newStart":143,"newLines":32,"lines":["   border-radius: 8rpx;"," }"," ","+/* 口令未同步云端提示 */","+.sync-warning {","+  background: #FFF4EE;","+  border: 2rpx solid #F5C9B3;","+  border-radius: 16rpx;","+  padding: 14rpx 20rpx;","+  display: flex;","+  justify-content: space-between;","+  align-items: center;","+  margin-bottom: 16rpx;","+}","+","+.sync-warning-text {","+  flex: 1;","+  font-size: 22rpx;","+  color: #C0562B;","+  margin-right: 16rpx;","+}","+","+.sync-warning-action {","+  font-size: 22rpx;","+  color: #E6683B;","+  font-weight: 600;","+  white-space: nowrap;","+}","+"," /* 邀请码条幅 */"," .invite-ba