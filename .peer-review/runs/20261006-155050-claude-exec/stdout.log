eCode || '').trim()))\n        ? String(event.inviteCode).trim()\n        : null;\n      if (inviteCode) {\n        let dupRes = null;\n        try {\n          dupRes = await db.collection('families').where({\n            inviteCode,\n            inviteExpiredAt: _.gt(now)\n          }).get();\n        } catch (dupErr) {\n          console.warn('[familyManage] 补传口令查重异常，改为生成新口令:', dupErr);\n        }\n        const isTaken = !dupRes || (dupRes.data || []).some(doc => (doc._id || doc.id) !== familyId);\n        if (isTaken) {\n          inviteCode = await generateUniqueInviteCode();\n        }\n      } else {\n        inviteCode = await generateUniqueInviteCode();\n      }\n      const inviteExpiredAt = (isLegacySync && event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n        ? Number(event.inviteExpiredAt)\n        : (now + 24 * 60 * 60 * 1000); // 24小时过期\n\n      return await db.runTransaction(async transaction => {\n        const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n\n        // 补传时若云端已存在同 id 家庭：本人所在则幂等返回（重复补传/重试），他人家庭则换新 id，严禁覆盖\n        if (requestedFamilyId) {\n          let existingFam = null;\n          try {\n            const famRes = await transaction.collection('families').doc(requestedFamilyId).get();\n            existingFam = (famRes && famRes.data) ? famRes.data : null;\n          } catch (e) {\n            if (!isNotFoundError(e)) throw e;\n          }\n          if (existingFam) {\n            const isMember = (existingFam.memberOpenids || []).includes(openid);\n            if (isMember) {\n              await userDocRef.update({\n                data: {\n                  familyId: requestedFamilyId,\n                  role: existingFam.creatorOpenid === openid ? 'creator' : 'member',\n                  updatedAt: now\n                }\n              }).catch(() => {});\n              return {\n                success: true,\n                openid,\n                family: {\n                  id: requestedFamilyId,\n                  _id: requestedFamilyId,\n                  ...existingFam\n                }\n              };\n            }\n            familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n          }\n        }\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3456,"cache_read_input_tokens":101051,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3456},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"06bbea82-2bc1-4455-9d94-f1d3424dac97","timestamp":"2026-10-06T07:56:31.919Z","request_id":"req_011CfkdFC5dNWXr5koRJ9oWc","wire_tool_inputs":{"toolu_01RULyLCekmW4AaXhyisN6Xa":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","old_string":"      // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n      const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n      let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n        ? String(event.inviteCode).trim()\n        : null;\n      if (inviteCode) {\n        const dupRes = await db.collection('families').where({\n          inviteCode,\n          inviteExpiredAt: _.gt(now)\n        }).get().catch(() => null);\n        if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n          inviteCode = await generateUniqueInviteCode();\n        }\n      } else {\n        inviteCode = await generateUniqueInviteCode();\n      }\n      const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n        ? Number(event.inviteExpiredAt)\n        : (now + 24 * 60 * 60 * 1000); // 24小时过期\n\n 