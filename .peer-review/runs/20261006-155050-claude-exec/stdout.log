{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019FAkPDpSfn4KiPFd2crnfm","type":"tool_result","content":"1\t<view class=\"container mine-container\">\n2\t  <!-- 4人家庭空间卡片 -->\n3\t  <view class=\"family-card card\">\n4\t    <!-- 未加入家庭状态 -->\n5\t    <block wx:if=\"{{ !family }}\">\n6\t      <view class=\"fam-empty-box\">\n7\t        <view class=\"fam-header\">\n8\t          <view class=\"fam-icon\">🏡</view>\n9\t          <view class=\"fam-title-wrap\">\n10\t            <view class=\"fam-title\">家庭厨房空间</view>\n11\t            <view class=\"fam-sub\">支持 1~4 人共享每日做菜历史与私房菜库</view>\n12\t          </view>\n13\t        </view>\n14\t        <view class=\"fam-actions\">\n15\t          <view class=\"create-row\">\n16\t            <input \n17\t              class=\"fam-name-input\" \n18\t              placeholder=\"自定义厨房名称 (如：温馨小家食堂)\" \n19\t              value=\"{{ newFamilyNameInput }}\" \n20\t              bindinput=\"handleFamilyNameInput\" \n21\t              maxlength=\"15\"\n22\t            />\n23\t            <button class=\"btn-create-fam\" bindtap=\"handleCreateFamily\" disabled=\"{{ isCreatingFamily }}\">创建厨房</button>\n24\t          </view>\n25\t          <view class=\"divider-text\">或输入家人分享的口令</view>\n26\t          <view class=\"join-row\">\n27\t            <input \n28\t              class=\"join-code-input\" \n29\t              type=\"text\" \n30\t              maxlength=\"100\" \n31\t              placeholder=\"输入 6 位家庭邀请口令\" \n32\t              value=\"{{ joinCodeInput }}\" \n33\t              bindinput=\"handleJoinCodeInput\" \n34\t              bindblur=\"handleJoinCodeInput\" \n35\t              bindconfirm=\"handleJoinFamily\" \n36\t            />\n37\t            <button class=\"btn-join-fam\" bindtap=\"handleJoinFamily\" disabled=\"{{ isJoiningFamily }}\">加入厨房</button>\n38\t          </view>\n39\t        </view>\n40\t      </view>\n41\t    </block>\n42\t\n43\t    <!-- 已绑定家庭状态 (上限 4 人) -->\n44\t    <block wx:else>\n45\t      <view class=\"fam-active-box\">\n46\t        <view class=\"fam-header\">\n47\t          <view class=\"fam-icon\">🍳</view>\n48\t          <view class=\"fam-title-wrap\">\n49\t            <view class=\"fam-title\">{{ family.name || '温馨小家食堂' }}</view>\n50\t            <view class=\"fam-badge\">家庭成员 ({{ family.members.length }}/4 人)</view>\n51\t          </view>\n52\t        </view>\n53\t\n54\t        <!-- 成员头像列表 -->\n55\t        <view class=\"members-grid\">\n56\t          <block wx:for=\"{{ family.members }}\" wx:key=\"openid\">\n57\t            <view class=\"member-chip\">\n58\t              <view class=\"member-avatar\">\n59\t                <text>{{ item.role === 'creator' ? '👨‍🍳' : '🥣' }}</text>\n60\t              </view>\n61\t              <view class=\"member-name\">{{ item.nickName }}</view>\n62\t              <view wx:if=\"{{ item.role === 'creator' }}\" class=\"role-tag\">房主</view>\n63\t            </view>\n64\t          </block>\n65\t        </view>\n66\t\n67\t        <!-- 邀请码与复制口令 -->\n68\t        <view class=\"invite-banner\">\n69\t          <view class=\"invite-left\">\n70\t            <text class=\"invite-label\">动态邀请口令 (24小时有效)</text>\n71\t            <text class=\"invite-code\">{{ family.inviteCode }}</text>\n72\t          </view>\n73\t          <view class=\"invite-actions\">\n74\t            <button class=\"btn-copy-code\" bindtap=\"handleCopyInviteCode\">复制口令</button>\n75\t            <button wx:if=\"{{ currentUser.role === 'creator' }}\" class=\"btn-refresh-code\" bindtap=\"handleRefreshInviteCode\">刷新</button>\n76\t          </view>\n77\t        </view>\n78\t\n79\t        <view class=\"fam-bottom-bar\">\n80\t          <text class=\"fam-leave-btn\" bindtap=\"handleLeaveFamily\">\n81\t            {{ currentUser.role === 'creator' ? '解散/退出家庭' : '退出家庭厨房' }}\n82\t          </text>\n83\t        </view>\n84\t      </view>\n85\t    </block>\n86\t  </view>\n87\t\n88\t  <!-- 辣度偏好 -->\n89\t  <view class=\"setting-card card\">\n90\t    <view class=\"card-title\">🌶️ 辣度接受度</view>\n91\t    <view class=\"spicy-options\">\n92\t      <block wx:for=\"{{ spicyLevels }}\" wx:key=\"level\">\n93\t        <view \n94\t          class=\"spicy-pill {{ preferences.spicyLevel === item.level ? 'pill-active' : '' }}\"\n95\t          bindtap=\"setSpicyLevel\"\n96\t          data-level=\"{{ item.level }}\"\n97\t        >\n98\t          {{ item.label }}\n99\t        </view>\n100\t      </block>\n101\t    </view>\n102\t  </view>\n103\t\n104\t  <!-- 忌口与不吃食材 -->\n105\t  <view class=\"setting-card card\">\n106\t    <view class=\"card-title\">🚫 忌口食材（算法自动排除）</view>\n107\t    <view class=\"disliked-chips\">\n108\t      <block wx:for=\"{{ commonAvoids }}\" wx:key=\"*this\">\n109\t        <view \n110\t          class=\"avoid-chip {{ dislikedMap[item] ? 'avoid-active' : '' }}\"\n111\t          bindtap=\"toggleAvoid\"\n112\t          data-item=\"{{ item }}\"\n113\t        >\n114\t          <text>{{ item }}</text>\n115\t          <text class=\"avoid-mark\">{{ dislikedMap[item] ? '✓' : '+' }}</text>\n116\t        </view>\n117\t      </block>\n118\t    </view>\n119\t  </view>\n120\t\n121\t  <!-- 默认开饭模式 -->\n122\t  <view class=\"setting-card card\">\n123\t    <view class=\"card-title\">🍲 默认餐桌模式</view>\n124\t    <view class=\"mode-select-grid\">\n125\t      <block wx:for=\"{{ availableModes }}\" wx:key=\"key\">\n126\t        <view \n127\t          class=\"mode-pill {{ preferences.defaultMode === item.key ? 'pill-active' : '' }}\"\n128\t          bindtap=\"setDefaultMode\"\n129\t          data-key=\"{{ item.key }}\"\n130\t        >\n131\t          {{ item.name }}\n132\t        </view>\n133\t      </block>\n134\t    </view>\n135\t  </view>\n136\t\n137\t  <!-- 数据管理与重置 -->\n138\t  <view class=\"setting-card card\">\n139\t    <view class=\"card-title\">⚙️ 数据管理</view>\n140\t    <view class=\"manage-row\" bindtap=\"handleClearHistory\">\n141\t      <text class=\"row-label\">清空吃饭历史记录 (重新开始防重)</text>\n142\t      <text class=\"row-arrow\">›</text>\n143\t    </view>\n144\t  </view>\n145\t\n146\t  <!-- 版本信息与版权声明 -->\n147\t  <view class=\"version-footer\">\n148\t    <text class=\"version-text\">四季三餐 · 好好吃饭 v{{ version }}</text>\n149\t    <text class=\"version-sub\">精选 125 道家常料理 · 时令生鲜智能搭配</text>\n150\t  </view>\n151\t</view>\n152\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"69e2f1d0-dc78-4f28-8099-b4a368b1779c","timestamp":"2026-10-06T07:51:10.636Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/pages/mine/index.wxml","content":"<view class=\"container mine-container\">\n  <!-- 4人家庭空间卡片 -->\n  <view class=\"family-card card\">\n    <!-- 未加入家庭状态 -->\n    <block wx:if=\"{{ !family }}\">\n      <view class=\"fam-empty-box\">\n        <view class=\"fam-header\">\n          <view class=\"fam-icon\">🏡</view>\n          <view class=\"fam-title-wrap\">\n            <view class=\"fam-title\">家庭厨房空间</view>\n            <view class=\"fam-sub\">支持 1~4 人共享每日做菜历史与私房菜库</view>\n          </view>\n        </view>\n        <view class=\"fam-actions\">\n          <view class=\"create-row\">\n            <input \n              class=\"fam-name-input\" \n              placeholder=\"自定义厨房名称 (如：温馨小家食堂)\" \n              value=\"{{ newFamilyNameInput }}\" \n              bindinput=\"handleFamilyNameInput\" \n              maxlength=\"15\"\n            />\n            <button class=\"btn-create-fam\" bindtap=\"handleCreateFamily\" disabled=\"{{ isCreatingFamily }}\">创建厨房</button>\n          </view>\n          <view class=\"divider-text\">或输入家人分享的口令</view>\n          <view class=\"join-row\">\n            <input \n              class=\"join-code-input\" \n              type=\"text\" \n              maxlength=\"100\" \n              placeholder=\"输入 6 位家庭邀请口令\" \n              value=\"{{ joinCodeInput }}\" \n              bindinput=\"handleJoinCodeInput\" \n              bindblur=\"handleJoinCodeInput\" \n              bindconfirm=\"handleJoinFamily\" \n            />\n            <button class=\"btn-join-fam\" bindtap=\"handleJoinFamily\" disabled=\"{{ isJoiningFamily }}\">加入厨房</button>\n          </view>\n        </view>\n      </view>\n    </block>\n\n    <!-- 已绑定家庭状态 (上限 4 人) -->\n    <block wx:else>\n      <view class=\"fam-active-box\">\n        <view class=\"fam-header\">\n          <view class=\"fam-icon\">🍳</view>\n          <view class=\"fam-title-wrap\">\n            <view class=\"fam-title\">{{ family.name || '温馨小家食堂' }}</view>\n            <view class=\"fam-badge\">家庭成员 ({{ family.members.length }}/4 人)</view>\n          </view>\n        </view>\n\n        <!-- 成员头像列表 -->\n        <view class=\"members-grid\">\n          <block wx:for=\"{{ family.members }}\" wx:key=\"openid\">\n            <view class=\"member-chip\">\n              <view class=\"member-avatar\">\n                <text>{{ item.role === 'creator' ? '👨‍🍳' : '🥣' }}</text>\n              </view>\n              <view class=\"member-name\">{{ item.nickName }}</view>\n              <view wx:if=\"{{ item.role === 'creator' }}\" class=\"role-tag\">房主</view>\n            </view>\n          </block>\n        </view>\n\n        <!-- 邀请码与复制口令 -->\n        <view class=\"invite-banner\">\n          <view class=\"invite-left\">\n            <text class=\"invite-label\">动态邀请口令 (24小时有效)</text>\n            <text class=\"invite-code\">{{ family.inviteCode }}</text>\n          </view>\n          <view class=\"invite-actions\">\n            <button class=\"btn-copy-code\" bindtap=\"handleCopyInviteCode\">复制口令</button>\n            <button wx:if=\"{{ currentUser.role === 'creator' }}\" class=\"btn-refresh-code\" bindtap=\"handleRefreshInviteCode\">刷新</button>\n          </view>\n        </view>\n\n        <view class=\"fam-bottom-bar\">\n          <text class=\"fam-leave-btn\" bindtap=\"handleLeaveFamily\">\n            {{ currentUser.role === 'creator' ? '解散/退出家庭' : '退出家庭厨房' }}\n          </text>\n        </view>\n      </view>\n    </block>\n  </view>\n\n  <!-- 辣度偏好 -->\n  <view class=\"setting-card card\">\n    <view class=\"card-title\">🌶️ 辣度接受度</view>\n    <view class=\"spicy-options\">\n      <block wx:for=\"{{ spicyLevels }}\" wx:key=\"level\">\n        <view \n          class=\"spicy-pill {{ preferences.spicyLevel === item.level ? 'pill-active' : '' }}\"\n          bindtap=\"setSpicyLevel\"\n          data-level=\"{{ item.level }}\"\n        >\n          {{ item.label }}\n        </view>\n      </block>\n    </view>\n  </view>\n\n  <!-- 忌口与不吃食材 -->\n  <view class=\"setting-card card\">\n    <view class=\"card-title\">🚫 忌口食材（算法自动排除）</view>\n    <view class=\"disliked-chips\">\n      <block wx:for=\"{{ commonAvoids }}\" wx:key=\"*this\">\n        <view \n          class=\"avoid-chip {{ dislikedMap[item] ? 'avoid-active' : '' }}\"\n          bindtap=\"toggleAvoid\"\n          data-item=\"{{ item }}\"\n        >\n          <text>{{ item }}</text>\n          <text class=\"avoid-mark\">{{ dislikedMap[item] ? '✓' : '+' }}</text>\n        </view>\n      </block>\n    </view>\n  </view>\n\n  <!-- 默认开饭模式 -->\n  <view class=\"setting-card card\">\n    <view class=\"card-title\">🍲 默认餐桌模式</view>\n    <view class=\"mode-select-grid\">\n      <block wx:for=\"{{ availableModes }}\" wx:key=\"key\">\n        <view \n          class=\"mode-pill {{ preferences.defaultMode === item.key ? 'pill-active' : '' }}\"\n          bindtap=\"setDefaultMode\"\n          data-key=\"{{ item.key }}\"\n        >\n          {{ item.name }}\n        </view>\n      </block>\n    </view>\n  </view>\n\n  <!-- 数据管理与重置 -->\n  <view class=\"setting-card card\">\n    <view class=\"card-title\">⚙️ 数据管理</view>\n    <view class=\"manage-row\" bindtap=\"handleClearHistory\">\n      <text class=\"row-label\">清空吃饭历史记录 (重新开始防重)</text>\n      <text class=\"row-arrow\">›</text>\n    </view>\n  </view>\n\n  <!-- 版本信息与版权声明 -->\n  <view class=\"version-footer\">\n    <text class=\"version-text\">四季三餐 · 好好吃饭 v{{ version }}</text>\n    <text class=\"version-sub\">精选 125 道家常料理 · 时令生鲜智能搭配</text>\n  </view>\n</view>\n","numLines":152,"startLine":1,"totalLines":152}}}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfkcrTShxW95jiNGEf2jQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018Hne4J5Am8oNneF1jdB912","name":"Read","input":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/test/join_family_resilience_test.mjs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14026,"cache_read_input_tokens":31402,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14026},"output_tokens":16,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"747ab6e9-5bbf-423e-8fec-3e3932e901f4","timestamp":"2026-10-06T07:51:10.687Z","request_id":"req_011CfkcrT9bkN7VCTaRcfHCb","wire_tool_inputs":{"toolu_018Hne4J5Am8oNneF1jdB912":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/test/join_family_resilience_test.mjs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Hne4J5Am8oNneF1jdB912","type":"tool_result","content":"1\t/**\n2\t * 专项验证：家庭厨房邀请口令加入全链路鲁棒性与多端容灾互通测试\n3\t * \n4\t * 覆盖场景：\n5\t * 1. cleanInviteCode 输入净化（全角数字、带空格、微信聊天格式文本提取、纯数字类型兼容）\n6\t * 2. WXML 输入框防截断（maxlength >= 20，杜绝带空格粘贴丢第6位致命缺陷）\n7\t * 3. 数据库 inviteCode 类型一致性（字符串与数值型双向无缝匹配，杜绝 MongoDB 类型隔离）\n8\t * 4. 新用户初次加入家庭安全防刷限频（isNotFoundError 识别对象型 errMsg，绝不误拦截正常新用户）\n9\t * 5. 跨机/跨模式互通穿透（本地降级模式用户加入云端家庭自动穿透探测，房主降级家庭上线后静默同步）\n10\t * 6. 复制口令类型防崩溃（wx.setClipboardData 传参必为字符串）\n11\t */\n12\t\n13\timport assert from 'assert/strict';\n14\timport fs from 'fs';\n15\timport path from 'path';\n16\t\n17\tconsole.log('===============================================================');\n18\tconsole.log('🧪 启动家庭厨房邀请口令加入全链路鲁棒性专项自动化验证');\n19\tconsole.log('===============================================================\\n');\n20\t\n21\t// 模拟原生小程序环境\n22\tconst storage = new Map();\n23\tlet clipboardData = null;\n24\tglobal.wx = {\n25\t  getStorageSync: (key) => storage.get(key) || null,\n26\t  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n27\t  removeStorageSync: (key) => storage.delete(key),\n28\t  clearStorageSync: () => storage.clear(),\n29\t  setClipboardData: ({ data, success }) => {\n30\t    assert.equal(typeof data, 'string', 'wx.setClipboardData data 参数必须为字符串');\n31\t    clipboardData = data;\n32\t    if (success) success();\n33\t  },\n34\t  showLoading: () => {},\n35\t  hideLoading: () => {},\n36\t  showToast: () => {}\n37\t};\n38\t\n39\tprocess.env.NODE_ENV = 'test';\n40\t\n41\tconst { cleanInviteCode, familyService } = await import('../miniprogram/services/familyService.js');\n42\tconst { cloudService } = await import('../miniprogram/services/cloudService.js');\n43\tconst familyManageModule = await import('../cloudfunctions/familyManage/index.js');\n44\tconst wxServerSdk = await import('wx-server-sdk');\n45\t\n46\t// -------------------------------------------------------------\n47\t// 【测试 1】cleanInviteCode 边界输入与格式净化鲁棒性\n48\t// -------------------------------------------------------------\n49\tconsole.log('【场景 1】验证 cleanInviteCode 口令格式智能净化与提取');\n50\t\n51\tassert.equal(cleanInviteCode('123456'), '123456', '标准 6 位字符串应原样保留');\n52\tassert.equal(cleanInviteCode(123456), '123456', '数值型 123456 应转为 6 位数字字符串');\n53\tassert.equal(cleanInviteCode('  839201  '), '839201', '带前后空格或换行的口令应自动 trim');\n54\tassert.equal(cleanInviteCode('１２３４５６'), '123456', '全角数字应正确转换为半角 123456');\n55\tassert.equal(cleanInviteCode('【839201】'), '839201', '带中文括号的口令应提取 6 位纯数字');\n56\tassert.equal(cleanInviteCode('口令：839201，复制即可加入'), '839201', '微信聊天复制文本应智能提取 6 位数字');\n57\tassert.equal(cleanInviteCode(''), '', '空输入返回空字符串');\n58\tassert.equal(cleanInviteCode(null), '', 'null 输入返回空字符串');\n59\tassert.equal(cleanInviteCode(undefined), '', 'undefined 输入返回空字符串');\n60\tassert.equal(cleanInviteCode('12345'), '12345', '不足 6 位保留提取结果供后续校验拦截');\n61\t\n62\tconsole.log('✅ 测试 1 通过: cleanInviteCode 对全角/空格/中文括号/聊天文本/数值型均完美适配！\\n');\n63\t\n64\t// -------------------------------------------------------------\n65\t// 【测试 2】WXML 输入框防截断属性核验\n66\t// -------------------------------------------------------------\n67\tconsole.log('【场景 2】验证 mine/index.wxml 输入框防截断设置');\n68\tconst wxmlContent = fs.readFileSync(path.resolve('miniprogram/pages/mine/index.wxml'), 'utf-8');\n69\tconst matchMaxlength = wxmlContent.match(/class=\"join-code-input\"[\\s\\S]*?maxlength=\"(\\d+)\"/);\n70\tassert(matchMaxlength, '必须在 join-code-input 上找到 maxlength 属性');\n71\tconst maxLen = parseInt(matchMaxlength[1], 10);\n72\tassert(maxLen >= 12, `join-code-input 的 maxlength 应至少为 12 (当前为 ${maxLen})，防止粘贴带空格内容时尾数被系统截断`);\n73\tconsole.log(`✅ 测试 2 通过: mine/index.wxml 中 join-code-input 的 maxlength 扩大为 ${maxLen}，彻底根治尾数被微信原生输入框截断问题！\\n`);\n74\t\n75\t// -------------------------------------------------------------\n76\t// 【测试 3】数据库中 inviteCode 数值型与字符串双向无缝匹配\n77\t// -------------------------------------------------------------\n78\tconsole.log('【场景 3】验证云函数对数值型与字符串 inviteCode 的双向兼容');\n79\tif (typeof wxServerSdk.default?.resetMemoryStore === 'function') {\n80\t  wxServerSdk.default.resetMemoryStore();\n81\t}\n82\t\n83\t// 模拟历史数据中将 inviteCode 存储为 Number 的家庭\n84\tconst db = wxServerSdk.default.database();\n85\tconst mockNumCode = 654321;\n86\tconst numFamId = 'fam_numeric_code_test';\n87\tawait db.collection('families').doc(numFamId).set({\n88\t  data: {\n89\t    id: numFamId,\n90\t    name: '数值口令实验家庭',\n91\t    creatorOpenid: 'openid_creator_num',\n92\t    members: [{ openid: 'openid_creator_num', nickName: '房主', role: 'creator', joinedAt: Date.now() }],\n93\t    memberOpenids: ['openid_creator_num'],\n94\t    inviteCode: mockNumCode, // 数值类型！\n95\t    inviteExpiredAt: Date.now() + 24 * 3600 * 1000,\n96\t    createdAt: Date.now(),\n97\t    updatedAt: Date.now()\n98\t  }\n99\t});\n100\t\n101\t// 测试加入：客户端传递字符串 '654321'\n102\tconst joinNumRes = await familyManageModule.default.main({\n103\t  action: 'joinFamily',\n104\t  inviteCode: '654321', // 字符串型\n105\t  mockOpenid: 'openid_member_str_joiner',\n106\t  nickName: '字符串加入者'\n107\t}, {});\n108\t\n109\tassert.equal(joinNumRes.success, true, '向数值型 inviteCode 家庭传入字符串口令必须匹配成功');\n110\tassert.equal(joinNumRes.family.id, numFamId, '成功加入对应家庭');\n111\tconsole.log('✅ 测试 3.1: 客户端传入字符串口令成功匹配服务端数值型 inviteCode！');\n112\t\n113\t// 同样测试 LocalCloudMockDatabase 中的数值型与字符串型兼容\n114\tcloudService.setForceMock(true);\n115\tconst mockDb = cloudService.getMockDb();\n116\tmockDb.clearAll();\n117\tconst localCreateRes = mockDb.handleFamilyManage({\n118\t  action: 'createFamily',\n119\t  name: '本地数值测试家庭',\n120\t  mockOpenid: 'openid_local_creator'\n121\t});\n122\t// 手动将 inviteCode 修改为数值\n123\tconst localFam = localCreateRes.family;\n124\tlocalFam.inviteCode = Number(localFam.inviteCode);\n125\t\n126\tconst localJoinRes = mockDb.handleFamilyManage({\n127\t  action: 'joinFamily',\n128\t  inviteCode: String(localFam.inviteCode),\n129\t  mockOpenid: 'openid_local_member'\n130\t});\n131\tassert.equal(localJoinRes.success, true, '本地 mock 中对数值/字符串型 inviteCode 亦能双向兼容');\n132\tconsole.log('✅ 测试 3.2: 本地高可用 Mock 库双向数值/字符串 inviteCode 兼容测试通过！');\n133\t\n134\t// 测试 3.3: 历史家庭无 inviteExpiredAt 或为字符串时间戳，绝不被误判为已过期\n135\tconst histFamId = 'fam_historical_no_expiry';\n136\tawait db.collection('families').doc(histFamId).set({\n137\t  data: {\n138\t    id: histFamId,\n139\t    name: '历史无过期字段厨房',\n140\t    creatorOpenid: 'openid_creator_hist',\n141\t    members: [{ openid: 'openid_creator_hist', nickName: '房主', role: 'creator', joinedAt: Date.now() }],\n142\t    memberOpenids: ['openid_creator_hist'],\n143\t    inviteCode: '888666',\n144\t    // 无 inviteExpiredAt 字段\n145\t    createdAt: Date.now(),\n146\t    updatedAt: Date.now()\n147\t  }\n148\t});\n149\t\n150\tconst joinHistRes = await familyManageModule.default.main({\n151\t  action: 'joinFamily',\n152\t  inviteCode: '【888666】', // 携带微信聊天中文括号\n153\t  mockOpenid: 'openid_hist_joiner',\n154\t  nickName: '历史加入者'\n155\t}, {});\n156\tassert.equal(joinHistRes.success, true, '历史无 inviteExpiredAt 字段的家庭必须能正常加入，严禁误报失效');\n157\tassert.equal(joinHistRes.family.id, histFamId);\n158\tassert.equal(joinHistRes.openid, 'openid_hist_joiner', 'joinFamily 返回必须包含真实 openid');\n159\tconsole.log('✅ 测试 3.3: 历史无过期字段家庭与全角/格式化口令加入验证通过！\\n');\n160\t\n161\t// -------------------------------------------------------------\n162\t// 【测试 4】新用户首次加入家庭（无 users 档案），绝不报安全防刷限频异常\n163\t// -------------------------------------------------------------\n164\tconsole.log('【场景 4】验证全新用户首次加入家庭时 isNotFoundError 识别与正常加入');\n165\tif (typeof wxServerSdk.default?.resetMemoryStore === 'function') {\n166\t  wxServerSdk.default.resetMemoryStore();\n167\t}\n168\t\n169\t// 创建一个正常云端家庭\n170\tconst createCloudFam = await familyManageModule.default.main({\n171\t  action: 'createFamily',\n172\t  name: '云端幸福厨房',\n173\t  mockOpenid: 'openid_cloud_dad',\n174\t  nickName: '爸爸'\n175\t}, {});\n176\tassert.equal(createCloudFam.success, true);\n177\tconst cloudInviteCode = createCloudFam.family.inviteCode;\n178\t\n179\t// 模拟全新微信用户（users 集合中毫无记录，微信底层抛出包含 errMsg 的 plain object）\n180\tconst freshOpenid = 'openid_fresh_new_user_123';\n181\tconst freshJoinRes = await familyManageModule.default.main({\n182\t  action: 'joinFamily',\n183\t  inviteCode: cloudInviteCode,\n184\t  mockOpenid: freshOpenid,\n185\t  nickName: '全新女儿'\n186\t}, {});\n187\t\n188\tassert.equal(freshJoinRes.success, true, '全新用户首次加入家庭必须顺利成功');\n189\tassert.equal(freshJoinRes.family.members.length, 2, '家庭成员数应变为 2');\n190\tassert(freshJoinRes.family.members.some(m => m.openid === freshOpenid), '新成员必须在家庭成员列表中');\n191\tconsole.log('✅ 测试 4: 全新用户首次加入家庭无任何 false-positive 限频报错，顺利加入成功！\\n');\n192\t\n193\t// -------------------------------------------------------------\n194\t// 【测试 5】跨模式与降级状态穿透互通机制\n195\t// -------------------------------------------------------------\n196\tconsole.log('【场景 5】验证用户在降级模式下向真实云端穿透加入家人厨房');\n197\t\n198\t// 场景 5.1: 房主在云端创建了家庭\n199\tconst cloudCreatorOpenid = 'openid_real_cloud_owner';\n200\tconst cloudKitchenRes = await familyManageModule.default.main({\n201\t  action: 'createFamily',\n202\t  name: '云端姥姥的小院',\n203\t  mockOpenid: cloudCreatorOpenid,\n204\t  nickName: '姥姥'\n205\t}, {});\n206\tassert(cloudKitchenRes.success);\n207\tconst cloudGrandmaCode = cloudKitchenRes.family.inviteCode;\n208\t\n209\t// 场景 5.2: 加入者此前因为偶发网络异常，isCloudAvailable 被置为 false（降级模式运行）\n210\tcloudService.setForceMock(false);\n211\tglobal.wx.cloud = {\n212\t  callFunction: async ({ name, data }) => {\n213\t    // 转发给实际云函数模拟真实云端环境\n214\t    if (name === 'familyManage') {\n215\t      return { result: await familyManageModule.default.main(data, {}) };\n216\t    }\n217\t    return { result: { success: false } };\n218\t  }\n219\t};\n220\t\n221\t// 显式将客户端标记为本地降级模式\n222\tcloudService.resetAvailability();\n223\t// 模拟一次环境不可用将 isCloudAvailable 锁为 false\n224\ttry {\n225\t  await cloudService.callFunction('familyManage', {\n226\t    action: 'probe',\n227\t    _simulateErr: true\n228\t  });\n229\t} catch (e) {}\n230\t\n231\t// 在 familyService 中执行加入家人家庭\n232\tfamilyService.setMockCurrentUser('openid_grandson', '外孙');\n233\t// 清空本地 mock 库，确保本地没有姥姥的家庭\n234\tcloudService.getMockDb().clearAll();\n235\t\n236\tconst grandsonJoinRes = await familyService.joinFamily(cloudGrandmaCode);\n237\tassert.equal(grandsonJoinRes.success, true, '降级状态下加入云端家庭应成功通过穿透探测加入');\n238\tassert.equal(grandsonJoinRes.family.name, '云端姥姥的小院');\n239\tassert.equal(cloudService.checkCloudAvailability(), true, '穿透云端成功后，云端可用性标识应自动自愈恢复为 true');\n240\tconsole.log('✅ 测试 5.1: 降级模式用户加入家人云端厨房时成功穿透并自动恢复云端可用性！');\n241\t\n242\t// 场景 5.3: 房主如果在本地离线创建了家庭，上线鉴权 syncUserAuth 时自动补全注册到云端\n243\tcloudService.getMockDb().clearAll();\n244\tfamilyService.setMockCurrentUser('openid_offline_mom', '妈妈');\n245\t// 本地创建家庭\n246\tconst localMomFam = await familyService.createFamily('离线妈妈的爱心食堂');\n247\tassert(localMomFam.success);\n248\tconst localMomCode = localMomFam.family.inviteCode;\n249\t\n250\t// 执行 syncUserAuth，验证是否自动向云端静默补全注册\n251\tglobal.wx.cloud.callFunction = async ({ name, data }) => {\n252\t  if (name === 'userAuth') {\n253\t    return {\n254\t      result: {\n255\t        success: true,\n256\t        openid: data.mockOpenid,\n257\t        user: { openid: data.mockOpenid, familyId: null, role: null },\n258\t        family: null // 云端暂无\n259\t      }\n260\t    };\n261\t  }\n262\t  if (name === 'familyManage' && data.action === 'createFamily') {\n263\t    return {\n264\t      result: await familyManageModule.default.main(data, {})\n265\t    };\n266\t  }\n267\t  return { result: { success: true } };\n268\t};\n269\t\n270\tawait familyService.syncUserAuth();\n271\t// 等待 promise 微任务执行\n272\tawait new Promise(r => setTimeout(r, 50));\n273\t\n274\t// 验证云端现在已经有了妈妈的家庭并且 inviteCode 完全一致\n275\tconst queryMomCloudRes = await familyManageModule.default.main({\n276\t  action: 'joinFamily',\n277\t  inviteCode: localMomCode,\n278\t  mockOpenid: 'openid_kid_user',\n279\t  nickName: '孩子'\n280\t}, {});\n281\tassert.equal(queryMomCloudRes.success, true, '房主本地离线家庭在 syncUserAuth 后已成功补全同步至云端，家人凭原口令可直接加入！');\n282\tconsole.log('✅ 测试 5.2: 房主本地创建家庭在联网鉴权时自动补全云端注册，家人可凭同一口令顺利加入！\\n');\n283\t\n284\t// -------------------------------------------------------------\n285\t// 【测试 6】复制口令类型防崩溃验证\n286\t// -------------------------------------------------------------\n287\tconsole.log('【场景 6】验证复制口令 wx.setClipboardData 传参必为字符串');\n288\tlet registeredMinePage = null;\n289\tglobal.Page = (cfg) => { registeredMinePage = cfg; };\n290\tawait import('../miniprogram/pages/mine/index.js');\n291\tassert(registeredMinePage && registeredMinePage.handleCopyInviteCode);\n292\t\n293\t// 模拟 family.inviteCode 为数值型\n294\tregisteredMinePage.data = {\n295\t  ...registeredMinePage.data,\n296\t  family: { inviteCode: 998877 }\n297\t};\n298\tclipboardData = null;\n299\tregisteredMinePage.handleCopyInviteCode();\n300\tassert.equal(clipboardData, '998877', '复制口令无论源数据为数字或字符串，传递给 wx.setClipboardData 必须为合法字符串');\n301\tconsole.log('✅ 测试 6: handleCopyInviteCode 确保 data 为纯字符串，杜绝微信原生报参数类型错误！\\n');\n302\t\n303\t// -------------------------------------------------------------\n304\t// 【测试 7】前端页面输入框净化返回值与防重复提交并发锁验证\n305\t// -------------------------------------------------------------\n306\tconsole.log('【场景 7】验证 mine 页面输入框净化返回值与防重提交锁');\n307\tassert(registeredMinePage.handleJoinCodeInput, 'mine 页面必须实现 handleJoinCodeInput');\n308\tassert(registeredMinePage.handleJoinFamily, 'mine 页面必须实现 handleJoinFamily');\n309\t\n310\t// 测试 handleJoinCodeInput 返回净化后字符串 (供微信原生 input 同步替换)\n311\tlet mockPageContext = {\n312\t  data: { joinCodeInput: '', isJoiningFamily: false },\n313\t  isSubmittingJoin: false,\n314\t  formatErrorTip: registeredMinePage.formatErrorTip,\n315\t  setData(obj) { Object.assign(this.data, obj); }\n316\t};\n317\tconst cleanedRet = registeredMinePage.handleJoinCodeInput.call(mockPageContext, {\n318\t  detail: { value: '  口令是：482915！ ' }\n319\t});\n320\tassert.equal(cleanedRet, '482915', 'handleJoinCodeInput 必须返回提取出的 6 位纯数字口令');\n321\tassert.equal(mockPageContext.data.joinCodeInput, '482915', 'page data.joinCodeInput 必须同步为提取口令');\n322\t\n323\t// 验证防重复点击 (isSubmittingJoin)\n324\tlet joinCallCount = 0;\n325\tconst originalJoinFamily = familyService.joinFamily;\n326\tfamilyService.joinFamily = async () => {\n327\t  joinCallCount++;\n328\t  await new Promise(r => setTimeout(r, 20));\n329\t  return { success: true };\n330\t};\n331\t\n332\tmockPageContext.data.joinCodeInput = '482915';\n333\tconst p1 = registeredMinePage.handleJoinFamily.call(mockPageContext);\n334\tconst p2 = registeredMinePage.handleJoinFamily.call(mockPageContext);\n335\tawait Promise.all([p1, p2]);\n336\t\n337\tassert.equal(joinCallCount, 1, '快速连击加入按钮时必须被防重提交锁拦截，严防并发事务冲突');\n338\tassert.equal(mockPageContext.isSubmittingJoin, false, '完成后防重提交锁必须成功复位');\n339\tfamilyService.joinFamily = originalJoinFamily;\n340\tconsole.log('✅ 测试 7: handleJoinCodeInput 同步返回值与防并发点击锁验证通过！\\n');\n341\t\n342\tconsole.log('===============================================================');\n343\tconsole.log('🎉 全部 7 大场景专项测试 100% 成功通过！加入家人厨房故障已彻底根除！');\n344\tconsole.log('===============================================================\\n');\n345\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"525a16eb-8669-4237-9f33-b13be477e189","timestamp":"2026-10-06T07:51:10.704Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/test/join_family_resilience_test.mjs","content":"/**\n * 专项验证：家庭厨房邀请口令加入全链路鲁棒性与多端容灾互通测试\n * \n * 覆盖场景：\n * 1. cleanInviteCode 输入净化（全角数字、带空格、微信聊天格式文本提取、纯数字类型兼容）\n * 2. WXML 输入框防截断（maxlength >= 20，杜绝带空格粘贴丢第6位致命缺陷）\n * 3. 数据库 inviteCode 类型一致性（字符串与数值型双向无缝匹配，杜绝 MongoDB 类型隔离）\n * 4. 新用户初次加入家庭安全防刷限频（isNotFoundError 识别对象型 errMsg，绝不误拦截正常新用户）\n * 5. 跨机/跨模式互通穿透（本地降级模式用户加入云端家庭自动穿透探测，房主降级家庭上线后静默同步）\n * 6. 复制口令类型防崩溃（wx.setClipboardData 传参必为字符串）\n */\n\nimport assert from 'assert/strict';\nimport fs from 'fs';\nimport path from 'path';\n\nconsole.log('===============================================================');\nconsole.log('🧪 启动家庭厨房邀请口令加入全链路鲁棒性专项自动化验证');\nconsole.log('===============================================================\\n');\n\n// 模拟原生小程序环境\nconst storage = new Map();\nlet clipboardData = null;\nglobal.wx = {\n  getStorageSync: (key) => storage.get(key) || null,\n  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n  removeStorageSync: (key) => storage.delete(key),\n  clearStorageSync: () => storage.clear(),\n  setClipboardData: ({ data, success }) => {\n    assert.equal(typeof data, 'string', 'wx.setClipboardData data 参数必须为字符串');\n    clipboardData = data;\n    if (success) success();\n  },\n  showLoading: () => {},\n  hideLoading: () => {},\n  showToast: () => {}\n};\n\nprocess.env.NODE_ENV = 'test';\n\nconst { cleanInviteCode, familyService } = await import('../miniprogram/services/familyService.js');\nconst { cloudService } = await import('../miniprogram/services/cloudService.js');\nconst familyManageModule = await import('../cloudfunctions/familyManage/index.js');\nconst wxServerSdk = await import('wx-server-sdk');\n\n// -------------------------------------------------------------\n// 【测试 1】cleanInviteCode 边界输入与格式净化鲁棒性\n// -------------------------------------------------------------\nconsole.log('【场景 1】验证 cleanInviteCode 口令格式智能净化与提取');\n\nassert.equal(cleanInviteCode('123456'), '123456', '标准 6 位字符串应原样保留');\nassert.equal(cleanInviteCode(123456), '123456', '数值型 123456 应转为 6 位数字字符串');\nassert.equal(cleanInviteCode('  839201  '), '839201', '带前后空格或换行的口令应自动 trim');\nassert.equal(cleanInviteCode('１２３４５６'), '123456', '全角数字应正确转换为半角 123456');\nassert.equal(cleanInviteCode('【839201】'), '839201', '带中文括号的口令应提取 6 位纯数字');\nassert.equal(cleanInviteCode('口令：839201，复制即可加入'), '839201', '微信聊天复制文本应智能提取 6 位数字');\nassert.equal(cleanInviteCode(''), '', '空输入返回空字符串');\nassert.equal(cleanInviteCode(null), '', 'null 输入返回空字符串');\nassert.equal(cleanInviteCode(undefined), '', 'undefined 输入返回空字符串');\nassert.equal(cleanInviteCode('12345'), '12345', '不足 6 位保留提取结果供后续校验拦截');\n\nconsole.log('✅ 测试 1 通过: cleanInviteCode 对全角/空格/中文括号/聊天文本/数值型均完美适配！\\n');\n\n// -------------------------------------------------------------\n// 【测试 2】WXML 输入框防截断属性核验\n// -------------------------------------------------------------\nconsole.log('【场景 2】验证 mine/index.wxml 输入框防截断设置');\nconst wxmlContent = fs.readFileSync(path.resolve('miniprogram/pages/mine/index.wxml'), 'utf-8');\nconst matchMaxlength = wxmlContent.match(/class=\"join-code-input\"[\\s\\S]*?maxlength=\"(\\d+)\"/);\nassert(matchMaxlength, '必须在 join-code-input 上找到 maxlength 属性');\nconst maxLen = parseInt(matchMaxlength[1], 10);\nassert(maxLen >= 12, `join-code-input 的 maxlength 应至少为 12 (当前为 ${maxLen})，防止粘贴带空格内容时尾数被系统截断`);\nconsole.log(`✅ 测试 2 通过: mine/index.wxml 中 join-code-input 的 maxlength 扩大为 ${maxLen}，彻底根治尾数被微信原生输入框截断问题！\\n`);\n\n// -------------------------------------------------------------\n// 【测试 3】数据库中 inviteCode 数值型与字符串双向无缝匹配\n// -------------------------------------------------------------\nconsole.log('【场景 3】验证云函数对数值型与字符串 inviteCode 的双向兼容');\nif (typeof wxServerSdk.default?.resetMemoryStore === 'function') {\n  wxServerSdk.default.resetMemoryStore();\n}\n\n// 模拟历史数据中将 inviteCode 存储为 Number 的家庭\nconst db = wxServerSdk.default.database();\nconst mockNumCode = 654321;\nconst numFamId = 'fam_numeric_code_test';\nawait db.collection('families').doc(numFamId).set({\n  data: {\n    id: numFamId,\n    name: '数值口令实验家庭',\n    creatorOpenid: 'openid_creator_num',\n    members: [{ openid: 'openid_creator_num', nickName: '房主', role: 'creator', joinedAt: Date.now() }],\n    memberOpenids: ['openid_creator_num'],\n    inviteCode: mockNumCode, // 数值类型！\n    inviteExpiredAt: Date.now() + 24 * 3600 * 1000,\n    createdAt: Date.now(),\n    updatedAt: Date.now()\n  }\n});\n\n// 测试加入：客户端传递字符串 '654321'\nconst joinNumRes = await familyManageModule.default.main({\n  action: 'joinFamily',\n  inviteCode: '654321', // 字符串型\n  mockOpenid: 'openid_member_str_joiner',\n  nickName: '字符串加入者'\n}, {});\n\nassert.equal(joinNumRes.success, true, '向数值型 inviteCode 家庭传入字符串口令必须匹配成功');\nassert.equal(joinNumRes.family.id, numFamId, '成功加入对应家庭');\nconsole.log('✅ 测试 3.1: 客户端传入字符串口令成功匹配服务端数值型 inviteCode！');\n\n// 同样测试 LocalCloudMockDatabase 中的数值型与字符串型兼容\ncloudService.setForceMock(true);\nconst mockDb = cloudService.getMockDb();\nmockDb.clearAll();\nconst localCreateRes = mockDb.handleFamilyManage({\n  action: 'createFamily',\n  name: '本地数值测试家庭',\n  mockOpenid: 'openid_local_creator'\n});\n// 手动将 inviteCode 修改为数值\nconst localFam = localCreateRes.family;\nlocalFam.inviteCode = Number(localFam.inviteCode);\n\nconst localJoinRes = mockDb.handleFamilyManage({\n  action: 'joinFamily',\n  inviteCode: String(localFam.inviteCode),\n  mockOpenid: 'openid_local_member'\n});\nassert.equal(localJoinRes.success, true, '本地 mock 中对数值/字符串型 inviteCode 亦能双向兼容');\nconsole.log('✅ 测试 3.2: 本地高可用 Mock 库双向数值/字符串 inviteCode 兼容测试通过！');\n\n// 测试 3.3: 历史家庭无 inviteExpiredAt 或为字符串时间戳，绝不被误判为已过期\nconst histFamId = 'fam_historical_no_expiry';\nawait db.collection('families').doc(histFamId).set({\n  data: {\n    id: histFamId,\n    name: '历史无过期字段厨房',\n    creatorOpenid: 'openid_creator_hist',\n    members: [{ openid: 'openid_creator_hist', nickName: '房主', role: 'creator', joinedAt: Date.now() }],\n    memberOpenids: ['openid_creator_hist'],\n    inviteCode: '888666',\n    // 无 inviteExpiredAt 字段\n    createdAt: Date.now(),\n    updatedAt: Date.now()\n  }\n});\n\nconst joinHistRes = await familyManageModule.default.main({\n  action: 'joinFamily',\n  inviteCode: '【888666】', // 携带微信聊天中文括号\n  mockOpenid: 'openid_hist_joiner',\n  nickName: '历史加入者'\n}, {});\nassert.equal(joinHistRes.success, true, '历史无 inviteExpiredAt 字段的家庭必须能正常加入，严禁误报失效');\nassert.equal(joinHistRes.family.id, histFamId);\nassert.equal(joinHistRes.openid, 'openid_hist_joiner', 'joinFamily 返回必须包含真实 openid');\nconsole.log('✅ 测试 3.3: 历史无过期字段家庭与全角/格式化口令加入验证通过！\\n');\n\n// -------------------------------------------------------------\n// 【测试 4】新用户首次加入家庭（无 users 档案），绝不报安全防刷限频异常\n// -------------------------------------------------------------\nconsole.log('【场景 4】验证全新用户首次加入家庭时 isNotFoundError 识别与正常加入');\nif (typeof wxServerSdk.default?.resetMemoryStore === 'function') {\n  wxServerSdk.default.resetMemoryStore();\n}\n\n// 创建一个正常云端家庭\nconst createCloudFam = await familyManageModule.default.main({\n  action: 'createFamily',\n  name: '云端幸福厨房',\n  mockOpenid: 'openid_cloud_dad',\n  nickName: '爸爸'\n}, {});\nassert.equal(createCloudFam.success, true);\nconst cloudInviteCode = createCloudFam.family.inviteCode;\n\n// 模拟全新微信用户（users 集合中毫无记录，微信底层抛出包含 errMsg 的 plain object）\nconst freshOpenid = 'openid_fresh_new_user_123';\nconst freshJoinRes = await familyManageModule.default.main({\n  action: 'joinFamily',\n  inviteCode: cloudInviteCode,\n  mockOpenid: freshOpenid,\n  nickName: '全新女儿'\n}, {});\n\nassert.equal(freshJoinRes.success, true, '全新用户首次加入家庭必须顺利成功');\nassert.equal(freshJoinRes.family.members.length, 2, '家庭成员数应变为 2');\nassert(freshJoinRes.family.members.some(m => m.openid === freshOpenid), '新成员必须在家庭成员列表中');\nconsole.log('✅ 测试 4: 全新用户首次加入家庭无任何 false-positive 限频报错，顺利加入成功！\\n');\n\n// -------------------------------------------------------------\n// 【测试 5】跨模式与降级状态穿透互通机制\n// -------------------------------------------------------------\nconsole.log('【场景 5】验证用户在降级模式下向真实云端穿透加入家人厨房');\n\n// 场景 5.1: 房主在云端创建了家庭\nconst cloudCreatorOpenid = 'openid_real_cloud_owner';\nconst cloudKitchenRes = await familyManageModule.default.main({\n  action: 'createFamily',\n  name: '云端姥姥的小院',\n  mockOpenid: cloudCreatorOpenid,\n  nickName: '姥姥'\n}, {});\nassert(cloudKitchenRes.success);\nconst cloudGrandmaCode = cloudKitchenRes.family.inviteCode;\n\n// 场景 5.2: 加入者此前因为偶发网络异常，isCloudAvailable 被置为 false（降级模式运行）\ncloudService.setForceMock(false);\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    // 转发给实际云函数模拟真实云端环境\n    if (name === 'familyManage') {\n      return { result: await familyManageModule.default.main(data, {}) };\n    }\n    return { result: { success: false } };\n  }\n};\n\n// 显式将客户端标记为本地降级模式\ncloudService.resetAvailability();\n// 模拟一次环境不可用将 isCloudAvailable 锁为 false\ntry {\n  await cloudService.callFunction('familyManage', {\n    action: 'probe',\n    _simulateErr: true\n  });\n} catch (e) {}\n\n// 在 familyService 中执行加入家人家庭\nfamilyService.setMockCurrentUser('openid_grandson', '外孙');\n// 清空本地 mock 库，确保本地没有姥姥的家庭\ncloudService.getMockDb().clearAll();\n\nconst grandsonJoinRes = await familyService.joinFamily(cloudGrandmaCode);\nassert.equal(grandsonJoinRes.success, true, '降级状态下加入云端家庭应成功通过穿透探测加入');\nassert.equal(grandsonJoinRes.family.name, '云端姥姥的小院');\nassert.equal(cloudService.checkCloudAvailability(), true, '穿透云端成功后，云端可用性标识应自动自愈恢复为 true');\nconsole.log('✅ 测试 5.1: 降级模式用户加入家人云端厨房时成功穿透并自动恢复云端可用性！');\n\n// 场景 5.3: 房主如果在本地离线创建了家庭，上线鉴权 syncUserAuth 时自动补全注册到云端\ncloudService.getMockDb().clearAll();\nfamilyService.setMockCurrentUser('openid_offline_mom', '妈妈');\n// 本地创建家庭\nconst localMomFam = await familyService.createFamily('离线妈妈的爱心食堂');\nassert(localMomFam.success);\nconst localMomCode = localMomFam.family.inviteCode;\n\n// 执行 syncUserAuth，验证是否自动向云端静默补全注册\nglobal.wx.cloud.callFunction = async ({ name, data }) => {\n  if (name === 'userAuth') {\n    return {\n      result: {\n        success: true,\n        openid: data.mockOpenid,\n        user: { openid: data.mockOpenid, familyId: null, role: null },\n        family: null // 云端暂无\n      }\n    };\n  }\n  if (name === 'familyManage' && data.action === 'createFamily') {\n    return {\n      result: await familyManageModule.default.main(data, {})\n    };\n  }\n  return { result: { success: true } };\n};\n\nawait familyService.syncUserAuth();\n// 等待 promise 微任务执行\nawait new Promise(r => setTimeout(r, 50));\n\n// 验证云端现在已经有了妈妈的家庭并且 inviteCode 完全一致\nconst queryMomCloudRes = await familyManageModule.default.main({\n  action: 'joinFamily',\n  inviteCode: localMomCode,\n  mockOpenid: 'openid_kid_user',\n  nickName: '孩子'\n}, {});\nassert.equal(queryMomCloudRes.success, true, '房主本地离线家庭在 syncUserAuth 后已成功补全同步至云端，家人凭原口令可直接加入！');\nconsole.log('✅ 测试 5.2: 房主本地创建家庭在联网鉴权时自动补全云端注册，家人可凭同一口令顺利加入！\\n');\n\n// -------------------------------------------------------------\n// 【测试 6】复制口令类型防崩溃验证\n// -------------------------------------------------------------\nconsole.log('【场景 6】验证复制口令 wx.setClipboardData 传参必为字符串');\nlet registeredMinePage = null;\nglobal.Page = (cfg) => { registeredMinePage = cfg; };\nawait import('../miniprogram/pages/mine/index.js');\nassert(registeredMinePage && registeredMinePage.handleCopyInviteCode);\n\n// 模拟 family.inviteCode 为数值型\nregisteredMinePage.data = {\n  ...registeredMinePage.data,\n  family: { inviteCode: 998877 }\n};\nclipboardData = null;\nregisteredMinePage.handleCopyInviteCode();\nassert.equal(clipboardData, '998877', '复制口令无论源数据为数字或字符串，传递给 wx.setClipboardData 必须为合法字符串');\nconsole.log('✅ 测试 6: handleCopyInviteCode 确保 data 为纯字符串，杜绝微信原生报参数类型错误！\\n');\n\n// -------------------------------------------------------------\n// 【测试 7】前端页面输入框净化返回值与防重复提交并发锁验证\n// -------------------------------------------------------------\nconsole.log('【场景 7】验证 mine 页面输入框净化返回值与防重提交锁');\nassert(registeredMinePage.handleJoinCodeInput, 'mine 页面必须实现 handleJoinCodeInput');\nassert(registeredMinePage.handleJoinFamily, 'mine 页面必须实现 handleJoinFamily');\n\n// 测试 handleJoinCodeInput 返回净化后字符串 (供微信原生 input 同步替换)\nlet mockPageContext = {\n  data: { joinCodeInput: '', isJoiningFamily: false },\n  isSubmittingJoin: false,\n  formatErrorTip: registeredMinePage.formatErrorTip,\n  setData(obj) { Object.assign(this.data, obj); }\n};\nconst cleanedRet = registeredMinePage.handleJoinCodeInput.call(mockPageContext, {\n  detail: { value: '  口令是：482915！ ' }\n});\nassert.equal(cleanedRet, '482915', 'handleJoinCodeInput 必须返回提取出的 6 位纯数字口令');\nassert.equal(mockPageContext.data.joinCodeInput, '482915', 'page data.joinCodeInput 必须同步为提取口令');\n\n// 验证防重复点击 (isSubmittingJoin)\nlet joinCallCount = 0;\nconst originalJoinFamily = familyService.joinFamily;\nfamilyService.joinFamily = async () => {\n  joinCallCount++;\n  await new Promise(r => setTimeout(r, 20));\n  return { success: true };\n};\n\nmockPageContext.data.joinCodeInput = '482915';\nconst p1 = registeredMinePage.handleJoinFamily.call(mockPageContext);\nconst p2 = registeredMinePage.handleJoinFamily.call(mockPageContext);\nawait Promise.all([p1, p2]);\n\nassert.equal(joinCallCount, 1, '快速连击加入按钮时必须被防重提交锁拦截，严防并发事务冲突');\nassert.equal(mockPageContext.isSubmittingJoin, false, '完成后防重提交锁必须成功复位');\nfamilyService.joinFamily = originalJoinFamily;\nconsole.log('✅ 测试 7: handleJoinCodeInput 同步返回值与防并发点击锁验证通过！\\n');\n\nconsole.log('===============================================================');\nconsole.log('🎉 全部 7 大场景专项测试 100% 成功通过！加入家人厨房故障已彻底根除！');\nconsole.log('===============================================================\\n');\n","numLines":345,"startLine":1,"totalLines":345}}}
