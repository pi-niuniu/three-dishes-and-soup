{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfkdL3iy5VUhkkTmeeT4n","type":"message","role":"assistant","content":[{"type":"text","text":"Now `userAuth`: stop treating any read error as \"new user\" (which overwrote the profile) and stop wiping familyId on transient errors."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":617,"cache_read_input_tokens":115457,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":617},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"0a747f7a-45c7-42cf-8a97-e035a729518d","timestamp":"2026-10-06T07:57:24.457Z","request_id":"req_011CfkdL3NPAMN7o5t59miX4"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfkdL3iy5VUhkkTmeeT4n","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NeGwJLFTz4TrRUVtGRN6wV","name":"Write","input":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/userAuth/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\nconst REQUIRED_COLLECTIONS = ['users', 'families', 'dishes', 'meals'];\nlet collectionsReady = false;\n\n/**\n * 集合自愈创建：新环境未手动建表时自动创建，createCollection 报错时用 count() 确认是否已存在；\n * 任一集合未确认就绪则下次调用继续重试\n */\nasync function ensureCollections(force = false) {\n  if (collectionsReady && !force) return;\n  if (typeof db.createCollection !== 'function') {\n    collectionsReady = true;\n    return;\n  }\n  let allReady = true;\n  for (const name of REQUIRED_COLLECTIONS) {\n    try {\n      await db.createCollection(name);\n    } catch (createErr) {\n      try {\n        await db.collection(name).count();\n      } catch (probeErr) {\n        allReady = false;\n        console.error(`[userAuth] 集合 ${name} 自愈创建失败:`, createErr, probeErr);\n      }\n    }\n  }\n  collectionsReady = allReady;\n}\n\nfunction getErrText(err) {\n  return String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n}\n\n/**\n * 判断是否为集合（表）不存在错误\n */\nfunction isCollectionNotExistError(err) {\n  if (!err) return false;\n  const msg = getErrText(err);\n  return (\n    msg.includes('collection not exist') ||\n    msg.includes('collection_not_exist') ||\n    msg.includes('table not exist') ||\n    msg.includes('db or table not exist')\n  );\n}\n\n/**\n * 判断是否为文档不存在（集合缺失不算，需要先自愈建表）\n */\nfunction isDocNotFoundError(err) {\n  if (!err || isCollectionNotExistError(err)) return false;\n  const code = err?.errCode ?? err?.code;\n  if (code === -502005 || String(code) === '-502005') return true;\n  const msg = getErrText(err);\n  return msg.includes('does not exist') || msg.includes('not exist') || msg.includes('not found');\n}\n\nasync function handleAuth(event, openid) {\n  const now = Date.now();\n  const userDocRef = db.collection('users').doc(`user_${openid}`);\n  let user = null;\n\n  try {\n    const res = await userDocRef.get();\n    user = res.data;\n  } catch (e) {\n    // 仅「文档不存在」才视为首次访问建档；超时等异常必须抛出，严禁用空档案覆盖已有家庭归属\n    if (!isDocNotFoundError(e)) throw e;\n  }\n\n  if (!user) {\n    const userData = {\n      openid,\n      nickName: event.nickName || '家人',\n      avatarUrl: event.avatarUrl || '',\n      familyId: null,\n      role: null,\n      createdAt: now,\n      updatedAt: now\n    };\n    await userDocRef.set({ data: userData });\n    user = { _id: `user_${openid}`, ...userData };\n  } else if (event.nickName || event.avatarUrl) {\n    // 更新昵称/头像\n    const updateData = { updatedAt: now };\n    if (event.nickName) updateData.nickName = event.nickName;\n    if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n    await userDocRef.update({ data: updateData });\n    user = { ...user, ...updateData };\n  }\n\n  // 若绑定了家庭，获取家庭最新信息\n  let family = null;\n  let familyFetchError = false;\n  if (user.familyId) {\n    let famData = null;\n    try {\n      const famRes = await db.collection('families').doc(user.familyId).get();\n      famData = (famRes && famRes.data) ? famRes.data : null;\n    } catch (err) {\n      if (!isDocNotFoundError(err)) {\n        // 瞬时异常：保留用户的家庭归属，告知客户端本次未能拉取，客户端保留本地缓存\n        console.warn('[userAuth] 获取用户所属家庭异常，保留归属不重置:', err);\n        familyFetchError = true;\n      }\n    }\n\n    const isStillMember = famData && (\n      (famData.memberOpenids || []).includes(openid) ||\n      (famData.members || []).some(m => m.openid === openid)\n    );\n\n    if (isStillMember) {\n      family = {\n        id: famData._id || user.familyId,\n        _id: famData._id || user.familyId,\n        ...famData\n      };\n      const expectedRole = famData.creatorOpenid === openid ? 'creator' : 'member';\n      if (user.role !== expectedRole) {\n        await userDocRef.update({ data: { role: expectedRole, updatedAt: now } }).catch(() => {});\n        user = { ...user, role: expectedRole };\n      }\n    } else if (!familyFetchError) {\n      // 家庭已解散或本人已被移出：重置用户的家庭归属\n      await userDocRef.update({\n        data: { familyId: null, role: null, updatedAt: now }\n      });\n      user = { ...user, familyId: null, role: null };\n    }\n  }\n\n  return {\n    success: true,\n    openid,\n    user,\n    family,\n    familyFetchError\n  };\n}\n\n/**\n * userAuth 云函数：用户静默鉴权与档案获取\n */\nexports.main = async (event, context) => {\n  await ensureCollections();\n\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  try {\n    return await handleAuth(event, openid);\n  } catch (err) {\n    if (isCollectionNotExistError(err)) {\n      console.warn('[userAuth] 检测到集合不存在，自愈建表后重试:', err);\n      await ensureCollections(true);\n      try {\n        return await handleAuth(event, openid);\n      } catch (retryErr) {\n        return { success: false, error: retryErr?.message || '用户鉴权失败' };\n      }\n    }\n    return {\n      success: false,\n      error: err?.message || '用户鉴权失败'\n    };\n  }\n};\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":617,"cache_read_input_tokens":115457,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":617},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"05238d38-22ea-4f87-ae81-22be9753339e","timestamp":"2026-10-06T07:57:40.281Z","request_id":"req_011CfkdL3NPAMN7o5t59miX4","wire_tool_inputs":{"toolu_01NeGwJLFTz4TrRUVtGRN6wV":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/userAuth/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\nconst REQUIRED_COLLECTIONS = ['users', 'families', 'dishes', 'meals'];\nlet collectionsReady = false;\n\n/**\n * 集合自愈创建：新环境未手动建表时自动创建，createCollection 报错时用 count() 确认是否已存在；\n * 任一集合未确认就绪则下次调用继续重试\n */\nasync function ensureCollections(force = false) {\n  if (collectionsReady && !force) return;\n  if (typeof db.createCollection !== 'function') {\n    collectionsReady = true;\n    return;\n  }\n  let allReady = true;\n  for (const name of REQUIRED_COLLECTIONS) {\n    try {\n      await db.createCollection(name);\n    } catch (createErr) {\n      try {\n        await db.collection(name).count();\n      } catch (probeErr) {\n        allReady = false;\n        console.error(`[userAuth] 集合 ${name} 自愈创建失败:`, createErr, probeErr);\n      }\n    }\n  }\n  collectionsReady = allReady;\n}\n\nfunction getErrText(err) {\n  return String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n}\n\n/**\n * 判断是否为集合（表）不存在错误\n */\nfunction isCollectionNotExistError(err) {\n  if (!err) return false;\n  const msg = getErrText(err);\n  return (\n    msg.includes('collection not exist') ||\n    msg.includes('collection_not_exist') ||\n    msg.includes('table not exist') ||\n    msg.includes('db or table not exist')\n  );\n}\n\n/**\n * 判断是否为文档不存在（集合缺失不算，需要先自愈建表）\n */\nfunction isDocNotFoundError(err) {\n  if (!err || isCollectionNotExistError(err)) return false;\n  const code = err?.errCode ?? err?.code;\n  if (code === -502005 || String(code) === '-502005') return true;\n  const msg = getErrText(err);\n  return msg.includes('does not exist') || msg.includes('not exist') || msg.includes('not found');\n}\n\nasync function handleAuth(event, openid) {\n  const now = Date.now();\n  const userDocRef = db.collection('users').doc(`user_${openid}`);\n  let user = null;\n\n  try {\n    const res = await userDocRef.get();\n    user = res.data;\n  } catch (e) {\n    // 仅「文档不存在」才视为首次访问建档；超时等异常必须抛出，严禁用空档案覆盖已有家庭归属\n    if (!isDocNotFoundError(e)) throw e;\n  }\n\n  if (!user) {\n    const userData = {\n      openid,\n      nickName: event.nickName || '家人',\n      avatarUrl: event.avatarUrl || '',\n      familyId: null,\n      role: null,\n      createdAt: now,\n      updatedAt: now\n    };\n    await userDocRef.set({ data: userData });\n    user = { _id: `user_${openid}`, ...userData };\n  } else if (event.nickName || event.avatarUrl) {\n    // 更新昵称/头像\n    const updateData = { updatedAt: now };\n    if (event.nickName) updateData.nickName = event.nickName;\n    if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n    await userDocRef.update({ data: updateData });\n    user = { ...user, ...updateData };\n  }\n\n  // 若绑定了家庭，获取家庭最新信息\n  let family = null;\n  let familyFetchError = false;\n  if (user.familyId) {\n    let famData = null;\n    try {\n      const famRes = await db.collection('families').doc(user.familyId).get();\n      famData = (famRes && famRes.data) ? famRes.data : null;\n    } catch (err) {\n      if (!isDocNotFoundError(err)) {\n        // 瞬时异常：保留用户的家庭归属，告知客户端本次未能拉取，客户端保留本地缓存\n        console.warn('[userAuth] 获取用户所属家庭异常，保留归属不重置:', err);\n        familyFetchError = true;\n      }\n    }\n\n    const isStillMember = famData && (\n      (famData.memberOpenids || []).includes(openid) ||\n      (famData.members || []).some(m => m.openid === openid)\n    );\n\n    if (isStillMember) {\n      family = {\n        id: famData._id || user.familyId,\n        _id: famData._id || user.familyId,\n        ...famData\n      };\n      const expectedRole = famData.creatorOpenid === openid ? 'creator' : 'member';\n      if (user.role !== expectedRole) {\n        await userDocRef.update({ data: { role: expectedRole, updatedAt: now } }).catch(() => {});\n        user = { ...user, role: expectedRole };\n      }\n    } else if (!familyFetchError) {\n      // 家庭已解散或本人已被移出：重置用户的家庭归属\n      await userDocRef.update({\n        data: { familyId: null, role: null, updatedAt: now }\n      });\n      user = { ...user, familyId: null, role: null };\n    }\n  }\n\n  return {\n    success: true,\n    openid,\n    user,\n    family,\n    familyFetchError\n  };\n}\n\n/**\n * userAuth 云函数：用户静默鉴权与档案获取\n */\nexports.main = async (event, context) => {\n  await ensureCollections();\n\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  try {\n    return await handleAuth(event, openid);\n  } catch (err) {\n    if (isCollectionNotExistError(err)) {\n      console.warn('[userAuth] 检测到集合不存在，自愈建表后重试:', err);\n      await ensureCollections(true);\n      try {\n        return await handleAuth(event, openid);\n      } catch (retryErr) {\n        return { success: false, error: retryErr?.message || '用户鉴权失败' };\n      }\n    }\n    return {\n      success: false,\n      error: err?.message || '用户鉴权失败'\n    };\n  }\n};\n"}}}
