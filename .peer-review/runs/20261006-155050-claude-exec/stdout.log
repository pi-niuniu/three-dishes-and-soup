{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017DcggNLxpa7cXrJGZkzGFJ","type":"tool_result","content":"The file /Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"005f52e8-94b1-42ad-9f33-83043e1df802","timestamp":"2026-10-06T07:55:42.796Z","tool_use_result":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","oldString":"      console.error('[familyManage] msgSecCheck 异常:', err);\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };","newString":"      console.error('[familyManage] msgSecCheck 异常:', err);\n      if (options.failOpenOnServiceError) {\n        return { pass: true };\n      }\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };","originalFile":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n/**\n * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n * failOpenOnServiceError：msgSecCheck 服务自身异常（如 openapi 权限未随云函数部署）时，\n * 在本地敏感词已通过的前提下放行，避免检测服务故障阻断家人加入\n */\nasync function checkTextSecurity(text, openid, options = {}) {\n  if (!text) return { pass: true };\n  const str = String(text).trim();\n  if (!str) return { pass: true };\n\n  // 1. 本地兜底敏感词拦截\n  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n  }\n\n  // 2. 微信官方 msgSecCheck 2.0 规范检测\n  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    try {\n      const res = await cloud.openapi.security.msgSecCheck({\n        version: 2,\n        scene: 1, // 1: 资料/昵称/家庭名称等\n        openid,\n        content: str\n      });\n      if (!res || !res.result || res.result.suggest !== 'pass') {\n        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n      }\n    } catch (err) {\n      console.error('[familyManage] msgSecCheck 异常:', err);\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n    }\n  }\n\n  return { pass: true };\n}\n\n/**\n * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n */\nasync function generateUniqueInviteCode() {\n  const now = Date.now();\n  for (let attempt = 0; attempt < 10; attempt++) {\n    const code = String(Math.floor(100000 + Math.random() * 900000));\n    const existing = await db.collection('families').where({\n      inviteCode: code,\n      inviteExpiredAt: _.gt(now)\n    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {\n      return code;\n    }\n  }\n  return String(Math.floor(100000 + Math.random() * 900000));\n}\n\n/**\n * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n */\nfunction normalizeInviteCode(input) {\n  if (!input) return '';\n  let str = String(input).trim();\n  // 全角数字转换为半角 (０-９ -> 0-9)\n  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n  // 提取纯数字\n  const digits = str.replace(/\\D/g, '');\n  if (digits.length === 6) return digits;\n  if (digits.length > 6) {\n    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n    if (match) return match[0];\n  }\n  return digits.slice(0, 6);\n}\n\nconst JOIN_RATE_LIMIT = {\n  MAX_FAILURES: 5,\n  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n};\n\n/**\n * 判断云开发数据库错误是否为文档不存在\n */\nfunction isNotFoundError(err) {\n  if (!err) return false;\n  const code = err?.errCode ?? err?.code;\n  if (code === -502005 || String(code) === '-502005') return true;\n  const msg = String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n  return (\n    msg.includes('does not exist') ||\n    msg.includes('not exist') ||\n    msg.includes('not found') ||\n    msg.includes('-502005')\n  );\n}\n\n/**\n * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n * 严格 fail-closed：查询异常时拒绝放行\n */\nasync function checkJoinRateLimit(openid, now) {\n  try {\n    let userDoc = null;\n    try {\n      userDoc = await db.collection('users').doc(`user_${openid}`).get();\n    } catch (docErr) {\n      // 用户文档尚不存在属于正常初次状态，不当作异常\n      if (isNotFoundError(docErr)) {\n        return { allowed: true };\n      }\n      throw docErr;\n    }\n\n    const data = userDoc?.data;\n    if (!data) return { allowed: true };\n\n    const failCount = data.joinFailCount || 0;\n    const lastFailTime = data.joinFailLastTime || 0;\n\n    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n      return { allowed: true };\n    }\n\n    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n      return {\n        allowed: false,\n        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n      };\n    }\n    return { allowed: true };\n  } catch (err) {\n    console.error('[familyManage] 检查防刷限频异常 (严格 fail-closed 拦截):', err);\n    return {\n      allowed: false,\n      error: '安全防刷限频服务异常，请稍后重试'\n    };\n  }\n}\n\n/**\n * 记录一次加入失败尝试 (在事务内原子更新失败计数与时间戳，防止并发竞态丢失计数)\n */\nasync function recordJoinFailure(openid, now) {\n  try {\n    await db.runTransaction(async transaction => {\n      const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n      let userRes = null;\n      try {\n        userRes = await userDocRef.get();\n      } catch (err) {\n        if (!isNotFoundError(err)) {\n          throw err;\n        }\n      }\n\n      const data = userRes?.data;\n      const lastFailTime = data?.joinFailLastTime || 0;\n      const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n      const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n\n      if (data) {\n        await userDocRef.update({\n          data: {\n            joinFailCount: newCount,\n            joinFailLastTime: now\n          }\n        });\n      } else {\n        await userDocRef.set({\n          data: {\n            openid,\n            nickName: '家人',\n            familyId: null,\n            role: null,\n            joinFailCount: newCount,\n            joinFailLastTime: now,\n            createdAt: now,\n            updatedAt: now\n          }\n        });\n      }\n    });\n  } catch (err) {\n    console.warn('[familyManage] 事务记录加入失败计数异常:', err);\n  }\n}\n\nlet collectionsChecked = false;\nasync function ensureCollections() {\n  if (collectionsChecked) return;\n  const collections = ['users', 'families', 'dishes', 'meals'];\n  for (const name of collections) {\n    try {\n      if (typeof db.createCollection === 'function') {\n        await db.createCollection(name);\n      }\n    } catch (e) {\n      // 忽略已存在或无权限错误\n    }\n  }\n  collectionsChecked = true;\n}\n\nexports.main = async (event, context) => {\n  await ensureCollections();\n\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 创建家庭空间\n       */\n      case 'createFamily': {\n        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = (event.nickName || '房主').trim();\n\n        // 安全合规校验：家庭名称与昵称\n        const nameSec = await checkTextSecurity(familyName, openid);\n        if (!nameSec.pass) return { success: false, error: nameSec.error };\n\n        const nickSec = await checkTextSecurity(nickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n        const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n          ? String(event.inviteCode).trim()\n          : null;\n        if (inviteCode) {\n          const dupRes = await db.collection('families').where({\n            inviteCode,\n            inviteExpiredAt: _.gt(now)\n          }).get().catch(() => null);\n          if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n            inviteCode = await generateUniqueInviteCode();\n          }\n        } else {\n          inviteCode = await generateUniqueInviteCode();\n        }\n        const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n          ? Number(event.inviteExpiredAt)\n          : (now + 24 * 60 * 60 * 1000); // 24小时过期\n\n        return await db.runTransaction(async transaction => {\n          const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n          \n          let user = null;\n          try {\n            const uRes = await userDocRef.get();\n            user = (uRes && uRes.data) ? uRes.data : null;\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              user = null;\n            } else {\n              console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n              throw e;\n            }\n          }\n          if (!user) {\n            user = { openid, nickName: nickName || '房主' };\n          }\n\n          // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n          if (user.familyId) {\n            try {\n              const oldFamilyId = user.familyId;\n              const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n              let oldFamRes = null;\n              try {\n                oldFamRes = await oldFamDocRef.get();\n              } catch (famErr) {\n                if (isNotFoundError(famErr)) {\n                  oldFamRes = null;\n                } else {\n                  throw famErr;\n                }\n              }\n              if (oldFamRes && oldFamRes.data) {\n                const oldFamily = oldFamRes.data;\n                const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await oldFamDocRef.remove();\n                } else {\n                  let newCreatorOpenid = oldFamily.creatorOpenid;\n                  if (oldFamily.creatorOpenid === openid) {\n                    newCreatorOpenid = remainingMembers[0].openid;\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await oldFamDocRef.update({\n                    data: {\n                      creatorOpenid: newCreatorOpenid,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            } catch (e) {\n              console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n              throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n            }\n          }\n\n          const familyData = {\n            id: familyId,\n            name: familyName,\n            creatorOpenid: openid,\n            members: [\n              {\n                openid,\n                nickName: nickName || user.nickName || '房主',\n                avatarUrl: event.avatarUrl || user.avatarUrl || '',\n                role: 'creator',\n                joinedAt: now\n              }\n            ],\n            memberOpenids: [openid],\n            inviteCode,\n            inviteExpiredAt,\n            createdAt: now,\n            updatedAt: now\n          };\n\n          // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n          await transaction.collection('families').doc(familyId).set({ data: familyData });\n\n          // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n          await transaction.collection('users').doc(`user_${openid}`).set({\n            data: {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n              familyId,\n              role: 'creator',\n              createdAt: (user && user.createdAt) || now,\n              updatedAt: now\n            }\n          });\n\n          return {\n            success: true,\n            openid,\n            family: {\n              id: familyId,\n              _id: familyId,\n              ...familyData\n            }\n          };\n        });\n      }\n\n      /**\n       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n       */\n      case 'joinFamily': {\n        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n        if (!rateLimitCheck.allowed) {\n          return { success: false, error: rateLimitCheck.error };\n        }\n\n        const cleanCode = normalizeInviteCode(event.inviteCode);\n        if (!cleanCode || cleanCode.length !== 6) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const memberNickName = (event.nickName || '家人').trim();\n        const nickSec = await checkTextSecurity(memberNickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n        const codeStr = String(cleanCode);\n        const codeNum = Number(cleanCode);\n\n        let matchedFamilies = [];\n        let queryError = null;\n\n        try {\n          const strRes = await db.collection('families').where({ inviteCode: codeStr }).get();\n          if (strRes && strRes.data && strRes.data.length > 0) {\n            matchedFamilies = matchedFamilies.concat(strRes.data);\n          }\n        } catch (err) {\n          console.warn('[familyManage] 字符串口令查询异常:', err);\n          queryError = err;\n        }\n\n        if (!isNaN(codeNum)) {\n          try {\n            const numRes = await db.collection('families').where({ inviteCode: codeNum }).get();\n            if (numRes && numRes.data && numRes.data.length > 0) {\n              for (const doc of numRes.data) {\n                const docId = doc._id || doc.id;\n                if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n                  matchedFamilies.push(doc);\n                }\n              }\n            }\n          } catch (err) {\n            console.warn('[familyManage] 数值口令查询异常:', err);\n            queryError = queryError || err;\n          }\n        }\n\n        // 如果底层数据库报错且未匹配到任何家庭，返回系统繁忙，不计入恶意失败限频\n        if (queryError && matchedFamilies.length === 0) {\n          const errMsg = String(queryError?.errMsg || queryError?.message || queryError);\n          if (errMsg.includes('collection not exist') || errMsg.includes('-502005')) {\n            return { success: false, error: '家庭数据库尚未初始化，请房主先重新创建厨房' };\n          }\n          return { success: false, error: '云端查询服务异常，请稍后重试' };\n        }\n\n        if (matchedFamilies.length === 0) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        // 筛选未过期家庭 (按更新时间倒序优先取最新)\n        matchedFamilies.sort((a, b) => (b.updatedAt || b.createdAt || 0) - (a.updatedAt || a.createdAt || 0));\n        const activeFamily = matchedFamilies.find(f => !f.inviteExpiredAt || Number(f.inviteExpiredAt) > now);\n\n        if (!activeFamily) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n        }\n\n        const targetFamilyId = activeFamily._id || activeFamily.id;\n\n        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n        try {\n          return await db.runTransaction(async transaction => {\n            let famDoc = null;\n            try {\n              famDoc = await transaction.collection('families').doc(targetFamilyId).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                famDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            if (!famDoc || !famDoc.data) {\n              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n              throw new Error('未找到该邀请口令对应的家庭厨房');\n            }\n\n            const family = famDoc.data;\n\n            // 校验 1: 口令是否已过期 (24 小时有效)\n            if (family.inviteExpiredAt && Number(family.inviteExpiredAt) <= now) {\n              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n            }\n\n            // 校验 2: 是否已经在该家庭中\n            const isAlreadyMember = (family.memberOpenids && family.memberOpenids.includes(openid)) ||\n              (family.members && family.members.some(m => m.openid === openid));\n            if (isAlreadyMember) {\n              // 确保用户档案同步归属\n              await transaction.collection('users').doc(`user_${openid}`).update({\n                data: {\n                  familyId: targetFamilyId,\n                  role: family.creatorOpenid === openid ? 'creator' : 'member',\n                  updatedAt: now\n                }\n              }).catch(() => {});\n\n              return {\n                success: true,\n                openid,\n                family: {\n                  id: family._id || targetFamilyId,\n                  _id: family._id || targetFamilyId,\n                  ...family\n                },\n                message: '您已经在该家庭厨房中'\n              };\n            }\n\n            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n            const memberCount = Math.max((family.memberOpenids || []).length, (family.members || []).length);\n            if (memberCount >= 4) {\n              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n            }\n\n            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n            let userDoc = null;\n            try {\n              userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                userDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            const oldFamilyId = userDoc?.data?.familyId;\n            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n              let oldFamDoc = null;\n              try {\n                oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get();\n              } catch (e) {\n                if (isNotFoundError(e)) {\n                  oldFamDoc = null;\n                } else {\n                  throw e;\n                }\n              }\n              if (oldFamDoc?.data) {\n                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await transaction.collection('families').doc(oldFamilyId).remove();\n                } else {\n                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n                    ? remainingMembers[0].openid\n                    : oldFamDoc.data.creatorOpenid;\n\n                  if (oldFamDoc.data.creatorOpenid === openid) {\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await transaction.collection('families').doc(oldFamilyId).update({\n                    data: {\n                      creatorOpenid: newCreator,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            }\n\n            // 加入新家庭\n            const newMember = {\n              openid,\n              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n              role: 'member',\n              joinedAt: now\n            };\n\n            const updatedMembers = [...(family.members || []), newMember];\n            const updatedOpenids = Array.from(new Set([...(family.memberOpenids || []), openid]));\n\n            await transaction.collection('families').doc(targetFamilyId).update({\n              data: {\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            });\n\n            // 更新用户档案并重置防刷计数 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n            await transaction.collection('users').doc(`user_${openid}`).set({\n              data: {\n                openid,\n                nickName: newMember.nickName,\n                avatarUrl: newMember.avatarUrl,\n                familyId: targetFamilyId,\n                role: 'member',\n                joinFailCount: 0,\n                joinFailLastTime: 0,\n                createdAt: userDoc?.data?.createdAt || now,\n                updatedAt: now\n              }\n            });\n\n            return {\n              success: true,\n              openid,\n              family: {\n                id: targetFamilyId,\n                _id: targetFamilyId,\n                ...family,\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            };\n          });\n        } catch (trxErr) {\n          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n          return {\n            success: false,\n            error: errMsg\n          };\n        }\n      }\n\n      /**\n       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n       */\n      case 'leaveFamily': {\n        return await db.runTransaction(async transaction => {\n          let userDoc = null;\n          try {\n            userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              userDoc = null;\n            } else {\n              throw e;\n            }\n          }\n          const user = userDoc?.data;\n\n          if (!user || !user.familyId) {\n            return { success: true, message: '当前未加入任何家庭' };\n          }\n\n          const familyId = user.familyId;\n          let famDoc = null;\n          try {\n            famDoc = await transaction.collection('families').doc(familyId).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              famDoc = null;\n            } else {\n              throw e;\n            }\n          }\n\n          if (famDoc && famDoc.data) {\n            const family = famDoc.data;\n            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n            if (remainingMembers.length === 0) {\n              await transaction.collection('families').doc(familyId).remove();\n            } else {\n              let newCreatorOpenid = family.creatorOpenid;\n              if (family.creatorOpenid === openid) {\n                newCreatorOpenid = remainingMembers[0].openid;\n                remainingMembers[0].role = 'creator';\n                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                  data: { role: 'creator', updatedAt: now }\n                }).catch(() => {});\n              }\n\n              await transaction.collection('families').doc(familyId).update({\n                data: {\n                  creatorOpenid: newCreatorOpenid,\n                  members: remainingMembers,\n                  memberOpenids: remainingOpenids,\n                  updatedAt: now\n                }\n              });\n            }\n          }\n\n          // 重置用户家庭归属\n          await transaction.collection('users').doc(`user_${openid}`).update({\n            data: {\n              familyId: null,\n              role: null,\n              updatedAt: now\n            }\n          });\n\n          return { success: true, message: '已退出家庭厨房空间' };\n        });\n      }\n\n      /**\n       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n       */\n      case 'refreshInviteCode': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = await generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n\n        await db.collection('families').doc(familyId).update({\n          data: {\n            inviteCode: newCode,\n            inviteExpiredAt: newExpiry,\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          inviteCode: newCode,\n          inviteExpiredAt: newExpiry\n        };\n      }\n\n      /**\n       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n       */\n      case 'getFamily': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return {\n          success: true,\n          family: {\n            id: family._id || familyId,\n            _id: family._id || familyId,\n            ...family\n          }\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n    return {\n      success: false,\n      error: errMsg\n    };\n  }\n};\n\n// 内部事务辅助：退出或重置家庭成员\nasync function leaveCurrentFamilyInternal(openid, familyId) {\n  return await db.runTransaction(async transaction => {\n    const famDocRef = transaction.collection('families').doc(familyId);\n    let famRes = null;\n    try {\n      famRes = await famDocRef.get();\n    } catch (e) {\n      if (isNotFoundError(e)) {\n        famRes = null;\n      } else {\n        throw e;\n      }\n    }\n    if (!famRes || !famRes.data) return;\n\n    const family = famRes.data;\n    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n    if (remainingMembers.length === 0) {\n      await famDocRef.remove();\n    } else {\n      let newCreatorOpenid = family.creatorOpenid;\n      if (family.creatorOpenid === openid) {\n        newCreatorOpenid = remainingMembers[0].openid;\n        remainingMembers[0].role = 'creator';\n        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n          data: { role: 'creator', updatedAt: Date.now() }\n        }).catch(() => {});\n      }\n\n      await famDocRef.update({\n        data: {\n          creatorOpenid: newCreatorOpenid,\n          members: remainingMembers,\n          memberOpenids: remainingOpenids,\n          updatedAt: Date.now()\n        }\n      });\n    }\n  });\n}\n","structuredPatch":[{"oldStart":38,"oldLines":6,"newStart":38,"newLines":9,"lines":["       }","     } catch (err) {","       console.error('[familyManage] msgSecCheck 异常:', err);","+      if (options.failOpenOnServiceError) {","+        return { pass: true };","+      }","       return { pass: false, error: '内容安全检测服务异常，请稍后重试' };","     }","   }"]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfkdByjspQ4n1WZT92Vta","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BHyUUmJMVUPhvTEAfnCrPf","name":"Edit","input":{"replace_all":false,"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","old_string":"    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {","new_string":"    }).count().catch(err => {\n      console.warn('[familyManage] 口令查重查询异常:', err);\n      return null;\n    });\n\n    if (!existing || existing.total === 0) {"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1187,"cache_read_input_tokens":94540,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1187},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"910eefca-ae83-405b-b464-38e6c8572318","timestamp":"2026-10-06T07:55:44.399Z","request_id":"req_011CfkdByLKsxXadPZEbaGzb","wire_tool_inputs":{"toolu_01BHyUUmJMVUPhvTEAfnCrPf":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","old_string":"    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {","new_string":"    }).count().catch(err => {\n      console.warn('[familyManage] 口令查重查询异常:', err);\n      return null;\n    });\n\n    if (!existing || existing.total === 0) {"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BHyUUmJMVUPhvTEAfnCrPf","type":"tool_result","content":"The file /Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"2fe541ce-5d88-4032-a69f-2924fefac4f4","timestamp":"2026-10-06T07:55:44.410Z","tool_use_result":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","oldString":"    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {","newString":"    }).count().catch(err => {\n      console.warn('[familyManage] 口令查重查询异常:', err);\n      return null;\n    });\n\n    if (!existing || existing.total === 0) {","originalFile":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n/**\n * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n * failOpenOnServiceError：msgSecCheck 服务自身异常（如 openapi 权限未随云函数部署）时，\n * 在本地敏感词已通过的前提下放行，避免检测服务故障阻断家人加入\n */\nasync function checkTextSecurity(text, openid, options = {}) {\n  if (!text) return { pass: true };\n  const str = String(text).trim();\n  if (!str) return { pass: true };\n\n  // 1. 本地兜底敏感词拦截\n  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n  }\n\n  // 2. 微信官方 msgSecCheck 2.0 规范检测\n  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    try {\n      const res = await cloud.openapi.security.msgSecCheck({\n        version: 2,\n        scene: 1, // 1: 资料/昵称/家庭名称等\n        openid,\n        content: str\n      });\n      if (!res || !res.result || res.result.suggest !== 'pass') {\n        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n      }\n    } catch (err) {\n      console.error('[familyManage] msgSecCheck 异常:', err);\n      if (options.failOpenOnServiceError) {\n        return { pass: true };\n      }\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n    }\n  }\n\n  return { pass: true };\n}\n\n/**\n * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n */\nasync function generateUniqueInviteCode() {\n  const now = Date.now();\n  for (let attempt = 0; attempt < 10; attempt++) {\n    const code = String(Math.floor(100000 + Math.random() * 900000));\n    const existing = await db.collection('families').where({\n      inviteCode: code,\n      inviteExpiredAt: _.gt(now)\n    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {\n      return code;\n    }\n  }\n  return String(Math.floor(100000 + Math.random() * 900000));\n}\n\n/**\n * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n */\nfunction normalizeInviteCode(input) {\n  if (!input) return '';\n  let str = String(input).trim();\n  // 全角数字转换为半角 (０-９ -> 0-9)\n  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n  // 提取纯数字\n  const digits = str.replace(/\\D/g, '');\n  if (digits.length === 6) return digits;\n  if (digits.length > 6) {\n    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n    if (match) return match[0];\n  }\n  return digits.slice(0, 6);\n}\n\nconst JOIN_RATE_LIMIT = {\n  MAX_FAILURES: 5,\n  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n};\n\n/**\n * 判断云开发数据库错误是否为文档不存在\n */\nfunction isNotFoundError(err) {\n  if (!err) return false;\n  const code = err?.errCode ?? err?.code;\n  if (code === -502005 || String(code) === '-502005') return true;\n  const msg = String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n  return (\n    msg.includes('does not exist') ||\n    msg.includes('not exist') ||\n    msg.includes('not found') ||\n    msg.includes('-502005')\n  );\n}\n\n/**\n * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n * 严格 fail-closed：查询异常时拒绝放行\n */\nasync function checkJoinRateLimit(openid, now) {\n  try {\n    let userDoc = null;\n    try {\n      userDoc = await db.collection('users').doc(`user_${openid}`).get();\n    } catch (docErr) {\n      // 用户文档尚不存在属于正常初次状态，不当作异常\n      if (isNotFoundError(docErr)) {\n        return { allowed: true };\n      }\n      throw docErr;\n    }\n\n    const data = userDoc?.data;\n    if (!data) return { allowed: true };\n\n    const failCount = data.joinFailCount || 0;\n    const lastFailTime = data.joinFailLastTime || 0;\n\n    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n      return { allowed: true };\n    }\n\n    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n      return {\n        allowed: false,\n        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n      };\n    }\n    return { allowed: true };\n  } catch (err) {\n    console.error('[familyManage] 检查防刷限频异常 (严格 fail-closed 拦截):', err);\n    return {\n      allowed: false,\n      error: '安全防刷限频服务异常，请稍后重试'\n    };\n  }\n}\n\n/**\n * 记录一次加入失败尝试 (在事务内原子更新失败计数与时间戳，防止并发竞态丢失计数)\n */\nasync function recordJoinFailure(openid, now) {\n  try {\n    await db.runTransaction(async transaction => {\n      const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n      let userRes = null;\n      try {\n        userRes = await userDocRef.get();\n      } catch (err) {\n        if (!isNotFoundError(err)) {\n          throw err;\n        }\n      }\n\n      const data = userRes?.data;\n      const lastFailTime = data?.joinFailLastTime || 0;\n      const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n      const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n\n      if (data) {\n        await userDocRef.update({\n          data: {\n            joinFailCount: newCount,\n            joinFailLastTime: now\n          }\n        });\n      } else {\n        await userDocRef.set({\n          data: {\n            openid,\n            nickName: '家人',\n            familyId: null,\n            role: null,\n            joinFailCount: newCount,\n            joinFailLastTime: now,\n            createdAt: now,\n            updatedAt: now\n          }\n        });\n      }\n    });\n  } catch (err) {\n    console.warn('[familyManage] 事务记录加入失败计数异常:', err);\n  }\n}\n\nlet collectionsChecked = false;\nasync function ensureCollections() {\n  if (collectionsChecked) return;\n  const collections = ['users', 'families', 'dishes', 'meals'];\n  for (const name of collections) {\n    try {\n      if (typeof db.createCollection === 'function') {\n        await db.createCollection(name);\n      }\n    } catch (e) {\n      // 忽略已存在或无权限错误\n    }\n  }\n  collectionsChecked = true;\n}\n\nexports.main = async (event, context) => {\n  await ensureCollections();\n\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 创建家庭空间\n       */\n      case 'createFamily': {\n        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = (event.nickName || '房主').trim();\n\n        // 安全合规校验：家庭名称与昵称\n        const nameSec = await checkTextSecurity(familyName, openid);\n        if (!nameSec.pass) return { success: false, error: nameSec.error };\n\n        const nickSec = await checkTextSecurity(nickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n        const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n          ? String(event.inviteCode).trim()\n          : null;\n        if (inviteCode) {\n          const dupRes = await db.collection('families').where({\n            inviteCode,\n            inviteExpiredAt: _.gt(now)\n          }).get().catch(() => null);\n          if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n            inviteCode = await generateUniqueInviteCode();\n          }\n        } else {\n          inviteCode = await generateUniqueInviteCode();\n        }\n        const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n          ? Number(event.inviteExpiredAt)\n          : (now + 24 * 60 * 60 * 1000); // 24小时过期\n\n        return await db.runTransaction(async transaction => {\n          const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n          \n          let user = null;\n          try {\n            const uRes = await userDocRef.get();\n            user = (uRes && uRes.data) ? uRes.data : null;\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              user = null;\n            } else {\n              console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n              throw e;\n            }\n          }\n          if (!user) {\n            user = { openid, nickName: nickName || '房主' };\n          }\n\n          // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n          if (user.familyId) {\n            try {\n              const oldFamilyId = user.familyId;\n              const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n              let oldFamRes = null;\n              try {\n                oldFamRes = await oldFamDocRef.get();\n              } catch (famErr) {\n                if (isNotFoundError(famErr)) {\n                  oldFamRes = null;\n                } else {\n                  throw famErr;\n                }\n              }\n              if (oldFamRes && oldFamRes.data) {\n                const oldFamily = oldFamRes.data;\n                const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await oldFamDocRef.remove();\n                } else {\n                  let newCreatorOpenid = oldFamily.creatorOpenid;\n                  if (oldFamily.creatorOpenid === openid) {\n                    newCreatorOpenid = remainingMembers[0].openid;\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await oldFamDocRef.update({\n                    data: {\n                      creatorOpenid: newCreatorOpenid,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            } catch (e) {\n              console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n              throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n            }\n          }\n\n          const familyData = {\n            id: familyId,\n            name: familyName,\n            creatorOpenid: openid,\n            members: [\n              {\n                openid,\n                nickName: nickName || user.nickName || '房主',\n                avatarUrl: event.avatarUrl || user.avatarUrl || '',\n                role: 'creator',\n                joinedAt: now\n              }\n            ],\n            memberOpenids: [openid],\n            inviteCode,\n            inviteExpiredAt,\n            createdAt: now,\n            updatedAt: now\n          };\n\n          // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n          await transaction.collection('families').doc(familyId).set({ data: familyData });\n\n          // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n          await transaction.collection('users').doc(`user_${openid}`).set({\n            data: {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n              familyId,\n              role: 'creator',\n              createdAt: (user && user.createdAt) || now,\n              updatedAt: now\n            }\n          });\n\n          return {\n            success: true,\n            openid,\n            family: {\n              id: familyId,\n              _id: familyId,\n              ...familyData\n            }\n          };\n        });\n      }\n\n      /**\n       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n       */\n      case 'joinFamily': {\n        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n        if (!rateLimitCheck.allowed) {\n          return { success: false, error: rateLimitCheck.error };\n        }\n\n        const cleanCode = normalizeInviteCode(event.inviteCode);\n        if (!cleanCode || cleanCode.length !== 6) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const memberNickName = (event.nickName || '家人').trim();\n        const nickSec = await checkTextSecurity(memberNickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n        const codeStr = String(cleanCode);\n        const codeNum = Number(cleanCode);\n\n        let matchedFamilies = [];\n        let queryError = null;\n\n        try {\n          const strRes = await db.collection('families').where({ inviteCode: codeStr }).get();\n          if (strRes && strRes.data && strRes.data.length > 0) {\n            matchedFamilies = matchedFamilies.concat(strRes.data);\n          }\n        } catch (err) {\n          console.warn('[familyManage] 字符串口令查询异常:', err);\n          queryError = err;\n        }\n\n        if (!isNaN(codeNum)) {\n          try {\n            const numRes = await db.collection('families').where({ inviteCode: codeNum }).get();\n            if (numRes && numRes.data && numRes.data.length > 0) {\n              for (const doc of numRes.data) {\n                const docId = doc._id || doc.id;\n                if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n                  matchedFamilies.push(doc);\n                }\n              }\n            }\n          } catch (err) {\n            console.warn('[familyManage] 数值口令查询异常:', err);\n            queryError = queryError || err;\n          }\n        }\n\n        // 如果底层数据库报错且未匹配到任何家庭，返回系统繁忙，不计入恶意失败限频\n        if (queryError && matchedFamilies.length === 0) {\n          const errMsg = String(queryError?.errMsg || queryError?.message || queryError);\n          if (errMsg.includes('collection not exist') || errMsg.includes('-502005')) {\n            return { success: false, error: '家庭数据库尚未初始化，请房主先重新创建厨房' };\n          }\n          return { success: false, error: '云端查询服务异常，请稍后重试' };\n        }\n\n        if (matchedFamilies.length === 0) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        // 筛选未过期家庭 (按更新时间倒序优先取最新)\n        matchedFamilies.sort((a, b) => (b.updatedAt || b.createdAt || 0) - (a.updatedAt || a.createdAt || 0));\n        const activeFamily = matchedFamilies.find(f => !f.inviteExpiredAt || Number(f.inviteExpiredAt) > now);\n\n        if (!activeFamily) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n        }\n\n        const targetFamilyId = activeFamily._id || activeFamily.id;\n\n        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n        try {\n          return await db.runTransaction(async transaction => {\n            let famDoc = null;\n            try {\n              famDoc = await transaction.collection('families').doc(targetFamilyId).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                famDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            if (!famDoc || !famDoc.data) {\n              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n              throw new Error('未找到该邀请口令对应的家庭厨房');\n            }\n\n            const family = famDoc.data;\n\n            // 校验 1: 口令是否已过期 (24 小时有效)\n            if (family.inviteExpiredAt && Number(family.inviteExpiredAt) <= now) {\n              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n            }\n\n            // 校验 2: 是否已经在该家庭中\n            const isAlreadyMember = (family.memberOpenids && family.memberOpenids.includes(openid)) ||\n              (family.members && family.members.some(m => m.openid === openid));\n            if (isAlreadyMember) {\n              // 确保用户档案同步归属\n              await transaction.collection('users').doc(`user_${openid}`).update({\n                data: {\n                  familyId: targetFamilyId,\n                  role: family.creatorOpenid === openid ? 'creator' : 'member',\n                  updatedAt: now\n                }\n              }).catch(() => {});\n\n              return {\n                success: true,\n                openid,\n                family: {\n                  id: family._id || targetFamilyId,\n                  _id: family._id || targetFamilyId,\n                  ...family\n                },\n                message: '您已经在该家庭厨房中'\n              };\n            }\n\n            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n            const memberCount = Math.max((family.memberOpenids || []).length, (family.members || []).length);\n            if (memberCount >= 4) {\n              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n            }\n\n            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n            let userDoc = null;\n            try {\n              userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                userDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            const oldFamilyId = userDoc?.data?.familyId;\n            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n              let oldFamDoc = null;\n              try {\n                oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get();\n              } catch (e) {\n                if (isNotFoundError(e)) {\n                  oldFamDoc = null;\n                } else {\n                  throw e;\n                }\n              }\n              if (oldFamDoc?.data) {\n                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await transaction.collection('families').doc(oldFamilyId).remove();\n                } else {\n                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n                    ? remainingMembers[0].openid\n                    : oldFamDoc.data.creatorOpenid;\n\n                  if (oldFamDoc.data.creatorOpenid === openid) {\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await transaction.collection('families').doc(oldFamilyId).update({\n                    data: {\n                      creatorOpenid: newCreator,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            }\n\n            // 加入新家庭\n            const newMember = {\n              openid,\n              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n              role: 'member',\n              joinedAt: now\n            };\n\n            const updatedMembers = [...(family.members || []), newMember];\n            const updatedOpenids = Array.from(new Set([...(family.memberOpenids || []), openid]));\n\n            await transaction.collection('families').doc(targetFamilyId).update({\n              data: {\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            });\n\n            // 更新用户档案并重置防刷计数 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n            await transaction.collection('users').doc(`user_${openid}`).set({\n              data: {\n                openid,\n                nickName: newMember.nickName,\n                avatarUrl: newMember.avatarUrl,\n                familyId: targetFamilyId,\n                role: 'member',\n                joinFailCount: 0,\n                joinFailLastTime: 0,\n                createdAt: userDoc?.data?.createdAt || now,\n                updatedAt: now\n              }\n            });\n\n            return {\n              success: true,\n              openid,\n              family: {\n                id: targetFamilyId,\n                _id: targetFamilyId,\n                ...family,\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            };\n          });\n        } catch (trxErr) {\n          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n          return {\n            success: false,\n            error: errMsg\n          };\n        }\n      }\n\n      /**\n       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n       */\n      case 'leaveFamily': {\n        return await db.runTransaction(async transaction => {\n          let userDoc = null;\n          try {\n            userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              userDoc = null;\n            } else {\n              throw e;\n            }\n          }\n          const user = userDoc?.data;\n\n          if (!user || !user.familyId) {\n            return { success: true, message: '当前未加入任何家庭' };\n          }\n\n          const familyId = user.familyId;\n          let famDoc = null;\n          try {\n            famDoc = await transaction.collection('families').doc(familyId).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              famDoc = null;\n            } else {\n              throw e;\n            }\n          }\n\n          if (famDoc && famDoc.data) {\n            const family = famDoc.data;\n            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n            if (remainingMembers.length === 0) {\n              await transaction.collection('families').doc(familyId).remove();\n            } else {\n              let newCreatorOpenid = family.creatorOpenid;\n              if (family.creatorOpenid === openid) {\n                newCreatorOpenid = remainingMembers[0].openid;\n                remainingMembers[0].role = 'creator';\n                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                  data: { role: 'creator', updatedAt: now }\n                }).catch(() => {});\n              }\n\n              await transaction.collection('families').doc(familyId).update({\n                data: {\n                  creatorOpenid: newCreatorOpenid,\n                  members: remainingMembers,\n                  memberOpenids: remainingOpenids,\n                  updatedAt: now\n                }\n              });\n            }\n          }\n\n          // 重置用户家庭归属\n          await transaction.collection('users').doc(`user_${openid}`).update({\n            data: {\n              familyId: null,\n              role: null,\n              updatedAt: now\n            }\n          });\n\n          return { success: true, message: '已退出家庭厨房空间' };\n        });\n      }\n\n      /**\n       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n       */\n      case 'refreshInviteCode': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = await generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n\n        await db.collection('families').doc(familyId).update({\n          data: {\n            inviteCode: newCode,\n            inviteExpiredAt: newExpiry,\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          inviteCode: newCode,\n          inviteExpiredAt: newExpiry\n        };\n      }\n\n      /**\n       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n       */\n      case 'getFamily': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return {\n          success: true,\n          family: {\n            id: family._id || familyId,\n            _id: family._id || familyId,\n            ...family\n          }\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n    return {\n      success: false,\n      error: errMsg\n    };\n  }\n};\n\n// 内部事务辅助：退出或重置家庭成员\nasync function leaveCurrentFamilyInternal(openid, familyId) {\n  return await db.runTransaction(async transaction => {\n    const famDocRef = transaction.collection('families').doc(familyId);\n    let famRes = null;\n    try {\n      famRes = await famDocRef.get();\n    } catch (e) {\n      if (isNotFoundError(e)) {\n        famRes = null;\n      } else {\n        throw e;\n      }\n    }\n    if (!famRes || !famRes.data) return;\n\n    const family = famRes.data;\n    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n    if (remainingMembers.length === 0) {\n      await famDocRef.remove();\n    } else {\n      let newCreatorOpenid = family.creatorOpenid;\n      if (family.creatorOpenid === openid) {\n        newCreatorOpenid = remainingMembers[0].openid;\n        remainingMembers[0].role = 'creator';\n        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n          data: { role: 'creator', updatedAt: Date.now() }\n        }).catch(() => {});\n      }\n\n      await famDocRef.update({\n        data: {\n          creatorOpenid: newCreatorOpenid,\n          members: remainingMembers,\n          memberOpenids: remainingOpenids,\n          updatedAt: Date.now()\n        }\n      });\n    }\n  });\n}\n","structuredPatch":[{"oldStart":58,"oldLines":7,"newStart":58,"newLines":10,"lines":["     const existing = await db.collection('families').where({","       inviteCode: code,","       inviteExpiredAt: _.gt(now)","-    }).count().catch(() => null);","+    }).count().catch(err => {","+      console.warn('[familyManage] 口令查重查询异常:', err);","+      return null;","+    });"," ","     if (!existing || existing.total === 0) {","       return code;"]}],"userModified":false,"replaceAll":false}}
