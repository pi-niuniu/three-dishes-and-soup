{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016hx8gvUSJvrc1RYcxdhTZw","type":"tool_result","content":"1\t/**\n2\t * 微信云开发服务网关 (CloudService)\n3\t * 职责：\n4\t * 1. 统一封装 wx.cloud.callFunction 调用\n5\t * 2. 真实小程序环境下云函数报错严禁降级返回 Mock 假成功，一律返回失败交由离线队列重试\n6\t * 3. 在无微信环境（Node.js 单测）或强制模拟模式下，提供高保真本地 Mock 状态机仿真\n7\t * 4. 严格保障 4 人上限、24小时邀请码、一人一家庭排他与同日多餐写入\n8\t */\n9\t\n10\timport type { FamilySpace, UserProfile, SingleMealItem, CustomDishRecord } from '../types/family.js';\n11\t\n12\tinterface CloudResponse<T = any> {\n13\t  success: boolean;\n14\t  result?: T;\n15\t  error?: string;\n16\t  [key: string]: any;\n17\t}\n18\t\n19\tclass LocalCloudMockDatabase {\n20\t  private users = new Map<string, any>();\n21\t  private families = new Map<string, any>();\n22\t  private mealHistory = new Map<string, any>(); // key: meal_${familyId}_${date}\n23\t  private customDishes = new Map<string, any[]>(); // key: familyId -> dish[]\n24\t  private sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n25\t\n26\t  constructor() {\n27\t    this.restoreFromStorage();\n28\t  }\n29\t\n30\t  private hasSensitiveContent(text: string): boolean {\n31\t    if (!text) return false;\n32\t    const str = String(text);\n33\t    return this.sensitiveWords.some(w => str.includes(w));\n34\t  }\n35\t\n36\t  private generateUniqueInviteCode(): string {\n37\t    const now = Date.now();\n38\t    for (let attempt = 0; attempt < 10; attempt++) {\n39\t      const code = String(Math.floor(100000 + Math.random() * 900000));\n40\t      let isDuplicate = false;\n41\t      for (const fam of this.families.values()) {\n42\t        if ((fam.inviteCode === code || String(fam.inviteCode) === code) && fam.inviteExpiredAt > now) {\n43\t          isDuplicate = true;\n44\t          break;\n45\t        }\n46\t      }\n47\t      if (!isDuplicate) return code;\n48\t    }\n49\t    return String(Math.floor(100000 + Math.random() * 900000));\n50\t  }\n51\t\n52\t  private getOpenid(data: any): string {\n53\t    if (data?.mockOpenid) return data.mockOpenid;\n54\t    try {\n55\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n56\t        const user = wx.getStorageSync('current_user_profile');\n57\t        if (user && user.openid) return user.openid;\n58\t      }\n59\t    } catch (e) {}\n60\t    return 'mock_openid_default';\n61\t  }\n62\t\n63\t  private restoreFromStorage() {\n64\t    try {\n65\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n66\t        const storedUsers = wx.getStorageSync('mock_db_users');\n67\t        if (storedUsers) this.users = new Map(Object.entries(storedUsers));\n68\t\n69\t        const storedFamilies = wx.getStorageSync('mock_db_families');\n70\t        if (storedFamilies) this.families = new Map(Object.entries(storedFamilies));\n71\t\n72\t        const storedHistory = wx.getStorageSync('mock_db_history');\n73\t        if (storedHistory) this.mealHistory = new Map(Object.entries(storedHistory));\n74\t\n75\t        const storedDishes = wx.getStorageSync('mock_db_custom_dishes');\n76\t        if (storedDishes) this.customDishes = new Map(Object.entries(storedDishes));\n77\t      }\n78\t    } catch (e) {}\n79\t  }\n80\t\n81\t  private persist() {\n82\t    try {\n83\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n84\t        wx.setStorageSync('mock_db_users', Object.fromEntries(this.users));\n85\t        wx.setStorageSync('mock_db_families', Object.fromEntries(this.families));\n86\t        wx.setStorageSync('mock_db_history', Object.fromEntries(this.mealHistory));\n87\t        wx.setStorageSync('mock_db_custom_dishes', Object.fromEntries(this.customDishes));\n88\t      }\n89\t    } catch (e) {}\n90\t  }\n91\t\n92\t  public clearAll() {\n93\t    this.users.clear();\n94\t    this.families.clear();\n95\t    this.mealHistory.clear();\n96\t    this.customDishes.clear();\n97\t    this.persist();\n98\t  }\n99\t\n100\t  public syncFamilyFromCloud(family: any, userOpenid?: string, role?: 'creator' | 'member') {\n101\t    if (!family) return;\n102\t    const famId = family.id || family._id;\n103\t    const safeFamily: FamilySpace = {\n104\t      id: famId,\n105\t      name: family.name,\n106\t      creatorOpenid: family.creatorOpenid,\n107\t      members: family.members || [],\n108\t      memberOpenids: family.memberOpenids || [],\n109\t      inviteCode: String(family.inviteCode),\n110\t      inviteExpiredAt: family.inviteExpiredAt,\n111\t      createdAt: family.createdAt || Date.now(),\n112\t      updatedAt: family.updatedAt || Date.now()\n113\t    };\n114\t    this.families.set(famId, safeFamily);\n115\t    if (userOpenid) {\n116\t      let user = this.users.get(`user_${userOpenid}`);\n117\t      if (!user) {\n118\t        user = {\n119\t          _id: `user_${userOpenid}`,\n120\t          openid: userOpenid,\n121\t          nickName: '家人',\n122\t          createdAt: Date.now()\n123\t        };\n124\t      }\n125\t      user.familyId = famId;\n126\t      user.role = role || (family.creatorOpenid === userOpenid ? 'creator' : 'member');\n127\t      user.updatedAt = Date.now();\n128\t      this.users.set(`user_${userOpenid}`, user);\n129\t    }\n130\t    this.persist();\n131\t  }\n132\t\n133\t  public handleUserAuth(data: any): any {\n134\t    const openid = this.getOpenid(data);\n135\t    const now = Date.now();\n136\t    let user = this.users.get(`user_${openid}`);\n137\t\n138\t    if (!user) {\n139\t      user = {\n140\t        _id: `user_${openid}`,\n141\t        _openid: openid,\n142\t        nickName: data?.nickName || '家人',\n143\t        avatarUrl: data?.avatarUrl || '',\n144\t        familyId: null,\n145\t        role: null,\n146\t        createdAt: now,\n147\t        updatedAt: now\n148\t      };\n149\t      this.users.set(`user_${openid}`, user);\n150\t    } else {\n151\t      if (data?.nickName) user.nickName = data.nickName;\n152\t      if (data?.avatarUrl) user.avatarUrl = data.avatarUrl;\n153\t      user.updatedAt = now;\n154\t    }\n155\t\n156\t    let family = null;\n157\t    if (user.familyId) {\n158\t      family = this.families.get(user.familyId) || null;\n159\t      if (!family) {\n160\t        user.familyId = null;\n161\t        user.role = null;\n162\t      }\n163\t    }\n164\t\n165\t    this.persist();\n166\t    return { success: true, openid, user, family };\n167\t  }\n168\t\n169\t  public handleFamilyManage(data: any): any {\n170\t    const { action } = data;\n171\t    const openid = this.getOpenid(data);\n172\t    const now = Date.now();\n173\t\n174\t    switch (action) {\n175\t      case 'createFamily': {\n176\t        const familyName = (data.name || '温馨小家食堂').trim().slice(0, 15);\n177\t        const nickName = data.nickName || '房主';\n178\t\n179\t        // 文本合规检验\n180\t        if (this.hasSensitiveContent(familyName) || this.hasSensitiveContent(nickName)) {\n181\t          return { success: false, error: '家庭名称或昵称包含敏感词，请修改后重试' };\n182\t        }\n183\t\n184\t        let user = this.users.get(`user_${openid}`) || {\n185\t          _id: `user_${openid}`,\n186\t          openid,\n187\t          nickName,\n188\t          familyId: null,\n189\t          role: null,\n190\t          createdAt: now,\n191\t          updatedAt: now\n192\t        };\n193\t\n194\t        // 如果用户在旧家庭中，先退出\n195\t        if (user.familyId && this.families.has(user.familyId)) {\n196\t          this.leaveFamilyInternal(openid, user.familyId);\n197\t        }\n198\t\n199\t        const familyId = data.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n200\t        const inviteCode = (data.inviteCode && String(data.inviteCode).trim().length === 6)\n201\t          ? String(data.inviteCode).trim()\n202\t          : this.generateUniqueInviteCode();\n203\t        const inviteExpiredAt = (data.inviteExpiredAt && Number(data.inviteExpiredAt) > now)\n204\t          ? Number(data.inviteExpiredAt)\n205\t          : (now + 24 * 60 * 60 * 1000);\n206\t\n207\t        const newFamily: FamilySpace = {\n208\t          id: familyId,\n209\t          name: familyName,\n210\t          creatorOpenid: openid,\n211\t          members: [\n212\t            {\n213\t              openid,\n214\t              nickName: nickName || user.nickName || '房主',\n215\t              avatarUrl: data.avatarUrl || user.avatarUrl || '',\n216\t              role: 'creator',\n217\t              joinedAt: now\n218\t            }\n219\t          ],\n220\t          memberOpenids: [openid],\n221\t          inviteCode,\n222\t          inviteExpiredAt,\n223\t          createdAt: now,\n224\t          updatedAt: now\n225\t        };\n226\t\n227\t        this.families.set(familyId, newFamily);\n228\t        user.familyId = familyId;\n229\t        user.role = 'creator';\n230\t        user.updatedAt = now;\n231\t        this.users.set(`user_${openid}`, user);\n232\t\n233\t        this.persist();\n234\t        return { success: true, family: newFamily };\n235\t      }\n236\t\n237\t      case 'joinFamily': {\n238\t        const WINDOW_MS = 15 * 60 * 1000;\n239\t        const MAX_FAILURES = 5;\n240\t        let user = this.users.get(`user_${openid}`) || {\n241\t          _id: `user_${openid}`,\n242\t          openid,\n243\t          nickName: data.nickName || '家人',\n244\t          familyId: null,\n245\t          role: null,\n246\t          joinFailCount: 0,\n247\t          joinFailLastTime: 0,\n248\t          createdAt: now,\n249\t          updatedAt: now\n250\t        };\n251\t\n252\t        if ((user.joinFailCount || 0) >= MAX_FAILURES && (now - (user.joinFailLastTime || 0)) <= WINDOW_MS) {\n253\t          const remainingMinutes = Math.max(1, Math.ceil((WINDOW_MS - (now - (user.joinFailLastTime || 0))) / 60000));\n254\t          return {\n255\t            success: false,\n256\t            error: `口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n257\t          };\n258\t        }\n259\t\n260\t        const recordMockFailure = () => {\n261\t          const isExpired = (now - (user.joinFailLastTime || 0)) > WINDOW_MS;\n262\t          user.joinFailCount = isExpired ? 1 : ((user.joinFailCount || 0) + 1);\n263\t          user.joinFailLastTime = now;\n264\t          this.users.set(`user_${openid}`, user);\n265\t          this.persist();\n266\t        };\n267\t\n268\t        const inviteCode = String(data.inviteCode || '').trim();\n269\t        if (!inviteCode || inviteCode.length !== 6) {\n270\t          recordMockFailure();\n271\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n272\t        }\n273\t\n274\t        const nickName = data.nickName || '家人';\n275\t        if (this.hasSensitiveContent(nickName)) {\n276\t          return { success: false, error: '成员昵称包含敏感词，请修改后重试' };\n277\t        }\n278\t\n279\t        let targetFamily: FamilySpace | null = null;\n280\t        for (const fam of this.families.values()) {\n281\t          if (\n282\t            String(fam.inviteCode) === inviteCode ||\n283\t            fam.inviteCode === inviteCode ||\n284\t            fam.inviteCode === Number(inviteCode)\n285\t          ) {\n286\t            targetFamily = fam;\n287\t            break;\n288\t          }\n289\t        }\n290\t\n291\t        if (!targetFamily) {\n292\t          recordMockFailure();\n293\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n294\t        }\n295\t\n296\t        if (now > targetFamily.inviteExpiredAt) {\n297\t          recordMockFailure();\n298\t          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n299\t        }\n300\t\n301\t        if (targetFamily.memberOpenids.includes(openid)) {\n302\t          return { success: true, family: targetFamily, message: '您已经在该家庭厨房中' };\n303\t        }\n304\t\n305\t        // 严格 4 人限制 (易错点 2 防御)\n306\t        if (targetFamily.memberOpenids.length >= 4) {\n307\t          return { success: false, error: '该家庭厨房成员已满（上限4人），无法继续加入' };\n308\t        }\n309\t\n310\t        // 一人一家庭排他 (易错点 3 防御)\n311\t        if (user.familyId && user.familyId !== targetFamily.id && this.families.has(user.familyId)) {\n312\t          this.leaveFamilyInternal(openid, user.familyId);\n313\t        }\n314\t\n315\t        const newMember = {\n316\t          openid,\n317\t          nickName: nickName || user.nickName || '家人',\n318\t          avatarUrl: data.avatarUrl || user.avatarUrl || '',\n319\t          role: 'member' as const,\n320\t          joinedAt: now\n321\t        };\n322\t\n323\t        targetFamily.members.push(newMember);\n324\t        targetFamily.memberOpenids.push(openid);\n325\t        targetFamily.updatedAt = now;\n326\t\n327\t        user.familyId = targetFamily.id;\n328\t        user.role = 'member';\n329\t        user.joinFailCount = 0;\n330\t        user.joinFailLastTime = 0;\n331\t        user.updatedAt = now;\n332\t        this.users.set(`user_${openid}`, user);\n333\t\n334\t        this.persist();\n335\t        return { success: true, family: targetFamily };\n336\t      }\n337\t\n338\t      case 'leaveFamily': {\n339\t        let user = this.users.get(`user_${openid}`);\n340\t        if (!user || !user.familyId) {\n341\t          return { success: true, message: '当前未加入任何家庭' };\n342\t        }\n343\t        this.leaveFamilyInternal(openid, user.familyId);\n344\t        user.familyId = null;\n345\t        user.role = null;\n346\t        user.updatedAt = now;\n347\t        this.users.set(`user_${openid}`, user);\n348\t        this.persist();\n349\t        return { success: true, message: '已退出家庭厨房空间' };\n350\t      }\n351\t\n352\t      case 'refreshInviteCode': {\n353\t        const { familyId } = data;\n354\t        const family = this.families.get(familyId);\n355\t        if (!family) return { success: false, error: '家庭不存在' };\n356\t\n357\t        if (!family.memberOpenids.includes(openid)) {\n358\t          return { success: false, error: '无权操作非本人所属家庭' };\n359\t        }\n360\t\n361\t        const newCode = this.generateUniqueInviteCode();\n362\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n363\t        family.inviteCode = newCode;\n364\t        family.inviteExpiredAt = newExpiry;\n365\t        family.updatedAt = now;\n366\t\n367\t        this.persist();\n368\t        return { success: true, inviteCode: newCode, inviteExpiredAt: newExpiry };\n369\t      }\n370\t\n371\t      case 'getFamily': {\n372\t        const { familyId } = data;\n373\t        const family = this.families.get(familyId);\n374\t        if (!family) return { success: false, error: '家庭不存在' };\n375\t\n376\t        // 敏感信息保护：非家庭成员不泄露敏感的邀请码与成员详情\n377\t        if (data.mockOpenid && (!family.memberOpenids || !family.memberOpenids.includes(data.mockOpenid))) {\n378\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n379\t        }\n380\t\n381\t        return { success: true, family };\n382\t      }\n383\t\n384\t      default:\n385\t        return { success: false, error: `不支持的操作类型: ${action}` };\n386\t    }\n387\t  }\n388\t\n389\t  private leaveFamilyInternal(openid: string, familyId: string) {\n390\t    const family = this.families.get(familyId);\n391\t    if (!family) return;\n392\t    family.members = family.members.filter(m => m.openid !== openid);\n393\t    family.memberOpenids = family.memberOpenids.filter(id => id !== openid);\n394\t    if (family.members.length === 0) {\n395\t      this.families.delete(familyId);\n396\t    } else {\n397\t      if (family.creatorOpenid === openid) {\n398\t        const nextCreatorOpenid = family.members[0].openid;\n399\t        family.creatorOpenid = nextCreatorOpenid;\n400\t        family.members[0].role = 'creator';\n401\t        const nextUser = this.users.get(`user_${nextCreatorOpenid}`);\n402\t        if (nextUser) {\n403\t          nextUser.role = 'creator';\n404\t          nextUser.updatedAt = Date.now();\n405\t        }\n406\t      }\n407\t      family.updatedAt = Date.now();\n408\t    }\n409\t  }\n410\t\n411\t  public handleUpsertMeal(data: any): any {\n412\t    const { action = 'upsertMeal' } = data;\n413\t    const openid = this.getOpenid(data);\n414\t    const now = Date.now();\n415\t\n416\t    switch (action) {\n417\t      case 'upsertMeal': {\n418\t        const { familyId, date, meal } = data;\n419\t        if (!familyId || !date || !meal) {\n420\t          return { success: false, error: '缺少参数 familyId/date/meal' };\n421\t        }\n422\t\n423\t        // 服务端鉴权：确认该用户确实属于该家庭\n424\t        const family = this.families.get(familyId);\n425\t        if (family && !family.memberOpenids.includes(openid)) {\n426\t          return { success: false, error: '越权操作：您不属于该家庭空间' };\n427\t        }\n428\t\n429\t        const docKey = `meal_${familyId}_${date}`;\n430\t        let doc = this.mealHistory.get(docKey);\n431\t\n432\t        const verifiedMember = (family?.members || []).find((m: any) => m.openid === openid);\n433\t        const verifiedNickName = (verifiedMember && verifiedMember.nickName && verifiedMember.nickName.trim())\n434\t          ? verifiedMember.nickName.trim()\n435\t          : (meal.confirmedByName || data.nickName || '家人');\n436\t\n437\t        const mealSnapshot: SingleMealItem = {\n438\t          mealId: meal.mealId || `m_${now}`,\n439\t          mealType: meal.mealType || '午餐',\n440\t          mode: meal.mode || 'hearty_3_1',\n441\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n442\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n443\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n444\t          confirmedBy: openid,\n445\t          confirmedByName: verifiedNickName,\n446\t          timestamp: meal.timestamp || now\n447\t        };\n448\t\n449\t        if (!doc) {\n450\t          doc = {\n451\t            _id: docKey,\n452\t            familyId,\n453\t            date,\n454\t            meals: [mealSnapshot],\n455\t            updatedAt: now\n456\t          };\n457\t        } else {\n458\t          const meals = doc.meals || [];\n459\t          const idx = meals.findIndex((m: any) => m.mealId === mealSnapshot.mealId);\n460\t          if (idx >= 0) {\n461\t            meals[idx] = mealSnapshot;\n462\t          } else {\n463\t            meals.push(mealSnapshot);\n464\t          }\n465\t          doc.meals = meals;\n466\t          doc.updatedAt = now;\n467\t        }\n468\t\n469\t        this.mealHistory.set(docKey, doc);\n470\t        this.persist();\n471\t        return { success: true, docId: docKey, meal: mealSnapshot };\n472\t      }\n473\t\n474\t      case 'getHistory': {\n475\t        const { familyId, limitDays = 60 } = data;\n476\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n477\t\n478\t        // 鉴权检查：如果传入了 mockOpenid 或有当前身份，校验是否在家庭中\n479\t        if (data.mockOpenid) {\n480\t          const family = this.families.get(familyId);\n481\t          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n482\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n483\t          }\n484\t        }\n485\t\n486\t        const allMeals: any[] = [];\n487\t        for (const [key, doc] of this.mealHistory.entries()) {\n488\t          if (doc.familyId === familyId) {\n489\t            for (const m of (doc.meals || [])) {\n490\t              allMeals.push({\n491\t                id: m.mealId,\n492\t                menuId: m.mealId,\n493\t                mealId: m.mealId,\n494\t                date: doc.date,\n495\t                timestamp: m.timestamp,\n496\t                mode: m.mode,\n497\t                mealType: m.mealType,\n498\t                dishIds: m.dishIds,\n499\t                dishNames: m.dishNames,\n500\t                dishes: m.dishes,\n501\t                confirmedBy: m.confirmedBy,\n502\t                confirmedByName: m.confirmedByName,\n503\t                familyId: doc.familyId,\n504\t                syncStatus: 'synced'\n505\t              });\n506\t            }\n507\t          }\n508\t        }\n509\t\n510\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n511\t        return { success: true, records: allMeals.slice(0, limitDays * 3) };\n512\t      }\n513\t\n514\t      default:\n515\t        return { success: false, error: `不支持的操作类型: ${action}` };\n516\t    }\n517\t  }\n518\t\n519\t  public handleCustomDish(data: any): any {\n520\t    const { action = 'addDish' } = data;\n521\t    const openid = this.getOpenid(data);\n522\t    const now = Date.now();\n523\t\n524\t    switch (action) {\n525\t      case 'addDish': {\n526\t        const name = String(data.name || '').trim();\n527\t        if (!name) return { success: false, error: '菜品名称不能为空' };\n528\t        if (name.length > 20) return { success: false, error: '菜品名称不能超过20个字' };\n529\t\n530\t        // 敏感词检测 (易错点 7 防御)\n531\t        const checkText = `${name} ${(data.taste || []).join(' ')} ${(data.ingredients || []).join(' ')}`;\n532\t        if (this.hasSensitiveContent(name) || this.hasSensitiveContent(checkText)) {\n533\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n534\t        }\n535\t\n536\t        // 隔离桶：未加入家庭的私房菜使用 personal_${openid}，严禁所有单人用户共用 'personal' 桶\n537\t        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n538\t        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n539\t\n540\t        // 服务端家庭鉴权\n541\t        if (!isPersonal) {\n542\t          const family = this.families.get(familyId);\n543\t          if (family && !family.memberOpenids.includes(openid)) {\n544\t            return { success: false, error: '越权操作：您不属于该家庭空间' };\n545\t          }\n546\t        }\n547\t\n548\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n549\t        const category = data.category || 'secondary_meat';\n550\t\n551\t        const newDish = {\n552\t          _id: dishId,\n553\t          id: dishId,\n554\t          familyId,\n555\t          creatorOpenid: openid,\n556\t          creatorName: data.creatorName || data.nickName || '家人',\n557\t          name,\n558\t          category,\n559\t          taste: Array.isArray(data.taste) ? data.taste : ['家常'],\n560\t          cookingTimeMinutes: Number(data.cookingTimeMinutes) || 25,\n561\t          ingredients: Array.isArray(data.ingredients) ? data.ingredients : [],\n562\t          enabled: true,\n563\t          isCustom: true,\n564\t          createdAt: now\n565\t        };\n566\t\n567\t        const list = this.customDishes.get(familyId) || [];\n568\t        list.unshift(newDish);\n569\t        this.customDishes.set(familyId, list);\n570\t        this.persist();\n571\t\n572\t        return { success: true, dish: newDish };\n573\t      }\n574\t\n575\t      case 'getDishes': {\n576\t        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n577\t        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n578\t\n579\t        // 服务端家庭鉴权\n580\t        if (!isPersonal && data.mockOpenid) {\n581\t          const family = this.families.get(familyId);\n582\t          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n583\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n584\t          }\n585\t        }\n586\t\n587\t        const list = this.customDishes.get(familyId) || [];\n588\t        return { success: true, dishes: list };\n589\t      }\n590\t\n591\t      default:\n592\t        return { success: false, error: `不支持的操作类型: ${action}` };\n593\t    }\n594\t  }\n595\t}\n596\t\n597\texport class CloudService {\n598\t  private mockDb = new LocalCloudMockDatabase();\n599\t  private isCloudAvailable: boolean | null = null;\n600\t  private forceMock: boolean = false;\n601\t\n602\t  public getMockDb() {\n603\t    return this.mockDb;\n604\t  }\n605\t\n606\t  public setForceMock(mock: boolean) {\n607\t    this.forceMock = mock;\n608\t  }\n609\t\n610\t  public resetAvailability() {\n611\t    this.isCloudAvailable = null;\n612\t  }\n613\t\n614\t  /**\n615\t   * 判断当前微信环境是否真正支持并开通了云开发\n616\t   */\n617\t  public checkCloudAvailability(): boolean {\n618\t    if (this.forceMock) return false;\n619\t    if (this.isCloudAvailable !== null) return this.isCloudAvailable;\n620\t    if (typeof wx !== 'undefined' && wx.cloud && typeof wx.cloud.callFunction === 'function') {\n621\t      this.isCloudAvailable = true;\n622\t    } else {\n623\t      this.isCloudAvailable = false;\n624\t    }\n625\t    return this.isCloudAvailable;\n626\t  }\n627\t\n628\t  /**\n629\t   * 判断错误是否属于微信云开发环境未就绪/未开通/云函数未部署\n630\t   * -601034: Environment not found\n631\t   * -601016: Environment does not exist\n632\t   * -601020: Function not found\n633\t   */\n634\t  private isEnvironmentUnavailableError(err: any): boolean {\n635\t    if (!err) return false;\n636\t    const errCode = err?.errCode ?? err?.code;\n637\t    if (errCode === -601034 || errCode === -601016 || errCode === -601015 || errCode === -601020) {\n638\t      return true;\n639\t    }\n640\t\n641\t    const msg = typeof err === 'string' ? err : String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '');\n642\t\n643\t    if (\n644\t      msg.includes('-601034') ||\n645\t      msg.includes('Environment not found') ||\n646\t      msg.includes('environment not found') ||\n647\t      msg.includes('Environment does not exist') ||\n648\t      msg.includes('FunctionName is not exist') ||\n649\t      msg.includes('function not exist') ||\n650\t      msg.includes('Function not found') ||\n651\t      msg.includes('no permission to callFunction')\n652\t    ) {\n653\t      return true;\n654\t    }\n655\t\n656\t    return false;\n657\t  }\n658\t\n659\t  /**\n660\t   * 判断错误是否属于微信云开发保留字段冲突或底层数据库参数错误\n661\t   * -501007: invalid parameters / 不能指定 _id / cannot update _id\n662\t   */\n663\t  private isReservedFieldOrParamError(err: any, result?: any): boolean {\n664\t    const checkItem = (item: any): boolean => {\n665\t      if (!item) return false;\n666\t      const code = item?.errCode ?? item?.code;\n667\t      const str = typeof item === 'string'\n668\t        ? item\n669\t        : String(item?.errMsg || item?.message || (typeof item === 'object' ? JSON.stringify(item) : item) || '');\n670\t\n671\t      const is501007 = code === -501007 || str.includes('-501007');\n672\t      const isReservedKeyword = str.includes('不能指定') || str.includes('保留字段') || str.includes('cannot update _id');\n673\t\n674\t      // 仅当明确具备 -501007 或保留字段核心关键字时才判定为冲突，绝不泛化拦截通用报错\n675\t      return (is501007 && (isReservedKeyword || str.includes('invalid parameters'))) || isReservedKeyword;\n676\t    };\n677\t\n678\t    return checkItem(err) || checkItem(result) || (result && checkItem(result.error));\n679\t  }\n680\t\n681\t  /**\n682\t   * 统一云函数调用方法\n683\t   * 1. 真实微信小程序环境下：严禁网络报错后假成功降级返回 Mock！一律返回失败交由离线待同步队列重试。\n684\t   * 2. 当检测到根本性环境缺失 (-601034 / 未开通云开发 / 云函数未部署)：自动熔断并平滑切换至本地高可用容灾模式。\n685\t   * 3. 本地仿真 Mock 保证单机与离线环境完整可用。\n686\t   */\n687\t  public async callFunction<T = any>(name: string, data: any = {}): Promise<CloudResponse<T>> {\n688\t    const hasCloud = this.checkCloudAvailability();\n689\t\n690\t    if (hasCloud) {\n691\t      try {\n692\t        const res = await wx.cloud.callFunction({\n693\t          name,\n694\t          data\n695\t        });\n696\t        if (res && res.result) {\n697\t          const result = res.result as CloudResponse<T>;\n698\t          if (result.success) {\n699\t            // 同步云端家庭数据至本地 Mock 状态机，保障单机状态与云端强一致\n700\t            if (name === 'familyManage' && (data?.action === 'createFamily' || data?.action === 'joinFamily') && (result as any).family) {\n701\t              const role = data?.action === 'createFamily' ? 'creator' : 'member';\n702\t              this.mockDb.syncFamilyFromCloud((result as any).family, data?.mockOpenid, role);\n703\t            }\n704\t            return result;\n705\t          }\n706\t\n707\t          // 核心容灾防御：若线上已发布的云端代码未部署最新补丁，返回了底层保留字段冲突或参数异常 (-501007)\n708\t          // 自动熔断降级至本地高可用容灾模式，确保用户业务（如创建厨房）绝不中断\n709\t          if (this.isReservedFieldOrParamError(null, result)) {\n710\t            console.warn(`[CloudService] 云函数 ${name} 线上返回底层数据库参数/保留字段冲突 (-501007)，自动降级至本地高可用容灾模式`);\n711\t            this.isCloudAvailable = false;\n712\t            const fallbackRes = this.invokeLocalMock(name, data);\n713\t            return {\n714\t              ...fallbackRes,\n715\t              isLocalFallback: true\n716\t            };\n717\t          }\n718\t\n719\t          // 环境异常亦熔断降级\n720\t          if (this.isEnvironmentUnavailableError(result) || this.isEnvironmentUnavailableError(result.error)) {\n721\t            console.warn(`[CloudService] 云函数 ${name} 线上返回环境未就绪，自动降级至本地高可用容灾模式`);\n722\t            this.isCloudAvailable = false;\n723\t            const fallbackRes = this.invokeLocalMock(name, data);\n724\t            return {\n725\t              ...fallbackRes,\n726\t              isLocalFallback: true\n727\t            };\n728\t          }\n729\t\n730\t          // 核心互通增强：若云端提示未找到口令，但本地 Mock 库中存在该家庭（例如同机多身份测试或房主在降级模式下创建）\n731\t          if (name === 'familyManage' && data?.action === 'joinFamily' && (result.error?.includes('未找到') || result.error?.includes('不存在'))) {\n732\t            const localFallback = this.invokeLocalMock(name, data);\n733\t            if (localFallback.success) {\n734\t              return {\n735\t                ...localFallback,\n736\t                isLocalFallback: true\n737\t              };\n738\t            }\n739\t          }\n740\t\n741\t          return result;\n742\t        }\n743\t        return { success: false, error: '云函数返回空结果' };\n744\t      } catch (err: any) {\n745\t        const errMsg = err?.errMsg || err?.message || String(err);\n746\t        console.warn(`[CloudService] 云函数 ${name} 线上调用失败:`, errMsg);\n747\t\n748\t        // 核心容灾防御：若为环境未就绪 (-601034)，自动熔断并无缝降级为本地高可用模式\n749\t        if (this.isEnvironmentUnavailableError(err)) {\n750\t          console.warn(`[CloudService] 检测到微信云开发环境未就绪/未开通 (-601034)，自动切换至本地高可用容灾模式`);\n751\t          this.isCloudAvailable = false;\n752\t          const fallbackRes = this.invokeLocalMock(name, data);\n753\t          return {\n754\t            ...fallbackRes,\n755\t            isLocalFallback: true\n756\t          };\n757\t        }\n758\t\n759\t        // 核心容灾防御：若底层保留字段冲突或参数异常 (-501007)，自动降级至本地高可用容灾模式\n760\t        if (this.isReservedFieldOrParamError(err)) {\n761\t          console.warn(`[CloudService] 云函数 ${name} 抛出底层保留字段冲突 (-501007)，自动降级至本地高可用容灾模式`);\n762\t          this.isCloudAvailable = false;\n763\t          const fallbackRes = this.invokeLocalMock(name, data);\n764\t          return {\n765\t            ...fallbackRes,\n766\t            isLocalFallback: true\n767\t          };\n768\t        }\n769\t\n770\t        // 真实网络故障等瞬时错误：严格遵循加固规范，严禁网络异常假成功，一律返回真实错误交由离线队列重试\n771\t        return { success: false, error: err?.message || errMsg };\n772\t      }\n773\t    }\n774\t\n775\t    // 本地高可用模式 (离线、无微信环境或降级模式)\n776\t    const localRes = this.invokeLocalMock(name, data);\n777\t\n778\t    // 核心跨机穿透增强：当用户在降级模式下加入家庭时，本地 mock 找不到目标家庭（因为目标家庭是由真机云端创建的），\n779\t    // 尝试向真实云端穿透探测一次，避免用户永远卡在单机隔离桶中无法加入家人创建的云端厨房\n780\t    if (\n781\t      name === 'familyManage' &&\n782\t      data?.action === 'joinFamily' &&\n783\t      !localRes.success &&\n784\t      typeof wx !== 'undefined' &&\n785\t      wx.cloud &&\n786\t      typeof wx.cloud.callFunction === 'function' &&\n787\t      !this.forceMock\n788\t    ) {\n789\t      try {\n790\t        const cloudTryRes = await wx.cloud.callFunction({ name, data });\n791\t        if (cloudTryRes?.result && (cloudTryRes.result as any).success) {\n792\t          const resResult = cloudTryRes.result as CloudResponse<T>;\n793\t          // 云端加入成功，自动恢复云端可用状态并同步回本地\n794\t          this.isCloudAvailable = true;\n795\t          if (resResult.family) {\n796\t            this.mockDb.syncFamilyFromCloud(resResult.family, data.mockOpenid, 'member');\n797\t          }\n798\t          return resResult;\n799\t        }\n800\t      } catch (probeErr) {\n801\t        // 穿透探测若失败，保持原始本地错误\n802\t      }\n803\t    }\n804\t\n805\t    // 核心降级创建互通：当房主此前在本地创建了家庭，联网静默补全注册 (_syncToCloud) 时，主动向真实云端尝试注册\n806\t    // 确保真实云开发可用时口令实时写入云端，家人凭口令可立即加入\n807\t    if (\n808\t      name === 'familyManage' &&\n809\t      data?.action === 'createFamily' &&\n810\t      data?._syncToCloud &&\n811\t      typeof wx !== 'undefined' &&\n812\t      wx.cloud &&\n813\t      typeof wx.cloud.callFunction === 'function' &&\n814\t      !this.forceMock\n815\t    ) {\n816\t      try {\n817\t        const cloudTryRes = await wx.cloud.callFunction({ name, data });\n818\t        if (cloudTryRes?.result && (cloudTryRes.result as any).success) {\n819\t          const resResult = cloudTryRes.result as CloudResponse<T>;\n820\t          this.isCloudAvailable = true;\n821\t          if (resResult.family) {\n822\t            this.mockDb.syncFamilyFromCloud(resResult.family, data.mockOpenid, 'creator');\n823\t          }\n824\t          return resResult;\n825\t        }\n826\t      } catch (probeErr) {\n827\t        // 离线时保持本地 mock\n828\t      }\n829\t    }\n830\t\n831\t    return {\n832\t      ...localRes,\n833\t      isLocalFallback: true\n834\t    };\n835\t  }\n836\t\n837\t  /**\n838\t   * 本地 Mock 逻辑分发\n839\t   */\n840\t  private invokeLocalMock(name: string, data: any): CloudResponse<any> {\n841\t    switch (name) {\n842\t      case 'userAuth':\n843\t        return this.mockDb.handleUserAuth(data);\n844\t      case 'familyManage':\n845\t        return this.mockDb.handleFamilyManage(data);\n846\t      case 'upsertMeal':\n847\t        return this.mockDb.handleUpsertMeal(data);\n848\t      case 'customDish':\n849\t        return this.mockDb.handleCustomDish(data);\n850\t      default:\n851\t        return { success: false, error: `未知云函数: ${name}` };\n852\t    }\n853\t  }\n854\t}\n855\t\n856\texport const cloudService = new CloudService();\n857\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"406d33f6-07e6-4367-be76-99bb21586093","timestamp":"2026-10-06T07:51:07.704Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/cloudService.ts","content":"/**\n * 微信云开发服务网关 (CloudService)\n * 职责：\n * 1. 统一封装 wx.cloud.callFunction 调用\n * 2. 真实小程序环境下云函数报错严禁降级返回 Mock 假成功，一律返回失败交由离线队列重试\n * 3. 在无微信环境（Node.js 单测）或强制模拟模式下，提供高保真本地 Mock 状态机仿真\n * 4. 严格保障 4 人上限、24小时邀请码、一人一家庭排他与同日多餐写入\n */\n\nimport type { FamilySpace, UserProfile, SingleMealItem, CustomDishRecord } from '../types/family.js';\n\ninterface CloudResponse<T = any> {\n  success: boolean;\n  result?: T;\n  error?: string;\n  [key: string]: any;\n}\n\nclass LocalCloudMockDatabase {\n  private users = new Map<string, any>();\n  private families = new Map<string, any>();\n  private mealHistory = new Map<string, any>(); // key: meal_${familyId}_${date}\n  private customDishes = new Map<string, any[]>(); // key: familyId -> dish[]\n  private sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n  constructor() {\n    this.restoreFromStorage();\n  }\n\n  private hasSensitiveContent(text: string): boolean {\n    if (!text) return false;\n    const str = String(text);\n    return this.sensitiveWords.some(w => str.includes(w));\n  }\n\n  private generateUniqueInviteCode(): string {\n    const now = Date.now();\n    for (let attempt = 0; attempt < 10; attempt++) {\n      const code = String(Math.floor(100000 + Math.random() * 900000));\n      let isDuplicate = false;\n      for (const fam of this.families.values()) {\n        if ((fam.inviteCode === code || String(fam.inviteCode) === code) && fam.inviteExpiredAt > now) {\n          isDuplicate = true;\n          break;\n        }\n      }\n      if (!isDuplicate) return code;\n    }\n    return String(Math.floor(100000 + Math.random() * 900000));\n  }\n\n  private getOpenid(data: any): string {\n    if (data?.mockOpenid) return data.mockOpenid;\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const user = wx.getStorageSync('current_user_profile');\n        if (user && user.openid) return user.openid;\n      }\n    } catch (e) {}\n    return 'mock_openid_default';\n  }\n\n  private restoreFromStorage() {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const storedUsers = wx.getStorageSync('mock_db_users');\n        if (storedUsers) this.users = new Map(Object.entries(storedUsers));\n\n        const storedFamilies = wx.getStorageSync('mock_db_families');\n        if (storedFamilies) this.families = new Map(Object.entries(storedFamilies));\n\n        const storedHistory = wx.getStorageSync('mock_db_history');\n        if (storedHistory) this.mealHistory = new Map(Object.entries(storedHistory));\n\n        const storedDishes = wx.getStorageSync('mock_db_custom_dishes');\n        if (storedDishes) this.customDishes = new Map(Object.entries(storedDishes));\n      }\n    } catch (e) {}\n  }\n\n  private persist() {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync('mock_db_users', Object.fromEntries(this.users));\n        wx.setStorageSync('mock_db_families', Object.fromEntries(this.families));\n        wx.setStorageSync('mock_db_history', Object.fromEntries(this.mealHistory));\n        wx.setStorageSync('mock_db_custom_dishes', Object.fromEntries(this.customDishes));\n      }\n    } catch (e) {}\n  }\n\n  public clearAll() {\n    this.users.clear();\n    this.families.clear();\n    this.mealHistory.clear();\n    this.customDishes.clear();\n    this.persist();\n  }\n\n  public syncFamilyFromCloud(family: any, userOpenid?: string, role?: 'creator' | 'member') {\n    if (!family) return;\n    const famId = family.id || family._id;\n    const safeFamily: FamilySpace = {\n      id: famId,\n      name: family.name,\n      creatorOpenid: family.creatorOpenid,\n      members: family.members || [],\n      memberOpenids: family.memberOpenids || [],\n      inviteCode: String(family.inviteCode),\n      inviteExpiredAt: family.inviteExpiredAt,\n      createdAt: family.createdAt || Date.now(),\n      updatedAt: family.updatedAt || Date.now()\n    };\n    this.families.set(famId, safeFamily);\n    if (userOpenid) {\n      let user = this.users.get(`user_${userOpenid}`);\n      if (!user) {\n        user = {\n          _id: `user_${userOpenid}`,\n          openid: userOpenid,\n          nickName: '家人',\n          createdAt: Date.now()\n        };\n      }\n      user.familyId = famId;\n      user.role = role || (family.creatorOpenid === userOpenid ? 'creator' : 'member');\n      user.updatedAt = Date.now();\n      this.users.set(`user_${userOpenid}`, user);\n    }\n    this.persist();\n  }\n\n  public handleUserAuth(data: any): any {\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n    let user = this.users.get(`user_${openid}`);\n\n    if (!user) {\n      user = {\n        _id: `user_${openid}`,\n        _openid: openid,\n        nickName: data?.nickName || '家人',\n        avatarUrl: data?.avatarUrl || '',\n        familyId: null,\n        role: null,\n        createdAt: now,\n        updatedAt: now\n      };\n      this.users.set(`user_${openid}`, user);\n    } else {\n      if (data?.nickName) user.nickName = data.nickName;\n      if (data?.avatarUrl) user.avatarUrl = data.avatarUrl;\n      user.updatedAt = now;\n    }\n\n    let family = null;\n    if (user.familyId) {\n      family = this.families.get(user.familyId) || null;\n      if (!family) {\n        user.familyId = null;\n        user.role = null;\n      }\n    }\n\n    this.persist();\n    return { success: true, openid, user, family };\n  }\n\n  public handleFamilyManage(data: any): any {\n    const { action } = data;\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n\n    switch (action) {\n      case 'createFamily': {\n        const familyName = (data.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = data.nickName || '房主';\n\n        // 文本合规检验\n        if (this.hasSensitiveContent(familyName) || this.hasSensitiveContent(nickName)) {\n          return { success: false, error: '家庭名称或昵称包含敏感词，请修改后重试' };\n        }\n\n        let user = this.users.get(`user_${openid}`) || {\n          _id: `user_${openid}`,\n          openid,\n          nickName,\n          familyId: null,\n          role: null,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        // 如果用户在旧家庭中，先退出\n        if (user.familyId && this.families.has(user.familyId)) {\n          this.leaveFamilyInternal(openid, user.familyId);\n        }\n\n        const familyId = data.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const inviteCode = (data.inviteCode && String(data.inviteCode).trim().length === 6)\n          ? String(data.inviteCode).trim()\n          : this.generateUniqueInviteCode();\n        const inviteExpiredAt = (data.inviteExpiredAt && Number(data.inviteExpiredAt) > now)\n          ? Number(data.inviteExpiredAt)\n          : (now + 24 * 60 * 60 * 1000);\n\n        const newFamily: FamilySpace = {\n          id: familyId,\n          name: familyName,\n          creatorOpenid: openid,\n          members: [\n            {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: data.avatarUrl || user.avatarUrl || '',\n              role: 'creator',\n              joinedAt: now\n            }\n          ],\n          memberOpenids: [openid],\n          inviteCode,\n          inviteExpiredAt,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        this.families.set(familyId, newFamily);\n        user.familyId = familyId;\n        user.role = 'creator';\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n\n        this.persist();\n        return { success: true, family: newFamily };\n      }\n\n      case 'joinFamily': {\n        const WINDOW_MS = 15 * 60 * 1000;\n        const MAX_FAILURES = 5;\n        let user = this.users.get(`user_${openid}`) || {\n          _id: `user_${openid}`,\n          openid,\n          nickName: data.nickName || '家人',\n          familyId: null,\n          role: null,\n          joinFailCount: 0,\n          joinFailLastTime: 0,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        if ((user.joinFailCount || 0) >= MAX_FAILURES && (now - (user.joinFailLastTime || 0)) <= WINDOW_MS) {\n          const remainingMinutes = Math.max(1, Math.ceil((WINDOW_MS - (now - (user.joinFailLastTime || 0))) / 60000));\n          return {\n            success: false,\n            error: `口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n          };\n        }\n\n        const recordMockFailure = () => {\n          const isExpired = (now - (user.joinFailLastTime || 0)) > WINDOW_MS;\n          user.joinFailCount = isExpired ? 1 : ((user.joinFailCount || 0) + 1);\n          user.joinFailLastTime = now;\n          this.users.set(`user_${openid}`, user);\n          this.persist();\n        };\n\n        const inviteCode = String(data.inviteCode || '').trim();\n        if (!inviteCode || inviteCode.length !== 6) {\n          recordMockFailure();\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const nickName = data.nickName || '家人';\n        if (this.hasSensitiveContent(nickName)) {\n          return { success: false, error: '成员昵称包含敏感词，请修改后重试' };\n        }\n\n        let targetFamily: FamilySpace | null = null;\n        for (const fam of this.families.values()) {\n          if (\n            String(fam.inviteCode) === inviteCode ||\n            fam.inviteCode === inviteCode ||\n            fam.inviteCode === Number(inviteCode)\n          ) {\n            targetFamily = fam;\n            break;\n          }\n        }\n\n        if (!targetFamily) {\n          recordMockFailure();\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        if (now > targetFamily.inviteExpiredAt) {\n          recordMockFailure();\n          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n        }\n\n        if (targetFamily.memberOpenids.includes(openid)) {\n          return { success: true, family: targetFamily, message: '您已经在该家庭厨房中' };\n        }\n\n        // 严格 4 人限制 (易错点 2 防御)\n        if (targetFamily.memberOpenids.length >= 4) {\n          return { success: false, error: '该家庭厨房成员已满（上限4人），无法继续加入' };\n        }\n\n        // 一人一家庭排他 (易错点 3 防御)\n        if (user.familyId && user.familyId !== targetFamily.id && this.families.has(user.familyId)) {\n          this.leaveFamilyInternal(openid, user.familyId);\n        }\n\n        const newMember = {\n          openid,\n          nickName: nickName || user.nickName || '家人',\n          avatarUrl: data.avatarUrl || user.avatarUrl || '',\n          role: 'member' as const,\n          joinedAt: now\n        };\n\n        targetFamily.members.push(newMember);\n        targetFamily.memberOpenids.push(openid);\n        targetFamily.updatedAt = now;\n\n        user.familyId = targetFamily.id;\n        user.role = 'member';\n        user.joinFailCount = 0;\n        user.joinFailLastTime = 0;\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n\n        this.persist();\n        return { success: true, family: targetFamily };\n      }\n\n      case 'leaveFamily': {\n        let user = this.users.get(`user_${openid}`);\n        if (!user || !user.familyId) {\n          return { success: true, message: '当前未加入任何家庭' };\n        }\n        this.leaveFamilyInternal(openid, user.familyId);\n        user.familyId = null;\n        user.role = null;\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n        this.persist();\n        return { success: true, message: '已退出家庭厨房空间' };\n      }\n\n      case 'refreshInviteCode': {\n        const { familyId } = data;\n        const family = this.families.get(familyId);\n        if (!family) return { success: false, error: '家庭不存在' };\n\n        if (!family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = this.generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n        family.inviteCode = newCode;\n        family.inviteExpiredAt = newExpiry;\n        family.updatedAt = now;\n\n        this.persist();\n        return { success: true, inviteCode: newCode, inviteExpiredAt: newExpiry };\n      }\n\n      case 'getFamily': {\n        const { familyId } = data;\n        const family = this.families.get(familyId);\n        if (!family) return { success: false, error: '家庭不存在' };\n\n        // 敏感信息保护：非家庭成员不泄露敏感的邀请码与成员详情\n        if (data.mockOpenid && (!family.memberOpenids || !family.memberOpenids.includes(data.mockOpenid))) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return { success: true, family };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n\n  private leaveFamilyInternal(openid: string, familyId: string) {\n    const family = this.families.get(familyId);\n    if (!family) return;\n    family.members = family.members.filter(m => m.openid !== openid);\n    family.memberOpenids = family.memberOpenids.filter(id => id !== openid);\n    if (family.members.length === 0) {\n      this.families.delete(familyId);\n    } else {\n      if (family.creatorOpenid === openid) {\n        const nextCreatorOpenid = family.members[0].openid;\n        family.creatorOpenid = nextCreatorOpenid;\n        family.members[0].role = 'creator';\n        const nextUser = this.users.get(`user_${nextCreatorOpenid}`);\n        if (nextUser) {\n          nextUser.role = 'creator';\n          nextUser.updatedAt = Date.now();\n        }\n      }\n      family.updatedAt = Date.now();\n    }\n  }\n\n  public handleUpsertMeal(data: any): any {\n    const { action = 'upsertMeal' } = data;\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n\n    switch (action) {\n      case 'upsertMeal': {\n        const { familyId, date, meal } = data;\n        if (!familyId || !date || !meal) {\n          return { success: false, error: '缺少参数 familyId/date/meal' };\n        }\n\n        // 服务端鉴权：确认该用户确实属于该家庭\n        const family = this.families.get(familyId);\n        if (family && !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '越权操作：您不属于该家庭空间' };\n        }\n\n        const docKey = `meal_${familyId}_${date}`;\n        let doc = this.mealHistory.get(docKey);\n\n        const verifiedMember = (family?.members || []).find((m: any) => m.openid === openid);\n        const verifiedNickName = (verifiedMember && verifiedMember.nickName && verifiedMember.nickName.trim())\n          ? verifiedMember.nickName.trim()\n          : (meal.confirmedByName || data.nickName || '家人');\n\n        const mealSnapshot: SingleMealItem = {\n          mealId: meal.mealId || `m_${now}`,\n          mealType: meal.mealType || '午餐',\n          mode: meal.mode || 'hearty_3_1',\n          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n          confirmedBy: openid,\n          confirmedByName: verifiedNickName,\n          timestamp: meal.timestamp || now\n        };\n\n        if (!doc) {\n          doc = {\n            _id: docKey,\n            familyId,\n            date,\n            meals: [mealSnapshot],\n            updatedAt: now\n          };\n        } else {\n          const meals = doc.meals || [];\n          const idx = meals.findIndex((m: any) => m.mealId === mealSnapshot.mealId);\n          if (idx >= 0) {\n            meals[idx] = mealSnapshot;\n          } else {\n            meals.push(mealSnapshot);\n          }\n          doc.meals = meals;\n          doc.updatedAt = now;\n        }\n\n        this.mealHistory.set(docKey, doc);\n        this.persist();\n        return { success: true, docId: docKey, meal: mealSnapshot };\n      }\n\n      case 'getHistory': {\n        const { familyId, limitDays = 60 } = data;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        // 鉴权检查：如果传入了 mockOpenid 或有当前身份，校验是否在家庭中\n        if (data.mockOpenid) {\n          const family = this.families.get(familyId);\n          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n            return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n          }\n        }\n\n        const allMeals: any[] = [];\n        for (const [key, doc] of this.mealHistory.entries()) {\n          if (doc.familyId === familyId) {\n            for (const m of (doc.meals || [])) {\n              allMeals.push({\n                id: m.mealId,\n                menuId: m.mealId,\n                mealId: m.mealId,\n                date: doc.date,\n                timestamp: m.timestamp,\n                mode: m.mode,\n                mealType: m.mealType,\n                dishIds: m.dishIds,\n                dishNames: m.dishNames,\n                dishes: m.dishes,\n                confirmedBy: m.confirmedBy,\n                confirmedByName: m.confirmedByName,\n                familyId: doc.familyId,\n                syncStatus: 'synced'\n              });\n            }\n          }\n        }\n\n        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n        return { success: true, records: allMeals.slice(0, limitDays * 3) };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n\n  public handleCustomDish(data: any): any {\n    const { action = 'addDish' } = data;\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n\n    switch (action) {\n      case 'addDish': {\n        const name = String(data.name || '').trim();\n        if (!name) return { success: false, error: '菜品名称不能为空' };\n        if (name.length > 20) return { success: false, error: '菜品名称不能超过20个字' };\n\n        // 敏感词检测 (易错点 7 防御)\n        const checkText = `${name} ${(data.taste || []).join(' ')} ${(data.ingredients || []).join(' ')}`;\n        if (this.hasSensitiveContent(name) || this.hasSensitiveContent(checkText)) {\n          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n        }\n\n        // 隔离桶：未加入家庭的私房菜使用 personal_${openid}，严禁所有单人用户共用 'personal' 桶\n        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n\n        // 服务端家庭鉴权\n        if (!isPersonal) {\n          const family = this.families.get(familyId);\n          if (family && !family.memberOpenids.includes(openid)) {\n            return { success: false, error: '越权操作：您不属于该家庭空间' };\n          }\n        }\n\n        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const category = data.category || 'secondary_meat';\n\n        const newDish = {\n          _id: dishId,\n          id: dishId,\n          familyId,\n          creatorOpenid: openid,\n          creatorName: data.creatorName || data.nickName || '家人',\n          name,\n          category,\n          taste: Array.isArray(data.taste) ? data.taste : ['家常'],\n          cookingTimeMinutes: Number(data.cookingTimeMinutes) || 25,\n          ingredients: Array.isArray(data.ingredients) ? data.ingredients : [],\n          enabled: true,\n          isCustom: true,\n          createdAt: now\n        };\n\n        const list = this.customDishes.get(familyId) || [];\n        list.unshift(newDish);\n        this.customDishes.set(familyId, list);\n        this.persist();\n\n        return { success: true, dish: newDish };\n      }\n\n      case 'getDishes': {\n        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n\n        // 服务端家庭鉴权\n        if (!isPersonal && data.mockOpenid) {\n          const family = this.families.get(familyId);\n          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n          }\n        }\n\n        const list = this.customDishes.get(familyId) || [];\n        return { success: true, dishes: list };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n}\n\nexport class CloudService {\n  private mockDb = new LocalCloudMockDatabase();\n  private isCloudAvailable: boolean | null = null;\n  private forceMock: boolean = false;\n\n  public getMockDb() {\n    return this.mockDb;\n  }\n\n  public setForceMock(mock: boolean) {\n    this.forceMock = mock;\n  }\n\n  public resetAvailability() {\n    this.isCloudAvailable = null;\n  }\n\n  /**\n   * 判断当前微信环境是否真正支持并开通了云开发\n   */\n  public checkCloudAvailability(): boolean {\n    if (this.forceMock) return false;\n    if (this.isCloudAvailable !== null) return this.isCloudAvailable;\n    if (typeof wx !== 'undefined' && wx.cloud && typeof wx.cloud.callFunction === 'function') {\n      this.isCloudAvailable = true;\n    } else {\n      this.isCloudAvailable = false;\n    }\n    return this.isCloudAvailable;\n  }\n\n  /**\n   * 判断错误是否属于微信云开发环境未就绪/未开通/云函数未部署\n   * -601034: Environment not found\n   * -601016: Environment does not exist\n   * -601020: Function not found\n   */\n  private isEnvironmentUnavailableError(err: any): boolean {\n    if (!err) return false;\n    const errCode = err?.errCode ?? err?.code;\n    if (errCode === -601034 || errCode === -601016 || errCode === -601015 || errCode === -601020) {\n      return true;\n    }\n\n    const msg = typeof err === 'string' ? err : String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '');\n\n    if (\n      msg.includes('-601034') ||\n      msg.includes('Environment not found') ||\n      msg.includes('environment not found') ||\n      msg.includes('Environment does not exist') ||\n      msg.includes('FunctionName is not exist') ||\n      msg.includes('function not exist') ||\n      msg.includes('Function not found') ||\n      msg.includes('no permission to callFunction')\n    ) {\n      return true;\n    }\n\n    return false;\n  }\n\n  /**\n   * 判断错误是否属于微信云开发保留字段冲突或底层数据库参数错误\n   * -501007: invalid parameters / 不能指定 _id / cannot update _id\n   */\n  private isReservedFieldOrParamError(err: any, result?: any): boolean {\n    const checkItem = (item: any): boolean => {\n      if (!item) return false;\n      const code = item?.errCode ?? item?.code;\n      const str = typeof item === 'string'\n        ? item\n        : String(item?.errMsg || item?.message || (typeof item === 'object' ? JSON.stringify(item) : item) || '');\n\n      const is501007 = code === -501007 || str.includes('-501007');\n      const isReservedKeyword = str.includes('不能指定') || str.includes('保留字段') || str.includes('cannot update _id');\n\n      // 仅当明确具备 -501007 或保留字段核心关键字时才判定为冲突，绝不泛化拦截通用报错\n      return (is501007 && (isReservedKeyword || str.includes('invalid parameters'))) || isReservedKeyword;\n    };\n\n    return checkItem(err) || checkItem(result) || (result && checkItem(result.error));\n  }\n\n  /**\n   * 统一云函数调用方法\n   * 1. 真实微信小程序环境下：严禁网络报错后假成功降级返回 Mock！一律返回失败交由离线待同步队列重试。\n   * 2. 当检测到根本性环境缺失 (-601034 / 未开通云开发 / 云函数未部署)：自动熔断并平滑切换至本地高可用容灾模式。\n   * 3. 本地仿真 Mock 保证单机与离线环境完整可用。\n   */\n  public async callFunction<T = any>(name: string, data: any = {}): Promise<CloudResponse<T>> {\n    const hasCloud = this.checkCloudAvailability();\n\n    if (hasCloud) {\n      try {\n        const res = await wx.cloud.callFunction({\n          name,\n          data\n        });\n        if (res && res.result) {\n          const result = res.result as CloudResponse<T>;\n          if (result.success) {\n            // 同步云端家庭数据至本地 Mock 状态机，保障单机状态与云端强一致\n            if (name === 'familyManage' && (data?.action === 'createFamily' || data?.action === 'joinFamily') && (result as any).family) {\n              const role = data?.action === 'createFamily' ? 'creator' : 'member';\n              this.mockDb.syncFamilyFromCloud((result as any).family, data?.mockOpenid, role);\n            }\n            return result;\n          }\n\n          // 核心容灾防御：若线上已发布的云端代码未部署最新补丁，返回了底层保留字段冲突或参数异常 (-501007)\n          // 自动熔断降级至本地高可用容灾模式，确保用户业务（如创建厨房）绝不中断\n          if (this.isReservedFieldOrParamError(null, result)) {\n            console.warn(`[CloudService] 云函数 ${name} 线上返回底层数据库参数/保留字段冲突 (-501007)，自动降级至本地高可用容灾模式`);\n            this.isCloudAvailable = false;\n            const fallbackRes = this.invokeLocalMock(name, data);\n            return {\n              ...fallbackRes,\n              isLocalFallback: true\n            };\n          }\n\n          // 环境异常亦熔断降级\n          if (this.isEnvironmentUnavailableError(result) || this.isEnvironmentUnavailableError(result.error)) {\n            console.warn(`[CloudService] 云函数 ${name} 线上返回环境未就绪，自动降级至本地高可用容灾模式`);\n            this.isCloudAvailable = false;\n            const fallbackRes = this.invokeLocalMock(name, data);\n            return {\n              ...fallbackRes,\n              isLocalFallback: true\n            };\n          }\n\n          // 核心互通增强：若云端提示未找到口令，但本地 Mock 库中存在该家庭（例如同机多身份测试或房主在降级模式下创建）\n          if (name === 'familyManage' && data?.action === 'joinFamily' && (result.error?.includes('未找到') || result.error?.includes('不存在'))) {\n            const localFallback = this.invokeLocalMock(name, data);\n            if (localFallback.success) {\n              return {\n                ...localFallback,\n                isLocalFallback: true\n              };\n            }\n          }\n\n          return result;\n        }\n        return { success: false, error: '云函数返回空结果' };\n      } catch (err: any) {\n        const errMsg = err?.errMsg || err?.message || String(err);\n        console.warn(`[CloudService] 云函数 ${name} 线上调用失败:`, errMsg);\n\n        // 核心容灾防御：若为环境未就绪 (-601034)，自动熔断并无缝降级为本地高可用模式\n        if (this.isEnvironmentUnavailableError(err)) {\n          console.warn(`[CloudService] 检测到微信云开发环境未就绪/未开通 (-601034)，自动切换至本地高可用容灾模式`);\n          this.isCloudAvailable = false;\n          const fallbackRes = this.invokeLocalMock(name, data);\n          return {\n            ...fallbackRes,\n            isLocalFallback: true\n          };\n        }\n\n        // 核心容灾防御：若底层保留字段冲突或参数异常 (-501007)，自动降级至本地高可用容灾模式\n        if (this.isReservedFieldOrParamError(err)) {\n          console.warn(`[CloudService] 云函数 ${name} 抛出底层保留字段冲突 (-501007)，自动降级至本地高可用容灾模式`);\n          this.isCloudAvailable = false;\n          const fallbackRes = this.invokeLocalMock(name, data);\n          return {\n            ...fallbackRes,\n            isLocalFallback: true\n          };\n        }\n\n        // 真实网络故障等瞬时错误：严格遵循加固规范，严禁网络异常假成功，一律返回真实错误交由离线队列重试\n        return { success: false, error: err?.message || errMsg };\n      }\n    }\n\n    // 本地高可用模式 (离线、无微信环境或降级模式)\n    const localRes = this.invokeLocalMock(name, data);\n\n    // 核心跨机穿透增强：当用户在降级模式下加入家庭时，本地 mock 找不到目标家庭（因为目标家庭是由真机云端创建的），\n    // 尝试向真实云端穿透探测一次，避免用户永远卡在单机隔离桶中无法加入家人创建的云端厨房\n    if (\n      name === 'familyManage' &&\n      data?.action === 'joinFamily' &&\n      !localRes.success &&\n      typeof wx !== 'undefined' &&\n      wx.cloud &&\n      typeof wx.cloud.callFunction === 'function' &&\n      !this.forceMock\n    ) {\n      try {\n        const cloudTryRes = await wx.cloud.callFunction({ name, data });\n        if (cloudTryRes?.result && (cloudTryRes.result as any).success) {\n          const resResult = cloudTryRes.result as CloudResponse<T>;\n          // 云端加入成功，自动恢复云端可用状态并同步回本地\n          this.isCloudAvailable = true;\n          if (resResult.family) {\n            this.mockDb.syncFamilyFromCloud(resResult.family, data.mockOpenid, 'member');\n          }\n          return resResult;\n        }\n      } catch (probeErr) {\n        // 穿透探测若失败，保持原始本地错误\n      }\n    }\n\n    // 核心降级创建互通：当房主此前在本地创建了家庭，联网静默补全注册 (_syncToCloud) 时，主动向真实云端尝试注册\n    // 确保真实云开发可用时口令实时写入云端，家人凭口令可立即加入\n    if (\n      name === 'familyManage' &&\n      data?.action === 'createFamily' &&\n      data?._syncToCloud &&\n      typeof wx !== 'undefined' &&\n      wx.cloud &&\n      typeof wx.cloud.callFunction === 'function' &&\n      !this.forceMock\n    ) {\n      try {\n        const cloudTryRes = await wx.cloud.callFunction({ name, data });\n        if (cloudTryRes?.result && (cloudTryRes.result as any).success) {\n          const resResult = cloudTryRes.result as CloudResponse<T>;\n          this.isCloudAvailable = true;\n          if (resResult.family) {\n            this.mockDb.syncFamilyFromCloud(resResult.family, data.mockOpenid, 'creator');\n          }\n          return resResult;\n        }\n      } catch (probeErr) {\n        // 离线时保持本地 mock\n      }\n    }\n\n    return {\n      ...localRes,\n      isLocalFallback: true\n    };\n  }\n\n  /**\n   * 本地 Mock 逻辑分发\n   */\n  private invokeLocalMock(name: string, data: any): CloudResponse<any> {\n    switch (name) {\n      case 'userAuth':\n        return this.mockDb.handleUserAuth(data);\n      case 'familyManage':\n        return this.mockDb.handleFamilyManage(data);\n      case 'upsertMeal':\n        return this.mockDb.handleUpsertMeal(data);\n      case 'customDish':\n        return this.mockDb.handleCustomDish(data);\n      default:\n        return { success: false, error: `未知云函数: ${name}` };\n    }\n  }\n}\n\nexport const cloudService = new CloudService();\n","numLines":857,"startLine":1,"totalLines":857}}}
