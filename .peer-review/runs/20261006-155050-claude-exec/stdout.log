{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014yv7pF1zgQPPuaBdPSyeES","type":"tool_result","content":"1\t/**\n2\t * 专项测试：验证微信云开发 -601034 报错精准识别与本地高可用自动降级容灾\n3\t */\n4\t\n5\timport assert from 'assert/strict';\n6\timport fs from 'fs';\n7\timport path from 'path';\n8\t\n9\tconsole.log('===============================================================');\n10\tconsole.log('🧪 启动微信云开发 -601034 报错与本地高可用自动降级专项验证');\n11\tconsole.log('===============================================================\\n');\n12\t\n13\t// 1. 验证 app.ts 源码合规性：不再包含前端非法的 DYNAMIC_CURRENT_ENV，且支持 CLOUD_ENV_ID\n14\tconst appSource = fs.readFileSync(path.resolve('miniprogram/app.ts'), 'utf-8');\n15\tassert(!appSource.includes('wx.cloud.DYNAMIC_CURRENT_ENV'), 'app.ts 严禁向前端传入 DYNAMIC_CURRENT_ENV');\n16\tassert(appSource.includes('CLOUD_ENV_ID'), 'app.ts 必须导出 CLOUD_ENV_ID 配置项');\n17\tconsole.log('✅ 验证项 1: app.ts 前端云开发初始化合规性核验通过！');\n18\t\n19\t// 2. 模拟微信小程序环境与 Storage\n20\tconst storage = new Map();\n21\tglobal.wx = {\n22\t  getStorageSync: (key) => storage.get(key) || null,\n23\t  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n24\t  removeStorageSync: (key) => storage.delete(key),\n25\t  clearStorageSync: () => storage.clear(),\n26\t  showLoading: () => {},\n27\t  hideLoading: () => {},\n28\t  showToast: () => {}\n29\t};\n30\t\n31\tprocess.env.NODE_ENV = 'test';\n32\t\n33\tconst { cloudService } = await import('../miniprogram/services/cloudService.js');\n34\tconst { familyService } = await import('../miniprogram/services/familyService.js');\n35\t\n36\t// 3. 场景 A: 模拟线上真机发生 errCode: -601034 (微信云开发未开通 / 环境不存在)\n37\tconsole.log('\\n【场景 A】模拟微信真实报错 errCode: -601034 (截图同款报错)');\n38\tlet mockCallCount = 0;\n39\tglobal.wx.cloud = {\n40\t  callFunction: async ({ name, data }) => {\n41\t    mockCallCount++;\n42\t    const err = new Error('cloud.callFunction:fail Error: errCode: -601034 | errMsg: Environment not found');\n43\t    err.errCode = -601034;\n44\t    throw err;\n45\t  }\n46\t};\n47\t\n48\tcloudService.resetAvailability();\n49\tfamilyService.setMockCurrentUser('openid_test_user', '皮妞妞');\n50\t\n51\t// 执行创建家庭厨房（对应截图上输入“皮妞妞”并点击“创建厨房”）\n52\tconst createRes = await familyService.createFamily('皮妞妞');\n53\t\n54\t// 验证断言：\n55\t// 1. 在遭遇 -601034 时，系统绝不抛错，而是平滑熔断并降级为本地高可用模式\n56\tassert.equal(createRes.success, true, '遭遇 -601034 时系统必须平滑降级并成功创建家庭厨房');\n57\tassert(createRes.family, '必须成功返回创建的家庭对象');\n58\tassert.equal(createRes.family.name, '皮妞妞', '家庭名称必须正确保存为 皮妞妞');\n59\tassert.equal(createRes.family.creatorOpenid, 'openid_test_user', '房主 openid 必须正确绑定');\n60\tassert.equal(cloudService.checkCloudAvailability(), false, '系统必须自动熔断云调用并标记 isCloudAvailable 为 false');\n61\t\n62\t// 验证二次调用时直接走本地模式，不再重复触发无意义的微信底层网络报错\n63\tconst secondRes = await familyService.createFamily('温馨小家食堂2');\n64\tassert.equal(secondRes.success, true, '降级后二次操作必须顺畅无感');\n65\tassert.equal(mockCallCount, 1, '降级熔断生效：二次调用直接由本地接管，不再向微信云端发起已确认不存在的调用');\n66\t\n67\tconsole.log('✅ 验证项 2: -601034 自动熔断与本地高可用容灾断言全部通过！家庭空间 100% 成功创建！');\n68\t\n69\t// 4. 场景 B: 验证真正的瞬时网络异常 (request:fail timeout) 依然严格保留 pending，不误触发降级\n70\tconsole.log('\\n【场景 B】验证瞬时网络波动异常 (request:fail timeout) 严禁误判为环境缺失');\n71\tcloudService.resetAvailability();\n72\tglobal.wx.cloud = {\n73\t  callFunction: async () => {\n74\t    throw new Error('request:fail timeout or offline');\n75\t  }\n76\t};\n77\t\n78\tassert.equal(cloudService.checkCloudAvailability(), true, '重置后初次检查应恢复为可用');\n79\tconst netFailRes = await cloudService.callFunction('familyManage', { action: 'probe' });\n80\tassert.equal(netFailRes.success, false, '瞬时网络故障必须返回 success: false');\n81\tassert(netFailRes.error?.includes('request:fail'), '必须返回真实网络错误信息交由离线重试队列');\n82\tassert.equal(cloudService.checkCloudAvailability(), true, '瞬时网络故障绝不破坏云环境可用性标识');\n83\t\n84\tconsole.log('✅ 验证项 3: 瞬时网络异常与环境缺失精准隔离断言通过！加固防线 100% 稳固！');\n85\t\n86\t// 5. 场景 C: 模拟线上老版本云函数未部署或微信云数据库报 -501007 invalid parameters (用户截图同款错误)\n87\tconsole.log('\\n【场景 C1】模拟截图同款 -501007 字符串报错报文自动熔断降级');\n88\tcloudService.resetAvailability();\n89\tglobal.wx.cloud = {\n90\t  callFunction: async ({ name, data }) => {\n91\t    return {\n92\t      result: {\n93\t        success: false,\n94\t        error: 'document.set:fail -501007 invalid parameters. 不能指定 _id'\n95\t      }\n96\t    };\n97\t  }\n98\t};\n99\t\n100\tconst paramFailRes = await familyService.createFamily('皮妞妞');\n101\tassert.equal(paramFailRes.success, true, '遭遇截图同款 -501007 报错时必须平滑降级，家庭创建绝不失败');\n102\tassert(paramFailRes.family, '降级后必须正确返回 family 实体');\n103\tassert.equal(paramFailRes.family.name, '皮妞妞', '降级后家庭名称必须正确');\n104\tassert(paramFailRes.family.id, '返回的 family 必须包含标准 id 字段');\n105\tconsole.log('✅ 验证项 4.1: 截图同款 -501007 字符串报错自动容灾降级断言通过！');\n106\t\n107\tconsole.log('\\n【场景 C2】模拟微信 SDK 返回对象类型 { errCode: -501007 } 自动熔断降级');\n108\tcloudService.resetAvailability();\n109\tglobal.wx.cloud = {\n110\t  callFunction: async ({ name, data }) => {\n111\t    return {\n112\t      result: {\n113\t        success: false,\n114\t        error: { errCode: -501007, errMsg: 'document.set:fail invalid parameters. 不能指定 _id' }\n115\t      }\n116\t    };\n117\t  }\n118\t};\n119\tconst objFailRes = await familyService.createFamily('皮妞妞对象错误测试');\n120\tassert.equal(objFailRes.success, true, '遭遇对象类型 -501007 报错必须安全识别并降级');\n121\tassert.equal(objFailRes.family.name, '皮妞妞对象错误测试');\n122\tconsole.log('✅ 验证项 4.2: 对象类型 { errCode: -501007 } 自动容灾降级断言通过！');\n123\t\n124\tconsole.log('\\n【场景 C3】模拟 callFunction 抛出异常 { errCode: -501007 } 自动熔断降级');\n125\tcloudService.resetAvailability();\n126\tglobal.wx.cloud = {\n127\t  callFunction: async ({ name, data }) => {\n128\t    const err = new Error('document.set:fail -501007 invalid parameters');\n129\t    err.errCode = -501007;\n130\t    throw err;\n131\t  }\n132\t};\n133\tconst thrownFailRes = await familyService.createFamily('皮妞妞抛错测试');\n134\tassert.equal(thrownFailRes.success, true, 'callFunction 抛出 -501007 异常必须平滑降级');\n135\tassert.equal(thrownFailRes.family.name, '皮妞妞抛错测试');\n136\tconsole.log('✅ 验证项 4.3: callFunction 抛出 -501007 异常自动容灾降级断言通过！');\n137\t\n138\tconsole.log('\\n【场景 C4】验证 formatErrorTip 对对象型错误与各类边界输入的防崩溃鲁棒性');\n139\t// 动态导入编译后的 mine/index.js 验证 formatErrorTip\n140\tlet registeredMinePage = null;\n141\tglobal.Page = (cfg) => { registeredMinePage = cfg; };\n142\tawait import('../miniprogram/pages/mine/index.js');\n143\tassert(registeredMinePage && registeredMinePage.formatErrorTip, '必须导出 formatErrorTip 方法');\n144\t\n145\tassert.equal(registeredMinePage.formatErrorTip(''), '操作失败，请重试');\n146\tassert.equal(registeredMinePage.formatErrorTip(null), '操作失败，请重试');\n147\tassert.equal(registeredMinePage.formatErrorTip(undefined), '操作失败，请重试');\n148\tassert.equal(registeredMinePage.formatErrorTip('document.set:fail -501007 invalid parameters. 不能指定 _id'), '数据服务同步异常，请稍后重试');\n149\tassert.equal(registeredMinePage.formatErrorTip('document.update:fail -501007 invalid parameters. 不能更新保留字段 _openid'), '数据服务同步异常，请稍后重试');\n150\tassert.equal(registeredMinePage.formatErrorTip({ errCode: -501007, errMsg: 'document.set:fail' }), '数据服务同步异常，请稍后重试', '对象型错误严禁抛 TypeError');\n151\tassert.equal(registeredMinePage.formatErrorTip({ errMsg: 'Environment not found (-601034)' }), '云开发环境未就绪，已切换为本地模式');\n152\tassert.equal(registeredMinePage.formatErrorTip('cloud.callFunction:fail timeout'), '服务连接异常，请重试');\n153\tassert.equal(cloudService.checkCloudAvailability(), false, '-501007 熔断后系统必须标记云可用性为 false 避免后续无效网络往返');\n154\tconsole.log('✅ 验证项 4.4: formatErrorTip 针对对象、字符串、null 等所有类型防崩溃鲁棒性验证通过！');\n155\t\n156\t// 6. 场景 D: 验证全项目版本号 100% 强一致性 (全部锁定 V2.11)\n157\tconsole.log('\\n【场景 D】验证全项目版本号一致性审计 (锁定 V2.11)');\n158\tconst pkg = JSON.parse(fs.readFileSync(path.resolve('package.json'), 'utf-8'));\n159\tconst appJson = JSON.parse(fs.readFileSync(path.resolve('miniprogram/app.json'), 'utf-8'));\n160\tconst projectConfig = JSON.parse(fs.readFileSync(path.resolve('project.config.json'), 'utf-8'));\n161\tconst publishGuide = fs.readFileSync(path.resolve('docs/wechat-publish-guide.md'), 'utf-8');\n162\t\n163\tassert.equal(pkg.version, '2.11', 'package.json 版本号必须为 2.11');\n164\tassert.equal(appJson.version, '2.11', 'miniprogram/app.json 版本号必须为 2.11');\n165\tassert.equal(projectConfig.version, '2.11', 'project.config.json version 必须为 2.11');\n166\tassert(projectConfig.projectname.includes('2.11'), 'project.config.json projectname 必须包含 2.11');\n167\tassert(appSource.includes(\"APP_VERSION = '2.11'\"), 'app.ts APP_VERSION 必须为 2.11');\n168\tassert(!publishGuide.includes('V2.05'), 'wechat-publish-guide.md 严禁残留 V2.05');\n169\tassert(!publishGuide.includes('V2.10'), 'wechat-publish-guide.md 严禁残留 V2.10');\n170\tassert(publishGuide.includes('2.11'), 'wechat-publish-guide.md 必须包含 2.11');\n171\tconsole.log('✅ 验证项 5: package.json / app.json / project.config.json / app.ts / wechat-publish-guide.md 版本号 2.11 强一致性校验通过！');\n172\t\n173\tconsole.log('\\n===============================================================');\n174\tconsole.log('🎉 专项验证全部 100% 成功通过！截图报错已彻底根治且系统具备极强鲁棒性！');\n175\tconsole.log('===============================================================\\n');\n176\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"6b64994a-516e-4ff0-a30a-a26f3b020ad1","timestamp":"2026-10-06T07:51:11.239Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/test/cloud_env_fallback_test.mjs","content":"/**\n * 专项测试：验证微信云开发 -601034 报错精准识别与本地高可用自动降级容灾\n */\n\nimport assert from 'assert/strict';\nimport fs from 'fs';\nimport path from 'path';\n\nconsole.log('===============================================================');\nconsole.log('🧪 启动微信云开发 -601034 报错与本地高可用自动降级专项验证');\nconsole.log('===============================================================\\n');\n\n// 1. 验证 app.ts 源码合规性：不再包含前端非法的 DYNAMIC_CURRENT_ENV，且支持 CLOUD_ENV_ID\nconst appSource = fs.readFileSync(path.resolve('miniprogram/app.ts'), 'utf-8');\nassert(!appSource.includes('wx.cloud.DYNAMIC_CURRENT_ENV'), 'app.ts 严禁向前端传入 DYNAMIC_CURRENT_ENV');\nassert(appSource.includes('CLOUD_ENV_ID'), 'app.ts 必须导出 CLOUD_ENV_ID 配置项');\nconsole.log('✅ 验证项 1: app.ts 前端云开发初始化合规性核验通过！');\n\n// 2. 模拟微信小程序环境与 Storage\nconst storage = new Map();\nglobal.wx = {\n  getStorageSync: (key) => storage.get(key) || null,\n  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n  removeStorageSync: (key) => storage.delete(key),\n  clearStorageSync: () => storage.clear(),\n  showLoading: () => {},\n  hideLoading: () => {},\n  showToast: () => {}\n};\n\nprocess.env.NODE_ENV = 'test';\n\nconst { cloudService } = await import('../miniprogram/services/cloudService.js');\nconst { familyService } = await import('../miniprogram/services/familyService.js');\n\n// 3. 场景 A: 模拟线上真机发生 errCode: -601034 (微信云开发未开通 / 环境不存在)\nconsole.log('\\n【场景 A】模拟微信真实报错 errCode: -601034 (截图同款报错)');\nlet mockCallCount = 0;\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    mockCallCount++;\n    const err = new Error('cloud.callFunction:fail Error: errCode: -601034 | errMsg: Environment not found');\n    err.errCode = -601034;\n    throw err;\n  }\n};\n\ncloudService.resetAvailability();\nfamilyService.setMockCurrentUser('openid_test_user', '皮妞妞');\n\n// 执行创建家庭厨房（对应截图上输入“皮妞妞”并点击“创建厨房”）\nconst createRes = await familyService.createFamily('皮妞妞');\n\n// 验证断言：\n// 1. 在遭遇 -601034 时，系统绝不抛错，而是平滑熔断并降级为本地高可用模式\nassert.equal(createRes.success, true, '遭遇 -601034 时系统必须平滑降级并成功创建家庭厨房');\nassert(createRes.family, '必须成功返回创建的家庭对象');\nassert.equal(createRes.family.name, '皮妞妞', '家庭名称必须正确保存为 皮妞妞');\nassert.equal(createRes.family.creatorOpenid, 'openid_test_user', '房主 openid 必须正确绑定');\nassert.equal(cloudService.checkCloudAvailability(), false, '系统必须自动熔断云调用并标记 isCloudAvailable 为 false');\n\n// 验证二次调用时直接走本地模式，不再重复触发无意义的微信底层网络报错\nconst secondRes = await familyService.createFamily('温馨小家食堂2');\nassert.equal(secondRes.success, true, '降级后二次操作必须顺畅无感');\nassert.equal(mockCallCount, 1, '降级熔断生效：二次调用直接由本地接管，不再向微信云端发起已确认不存在的调用');\n\nconsole.log('✅ 验证项 2: -601034 自动熔断与本地高可用容灾断言全部通过！家庭空间 100% 成功创建！');\n\n// 4. 场景 B: 验证真正的瞬时网络异常 (request:fail timeout) 依然严格保留 pending，不误触发降级\nconsole.log('\\n【场景 B】验证瞬时网络波动异常 (request:fail timeout) 严禁误判为环境缺失');\ncloudService.resetAvailability();\nglobal.wx.cloud = {\n  callFunction: async () => {\n    throw new Error('request:fail timeout or offline');\n  }\n};\n\nassert.equal(cloudService.checkCloudAvailability(), true, '重置后初次检查应恢复为可用');\nconst netFailRes = await cloudService.callFunction('familyManage', { action: 'probe' });\nassert.equal(netFailRes.success, false, '瞬时网络故障必须返回 success: false');\nassert(netFailRes.error?.includes('request:fail'), '必须返回真实网络错误信息交由离线重试队列');\nassert.equal(cloudService.checkCloudAvailability(), true, '瞬时网络故障绝不破坏云环境可用性标识');\n\nconsole.log('✅ 验证项 3: 瞬时网络异常与环境缺失精准隔离断言通过！加固防线 100% 稳固！');\n\n// 5. 场景 C: 模拟线上老版本云函数未部署或微信云数据库报 -501007 invalid parameters (用户截图同款错误)\nconsole.log('\\n【场景 C1】模拟截图同款 -501007 字符串报错报文自动熔断降级');\ncloudService.resetAvailability();\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    return {\n      result: {\n        success: false,\n        error: 'document.set:fail -501007 invalid parameters. 不能指定 _id'\n      }\n    };\n  }\n};\n\nconst paramFailRes = await familyService.createFamily('皮妞妞');\nassert.equal(paramFailRes.success, true, '遭遇截图同款 -501007 报错时必须平滑降级，家庭创建绝不失败');\nassert(paramFailRes.family, '降级后必须正确返回 family 实体');\nassert.equal(paramFailRes.family.name, '皮妞妞', '降级后家庭名称必须正确');\nassert(paramFailRes.family.id, '返回的 family 必须包含标准 id 字段');\nconsole.log('✅ 验证项 4.1: 截图同款 -501007 字符串报错自动容灾降级断言通过！');\n\nconsole.log('\\n【场景 C2】模拟微信 SDK 返回对象类型 { errCode: -501007 } 自动熔断降级');\ncloudService.resetAvailability();\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    return {\n      result: {\n        success: false,\n        error: { errCode: -501007, errMsg: 'document.set:fail invalid parameters. 不能指定 _id' }\n      }\n    };\n  }\n};\nconst objFailRes = await familyService.createFamily('皮妞妞对象错误测试');\nassert.equal(objFailRes.success, true, '遭遇对象类型 -501007 报错必须安全识别并降级');\nassert.equal(objFailRes.family.name, '皮妞妞对象错误测试');\nconsole.log('✅ 验证项 4.2: 对象类型 { errCode: -501007 } 自动容灾降级断言通过！');\n\nconsole.log('\\n【场景 C3】模拟 callFunction 抛出异常 { errCode: -501007 } 自动熔断降级');\ncloudService.resetAvailability();\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    const err = new Error('document.set:fail -501007 invalid parameters');\n    err.errCode = -501007;\n    throw err;\n  }\n};\nconst thrownFailRes = await familyService.createFamily('皮妞妞抛错测试');\nassert.equal(thrownFailRes.success, true, 'callFunction 抛出 -501007 异常必须平滑降级');\nassert.equal(thrownFailRes.family.name, '皮妞妞抛错测试');\nconsole.log('✅ 验证项 4.3: callFunction 抛出 -501007 异常自动容灾降级断言通过！');\n\nconsole.log('\\n【场景 C4】验证 formatErrorTip 对对象型错误与各类边界输入的防崩溃鲁棒性');\n// 动态导入编译后的 mine/index.js 验证 formatErrorTip\nlet registeredMinePage = null;\nglobal.Page = (cfg) => { registeredMinePage = cfg; };\nawait import('../miniprogram/pages/mine/index.js');\nassert(registeredMinePage && registeredMinePage.formatErrorTip, '必须导出 formatErrorTip 方法');\n\nassert.equal(registeredMinePage.formatErrorTip(''), '操作失败，请重试');\nassert.equal(registeredMinePage.formatErrorTip(null), '操作失败，请重试');\nassert.equal(registeredMinePage.formatErrorTip(undefined), '操作失败，请重试');\nassert.equal(registeredMinePage.formatErrorTip('document.set:fail -501007 invalid parameters. 不能指定 _id'), '数据服务同步异常，请稍后重试');\nassert.equal(registeredMinePage.formatErrorTip('document.update:fail -501007 invalid parameters. 不能更新保留字段 _openid'), '数据服务同步异常，请稍后重试');\nassert.equal(registeredMinePage.formatErrorTip({ errCode: -501007, errMsg: 'document.set:fail' }), '数据服务同步异常，请稍后重试', '对象型错误严禁抛 TypeError');\nassert.equal(registeredMinePage.formatErrorTip({ errMsg: 'Environment not found (-601034)' }), '云开发环境未就绪，已切换为本地模式');\nassert.equal(registeredMinePage.formatErrorTip('cloud.callFunction:fail timeout'), '服务连接异常，请重试');\nassert.equal(cloudService.checkCloudAvailability(), false, '-501007 熔断后系统必须标记云可用性为 false 避免后续无效网络往返');\nconsole.log('✅ 验证项 4.4: formatErrorTip 针对对象、字符串、null 等所有类型防崩溃鲁棒性验证通过！');\n\n// 6. 场景 D: 验证全项目版本号 100% 强一致性 (全部锁定 V2.11)\nconsole.log('\\n【场景 D】验证全项目版本号一致性审计 (锁定 V2.11)');\nconst pkg = JSON.parse(fs.readFileSync(path.resolve('package.json'), 'utf-8'));\nconst appJson = JSON.parse(fs.readFileSync(path.resolve('miniprogram/app.json'), 'utf-8'));\nconst projectConfig = JSON.parse(fs.readFileSync(path.resolve('project.config.json'), 'utf-8'));\nconst publishGuide = fs.readFileSync(path.resolve('docs/wechat-publish-guide.md'), 'utf-8');\n\nassert.equal(pkg.version, '2.11', 'package.json 版本号必须为 2.11');\nassert.equal(appJson.version, '2.11', 'miniprogram/app.json 版本号必须为 2.11');\nassert.equal(projectConfig.version, '2.11', 'project.config.json version 必须为 2.11');\nassert(projectConfig.projectname.includes('2.11'), 'project.config.json projectname 必须包含 2.11');\nassert(appSource.includes(\"APP_VERSION = '2.11'\"), 'app.ts APP_VERSION 必须为 2.11');\nassert(!publishGuide.includes('V2.05'), 'wechat-publish-guide.md 严禁残留 V2.05');\nassert(!publishGuide.includes('V2.10'), 'wechat-publish-guide.md 严禁残留 V2.10');\nassert(publishGuide.includes('2.11'), 'wechat-publish-guide.md 必须包含 2.11');\nconsole.log('✅ 验证项 5: package.json / app.json / project.config.json / app.ts / wechat-publish-guide.md 版本号 2.11 强一致性校验通过！');\n\nconsole.log('\\n===============================================================');\nconsole.log('🎉 专项验证全部 100% 成功通过！截图报错已彻底根治且系统具备极强鲁棒性！');\nconsole.log('===============================================================\\n');\n","numLines":176,"startLine":1,"totalLines":176}}}
