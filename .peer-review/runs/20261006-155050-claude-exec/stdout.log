{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0114JaCUWBSF9AurfpoZDYzM","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\t\n9\tlet collectionsChecked = false;\n10\tasync function ensureCollections() {\n11\t  if (collectionsChecked) return;\n12\t  const collections = ['users', 'families', 'dishes', 'meals'];\n13\t  for (const name of collections) {\n14\t    try {\n15\t      if (typeof db.createCollection === 'function') {\n16\t        await db.createCollection(name);\n17\t      }\n18\t    } catch (e) {\n19\t      // 忽略已存在或无权限错误\n20\t    }\n21\t  }\n22\t  collectionsChecked = true;\n23\t}\n24\t\n25\t/**\n26\t * userAuth 云函数：用户静默鉴权与档案获取\n27\t */\n28\texports.main = async (event, context) => {\n29\t  await ensureCollections();\n30\t\n31\t  const wxContext = cloud.getWXContext();\n32\t  let openid = wxContext && wxContext.OPENID;\n33\t\n34\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n35\t  if (!openid) {\n36\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n37\t      openid = event.mockOpenid || 'mock_openid_default';\n38\t    } else {\n39\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n40\t    }\n41\t  }\n42\t\n43\t  const now = Date.now();\n44\t\n45\t  try {\n46\t    const userDocRef = db.collection('users').doc(`user_${openid}`);\n47\t    let user = null;\n48\t\n49\t    try {\n50\t      const res = await userDocRef.get();\n51\t      user = res.data;\n52\t    } catch (e) {\n53\t      // 用户首次访问，自动创建档案\n54\t      const userData = {\n55\t        openid,\n56\t        nickName: event.nickName || '家人',\n57\t        avatarUrl: event.avatarUrl || '',\n58\t        familyId: null,\n59\t        role: null,\n60\t        createdAt: now,\n61\t        updatedAt: now\n62\t      };\n63\t      await userDocRef.set({ data: userData });\n64\t      user = { _id: `user_${openid}`, ...userData };\n65\t    }\n66\t\n67\t    // 更新昵称/头像\n68\t    if (event.nickName || event.avatarUrl) {\n69\t      const updateData = { updatedAt: now };\n70\t      if (event.nickName) updateData.nickName = event.nickName;\n71\t      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n72\t      await userDocRef.update({ data: updateData });\n73\t      user = { ...user, ...updateData };\n74\t    }\n75\t\n76\t    // 若绑定了家庭，获取家庭最新信息\n77\t    let family = null;\n78\t    if (user.familyId) {\n79\t      try {\n80\t        const famRes = await db.collection('families').doc(user.familyId).get();\n81\t        if (famRes && famRes.data) {\n82\t          family = {\n83\t            id: famRes.data._id || user.familyId,\n84\t            _id: famRes.data._id || user.familyId,\n85\t            ...famRes.data\n86\t          };\n87\t        }\n88\t      } catch (err) {\n89\t        console.warn('获取用户所属家庭失败或家庭已解散', err);\n90\t        // 如果家庭已被解散，重置用户的 familyId\n91\t        await userDocRef.update({\n92\t          data: { familyId: null, role: null, updatedAt: now }\n93\t        });\n94\t        user.familyId = null;\n95\t        user.role = null;\n96\t      }\n97\t    }\n98\t\n99\t    return {\n100\t      success: true,\n101\t      openid,\n102\t      user,\n103\t      family\n104\t    };\n105\t  } catch (err) {\n106\t    return {\n107\t      success: false,\n108\t      error: err.message || '用户鉴权失败'\n109\t    };\n110\t  }\n111\t};\n112\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"4c8a7496-ff1e-4fc7-b299-25e3f34a1b4d","timestamp":"2026-10-06T07:51:00.957Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/userAuth/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\nlet collectionsChecked = false;\nasync function ensureCollections() {\n  if (collectionsChecked) return;\n  const collections = ['users', 'families', 'dishes', 'meals'];\n  for (const name of collections) {\n    try {\n      if (typeof db.createCollection === 'function') {\n        await db.createCollection(name);\n      }\n    } catch (e) {\n      // 忽略已存在或无权限错误\n    }\n  }\n  collectionsChecked = true;\n}\n\n/**\n * userAuth 云函数：用户静默鉴权与档案获取\n */\nexports.main = async (event, context) => {\n  await ensureCollections();\n\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const now = Date.now();\n\n  try {\n    const userDocRef = db.collection('users').doc(`user_${openid}`);\n    let user = null;\n\n    try {\n      const res = await userDocRef.get();\n      user = res.data;\n    } catch (e) {\n      // 用户首次访问，自动创建档案\n      const userData = {\n        openid,\n        nickName: event.nickName || '家人',\n        avatarUrl: event.avatarUrl || '',\n        familyId: null,\n        role: null,\n        createdAt: now,\n        updatedAt: now\n      };\n      await userDocRef.set({ data: userData });\n      user = { _id: `user_${openid}`, ...userData };\n    }\n\n    // 更新昵称/头像\n    if (event.nickName || event.avatarUrl) {\n      const updateData = { updatedAt: now };\n      if (event.nickName) updateData.nickName = event.nickName;\n      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n      await userDocRef.update({ data: updateData });\n      user = { ...user, ...updateData };\n    }\n\n    // 若绑定了家庭，获取家庭最新信息\n    let family = null;\n    if (user.familyId) {\n      try {\n        const famRes = await db.collection('families').doc(user.familyId).get();\n        if (famRes && famRes.data) {\n          family = {\n            id: famRes.data._id || user.familyId,\n            _id: famRes.data._id || user.familyId,\n            ...famRes.data\n          };\n        }\n      } catch (err) {\n        console.warn('获取用户所属家庭失败或家庭已解散', err);\n        // 如果家庭已被解散，重置用户的 familyId\n        await userDocRef.update({\n          data: { familyId: null, role: null, updatedAt: now }\n        });\n        user.familyId = null;\n        user.role = null;\n      }\n    }\n\n    return {\n      success: true,\n      openid,\n      user,\n      family\n    };\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '用户鉴权失败'\n    };\n  }\n};\n","numLines":112,"startLine":1,"totalLines":112}}}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfkcqnfaGjWRGnAXWYU4U","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0154SsHtHu8FhttufeiV4J3p","name":"Read","input":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/familyService.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14851,"cache_read_input_tokens":8378,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14851},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"7fba9872-1e92-46c9-8a9b-3d24baaee132","timestamp":"2026-10-06T07:51:01.490Z","request_id":"req_011CfkcqmsSgdAgxH6drvU8p","wire_tool_inputs":{"toolu_0154SsHtHu8FhttufeiV4J3p":{"file_path":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/familyService.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0154SsHtHu8FhttufeiV4J3p","type":"tool_result","content":"1\timport { cloudService } from './cloudService.js';\n2\timport type { FamilySpace, UserProfile } from '../types/family.js';\n3\t\n4\tconst STORAGE_KEY_USER = 'current_user_profile';\n5\tconst STORAGE_KEY_FAMILY = 'current_family_space';\n6\t\n7\ttype FamilyChangeListener = (family: FamilySpace | null) => void;\n8\t\n9\t/**\n10\t * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n11\t */\n12\texport function cleanInviteCode(input: any): string {\n13\t  if (!input) return '';\n14\t  let str = String(input).trim();\n15\t  // 全角数字转换为半角 (０-９ -> 0-9)\n16\t  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n17\t  // 提取纯数字\n18\t  const digits = str.replace(/\\D/g, '');\n19\t  if (digits.length === 6) return digits;\n20\t  if (digits.length > 6) {\n21\t    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n22\t    if (match) return match[0];\n23\t  }\n24\t  return digits.slice(0, 6);\n25\t}\n26\t\n27\tclass FamilyService {\n28\t  private currentUser: UserProfile = {\n29\t    openid: 'wx_user_default',\n30\t    nickName: '我',\n31\t    avatarUrl: '',\n32\t    familyId: null,\n33\t    role: null,\n34\t    createdAt: Date.now(),\n35\t    updatedAt: Date.now()\n36\t  };\n37\t\n38\t  private currentFamily: FamilySpace | null = null;\n39\t  private listeners: Set<FamilyChangeListener> = new Set();\n40\t  private initialized = false;\n41\t\n42\t  constructor() {\n43\t    this.restoreFromStorage();\n44\t  }\n45\t\n46\t  public init(): void {\n47\t    if (this.initialized) return;\n48\t    this.restoreFromStorage();\n49\t    this.initialized = true;\n50\t  }\n51\t\n52\t  private restoreFromStorage(): void {\n53\t    try {\n54\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n55\t        const storedUser = wx.getStorageSync(STORAGE_KEY_USER);\n56\t        if (storedUser) {\n57\t          this.currentUser = { ...this.currentUser, ...storedUser };\n58\t        }\n59\t        const storedFam = wx.getStorageSync(STORAGE_KEY_FAMILY);\n60\t        if (storedFam) {\n61\t          this.currentFamily = storedFam;\n62\t        }\n63\t      }\n64\t    } catch (e) {\n65\t      console.warn('读取本地家庭缓存失败', e);\n66\t    }\n67\t  }\n68\t\n69\t  private persist(): void {\n70\t    try {\n71\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n72\t        wx.setStorageSync(STORAGE_KEY_USER, this.currentUser);\n73\t        if (this.currentFamily) {\n74\t          wx.setStorageSync(STORAGE_KEY_FAMILY, this.currentFamily);\n75\t        } else {\n76\t          wx.removeStorageSync(STORAGE_KEY_FAMILY);\n77\t        }\n78\t      }\n79\t    } catch (e) {\n80\t      console.warn('持久化本地家庭缓存失败', e);\n81\t    }\n82\t    this.notifyListeners();\n83\t  }\n84\t\n85\t  public subscribe(listener: FamilyChangeListener): () => void {\n86\t    this.listeners.add(listener);\n87\t    return () => this.listeners.delete(listener);\n88\t  }\n89\t\n90\t  private notifyListeners(): void {\n91\t    for (const listener of this.listeners) {\n92\t      try {\n93\t        listener(this.currentFamily);\n94\t      } catch (err) {\n95\t        console.error('家庭状态订阅回调异常', err);\n96\t      }\n97\t    }\n98\t  }\n99\t\n100\t  public getCurrentUser(): UserProfile {\n101\t    return this.currentUser;\n102\t  }\n103\t\n104\t  public getCurrentFamily(): FamilySpace | null {\n105\t    return this.currentFamily;\n106\t  }\n107\t\n108\t  public setMockCurrentUser(openid: string, nickName: string = '家人'): void {\n109\t    this.currentUser.openid = openid;\n110\t    this.currentUser.nickName = nickName;\n111\t    this.currentUser.familyId = null;\n112\t    this.currentUser.role = null;\n113\t    this.currentFamily = null;\n114\t    this.persist();\n115\t  }\n116\t\n117\t  /**\n118\t   * 静默登录与鉴权同步\n119\t   */\n120\t  public async syncUserAuth(): Promise<UserProfile> {\n121\t    const res = await cloudService.callFunction('userAuth', {\n122\t      mockOpenid: this.currentUser.openid,\n123\t      nickName: this.currentUser.nickName,\n124\t      avatarUrl: this.currentUser.avatarUrl\n125\t    });\n126\t\n127\t    if (res.success && res.user) {\n128\t      const prevRole = this.currentUser.role;\n129\t      const prevFamily = this.currentFamily;\n130\t\n131\t      this.currentUser = {\n132\t        openid: res.openid || this.currentUser.openid,\n133\t        nickName: res.user.nickName || this.currentUser.nickName,\n134\t        avatarUrl: res.user.avatarUrl || '',\n135\t        familyId: res.user.familyId || null,\n136\t        role: res.user.role || (res.family ? (res.family.creatorOpenid === (res.openid || this.currentUser.openid) ? 'creator' : 'member') : null) || prevRole || null,\n137\t        createdAt: res.user.createdAt || Date.now(),\n138\t        updatedAt: res.user.updatedAt || Date.now()\n139\t      };\n140\t      if (res.family) {\n141\t        this.currentFamily = res.family;\n142\t      } else if (!this.currentUser.familyId) {\n143\t        // 若云端未关联家庭，但本地存在此前离线或降级创建的家庭，且当前用户是房主\n144\t        const isCreator = prevRole === 'creator' || (prevFamily && (prevFamily.creatorOpenid === this.currentUser.openid || prevFamily.creatorOpenid === 'wx_user_default' || prevFamily.creatorOpenid === 'mock_openid_default'));\n145\t        if (prevFamily && isCreator) {\n146\t          this.currentFamily = prevFamily;\n147\t          this.currentUser.role = 'creator';\n148\t          // 自动向云端静默补全注册，确保云端具备该邀请码供家人加入\n149\t          cloudService.callFunction('familyManage', {\n150\t            action: 'createFamily',\n151\t            _syncToCloud: true,\n152\t            mockOpenid: this.currentUser.openid,\n153\t            familyId: prevFamily.id || (prevFamily as any)._id,\n154\t            name: prevFamily.name,\n155\t            inviteCode: prevFamily.inviteCode,\n156\t            inviteExpiredAt: prevFamily.inviteExpiredAt,\n157\t            nickName: this.currentUser.nickName,\n158\t            avatarUrl: this.currentUser.avatarUrl\n159\t          }).then(syncRes => {\n160\t            if (syncRes.success && syncRes.family && !syncRes.isLocalFallback) {\n161\t              this.currentFamily = syncRes.family;\n162\t              this.currentUser.familyId = syncRes.family.id || syncRes.family._id;\n163\t              this.currentUser.role = 'creator';\n164\t              this.persist();\n165\t            }\n166\t          }).catch(() => {});\n167\t        } else {\n168\t          this.currentFamily = null;\n169\t        }\n170\t      }\n171\t      this.persist();\n172\t    }\n173\t\n174\t    return this.currentUser;\n175\t  }\n176\t\n177\t  /**\n178\t   * 1. 创建家庭空间\n179\t   */\n180\t  public async createFamily(name = '温馨小家食堂', nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n181\t    const callerNick = nickName || this.currentUser.nickName || '房主';\n182\t    const res = await cloudService.callFunction('familyManage', {\n183\t      action: 'createFamily',\n184\t      mockOpenid: this.currentUser.openid,\n185\t      name,\n186\t      nickName: callerNick,\n187\t      avatarUrl: this.currentUser.avatarUrl\n188\t    });\n189\t\n190\t    if (res.success && res.family) {\n191\t      this.currentFamily = res.family;\n192\t      if (res.openid) {\n193\t        this.currentUser.openid = res.openid;\n194\t      }\n195\t      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n196\t      this.currentUser.role = 'creator';\n197\t      this.currentUser.nickName = callerNick;\n198\t      this.persist();\n199\t      return { success: true, family: res.family };\n200\t    }\n201\t\n202\t    return { success: false, error: res.error || '创建家庭空间失败' };\n203\t  }\n204\t\n205\t  /**\n206\t   * 2. 口令加入家庭 (云端事务，上限 4 人，一人一家庭互斥)\n207\t   */\n208\t  public async joinFamily(inviteCode: string | number, nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n209\t    const code = cleanInviteCode(inviteCode);\n210\t    if (!code || code.length !== 6) {\n211\t      return { success: false, error: '请输入正确的6位数字邀请码' };\n212\t    }\n213\t\n214\t    const callerNick = nickName || this.currentUser.nickName || '家人';\n215\t    const res = await cloudService.callFunction('familyManage', {\n216\t      action: 'joinFamily',\n217\t      mockOpenid: this.currentUser.openid,\n218\t      inviteCode: code,\n219\t      nickName: callerNick,\n220\t      avatarUrl: this.currentUser.avatarUrl\n221\t    });\n222\t\n223\t    if (res.success && res.family) {\n224\t      this.currentFamily = res.family;\n225\t      if (res.openid) {\n226\t        this.currentUser.openid = res.openid;\n227\t      }\n228\t      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n229\t      this.currentUser.role = 'member';\n230\t      this.currentUser.nickName = callerNick;\n231\t      this.persist();\n232\t      return { success: true, family: res.family };\n233\t    }\n234\t\n235\t    return { success: false, error: res.error || '加入家庭空间失败' };\n236\t  }\n237\t\n238\t  /**\n239\t   * 3. 退出 / 解散家庭\n240\t   */\n241\t  public async leaveFamily(): Promise<{ success: boolean; error?: string }> {\n242\t    const res = await cloudService.callFunction('familyManage', {\n243\t      action: 'leaveFamily',\n244\t      mockOpenid: this.currentUser.openid\n245\t    });\n246\t\n247\t    if (res.success) {\n248\t      this.currentUser.familyId = null;\n249\t      this.currentUser.role = null;\n250\t      this.currentFamily = null;\n251\t      this.persist();\n252\t      return { success: true };\n253\t    }\n254\t\n255\t    return { success: false, error: res.error || '退出家庭失败' };\n256\t  }\n257\t\n258\t  /**\n259\t   * 4. 刷新 24 小时动态口令\n260\t   */\n261\t  public async refreshInviteCode(): Promise<{ success: boolean; inviteCode?: string; error?: string }> {\n262\t    if (!this.currentFamily) {\n263\t      return { success: false, error: '尚未加入家庭' };\n264\t    }\n265\t\n266\t    const res = await cloudService.callFunction('familyManage', {\n267\t      action: 'refreshInviteCode',\n268\t      mockOpenid: this.currentUser.openid,\n269\t      familyId: this.currentFamily.id || (this.currentFamily as any)._id\n270\t    });\n271\t\n272\t    if (res.success && res.inviteCode) {\n273\t      this.currentFamily.inviteCode = res.inviteCode;\n274\t      this.currentFamily.inviteExpiredAt = res.inviteExpiredAt;\n275\t      this.persist();\n276\t      return { success: true, inviteCode: res.inviteCode };\n277\t    }\n278\t\n279\t    return { success: false, error: res.error || '刷新邀请码失败' };\n280\t  }\n281\t}\n282\t\n283\texport const familyService = new FamilyService();\n284\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"12d963cd-3c79-4a7b-b476-208a28c24958","timestamp":"2026-10-06T07:51:01.506Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/familyService.ts","content":"import { cloudService } from './cloudService.js';\nimport type { FamilySpace, UserProfile } from '../types/family.js';\n\nconst STORAGE_KEY_USER = 'current_user_profile';\nconst STORAGE_KEY_FAMILY = 'current_family_space';\n\ntype FamilyChangeListener = (family: FamilySpace | null) => void;\n\n/**\n * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n */\nexport function cleanInviteCode(input: any): string {\n  if (!input) return '';\n  let str = String(input).trim();\n  // 全角数字转换为半角 (０-９ -> 0-9)\n  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n  // 提取纯数字\n  const digits = str.replace(/\\D/g, '');\n  if (digits.length === 6) return digits;\n  if (digits.length > 6) {\n    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n    if (match) return match[0];\n  }\n  return digits.slice(0, 6);\n}\n\nclass FamilyService {\n  private currentUser: UserProfile = {\n    openid: 'wx_user_default',\n    nickName: '我',\n    avatarUrl: '',\n    familyId: null,\n    role: null,\n    createdAt: Date.now(),\n    updatedAt: Date.now()\n  };\n\n  private currentFamily: FamilySpace | null = null;\n  private listeners: Set<FamilyChangeListener> = new Set();\n  private initialized = false;\n\n  constructor() {\n    this.restoreFromStorage();\n  }\n\n  public init(): void {\n    if (this.initialized) return;\n    this.restoreFromStorage();\n    this.initialized = true;\n  }\n\n  private restoreFromStorage(): void {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const storedUser = wx.getStorageSync(STORAGE_KEY_USER);\n        if (storedUser) {\n          this.currentUser = { ...this.currentUser, ...storedUser };\n        }\n        const storedFam = wx.getStorageSync(STORAGE_KEY_FAMILY);\n        if (storedFam) {\n          this.currentFamily = storedFam;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地家庭缓存失败', e);\n    }\n  }\n\n  private persist(): void {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(STORAGE_KEY_USER, this.currentUser);\n        if (this.currentFamily) {\n          wx.setStorageSync(STORAGE_KEY_FAMILY, this.currentFamily);\n        } else {\n          wx.removeStorageSync(STORAGE_KEY_FAMILY);\n        }\n      }\n    } catch (e) {\n      console.warn('持久化本地家庭缓存失败', e);\n    }\n    this.notifyListeners();\n  }\n\n  public subscribe(listener: FamilyChangeListener): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  private notifyListeners(): void {\n    for (const listener of this.listeners) {\n      try {\n        listener(this.currentFamily);\n      } catch (err) {\n        console.error('家庭状态订阅回调异常', err);\n      }\n    }\n  }\n\n  public getCurrentUser(): UserProfile {\n    return this.currentUser;\n  }\n\n  public getCurrentFamily(): FamilySpace | null {\n    return this.currentFamily;\n  }\n\n  public setMockCurrentUser(openid: string, nickName: string = '家人'): void {\n    this.currentUser.openid = openid;\n    this.currentUser.nickName = nickName;\n    this.currentUser.familyId = null;\n    this.currentUser.role = null;\n    this.currentFamily = null;\n    this.persist();\n  }\n\n  /**\n   * 静默登录与鉴权同步\n   */\n  public async syncUserAuth(): Promise<UserProfile> {\n    const res = await cloudService.callFunction('userAuth', {\n      mockOpenid: this.currentUser.openid,\n      nickName: this.currentUser.nickName,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.user) {\n      const prevRole = this.currentUser.role;\n      const prevFamily = this.currentFamily;\n\n      this.currentUser = {\n        openid: res.openid || this.currentUser.openid,\n        nickName: res.user.nickName || this.currentUser.nickName,\n        avatarUrl: res.user.avatarUrl || '',\n        familyId: res.user.familyId || null,\n        role: res.user.role || (res.family ? (res.family.creatorOpenid === (res.openid || this.currentUser.openid) ? 'creator' : 'member') : null) || prevRole || null,\n        createdAt: res.user.createdAt || Date.now(),\n        updatedAt: res.user.updatedAt || Date.now()\n      };\n      if (res.family) {\n        this.currentFamily = res.family;\n      } else if (!this.currentUser.familyId) {\n        // 若云端未关联家庭，但本地存在此前离线或降级创建的家庭，且当前用户是房主\n        const isCreator = prevRole === 'creator' || (prevFamily && (prevFamily.creatorOpenid === this.currentUser.openid || prevFamily.creatorOpenid === 'wx_user_default' || prevFamily.creatorOpenid === 'mock_openid_default'));\n        if (prevFamily && isCreator) {\n          this.currentFamily = prevFamily;\n          this.currentUser.role = 'creator';\n          // 自动向云端静默补全注册，确保云端具备该邀请码供家人加入\n          cloudService.callFunction('familyManage', {\n            action: 'createFamily',\n            _syncToCloud: true,\n            mockOpenid: this.currentUser.openid,\n            familyId: prevFamily.id || (prevFamily as any)._id,\n            name: prevFamily.name,\n            inviteCode: prevFamily.inviteCode,\n            inviteExpiredAt: prevFamily.inviteExpiredAt,\n            nickName: this.currentUser.nickName,\n            avatarUrl: this.currentUser.avatarUrl\n          }).then(syncRes => {\n            if (syncRes.success && syncRes.family && !syncRes.isLocalFallback) {\n              this.currentFamily = syncRes.family;\n              this.currentUser.familyId = syncRes.family.id || syncRes.family._id;\n              this.currentUser.role = 'creator';\n              this.persist();\n            }\n          }).catch(() => {});\n        } else {\n          this.currentFamily = null;\n        }\n      }\n      this.persist();\n    }\n\n    return this.currentUser;\n  }\n\n  /**\n   * 1. 创建家庭空间\n   */\n  public async createFamily(name = '温馨小家食堂', nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n    const callerNick = nickName || this.currentUser.nickName || '房主';\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'createFamily',\n      mockOpenid: this.currentUser.openid,\n      name,\n      nickName: callerNick,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.family) {\n      this.currentFamily = res.family;\n      if (res.openid) {\n        this.currentUser.openid = res.openid;\n      }\n      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n      this.currentUser.role = 'creator';\n      this.currentUser.nickName = callerNick;\n      this.persist();\n      return { success: true, family: res.family };\n    }\n\n    return { success: false, error: res.error || '创建家庭空间失败' };\n  }\n\n  /**\n   * 2. 口令加入家庭 (云端事务，上限 4 人，一人一家庭互斥)\n   */\n  public async joinFamily(inviteCode: string | number, nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n    const code = cleanInviteCode(inviteCode);\n    if (!code || code.length !== 6) {\n      return { success: false, error: '请输入正确的6位数字邀请码' };\n    }\n\n    const callerNick = nickName || this.currentUser.nickName || '家人';\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'joinFamily',\n      mockOpenid: this.currentUser.openid,\n      inviteCode: code,\n      nickName: callerNick,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.family) {\n      this.currentFamily = res.family;\n      if (res.openid) {\n        this.currentUser.openid = res.openid;\n      }\n      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n      this.currentUser.role = 'member';\n      this.currentUser.nickName = callerNick;\n      this.persist();\n      return { success: true, family: res.family };\n    }\n\n    return { success: false, error: res.error || '加入家庭空间失败' };\n  }\n\n  /**\n   * 3. 退出 / 解散家庭\n   */\n  public async leaveFamily(): Promise<{ success: boolean; error?: string }> {\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'leaveFamily',\n      mockOpenid: this.currentUser.openid\n    });\n\n    if (res.success) {\n      this.currentUser.familyId = null;\n      this.currentUser.role = null;\n      this.currentFamily = null;\n      this.persist();\n      return { success: true };\n    }\n\n    return { success: false, error: res.error || '退出家庭失败' };\n  }\n\n  /**\n   * 4. 刷新 24 小时动态口令\n   */\n  public async refreshInviteCode(): Promise<{ success: boolean; inviteCode?: string; error?: string }> {\n    if (!this.currentFamily) {\n      return { success: false, error: '尚未加入家庭' };\n    }\n\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'refreshInviteCode',\n      mockOpenid: this.currentUser.openid,\n      familyId: this.currentFamily.id || (this.currentFamily as any)._id\n    });\n\n    if (res.success && res.inviteCode) {\n      this.currentFamily.inviteCode = res.inviteCode;\n      this.currentFamily.inviteExpiredAt = res.inviteExpiredAt;\n      this.persist();\n      return { success: true, inviteCode: res.inviteCode };\n    }\n\n    return { success: false, error: res.error || '刷新邀请码失败' };\n  }\n}\n\nexport const familyService = new FamilyService();\n","numLines":284,"startLine":1,"totalLines":284}}}
