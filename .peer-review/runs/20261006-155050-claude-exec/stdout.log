{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QCqoiC2kzoLYSXc3ke37wF","type":"tool_result","content":"1\timport { preferenceService } from '../../services/preferenceService.js';\n2\timport { historyService } from '../../services/historyService.js';\n3\timport { familyService, cleanInviteCode } from '../../services/familyService.js';\n4\timport { dataProvider } from '../../services/dataProvider.js';\n5\timport { UserPreferences } from '../../types/user.js';\n6\timport { MealMode } from '../../types/menu.js';\n7\timport { FamilySpace, UserProfile } from '../../types/family.js';\n8\t\n9\tPage({\n10\t  data: {\n11\t    version: '2.11',\n12\t    preferences: {} as UserPreferences,\n13\t    dislikedMap: {} as Record<string, boolean>,\n14\t    spicyLevels: [\n15\t      { level: 0, label: '不吃辣' },\n16\t      { level: 1, label: '微辣' },\n17\t      { level: 2, label: '中辣' },\n18\t      { level: 3, label: '重辣' }\n19\t    ],\n20\t    commonAvoids: ['鱼/海鲜', '牛肉', '鸡肉', '韭菜', '香菜', '苦瓜', '生姜', '大蒜', '内脏', '羊肉'],\n21\t    availableModes: [\n22\t      { key: 'hearty_3_1', name: '3 菜 1 汤' },\n23\t      { key: 'routine_2_1', name: '2 菜 1 汤' },\n24\t      { key: 'three_dishes', name: '3 个菜' },\n25\t      { key: 'three_stir_fries', name: '3 个炒菜' }\n26\t    ],\n27\t\n28\t    // 家庭厨房相关状态\n29\t    currentUser: {} as UserProfile,\n30\t    family: null as FamilySpace | null,\n31\t    joinCodeInput: '',\n32\t    newFamilyNameInput: '',\n33\t    isCreatingFamily: false,\n34\t    isJoiningFamily: false\n35\t  },\n36\t  isSubmittingCreate: false,\n37\t  isSubmittingJoin: false,\n38\t\n39\t  onShow() {\n40\t    const app = getApp<any>();\n41\t    if (app?.globalData?.version) {\n42\t      this.setData({ version: app.globalData.version });\n43\t    }\n44\t    this.loadPreferences();\n45\t    this.loadFamilyState();\n46\t\n47\t    // 静默鉴权并同步最新家庭档案\n48\t    familyService.syncUserAuth().then(() => {\n49\t      this.loadFamilyState();\n50\t    }).catch(() => {});\n51\t  },\n52\t\n53\t  loadPreferences() {\n54\t    const pref = preferenceService.getPreferences();\n55\t    const map: Record<string, boolean> = {};\n56\t    (pref.dislikedIngredients || []).forEach(item => {\n57\t      map[item] = true;\n58\t    });\n59\t\n60\t    this.setData({\n61\t      preferences: pref,\n62\t      dislikedMap: map\n63\t    });\n64\t  },\n65\t\n66\t  loadFamilyState() {\n67\t    familyService.init();\n68\t    const user = familyService.getCurrentUser();\n69\t    const fam = familyService.getCurrentFamily();\n70\t    this.setData({\n71\t      currentUser: user,\n72\t      family: fam\n73\t    });\n74\t  },\n75\t\n76\t  handleJoinCodeInput(e: any) {\n77\t    const raw = e?.detail?.value || '';\n78\t    const cleaned = cleanInviteCode(raw);\n79\t    this.setData({\n80\t      joinCodeInput: cleaned\n81\t    });\n82\t    return cleaned;\n83\t  },\n84\t\n85\t  handleFamilyNameInput(e: any) {\n86\t    this.setData({\n87\t      newFamilyNameInput: (e?.detail?.value || '').trim()\n88\t    });\n89\t  },\n90\t\n91\t  formatErrorTip(err?: any): string {\n92\t    if (!err) return '操作失败，请重试';\n93\t    const errStr = typeof err === 'string'\n94\t      ? err\n95\t      : String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '');\n96\t    if (errStr.includes('-601034') || errStr.includes('Environment not found')) {\n97\t      return '云开发环境未就绪，已切换为本地模式';\n98\t    }\n99\t    if (errStr.includes('cloud.callFunction:fail')) {\n100\t      return '服务连接异常，请重试';\n101\t    }\n102\t    if (\n103\t      errStr.includes('-501007') ||\n104\t      errStr.includes('document.set:fail') ||\n105\t      errStr.includes('document.update:fail') ||\n106\t      errStr.includes('invalid parameters') ||\n107\t      errStr.includes('不能指定') ||\n108\t      errStr.includes('保留字段') ||\n109\t      errStr.includes('cannot update _id')\n110\t    ) {\n111\t      return '数据服务同步异常，请稍后重试';\n112\t    }\n113\t    return errStr;\n114\t  },\n115\t\n116\t  async handleCreateFamily() {\n117\t    if (this.isSubmittingCreate || this.data.isCreatingFamily) return;\n118\t    this.isSubmittingCreate = true;\n119\t    this.setData({ isCreatingFamily: true });\n120\t\n121\t    try {\n122\t      const name = this.data.newFamilyNameInput || '温馨小家食堂';\n123\t      wx.showLoading({ title: '创建中...' });\n124\t      const res = await familyService.createFamily(name);\n125\t      wx.hideLoading();\n126\t\n127\t      if (res.success && res.family) {\n128\t        this.setData({\n129\t          family: res.family,\n130\t          currentUser: familyService.getCurrentUser(),\n131\t          newFamilyNameInput: ''\n132\t        });\n133\t        wx.showToast({ title: '家庭厨房创建成功！', icon: 'success' });\n134\t        // 同步家庭历史与自选私房菜\n135\t        historyService.syncCloudHistory().catch(() => {});\n136\t        dataProvider.syncCloudCustomDishes().catch(() => {});\n137\t      } else {\n138\t        wx.showToast({ title: this.formatErrorTip(res.error), icon: 'none' });\n139\t      }\n140\t    } finally {\n141\t      this.isSubmittingCreate = false;\n142\t      this.setData({ isCreatingFamily: false });\n143\t    }\n144\t  },\n145\t\n146\t  async handleJoinFamily() {\n147\t    if (this.isSubmittingJoin || this.data.isJoiningFamily) return;\n148\t\n149\t    const raw = this.data.joinCodeInput;\n150\t    const code = cleanInviteCode(raw);\n151\t    if (!code || code.length !== 6) {\n152\t      wx.showToast({ title: '请输入6位有效数字口令', icon: 'none' });\n153\t      return;\n154\t    }\n155\t\n156\t    this.isSubmittingJoin = true;\n157\t    this.setData({ isJoiningFamily: true });\n158\t\n159\t    try {\n160\t      wx.showLoading({ title: '正在加入...' });\n161\t      const res = await familyService.joinFamily(code);\n162\t      wx.hideLoading();\n163\t\n164\t      if (res.success && res.family) {\n165\t        this.setData({\n166\t          family: res.family,\n167\t          currentUser: familyService.getCurrentUser(),\n168\t          joinCodeInput: ''\n169\t        });\n170\t        wx.showToast({ title: '成功加入家庭厨房！', icon: 'success' });\n171\t        // 同步家庭共享历史与自选私房菜\n172\t        historyService.syncCloudHistory().catch(() => {});\n173\t        dataProvider.syncCloudCustomDishes().catch(() => {});\n174\t      } else {\n175\t        wx.showToast({ title: this.formatErrorTip(res.error), icon: 'none' });\n176\t      }\n177\t    } finally {\n178\t      this.isSubmittingJoin = false;\n179\t      this.setData({ isJoiningFamily: false });\n180\t    }\n181\t  },\n182\t\n183\t  handleCopyInviteCode() {\n184\t    const code = String(this.data.family?.inviteCode || '').trim();\n185\t    if (!code) return;\n186\t    wx.setClipboardData({\n187\t      data: code,\n188\t      success: () => {\n189\t        wx.showToast({ title: '口令已复制，发给家人即可加入', icon: 'none' });\n190\t      }\n191\t    });\n192\t  },\n193\t\n194\t  async handleRefreshInviteCode() {\n195\t    wx.showLoading({ title: '刷新口令...' });\n196\t    const res = await familyService.refreshInviteCode();\n197\t    wx.hideLoading();\n198\t    if (res.success && res.inviteCode) {\n199\t      this.setData({ family: familyService.getCurrentFamily() });\n200\t      wx.showToast({ title: '已生成新口令（24h有效）', icon: 'none' });\n201\t    } else {\n202\t      wx.showToast({ title: this.formatErrorTip(res.error || '刷新失败'), icon: 'none' });\n203\t    }\n204\t  },\n205\t\n206\t  handleLeaveFamily() {\n207\t    const isCreator = this.data.currentUser?.role === 'creator';\n208\t    wx.showModal({\n209\t      title: isCreator ? '解散/退出家庭厨房？' : '退出家庭厨房？',\n210\t      content: isCreator \n211\t        ? '退出后若还有其他成员，房主将顺延转交；若无其他成员则空间将自动解散。' \n212\t        : '退出后将无法查看家庭共享做菜历史与自选私房菜，确定退出吗？',\n213\t      confirmColor: '#E6683B',\n214\t      success: async (res) => {\n215\t        if (res.confirm) {\n216\t          wx.showLoading({ title: '正在退出...' });\n217\t          const leaveRes = await familyService.leaveFamily();\n218\t          wx.hideLoading();\n219\t          if (leaveRes.success) {\n220\t            // 清理本地家庭历史与私房菜，安全恢复单人纯净模式\n221\t            historyService.clearHistory();\n222\t            dataProvider.clearCustomDishes();\n223\t            // 恢复单人 personal_${openid} 隔离桶私房菜\n224\t            dataProvider.syncCloudCustomDishes().catch(() => {});\n225\t            this.setData({\n226\t              family: null,\n227\t              currentUser: familyService.getCurrentUser()\n228\t            });\n229\t            wx.showToast({ title: '已退出家庭厨房', icon: 'none' });\n230\t          } else {\n231\t            wx.showToast({ title: this.formatErrorTip(leaveRes.error || '退出失败'), icon: 'none' });\n232\t          }\n233\t        }\n234\t      }\n235\t    });\n236\t  },\n237\t\n238\t  setSpicyLevel(e: any) {\n239\t    const level = e.currentTarget.dataset.level as number;\n240\t    const updated = preferenceService.savePreferences({ spicyLevel: level as any });\n241\t    this.setData({ preferences: updated });\n242\t    wx.showToast({ title: '辣度已更新', icon: 'none' });\n243\t  },\n244\t\n245\t  toggleAvoid(e: any) {\n246\t    const item = e.currentTarget.dataset.item as string;\n247\t    const current = this.data.preferences.dislikedIngredients || [];\n248\t    let updatedList: string[];\n249\t\n250\t    if (current.includes(item)) {\n251\t      updatedList = current.filter(i => i !== item);\n252\t    } else {\n253\t      updatedList = [...current, item];\n254\t    }\n255\t\n256\t    const updated = preferenceService.savePreferences({ dislikedIngredients: updatedList });\n257\t    const map: Record<string, boolean> = {};\n258\t    updatedList.forEach(k => { map[k] = true; });\n259\t\n260\t    this.setData({\n261\t      preferences: updated,\n262\t      dislikedMap: map\n263\t    });\n264\t  },\n265\t\n266\t  setDefaultMode(e: any) {\n267\t    const key = e.currentTarget.dataset.key as MealMode;\n268\t    const updated = preferenceService.savePreferences({ defaultMode: key });\n269\t    this.setData({ preferences: updated });\n270\t    wx.showToast({ title: '默认模式已更新', icon: 'none' });\n271\t  },\n272\t\n273\t  handleClearHistory() {\n274\t    wx.showModal({\n275\t      title: '清空就餐历史？',\n276\t      content: '清空后算法防重将重新从今天开始计算。',\n277\t      confirmColor: '#E6683B',\n278\t      success: (res) => {\n279\t        if (res.confirm) {\n280\t          historyService.clearHistory();\n281\t          wx.showToast({ title: '已清空历史', icon: 'none' });\n282\t        }\n283\t      }\n284\t    });\n285\t  }\n286\t});\n287\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"79f7ca94-74c0-46a0-b10e-d552eecda8bf","timestamp":"2026-10-06T07:51:09.986Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/pages/mine/index.ts","content":"import { preferenceService } from '../../services/preferenceService.js';\nimport { historyService } from '../../services/historyService.js';\nimport { familyService, cleanInviteCode } from '../../services/familyService.js';\nimport { dataProvider } from '../../services/dataProvider.js';\nimport { UserPreferences } from '../../types/user.js';\nimport { MealMode } from '../../types/menu.js';\nimport { FamilySpace, UserProfile } from '../../types/family.js';\n\nPage({\n  data: {\n    version: '2.11',\n    preferences: {} as UserPreferences,\n    dislikedMap: {} as Record<string, boolean>,\n    spicyLevels: [\n      { level: 0, label: '不吃辣' },\n      { level: 1, label: '微辣' },\n      { level: 2, label: '中辣' },\n      { level: 3, label: '重辣' }\n    ],\n    commonAvoids: ['鱼/海鲜', '牛肉', '鸡肉', '韭菜', '香菜', '苦瓜', '生姜', '大蒜', '内脏', '羊肉'],\n    availableModes: [\n      { key: 'hearty_3_1', name: '3 菜 1 汤' },\n      { key: 'routine_2_1', name: '2 菜 1 汤' },\n      { key: 'three_dishes', name: '3 个菜' },\n      { key: 'three_stir_fries', name: '3 个炒菜' }\n    ],\n\n    // 家庭厨房相关状态\n    currentUser: {} as UserProfile,\n    family: null as FamilySpace | null,\n    joinCodeInput: '',\n    newFamilyNameInput: '',\n    isCreatingFamily: false,\n    isJoiningFamily: false\n  },\n  isSubmittingCreate: false,\n  isSubmittingJoin: false,\n\n  onShow() {\n    const app = getApp<any>();\n    if (app?.globalData?.version) {\n      this.setData({ version: app.globalData.version });\n    }\n    this.loadPreferences();\n    this.loadFamilyState();\n\n    // 静默鉴权并同步最新家庭档案\n    familyService.syncUserAuth().then(() => {\n      this.loadFamilyState();\n    }).catch(() => {});\n  },\n\n  loadPreferences() {\n    const pref = preferenceService.getPreferences();\n    const map: Record<string, boolean> = {};\n    (pref.dislikedIngredients || []).forEach(item => {\n      map[item] = true;\n    });\n\n    this.setData({\n      preferences: pref,\n      dislikedMap: map\n    });\n  },\n\n  loadFamilyState() {\n    familyService.init();\n    const user = familyService.getCurrentUser();\n    const fam = familyService.getCurrentFamily();\n    this.setData({\n      currentUser: user,\n      family: fam\n    });\n  },\n\n  handleJoinCodeInput(e: any) {\n    const raw = e?.detail?.value || '';\n    const cleaned = cleanInviteCode(raw);\n    this.setData({\n      joinCodeInput: cleaned\n    });\n    return cleaned;\n  },\n\n  handleFamilyNameInput(e: any) {\n    this.setData({\n      newFamilyNameInput: (e?.detail?.value || '').trim()\n    });\n  },\n\n  formatErrorTip(err?: any): string {\n    if (!err) return '操作失败，请重试';\n    const errStr = typeof err === 'string'\n      ? err\n      : String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '');\n    if (errStr.includes('-601034') || errStr.includes('Environment not found')) {\n      return '云开发环境未就绪，已切换为本地模式';\n    }\n    if (errStr.includes('cloud.callFunction:fail')) {\n      return '服务连接异常，请重试';\n    }\n    if (\n      errStr.includes('-501007') ||\n      errStr.includes('document.set:fail') ||\n      errStr.includes('document.update:fail') ||\n      errStr.includes('invalid parameters') ||\n      errStr.includes('不能指定') ||\n      errStr.includes('保留字段') ||\n      errStr.includes('cannot update _id')\n    ) {\n      return '数据服务同步异常，请稍后重试';\n    }\n    return errStr;\n  },\n\n  async handleCreateFamily() {\n    if (this.isSubmittingCreate || this.data.isCreatingFamily) return;\n    this.isSubmittingCreate = true;\n    this.setData({ isCreatingFamily: true });\n\n    try {\n      const name = this.data.newFamilyNameInput || '温馨小家食堂';\n      wx.showLoading({ title: '创建中...' });\n      const res = await familyService.createFamily(name);\n      wx.hideLoading();\n\n      if (res.success && res.family) {\n        this.setData({\n          family: res.family,\n          currentUser: familyService.getCurrentUser(),\n          newFamilyNameInput: ''\n        });\n        wx.showToast({ title: '家庭厨房创建成功！', icon: 'success' });\n        // 同步家庭历史与自选私房菜\n        historyService.syncCloudHistory().catch(() => {});\n        dataProvider.syncCloudCustomDishes().catch(() => {});\n      } else {\n        wx.showToast({ title: this.formatErrorTip(res.error), icon: 'none' });\n      }\n    } finally {\n      this.isSubmittingCreate = false;\n      this.setData({ isCreatingFamily: false });\n    }\n  },\n\n  async handleJoinFamily() {\n    if (this.isSubmittingJoin || this.data.isJoiningFamily) return;\n\n    const raw = this.data.joinCodeInput;\n    const code = cleanInviteCode(raw);\n    if (!code || code.length !== 6) {\n      wx.showToast({ title: '请输入6位有效数字口令', icon: 'none' });\n      return;\n    }\n\n    this.isSubmittingJoin = true;\n    this.setData({ isJoiningFamily: true });\n\n    try {\n      wx.showLoading({ title: '正在加入...' });\n      const res = await familyService.joinFamily(code);\n      wx.hideLoading();\n\n      if (res.success && res.family) {\n        this.setData({\n          family: res.family,\n          currentUser: familyService.getCurrentUser(),\n          joinCodeInput: ''\n        });\n        wx.showToast({ title: '成功加入家庭厨房！', icon: 'success' });\n        // 同步家庭共享历史与自选私房菜\n        historyService.syncCloudHistory().catch(() => {});\n        dataProvider.syncCloudCustomDishes().catch(() => {});\n      } else {\n        wx.showToast({ title: this.formatErrorTip(res.error), icon: 'none' });\n      }\n    } finally {\n      this.isSubmittingJoin = false;\n      this.setData({ isJoiningFamily: false });\n    }\n  },\n\n  handleCopyInviteCode() {\n    const code = String(this.data.family?.inviteCode || '').trim();\n    if (!code) return;\n    wx.setClipboardData({\n      data: code,\n      success: () => {\n        wx.showToast({ title: '口令已复制，发给家人即可加入', icon: 'none' });\n      }\n    });\n  },\n\n  async handleRefreshInviteCode() {\n    wx.showLoading({ title: '刷新口令...' });\n    const res = await familyService.refreshInviteCode();\n    wx.hideLoading();\n    if (res.success && res.inviteCode) {\n      this.setData({ family: familyService.getCurrentFamily() });\n      wx.showToast({ title: '已生成新口令（24h有效）', icon: 'none' });\n    } else {\n      wx.showToast({ title: this.formatErrorTip(res.error || '刷新失败'), icon: 'none' });\n    }\n  },\n\n  handleLeaveFamily() {\n    const isCreator = this.data.currentUser?.role === 'creator';\n    wx.showModal({\n      title: isCreator ? '解散/退出家庭厨房？' : '退出家庭厨房？',\n      content: isCreator \n        ? '退出后若还有其他成员，房主将顺延转交；若无其他成员则空间将自动解散。' \n        : '退出后将无法查看家庭共享做菜历史与自选私房菜，确定退出吗？',\n      confirmColor: '#E6683B',\n      success: async (res) => {\n        if (res.confirm) {\n          wx.showLoading({ title: '正在退出...' });\n          const leaveRes = await familyService.leaveFamily();\n          wx.hideLoading();\n          if (leaveRes.success) {\n            // 清理本地家庭历史与私房菜，安全恢复单人纯净模式\n            historyService.clearHistory();\n            dataProvider.clearCustomDishes();\n            // 恢复单人 personal_${openid} 隔离桶私房菜\n            dataProvider.syncCloudCustomDishes().catch(() => {});\n            this.setData({\n              family: null,\n              currentUser: familyService.getCurrentUser()\n            });\n            wx.showToast({ title: '已退出家庭厨房', icon: 'none' });\n          } else {\n            wx.showToast({ title: this.formatErrorTip(leaveRes.error || '退出失败'), icon: 'none' });\n          }\n        }\n      }\n    });\n  },\n\n  setSpicyLevel(e: any) {\n    const level = e.currentTarget.dataset.level as number;\n    const updated = preferenceService.savePreferences({ spicyLevel: level as any });\n    this.setData({ preferences: updated });\n    wx.showToast({ title: '辣度已更新', icon: 'none' });\n  },\n\n  toggleAvoid(e: any) {\n    const item = e.currentTarget.dataset.item as string;\n    const current = this.data.preferences.dislikedIngredients || [];\n    let updatedList: string[];\n\n    if (current.includes(item)) {\n      updatedList = current.filter(i => i !== item);\n    } else {\n      updatedList = [...current, item];\n    }\n\n    const updated = preferenceService.savePreferences({ dislikedIngredients: updatedList });\n    const map: Record<string, boolean> = {};\n    updatedList.forEach(k => { map[k] = true; });\n\n    this.setData({\n      preferences: updated,\n      dislikedMap: map\n    });\n  },\n\n  setDefaultMode(e: any) {\n    const key = e.currentTarget.dataset.key as MealMode;\n    const updated = preferenceService.savePreferences({ defaultMode: key });\n    this.setData({ preferences: updated });\n    wx.showToast({ title: '默认模式已更新', icon: 'none' });\n  },\n\n  handleClearHistory() {\n    wx.showModal({\n      title: '清空就餐历史？',\n      content: '清空后算法防重将重新从今天开始计算。',\n      confirmColor: '#E6683B',\n      success: (res) => {\n        if (res.confirm) {\n          historyService.clearHistory();\n          wx.showToast({ title: '已清空历史', icon: 'none' });\n        }\n      }\n    });\n  }\n});\n","numLines":287,"startLine":1,"totalLines":287}}}
