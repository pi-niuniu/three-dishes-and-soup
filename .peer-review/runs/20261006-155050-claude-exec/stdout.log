g, ...JSON.parse(JSON.stringify(data || {})) };\n      col.set(id, updated);\n      return { stats: { updated: 1 } };\n    },\n    remove: async () => {\n      const col = getStoreMap(colName);\n      col.delete(id);\n      return { stats: { removed: 1 } };\n    }\n  };\n}\n\nfunction createCollectionRef(name) {\n  return {\n    doc: (id) => createDocRef(name, id),\n    add: async ({ data } = {}) => {\n      const col = getStoreMap(name);\n      const id = data?._id || `auto_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`;\n      const newDoc = { ...JSON.parse(JSON.stringify(data || {})), _id: id };\n      col.set(id, newDoc);\n      return { _id: id };\n    },\n    where: (query) => {\n      const col = getStoreMap(name);\n      const getMatches = () => {\n        const matches = [];\n        for (const doc of col.values()) {\n          if (matchesFilter(doc, query)) {\n            matches.push(JSON.parse(JSON.stringify(doc)));\n          }\n        }\n        return matches;\n      };\n      return {\n        get: async () => ({ data: getMatches() }),\n        count: async () => ({ total: getMatches().length }),\n        orderBy: (field, dir = 'asc') => ({\n          limit: (n) => ({\n            get: async () => {\n              const matches = getMatches();\n              matches.sort((a, b) => {\n                if (dir === 'desc') return (b[field] > a[field] ? 1 : -1);\n                return (a[field] > b[field] ? 1 : -1);\n              });\n              return { data: matches.slice(0, n) };\n            }\n          }),\n          get: async () => {\n            const matches = getMatches();\n            matches.sort((a, b) => {\n              if (dir === 'desc') return (b[field] > a[field] ? 1 : -1);\n              return (a[field] > b[field] ? 1 : -1);\n            });\n            return { data: matches };\n          }\n        }),\n        limit: (n) => ({\n          get: async () => ({ data: getMatches().slice(0, n) })\n        })\n      };\n