{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QKiPqnrVMRaybhwu4FQJTp","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\tconst _ = db.command;\n9\t\n10\tconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n11\t\n12\t/**\n13\t * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n14\t */\n15\tasync function checkTextSecurity(text, openid) {\n16\t  if (!text) return { pass: true };\n17\t  const str = String(text).trim();\n18\t  if (!str) return { pass: true };\n19\t\n20\t  // 1. 本地兜底敏感词拦截\n21\t  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n22\t    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n23\t  }\n24\t\n25\t  // 2. 微信官方 msgSecCheck 2.0 规范检测\n26\t  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n27\t    try {\n28\t      const res = await cloud.openapi.security.msgSecCheck({\n29\t        version: 2,\n30\t        scene: 1, // 1: 资料/昵称/家庭名称等\n31\t        openid,\n32\t        content: str\n33\t      });\n34\t      if (!res || !res.result || res.result.suggest !== 'pass') {\n35\t        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n36\t      }\n37\t    } catch (err) {\n38\t      console.error('[familyManage] msgSecCheck 异常:', err);\n39\t      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n40\t    }\n41\t  }\n42\t\n43\t  return { pass: true };\n44\t}\n45\t\n46\t/**\n47\t * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n48\t */\n49\tasync function generateUniqueInviteCode() {\n50\t  const now = Date.now();\n51\t  for (let attempt = 0; attempt < 10; attempt++) {\n52\t    const code = String(Math.floor(100000 + Math.random() * 900000));\n53\t    const existing = await db.collection('families').where({\n54\t      inviteCode: code,\n55\t      inviteExpiredAt: _.gt(now)\n56\t    }).count().catch(() => null);\n57\t\n58\t    if (!existing || existing.total === 0) {\n59\t      return code;\n60\t    }\n61\t  }\n62\t  return String(Math.floor(100000 + Math.random() * 900000));\n63\t}\n64\t\n65\t/**\n66\t * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n67\t */\n68\tfunction normalizeInviteCode(input) {\n69\t  if (!input) return '';\n70\t  let str = String(input).trim();\n71\t  // 全角数字转换为半角 (０-９ -> 0-9)\n72\t  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n73\t  // 提取纯数字\n74\t  const digits = str.replace(/\\D/g, '');\n75\t  if (digits.length === 6) return digits;\n76\t  if (digits.length > 6) {\n77\t    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n78\t    if (match) return match[0];\n79\t  }\n80\t  return digits.slice(0, 6);\n81\t}\n82\t\n83\tconst JOIN_RATE_LIMIT = {\n84\t  MAX_FAILURES: 5,\n85\t  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n86\t};\n87\t\n88\t/**\n89\t * 判断云开发数据库错误是否为文档不存在\n90\t */\n91\tfunction isNotFoundError(err) {\n92\t  if (!err) return false;\n93\t  const code = err?.errCode ?? err?.code;\n94\t  if (code === -502005 || String(code) === '-502005') return true;\n95\t  const msg = String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n96\t  return (\n97\t    msg.includes('does not exist') ||\n98\t    msg.includes('not exist') ||\n99\t    msg.includes('not found') ||\n100\t    msg.includes('-502005')\n101\t  );\n102\t}\n103\t\n104\t/**\n105\t * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n106\t * 严格 fail-closed：查询异常时拒绝放行\n107\t */\n108\tasync function checkJoinRateLimit(openid, now) {\n109\t  try {\n110\t    let userDoc = null;\n111\t    try {\n112\t      userDoc = await db.collection('users').doc(`user_${openid}`).get();\n113\t    } catch (docErr) {\n114\t      // 用户文档尚不存在属于正常初次状态，不当作异常\n115\t      if (isNotFoundError(docErr)) {\n116\t        return { allowed: true };\n117\t      }\n118\t      throw docErr;\n119\t    }\n120\t\n121\t    const data = userDoc?.data;\n122\t    if (!data) return { allowed: true };\n123\t\n124\t    const failCount = data.joinFailCount || 0;\n125\t    const lastFailTime = data.joinFailLastTime || 0;\n126\t\n127\t    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n128\t      return { allowed: true };\n129\t    }\n130\t\n131\t    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n132\t      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n133\t      return {\n134\t        allowed: false,\n135\t        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n136\t      };\n137\t    }\n138\t    return { allowed: true };\n139\t  } catch (err) {\n140\t    console.error('[familyManage] 检查防刷限频异常 (严格 fail-closed 拦截):', err);\n141\t    return {\n142\t      allowed: false,\n143\t      error: '安全防刷限频服务异常，请稍后重试'\n144\t    };\n145\t  }\n146\t}\n147\t\n148\t/**\n149\t * 记录一次加入失败尝试 (在事务内原子更新失败计数与时间戳，防止并发竞态丢失计数)\n150\t */\n151\tasync function recordJoinFailure(openid, now) {\n152\t  try {\n153\t    await db.runTransaction(async transaction => {\n154\t      const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n155\t      let userRes = null;\n156\t      try {\n157\t        userRes = await userDocRef.get();\n158\t      } catch (err) {\n159\t        if (!isNotFoundError(err)) {\n160\t          throw err;\n161\t        }\n162\t      }\n163\t\n164\t      const data = userRes?.data;\n165\t      const lastFailTime = data?.joinFailLastTime || 0;\n166\t      const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n167\t      const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n168\t\n169\t      if (data) {\n170\t        await userDocRef.update({\n171\t          data: {\n172\t            joinFailCount: newCount,\n173\t            joinFailLastTime: now\n174\t          }\n175\t        });\n176\t      } else {\n177\t        await userDocRef.set({\n178\t          data: {\n179\t            openid,\n180\t            nickName: '家人',\n181\t            familyId: null,\n182\t            role: null,\n183\t            joinFailCount: newCount,\n184\t            joinFailLastTime: now,\n185\t            createdAt: now,\n186\t            updatedAt: now\n187\t          }\n188\t        });\n189\t      }\n190\t    });\n191\t  } catch (err) {\n192\t    console.warn('[familyManage] 事务记录加入失败计数异常:', err);\n193\t  }\n194\t}\n195\t\n196\tlet collectionsChecked = false;\n197\tasync function ensureCollections() {\n198\t  if (collectionsChecked) return;\n199\t  const collections = ['users', 'families', 'dishes', 'meals'];\n200\t  for (const name of collections) {\n201\t    try {\n202\t      if (typeof db.createCollection === 'function') {\n203\t        await db.createCollection(name);\n204\t      }\n205\t    } catch (e) {\n206\t      // 忽略已存在或无权限错误\n207\t    }\n208\t  }\n209\t  collectionsChecked = true;\n210\t}\n211\t\n212\texports.main = async (event, context) => {\n213\t  await ensureCollections();\n214\t\n215\t  const wxContext = cloud.getWXContext();\n216\t  let openid = wxContext && wxContext.OPENID;\n217\t\n218\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n219\t  if (!openid) {\n220\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n221\t      openid = event.mockOpenid || 'mock_openid_default';\n222\t    } else {\n223\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n224\t    }\n225\t  }\n226\t\n227\t  const { action } = event;\n228\t  const now = Date.now();\n229\t\n230\t  try {\n231\t    switch (action) {\n232\t      /**\n233\t       * 1. 创建家庭空间\n234\t       */\n235\t      case 'createFamily': {\n236\t        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n237\t        const nickName = (event.nickName || '房主').trim();\n238\t\n239\t        // 安全合规校验：家庭名称与昵称\n240\t        const nameSec = await checkTextSecurity(familyName, openid);\n241\t        if (!nameSec.pass) return { success: false, error: nameSec.error };\n242\t\n243\t        const nickSec = await checkTextSecurity(nickName, openid);\n244\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n245\t\n246\t        // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n247\t        const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n248\t        let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n249\t          ? String(event.inviteCode).trim()\n250\t          : null;\n251\t        if (inviteCode) {\n252\t          const dupRes = await db.collection('families').where({\n253\t            inviteCode,\n254\t            inviteExpiredAt: _.gt(now)\n255\t          }).get().catch(() => null);\n256\t          if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n257\t            inviteCode = await generateUniqueInviteCode();\n258\t          }\n259\t        } else {\n260\t          inviteCode = await generateUniqueInviteCode();\n261\t        }\n262\t        const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n263\t          ? Number(event.inviteExpiredAt)\n264\t          : (now + 24 * 60 * 60 * 1000); // 24小时过期\n265\t\n266\t        return await db.runTransaction(async transaction => {\n267\t          const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n268\t          \n269\t          let user = null;\n270\t          try {\n271\t            const uRes = await userDocRef.get();\n272\t            user = (uRes && uRes.data) ? uRes.data : null;\n273\t          } catch (e) {\n274\t            if (isNotFoundError(e)) {\n275\t              user = null;\n276\t            } else {\n277\t              console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n278\t              throw e;\n279\t            }\n280\t          }\n281\t          if (!user) {\n282\t            user = { openid, nickName: nickName || '房主' };\n283\t          }\n284\t\n285\t          // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n286\t          if (user.familyId) {\n287\t            try {\n288\t              const oldFamilyId = user.familyId;\n289\t              const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n290\t              let oldFamRes = null;\n291\t              try {\n292\t                oldFamRes = await oldFamDocRef.get();\n293\t              } catch (famErr) {\n294\t                if (isNotFoundError(famErr)) {\n295\t                  oldFamRes = null;\n296\t                } else {\n297\t                  throw famErr;\n298\t                }\n299\t              }\n300\t              if (oldFamRes && oldFamRes.data) {\n301\t                const oldFamily = oldFamRes.data;\n302\t                const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n303\t                const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n304\t\n305\t                if (remainingMembers.length === 0) {\n306\t                  await oldFamDocRef.remove();\n307\t                } else {\n308\t                  let newCreatorOpenid = oldFamily.creatorOpenid;\n309\t                  if (oldFamily.creatorOpenid === openid) {\n310\t                    newCreatorOpenid = remainingMembers[0].openid;\n311\t                    remainingMembers[0].role = 'creator';\n312\t                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n313\t                      data: { role: 'creator', updatedAt: now }\n314\t                    }).catch(() => {});\n315\t                  }\n316\t\n317\t                  await oldFamDocRef.update({\n318\t                    data: {\n319\t                      creatorOpenid: newCreatorOpenid,\n320\t                      members: remainingMembers,\n321\t                      memberOpenids: remainingOpenids,\n322\t                      updatedAt: now\n323\t                    }\n324\t                  });\n325\t                }\n326\t              }\n327\t            } catch (e) {\n328\t              console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n329\t              throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n330\t            }\n331\t          }\n332\t\n333\t          const familyData = {\n334\t            id: familyId,\n335\t            name: familyName,\n336\t            creatorOpenid: openid,\n337\t            members: [\n338\t              {\n339\t                openid,\n340\t                nickName: nickName || user.nickName || '房主',\n341\t                avatarUrl: event.avatarUrl || user.avatarUrl || '',\n342\t                role: 'creator',\n343\t                joinedAt: now\n344\t              }\n345\t            ],\n346\t            memberOpenids: [openid],\n347\t            inviteCode,\n348\t            inviteExpiredAt,\n349\t            createdAt: now,\n350\t            updatedAt: now\n351\t          };\n352\t\n353\t          // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n354\t          await transaction.collection('families').doc(familyId).set({ data: familyData });\n355\t\n356\t          // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n357\t          await transaction.collection('users').doc(`user_${openid}`).set({\n358\t            data: {\n359\t              openid,\n360\t              nickName: nickName || user.nickName || '房主',\n361\t              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n362\t              familyId,\n363\t              role: 'creator',\n364\t              createdAt: (user && user.createdAt) || now,\n365\t              updatedAt: now\n366\t            }\n367\t          });\n368\t\n369\t          return {\n370\t            success: true,\n371\t            openid,\n372\t            family: {\n373\t              id: familyId,\n374\t              _id: familyId,\n375\t              ...familyData\n376\t            }\n377\t          };\n378\t        });\n379\t      }\n380\t\n381\t      /**\n382\t       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n383\t       */\n384\t      case 'joinFamily': {\n385\t        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n386\t        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n387\t        if (!rateLimitCheck.allowed) {\n388\t          return { success: false, error: rateLimitCheck.error };\n389\t        }\n390\t\n391\t        const cleanCode = normalizeInviteCode(event.inviteCode);\n392\t        if (!cleanCode || cleanCode.length !== 6) {\n393\t          await recordJoinFailure(openid, now);\n394\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n395\t        }\n396\t\n397\t        const memberNickName = (event.nickName || '家人').trim();\n398\t        const nickSec = await checkTextSecurity(memberNickName, openid);\n399\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n400\t\n401\t        // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n402\t        const codeStr = String(cleanCode);\n403\t        const codeNum = Number(cleanCode);\n404\t\n405\t        let matchedFamilies = [];\n406\t        let queryError = null;\n407\t\n408\t        try {\n409\t          const strRes = await db.collection('families').where({ inviteCode: codeStr }).get();\n410\t          if (strRes && strRes.data && strRes.data.length > 0) {\n411\t            matchedFamilies = matchedFamilies.concat(strRes.data);\n412\t          }\n413\t        } catch (err) {\n414\t          console.warn('[familyManage] 字符串口令查询异常:', err);\n415\t          queryError = err;\n416\t        }\n417\t\n418\t        if (!isNaN(codeNum)) {\n419\t          try {\n420\t            const numRes = await db.collection('families').where({ inviteCode: codeNum }).get();\n421\t            if (numRes && numRes.data && numRes.data.length > 0) {\n422\t              for (const doc of numRes.data) {\n423\t                const docId = doc._id || doc.id;\n424\t                if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n425\t                  matchedFamilies.push(doc);\n426\t                }\n427\t              }\n428\t            }\n429\t          } catch (err) {\n430\t            console.warn('[familyManage] 数值口令查询异常:', err);\n431\t            queryError = queryError || err;\n432\t          }\n433\t        }\n434\t\n435\t        // 如果底层数据库报错且未匹配到任何家庭，返回系统繁忙，不计入恶意失败限频\n436\t        if (queryError && matchedFamilies.length === 0) {\n437\t          const errMsg = String(queryError?.errMsg || queryError?.message || queryError);\n438\t          if (errMsg.includes('collection not exist') || errMsg.includes('-502005')) {\n439\t            return { success: false, error: '家庭数据库尚未初始化，请房主先重新创建厨房' };\n440\t          }\n441\t          return { success: false, error: '云端查询服务异常，请稍后重试' };\n442\t        }\n443\t\n444\t        if (matchedFamilies.length === 0) {\n445\t          await recordJoinFailure(openid, now);\n446\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n447\t        }\n448\t\n449\t        // 筛选未过期家庭 (按更新时间倒序优先取最新)\n450\t        matchedFamilies.sort((a, b) => (b.updatedAt || b.createdAt || 0) - (a.updatedAt || a.createdAt || 0));\n451\t        const activeFamily = matchedFamilies.find(f => !f.inviteExpiredAt || Number(f.inviteExpiredAt) > now);\n452\t\n453\t        if (!activeFamily) {\n454\t          await recordJoinFailure(openid, now);\n455\t          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n456\t        }\n457\t\n458\t        const targetFamilyId = activeFamily._id || activeFamily.id;\n459\t\n460\t        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n461\t        try {\n462\t          return await db.runTransaction(async transaction => {\n463\t            let famDoc = null;\n464\t            try {\n465\t              famDoc = await transaction.collection('families').doc(targetFamilyId).get();\n466\t            } catch (e) {\n467\t              if (isNotFoundError(e)) {\n468\t                famDoc = null;\n469\t              } else {\n470\t                throw e;\n471\t              }\n472\t            }\n473\t            if (!famDoc || !famDoc.data) {\n474\t              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n475\t              throw new Error('未找到该邀请口令对应的家庭厨房');\n476\t            }\n477\t\n478\t            const family = famDoc.data;\n479\t\n480\t            // 校验 1: 口令是否已过期 (24 小时有效)\n481\t            if (family.inviteExpiredAt && Number(family.inviteExpiredAt) <= now) {\n482\t              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n483\t              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n484\t            }\n485\t\n486\t            // 校验 2: 是否已经在该家庭中\n487\t            const isAlreadyMember = (family.memberOpenids && family.memberOpenids.includes(openid)) ||\n488\t              (family.members && family.members.some(m => m.openid === openid));\n489\t            if (isAlreadyMember) {\n490\t              // 确保用户档案同步归属\n491\t              await transaction.collection('users').doc(`user_${openid}`).update({\n492\t                data: {\n493\t                  familyId: targetFamilyId,\n494\t                  role: family.creatorOpenid === openid ? 'creator' : 'member',\n495\t                  updatedAt: now\n496\t                }\n497\t              }).catch(() => {});\n498\t\n499\t              return {\n500\t                success: true,\n501\t                openid,\n502\t                family: {\n503\t                  id: family._id || targetFamilyId,\n504\t                  _id: family._id || targetFamilyId,\n505\t                  ...family\n506\t                },\n507\t                message: '您已经在该家庭厨房中'\n508\t              };\n509\t            }\n510\t\n511\t            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n512\t            const memberCount = Math.max((family.memberOpenids || []).length, (family.members || []).length);\n513\t            if (memberCount >= 4) {\n514\t              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n515\t              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n516\t            }\n517\t\n518\t            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n519\t            let userDoc = null;\n520\t            try {\n521\t              userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n522\t            } catch (e) {\n523\t              if (isNotFoundError(e)) {\n524\t                userDoc = null;\n525\t              } else {\n526\t                throw e;\n527\t              }\n528\t            }\n529\t            const oldFamilyId = userDoc?.data?.familyId;\n530\t            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n531\t              let oldFamDoc = null;\n532\t              try {\n533\t                oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get();\n534\t              } catch (e) {\n535\t                if (isNotFoundError(e)) {\n536\t                  oldFamDoc = null;\n537\t                } else {\n538\t                  throw e;\n539\t                }\n540\t              }\n541\t              if (oldFamDoc?.data) {\n542\t                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n543\t                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n544\t\n545\t                if (remainingMembers.length === 0) {\n546\t                  await transaction.collection('families').doc(oldFamilyId).remove();\n547\t                } else {\n548\t                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n549\t                    ? remainingMembers[0].openid\n550\t                    : oldFamDoc.data.creatorOpenid;\n551\t\n552\t                  if (oldFamDoc.data.creatorOpenid === openid) {\n553\t                    remainingMembers[0].role = 'creator';\n554\t                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n555\t                      data: { role: 'creator', updatedAt: now }\n556\t                    }).catch(() => {});\n557\t                  }\n558\t\n559\t                  await transaction.collection('families').doc(oldFamilyId).update({\n560\t                    data: {\n561\t                      creatorOpenid: newCreator,\n562\t                      members: remainingMembers,\n563\t                      memberOpenids: remainingOpenids,\n564\t                      updatedAt: now\n565\t                    }\n566\t                  });\n567\t                }\n568\t              }\n569\t            }\n570\t\n571\t            // 加入新家庭\n572\t            const newMember = {\n573\t              openid,\n574\t              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n575\t              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n576\t              role: 'member',\n577\t              joinedAt: now\n578\t            };\n579\t\n580\t            const updatedMembers = [...(family.members || []), newMember];\n581\t            const updatedOpenids = Array.from(new Set([...(family.memberOpenids || []), openid]));\n582\t\n583\t            await transaction.collection('families').doc(targetFamilyId).update({\n584\t              data: {\n585\t                members: updatedMembers,\n586\t                memberOpenids: updatedOpenids,\n587\t                updatedAt: now\n588\t              }\n589\t            });\n590\t\n591\t            // 更新用户档案并重置防刷计数 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n592\t            await transaction.collection('users').doc(`user_${openid}`).set({\n593\t              data: {\n594\t                openid,\n595\t                nickName: newMember.nickName,\n596\t                avatarUrl: newMember.avatarUrl,\n597\t                familyId: targetFamilyId,\n598\t                role: 'member',\n599\t                joinFailCount: 0,\n600\t                joinFailLastTime: 0,\n601\t                createdAt: userDoc?.data?.createdAt || now,\n602\t                updatedAt: now\n603\t              }\n604\t            });\n605\t\n606\t            return {\n607\t              success: true,\n608\t              openid,\n609\t              family: {\n610\t                id: targetFamilyId,\n611\t                _id: targetFamilyId,\n612\t                ...family,\n613\t                members: updatedMembers,\n614\t                memberOpenids: updatedOpenids,\n615\t                updatedAt: now\n616\t              }\n617\t            };\n618\t          });\n619\t        } catch (trxErr) {\n620\t          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n621\t          return {\n622\t            success: false,\n623\t            error: errMsg\n624\t          };\n625\t        }\n626\t      }\n627\t\n628\t      /**\n629\t       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n630\t       */\n631\t      case 'leaveFamily': {\n632\t        return await db.runTransaction(async transaction => {\n633\t          let userDoc = null;\n634\t          try {\n635\t            userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n636\t          } catch (e) {\n637\t            if (isNotFoundError(e)) {\n638\t              userDoc = null;\n639\t            } else {\n640\t              throw e;\n641\t            }\n642\t          }\n643\t          const user = userDoc?.data;\n644\t\n645\t          if (!user || !user.familyId) {\n646\t            return { success: true, message: '当前未加入任何家庭' };\n647\t          }\n648\t\n649\t          const familyId = user.familyId;\n650\t          let famDoc = null;\n651\t          try {\n652\t            famDoc = await transaction.collection('families').doc(familyId).get();\n653\t          } catch (e) {\n654\t            if (isNotFoundError(e)) {\n655\t              famDoc = null;\n656\t            } else {\n657\t              throw e;\n658\t            }\n659\t          }\n660\t\n661\t          if (famDoc && famDoc.data) {\n662\t            const family = famDoc.data;\n663\t            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n664\t            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n665\t\n666\t            if (remainingMembers.length === 0) {\n667\t              await transaction.collection('families').doc(familyId).remove();\n668\t            } else {\n669\t              let newCreatorOpenid = family.creatorOpenid;\n670\t              if (family.creatorOpenid === openid) {\n671\t                newCreatorOpenid = remainingMembers[0].openid;\n672\t                remainingMembers[0].role = 'creator';\n673\t                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n674\t                  data: { role: 'creator', updatedAt: now }\n675\t                }).catch(() => {});\n676\t              }\n677\t\n678\t              await transaction.collection('families').doc(familyId).update({\n679\t                data: {\n680\t                  creatorOpenid: newCreatorOpenid,\n681\t                  members: remainingMembers,\n682\t                  memberOpenids: remainingOpenids,\n683\t                  updatedAt: now\n684\t                }\n685\t              });\n686\t            }\n687\t          }\n688\t\n689\t          // 重置用户家庭归属\n690\t          await transaction.collection('users').doc(`user_${openid}`).update({\n691\t            data: {\n692\t              familyId: null,\n693\t              role: null,\n694\t              updatedAt: now\n695\t            }\n696\t          });\n697\t\n698\t          return { success: true, message: '已退出家庭厨房空间' };\n699\t        });\n700\t      }\n701\t\n702\t      /**\n703\t       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n704\t       */\n705\t      case 'refreshInviteCode': {\n706\t        const { familyId } = event;\n707\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n708\t\n709\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n710\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n711\t\n712\t        const family = famRes.data;\n713\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n714\t          return { success: false, error: '无权操作非本人所属家庭' };\n715\t        }\n716\t\n717\t        const newCode = await generateUniqueInviteCode();\n718\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n719\t\n720\t        await db.collection('families').doc(familyId).update({\n721\t          data: {\n722\t            inviteCode: newCode,\n723\t            inviteExpiredAt: newExpiry,\n724\t            updatedAt: now\n725\t          }\n726\t        });\n727\t\n728\t        return {\n729\t          success: true,\n730\t          inviteCode: newCode,\n731\t          inviteExpiredAt: newExpiry\n732\t        };\n733\t      }\n734\t\n735\t      /**\n736\t       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n737\t       */\n738\t      case 'getFamily': {\n739\t        const { familyId } = event;\n740\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n741\t\n742\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n743\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n744\t\n745\t        const family = famRes.data;\n746\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n747\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n748\t        }\n749\t\n750\t        return {\n751\t          success: true,\n752\t          family: {\n753\t            id: family._id || familyId,\n754\t            _id: family._id || familyId,\n755\t            ...family\n756\t          }\n757\t        };\n758\t      }\n759\t\n760\t      default:\n761\t        return { success: false, error: `不支持的操作类型: ${action}` };\n762\t    }\n763\t  } catch (err) {\n764\t    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n765\t    return {\n766\t      success: false,\n767\t      error: errMsg\n768\t    };\n769\t  }\n770\t};\n771\t\n772\t// 内部事务辅助：退出或重置家庭成员\n773\tasync function leaveCurrentFamilyInternal(openid, familyId) {\n774\t  return await db.runTransaction(async transaction => {\n775\t    const famDocRef = transaction.collection('families').doc(familyId);\n776\t    let famRes = null;\n777\t    try {\n778\t      famRes = await famDocRef.get();\n779\t    } catch (e) {\n780\t      if (isNotFoundError(e)) {\n781\t        famRes = null;\n782\t      } else {\n783\t        throw e;\n784\t      }\n785\t    }\n786\t    if (!famRes || !famRes.data) return;\n787\t\n788\t    const family = famRes.data;\n789\t    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n790\t    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n791\t\n792\t    if (remainingMembers.length === 0) {\n793\t      await famDocRef.remove();\n794\t    } else {\n795\t      let newCreatorOpenid = family.creatorOpenid;\n796\t      if (family.creatorOpenid === openid) {\n797\t        newCreatorOpenid = remainingMembers[0].openid;\n798\t        remainingMembers[0].role = 'creator';\n799\t        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n800\t          data: { role: 'creator', updatedAt: Date.now() }\n801\t        }).catch(() => {});\n802\t      }\n803\t\n804\t      await famDocRef.update({\n805\t        data: {\n806\t          creatorOpenid: newCreatorOpenid,\n807\t          members: remainingMembers,\n808\t          memberOpenids: remainingOpenids,\n809\t          updatedAt: Date.now()\n810\t        }\n811\t      });\n812\t    }\n813\t  });\n814\t}\n815\t"}]},"parent_tool_use_id":null,"session_id":"ffb3cba0-7f1e-4336-8d18-b9d5762c891a","uuid":"875379f2-c3e5-4774-85ba-45e19333da5e","timestamp":"2026-10-06T07:50:58.520Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n/**\n * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n */\nasync function checkTextSecurity(text, openid) {\n  if (!text) return { pass: true };\n  const str = String(text).trim();\n  if (!str) return { pass: true };\n\n  // 1. 本地兜底敏感词拦截\n  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n  }\n\n  // 2. 微信官方 msgSecCheck 2.0 规范检测\n  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    try {\n      const res = await cloud.openapi.security.msgSecCheck({\n        version: 2,\n        scene: 1, // 1: 资料/昵称/家庭名称等\n        openid,\n        content: str\n      });\n      if (!res || !res.result || res.result.suggest !== 'pass') {\n        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n      }\n    } catch (err) {\n      console.error('[familyManage] msgSecCheck 异常:', err);\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n    }\n  }\n\n  return { pass: true };\n}\n\n/**\n * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n */\nasync function generateUniqueInviteCode() {\n  const now = Date.now();\n  for (let attempt = 0; attempt < 10; attempt++) {\n    const code = String(Math.floor(100000 + Math.random() * 900000));\n    const existing = await db.collection('families').where({\n      inviteCode: code,\n      inviteExpiredAt: _.gt(now)\n    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {\n      return code;\n    }\n  }\n  return String(Math.floor(100000 + Math.random() * 900000));\n}\n\n/**\n * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n */\nfunction normalizeInviteCode(input) {\n  if (!input) return '';\n  let str = String(input).trim();\n  // 全角数字转换为半角 (０-９ -> 0-9)\n  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n  // 提取纯数字\n  const digits = str.replace(/\\D/g, '');\n  if (digits.length === 6) return digits;\n  if (digits.length > 6) {\n    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n    if (match) return match[0];\n  }\n  return digits.slice(0, 6);\n}\n\nconst JOIN_RATE_LIMIT = {\n  MAX_FAILURES: 5,\n  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n};\n\n/**\n * 判断云开发数据库错误是否为文档不存在\n */\nfunction isNotFoundError(err) {\n  if (!err) return false;\n  const code = err?.errCode ?? err?.code;\n  if (code === -502005 || String(code) === '-502005') return true;\n  const msg = String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n  return (\n    msg.includes('does not exist') ||\n    msg.includes('not exist') ||\n    msg.includes('not found') ||\n    msg.includes('-502005')\n  );\n}\n\n/**\n * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n * 严格 fail-closed：查询异常时拒绝放行\n */\nasync function checkJoinRateLimit(openid, now) {\n  try {\n    let userDoc = null;\n    try {\n      userDoc = await db.collection('users').doc(`user_${openid}`).get();\n    } catch (docErr) {\n      // 用户文档尚不存在属于正常初次状态，不当作异常\n      if (isNotFoundError(docErr)) {\n        return { allowed: true };\n      }\n      throw docErr;\n    }\n\n    const data = userDoc?.data;\n    if (!data) return { allowed: true };\n\n    const failCount = data.joinFailCount || 0;\n    const lastFailTime = data.joinFailLastTime || 0;\n\n    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n      return { allowed: true };\n    }\n\n    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n      return {\n        allowed: false,\n        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n      };\n    }\n    return { allowed: true };\n  } catch (err) {\n    console.error('[familyManage] 检查防刷限频异常 (严格 fail-closed 拦截):', err);\n    return {\n      allowed: false,\n      error: '安全防刷限频服务异常，请稍后重试'\n    };\n  }\n}\n\n/**\n * 记录一次加入失败尝试 (在事务内原子更新失败计数与时间戳，防止并发竞态丢失计数)\n */\nasync function recordJoinFailure(openid, now) {\n  try {\n    await db.runTransaction(async transaction => {\n      const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n      let userRes = null;\n      try {\n        userRes = await userDocRef.get();\n      } catch (err) {\n        if (!isNotFoundError(err)) {\n          throw err;\n        }\n      }\n\n      const data = userRes?.data;\n      const lastFailTime = data?.joinFailLastTime || 0;\n      const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n      const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n\n      if (data) {\n        await userDocRef.update({\n          data: {\n            joinFailCount: newCount,\n            joinFailLastTime: now\n          }\n        });\n      } else {\n        await userDocRef.set({\n          data: {\n            openid,\n            nickName: '家人',\n            familyId: null,\n            role: null,\n            joinFailCount: newCount,\n            joinFailLastTime: now,\n            createdAt: now,\n            updatedAt: now\n          }\n        });\n      }\n    });\n  } catch (err) {\n    console.warn('[familyManage] 事务记录加入失败计数异常:', err);\n  }\n}\n\nlet collectionsChecked = false;\nasync function ensureCollections() {\n  if (collectionsChecked) return;\n  const collections = ['users', 'families', 'dishes', 'meals'];\n  for (const name of collections) {\n    try {\n      if (typeof db.createCollection === 'function') {\n        await db.createCollection(name);\n      }\n    } catch (e) {\n      // 忽略已存在或无权限错误\n    }\n  }\n  collectionsChecked = true;\n}\n\nexports.main = async (event, context) => {\n  await ensureCollections();\n\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 创建家庭空间\n       */\n      case 'createFamily': {\n        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = (event.nickName || '房主').trim();\n\n        // 安全合规校验：家庭名称与昵称\n        const nameSec = await checkTextSecurity(familyName, openid);\n        if (!nameSec.pass) return { success: false, error: nameSec.error };\n\n        const nickSec = await checkTextSecurity(nickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n        const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n          ? String(event.inviteCode).trim()\n          : null;\n        if (inviteCode) {\n          const dupRes = await db.collection('families').where({\n            inviteCode,\n            inviteExpiredAt: _.gt(now)\n          }).get().catch(() => null);\n          if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n            inviteCode = await generateUniqueInviteCode();\n          }\n        } else {\n          inviteCode = await generateUniqueInviteCode();\n        }\n        const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n          ? Number(event.inviteExpiredAt)\n          : (now + 24 * 60 * 60 * 1000); // 24小时过期\n\n        return await db.runTransaction(async transaction => {\n          const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n          \n          let user = null;\n          try {\n            const uRes = await userDocRef.get();\n            user = (uRes && uRes.data) ? uRes.data : null;\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              user = null;\n            } else {\n              console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n              throw e;\n            }\n          }\n          if (!user) {\n            user = { openid, nickName: nickName || '房主' };\n          }\n\n          // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n          if (user.familyId) {\n            try {\n              const oldFamilyId = user.familyId;\n              const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n              let oldFamRes = null;\n              try {\n                oldFamRes = await oldFamDocRef.get();\n              } catch (famErr) {\n                if (isNotFoundError(famErr)) {\n                  oldFamRes = null;\n                } else {\n                  throw famErr;\n                }\n              }\n              if (oldFamRes && oldFamRes.data) {\n                const oldFamily = oldFamRes.data;\n                const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await oldFamDocRef.remove();\n                } else {\n                  let newCreatorOpenid = oldFamily.creatorOpenid;\n                  if (oldFamily.creatorOpenid === openid) {\n                    newCreatorOpenid = remainingMembers[0].openid;\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await oldFamDocRef.update({\n                    data: {\n                      creatorOpenid: newCreatorOpenid,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            } catch (e) {\n              console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n              throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n            }\n          }\n\n          const familyData = {\n            id: familyId,\n            name: familyName,\n            creatorOpenid: openid,\n            members: [\n              {\n                openid,\n                nickName: nickName || user.nickName || '房主',\n                avatarUrl: event.avatarUrl || user.avatarUrl || '',\n                role: 'creator',\n                joinedAt: now\n              }\n            ],\n            memberOpenids: [openid],\n            inviteCode,\n            inviteExpiredAt,\n            createdAt: now,\n            updatedAt: now\n          };\n\n          // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n          await transaction.collection('families').doc(familyId).set({ data: familyData });\n\n          // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n          await transaction.collection('users').doc(`user_${openid}`).set({\n            data: {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n              familyId,\n              role: 'creator',\n              createdAt: (user && user.createdAt) || now,\n              updatedAt: now\n            }\n          });\n\n          return {\n            success: true,\n            openid,\n            family: {\n              id: familyId,\n              _id: familyId,\n              ...familyData\n            }\n          };\n        });\n      }\n\n      /**\n       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n       */\n      case 'joinFamily': {\n        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n        if (!rateLimitCheck.allowed) {\n          return { success: false, error: rateLimitCheck.error };\n        }\n\n        const cleanCode = normalizeInviteCode(event.inviteCode);\n        if (!cleanCode || cleanCode.length !== 6) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const memberNickName = (event.nickName || '家人').trim();\n        const nickSec = await checkTextSecurity(memberNickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n        const codeStr = String(cleanCode);\n        const codeNum = Number(cleanCode);\n\n        let matchedFamilies = [];\n        let queryError = null;\n\n        try {\n          const strRes = await db.collection('families').where({ inviteCode: codeStr }).get();\n          if (strRes && strRes.data && strRes.data.length > 0) {\n            matchedFamilies = matchedFamilies.concat(strRes.data);\n          }\n        } catch (err) {\n          console.warn('[familyManage] 字符串口令查询异常:', err);\n          queryError = err;\n        }\n\n        if (!isNaN(codeNum)) {\n          try {\n            const numRes = await db.collection('families').where({ inviteCode: codeNum }).get();\n            if (numRes && numRes.data && numRes.data.length > 0) {\n              for (const doc of numRes.data) {\n                const docId = doc._id || doc.id;\n                if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n                  matchedFamilies.push(doc);\n                }\n              }\n            }\n          } catch (err) {\n            console.warn('[familyManage] 数值口令查询异常:', err);\n            queryError = queryError || err;\n          }\n        }\n\n        // 如果底层数据库报错且未匹配到任何家庭，返回系统繁忙，不计入恶意失败限频\n        if (queryError && matchedFamilies.length === 0) {\n          const errMsg = String(queryError?.errMsg || queryError?.message || queryError);\n          if (errMsg.includes('collection not exist') || errMsg.includes('-502005')) {\n            return { success: false, error: '家庭数据库尚未初始化，请房主先重新创建厨房' };\n          }\n          return { success: false, error: '云端查询服务异常，请稍后重试' };\n        }\n\n        if (matchedFamilies.length === 0) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        // 筛选未过期家庭 (按更新时间倒序优先取最新)\n        matchedFamilies.sort((a, b) => (b.updatedAt || b.createdAt || 0) - (a.updatedAt || a.createdAt || 0));\n        const activeFamily = matchedFamilies.find(f => !f.inviteExpiredAt || Number(f.inviteExpiredAt) > now);\n\n        if (!activeFamily) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n        }\n\n        const targetFamilyId = activeFamily._id || activeFamily.id;\n\n        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n        try {\n          return await db.runTransaction(async transaction => {\n            let famDoc = null;\n            try {\n              famDoc = await transaction.collection('families').doc(targetFamilyId).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                famDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            if (!famDoc || !famDoc.data) {\n              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n              throw new Error('未找到该邀请口令对应的家庭厨房');\n            }\n\n            const family = famDoc.data;\n\n            // 校验 1: 口令是否已过期 (24 小时有效)\n            if (family.inviteExpiredAt && Number(family.inviteExpiredAt) <= now) {\n              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n            }\n\n            // 校验 2: 是否已经在该家庭中\n            const isAlreadyMember = (family.memberOpenids && family.memberOpenids.includes(openid)) ||\n              (family.members && family.members.some(m => m.openid === openid));\n            if (isAlreadyMember) {\n              // 确保用户档案同步归属\n              await transaction.collection('users').doc(`user_${openid}`).update({\n                data: {\n                  familyId: targetFamilyId,\n                  role: family.creatorOpenid === openid ? 'creator' : 'member',\n                  updatedAt: now\n                }\n              }).catch(() => {});\n\n              return {\n                success: true,\n                openid,\n                family: {\n                  id: family._id || targetFamilyId,\n                  _id: family._id || targetFamilyId,\n                  ...family\n                },\n                message: '您已经在该家庭厨房中'\n              };\n            }\n\n            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n            const memberCount = Math.max((family.memberOpenids || []).length, (family.members || []).length);\n            if (memberCount >= 4) {\n              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n            }\n\n            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n            let userDoc = null;\n            try {\n              userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                userDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            const oldFamilyId = userDoc?.data?.familyId;\n            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n              let oldFamDoc = null;\n              try {\n                oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get();\n              } catch (e) {\n                if (isNotFoundError(e)) {\n                  oldFamDoc = null;\n                } else {\n                  throw e;\n                }\n              }\n              if (oldFamDoc?.data) {\n                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await transaction.collection('families').doc(oldFamilyId).remove();\n                } else {\n                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n                    ? remainingMembers[0].openid\n                    : oldFamDoc.data.creatorOpenid;\n\n                  if (oldFamDoc.data.creatorOpenid === openid) {\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await transaction.collection('families').doc(oldFamilyId).update({\n                    data: {\n                      creatorOpenid: newCreator,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            }\n\n            // 加入新家庭\n            const newMember = {\n              openid,\n              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n              role: 'member',\n              joinedAt: now\n            };\n\n            const updatedMembers = [...(family.members || []), newMember];\n            const updatedOpenids = Array.from(new Set([...(family.memberOpenids || []), openid]));\n\n            await transaction.collection('families').doc(targetFamilyId).update({\n              data: {\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            });\n\n            // 更新用户档案并重置防刷计数 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n            await transaction.collection('users').doc(`user_${openid}`).set({\n              data: {\n                openid,\n                nickName: newMember.nickName,\n                avatarUrl: newMember.avatarUrl,\n                familyId: targetFamilyId,\n                role: 'member',\n                joinFailCount: 0,\n                joinFailLastTime: 0,\n                createdAt: userDoc?.data?.createdAt || now,\n                updatedAt: now\n              }\n            });\n\n            return {\n              success: true,\n              openid,\n              family: {\n                id: targetFamilyId,\n                _id: targetFamilyId,\n                ...family,\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            };\n          });\n        } catch (trxErr) {\n          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n          return {\n            success: false,\n            error: errMsg\n          };\n        }\n      }\n\n      /**\n       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n       */\n      case 'leaveFamily': {\n        return await db.runTransaction(async transaction => {\n          let userDoc = null;\n          try {\n            userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              userDoc = null;\n            } else {\n              throw e;\n            }\n          }\n          const user = userDoc?.data;\n\n          if (!user || !user.familyId) {\n            return { success: true, message: '当前未加入任何家庭' };\n          }\n\n          const familyId = user.familyId;\n          let famDoc = null;\n          try {\n            famDoc = await transaction.collection('families').doc(familyId).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              famDoc = null;\n            } else {\n              throw e;\n            }\n          }\n\n          if (famDoc && famDoc.data) {\n            const family = famDoc.data;\n            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n            if (remainingMembers.length === 0) {\n              await transaction.collection('families').doc(familyId).remove();\n            } else {\n              let newCreatorOpenid = family.creatorOpenid;\n              if (family.creatorOpenid === openid) {\n                newCreatorOpenid = remainingMembers[0].openid;\n                remainingMembers[0].role = 'creator';\n                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                  data: { role: 'creator', updatedAt: now }\n                }).catch(() => {});\n              }\n\n              await transaction.collection('families').doc(familyId).update({\n                data: {\n                  creatorOpenid: newCreatorOpenid,\n                  members: remainingMembers,\n                  memberOpenids: remainingOpenids,\n                  updatedAt: now\n                }\n              });\n            }\n          }\n\n          // 重置用户家庭归属\n          await transaction.collection('users').doc(`user_${openid}`).update({\n            data: {\n              familyId: null,\n              role: null,\n              updatedAt: now\n            }\n          });\n\n          return { success: true, message: '已退出家庭厨房空间' };\n        });\n      }\n\n      /**\n       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n       */\n      case 'refreshInviteCode': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = await generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n\n        await db.collection('families').doc(familyId).update({\n          data: {\n            inviteCode: newCode,\n            inviteExpiredAt: newExpiry,\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          inviteCode: newCode,\n          inviteExpiredAt: newExpiry\n        };\n      }\n\n      /**\n       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n       */\n      case 'getFamily': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return {\n          success: true,\n          family: {\n            id: family._id || familyId,\n            _id: family._id || familyId,\n            ...family\n          }\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n    return {\n      success: false,\n      error: errMsg\n    };\n  }\n};\n\n// 内部事务辅助：退出或重置家庭成员\nasync function leaveCurrentFamilyInternal(openid, familyId) {\n  return await db.runTransaction(async transaction => {\n    const famDocRef = transaction.collection('families').doc(familyId);\n    let famRes = null;\n    try {\n      famRes = await famDocRef.get();\n    } catch (e) {\n      if (isNotFoundError(e)) {\n        famRes = null;\n      } else {\n        throw e;\n      }\n    }\n    if (!famRes || !famRes.data) return;\n\n    const family = famRes.data;\n    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n    if (remainingMembers.length === 0) {\n      await famDocRef.remove();\n    } else {\n      let newCreatorOpenid = family.creatorOpenid;\n      if (family.creatorOpenid === openid) {\n        newCreatorOpenid = remainingMembers[0].openid;\n        remainingMembers[0].role = 'creator';\n        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n          data: { role: 'creator', updatedAt: Date.now() }\n        }).catch(() => {});\n      }\n\n      await famDocRef.update({\n        data: {\n          creatorOpenid: newCreatorOpenid,\n          members: remainingMembers,\n          memberOpenids: remainingOpenids,\n          updatedAt: Date.now()\n        }\n      });\n    }\n  });\n}\n","numLines":815,"startLine":1,"totalLines":815}}}
