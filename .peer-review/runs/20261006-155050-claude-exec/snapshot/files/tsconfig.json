{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": false,
    "paths": {
      "@/*": ["./miniprogram/*"]
    }
  },
  "include": [
    "miniprogram/**/*.ts",
    "miniprogram/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "test"
  ]
}
