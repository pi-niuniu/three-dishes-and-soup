{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"ls -l node_modules/wx-server-sdk cloudfunctions/*/node_modules/wx-server-sdk node_modules/.bin/tsc; cat node_modules/wx-server-sdk/package.json; sed -n '1,260p' node_modules/wx-server-sdk/index.js\"","aggregated_output":"zsh:1: no matches found: cloudfunctions/*/node_modules/wx-server-sdk\n{\n  \"name\": \"wx-server-sdk\",\n  \"version\": \"2.6.3\",\n  \"main\": \"index.js\"\n}\nconst store = new Map();\n\nfunction getStoreMap(collection) {\n  if (!store.has(collection)) {\n    store.set(collection, new Map());\n  }\n  return store.get(collection);\n}\n\nfunction matchesFilter(doc, query) {\n  if (!query) return true;\n  for (const [k, v] of Object.entries(query)) {\n    if (v && typeof v === 'object' && v.$gt !== undefined) {\n      if (!(doc[k] > v.$gt)) return false;\n    } else {\n      if (doc[k] !== v) return false;\n    }\n  }\n  return true;\n}\n\nfunction createDocRef(colName, id) {\n  return {\n    get: async () => {\n      const col = getStoreMap(colName);\n      if (col.has(id)) {\n        return { data: JSON.parse(JSON.stringify(col.get(id))) };\n      }\n      const err = new Error(`document.get:fail document with _id ${id} does not exist`);\n      err.errCode = -502005;\n      throw err;\n    },\n    set: async ({ data } = {}) => {\n      const col = getStoreMap(colName);\n      const newDoc = { ...JSON.parse(JSON.stringify(data || {})), _id: id };\n      col.set(id, newDoc);\n      return { _id: id, stats: { updated: 1 } };\n    },\n    update: async ({ data } = {}) => {\n      const col = getStoreMap(colName);\n      const existing = col.get(id) || { _id: id };\n      const updated = { ...existing, ...JSON.parse(JSON.stringify(data || {})) };\n      col.set(id, updated);\n      return { stats: { updated: 1 } };\n    },\n    remove: async () => {\n      const col = getStoreMap(colName);\n      col.delete(id);\n      return { stats: { removed: 1 } };\n    }\n  };\n}\n\nfunction createCollectionRef(name) {\n  return {\n    doc: (id) => createDocRef(name, id),\n    add: async ({ data } = {}) => {\n      const col = getStoreMap(name);\n      const id = data?._id || `auto_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`;\n      const newDoc = { ...JSON.parse(JSON.stringify(data || {})), _id: id };\n      col.set(id, newDoc);\n      return { _id: id };\n    },\n    where: (query) => {\n      const col = getStoreMap(name);\n      const getMatches = () => {\n        const matches = [];\n        for (const doc of col.values()) {\n          if (matchesFilter(doc, query)) {\n            matches.push(JSON.parse(JSON.stringify(doc)));\n          }\n        }\n        return matches;\n      };\n      return {\n        get: async () => ({ data: getMatches() }),\n        count: async () => ({ total: getMatches().length }),\n        orderBy: (field, dir = 'asc') => ({\n          limit: (n) => ({\n            get: async () => {\n              const matches = getMatches();\n              matches.sort((a, b) => {\n                if (dir === 'desc') return (b[field] > a[field] ? 1 : -1);\n                return (a[field] > b[field] ? 1 : -1);\n              });\n              return { data: matches.slice(0, n) };\n            }\n          }),\n          get: async () => {\n            const matches = getMatches();\n            matches.sort((a, b) => {\n              if (dir === 'desc') return (b[field] > a[field] ? 1 : -1);\n              return (a[field] > b[field] ? 1 : -1);\n            });\n            return { data: matches };\n          }\n        }),\n        limit: (n) => ({\n          get: async () => ({ data: getMatches().slice(0, n) })\n        })\n      };\n    }\n  };\n}\n\nconst mockSdk = {\n  DYNAMIC_CURRENT_ENV: 'current',\n  init: () => {},\n  getWXContext: () => ({\n    OPENID: process.env.TEST_OPENID || ''\n  }),\n  resetMemoryStore: () => {\n    store.clear();\n  },\n  database: () => ({\n    command: {\n      gt: (val) => ({ $gt: val }),\n      pull: (val) => ({ $pull: val })\n    },\n    runTransaction: async (cb) => {\n      const transaction = {\n        collection: (colName) => ({\n          doc: (docId) => createDocRef(colName, docId)\n        }),\n        rollback: async (msg) => {\n          throw new Error(msg || 'transaction rollback');\n        }\n      };\n      return await cb(transaction);\n    },\n    collection: (name) => createCollectionRef(name)\n  }),\n  openapi: {\n    security: {\n      msgSecCheck: async () => ({ errCode: 0, result: { suggest: 'pass' } })\n    }\n  }\n};\n\nmodule.exports = mockSdk;\n","exit_code":0,"status":"completed"}}
