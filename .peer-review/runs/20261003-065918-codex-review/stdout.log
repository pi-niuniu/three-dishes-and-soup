{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba cloudfunctions/familyManage/index.js | sed -n '430,610p'; nl -ba cloudfunctions/upsertMeal/index.js\"","aggregated_output":"   430\t\n   431\t              await transaction.collection('families').doc(familyId).update({\n   432\t                data: {\n   433\t                  creatorOpenid: newCreatorOpenid,\n   434\t                  members: remainingMembers,\n   435\t                  memberOpenids: remainingOpenids,\n   436\t                  updatedAt: now\n   437\t                }\n   438\t              });\n   439\t            }\n   440\t          }\n   441\t\n   442\t          // 重置用户家庭归属\n   443\t          await transaction.collection('users').doc(`user_${openid}`).update({\n   444\t            data: {\n   445\t              familyId: null,\n   446\t              role: null,\n   447\t              updatedAt: now\n   448\t            }\n   449\t          });\n   450\t\n   451\t          return { success: true, message: '已退出家庭厨房空间' };\n   452\t        });\n   453\t      }\n   454\t\n   455\t      /**\n   456\t       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n   457\t       */\n   458\t      case 'refreshInviteCode': {\n   459\t        const { familyId } = event;\n   460\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n   461\t\n   462\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n   463\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n   464\t\n   465\t        const family = famRes.data;\n   466\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n   467\t          return { success: false, error: '无权操作非本人所属家庭' };\n   468\t        }\n   469\t\n   470\t        const newCode = await generateUniqueInviteCode();\n   471\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n   472\t\n   473\t        await db.collection('families').doc(familyId).update({\n   474\t          data: {\n   475\t            inviteCode: newCode,\n   476\t            inviteExpiredAt: newExpiry,\n   477\t            updatedAt: now\n   478\t          }\n   479\t        });\n   480\t\n   481\t        return {\n   482\t          success: true,\n   483\t          inviteCode: newCode,\n   484\t          inviteExpiredAt: newExpiry\n   485\t        };\n   486\t      }\n   487\t\n   488\t      /**\n   489\t       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n   490\t       */\n   491\t      case 'getFamily': {\n   492\t        const { familyId } = event;\n   493\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n   494\t\n   495\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n   496\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n   497\t\n   498\t        const family = famRes.data;\n   499\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n   500\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n   501\t        }\n   502\t\n   503\t        return {\n   504\t          success: true,\n   505\t          family\n   506\t        };\n   507\t      }\n   508\t\n   509\t      default:\n   510\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   511\t    }\n   512\t  } catch (err) {\n   513\t    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n   514\t    return {\n   515\t      success: false,\n   516\t      error: errMsg\n   517\t    };\n   518\t  }\n   519\t};\n   520\t\n   521\t// 内部事务辅助：退出或重置家庭成员\n   522\tasync function leaveCurrentFamilyInternal(openid, familyId) {\n   523\t  return await db.runTransaction(async transaction => {\n   524\t    const famDocRef = transaction.collection('families').doc(familyId);\n   525\t    const famRes = await famDocRef.get().catch(() => null);\n   526\t    if (!famRes || !famRes.data) return;\n   527\t\n   528\t    const family = famRes.data;\n   529\t    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n   530\t    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n   531\t\n   532\t    if (remainingMembers.length === 0) {\n   533\t      await famDocRef.remove();\n   534\t    } else {\n   535\t      let newCreatorOpenid = family.creatorOpenid;\n   536\t      if (family.creatorOpenid === openid) {\n   537\t        newCreatorOpenid = remainingMembers[0].openid;\n   538\t        remainingMembers[0].role = 'creator';\n   539\t        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n   540\t          data: { role: 'creator', updatedAt: Date.now() }\n   541\t        }).catch(() => {});\n   542\t      }\n   543\t\n   544\t      await famDocRef.update({\n   545\t        data: {\n   546\t          creatorOpenid: newCreatorOpenid,\n   547\t          members: remainingMembers,\n   548\t          memberOpenids: remainingOpenids,\n   549\t          updatedAt: Date.now()\n   550\t        }\n   551\t      });\n   552\t    }\n   553\t  });\n   554\t}\n     1\tconst cloud = require('wx-server-sdk');\n     2\t\n     3\tcloud.init({\n     4\t  env: cloud.DYNAMIC_CURRENT_ENV\n     5\t});\n     6\t\n     7\tconst db = cloud.database();\n     8\tconst _ = db.command;\n     9\t\n    10\texports.main = async (event, context) => {\n    11\t  const wxContext = cloud.getWXContext();\n    12\t  let openid = wxContext && wxContext.OPENID;\n    13\t\n    14\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n    15\t  if (!openid) {\n    16\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n    17\t      openid = event.mockOpenid || 'mock_openid_default';\n    18\t    } else {\n    19\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    20\t    }\n    21\t  }\n    22\t\n    23\t  const { action = 'upsertMeal' } = event;\n    24\t  const now = Date.now();\n    25\t\n    26\t  try {\n    27\t    switch (action) {\n    28\t      /**\n    29\t       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n    30\t       * 彻底杜绝同日多次做菜被覆盖问题\n    31\t       */\n    32\t      case 'upsertMeal': {\n    33\t        const { familyId, date, meal } = event;\n    34\t        if (!familyId || !date || !meal) {\n    35\t          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n    36\t        }\n    37\t\n    38\t        // 服务端鉴权：验证 openid 确实属于该家庭\n    39\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n    40\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n    41\t          return { success: false, error: '越权操作：您不属于该家庭空间' };\n    42\t        }\n    43\t\n    44\t        const docId = `meal_${familyId}_${date}`;\n    45\t\n    46\t        // 服务端已核验昵称：优先从 family.members 取真实成员昵称，杜绝客户端伪造\n    47\t        const verifiedMember = (famDoc.data.members || []).find(m => m.openid === openid);\n    48\t        const verifiedNickName = (verifiedMember && verifiedMember.nickName && verifiedMember.nickName.trim())\n    49\t          ? verifiedMember.nickName.trim()\n    50\t          : (meal.confirmedByName || event.nickName || '家人');\n    51\t\n    52\t        // 规范化单餐快照数据\n    53\t        const mealSnapshot = {\n    54\t          mealId: meal.mealId || `m_${now}`,\n    55\t          mealType: meal.mealType || '午餐',\n    56\t          mode: meal.mode || 'hearty_3_1',\n    57\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n    58\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n    59\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n    60\t          confirmedBy: openid,\n    61\t          confirmedByName: verifiedNickName,\n    62\t          timestamp: meal.timestamp || now\n    63\t        };\n    64\t\n    65\t        return await db.runTransaction(async transaction => {\n    66\t          const docRef = transaction.collection('meal_history').doc(docId);\n    67\t          const existingDoc = await docRef.get().catch(() => null);\n    68\t\n    69\t          if (!existingDoc || !existingDoc.data) {\n    70\t            // 该日首次开饭，创建日文档 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n    71\t            await docRef.set({\n    72\t              data: {\n    73\t                familyId,\n    74\t                date,\n    75\t                meals: [mealSnapshot],\n    76\t                updatedAt: now\n    77\t              }\n    78\t            });\n    79\t          } else {\n    80\t            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n    81\t            const existingMeals = existingDoc.data.meals || [];\n    82\t            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n    83\t\n    84\t            let updatedMeals;\n    85\t            if (mealIndex >= 0) {\n    86\t              // 同一餐次就地更新 (如反复确认)\n    87\t              updatedMeals = [...existingMeals];\n    88\t              updatedMeals[mealIndex] = mealSnapshot;\n    89\t            } else {\n    90\t              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n    91\t              updatedMeals = [...existingMeals, mealSnapshot];\n    92\t            }\n    93\t\n    94\t            await docRef.update({\n    95\t              data: {\n    96\t                meals: updatedMeals,\n    97\t                updatedAt: now\n    98\t              }\n    99\t            });\n   100\t          }\n   101\t\n   102\t          return {\n   103\t            success: true,\n   104\t            docId,\n   105\t            meal: mealSnapshot\n   106\t          };\n   107\t        });\n   108\t      }\n   109\t\n   110\t      /**\n   111\t       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n   112\t       */\n   113\t      case 'getHistory': {\n   114\t        const { familyId, limitDays = 60 } = event;\n   115\t        if (!familyId) {\n   116\t          return { success: false, error: '缺少 familyId' };\n   117\t        }\n   118\t\n   119\t        // 服务端鉴权：验证 openid 确实属于该家庭\n   120\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n   121\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n   122\t          return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n   123\t        }\n   124\t\n   125\t        // 查询该家庭最近的日文档\n   126\t        const res = await db.collection('meal_history')\n   127\t          .where({ familyId })\n   128\t          .orderBy('date', 'desc')\n   129\t          .limit(limitDays)\n   130\t          .get();\n   131\t\n   132\t        const docs = res.data || [];\n   133\t        // 展平为有序餐次列表供客户端秒级合并\n   134\t        const allMeals = [];\n   135\t        for (const doc of docs) {\n   136\t          for (const m of (doc.meals || [])) {\n   137\t            allMeals.push({\n   138\t              id: m.mealId,\n   139\t              menuId: m.mealId,\n   140\t              mealId: m.mealId,\n   141\t              date: doc.date,\n   142\t              timestamp: m.timestamp,\n   143\t              mode: m.mode,\n   144\t              mealType: m.mealType,\n   145\t              dishIds: m.dishIds,\n   146\t              dishNames: m.dishNames,\n   147\t              dishes: m.dishes,\n   148\t              confirmedBy: m.confirmedBy,\n   149\t              confirmedByName: m.confirmedByName,\n   150\t              familyId: doc.familyId,\n   151\t              syncStatus: 'synced'\n   152\t            });\n   153\t          }\n   154\t        }\n   155\t\n   156\t        // 按时间戳倒序排列\n   157\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n   158\t\n   159\t        return {\n   160\t          success: true,\n   161\t          records: allMeals,\n   162\t          docs\n   163\t        };\n   164\t      }\n   165\t\n   166\t      default:\n   167\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   168\t    }\n   169\t  } catch (err) {\n   170\t    return {\n   171\t      success: false,\n   172\t      error: err.message || '历史记录同步失败'\n   173\t    };\n   174\t  }\n   175\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"已确认家庭人数检查和多餐记录写入使用了事务；同时发现家庭切换与错误处理仍有数据一致性风险。接下来核对八套测试的隔离方式和离线同步流程，判断现有测试是否覆盖这些边界。"}}
