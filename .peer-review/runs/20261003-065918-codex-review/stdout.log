turn '包菜';\n    33\t  if (p === '青菜心' || p === '菜心') return '青菜心';\n    34\t  if (p === '铁棍山药' || p === '山药') return '山药';\n    35\t  if (p === '嫩荷兰豆' || p === '荷兰豆') return '荷兰豆';\n    36\t  if (p === '鲜佛手瓜' || p === '佛手瓜') return '佛手瓜';\n    37\t  if (p === '鲜西葫芦' || p === '西葫芦' || p === '西葫芦丝') return '西葫芦';\n    38\t  if (p === '矮脚奶白菜' || p === '奶白菜') return '奶白菜';\n    39\t  if (p === '新鲜菠菜' || p === '菠菜') return '菠菜';\n    40\t  if (p === '鲜金针菇' || p === '金针菇') return '金针菇';\n    41\t  if (p === '新鲜口蘑' || p === '口蘑') return '口蘑';\n    42\t  if (p === '东北油豆角' || p === '油豆角') return '油豆角';\n    43\t  if (p === '新鲜茴香' || p === '茴香') return '茴香';\n    44\t  if (p === '新鲜红苋菜' || p === '红苋菜') return '红苋菜';\n    45\t  return p;\n    46\t}\n    47\t\n    48\tfunction getProduceKeys(dish: Dish): string[] {\n    49\t  const produceList = [\n    50\t    '丝瓜', '番茄', '西红柿', '冬瓜', '南瓜尖', '卷心菜', '包菜', '四季豆', '圆茄子', '茄子', '土豆',\n    51\t    '嫩豆腐', '老豆腐', '豆腐', '毛豆米', '毛豆', '白玉菇', '白萝卜', '萝卜', '空心菜', '茼蒿', '莲藕', '藕',\n    52\t    '莴笋', '菜心', '青菜心', '蒜苔', '西兰花', '散花菜', '花菜', '豆芽',\n    53\t    '豌豆尖', '山药', '黄瓜', '木耳', '黑木耳', '香菇', '板栗',\n    54\t    '西葫芦', '佛手瓜', '荷兰豆', '油豆角', '奶白菜', '菠菜', '金针菇', '口蘑', '茴香', '红苋菜'\n    55\t  ];\n    56\t  const found = new Set<string>();\n    57\t  for (const p of produceList) {\n    58\t    if (dish.name?.includes(p) || dish.mainIngredient?.includes(p)) {\n    59\t      found.add(normalizeProduce(p));\n    60\t    }\n    61\t  }\n    62\t  for (const ing of (dish.ingredients || [])) {\n    63\t    if (ing.isMain || ing.amount >= 80) {\n    64\t      for (const p of produceList) {\n    65\t        if (ing.name?.includes(p)) {\n    66\t          found.add(normalizeProduce(p));\n    67\t        }\n    68\t      }\n    69\t    }\n    70\t  }\n    71\t  return Array.from(found);\n    72\t}\n    73\t\n    74\texport class MenuRecommendationEngine {\n    75\t  public generateMenu(params: RecommendationParams): TableMenu {\n    76\t    const {\n    77\t      mode,\n    78\t      currentMonth,\n    79\t      preferences,\n    80\t      history,\n    81\t      allDishes,\n    82\t      lockedSlots,\n    83\t      portionScale = 1.8,\n    84\t      targetDateDay = 'tomorrow'\n    85\t    } = params;\n    86\t\n    87\t    let eligibleDishes = this.filterDishes(allDishes, preferences);\n    88\t\n    89\t    if (mode === 'three_stir_fries') {\n    90\t      const stirFriesOnly = eligibleDishes.filter(\n    19\t  _unsubscribe: null as (() => void) | null,\n    20\t\n    21\t  onShow() {\n    22\t    this.checkFamilyStatus();\n    23\t    this.loadHistory();\n    24\t\n    25\t    // 订阅历史变化 (SWR 后台增量拉取完成后自动重绘)\n    26\t    if (!this._unsubscribe) {\n    27\t      this._unsubscribe = historyService.subscribe(() => {\n    28\t        this.loadHistory();\n    29\t      });\n    30\t    }\n    31\t\n    32\t    // 后台静默发起云端增量同步 (0ms 离线秒开，后台异步拉取)\n    33\t    historyService.syncCloudHistory().then(() => {\n    34\t      this.loadHistory();\n    35\t    }).catch(() => {});\n    36\t  },\n    37\t\n    38\t  onHide() {\n    39\t    if (this._unsubscribe) {\n    40\t      this._unsubscribe();\n    41\t      this._unsubscribe = null;\n    42\t    }\n    43\t  },\n    44\t\n    45\t  onUnload() {\n    46\t    if (this._unsubscribe) {\n    47\t      this._unsubscribe();\n    48\t      this._unsubscribe = null;\n    49\t    }\n    50\t  },\n    51\t\n    52\t  checkFamilyStatus() {\n    53\t    familyService.init();\n    54\t    const fam = familyService.getCurrentFamily();\n    55\t    const hasFamily = Boolean(fam);\n    56\t    this.setData({\n    57\t      hasFamily,\n    58\t      syncStatusText: hasFamily ? '☁️ 全家共享就餐足迹' : '📅 30 天就餐足迹'\n    59\t    });\n    60\t  },\n    61\t\n    62\t  loadHistory() {\n    63\t    const list = historyService.getHistory();\n    64\t    const allDishes = dataProvider.getAllDishes();\n    65\t    const dishMap = new Map(allDishes.map(d => [d.name, d]));\n    66\t\n    67\t    const enrichedList = list.map(record => {\n    68\t      // 优先从已保存的 dishes 结构还原，没有则回溯查表\n    69\t      const dishes = (record.dishes && record.dishes.length > 0)\n    70\t        ? record.dishes.map(d => {\n    71\t            const found = dishMap.get(d.name);\n    72\t            return {\n    73\t              name: d.name,\n    74\t              category: d.category || found?.category,\n    75\t              thumbUrl: d.thumbUrl || found?.thumbUrl || imageService.getDefaultImage(d.category || found?.category),\n    76\t              dishEmoji: d.dishEmoji || found?.dishEmoji || '🍲'\n    77\t            };\n    78\t          })\n    79\t        : (record.dishNames || []).map(name => {\n    80\t            const found = dishMap.get(name);\n    81\t            return {\n    82\t              name,\n    83\t              category: found?.category,\n    84\t              thumbUrl: found?.thumbUrl || imageService.getDefaultImage(found?.category),\n    85\t              dishEmoji: found?.dishEmoji || '🍲'\n    86\t            };\n    87\t          });\n    88\t\n    89\t      return {\n    90\t        ...record,\n    91\t        mealTypeLabel: record.mealType || '正餐',\n    92\t        confirmedByText: record.confirmedByName ? `${record.confirmedByName} 确认开饭` : '',\n    93\t        dishes\n    94\t      };\n    95\t    });\n    96\t\n    97\t    this.setData({ records: enrichedList });\n    98\t  },\n    99\t\n   100\t  handleHistoryImageError(e: any) {\n   101\t    const recIndex = e?.currentTarget?.dataset?.recordIndex;\n   102\t    const dishIndex = e?.currentTarget?.dataset?.dishIndex;\n   103\t    if (typeof recIndex !== 'number' || typeof dishIndex !== 'number') return;\n     1\timport { dataProvider } from '../../../services/dataProvider.js';\n     2\timport { DishCategory } from '../../../types/dish.js';\n     3\t\n     4\tPage({\n     5\t  data: {\n     6\t    dishName: '',\n     7\t    selectedCategory: 'secondary_meat' as DishCategory,\n     8\t    categoryOptions: [\n     9\t      { key: 'main_meat', label: '主荤 (硬菜/炖肉)', icon: '🥩' },\n    10\t      { key: 'secondary_meat', label: '副荤 (家常小炒)', icon: '🥘' },\n    11\t      { key: 'vegetable', label: '素菜 (时蔬/菌菇)', icon: '🥬' },\n    12\t      { key: 'soup', label: '靓汤 (养胃暖汤)', icon: '🍲' },\n    13\t      { key: 'staple_sauce', label: '主食 (面饭炒饭)', icon: '🍚' }\n    14\t    ],\n    15\t    selectedTastes: ['家常'] as string[],\n    16\t    tasteOptions: ['家常', '清淡', '咸鲜', '微辣', '酸甜', '浓郁'],\n    17\t    selectedTime: 25,\n    18\t    timeOptions: [\n    19\t      { minutes: 15, label: '15分钟 (快手)' },\n    20\t      { minutes: 25, label: '25分钟 (适中)' },\n    21\t      { minutes: 40, label: '40分钟 (慢火)' },\n    22\t      { minutes: 60, label: '60分钟 (功夫)' }\n    23\t    ],\n    24\t    submitting: false\n    25\t  },\n    26\t\n    27\t  handleNameInput(e: any) {\n    28\t    const val = (e?.detail?.value || '').slice(0, 20);\n    29\t    this.setData({ dishName: val });\n    30\t  },\n    31\t\n    32\t  selectCategory(e: any) {\n    33\t    const cat = e?.currentTarget?.dataset?.cat as DishCategory;\n    34\t    if (cat) {\n    35\t      this.setData({ selectedCategory: cat });\n    36\t    }\n    37\t  },\n    38\t\n    39\t  toggleTaste(e: any) {\n    40\t    const taste = e?.currentTarget?.dataset?.taste as string;\n    41\t    if (!taste) return;\n    42\t\n    43\t    let list = [...this.data.selectedTastes];\n    44\t    if (list.includes(taste)) {\n    45\t      if (list.length > 1) {\n    46\t        list = list.filter(t => t !== taste);\n    47\t      }\n    48\t    } else {\n    49\t      if (list.length < 3) {\n    50\t        list.push(taste);\n    51\t      } else {\n    52\t        wx.showToast({ title: '最多选择3个口味标签', icon: 'none' });\n    53\t        return;\n    54\t      }\n    55\t    }\n    56\t    this.setData({ selectedTastes: list });\n    57\t  },\n    58\t\n    59\t  selectTime(e: any) {\n    60\t    const minutes = Number(e?.currentTarget?.dataset?.minutes) || 25;\n    61\t    this.setData({ selectedTime: minutes });\n    62\t  },\n    63\t\n    64\t  async handleSubmit() {\n    65\t    const name = this.data.dishName.trim();\n    66\t    if (!name) {\n    67\t      wx.showToast({ title: '请输入菜品名称', icon: 'none' });\n    68\t      return;\n    69\t    }\n    70\t\n    71\t    if (name.length > 20) {\n    72\t      wx.showToast({ title: '菜名最多20个字', icon: 'none' });\n    73\t      return;\n    74\t    }\n    75\t\n    76\t    // 前端敏感词初筛 (易错点 7 防御)\n    77\t    const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄'];\n    78\t    if (sensitiveWords.some(w => name.includes(w))) {\n    79\t      wx.showModal({\n    80\t        title: '提示',\n    81\t        content: '菜品名称包含敏感内容，请修改后重试',\n    82\t        showCancel: false,\n    83\t        confirmColor: '#E6683B'\n    84\t      });\n    85\t      return;\n    86\t    }\n    87\t\n    88\t    this.setData({ submitting: true });\n    89\t    wx.showLoading({ title: '正在录入...' });\n    90\t\n    91\t    try {\n    92\t      await dataProvider.addCustomDish({\n    93\t        name,\n    94\t        category: this.data.selectedCategory,\n    95\t        taste: this.data.selectedTastes,\n    96\t        cookingTimeMinutes: this.data.selectedTime,\n    97\t        tags: ['自选私房菜', '纯文字录入']\n    98\t      });\n    99\t\n   100\t      wx.hideLoading();\n   101\t      wx.showToast({ title: '添加私房菜成功！', icon: 'success' });\n   102\t\n   103\t      setTimeout(() => {\n   104\t        wx.navigateBack();\n   105\t      }, 1000);\n   106\t    } catch (err: any) {\n   107\t      wx.hideLoading();\n   108\t      this.setData({ submitting: false });\n   109\t      wx.showToast({ title: err?.message || '添加失败，请重试', icon: 'none' });\n   110\t    }\n   111\t  }\n   112\t});\n","exit_code":0,"status":"completed"}}
