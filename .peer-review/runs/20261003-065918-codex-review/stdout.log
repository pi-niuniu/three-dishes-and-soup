{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba cloudfunctions/upsertMeal/index.js; nl -ba cloudfunctions/customDish/index.js; nl -ba cloudfunctions/userAuth/index.js'","aggregated_output":"     1\tconst cloud = require('wx-server-sdk');\n     2\t\n     3\tcloud.init({\n     4\t  env: cloud.DYNAMIC_CURRENT_ENV\n     5\t});\n     6\t\n     7\tconst db = cloud.database();\n     8\tconst _ = db.command;\n     9\t\n    10\texports.main = async (event, context) => {\n    11\t  const wxContext = cloud.getWXContext();\n    12\t  let openid = wxContext && wxContext.OPENID;\n    13\t\n    14\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n    15\t  if (!openid) {\n    16\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n    17\t      openid = event.mockOpenid || 'mock_openid_default';\n    18\t    } else {\n    19\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    20\t    }\n    21\t  }\n    22\t\n    23\t  const { action = 'upsertMeal' } = event;\n    24\t  const now = Date.now();\n    25\t\n    26\t  try {\n    27\t    switch (action) {\n    28\t      /**\n    29\t       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n    30\t       * 彻底杜绝同日多次做菜被覆盖问题\n    31\t       */\n    32\t      case 'upsertMeal': {\n    33\t        const { familyId, date, meal } = event;\n    34\t        if (!familyId || !date || !meal) {\n    35\t          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n    36\t        }\n    37\t\n    38\t        // 服务端鉴权：验证 openid 确实属于该家庭\n    39\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n    40\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n    41\t          return { success: false, error: '越权操作：您不属于该家庭空间' };\n    42\t        }\n    43\t\n    44\t        const docId = `meal_${familyId}_${date}`;\n    45\t\n    46\t        // 服务端已核验昵称：优先从 family.members 取真实成员昵称，杜绝客户端伪造\n    47\t        const verifiedMember = (famDoc.data.members || []).find(m => m.openid === openid);\n    48\t        const verifiedNickName = (verifiedMember && verifiedMember.nickName && verifiedMember.nickName.trim())\n    49\t          ? verifiedMember.nickName.trim()\n    50\t          : (meal.confirmedByName || event.nickName || '家人');\n    51\t\n    52\t        // 规范化单餐快照数据\n    53\t        const mealSnapshot = {\n    54\t          mealId: meal.mealId || `m_${now}`,\n    55\t          mealType: meal.mealType || '午餐',\n    56\t          mode: meal.mode || 'hearty_3_1',\n    57\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n    58\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n    59\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n    60\t          confirmedBy: openid,\n    61\t          confirmedByName: verifiedNickName,\n    62\t          timestamp: meal.timestamp || now\n    63\t        };\n    64\t\n    65\t        return await db.runTransaction(async transaction => {\n    66\t          const docRef = transaction.collection('meal_history').doc(docId);\n    67\t          const existingDoc = await docRef.get().catch(() => null);\n    68\t\n    69\t          if (!existingDoc || !existingDoc.data) {\n    70\t            // 该日首次开饭，创建日文档 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n    71\t            await docRef.set({\n    72\t              data: {\n    73\t                familyId,\n    74\t                date,\n    75\t                meals: [mealSnapshot],\n    76\t                updatedAt: now\n    77\t              }\n    78\t            });\n    79\t          } else {\n    80\t            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n    81\t            const existingMeals = existingDoc.data.meals || [];\n    82\t            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n    83\t\n    84\t            let updatedMeals;\n    85\t            if (mealIndex >= 0) {\n    86\t              // 同一餐次就地更新 (如反复确认)\n    87\t              updatedMeals = [...existingMeals];\n    88\t              updatedMeals[mealIndex] = mealSnapshot;\n    89\t            } else {\n    90\t              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n    91\t              updatedMeals = [...existingMeals, mealSnapshot];\n    92\t            }\n    93\t\n    94\t            await docRef.update({\n    95\t              data: {\n    96\t                meals: updatedMeals,\n    97\t                updatedAt: now\n    98\t              }\n    99\t            });\n   100\t          }\n   101\t\n   102\t          return {\n   103\t            success: true,\n   104\t            docId,\n   105\t            meal: mealSnapshot\n   106\t          };\n   107\t        });\n   108\t      }\n   109\t\n   110\t      /**\n   111\t       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n   112\t       */\n   113\t      case 'getHistory': {\n   114\t        const { familyId, limitDays = 60 } = event;\n   115\t        if (!familyId) {\n   116\t          return { success: false, error: '缺少 familyId' };\n   117\t        }\n   118\t\n   119\t        // 服务端鉴权：验证 openid 确实属于该家庭\n   120\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n   121\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n   122\t          return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n   123\t        }\n   124\t\n   125\t        // 查询该家庭最近的日文档\n   126\t        const res = await db.collection('meal_history')\n   127\t          .where({ familyId })\n   128\t          .orderBy('date', 'desc')\n   129\t          .limit(limitDays)\n   130\t          .get();\n   131\t\n   132\t        const docs = res.data || [];\n   133\t        // 展平为有序餐次列表供客户端秒级合并\n   134\t        const allMeals = [];\n   135\t        for (const doc of docs) {\n   136\t          for (const m of (doc.meals || [])) {\n   137\t            allMeals.push({\n   138\t              id: m.mealId,\n   139\t              menuId: m.mealId,\n   140\t              mealId: m.mealId,\n   141\t              date: doc.date,\n   142\t              timestamp: m.timestamp,\n   143\t              mode: m.mode,\n   144\t              mealType: m.mealType,\n   145\t              dishIds: m.dishIds,\n   146\t              dishNames: m.dishNames,\n   147\t              dishes: m.dishes,\n   148\t              confirmedBy: m.confirmedBy,\n   149\t              confirmedByName: m.confirmedByName,\n   150\t              familyId: doc.familyId,\n   151\t              syncStatus: 'synced'\n   152\t            });\n   153\t          }\n   154\t        }\n   155\t\n   156\t        // 按时间戳倒序排列\n   157\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n   158\t\n   159\t        return {\n   160\t          success: true,\n   161\t          records: allMeals,\n   162\t          docs\n   163\t        };\n   164\t      }\n   165\t\n   166\t      default:\n   167\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   168\t    }\n   169\t  } catch (err) {\n   170\t    return {\n   171\t      success: false,\n   172\t      error: err.message || '历史记录同步失败'\n   173\t    };\n   174\t  }\n   175\t};\n     1\tconst cloud = require('wx-server-sdk');\n     2\t\n     3\tcloud.init({\n     4\t  env: cloud.DYNAMIC_CURRENT_ENV\n     5\t});\n     6\t\n     7\tconst db = cloud.database();\n     8\t\n     9\t// 预设分类生活美学图标与默认大图映射\n    10\tconst CATEGORY_DEFAULT_CONFIG = {\n    11\t  main_meat: { icon: '🥩', theme: 'theme_main_meat', thumb: '/assets/dishes/default_main.jpg' },\n    12\t  secondary_meat: { icon: '🥘', theme: 'theme_secondary_meat', thumb: '/assets/dishes/default_secondary.jpg' },\n    13\t  egg: { icon: '🍳', theme: 'theme_egg', thumb: '/assets/dishes/default_egg.jpg' },\n    14\t  tofu: { icon: '🧊', theme: 'theme_tofu', thumb: '/assets/dishes/default_tofu.jpg' },\n    15\t  vegetable: { icon: '🥬', theme: 'theme_vegetable', thumb: '/assets/dishes/default_vegetable.jpg' },\n    16\t  soup: { icon: '🍲', theme: 'theme_soup', thumb: '/assets/dishes/default_soup.jpg' },\n    17\t  staple_sauce: { icon: '🍚', theme: 'theme_staple_sauce', thumb: '/assets/dishes/default_dish.jpg' },\n    18\t  default: { icon: '🍽️', theme: 'theme_default', thumb: '/assets/dishes/default_dish.jpg' }\n    19\t};\n    20\t\n    21\t// 根据菜名特征智能匹配生动 Emoji\n    22\tfunction matchEmoji(name, category) {\n    23\t  if (!name) return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n    24\t  if (name.includes('土豆')) return '🥔';\n    25\t  if (name.includes('番茄') || name.includes('西红柿')) return '🍅';\n    26\t  if (name.includes('虾')) return '🦐';\n    27\t  if (name.includes('鱼')) return '🐟';\n    28\t  if (name.includes('鸡') || name.includes('鸭')) return '🍗';\n    29\t  if (name.includes('牛') || name.includes('羊') || name.includes('排骨') || name.includes('肉')) return '🥩';\n    30\t  if (name.includes('蛋')) return '🍳';\n    31\t  if (name.includes('豆腐')) return '🧊';\n    32\t  if (name.includes('蘑菇') || name.includes('菌') || name.includes('菇')) return '🍄';\n    33\t  if (name.includes('茄子')) return '🍆';\n    34\t  if (name.includes('玉米')) return '🌽';\n    35\t  if (name.includes('面') || name.includes('粉')) return '🍜';\n    36\t  if (name.includes('饭')) return '🍚';\n    37\t  if (name.includes('饺') || name.includes('抄手')) return '🥟';\n    38\t  if (name.includes('汤')) return '🍲';\n    39\t  if (name.includes('菜') || name.includes('笋') || name.includes('瓜')) return '🥬';\n    40\t  return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n    41\t}\n    42\t\n    43\texports.main = async (event, context) => {\n    44\t  const wxContext = cloud.getWXContext();\n    45\t  let openid = wxContext && wxContext.OPENID;\n    46\t\n    47\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n    48\t  if (!openid) {\n    49\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n    50\t      openid = event.mockOpenid || 'mock_openid_default';\n    51\t    } else {\n    52\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    53\t    }\n    54\t  }\n    55\t\n    56\t  const { action = 'addDish' } = event;\n    57\t  const now = Date.now();\n    58\t\n    59\t  try {\n    60\t    switch (action) {\n    61\t      /**\n    62\t       * 1. 录入纯文字私房菜 (强制文本安全检查，禁止图片上传)\n    63\t       */\n    64\t      case 'addDish': {\n    65\t        const name = String(event.name || '').trim();\n    66\t        if (!name) {\n    67\t          return { success: false, error: '菜品名称不能为空' };\n    68\t        }\n    69\t        if (name.length > 20) {\n    70\t          return { success: false, error: '菜品名称不能超过20个字' };\n    71\t        }\n    72\t\n    73\t        const category = event.category || 'secondary_meat';\n    74\t        const taste = Array.isArray(event.taste) ? event.taste : (event.taste ? [event.taste] : ['家常']);\n    75\t        const cookingTimeMinutes = Number(event.cookingTimeMinutes) || 25;\n    76\t        const ingredients = Array.isArray(event.ingredients) ? event.ingredients : [];\n    77\t\n    78\t        // 文本合规检验：结合菜名、口味与食材\n    79\t        const checkContent = `${name} ${taste.join(' ')} ${ingredients.join(' ')}`;\n    80\t\n    81\t        // 1. 本地/弱网兜底敏感词检测 (易错点 7 防线)\n    82\t        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n    83\t        if (sensitiveWords.some(w => name.includes(w) || checkContent.includes(w))) {\n    84\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n    85\t        }\n    86\t\n    87\t        // 2. 升级微信官方文本合规检测 msgSecCheck 2.0 规范\n    88\t        if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    89\t          try {\n    90\t            const secRes = await cloud.openapi.security.msgSecCheck({\n    91\t              version: 2,\n    92\t              scene: 1, // 资料类\n    93\t              openid,\n    94\t              content: checkContent\n    95\t            });\n    96\t            if (!secRes || !secRes.result || secRes.result.suggest !== 'pass') {\n    97\t              return { success: false, error: '菜品名称或描述包含敏感内容，请修改后重试' };\n    98\t            }\n    99\t          } catch (secErr) {\n   100\t            console.error('微信 msgSecCheck 检测异常:', secErr);\n   101\t            // 真实生产环境若检测接口异常也坚决拦截入库\n   102\t            return { success: false, error: '内容安全检测未通过或服务暂时不可用，请稍后重试' };\n   103\t          }\n   104\t        }\n   105\t\n   106\t        // 桶隔离：未加入家庭的私房菜使用 personal_${openid}，禁止所有单人用户共用 'personal' 桶\n   107\t        const rawFamilyId = event.familyId;\n   108\t        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n   109\t        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n   110\t\n   111\t        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n   112\t        if (!isPersonal) {\n   113\t          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n   114\t          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n   115\t            return { success: false, error: '越权操作：您不属于该家庭空间' };\n   116\t          }\n   117\t        }\n   118\t\n   119\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n   120\t        const cfg = CATEGORY_DEFAULT_CONFIG[category] || CATEGORY_DEFAULT_CONFIG.default;\n   121\t        const emoji = matchEmoji(name, category);\n   122\t\n   123\t        const newDish = {\n   124\t          _id: dishId,\n   125\t          id: dishId,\n   126\t          familyId,\n   127\t          creatorOpenid: openid,\n   128\t          creatorName: event.creatorName || event.nickName || '家人',\n   129\t          name,\n   130\t          category,\n   131\t          taste,\n   132\t          cookingTimeMinutes,\n   133\t          defaultIcon: emoji,\n   134\t          defaultTheme: cfg.theme,\n   135\t          thumbUrl: cfg.thumb,\n   136\t          ingredients, // 空食材保留空数组，严禁无中生有\n   137\t          enabled: true,\n   138\t          isCustom: true,\n   139\t          createdAt: now\n   140\t        };\n   141\t\n   142\t        await db.collection('custom_dishes').add({ data: newDish });\n   143\t\n   144\t        return {\n   145\t          success: true,\n   146\t          dish: newDish\n   147\t        };\n   148\t      }\n   149\t\n   150\t      /**\n   151\t       * 2. 查询家庭私房菜列表\n   152\t       */\n   153\t      case 'getDishes': {\n   154\t        const rawFamilyId = event.familyId;\n   155\t        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n   156\t        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n   157\t\n   158\t        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n   159\t        if (!isPersonal) {\n   160\t          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n   161\t          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n   162\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n   163\t          }\n   164\t        }\n   165\t\n   166\t        const res = await db.collection('custom_dishes')\n   167\t          .where({\n   168\t            familyId,\n   169\t            enabled: true\n   170\t          })\n   171\t          .orderBy('createdAt', 'desc')\n   172\t          .get();\n   173\t\n   174\t        return {\n   175\t          success: true,\n   176\t          dishes: res.data || []\n   177\t        };\n   178\t      }\n   179\t\n   180\t      default:\n   181\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   182\t    }\n   183\t  } catch (err) {\n   184\t    return {\n   185\t      success: false,\n   186\t      error: err.message || '自选私房菜操作失败'\n   187\t    };\n   188\t  }\n   189\t};\n     1\tconst cloud = require('wx-server-sdk');\n     2\t\n     3\tcloud.init({\n     4\t  env: cloud.DYNAMIC_CURRENT_ENV\n     5\t});\n     6\t\n     7\tconst db = cloud.database();\n     8\t\n     9\t/**\n    10\t * userAuth 云函数：用户静默鉴权与档案获取\n    11\t */\n    12\texports.main = async (event, context) => {\n    13\t  const wxContext = cloud.getWXContext();\n    14\t  let openid = wxContext && wxContext.OPENID;\n    15\t\n    16\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n    17\t  if (!openid) {\n    18\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n    19\t      openid = event.mockOpenid || 'mock_openid_default';\n    20\t    } else {\n    21\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    22\t    }\n    23\t  }\n    24\t\n    25\t  const now = Date.now();\n    26\t\n    27\t  try {\n    28\t    const userDocRef = db.collection('users').doc(`user_${openid}`);\n    29\t    let user = null;\n    30\t\n    31\t    try {\n    32\t      const res = await userDocRef.get();\n    33\t      user = res.data;\n    34\t    } catch (e) {\n    35\t      // 用户首次访问，自动创建档案\n    36\t      const newUser = {\n    37\t        _id: `user_${openid}`,\n    38\t        _openid: openid,\n    39\t        nickName: event.nickName || '家人',\n    40\t        avatarUrl: event.avatarUrl || '',\n    41\t        familyId: null,\n    42\t        role: null,\n    43\t        createdAt: now,\n    44\t        updatedAt: now\n    45\t      };\n    46\t      await db.collection('users').add({ data: newUser });\n    47\t      user = newUser;\n    48\t    }\n    49\t\n    50\t    // 更新昵称/头像\n    51\t    if (event.nickName || event.avatarUrl) {\n    52\t      const updateData = { updatedAt: now };\n    53\t      if (event.nickName) updateData.nickName = event.nickName;\n    54\t      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n    55\t      await userDocRef.update({ data: updateData });\n    56\t      user = { ...user, ...updateData };\n    57\t    }\n    58\t\n    59\t    // 若绑定了家庭，获取家庭最新信息\n    60\t    let family = null;\n    61\t    if (user.familyId) {\n    62\t      try {\n    63\t        const famRes = await db.collection('families').doc(user.familyId).get();\n    64\t        family = famRes.data;\n    65\t      } catch (err) {\n    66\t        console.warn('获取用户所属家庭失败或家庭已解散', err);\n    67\t        // 如果家庭已被解散，重置用户的 familyId\n    68\t        await userDocRef.update({\n    69\t          data: { familyId: null, role: null, updatedAt: now }\n    70\t        });\n    71\t        user.familyId = null;\n    72\t        user.role = null;\n    73\t      }\n    74\t    }\n    75\t\n    76\t    return {\n    77\t      success: true,\n    78\t      openid,\n    79\t      user,\n    80\t      family\n    81\t    };\n    82\t  } catch (err) {\n    83\t    return {\n    84\t      success: false,\n    85\t      error: err.message || '用户鉴权失败'\n    86\t    };\n    87\t  }\n    88\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba miniprogram/services/historyService.ts; nl -ba miniprogram/services/cloudService.ts; nl -ba miniprogram/services/familyService.ts'","aggregated_output":"     1\timport type { MealHistoryRecord, MealMode } from '../types/user.js';\n     2\timport type { Dish } from '../types/dish.js';\n     3\timport { familyService } from './familyService.js';\n     4\timport { cloudService } from './cloudService.js';\n     5\t\n     6\tconst STORAGE_KEY = 'meal_history_records';\n     7\tconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n     8\t\n     9\tinterface PendingSyncItem {\n    10\t  targetFamilyId: string;\n    11\t  authorOpenid: string;\n    12\t  record: MealHistoryRecord;\n    13\t}\n    14\t\n    15\ttype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n    16\t\n    17\tclass HistoryService {\n    18\t  private memoryHistory: MealHistoryRecord[] = [];\n    19\t  private pendingQueue: PendingSyncItem[] = [];\n    20\t  private listeners: Set<HistoryChangeListener> = new Set();\n    21\t  private isSyncing = false;\n    22\t  private syncPromise: Promise<void> | null = null;\n    23\t\n    24\t  constructor() {\n    25\t    this.restoreFromStorage();\n    26\t    this.initNetworkListener();\n    27\t  }\n    28\t\n    29\t  /**\n    30\t   * 监听网络状态变化：当连网时自动静默上报离线待同步队列\n    31\t   */\n    32\t  private initNetworkListener() {\n    33\t    if (typeof wx !== 'undefined' && typeof wx.onNetworkStatusChange === 'function') {\n    34\t      wx.onNetworkStatusChange((res: { isConnected: boolean; networkType: string }) => {\n    35\t        if (res && res.isConnected) {\n    36\t          console.log('[HistoryService] 网络连接已恢复，自动触发待同步离线队列上报...');\n    37\t          this.flushPendingQueue().catch(err => {\n    38\t            console.warn('[HistoryService] 连网自动上报待同步队列异常:', err);\n    39\t          });\n    40\t        }\n    41\t      });\n    42\t    }\n    43\t  }\n    44\t\n    45\t  private restoreFromStorage() {\n    46\t    try {\n    47\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    48\t        const stored = wx.getStorageSync(STORAGE_KEY);\n    49\t        if (stored && Array.isArray(stored)) {\n    50\t          this.memoryHistory = stored;\n    51\t        }\n    52\t        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n    53\t        if (queued && Array.isArray(queued)) {\n    54\t          this.pendingQueue = queued;\n    55\t        }\n    56\t      }\n    57\t    } catch (e) {\n    58\t      console.warn('读取本地历史失败，使用内存降级', e);\n    59\t    }\n    60\t  }\n    61\t\n    62\t  /**\n    63\t   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n    64\t   */\n    65\t  public subscribe(listener: HistoryChangeListener): () => void {\n    66\t    this.listeners.add(listener);\n    67\t    return () => this.listeners.delete(listener);\n    68\t  }\n    69\t\n    70\t  private notifyListeners(): void {\n    71\t    const list = this.getHistory();\n    72\t    for (const listener of this.listeners) {\n    73\t      try {\n    74\t        listener(list);\n    75\t      } catch (err) {\n    76\t        console.error('历史状态订阅回调异常', err);\n    77\t      }\n    78\t    }\n    79\t  }\n    80\t\n    81\t  /**\n    82\t   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n    83\t   */\n    84\t  public getHistory(): MealHistoryRecord[] {\n    85\t    try {\n    86\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    87\t        const stored = wx.getStorageSync(STORAGE_KEY);\n    88\t        if (stored && Array.isArray(stored)) {\n    89\t          return stored;\n    90\t        }\n    91\t      }\n    92\t    } catch (e) {\n    93\t      console.warn('读取本地历史失败，使用内存降级', e);\n    94\t    }\n    95\t    return this.memoryHistory;\n    96\t  }\n    97\t\n    98\t  /**\n    99\t   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n   100\t   */\n   101\t  public deduceMealType(dateObj = new Date()): string {\n   102\t    const hour = dateObj.getHours();\n   103\t    if (hour >= 5 && hour < 10) return '早餐';\n   104\t    if (hour >= 10 && hour < 15) return '午餐';\n   105\t    if (hour >= 15 && hour < 21) return '晚餐';\n   106\t    return '加餐';\n   107\t  }\n   108\t\n   109\t  /**\n   110\t   * 确认开饭：将菜单正式写入就餐历史\n   111\t   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n   112\t   */\n   113\t  public recordMeal(\n   114\t    mode: MealMode,\n   115\t    dishes: Dish[],\n   116\t    dateStr?: string,\n   117\t    menuId?: string,\n   118\t    mealType?: string\n   119\t  ): MealHistoryRecord {\n   120\t    const history = this.getHistory();\n   121\t    const now = new Date();\n   122\t    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n   123\t    const targetDate = dateStr || localDate;\n   124\t    const resolvedMealType = mealType || this.deduceMealType(now);\n   125\t    const randSuffix = Math.random().toString(36).slice(2, 6);\n   126\t    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n   127\t\n   128\t    const currentUser = familyService.getCurrentUser();\n   129\t    const currentFamily = familyService.getCurrentFamily();\n   130\t    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n   131\t\n   132\t    const newRecord: MealHistoryRecord = {\n   133\t      id: mealId,\n   134\t      menuId,\n   135\t      mealId,\n   136\t      date: targetDate,\n   137\t      timestamp: now.getTime(),\n   138\t      mode,\n   139\t      mealType: resolvedMealType,\n   140\t      dishIds: dishes.map(d => d.id),\n   141\t      dishNames: dishes.map(d => d.name),\n   142\t      dishes: dishes.map(d => ({\n   143\t        id: d.id,\n   144\t        name: d.name,\n   145\t        category: d.category,\n   146\t        thumbUrl: d.thumbUrl,\n   147\t        dishEmoji: d.dishEmoji,\n   148\t        isCustom: (d as any).isCustom\n   149\t      })),\n   150\t      confirmedBy: currentUser.openid,\n   151\t      confirmedByName: currentUser.nickName || '家人',\n   152\t      familyId,\n   153\t      syncStatus: familyId ? 'pending' : 'synced'\n   154\t    };\n   155\t\n   156\t    // 智能去重判断：\n   157\t    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n   158\t    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n   159\t    const existingIndex = history.findIndex(r =>\n   160\t      r.id === mealId ||\n   161\t      (Boolean(menuId) && r.menuId === menuId) ||\n   162\t      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n   163\t    );\n   164\t\n   165\t    let updated: MealHistoryRecord[];\n   166\t    if (existingIndex >= 0) {\n   167\t      updated = [...history];\n   168\t      updated[existingIndex] = newRecord;\n   169\t    } else {\n   170\t      updated = [newRecord, ...history].slice(0, 60);\n   171\t    }\n   172\t\n   173\t    this.saveHistory(updated);\n   174\t\n   175\t    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n   176\t    if (familyId) {\n   177\t      this.enqueuePendingSync({\n   178\t        targetFamilyId: familyId,\n   179\t        authorOpenid: currentUser.openid,\n   180\t        record: newRecord\n   181\t      });\n   182\t      // 触发后台静默同步\n   183\t      this.flushPendingQueue().catch(() => {});\n   184\t    }\n   185\t\n   186\t    return newRecord;\n   187\t  }\n   188\t\n   189\t  /**\n   190\t   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n   191\t   */\n   192\t  private enqueuePendingSync(item: PendingSyncItem) {\n   193\t    this.pendingQueue.push(item);\n   194\t    this.savePendingQueue();\n   195\t  }\n   196\t\n   197\t  private savePendingQueue() {\n   198\t    try {\n   199\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n   200\t        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n   201\t      }\n   202\t    } catch (e) {}\n   203\t  }\n   204\t\n   205\t  /**\n   206\t   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n   207\t   */\n   208\t  public async flushPendingQueue(): Promise<void> {\n   209\t    if (this.syncPromise) {\n   210\t      return this.syncPromise;\n   211\t    }\n   212\t    if (this.pendingQueue.length === 0) return;\n   213\t    this.isSyncing = true;\n   214\t\n   215\t    this.syncPromise = (async () => {\n   216\t      try {\n   217\t        while (this.pendingQueue.length > 0) {\n   218\t          const item = this.pendingQueue[0];\n   219\t          const currentFamily = familyService.getCurrentFamily();\n   220\t          const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n   221\t\n   222\t          // 关键防御：如果当前明确处于另一不同家庭，判定为跨家庭废弃记录，安全出队丢弃，绝不上报！\n   223\t          if (currentFamilyId && currentFamilyId !== item.targetFamilyId) {\n   224\t            console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n   225\t            this.pendingQueue.shift();\n   226\t            this.savePendingQueue();\n   227\t            continue;\n   228\t          }\n   229\t\n   230\t          // 若当前家庭信息尚未加载就绪，暂缓上报，保留在队列中等待家庭就绪\n   231\t          if (!currentFamilyId) {\n   232\t            break;\n   233\t          }\n   234\t\n   235\t          const res = await cloudService.callFunction('upsertMeal', {\n   236\t            action: 'upsertMeal',\n   237\t            familyId: item.targetFamilyId,\n   238\t            date: item.record.date,\n   239\t            mockOpenid: item.authorOpenid,\n   240\t            meal: {\n   241\t              mealId: item.record.mealId || item.record.id,\n   242\t              mealType: item.record.mealType,\n   243\t              mode: item.record.mode,\n   244\t              dishes: item.record.dishes,\n   245\t              dishIds: item.record.dishIds,\n   246\t              dishNames: item.record.dishNames,\n   247\t              confirmedByName: item.record.confirmedByName,\n   248\t              timestamp: item.record.timestamp\n   249\t            }\n   250\t          });\n   251\t\n   252\t          if (res.success) {\n   253\t            // 标记本地记录为已同步并从队列出队\n   254\t            this.pendingQueue.shift();\n   255\t            this.savePendingQueue();\n   256\t\n   257\t            const history = this.getHistory();\n   258\t            const target = history.find(r =>\n   259\t              r.id === item.record.id ||\n   260\t              (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n   261\t              (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n   262\t            );\n   263\t            if (target) {\n   264\t              target.syncStatus = 'synced';\n   265\t              this.saveHistory([...history]);\n   266\t              this.notifyListeners();\n   267\t            }\n   268\t          } else {\n   269\t            const errorMsg = res.error || '';\n   270\t            const lower = errorMsg.toLowerCase();\n   271\t            const isTransientNetwork =\n   272\t              lower.includes('request:fail') ||\n   273\t              lower.includes('timeout') ||\n   274\t              lower.includes('offline') ||\n   275\t              lower.includes('network') ||\n   276\t              lower.includes('fail connect') ||\n   277\t              lower.includes('socket closed') ||\n   278\t              lower.includes('econnaborted') ||\n   279\t              lower.includes('econnreset') ||\n   280\t              lower.includes('etimedout');\n   281\t\n   282\t            const isExplicitRejection =\n   283\t              lower.includes('越权') ||\n   284\t              lower.includes('不属于') ||\n   285\t              lower.includes('无权') ||\n   286\t              lower.includes('权限') ||\n   287\t              lower.includes('缺少') ||\n   288\t              lower.includes('参数') ||\n   289\t              lower.includes('非法') ||\n   290\t              lower.includes('openid') ||\n   291\t              lower.includes('身份凭据') ||\n   292\t              lower.includes('不支持') ||\n   293\t              lower.includes('敏感') ||\n   294\t              lower.includes('违规') ||\n   295\t              lower.includes('合规') ||\n   296\t              lower.includes('家庭不存在') ||\n   297\t              lower.includes('不存在') ||\n   298\t              lower.includes('未找到') ||\n   299\t              lower.includes('已满') ||\n   300\t              lower.includes('上限') ||\n   301\t              lower.includes('锁定') ||\n   302\t              lower.includes('防刷') ||\n   303\t              lower.includes('防暴力枚举') ||\n   304\t              lower.includes('已失效') ||\n   305\t              lower.includes('过期') ||\n   306\t              lower.includes('cannot update _id') ||\n   307\t              lower.includes('errcode');\n   308\t\n   309\t            if (!isTransientNetwork && isExplicitRejection) {\n   310\t              // 服务端业务明确拒绝错误（越权、参数非法等）：直接出队并标记为 failed，避免死循环重试\n   311\t              console.warn(`[HistoryService] 离线同步记录 ${item.record.id} 遭服务端明确拒绝，已出队并标记为 failed: ${errorMsg}`);\n   312\t              this.pendingQueue.shift();\n   313\t              this.savePendingQueue();\n   314\t\n   315\t              const history = this.getHistory();\n   316\t              const target = history.find(r =>\n   317\t                r.id === item.record.id ||\n   318\t                (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n   319\t                (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n   320\t              );\n   321\t              if (target) {\n   322\t                target.syncStatus = 'failed';\n   323\t                this.saveHistory([...history]);\n   324\t                this.notifyListeners();\n   325\t              }\n   326\t            } else {\n   327\t              // 提交失败（网络或瞬时异常），保留在队列头部中断当前轮次等待下次重试\n   328\t              break;\n   329\t            }\n   330\t          }\n   331\t        }\n   332\t      } finally {\n   333\t        this.isSyncing = false;\n   334\t        this.syncPromise = null;\n   335\t      }\n   336\t    })();\n   337\t\n   338\t    return this.syncPromise;\n   339\t  }\n   340\t\n   341\t  /**\n   342\t   * SWR 增量拉取家庭共享历史并合并到本地\n   343\t   */\n   344\t  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n   345\t    const currentFamily = familyService.getCurrentFamily();\n   346\t    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n   347\t    if (!familyId) {\n   348\t      return this.getHistory();\n   349\t    }\n   350\t\n   351\t    // 先刷新离线待上报队列\n   352\t    await this.flushPendingQueue();\n   353\t\n   354\t    const currentUser = familyService.getCurrentUser();\n   355\t    const res = await cloudService.callFunction('upsertMeal', {\n   356\t      action: 'getHistory',\n   357\t      familyId,\n   358\t      mockOpenid: currentUser.openid,\n   359\t      limitDays: 60\n   360\t    });\n   361\t\n   362\t    if (res.success && Array.isArray(res.records)) {\n   363\t      const cloudRecords: MealHistoryRecord[] = res.records;\n   364\t      const localRecords = this.getHistory();\n   365\t\n   366\t      // 双向合并：以餐次 mealId 为唯一标识\n   367\t      const recordMap = new Map<string, MealHistoryRecord>();\n   368\t\n   369\t      // 先放入云端记录\n   370\t      for (const cr of cloudRecords) {\n   371\t        const key = cr.mealId || cr.id;\n   372\t        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n   373\t      }\n   374\t\n   375\t      // 再放入本地未同步或更新的属于当前家庭的记录\n   376\t      for (const lr of localRecords) {\n   377\t        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n   378\t        if (lr.familyId && lr.familyId !== familyId) {\n   379\t          continue;\n   380\t        }\n   381\t        const key = lr.mealId || lr.id;\n   382\t        if (!recordMap.has(key)) {\n   383\t          recordMap.set(key, lr);\n   384\t        } else {\n   385\t          // 如果本地是 pending，优先以本地为准\n   386\t          if (lr.syncStatus === 'pending') {\n   387\t            recordMap.set(key, lr);\n   388\t          }\n   389\t        }\n   390\t      }\n   391\t\n   392\t      const merged = Array.from(recordMap.values());\n   393\t      merged.sort((a, b) => b.timestamp - a.timestamp);\n   394\t      const finalRecords = merged.slice(0, 60);\n   395\t\n   396\t      this.saveHistory(finalRecords);\n   397\t      this.notifyListeners();\n   398\t      return finalRecords;\n   399\t    }\n   400\t\n   401\t    return this.getHistory();\n   402\t  }\n   403\t\n   404\t  /**\n   405\t   * 清空或重置历史 (用于测试或用户重置)\n   406\t   */\n   407\t  public clearHistory(): void {\n   408\t    this.pendingQueue = [];\n   409\t    this.savePendingQueue();\n   410\t    this.saveHistory([]);\n   411\t    this.notifyListeners();\n   412\t  }\n   413\t\n   414\t  private saveHistory(records: MealHistoryRecord[]): void {\n   415\t    this.memoryHistory = records;\n   416\t    try {\n   417\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n   418\t        wx.setStorageSync(STORAGE_KEY, records);\n   419\t      }\n   420\t    } catch (e) {\n   421\t      console.warn('保存本地历史失败', e);\n   422\t    }\n   423\t  }\n   424\t}\n   425\t\n   426\texport const historyService = new HistoryService();\n     1\t/**\n     2\t * 微信云开发服务网关 (CloudService)\n     3\t * 职责：\n     4\t * 1. 统一封装 wx.cloud.callFunction 调用\n     5\t * 2. 真实小程序环境下云函数报错严禁降级返回 Mock 假成功，一律返回失败交由离线队列重试\n     6\t * 3. 在无微信环境（Node.js 单测）或强制模拟模式下，提供高保真本地 Mock 状态机仿真\n     7\t * 4. 严格保障 4 人上限、24小时邀请码、一人一家庭排他与同日多餐写入\n     8\t */\n     9\t\n    10\timport type { FamilySpace, UserProfile, SingleMealItem, CustomDishRecord } from '../types/family.js';\n    11\t\n    12\tinterface CloudResponse<T = any> {\n    13\t  success: boolean;\n    14\t  result?: T;\n    15\t  error?: string;\n    16\t  [key: string]: any;\n    17\t}\n    18\t\n    19\tclass LocalCloudMockDatabase {\n    20\t  private users = new Map<string, any>();\n    21\t  private families = new Map<string, any>();\n    22\t  private mealHistory = new Map<string, any>(); // key: meal_${familyId}_${date}\n    23\t  private customDishes = new Map<string, any[]>(); // key: familyId -> dish[]\n    24\t  private sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n    25\t\n    26\t  constructor() {\n    27\t    this.restoreFromStorage();\n    28\t  }\n    29\t\n    30\t  private hasSensitiveContent(text: string): boolean {\n    31\t    if (!text) return false;\n    32\t    const str = String(text);\n    33\t    return this.sensitiveWords.some(w => str.includes(w));\n    34\t  }\n    35\t\n    36\t  private generateUniqueInviteCode(): string {\n    37\t    const now = Date.now();\n    38\t    for (let attempt = 0; attempt < 10; attempt++) {\n    39\t      const code = String(Math.floor(100000 + Math.random() * 900000));\n    40\t      let isDuplicate = false;\n    41\t      for (const fam of this.families.values()) {\n    42\t        if (fam.inviteCode === code && fam.inviteExpiredAt > now) {\n    43\t          isDuplicate = true;\n    44\t          break;\n    45\t        }\n    46\t      }\n    47\t      if (!isDuplicate) return code;\n    48\t    }\n    49\t    return String(Math.floor(100000 + Math.random() * 900000));\n    50\t  }\n    51\t\n    52\t  private getOpenid(data: any): string {\n    53\t    if (data?.mockOpenid) return data.mockOpenid;\n    54\t    try {\n    55\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    56\t        const user = wx.getStorageSync('current_user_profile');\n    57\t        if (user && user.openid) return user.openid;\n    58\t      }\n    59\t    } catch (e) {}\n    60\t    return 'mock_openid_default';\n    61\t  }\n    62\t\n    63\t  private restoreFromStorage() {\n    64\t    try {\n    65\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    66\t        const storedUsers = wx.getStorageSync('mock_db_users');\n    67\t        if (storedUsers) this.users = new Map(Object.entries(storedUsers));\n    68\t\n    69\t        const storedFamilies = wx.getStorageSync('mock_db_families');\n    70\t        if (storedFamilies) this.families = new Map(Object.entries(storedFamilies));\n    71\t\n    72\t        const storedHistory = wx.getStorageSync('mock_db_history');\n    73\t        if (storedHistory) this.mealHistory = new Map(Object.entries(storedHistory));\n    74\t\n    75\t        const storedDishes = wx.getStorageSync('mock_db_custom_dishes');\n    76\t        if (storedDishes) this.customDishes = new Map(Object.entries(storedDishes));\n    77\t      }\n    78\t    } catch (e) {}\n    79\t  }\n    80\t\n    81\t  private persist() {\n    82\t    try {\n    83\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n    84\t        wx.setStorageSync('mock_db_users', Object.fromEntries(this.users));\n    85\t        wx.setStorageSync('mock_db_families', Object.fromEntries(this.families));\n    86\t        wx.setStorageSync('mock_db_history', Object.fromEntries(this.mealHistory));\n    87\t        wx.setStorageSync('mock_db_custom_dishes', Object.fromEntries(this.customDishes));\n    88\t      }\n    89\t    } catch (e) {}\n    90\t  }\n    91\t\n    92\t  public clearAll() {\n    93\t    this.users.clear();\n    94\t    this.families.clear();\n    95\t    this.mealHistory.clear();\n    96\t    this.customDishes.clear();\n    97\t    this.persist();\n    98\t  }\n    99\t\n   100\t  public handleUserAuth(data: any): any {\n   101\t    const openid = this.getOpenid(data);\n   102\t    const now = Date.now();\n   103\t    let user = this.users.get(`user_${openid}`);\n   104\t\n   105\t    if (!user) {\n   106\t      user = {\n   107\t        _id: `user_${openid}`,\n   108\t        _openid: openid,\n   109\t        nickName: data?.nickName || '家人',\n   110\t        avatarUrl: data?.avatarUrl || '',\n   111\t        familyId: null,\n   112\t        role: null,\n   113\t        createdAt: now,\n   114\t        updatedAt: now\n   115\t      };\n   116\t      this.users.set(`user_${openid}`, user);\n   117\t    } else {\n   118\t      if (data?.nickName) user.nickName = data.nickName;\n   119\t      if (data?.avatarUrl) user.avatarUrl = data.avatarUrl;\n   120\t      user.updatedAt = now;\n   121\t    }\n   122\t\n   123\t    let family = null;\n   124\t    if (user.familyId) {\n   125\t      family = this.families.get(user.familyId) || null;\n   126\t      if (!family) {\n   127\t        user.familyId = null;\n   128\t        user.role = null;\n   129\t      }\n   130\t    }\n   131\t\n   132\t    this.persist();\n   133\t    return { success: true, openid, user, family };\n   134\t  }\n   135\t\n   136\t  public handleFamilyManage(data: any): any {\n   137\t    const { action } = data;\n   138\t    const openid = this.getOpenid(data);\n   139\t    const now = Date.now();\n   140\t\n   141\t    switch (action) {\n   142\t      case 'createFamily': {\n   143\t        const familyName = (data.name || '温馨小家食堂').trim().slice(0, 15);\n   144\t        const nickName = data.nickName || '房主';\n   145\t\n   146\t        // 文本合规检验\n   147\t        if (this.hasSensitiveContent(familyName) || this.hasSensitiveContent(nickName)) {\n   148\t          return { success: false, error: '家庭名称或昵称包含敏感词，请修改后重试' };\n   149\t        }\n   150\t\n   151\t        let user = this.users.get(`user_${openid}`) || {\n   152\t          _id: `user_${openid}`,\n   153\t          _openid: openid,\n   154\t          nickName,\n   155\t          familyId: null\n   156\t        };\n   157\t\n   158\t        // 如果用户在旧家庭中，先退出\n   159\t        if (user.familyId && this.families.has(user.familyId)) {\n   160\t          this.leaveFamilyInternal(openid, user.familyId);\n   161\t        }\n   162\t\n   163\t        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n   164\t        const inviteCode = this.generateUniqueInviteCode();\n   165\t        const inviteExpiredAt = now + 24 * 60 * 60 * 1000;\n   166\t\n   167\t        const newFamily: FamilySpace = {\n   168\t          id: familyId,\n   169\t          name: familyName,\n   170\t          creatorOpenid: openid,\n   171\t          members: [\n   172\t            {\n   173\t              openid,\n   174\t              nickName: nickName || user.nickName || '房主',\n   175\t              avatarUrl: data.avatarUrl || user.avatarUrl || '',\n   176\t              role: 'creator',\n   177\t              joinedAt: now\n   178\t            }\n   179\t          ],\n   180\t          memberOpenids: [openid],\n   181\t          inviteCode,\n   182\t          inviteExpiredAt,\n   183\t          createdAt: now,\n   184\t          updatedAt: now\n   185\t        };\n   186\t\n   187\t        this.families.set(familyId, newFamily);\n   188\t        user.familyId = familyId;\n   189\t        user.role = 'creator';\n   190\t        user.updatedAt = now;\n   191\t        this.users.set(`user_${openid}`, user);\n   192\t\n   193\t        this.persist();\n   194\t        return { success: true, family: newFamily };\n   195\t      }\n   196\t\n   197\t      case 'joinFamily': {\n   198\t        const WINDOW_MS = 15 * 60 * 1000;\n   199\t        const MAX_FAILURES = 5;\n   200\t        let user = this.users.get(`user_${openid}`) || {\n   201\t          _id: `user_${openid}`,\n   202\t          _openid: openid,\n   203\t          nickName: data.nickName || '家人',\n   204\t          familyId: null,\n   205\t          joinFailCount: 0,\n   206\t          joinFailLastTime: 0\n   207\t        };\n   208\t\n   209\t        if ((user.joinFailCount || 0) >= MAX_FAILURES && (now - (user.joinFailLastTime || 0)) <= WINDOW_MS) {\n   210\t          const remainingMinutes = Math.max(1, Math.ceil((WINDOW_MS - (now - (user.joinFailLastTime || 0))) / 60000));\n   211\t          return {\n   212\t            success: false,\n   213\t            error: `口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n   214\t          };\n   215\t        }\n   216\t\n   217\t        const recordMockFailure = () => {\n   218\t          const isExpired = (now - (user.joinFailLastTime || 0)) > WINDOW_MS;\n   219\t          user.joinFailCount = isExpired ? 1 : ((user.joinFailCount || 0) + 1);\n   220\t          user.joinFailLastTime = now;\n   221\t          this.users.set(`user_${openid}`, user);\n   222\t          this.persist();\n   223\t        };\n   224\t\n   225\t        const inviteCode = String(data.inviteCode || '').trim();\n   226\t        if (!inviteCode || inviteCode.length !== 6) {\n   227\t          recordMockFailure();\n   228\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n   229\t        }\n   230\t\n   231\t        const nickName = data.nickName || '家人';\n   232\t        if (this.hasSensitiveContent(nickName)) {\n   233\t          return { success: false, error: '成员昵称包含敏感词，请修改后重试' };\n   234\t        }\n   235\t\n   236\t        let targetFamily: FamilySpace | null = null;\n   237\t        for (const fam of this.families.values()) {\n   238\t          if (fam.inviteCode === inviteCode) {\n   239\t            targetFamily = fam;\n   240\t            break;\n   241\t          }\n   242\t        }\n   243\t\n   244\t        if (!targetFamily) {\n   245\t          recordMockFailure();\n   246\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n   247\t        }\n   248\t\n   249\t        if (now > targetFamily.inviteExpiredAt) {\n   250\t          recordMockFailure();\n   251\t          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n   252\t        }\n   253\t\n   254\t        if (targetFamily.memberOpenids.includes(openid)) {\n   255\t          return { success: true, family: targetFamily, message: '您已经在该家庭厨房中' };\n   256\t        }\n   257\t\n   258\t        // 严格 4 人限制 (易错点 2 防御)\n   259\t        if (targetFamily.memberOpenids.length >= 4) {\n   260\t          return { success: false, error: '该家庭厨房成员已满（上限4人），无法继续加入' };\n   261\t        }\n   262\t\n   263\t        // 一人一家庭排他 (易错点 3 防御)\n   264\t        if (user.familyId && user.familyId !== targetFamily.id && this.families.has(user.familyId)) {\n   265\t          this.leaveFamilyInternal(openid, user.familyId);\n   266\t        }\n   267\t\n   268\t        const newMember = {\n   269\t          openid,\n   270\t          nickName: nickName || user.nickName || '家人',\n   271\t          avatarUrl: data.avatarUrl || user.avatarUrl || '',\n   272\t          role: 'member' as const,\n   273\t          joinedAt: now\n   274\t        };\n   275\t\n   276\t        targetFamily.members.push(newMember);\n   277\t        targetFamily.memberOpenids.push(openid);\n   278\t        targetFamily.updatedAt = now;\n   279\t\n   280\t        user.familyId = targetFamily.id;\n   281\t        user.role = 'member';\n   282\t        user.joinFailCount = 0;\n   283\t        user.joinFailLastTime = 0;\n   284\t        user.updatedAt = now;\n   285\t        this.users.set(`user_${openid}`, user);\n   286\t\n   287\t        this.persist();\n   288\t        return { success: true, family: targetFamily };\n   289\t      }\n   290\t\n   291\t      case 'leaveFamily': {\n   292\t        let user = this.users.get(`user_${openid}`);\n   293\t        if (!user || !user.familyId) {\n   294\t          return { success: true, message: '当前未加入任何家庭' };\n   295\t        }\n   296\t        this.leaveFamilyInternal(openid, user.familyId);\n   297\t        user.familyId = null;\n   298\t        user.role = null;\n   299\t        user.updatedAt = now;\n   300\t        this.users.set(`user_${openid}`, user);\n   301\t        this.persist();\n   302\t        return { success: true, message: '已退出家庭厨房空间' };\n   303\t      }\n   304\t\n   305\t      case 'refreshInviteCode': {\n   306\t        const { familyId } = data;\n   307\t        const family = this.families.get(familyId);\n   308\t        if (!family) return { success: false, error: '家庭不存在' };\n   309\t\n   310\t        if (!family.memberOpenids.includes(openid)) {\n   311\t          return { success: false, error: '无权操作非本人所属家庭' };\n   312\t        }\n   313\t\n   314\t        const newCode = this.generateUniqueInviteCode();\n   315\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n   316\t        family.inviteCode = newCode;\n   317\t        family.inviteExpiredAt = newExpiry;\n   318\t        family.updatedAt = now;\n   319\t\n   320\t        this.persist();\n   321\t        return { success: true, inviteCode: newCode, inviteExpiredAt: newExpiry };\n   322\t      }\n   323\t\n   324\t      case 'getFamily': {\n   325\t        const { familyId } = data;\n   326\t        const family = this.families.get(familyId);\n   327\t        if (!family) return { success: false, error: '家庭不存在' };\n   328\t\n   329\t        // 敏感信息保护：非家庭成员不泄露敏感的邀请码与成员详情\n   330\t        if (data.mockOpenid && (!family.memberOpenids || !family.memberOpenids.includes(data.mockOpenid))) {\n   331\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n   332\t        }\n   333\t\n   334\t        return { success: true, family };\n   335\t      }\n   336\t\n   337\t      default:\n   338\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   339\t    }\n   340\t  }\n   341\t\n   342\t  private leaveFamilyInternal(openid: string, familyId: string) {\n   343\t    const family = this.families.get(familyId);\n   344\t    if (!family) return;\n   345\t    family.members = family.members.filter(m => m.openid !== openid);\n   346\t    family.memberOpenids = family.memberOpenids.filter(id => id !== openid);\n   347\t    if (family.members.length === 0) {\n   348\t      this.families.delete(familyId);\n   349\t    } else {\n   350\t      if (family.creatorOpenid === openid) {\n   351\t        family.creatorOpenid = family.members[0].openid;\n   352\t        family.members[0].role = 'creator';\n   353\t      }\n   354\t      family.updatedAt = Date.now();\n   355\t    }\n   356\t  }\n   357\t\n   358\t  public handleUpsertMeal(data: any): any {\n   359\t    const { action = 'upsertMeal' } = data;\n   360\t    const openid = this.getOpenid(data);\n   361\t    const now = Date.now();\n   362\t\n   363\t    switch (action) {\n   364\t      case 'upsertMeal': {\n   365\t        const { familyId, date, meal } = data;\n   366\t        if (!familyId || !date || !meal) {\n   367\t          return { success: false, error: '缺少参数 familyId/date/meal' };\n   368\t        }\n   369\t\n   370\t        // 服务端鉴权：确认该用户确实属于该家庭\n   371\t        const family = this.families.get(familyId);\n   372\t        if (family && !family.memberOpenids.includes(openid)) {\n   373\t          return { success: false, error: '越权操作：您不属于该家庭空间' };\n   374\t        }\n   375\t\n   376\t        const docKey = `meal_${familyId}_${date}`;\n   377\t        let doc = this.mealHistory.get(docKey);\n   378\t\n   379\t        const verifiedMember = (family?.members || []).find((m: any) => m.openid === openid);\n   380\t        const verifiedNickName = (verifiedMember && verifiedMember.nickName && verifiedMember.nickName.trim())\n   381\t          ? verifiedMember.nickName.trim()\n   382\t          : (meal.confirmedByName || data.nickName || '家人');\n   383\t\n   384\t        const mealSnapshot: SingleMealItem = {\n   385\t          mealId: meal.mealId || `m_${now}`,\n   386\t          mealType: meal.mealType || '午餐',\n   387\t          mode: meal.mode || 'hearty_3_1',\n   388\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n   389\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n   390\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n   391\t          confirmedBy: openid,\n   392\t          confirmedByName: verifiedNickName,\n   393\t          timestamp: meal.timestamp || now\n   394\t        };\n   395\t\n   396\t        if (!doc) {\n   397\t          doc = {\n   398\t            _id: docKey,\n   399\t            familyId,\n   400\t            date,\n   401\t            meals: [mealSnapshot],\n   402\t            updatedAt: now\n   403\t          };\n   404\t        } else {\n   405\t          const meals = doc.meals || [];\n   406\t          const idx = meals.findIndex((m: any) => m.mealId === mealSnapshot.mealId);\n   407\t          if (idx >= 0) {\n   408\t            meals[idx] = mealSnapshot;\n   409\t          } else {\n   410\t            meals.push(mealSnapshot);\n   411\t          }\n   412\t          doc.meals = meals;\n   413\t          doc.updatedAt = now;\n   414\t        }\n   415\t\n   416\t        this.mealHistory.set(docKey, doc);\n   417\t        this.persist();\n   418\t        return { success: true, docId: docKey, meal: mealSnapshot };\n   419\t      }\n   420\t\n   421\t      case 'getHistory': {\n   422\t        const { familyId, limitDays = 60 } = data;\n   423\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n   424\t\n   425\t        // 鉴权检查：如果传入了 mockOpenid 或有当前身份，校验是否在家庭中\n   426\t        if (data.mockOpenid) {\n   427\t          const family = this.families.get(familyId);\n   428\t          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n   429\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n   430\t          }\n   431\t        }\n   432\t\n   433\t        const allMeals: any[] = [];\n   434\t        for (const [key, doc] of this.mealHistory.entries()) {\n   435\t          if (doc.familyId === familyId) {\n   436\t            for (const m of (doc.meals || [])) {\n   437\t              allMeals.push({\n   438\t                id: m.mealId,\n   439\t                menuId: m.mealId,\n   440\t                mealId: m.mealId,\n   441\t                date: doc.date,\n   442\t                timestamp: m.timestamp,\n   443\t                mode: m.mode,\n   444\t                mealType: m.mealType,\n   445\t                dishIds: m.dishIds,\n   446\t                dishNames: m.dishNames,\n   447\t                dishes: m.dishes,\n   448\t                confirmedBy: m.confirmedBy,\n   449\t                confirmedByName: m.confirmedByName,\n   450\t                familyId: doc.familyId,\n   451\t                syncStatus: 'synced'\n   452\t              });\n   453\t            }\n   454\t          }\n   455\t        }\n   456\t\n   457\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n   458\t        return { success: true, records: allMeals.slice(0, limitDays * 3) };\n   459\t      }\n   460\t\n   461\t      default:\n   462\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   463\t    }\n   464\t  }\n   465\t\n   466\t  public handleCustomDish(data: any): any {\n   467\t    const { action = 'addDish' } = data;\n   468\t    const openid = this.getOpenid(data);\n   469\t    const now = Date.now();\n   470\t\n   471\t    switch (action) {\n   472\t      case 'addDish': {\n   473\t        const name = String(data.name || '').trim();\n   474\t        if (!name) return { success: false, error: '菜品名称不能为空' };\n   475\t        if (name.length > 20) return { success: false, error: '菜品名称不能超过20个字' };\n   476\t\n   477\t        // 敏感词检测 (易错点 7 防御)\n   478\t        const checkText = `${name} ${(data.taste || []).join(' ')} ${(data.ingredients || []).join(' ')}`;\n   479\t        if (this.hasSensitiveContent(name) || this.hasSensitiveContent(checkText)) {\n   480\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n   481\t        }\n   482\t\n   483\t        // 隔离桶：未加入家庭的私房菜使用 personal_${openid}，严禁所有单人用户共用 'personal' 桶\n   484\t        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n   485\t        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n   486\t\n   487\t        // 服务端家庭鉴权\n   488\t        if (!isPersonal) {\n   489\t          const family = this.families.get(familyId);\n   490\t          if (family && !family.memberOpenids.includes(openid)) {\n   491\t            return { success: false, error: '越权操作：您不属于该家庭空间' };\n   492\t          }\n   493\t        }\n   494\t\n   495\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n   496\t        const category = data.category || 'secondary_meat';\n   497\t\n   498\t        const newDish = {\n   499\t          _id: dishId,\n   500\t          id: dishId,\n   501\t          familyId,\n   502\t          creatorOpenid: openid,\n   503\t          creatorName: data.creatorName || data.nickName || '家人',\n   504\t          name,\n   505\t          category,\n   506\t          taste: Array.isArray(data.taste) ? data.taste : ['家常'],\n   507\t          cookingTimeMinutes: Number(data.cookingTimeMinutes) || 25,\n   508\t          ingredients: Array.isArray(data.ingredients) ? data.ingredients : [],\n   509\t          enabled: true,\n   510\t          isCustom: true,\n   511\t          createdAt: now\n   512\t        };\n   513\t\n   514\t        const list = this.customDishes.get(familyId) || [];\n   515\t        list.unshift(newDish);\n   516\t        this.customDishes.set(familyId, list);\n   517\t        this.persist();\n   518\t\n   519\t        return { success: true, dish: newDish };\n   520\t      }\n   521\t\n   522\t      case 'getDishes': {\n   523\t        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n   524\t        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n   525\t\n   526\t        // 服务端家庭鉴权\n   527\t        if (!isPersonal && data.mockOpenid) {\n   528\t          const family = this.families.get(familyId);\n   529\t          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n   530\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n   531\t          }\n   532\t        }\n   533\t\n   534\t        const list = this.customDishes.get(familyId) || [];\n   535\t        return { success: true, dishes: list };\n   536\t      }\n   537\t\n   538\t      default:\n   539\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   540\t    }\n   541\t  }\n   542\t}\n   543\t\n   544\texport class CloudService {\n   545\t  private mockDb = new LocalCloudMockDatabase();\n   546\t  private isCloudAvailable: boolean | null = null;\n   547\t  private forceMock: boolean = false;\n   548\t\n   549\t  public getMockDb() {\n   550\t    return this.mockDb;\n   551\t  }\n   552\t\n   553\t  public setForceMock(mock: boolean) {\n   554\t    this.forceMock = mock;\n   555\t  }\n   556\t\n   557\t  public resetAvailability() {\n   558\t    this.isCloudAvailable = null;\n   559\t  }\n   560\t\n   561\t  /**\n   562\t   * 判断当前微信环境是否真正支持并开通了云开发\n   563\t   */\n   564\t  public checkCloudAvailability(): boolean {\n   565\t    if (this.forceMock) return false;\n   566\t    if (this.isCloudAvailable !== null) return this.isCloudAvailable;\n   567\t    if (typeof wx !== 'undefined' && wx.cloud && typeof wx.cloud.callFunction === 'function') {\n   568\t      this.isCloudAvailable = true;\n   569\t    } else {\n   570\t      this.isCloudAvailable = false;\n   571\t    }\n   572\t    return this.isCloudAvailable;\n   573\t  }\n   574\t\n   575\t  /**\n   576\t   * 统一云函数调用方法\n   577\t   * 真实微信小程序环境下：严禁网络报错后假成功降级返回 Mock！一律返回失败交由离线待同步队列重试。\n   578\t   * 本地仿真 Mock 仅在无微信环境（Node.js 本地单测）或本地强制模拟模式下生效。\n   579\t   */\n   580\t  public async callFunction<T = any>(name: string, data: any = {}): Promise<CloudResponse<T>> {\n   581\t    const hasCloud = this.checkCloudAvailability();\n   582\t\n   583\t    if (hasCloud) {\n   584\t      try {\n   585\t        const res = await wx.cloud.callFunction({\n   586\t          name,\n   587\t          data\n   588\t        });\n   589\t        if (res && res.result) {\n   590\t          return res.result as CloudResponse<T>;\n   591\t        }\n   592\t        return { success: false, error: '云函数返回空结果' };\n   593\t      } catch (err: any) {\n   594\t        const errMsg = err?.errMsg || err?.message || String(err);\n   595\t        console.warn(`[CloudService] 云函数 ${name} 线上调用失败:`, errMsg);\n   596\t        // 严格遵循第 1 项要求：严禁降级返回 Mock 的 success！一律返回 { success: false, error: err.message }\n   597\t        return { success: false, error: err?.message || errMsg };\n   598\t      }\n   599\t    }\n   600\t\n   601\t    // 本地仿真降级处理 (仅在无微信环境下使用)\n   602\t    return this.invokeLocalMock(name, data);\n   603\t  }\n   604\t\n   605\t  /**\n   606\t   * 本地 Mock 逻辑分发\n   607\t   */\n   608\t  private invokeLocalMock(name: string, data: any): CloudResponse<any> {\n   609\t    switch (name) {\n   610\t      case 'userAuth':\n   611\t        return this.mockDb.handleUserAuth(data);\n   612\t      case 'familyManage':\n   613\t        return this.mockDb.handleFamilyManage(data);\n   614\t      case 'upsertMeal':\n   615\t        return this.mockDb.handleUpsertMeal(data);\n   616\t      case 'customDish':\n   617\t        return this.mockDb.handleCustomDish(data);\n   618\t      default:\n   619\t        return { success: false, error: `未知云函数: ${name}` };\n   620\t    }\n   621\t  }\n   622\t}\n   623\t\n   624\texport const cloudService = new CloudService();\n     1\timport { cloudService } from './cloudService.js';\n     2\timport type { FamilySpace, UserProfile } from '../types/family.js';\n     3\t\n     4\tconst STORAGE_KEY_USER = 'current_user_profile';\n     5\tconst STORAGE_KEY_FAMILY = 'current_family_space';\n     6\t\n     7\ttype FamilyChangeListener = (family: FamilySpace | null) => void;\n     8\t\n     9\tclass FamilyService {\n    10\t  private currentUser: UserProfile = {\n    11\t    openid: 'wx_user_default',\n    12\t    nickName: '我',\n    13\t    avatarUrl: '',\n    14\t    familyId: null,\n    15\t    role: null,\n    16\t    createdAt: Date.now(),\n    17\t    updatedAt: Date.now()\n    18\t  };\n    19\t\n    20\t  private currentFamily: FamilySpace | null = null;\n    21\t  private listeners: Set<FamilyChangeListener> = new Set();\n    22\t  private initialized = false;\n    23\t\n    24\t  constructor() {\n    25\t    this.restoreFromStorage();\n    26\t  }\n    27\t\n    28\t  public init(): void {\n    29\t    if (this.initialized) return;\n    30\t    this.restoreFromStorage();\n    31\t    this.initialized = true;\n    32\t  }\n    33\t\n    34\t  private restoreFromStorage(): void {\n    35\t    try {\n    36\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    37\t        const storedUser = wx.getStorageSync(STORAGE_KEY_USER);\n    38\t        if (storedUser) {\n    39\t          this.currentUser = { ...this.currentUser, ...storedUser };\n    40\t        }\n    41\t        const storedFam = wx.getStorageSync(STORAGE_KEY_FAMILY);\n    42\t        if (storedFam) {\n    43\t          this.currentFamily = storedFam;\n    44\t        }\n    45\t      }\n    46\t    } catch (e) {\n    47\t      console.warn('读取本地家庭缓存失败', e);\n    48\t    }\n    49\t  }\n    50\t\n    51\t  private persist(): void {\n    52\t    try {\n    53\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n    54\t        wx.setStorageSync(STORAGE_KEY_USER, this.currentUser);\n    55\t        if (this.currentFamily) {\n    56\t          wx.setStorageSync(STORAGE_KEY_FAMILY, this.currentFamily);\n    57\t        } else {\n    58\t          wx.removeStorageSync(STORAGE_KEY_FAMILY);\n    59\t        }\n    60\t      }\n    61\t    } catch (e) {\n    62\t      console.warn('持久化本地家庭缓存失败', e);\n    63\t    }\n    64\t    this.notifyListeners();\n    65\t  }\n    66\t\n    67\t  public subscribe(listener: FamilyChangeListener): () => void {\n    68\t    this.listeners.add(listener);\n    69\t    return () => this.listeners.delete(listener);\n    70\t  }\n    71\t\n    72\t  private notifyListeners(): void {\n    73\t    for (const listener of this.listeners) {\n    74\t      try {\n    75\t        listener(this.currentFamily);\n    76\t      } catch (err) {\n    77\t        console.error('家庭状态订阅回调异常', err);\n    78\t      }\n    79\t    }\n    80\t  }\n    81\t\n    82\t  public getCurrentUser(): UserProfile {\n    83\t    return this.currentUser;\n    84\t  }\n    85\t\n    86\t  public getCurrentFamily(): FamilySpace | null {\n    87\t    return this.currentFamily;\n    88\t  }\n    89\t\n    90\t  public setMockCurrentUser(openid: string, nickName: string = '家人'): void {\n    91\t    this.currentUser.openid = openid;\n    92\t    this.currentUser.nickName = nickName;\n    93\t    this.currentUser.familyId = null;\n    94\t    this.currentUser.role = null;\n    95\t    this.currentFamily = null;\n    96\t    this.persist();\n    97\t  }\n    98\t\n    99\t  /**\n   100\t   * 静默登录与鉴权同步\n   101\t   */\n   102\t  public async syncUserAuth(): Promise<UserProfile> {\n   103\t    const res = await cloudService.callFunction('userAuth', {\n   104\t      mockOpenid: this.currentUser.openid,\n   105\t      nickName: this.currentUser.nickName,\n   106\t      avatarUrl: this.currentUser.avatarUrl\n   107\t    });\n   108\t\n   109\t    if (res.success && res.user) {\n   110\t      this.currentUser = {\n   111\t        openid: res.openid || this.currentUser.openid,\n   112\t        nickName: res.user.nickName || this.currentUser.nickName,\n   113\t        avatarUrl: res.user.avatarUrl || '',\n   114\t        familyId: res.user.familyId || null,\n   115\t        role: res.user.role || null,\n   116\t        createdAt: res.user.createdAt || Date.now(),\n   117\t        updatedAt: res.user.updatedAt || Date.now()\n   118\t      };\n   119\t      if (res.family) {\n   120\t        this.currentFamily = res.family;\n   121\t      } else if (!this.currentUser.familyId) {\n   122\t        this.currentFamily = null;\n   123\t      }\n   124\t      this.persist();\n   125\t    }\n   126\t\n   127\t    return this.currentUser;\n   128\t  }\n   129\t\n   130\t  /**\n   131\t   * 1. 创建家庭空间\n   132\t   */\n   133\t  public async createFamily(name = '温馨小家食堂', nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n   134\t    const callerNick = nickName || this.currentUser.nickName || '房主';\n   135\t    const res = await cloudService.callFunction('familyManage', {\n   136\t      action: 'createFamily',\n   137\t      mockOpenid: this.currentUser.openid,\n   138\t      name,\n   139\t      nickName: callerNick,\n   140\t      avatarUrl: this.currentUser.avatarUrl\n   141\t    });\n   142\t\n   143\t    if (res.success && res.family) {\n   144\t      this.currentFamily = res.family;\n   145\t      this.currentUser.familyId = res.family.id || res.family._id;\n   146\t      this.currentUser.role = 'creator';\n   147\t      this.currentUser.nickName = callerNick;\n   148\t      this.persist();\n   149\t      return { success: true, family: res.family };\n   150\t    }\n   151\t\n   152\t    return { success: false, error: res.error || '创建家庭空间失败' };\n   153\t  }\n   154\t\n   155\t  /**\n   156\t   * 2. 口令加入家庭 (云端事务，上限 4 人，一人一家庭互斥)\n   157\t   */\n   158\t  public async joinFamily(inviteCode: string, nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n   159\t    const code = inviteCode.trim();\n   160\t    if (!code || code.length !== 6) {\n   161\t      return { success: false, error: '请输入正确的6位数字邀请码' };\n   162\t    }\n   163\t\n   164\t    const callerNick = nickName || this.currentUser.nickName || '家人';\n   165\t    const res = await cloudService.callFunction('familyManage', {\n   166\t      action: 'joinFamily',\n   167\t      mockOpenid: this.currentUser.openid,\n   168\t      inviteCode: code,\n   169\t      nickName: callerNick,\n   170\t      avatarUrl: this.currentUser.avatarUrl\n   171\t    });\n   172\t\n   173\t    if (res.success && res.family) {\n   174\t      this.currentFamily = res.family;\n   175\t      this.currentUser.familyId = res.family.id || res.family._id;\n   176\t      this.currentUser.role = 'member';\n   177\t      this.currentUser.nickName = callerNick;\n   178\t      this.persist();\n   179\t      return { success: true, family: res.family };\n   180\t    }\n   181\t\n   182\t    return { success: false, error: res.error || '加入家庭空间失败' };\n   183\t  }\n   184\t\n   185\t  /**\n   186\t   * 3. 退出 / 解散家庭\n   187\t   */\n   188\t  public async leaveFamily(): Promise<{ success: boolean; error?: string }> {\n   189\t    const res = await cloudService.callFunction('familyManage', {\n   190\t      action: 'leaveFamily',\n   191\t      mockOpenid: this.currentUser.openid\n   192\t    });\n   193\t\n   194\t    if (res.success) {\n   195\t      this.currentUser.familyId = null;\n   196\t      this.currentUser.role = null;\n   197\t      this.currentFamily = null;\n   198\t      this.persist();\n   199\t      return { success: true };\n   200\t    }\n   201\t\n   202\t    return { success: false, error: res.error || '退出家庭失败' };\n   203\t  }\n   204\t\n   205\t  /**\n   206\t   * 4. 刷新 24 小时动态口令\n   207\t   */\n   208\t  public async refreshInviteCode(): Promise<{ success: boolean; inviteCode?: string; error?: string }> {\n   209\t    if (!this.currentFamily) {\n   210\t      return { success: false, error: '尚未加入家庭' };\n   211\t    }\n   212\t\n   213\t    const res = await cloudService.callFunction('familyManage', {\n   214\t      action: 'refreshInviteCode',\n   215\t      mockOpenid: this.currentUser.openid,\n   216\t      familyId: this.currentFamily.id || (this.currentFamily as any)._id\n   217\t    });\n   218\t\n   219\t    if (res.success && res.inviteCode) {\n   220\t      this.currentFamily.inviteCode = res.inviteCode;\n   221\t      this.currentFamily.inviteExpiredAt = res.inviteExpiredAt;\n   222\t      this.persist();\n   223\t      return { success: true, inviteCode: res.inviteCode };\n   224\t    }\n   225\t\n   226\t    return { success: false, error: res.error || '刷新邀请码失败' };\n   227\t  }\n   228\t}\n   229\t\n   230\texport const familyService = new FamilyService();\n","exit_code":0,"status":"completed"}}
