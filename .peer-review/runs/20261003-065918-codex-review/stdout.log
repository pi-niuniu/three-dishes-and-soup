,\n   537\t    currentMonth: 10,\n   538\t    preferences: {\n   539\t      mode: 'hearty_3_1',\n   540\t      spicyLevel: 0,\n   541\t      dislikedIngredients: [],\n   542\t      customDietaryTags: []\n   543\t    },\n   544\t    history: historyService.getHistory(),\n   545\t    allDishes: dataProvider.getAllDishes(),\n   546\t    targetDateDay: 'tomorrow'\n   547\t  });\n   548\t\n   549\t  const tomorrowDishNames = tomorrowMenu.slots.map(s => s.dish.name);\n   550\t  console.log('明天自动排餐结果:', tomorrowDishNames.join(' + '));\n   551\t  // 验证昨日吃过的菜绝不重复出现在明天菜单中\n   552\t  assert(!tomorrowDishNames.includes('奶奶牌秘制东坡肉'), '昨日吃过的奶奶私房菜应被避重');\n   553\t  assert(!tomorrowDishNames.includes('青椒肉丝'), '昨日吃过的青椒肉丝应被避重');\n   554\t  assert(!tomorrowDishNames.includes('清蒸鲈鱼'), '昨日吃过的清蒸鲈鱼应被避重');\n   555\t  console.log('✅ 智能排餐成功避开全家昨日午餐和晚餐吃过的全部菜品！');\n   556\t\n   557\t  // -------------------------------------------------------------\n   558\t  // 【阶段 7】大厨交付中心买菜清单与微信卡片免密扫码还原\n   559\t  // -------------------------------------------------------------\n   560\t  console.log('\\n【阶段 7】交付中心买菜清单与大厨端免密扫码还原');\n   561\t  const shoppingList = shoppingListService.generateShoppingList(tomorrowMenu.slots.map(s => s.dish));\n   562\t  assert(shoppingList.length > 0, '买菜清单生成成功');\n   563\t  console.log(`✅ 自动生成买菜食材项: ${shoppingList.length} 样 (包含菜场口语化斤两)`);\n   564\t\n   565\t  const shareParam = shoppingListService.serializeMenuForShare(tomorrowMenu);\n9:  history: MealHistoryRecord[];\n13:  targetDateDay?: 'today' | 'tomorrow';\n16:function formatLocalDate(d: Date): string {\n19:  const day = String(d.getDate()).padStart(2, '0');\n80:      history,\n84:      targetDateDay = 'tomorrow'\n99:    const historyRelaxRate = history.length >= 10 ? 0.5 : 1.0;\n103:      score: this.scoreDish(dish, currentMonth, preferences, history, mode, historyRelaxRate)\n181:    const targetDateObj = new Date();\n182:    if (targetDateDay === 'tomorrow') {\n183:      targetDateObj.setDate(targetDateObj.getDate() + 