{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba miniprogram/services/menuRecommendation.ts | sed -n '367,445p'; nl -ba miniprogram/services/menuRecommendation.ts | sed -n '475,516p'; nl -ba test/e2e_family_custom_full_flow_test.mjs | sed -n '330,360p'; nl -ba test/family_sharing_custom_dishes_test.mjs | sed -n '90,136p'; nl -ba test/final_security_hardening_test.mjs | sed -n '125,175p'; nl -ba node_modules/wx-server-sdk/index.js | sed -n '118,155p'\"","aggregated_output":"   367\t    });\n   368\t  }\n   369\t\n   370\t  public scoreDish(\n   371\t    dish: Dish,\n   372\t    currentMonth: number,\n   373\t    preferences: UserPreferences,\n   374\t    history: MealHistoryRecord[],\n   375\t    mode?: MealMode,\n   376\t    relaxRate: number = 1.0\n   377\t  ): number {\n   378\t    const seasonScore = this.calculateSeasonScore(dish, currentMonth);\n   379\t    const prefScore = this.calculatePreferenceScore(dish, preferences);\n   380\t    \n   381\t    // 动态保底：如果历史记录已很满，对惩罚做平滑补偿\n   382\t    const rawPenalty = this.calculateHistoryPenalty(dish.id, history);\n   383\t    const historyPenalty = 1.0 - (1.0 - rawPenalty) * relaxRate;\n   384\t\n   385\t    const favoriteBoost = preferences.favoriteDishIds?.includes(dish.id) ? 1.2 : 1.0;\n   386\t    const difficultyScore = dish.difficulty === 1 ? 1.1 : (dish.difficulty === 2 ? 1.0 : 0.9);\n   387\t    const jitter = 0.95 + Math.random() * 0.1;\n   388\t\n   389\t    let stirFriesBoost = 1.0;\n   390\t    if (mode === 'three_stir_fries' && (dish.cookingMethod === 'stir_fry' || dish.cookingMethod === 'clear_fry')) {\n   391\t      stirFriesBoost = 1.3;\n   392\t    }\n   393\t\n   394\t    const baseScore =\n   395\t      (seasonScore * 0.30) +\n   396\t      (prefScore * 0.20) +\n   397\t      (historyPenalty * 0.25) +\n   398\t      (difficultyScore * 0.10) +\n   399\t      (dish.tags.includes('大厨拿手') ? 0.15 : 0.05);\n   400\t\n   401\t    return baseScore * favoriteBoost * stirFriesBoost * jitter;\n   402\t  }\n   403\t\n   404\t  public calculateSeasonScore(dish: Dish, currentMonth: number): number {\n   405\t    if (dish.bestMonths.includes(currentMonth)) return 1.0;\n   406\t    if (dish.availableMonths.includes(currentMonth)) return 0.7;\n   407\t    return 0.3;\n   408\t  }\n   409\t\n   410\t  public calculatePreferenceScore(dish: Dish, preferences: UserPreferences): number {\n   411\t    let score = 0.7;\n   412\t    if (dish.spicyLevel === preferences.spicyLevel) score += 0.2;\n   413\t    return Math.min(score, 1.0);\n   414\t  }\n   415\t\n   416\t  public calculateHistoryPenalty(dishId: string, history: MealHistoryRecord[]): number {\n   417\t    if (!history || history.length === 0) return 1.0;\n   418\t    const now = Date.now();\n   419\t    let minDaysAgo = 999;\n   420\t    for (const record of history) {\n   421\t      const ids = Array.isArray(record?.dishIds)\n   422\t        ? record.dishIds\n   423\t        : (Array.isArray(record?.dishes) ? record.dishes.map(d => d.id).filter(Boolean) : []);\n   424\t      if (ids.includes(dishId)) {\n   425\t        const daysAgo = Math.floor((now - record.timestamp) / (1000 * 60 * 60 * 24));\n   426\t        if (daysAgo < minDaysAgo) {\n   427\t          minDaysAgo = daysAgo;\n   428\t        }\n   429\t      }\n   430\t    }\n   431\t    if (minDaysAgo <= 3) return 0.1;\n   432\t    if (minDaysAgo <= 7) return 0.4;\n   433\t    if (minDaysAgo <= 14) return 0.7;\n   434\t    return 1.0;\n   435\t  }\n   436\t\n   437\t  private isCategoryMatchingRole(category: DishCategory, role: SlotRole): boolean {\n   438\t    switch (role) {\n   439\t      case 'main_meat':\n   440\t        return category === 'main_meat';\n   441\t      case 'secondary_meat':\n   442\t        return category === 'secondary_meat' || category === 'egg' || category === 'tofu';\n   443\t      case 'egg_or_tofu':\n   444\t        return category === 'egg' || category === 'tofu';\n   445\t      case 'vegetable':\n   475\t      // 肉类主料最多 2 道\n   476\t      const currentCount = usedMainIngredients[dish.mainIngredient] || 0;\n   477\t      if (currentCount >= 2) continue;\n   478\t\n   479\t      // 生鲜果蔬/豆制品同桌严禁重样 (杜绝丝瓜炒蛋 + 丝瓜汤、番茄炒蛋 + 番茄汤、土豆牛肉 + 土豆丝等撞菜)\n   480\t      const pks = getProduceKeys(dish);\n   481\t      if (pks.some(pk => usedProduces.has(pk))) continue;\n   482\t\n   483\t      validCandidates.push(item);\n   484\t    }\n   485\t\n   486\t    if (validCandidates.length === 0) {\n   487\t      // 兜底放宽蔬果限制\n   488\t      const fallback = scoredDishes.find(\n   489\t        item => !excludedDishIds.includes(item.dish.id) &&\n   490\t        this.isCategoryMatchingRole(item.dish.category, role)\n   491\t      );\n   492\t      return fallback?.dish;\n   493\t    }\n   494\t\n   495\t    // 采用加权随机抽样（分数 3 次幂放大优质菜品概率，同时赋予充沛多样性）\n   496\t    const weights = validCandidates.map(c => Math.max(0.01, Math.pow(c.score, 3)));\n   497\t    const totalWeight = weights.reduce((sum, w) => sum + w, 0);\n   498\t    let rand = Math.random() * totalWeight;\n   499\t\n   500\t    for (let i = 0; i < validCandidates.length; i++) {\n   501\t      rand -= weights[i];\n   502\t      if (rand <= 0) {\n   503\t        return validCandidates[i].dish;\n   504\t      }\n   505\t    }\n   506\t\n   507\t    return validCandidates[0].dish;\n   508\t  }\n   509\t\n   510\t  private calculateEstimatedTotalTime(dishes: Dish[]): number {\n   511\t    if (dishes.length === 0) return 0;\n   512\t    const maxTime = Math.max(...dishes.map(d => d.cookingTimeMinutes));\n   513\t    return maxTime + (dishes.length - 1) * 5;\n   514\t  }\n   515\t}\n   516\t\n   330\t    }\n   331\t\n   332\t    return { success: false, error: '未知云函数或方法' };\n   333\t  }\n   334\t}\n   335\t\n   336\t// 3. 执行全景 E2E 剧本测试\n   337\tasync function runFullE2ESuite() {\n   338\t  console.log('===============================================================');\n   339\t  console.log('🎬 启动《四季三餐·好好吃饭》4人家庭+同日多餐+私房菜全链路端到端集成测试');\n   340\t  console.log('===============================================================\\n');\n   341\t\n   342\t  const hub = new MockCloudBaseHub();\n   343\t\n   344\t  // 设备定义：爸爸、妈妈、大宝、奶奶、邻居\n   345\t  const deviceDad = new MockWechatDevice('openid_dad', '老爸大厨');\n   346\t  const deviceMom = new MockWechatDevice('openid_mom', '老妈');\n   347\t  const deviceKid = new MockWechatDevice('openid_kid', '大宝');\n   348\t  const deviceGrandma = new MockWechatDevice('openid_grandma', '奶奶');\n   349\t  const deviceNeighbor = new MockWechatDevice('openid_neighbor', '隔壁老王');\n   350\t\n   351\t  let currentActiveDevice = deviceDad;\n   352\t\n   353\t  const globalNetworkListeners = [];\n   354\t  function setNetworkStatus(isConnected) {\n   355\t    currentActiveDevice.isOnline = isConnected;\n   356\t    for (const cb of globalNetworkListeners) {\n   357\t      cb({ isConnected, networkType: isConnected ? 'wifi' : 'none' });\n   358\t    }\n   359\t  }\n   360\t\n    90\tassert(joinD.success, 'User D 加入家庭必须成功');\n    91\tassert.equal(joinD.family.members.length, 4, '成员数达到上限 4 人');\n    92\tconsole.log(`✅ 4 位家庭成员依次顺利绑定: ${joinD.family.members.map(m => m.nickName).join(' + ')}`);\n    93\t\n    94\t// 5. 易错点 2 防御：User E 尝试加入，必须被严格拦截\n    95\tfamilyService.setMockCurrentUser('openid_user_e', '邻居小王');\n    96\tconst joinE = await familyService.joinFamily(inviteCode);\n    97\tassert.equal(joinE.success, false, '第 5 个人加入必须被云端事务强制拒绝');\n    98\tassert(joinE.error.includes('上限4人') || joinE.error.includes('成员已满'), `错误提示应明确超员拦截: ${joinE.error}`);\n    99\tconsole.log(`✅ 并发防超员防御验证通过：拦截第 5 位加入请求 -> \"${joinE.error}\"`);\n   100\t\n   101\t// 6. 易错点 2 & 口令有效期防御：已过期口令不可加入\n   102\tconst currentFam = cloudService.getMockDb().handleFamilyManage({\n   103\t  action: 'getFamily',\n   104\t  familyId: joinD.family.id\n   105\t}).family;\n   106\tcurrentFam.inviteExpiredAt = Date.now() - 1000; // 模拟口令过期\n   107\tconst joinExpired = await familyService.joinFamily(inviteCode);\n   108\tassert.equal(joinExpired.success, false, '已过期口令加入必须失败');\n   109\tassert(joinExpired.error.includes('失效') || joinExpired.error.includes('过期'), `错误提示应明确口令过期: ${joinExpired.error}`);\n   110\tconsole.log(`✅ 24 小时动态口令失效检验通过 -> \"${joinExpired.error}\"`);\n   111\t\n   112\t// 恢复有效口令\n   113\tcurrentFam.inviteExpiredAt = Date.now() + 24 * 3600 * 1000;\n   114\t\n   115\t// 7. 易错点 3 防御：一人一家庭互斥测试 (User B 切换到新家庭，旧家庭自动移除)\n   116\tfamilyService.setMockCurrentUser('openid_user_b', '妈妈');\n   117\tconst newFamRes = await familyService.createFamily('妈妈的新工作室食堂');\n   118\tassert(newFamRes.success, 'User B 创建新家庭成功');\n   119\tassert.equal(familyService.getCurrentFamily().id, newFamRes.family.id);\n   120\t\n   121\t// 检查原家庭成员列表中是否已自动移除 User B，且房主仍然是爸爸\n   122\tconst oldFamCheck = cloudService.getMockDb().handleFamilyManage({\n   123\t  action: 'getFamily',\n   124\t  familyId: joinD.family.id\n   125\t}).family;\n   126\tassert(!oldFamCheck.memberOpenids.includes('openid_user_b'), '旧家庭必须已原子移除 User B');\n   127\tassert.equal(oldFamCheck.members.length, 3, '旧家庭人数应变为 3 人');\n   128\tassert.equal(oldFamCheck.creatorOpenid, 'openid_user_a', '普通成员离开后原房主 openid 必须完好保持');\n   129\tconsole.log('✅ 一人一家庭单向互斥验证通过：切换家庭后旧家庭成员已安全剥离且房主权属保持！\\n');\n   130\t\n   131\t\n   132\t// -------------------------------------------------------------\n   133\t// 【模块二】共享做菜历史与同日多餐独立同步 (解决覆盖写灾难)\n   134\t// -------------------------------------------------------------\n   135\tconsole.log('【阶段二】测试共享做菜历史与同日多餐独立记录 (易错点 1 & 4 & 6 防御)');\n   136\t\n   125\tconsole.log('【加固项 2】验证 familyManage 退出旧家庭失败中断与防刷限频');\n   126\t\n   127\t// 2.1 源码审查：createFamily 退出旧家庭失败抛错中断，且无冗余 _id\n   128\tconst familyManageSource = fs.readFileSync(path.resolve('cloudfunctions/familyManage/index.js'), 'utf-8');\n   129\tassert(familyManageSource.includes('退出原有家庭失败，中断创建新家庭'), '退出旧家庭失败必须抛错中断以防一人跨两家');\n   130\tassert(familyManageSource.includes('checkJoinRateLimit'), '必须在加入家庭时调用 checkJoinRateLimit 防暴力枚举');\n   131\tassert(familyManageSource.includes('recordJoinFailure'), '必须记录口令失败尝试 recordJoinFailure');\n   132\tassert(!familyManageSource.includes('_id: `user_${openid}`'), 'familyManage 中 users.doc().set() 严禁包含冗余 _id 字段');\n   133\tconsole.log('✅ familyManage 源码中退出旧家庭失败中断、防刷限频与 _id 剔除逻辑核验通过！');\n   134\t\n   135\t// 2.2 防刷限频计数验证：连续 5 次错误邀请码后锁定 (测试真实云函数)\n   136\tconst realAttackerOpenid = 'openid_real_attacker';\n   137\tfor (let i = 1; i <= 5; i++) {\n   138\t  const tryRes = await familyManageModule.default.main({\n   139\t    action: 'joinFamily',\n   140\t    inviteCode: '000000',\n   141\t    mockOpenid: realAttackerOpenid\n   142\t  }, {});\n   143\t  assert.equal(tryRes.success, false);\n   144\t  assert(tryRes.error.includes('未找到') || tryRes.error.includes('口令'), '前5次返回口令错误');\n   145\t}\n   146\t\n   147\t// 第 6 次尝试（即使给正确口令也必须被安全锁定拒绝！）\n   148\tconst realLockedRes = await familyManageModule.default.main({\n   149\t  action: 'joinFamily',\n   150\t  inviteCode: realCreateRes.family.inviteCode,\n   151\t  mockOpenid: realAttackerOpenid\n   152\t}, {});\n   153\tassert.equal(realLockedRes.success, false, '真实云函数中尝试 5 次失败后必须触发防刷锁定拦截');\n   154\tassert(\n   155\t  realLockedRes.error.includes('防暴力枚举') || realLockedRes.error.includes('安全锁定'),\n   156\t  `应返回防刷限频提示: ${realLockedRes.error}`\n   157\t);\n   158\tconsole.log(`✅ 攻击者尝试 5 次后触发拦截 -> \"${realLockedRes.error}\"`);\n   159\t\n   160\t// 验证全新用户（无用户档案 null）创建家庭顺利通过，杜绝 TypeError\n   161\tconst brandNewOpenid = 'openid_brand_new_user';\n   162\tconst newFamRes = await familyManageModule.default.main({\n   163\t  action: 'createFamily',\n   164\t  name: '崭新家庭',\n   165\t  nickName: '崭新房主',\n   166\t  mockOpenid: brandNewOpenid\n   167\t}, {});\n   168\tassert(newFamRes.success, '全新用户初次创建家庭必须成功无报错');\n   169\tconsole.log('✅ 全新用户初次创建家庭无 null 异常且顺利通过！\\n');\n   170\t\n   171\t// -------------------------------------------------------------\n   172\t// 【加固项 3】historyService 离线待同步队列业务明确拒绝出队并标记 failed\n   173\t// -------------------------------------------------------------\n   174\tconsole.log('【加固项 3】验证 historyService 离线队列对业务明确拒绝与网络异常的区分处理');\n   175\t\n   118\t      pull: (val) => ({ $pull: val })\n   119\t    },\n   120\t    runTransaction: async (cb) => {\n   121\t      const transaction = {\n   122\t        collection: (colName) => ({\n   123\t          doc: (docId) => createDocRef(colName, docId)\n   124\t        }),\n   125\t        rollback: async (msg) => {\n   126\t          throw new Error(msg || 'transaction rollback');\n   127\t        }\n   128\t      };\n   129\t      return await cb(transaction);\n   130\t    },\n   131\t    collection: (name) => createCollectionRef(name)\n   132\t  }),\n   133\t  openapi: {\n   134\t    security: {\n   135\t      msgSecCheck: async () => ({ errCode: 0, result: { suggest: 'pass' } })\n   136\t    }\n   137\t  }\n   138\t};\n   139\t\n   140\tmodule.exports = mockSdk;\n","exit_code":0,"status":"completed"}}
