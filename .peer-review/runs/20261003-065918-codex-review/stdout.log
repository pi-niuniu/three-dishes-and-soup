\": \"./dist/ast/factory.generated.js\",\n        \"./unstable/ast/utils\": \"./dist/ast/utils.js\",\n        \"./unstable/ast/scanner\": \"./dist/ast/scanner.js\",\n        \"./unstable/ast/visitor\": \"./dist/ast/visitor.js\",\n        \"./unstable/ast/clone\": \"./dist/ast/clone.js\"\n    },\n    \"imports\": {\n        \"#getExePath\": \"./lib/getExePath.js\",\n        \"#enums/*\": {\n            \"types\": \"./dist/enums/*.enum.d.ts\",\n            \"default\": \"./dist/enums/*.js\"\n        },\n        \"#vscode-jsonrpc/node\": \"./vendor/vscode-jsonrpc/lib/node/main.js\"\n    },\n    \"gitHead\": \"2bd066d87f5bafd315be9f40889d0a60b9e58e0b\",\n    \"publishConfig\": {\n        \"access\": \"public\",\n        \"tag\": \"latest\"\n    },\n    \"optionalDependencies\": {\n        \"@typescript/typescript-win32-x64\": \"7.0.2\",\n        \"@typescript/typescript-win32-arm64\": \"7.0.2\",\n        \"@typescript/typescript-linux-x64\": \"7.0.2\",\n        \"@typescript/typescript-linux-arm\": \"7.0.2\",\n        \"@typescript/typescript-linux-arm64\": \"7.0.2\",\n        \"@typescript/typescript-darwin-x64\": \"7.0.2\",\n        \"@typescript/typescript-darwin-arm64\": \"7.0.2\",\n        \"@typescript/typescript-aix-ppc64\": \"7.0.2\",\n        \"@typescript/typescript-freebsd-arm64\": \"7.0.2\",\n        \"@typescript/typescript-freebsd-x64\": \"7.0.2\",\n        \"@typescript/typescript-linux-loong64\": \"7.0.2\",\n        \"@typescript/typescript-linux-mips64el\": \"7.0.2\",\n        \"@typescript/typescript-linux-ppc64\": \"7.0.2\",\n        \"@typescript/typescript-linux-riscv64\": \"7.0.2\",\n        \"@typescript/typescript-linux-s390x\": \"7.0.2\",\n        \"@typescript/typescript-netbsd-arm64\": \"7.0.2\",\n        \"@typescript/typescript-netbsd-x64\": \"7.0.2\",\n        \"@typescript/typescript-openbsd-arm64\": \"7.0.2\",\n        \"@typescript/typescript-openbsd-x64\": \"7.0.2\",\n        \"@typescript/typescript-sunos-x64\": \"7.0.2\"\n    }\n}    23\tconst __dirname = path.dirname(__filename);\n    24\tconst rootDir = path.resolve(__dirname, '..');\n    25\t\n    26\t// 1. 模拟微信小程序多设备原生底层环境 (Multi-Device Mock Wechat Environment)\n    27\tclass MockWechatDevice {\n    28\t  constructor(openid, nickName) {\n    29\t    this.openid = openid;\n    30\t    this.nickName = nickName;\n    31\t    this.storage = new Map();\n    32\t    this.clipboardData = '';\n    33\t    this.isOnline = true;\n    34\t    this.networkListeners = [];\n    35\t  }\n    36\t\n    37\t  getStorageSync(key) {\n    38\t    return this.storage.get(key);\n    39\t  }\n    40\t\n    41\t  setStorageSync(key, val) {\n    42\t    this.storage.set(key, JSON.parse(JSON.stringify(val)));\n    43\t  }\n    44\t\n    45\t  removeStorageSync(key) {\n    46\t    this.storage.delete(key);\n    47\t  }\n    48\t\n    49\t  clearStorageSync() {\n    50\t    this.storage.clear();\n    51\t  }\n    52\t\n    53\t  setClipboardData({ data, success }) {\n    54\t    this.clipboardData = data;\n    55\t    if (success) success({ errMsg: 'setClipboardData:ok' });\n    56\t  }\n    57\t\n    58\t  onNetworkStatusChange(cb) {\n    59\t    this.networkListeners.push(cb);\n    60\t  }\n    61\t\n    62\t  simulateNetworkChange(isConnected) {\n    63\t    this.isOnline = isConnected;\n    64\t    for (const cb of this.networkListeners) {\n    65\t      cb({ isConnected, networkType: isConnected ? 'wifi' : 'none' });\n    66\t    }\n    67\t  }\n    68\t}\n    69\t\n    70\t// 2. 模拟微信云端数据库与云函数中心 (CloudBase Central Hub)\n    71\tclass MockCloudBaseHub {\n    72\t  constructor() {\n    73\t    this.users = new Map();\n    74\t    this.families = new Map();\n    75\t    this.mealHistories = new Map(); // key: meal_${familyId}_${date}\n    76\t    this.customDishes = new Map(); // key: dishId\n    77\t    this.sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n    78\t  }\n    79\t\n    80\t  async callFunction({ name, data }, callerOpenid) {\n    81\t    const now = Date.now();\n    82\t\n    83\t    if (name === 'userAuth') {\n    84\t      const openid = callerOpenid;\n    85\t      let user = this.users.get(openid);\n    86\t      if (!user) {\n    87\t        user = {\n    88\t          _id: `user_${openid}`,\n    89\t          openid,\n    90\t          nickName: data.nickName || '微信用户',\n    91\t          familyId: null,\n    92\t          role: 'personal',\n    93\t          createdAt: now\n    94\t        };\n    95\t        this.users.set(openid, user);\n    96\t      }\n    97\t      let family = null;\n    98\t      if (user.familyId) {\n    99\t        family = this.families.get(user.familyId) || null;\n   100\t      }\n   101\t      return { success: true, user, family, openid };\n   102\t    }\n   103\t\n   104\t    if (name === 'familyManage') {\n   105\t      const openid = callerOpenid;\n   106\t      const { action } = data;\n   107\t\n   108\t      if (action === 'createFamily') {\n   109\t        const name = (data.name || '我的家庭厨房').trim();\n   110\t        if (this.sensitiveWords.some(w => name.includes(w))) {\n   111\t          return { success: false, error: '家庭名称包含敏感词' };\n   112\t        }\n   113\t        const famId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n   114\t        const inviteCode = String(Math.floor(100000 + Math.random() * 900000));\n   115\t        const family = {\n   116\t          _id: famId,\n   117\t          id: famId,\n   118\t          name,\n   119\t          creatorOpenid: openid,\n   120\t          members: [{ openid, nickName: data.nickName || '房主', role: 'creator', joinedAt: now }],\n   293\t// -------------------------------------------------------------\n   294\t// 【测试 7】生产环境缺失 OPENID 拒绝对比测试\n   295\t// -------------------------------------------------------------\n   296\tconsole.log('【阶段七】测试生产环境缺失 OPENID 坚决拒绝伪造');\n   297\t\n   298\tconst familyManageModule = await import('../cloudfunctions/familyManage/index.js');\n   299\tconst upsertMealModule = await import('../cloudfunctions/upsertMeal/index.js');\n   300\tconst customDishModule = await import('../cloudfunctions/customDish/index.js');\n   301\tconst userAuthModule = await import('../cloudfunctions/userAuth/index.js');\n   302\t\n   303\t// 模拟生产环境 (NODE_ENV !== 'test', 无 OPENID, 未带 _testMock)\n   304\tconst originalNodeEnv = process.env.NODE_ENV;\n   305\tdelete process.env.NODE_ENV;\n   306\t\n   307\tconst fakeEvent = {\n   308\t  action: 'createFamily',\n   309\t  name: '黑客伪造家庭',\n   310\t  mockOpenid: 'victim_user'\n   311\t};\n   312\t\n   313\tconst famResultProd = await familyManageModule.main(fakeEvent, {});\n   314\tassert.equal(famResultProd.success, false, '生产环境无真实 OPENID 且未通过鉴权网关时必须拒绝');\n   315\tassert(famResultProd.error.includes('OPENID 缺失') || famResultProd.error.includes('有效身份'), '应提示 OPENID 缺失');\n   316\t\n   317\tconst mealResultProd = await upsertMealModule.main(fakeEvent, {});\n   318\tassert.equal(mealResultProd.success, false, 'upsertMeal 生产环境无 OPENID 必须直接拒绝');\n   319\t\n   320\tconst dishResultProd = await customDishModule.main(fakeEvent, {});\n   321\tassert.equal(dishResultProd.success, false, 'customDish 生产环境无 OPENID 必须直接拒绝');\n   322\t\n   323\tconst authResultProd = await userAuthModule.main(fakeEvent, {});\n   324\tassert.equal(authResultProd.success, false, 'userAuth 生产环境无 OPENID 必须直接拒绝');\n   325\t\n   326\t// 恢复环境变量\n   327\tprocess.env.NODE_ENV = originalNodeEnv;\n   328\tconsole.log('✅ 生产环境缺失 OPENID 鉴权凭据安全防线 100% 坚不可摧！\\n');\n   329\t\n   330\tconsole.log('===============================================================');\n   331\tconsole.log('🏆 所有 5 项严重问题修复与加固项专项深度回归测试 100% 通过！');\n   332\tconsole.log('===============================================================\\n');\n    18\t// -------------------------------------------------------------\n    19\t// 测试项 1: 全量 125 道菜品与 7 大类别默认图物理存在性与格式校验\n    20\t// -------------------------------------------------------------\n    21\tconsole.log('【阶段一】验证本地 125 道菜品出锅图与 7 大类别默认大图物理完整性');\n    22\tconst dishesDir = path.join(projectRoot, 'miniprogram', 'assets', 'dishes');\n    23\tassert(fs.existsSync(dishesDir), 'assets/dishes 目录必须存在');\n    24\t\n    25\tassert.equal(defaultDishes.length, 125, '菜库总数应为 125 道菜');\n    26\tfor (const dish of defaultDishes) {\n    27\t  assert(dish.thumbUrl, `菜品 [${dish.name}] (${dish.id}) 必须包含 thumbUrl`);\n    28\t  assert(dish.thumbUrl.endsWith('.jpg'), `菜品 [${dish.name}] thumbUrl 必须使用高兼容 .jpg 格式`);\n    29\t  \n    30\t  const relPath = dish.thumbUrl.replace(/^\\//, '');\n    31\t  const absPath = path.join(projectRoot, 'miniprogram', relPath);\n    32\t  assert(fs.existsSync(absPath), `菜品 [${dish.name}] 对应的本地物理文件不存在: ${absPath}`);\n    33\t  \n    34\t  const stat = fs.statSync(absPath);\n    35\t  assert(stat.size > 2000, `菜品 [${dish.name}] 图片体积异常过小 (${stat.size} bytes)`);\n    36\t\n    37\t  // 验证 JPEG 头部魔数 (FF D8 FF)\n    38\t  const buf = Buffer.alloc(3);\n    39\t  const fd = fs.openSync(absPath, 'r');\n    40\t  fs.readSync(fd, buf, 0, 3, 0);\n    41\t  fs.closeSync(fd);\n    42\t  assert.equal(buf.toString('hex'), 'ffd8ff', `菜品 [${dish.name}] 必须为有效 JPEG 图像 (Magic: ffd8ff)`);\n    43\t}\n    44\tconsole.log('✅ 全部 125 道菜品出锅图物理文件与 JPEG 文件头校验 100% 通过！');\n    45\t\n    46\tconst defaultKeys = ['main_meat', 'secondary_meat', 'vegetable', 'soup', 'egg', 'tofu', 'staple_sauce', 'default'];\n    47\tfor (const key of defaultKeys) {\n    48\t  const defaultPath = CATEGORY_DEFAULT_IMAGES[key];\n    49\t  assert(defaultPath, `类别 [${key}] 必须定义默认图片路径`);\n    50\t  const absPath = path.join(projectRoot, 'miniprogram', defaultPath.replace(/^\\//, ''));\n    51\t  assert(fs.existsSync(absPath), `类别 [${key}] 默认图片物理文件不存在: ${absPath}`);\n    52\t  assert(fs.statSync(absPath).size > 2000, `类别 [${key}] 默认图片体积过小`);\n    53\t}\n    54\tconsole.log('✅ 全部 7 大类别默认大图物理文件校验 100% 通过！\\n');\n    55\t\n    56\t// -------------------------------------------------------------\n    57\t// 测试项 2: 验证 miniprogram 目录下绝无任何残留 WebP 文件 (零超包隐患)\n    58\t// -------------------------------------------------------------\n    59\tconsole.log('【阶段二】验证 miniprogram 目录绝无 WebP 残留与严格体积预算');\n    60\tfunction findWebp(dir) {\n    61\t  const result = [];\n    62\t  for (const item of fs.readdirSync(dir)) {\n    63\t    const full = path.join(dir, item);\n    64\t    if (fs.statSync(full).isDirectory()) {\n    65\t      result.push(...findWebp(full));\n    66\t    } else if (item.endsWith('.webp')) {\n    67\t      result.push(full);\n    68\t    }\n    69\t  }\n    70\t  return result;\n    71\t}\n    72\tconst webpInMiniprogram = findWebp(path.join(projectRoot, 'miniprogram'));\n    73\tassert.equal(webpInMiniprogram.length, 0, `miniprogram 目录下不得残留任何 .webp 文件，实际发现: ${webpInMiniprogram.join(', ')}`);\n    74\tconsole.log('✅ miniprogram 源码树 0 残留 WebP 文件！');\n    75\t\n    76\t// 校验打包体积预算\n    77\tlet uploadPackBytes = 0;\n    78\tfunction calcPack(dir) {\n    79\t  for (const item of fs.readdirSync(dir)) {\n    80\t    const full = path.join(dir, item);\n    81\t    const rel = path.relative(path.join(projectRoot, 'miniprogram'), full);\n    82\t    if (fs.statSync(full).isDirectory()) {\n    83\t      calcPack(full);\n    84\t    } else {\n    85\t      if (item.endsWith('.ts') || item === '.DS_Store') continue;\n    86\t      if (rel === 'data/dishes.json' || rel === 'data/ingredients.json') continue;\n    87\t      uploadPackBytes += fs.statSync(full).size;\n    88\t    }\n    89\t  }\n    90\t}\n    91\tcalcPack(path.join(projectRoot, 'miniprogram'));\n    92\tconst uploadPackKB = (uploadPackBytes / 1024).toFixed(1);\n    93\tconsole.log(`📦 实际预估打包体积: ${uploadPackKB} KB (上限 2048 KB, 安全裕度 ${(2048 - uploadPackBytes / 1024).toFixed(1)} KB)`);\nminiprogram/services/imageService.js:10:    'https://cdn.jsdelivr.net/gh/pi-niuniu/three-dishes-and-soup@main/miniprogram',\nminiprogram/services/imageService.js:11:    'https://raw.githubusercontent.com/pi-niuniu/three-dishes-and-soup/main/miniprogram'\nminiprogram/services/imageService.js:103:        if (currentSrc.startsWith('http://') || currentSrc.startsWith('https://')) {\nminiprogram/services/historyService.js:235:                        const isTransientNetwork = lower.includes('request:fail') ||\n","exit_code":0,"status":"completed"}}
