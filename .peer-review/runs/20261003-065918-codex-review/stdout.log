{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba cloudfunctions/customDish/index.js; nl -ba cloudfunctions/userAuth/index.js; nl -ba miniprogram/services/historyService.ts'","aggregated_output":"     1\tconst cloud = require('wx-server-sdk');\n     2\t\n     3\tcloud.init({\n     4\t  env: cloud.DYNAMIC_CURRENT_ENV\n     5\t});\n     6\t\n     7\tconst db = cloud.database();\n     8\t\n     9\t// 预设分类生活美学图标与默认大图映射\n    10\tconst CATEGORY_DEFAULT_CONFIG = {\n    11\t  main_meat: { icon: '🥩', theme: 'theme_main_meat', thumb: '/assets/dishes/default_main.jpg' },\n    12\t  secondary_meat: { icon: '🥘', theme: 'theme_secondary_meat', thumb: '/assets/dishes/default_secondary.jpg' },\n    13\t  egg: { icon: '🍳', theme: 'theme_egg', thumb: '/assets/dishes/default_egg.jpg' },\n    14\t  tofu: { icon: '🧊', theme: 'theme_tofu', thumb: '/assets/dishes/default_tofu.jpg' },\n    15\t  vegetable: { icon: '🥬', theme: 'theme_vegetable', thumb: '/assets/dishes/default_vegetable.jpg' },\n    16\t  soup: { icon: '🍲', theme: 'theme_soup', thumb: '/assets/dishes/default_soup.jpg' },\n    17\t  staple_sauce: { icon: '🍚', theme: 'theme_staple_sauce', thumb: '/assets/dishes/default_dish.jpg' },\n    18\t  default: { icon: '🍽️', theme: 'theme_default', thumb: '/assets/dishes/default_dish.jpg' }\n    19\t};\n    20\t\n    21\t// 根据菜名特征智能匹配生动 Emoji\n    22\tfunction matchEmoji(name, category) {\n    23\t  if (!name) return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n    24\t  if (name.includes('土豆')) return '🥔';\n    25\t  if (name.includes('番茄') || name.includes('西红柿')) return '🍅';\n    26\t  if (name.includes('虾')) return '🦐';\n    27\t  if (name.includes('鱼')) return '🐟';\n    28\t  if (name.includes('鸡') || name.includes('鸭')) return '🍗';\n    29\t  if (name.includes('牛') || name.includes('羊') || name.includes('排骨') || name.includes('肉')) return '🥩';\n    30\t  if (name.includes('蛋')) return '🍳';\n    31\t  if (name.includes('豆腐')) return '🧊';\n    32\t  if (name.includes('蘑菇') || name.includes('菌') || name.includes('菇')) return '🍄';\n    33\t  if (name.includes('茄子')) return '🍆';\n    34\t  if (name.includes('玉米')) return '🌽';\n    35\t  if (name.includes('面') || name.includes('粉')) return '🍜';\n    36\t  if (name.includes('饭')) return '🍚';\n    37\t  if (name.includes('饺') || name.includes('抄手')) return '🥟';\n    38\t  if (name.includes('汤')) return '🍲';\n    39\t  if (name.includes('菜') || name.includes('笋') || name.includes('瓜')) return '🥬';\n    40\t  return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n    41\t}\n    42\t\n    43\texports.main = async (event, context) => {\n    44\t  const wxContext = cloud.getWXContext();\n    45\t  let openid = wxContext && wxContext.OPENID;\n    46\t\n    47\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n    48\t  if (!openid) {\n    49\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n    50\t      openid = event.mockOpenid || 'mock_openid_default';\n    51\t    } else {\n    52\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    53\t    }\n    54\t  }\n    55\t\n    56\t  const { action = 'addDish' } = event;\n    57\t  const now = Date.now();\n    58\t\n    59\t  try {\n    60\t    switch (action) {\n    61\t      /**\n    62\t       * 1. 录入纯文字私房菜 (强制文本安全检查，禁止图片上传)\n    63\t       */\n    64\t      case 'addDish': {\n    65\t        const name = String(event.name || '').trim();\n    66\t        if (!name) {\n    67\t          return { success: false, error: '菜品名称不能为空' };\n    68\t        }\n    69\t        if (name.length > 20) {\n    70\t          return { success: false, error: '菜品名称不能超过20个字' };\n    71\t        }\n    72\t\n    73\t        const category = event.category || 'secondary_meat';\n    74\t        const taste = Array.isArray(event.taste) ? event.taste : (event.taste ? [event.taste] : ['家常']);\n    75\t        const cookingTimeMinutes = Number(event.cookingTimeMinutes) || 25;\n    76\t        const ingredients = Array.isArray(event.ingredients) ? event.ingredients : [];\n    77\t\n    78\t        // 文本合规检验：结合菜名、口味与食材\n    79\t        const checkContent = `${name} ${taste.join(' ')} ${ingredients.join(' ')}`;\n    80\t\n    81\t        // 1. 本地/弱网兜底敏感词检测 (易错点 7 防线)\n    82\t        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n    83\t        if (sensitiveWords.some(w => name.includes(w) || checkContent.includes(w))) {\n    84\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n    85\t        }\n    86\t\n    87\t        // 2. 升级微信官方文本合规检测 msgSecCheck 2.0 规范\n    88\t        if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    89\t          try {\n    90\t            const secRes = await cloud.openapi.security.msgSecCheck({\n    91\t              version: 2,\n    92\t              scene: 1, // 资料类\n    93\t              openid,\n    94\t              content: checkContent\n    95\t            });\n    96\t            if (!secRes || !secRes.result || secRes.result.suggest !== 'pass') {\n    97\t              return { success: false, error: '菜品名称或描述包含敏感内容，请修改后重试' };\n    98\t            }\n    99\t          } catch (secErr) {\n   100\t            console.error('微信 msgSecCheck 检测异常:', secErr);\n   101\t            // 真实生产环境若检测接口异常也坚决拦截入库\n   102\t            return { success: false, error: '内容安全检测未通过或服务暂时不可用，请稍后重试' };\n   103\t          }\n   104\t        }\n   105\t\n   106\t        // 桶隔离：未加入家庭的私房菜使用 personal_${openid}，禁止所有单人用户共用 'personal' 桶\n   107\t        const rawFamilyId = event.familyId;\n   108\t        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n   109\t        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n   110\t\n   111\t        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n   112\t        if (!isPersonal) {\n   113\t          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n   114\t          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n   115\t            return { success: false, error: '越权操作：您不属于该家庭空间' };\n   116\t          }\n   117\t        }\n   118\t\n   119\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n   120\t        const cfg = CATEGORY_DEFAULT_CONFIG[category] || CATEGORY_DEFAULT_CONFIG.default;\n   121\t        const emoji = matchEmoji(name, category);\n   122\t\n   123\t        const newDish = {\n   124\t          _id: dishId,\n   125\t          id: dishId,\n   126\t          familyId,\n   127\t          creatorOpenid: openid,\n   128\t          creatorName: event.creatorName || event.nickName || '家人',\n   129\t          name,\n   130\t          category,\n   131\t          taste,\n   132\t          cookingTimeMinutes,\n   133\t          defaultIcon: emoji,\n   134\t          defaultTheme: cfg.theme,\n   135\t          thumbUrl: cfg.thumb,\n   136\t          ingredients, // 空食材保留空数组，严禁无中生有\n   137\t          enabled: true,\n   138\t          isCustom: true,\n   139\t          createdAt: now\n   140\t        };\n   141\t\n   142\t        await db.collection('custom_dishes').add({ data: newDish });\n   143\t\n   144\t        return {\n   145\t          success: true,\n   146\t          dish: newDish\n   147\t        };\n   148\t      }\n   149\t\n   150\t      /**\n   151\t       * 2. 查询家庭私房菜列表\n   152\t       */\n   153\t      case 'getDishes': {\n   154\t        const rawFamilyId = event.familyId;\n   155\t        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n   156\t        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n   157\t\n   158\t        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n   159\t        if (!isPersonal) {\n   160\t          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n   161\t          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n   162\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n   163\t          }\n   164\t        }\n   165\t\n   166\t        const res = await db.collection('custom_dishes')\n   167\t          .where({\n   168\t            familyId,\n   169\t            enabled: true\n   170\t          })\n   171\t          .orderBy('createdAt', 'desc')\n   172\t          .get();\n   173\t\n   174\t        return {\n   175\t          success: true,\n   176\t          dishes: res.data || []\n   177\t        };\n   178\t      }\n   179\t\n   180\t      default:\n   181\t        return { success: false, error: `不支持的操作类型: ${action}` };\n   182\t    }\n   183\t  } catch (err) {\n   184\t    return {\n   185\t      success: false,\n   186\t      error: err.message || '自选私房菜操作失败'\n   187\t    };\n   188\t  }\n   189\t};\n     1\tconst cloud = require('wx-server-sdk');\n     2\t\n     3\tcloud.init({\n     4\t  env: cloud.DYNAMIC_CURRENT_ENV\n     5\t});\n     6\t\n     7\tconst db = cloud.database();\n     8\t\n     9\t/**\n    10\t * userAuth 云函数：用户静默鉴权与档案获取\n    11\t */\n    12\texports.main = async (event, context) => {\n    13\t  const wxContext = cloud.getWXContext();\n    14\t  let openid = wxContext && wxContext.OPENID;\n    15\t\n    16\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n    17\t  if (!openid) {\n    18\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n    19\t      openid = event.mockOpenid || 'mock_openid_default';\n    20\t    } else {\n    21\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    22\t    }\n    23\t  }\n    24\t\n    25\t  const now = Date.now();\n    26\t\n    27\t  try {\n    28\t    const userDocRef = db.collection('users').doc(`user_${openid}`);\n    29\t    let user = null;\n    30\t\n    31\t    try {\n    32\t      const res = await userDocRef.get();\n    33\t      user = res.data;\n    34\t    } catch (e) {\n    35\t      // 用户首次访问，自动创建档案\n    36\t      const newUser = {\n    37\t        _id: `user_${openid}`,\n    38\t        _openid: openid,\n    39\t        nickName: event.nickName || '家人',\n    40\t        avatarUrl: event.avatarUrl || '',\n    41\t        familyId: null,\n    42\t        role: null,\n    43\t        createdAt: now,\n    44\t        updatedAt: now\n    45\t      };\n    46\t      await db.collection('users').add({ data: newUser });\n    47\t      user = newUser;\n    48\t    }\n    49\t\n    50\t    // 更新昵称/头像\n    51\t    if (event.nickName || event.avatarUrl) {\n    52\t      const updateData = { updatedAt: now };\n    53\t      if (event.nickName) updateData.nickName = event.nickName;\n    54\t      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n    55\t      await userDocRef.update({ data: updateData });\n    56\t      user = { ...user, ...updateData };\n    57\t    }\n    58\t\n    59\t    // 若绑定了家庭，获取家庭最新信息\n    60\t    let family = null;\n    61\t    if (user.familyId) {\n    62\t      try {\n    63\t        const famRes = await db.collection('families').doc(user.familyId).get();\n    64\t        family = famRes.data;\n    65\t      } catch (err) {\n    66\t        console.warn('获取用户所属家庭失败或家庭已解散', err);\n    67\t        // 如果家庭已被解散，重置用户的 familyId\n    68\t        await userDocRef.update({\n    69\t          data: { familyId: null, role: null, updatedAt: now }\n    70\t        });\n    71\t        user.familyId = null;\n    72\t        user.role = null;\n    73\t      }\n    74\t    }\n    75\t\n    76\t    return {\n    77\t      success: true,\n    78\t      openid,\n    79\t      user,\n    80\t      family\n    81\t    };\n    82\t  } catch (err) {\n    83\t    return {\n    84\t      success: false,\n    85\t      error: err.message || '用户鉴权失败'\n    86\t    };\n    87\t  }\n    88\t};\n     1\timport type { MealHistoryRecord, MealMode } from '../types/user.js';\n     2\timport type { Dish } from '../types/dish.js';\n     3\timport { familyService } from './familyService.js';\n     4\timport { cloudService } from './cloudService.js';\n     5\t\n     6\tconst STORAGE_KEY = 'meal_history_records';\n     7\tconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n     8\t\n     9\tinterface PendingSyncItem {\n    10\t  targetFamilyId: string;\n    11\t  authorOpenid: string;\n    12\t  record: MealHistoryRecord;\n    13\t}\n    14\t\n    15\ttype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n    16\t\n    17\tclass HistoryService {\n    18\t  private memoryHistory: MealHistoryRecord[] = [];\n    19\t  private pendingQueue: PendingSyncItem[] = [];\n    20\t  private listeners: Set<HistoryChangeListener> = new Set();\n    21\t  private isSyncing = false;\n    22\t  private syncPromise: Promise<void> | null = null;\n    23\t\n    24\t  constructor() {\n    25\t    this.restoreFromStorage();\n    26\t    this.initNetworkListener();\n    27\t  }\n    28\t\n    29\t  /**\n    30\t   * 监听网络状态变化：当连网时自动静默上报离线待同步队列\n    31\t   */\n    32\t  private initNetworkListener() {\n    33\t    if (typeof wx !== 'undefined' && typeof wx.onNetworkStatusChange === 'function') {\n    34\t      wx.onNetworkStatusChange((res: { isConnected: boolean; networkType: string }) => {\n    35\t        if (res && res.isConnected) {\n    36\t          console.log('[HistoryService] 网络连接已恢复，自动触发待同步离线队列上报...');\n    37\t          this.flushPendingQueue().catch(err => {\n    38\t            console.warn('[HistoryService] 连网自动上报待同步队列异常:', err);\n    39\t          });\n    40\t        }\n    41\t      });\n    42\t    }\n    43\t  }\n    44\t\n    45\t  private restoreFromStorage() {\n    46\t    try {\n    47\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    48\t        const stored = wx.getStorageSync(STORAGE_KEY);\n    49\t        if (stored && Array.isArray(stored)) {\n    50\t          this.memoryHistory = stored;\n    51\t        }\n    52\t        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n    53\t        if (queued && Array.isArray(queued)) {\n    54\t          this.pendingQueue = queued;\n    55\t        }\n    56\t      }\n    57\t    } catch (e) {\n    58\t      console.warn('读取本地历史失败，使用内存降级', e);\n    59\t    }\n    60\t  }\n    61\t\n    62\t  /**\n    63\t   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n    64\t   */\n    65\t  public subscribe(listener: HistoryChangeListener): () => void {\n    66\t    this.listeners.add(listener);\n    67\t    return () => this.listeners.delete(listener);\n    68\t  }\n    69\t\n    70\t  private notifyListeners(): void {\n    71\t    const list = this.getHistory();\n    72\t    for (const listener of this.listeners) {\n    73\t      try {\n    74\t        listener(list);\n    75\t      } catch (err) {\n    76\t        console.error('历史状态订阅回调异常', err);\n    77\t      }\n    78\t    }\n    79\t  }\n    80\t\n    81\t  /**\n    82\t   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n    83\t   */\n    84\t  public getHistory(): MealHistoryRecord[] {\n    85\t    try {\n    86\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    87\t        const stored = wx.getStorageSync(STORAGE_KEY);\n    88\t        if (stored && Array.isArray(stored)) {\n    89\t          return stored;\n    90\t        }\n    91\t      }\n    92\t    } catch (e) {\n    93\t      console.warn('读取本地历史失败，使用内存降级', e);\n    94\t    }\n    95\t    return this.memoryHistory;\n    96\t  }\n    97\t\n    98\t  /**\n    99\t   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n   100\t   */\n   101\t  public deduceMealType(dateObj = new Date()): string {\n   102\t    const hour = dateObj.getHours();\n   103\t    if (hour >= 5 && hour < 10) return '早餐';\n   104\t    if (hour >= 10 && hour < 15) return '午餐';\n   105\t    if (hour >= 15 && hour < 21) return '晚餐';\n   106\t    return '加餐';\n   107\t  }\n   108\t\n   109\t  /**\n   110\t   * 确认开饭：将菜单正式写入就餐历史\n   111\t   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n   112\t   */\n   113\t  public recordMeal(\n   114\t    mode: MealMode,\n   115\t    dishes: Dish[],\n   116\t    dateStr?: string,\n   117\t    menuId?: string,\n   118\t    mealType?: string\n   119\t  ): MealHistoryRecord {\n   120\t    const history = this.getHistory();\n   121\t    const now = new Date();\n   122\t    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n   123\t    const targetDate = dateStr || localDate;\n   124\t    const resolvedMealType = mealType || this.deduceMealType(now);\n   125\t    const randSuffix = Math.random().toString(36).slice(2, 6);\n   126\t    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n   127\t\n   128\t    const currentUser = familyService.getCurrentUser();\n   129\t    const currentFamily = familyService.getCurrentFamily();\n   130\t    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n   131\t\n   132\t    const newRecord: MealHistoryRecord = {\n   133\t      id: mealId,\n   134\t      menuId,\n   135\t      mealId,\n   136\t      date: targetDate,\n   137\t      timestamp: now.getTime(),\n   138\t      mode,\n   139\t      mealType: resolvedMealType,\n   140\t      dishIds: dishes.map(d => d.id),\n   141\t      dishNames: dishes.map(d => d.name),\n   142\t      dishes: dishes.map(d => ({\n   143\t        id: d.id,\n   144\t        name: d.name,\n   145\t        category: d.category,\n   146\t        thumbUrl: d.thumbUrl,\n   147\t        dishEmoji: d.dishEmoji,\n   148\t        isCustom: (d as any).isCustom\n   149\t      })),\n   150\t      confirmedBy: currentUser.openid,\n   151\t      confirmedByName: currentUser.nickName || '家人',\n   152\t      familyId,\n   153\t      syncStatus: familyId ? 'pending' : 'synced'\n   154\t    };\n   155\t\n   156\t    // 智能去重判断：\n   157\t    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n   158\t    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n   159\t    const existingIndex = history.findIndex(r =>\n   160\t      r.id === mealId ||\n   161\t      (Boolean(menuId) && r.menuId === menuId) ||\n   162\t      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n   163\t    );\n   164\t\n   165\t    let updated: MealHistoryRecord[];\n   166\t    if (existingIndex >= 0) {\n   167\t      updated = [...history];\n   168\t      updated[existingIndex] = newRecord;\n   169\t    } else {\n   170\t      updated = [newRecord, ...history].slice(0, 60);\n   171\t    }\n   172\t\n   173\t    this.saveHistory(updated);\n   174\t\n   175\t    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n   176\t    if (familyId) {\n   177\t      this.enqueuePendingSync({\n   178\t        targetFamilyId: familyId,\n   179\t        authorOpenid: currentUser.openid,\n   180\t        record: newRecord\n   181\t      });\n   182\t      // 触发后台静默同步\n   183\t      this.flushPendingQueue().catch(() => {});\n   184\t    }\n   185\t\n   186\t    return newRecord;\n   187\t  }\n   188\t\n   189\t  /**\n   190\t   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n   191\t   */\n   192\t  private enqueuePendingSync(item: PendingSyncItem) {\n   193\t    this.pendingQueue.push(item);\n   194\t    this.savePendingQueue();\n   195\t  }\n   196\t\n   197\t  private savePendingQueue() {\n   198\t    try {\n   199\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n   200\t        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n   201\t      }\n   202\t    } catch (e) {}\n   203\t  }\n   204\t\n   205\t  /**\n   206\t   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n   207\t   */\n   208\t  public async flushPendingQueue(): Promise<void> {\n   209\t    if (this.syncPromise) {\n   210\t      return this.syncPromise;\n   211\t    }\n   212\t    if (this.pendingQueue.length === 0) return;\n   213\t    this.isSyncing = true;\n   214\t\n   215\t    this.syncPromise = (async () => {\n   216\t      try {\n   217\t        while (this.pendingQueue.length > 0) {\n   218\t          const item = this.pendingQueue[0];\n   219\t          const currentFamily = familyService.getCurrentFamily();\n   220\t          const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n   221\t\n   222\t          // 关键防御：如果当前明确处于另一不同家庭，判定为跨家庭废弃记录，安全出队丢弃，绝不上报！\n   223\t          if (currentFamilyId && currentFamilyId !== item.targetFamilyId) {\n   224\t            console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n   225\t            this.pendingQueue.shift();\n   226\t            this.savePendingQueue();\n   227\t            continue;\n   228\t          }\n   229\t\n   230\t          // 若当前家庭信息尚未加载就绪，暂缓上报，保留在队列中等待家庭就绪\n   231\t          if (!currentFamilyId) {\n   232\t            break;\n   233\t          }\n   234\t\n   235\t          const res = await cloudService.callFunction('upsertMeal', {\n   236\t            action: 'upsertMeal',\n   237\t            familyId: item.targetFamilyId,\n   238\t            date: item.record.date,\n   239\t            mockOpenid: item.authorOpenid,\n   240\t            meal: {\n   241\t              mealId: item.record.mealId || item.record.id,\n   242\t              mealType: item.record.mealType,\n   243\t              mode: item.record.mode,\n   244\t              dishes: item.record.dishes,\n   245\t              dishIds: item.record.dishIds,\n   246\t              dishNames: item.record.dishNames,\n   247\t              confirmedByName: item.record.confirmedByName,\n   248\t              timestamp: item.record.timestamp\n   249\t            }\n   250\t          });\n   251\t\n   252\t          if (res.success) {\n   253\t            // 标记本地记录为已同步并从队列出队\n   254\t            this.pendingQueue.shift();\n   255\t            this.savePendingQueue();\n   256\t\n   257\t            const history = this.getHistory();\n   258\t            const target = history.find(r =>\n   259\t              r.id === item.record.id ||\n   260\t              (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n   261\t              (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n   262\t            );\n   263\t            if (target) {\n   264\t              target.syncStatus = 'synced';\n   265\t              this.saveHistory([...history]);\n   266\t              this.notifyListeners();\n   267\t            }\n   268\t          } else {\n   269\t            const errorMsg = res.error || '';\n   270\t            const lower = errorMsg.toLowerCase();\n   271\t            const isTransientNetwork =\n   272\t              lower.includes('request:fail') ||\n   273\t              lower.includes('timeout') ||\n   274\t              lower.includes('offline') ||\n   275\t              lower.includes('network') ||\n   276\t              lower.includes('fail connect') ||\n   277\t              lower.includes('socket closed') ||\n   278\t              lower.includes('econnaborted') ||\n   279\t              lower.includes('econnreset') ||\n   280\t              lower.includes('etimedout');\n   281\t\n   282\t            const isExplicitRejection =\n   283\t              lower.includes('越权') ||\n   284\t              lower.includes('不属于') ||\n   285\t              lower.includes('无权') ||\n   286\t              lower.includes('权限') ||\n   287\t              lower.includes('缺少') ||\n   288\t              lower.includes('参数') ||\n   289\t              lower.includes('非法') ||\n   290\t              lower.includes('openid') ||\n   291\t              lower.includes('身份凭据') ||\n   292\t              lower.includes('不支持') ||\n   293\t              lower.includes('敏感') ||\n   294\t              lower.includes('违规') ||\n   295\t              lower.includes('合规') ||\n   296\t              lower.includes('家庭不存在') ||\n   297\t              lower.includes('不存在') ||\n   298\t              lower.includes('未找到') ||\n   299\t              lower.includes('已满') ||\n   300\t              lower.includes('上限') ||\n   301\t              lower.includes('锁定') ||\n   302\t              lower.includes('防刷') ||\n   303\t              lower.includes('防暴力枚举') ||\n   304\t              lower.includes('已失效') ||\n   305\t              lower.includes('过期') ||\n   306\t              lower.includes('cannot update _id') ||\n   307\t              lower.includes('errcode');\n   308\t\n   309\t            if (!isTransientNetwork && isExplicitRejection) {\n   310\t              // 服务端业务明确拒绝错误（越权、参数非法等）：直接出队并标记为 failed，避免死循环重试\n   311\t              console.warn(`[HistoryService] 离线同步记录 ${item.record.id} 遭服务端明确拒绝，已出队并标记为 failed: ${errorMsg}`);\n   312\t              this.pendingQueue.shift();\n   313\t              this.savePendingQueue();\n   314\t\n   315\t              const history = this.getHistory();\n   316\t              const target = history.find(r =>\n   317\t                r.id === item.record.id ||\n   318\t                (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n   319\t                (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n   320\t              );\n   321\t              if (target) {\n   322\t                target.syncStatus = 'failed';\n   323\t                this.saveHistory([...history]);\n   324\t                this.notifyListeners();\n   325\t              }\n   326\t            } else {\n   327\t              // 提交失败（网络或瞬时异常），保留在队列头部中断当前轮次等待下次重试\n   328\t              break;\n   329\t            }\n   330\t          }\n   331\t        }\n   332\t      } finally {\n   333\t        this.isSyncing = false;\n   334\t        this.syncPromise = null;\n   335\t      }\n   336\t    })();\n   337\t\n   338\t    return this.syncPromise;\n   339\t  }\n   340\t\n   341\t  /**\n   342\t   * SWR 增量拉取家庭共享历史并合并到本地\n   343\t   */\n   344\t  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n   345\t    const currentFamily = familyService.getCurrentFamily();\n   346\t    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n   347\t    if (!familyId) {\n   348\t      return this.getHistory();\n   349\t    }\n   350\t\n   351\t    // 先刷新离线待上报队列\n   352\t    await this.flushPendingQueue();\n   353\t\n   354\t    const currentUser = familyService.getCurrentUser();\n   355\t    const res = await cloudService.callFunction('upsertMeal', {\n   356\t      action: 'getHistory',\n   357\t      familyId,\n   358\t      mockOpenid: currentUser.openid,\n   359\t      limitDays: 60\n   360\t    });\n   361\t\n   362\t    if (res.success && Array.isArray(res.records)) {\n   363\t      const cloudRecords: MealHistoryRecord[] = res.records;\n   364\t      const localRecords = this.getHistory();\n   365\t\n   366\t      // 双向合并：以餐次 mealId 为唯一标识\n   367\t      const recordMap = new Map<string, MealHistoryRecord>();\n   368\t\n   369\t      // 先放入云端记录\n   370\t      for (const cr of cloudRecords) {\n   371\t        const key = cr.mealId || cr.id;\n   372\t        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n   373\t      }\n   374\t\n   375\t      // 再放入本地未同步或更新的属于当前家庭的记录\n   376\t      for (const lr of localRecords) {\n   377\t        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n   378\t        if (lr.familyId && lr.familyId !== familyId) {\n   379\t          continue;\n   380\t        }\n   381\t        const key = lr.mealId || lr.id;\n   382\t        if (!recordMap.has(key)) {\n   383\t          recordMap.set(key, lr);\n   384\t        } else {\n   385\t          // 如果本地是 pending，优先以本地为准\n   386\t          if (lr.syncStatus === 'pending') {\n   387\t            recordMap.set(key, lr);\n   388\t          }\n   389\t        }\n   390\t      }\n   391\t\n   392\t      const merged = Array.from(recordMap.values());\n   393\t      merged.sort((a, b) => b.timestamp - a.timestamp);\n   394\t      const finalRecords = merged.slice(0, 60);\n   395\t\n   396\t      this.saveHistory(finalRecords);\n   397\t      this.notifyListeners();\n   398\t      return finalRecords;\n   399\t    }\n   400\t\n   401\t    return this.getHistory();\n   402\t  }\n   403\t\n   404\t  /**\n   405\t   * 清空或重置历史 (用于测试或用户重置)\n   406\t   */\n   407\t  public clearHistory(): void {\n   408\t    this.pendingQueue = [];\n   409\t    this.savePendingQueue();\n   410\t    this.saveHistory([]);\n   411\t    this.notifyListeners();\n   412\t  }\n   413\t\n   414\t  private saveHistory(records: MealHistoryRecord[]): void {\n   415\t    this.memoryHistory = records;\n   416\t    try {\n   417\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n   418\t        wx.setStorageSync(STORAGE_KEY, records);\n   419\t      }\n   420\t    } catch (e) {\n   421\t      console.warn('保存本地历史失败', e);\n   422\t    }\n   423\t  }\n   424\t}\n   425\t\n   426\texport const historyService = new HistoryService();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"wc -l test/*.mjs miniprogram/services/dataProvider.ts miniprogram/services/menuRecommendation.ts miniprogram/pages/{history,mine,dishes/custom-add}/index.ts; sed -n '1,110p' test/e2e_full_lifecycle_test.mjs; sed -n '1,90p' test/family_sharing_custom_dishes_test.mjs; sed -n '1,85p' test/security_hardening_audit_test.mjs; sed -n '1,90p' test/final_security_hardening_test.mjs; sed -n '1,105p' test/pages_runtime_test.mjs; cat cloudfunctions/*/package.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"wc -l test/*.mjs miniprogram/services/dataProvider.ts miniprogram/services/menuRecommendation.ts miniprogram/pages/{history,mine,dishes/custom-add}/index.ts; sed -n '1,110p' test/e2e_full_lifecycle_test.mjs; sed -n '1,90p' test/family_sharing_custom_dishes_test.mjs; sed -n '1,85p' test/security_hardening_audit_test.mjs; sed -n '1,90p' test/final_security_hardening_test.mjs; sed -n '1,105p' test/pages_runtime_test.mjs; cat cloudfunctions/*/package.json\"","aggregated_output":"     638 test/e2e_family_custom_full_flow_test.mjs\n     508 test/e2e_full_lifecycle_test.mjs\n     399 test/family_sharing_custom_dishes_test.mjs\n     260 test/final_security_hardening_test.mjs\n     175 test/image_resilience_test.mjs\n     197 test/pages_runtime_test.mjs\n     297 test/recommendation_test.mjs\n     332 test/security_hardening_audit_test.mjs\n     278 miniprogram/services/dataProvider.ts\n     517 miniprogram/services/menuRecommendation.ts\n     112 miniprogram/pages/history/index.ts\n     232 miniprogram/pages/mine/index.ts\n     112 miniprogram/pages/dishes/custom-add/index.ts\n    4057 total\n/**\n * 《四季三餐 · 好好吃饭》全链路真实端到端 (End-to-End) 自动化测试\n * \n * 模拟完整的微信小程序运行环境与多用户/大厨协同生命周期：\n * 1. 用户首页启动与明日菜单智能搭配 (pages/index)\n * 2. 菜单结果页查看、单菜锁定、换菜防乒乓与自选私房菜 (pages/menu/result)\n * 3. 交付中心双视图切换、双独立备注输入与微信安全分享序列化 (pages/menu/shopping)\n * 4. 大厨端微信卡片免密秒开还原、置顶交代、菜场打勾持久化与开工激励 (pages/cook/view)\n * 5. 就餐历史记录闭环与次日动态避重检验 (pages/history)\n */\n\nimport assert from 'assert';\nimport fs from 'fs';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\nconst rootDir = path.resolve(__dirname, '..');\n\n// 1. 模拟微信小程序全局底层运行时 (Mock Wechat Runtime)\nclass MockWechatRuntime {\n  constructor() {\n    this.storage = new Map();\n    this.clipboardData = '';\n    this.vibrateCount = 0;\n    this.navigationHistory = [];\n    this.toastHistory = [];\n    this.modalHistory = [];\n    this.loading = false;\n  }\n\n  getStorageSync(key) {\n    return this.storage.get(key);\n  }\n\n  setStorageSync(key, value) {\n    this.storage.set(key, JSON.parse(JSON.stringify(value)));\n  }\n\n  removeStorageSync(key) {\n    this.storage.delete(key);\n  }\n\n  clearStorageSync() {\n    this.storage.clear();\n  }\n\n  setClipboardData({ data, success }) {\n    this.clipboardData = data;\n    if (success) success({ errMsg: 'setClipboardData:ok' });\n  }\n\n  vibrateShort({ type } = {}) {\n    this.vibrateCount++;\n  }\n\n  navigateTo({ url }) {\n    this.navigationHistory.push(url);\n  }\n\n  showToast({ title, icon }) {\n    this.toastHistory.push({ title, icon });\n  }\n\n  showModal({ title, content, success }) {\n    this.modalHistory.push({ title, content });\n    if (success) success({ confirm: true, cancel: false });\n  }\n\n  showLoading({ title }) {\n    this.loading = true;\n  }\n\n  hideLoading() {\n    this.loading = false;\n  }\n}\n\nconst mockWx = new MockWechatRuntime();\nglobal.wx = mockWx;\n\nconst appInstance = {\n  globalData: {\n    currentMenu: null\n  }\n};\nglobal.getApp = () => appInstance;\n\n// 动态载入编译后的原生 JS 业务服务与数据\nimport { dataProvider } from '../miniprogram/services/dataProvider.js';\nimport { preferenceService } from '../miniprogram/services/preferenceService.js';\nimport { historyService } from '../miniprogram/services/historyService.js';\nimport { menuRecommendationEngine } from '../miniprogram/services/menuRecommendation.js';\nimport { shoppingListService } from '../miniprogram/services/shoppingListService.js';\n\ndataProvider.init();\n\nconsole.log('\\n===============================================================');\nconsole.log('🚀 《四季三餐 · 好好吃饭》端到端 (E2E) 全生命周期自动化测试');\nconsole.log('===============================================================\\n');\n\n// ==========================================\n// 阶段一：用户打开首页排餐 (pages/index E2E)\n// ==========================================\nconsole.log('【阶段一】测试首页启动与明日菜单智能搭配 (pages/index)');\n\n// 模拟 pages/index 页面生命周期\nconst indexPage = {\n  data: {\n/**\n * 《四季三餐·好好吃饭》4人家庭绑定、共享做菜历史与纯文字私房菜全链路深度自动化测试\n * 覆盖 7 大高危易错点防范与 5 大核心实施里程碑\n */\nimport assert from 'assert/strict';\n\n// 1. 模拟微信小程序原生环境\nconst storage = new Map();\nlet registeredPages = {};\n\nglobal.wx = {\n  getStorageSync: (key) => storage.get(key) || null,\n  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n  removeStorageSync: (key) => storage.delete(key),\n  clearStorageSync: () => storage.clear(),\n  showLoading: () => {},\n  hideLoading: () => {},\n  showToast: () => {},\n  showModal: ({ success }) => success && success({ confirm: true }),\n  vibrateShort: () => {},\n  setClipboardData: ({ success }) => success && success({ errMsg: 'setClipboardData:ok' }),\n  navigateTo: () => {},\n  navigateBack: () => {}\n};\n\nconst appInstance = {\n  globalData: {\n    currentMenu: null,\n    version: '2.05'\n  }\n};\nglobal.getApp = () => appInstance;\nglobal.App = (options) => {\n  if (options.onLaunch) options.onLaunch();\n};\n\nlet currentPageName = '';\nglobal.Page = (options) => {\n  registeredPages[currentPageName] = options;\n};\n\n// 导入核心服务\nimport { cloudService } from '../miniprogram/services/cloudService.js';\nimport { familyService } from '../miniprogram/services/familyService.js';\nimport { historyService } from '../miniprogram/services/historyService.js';\nimport { dataProvider, hydrateCustomDish } from '../miniprogram/services/dataProvider.js';\nimport { menuRecommendationEngine } from '../miniprogram/services/menuRecommendation.js';\nimport { preferenceService } from '../miniprogram/services/preferenceService.js';\n\nconsole.log('===============================================================');\nconsole.log('🚀 启动《四季三餐》4人家庭绑定、共享历史与纯文字私房菜深度测试');\nconsole.log('===============================================================\\n');\n\n// -------------------------------------------------------------\n// 【模块一】4人家庭绑定与云端事务控制 (防超4人 / 24h口令 / 一人一家庭)\n// -------------------------------------------------------------\nconsole.log('【阶段一】测试 4 人家庭空间事务控制与并发防超员');\n\n// 重置环境\ncloudService.getMockDb().clearAll();\nstorage.clear();\n\n// 1. 房主 User A 创建家庭\nfamilyService.setMockCurrentUser('openid_user_a', '爸爸(大厨)');\nconst createRes = await familyService.createFamily('温馨四口之家');\nassert(createRes.success, '房主创建家庭必须成功');\nassert.equal(createRes.family.members.length, 1, '创建后成员数应为 1');\nassert.equal(createRes.family.memberOpenids.length, 1);\nassert.equal(createRes.family.members[0].role, 'creator');\nassert.equal(createRes.family.name, '温馨四口之家');\nconst inviteCode = createRes.family.inviteCode;\nassert(inviteCode && inviteCode.length === 6, '必须生成 6 位数字邀请码');\nconsole.log(`✅ 房主 User A 成功创建家庭【${createRes.family.name}】，动态邀请码: ${inviteCode}`);\n\n// 2. User B 加入\nfamilyService.setMockCurrentUser('openid_user_b', '妈妈');\nconst joinB = await familyService.joinFamily(inviteCode);\nassert(joinB.success, 'User B 加入家庭必须成功');\nassert.equal(joinB.family.members.length, 2, '成员数应增至 2 人');\n\n// 3. User C 加入\nfamilyService.setMockCurrentUser('openid_user_c', '大宝');\nconst joinC = await familyService.joinFamily(inviteCode);\nassert(joinC.success, 'User C 加入家庭必须成功');\nassert.equal(joinC.family.members.length, 3, '成员数应增至 3 人');\n\n// 4. User D 加入 (满员 4 人)\nfamilyService.setMockCurrentUser('openid_user_d', '二宝');\nconst joinD = await familyService.joinFamily(inviteCode);\nassert(joinD.success, 'User D 加入家庭必须成功');\n/**\n * 针对用户批准的 5 项严重缺陷及加固项的专项深度审计与自动化回归测试\n * \n * 1. 网络错误降级防“假成功”测试\n * 2. 事务回滚防继续执行与防脏写测试\n * 3. 服务端越权与成员鉴权漏洞防范测试\n * 4. 个人菜桶 personal_${openid} 隔离防泄露测试\n * 5. 微信安全检测与 config.json 声明核验\n * 6. 退出家庭原子事务与并发防竞态测试\n * 7. 动态口令唯一性与过期校验测试\n * 8. 连网状态监听 wx.onNetworkStatusChange 自动排空测试\n * 9. 生产环境缺失 OPENID 坚决拒绝伪造测试\n */\n\nimport assert from 'assert/strict';\nimport fs from 'fs';\nimport path from 'path';\n\nconsole.log('===============================================================');\nconsole.log('🛡️ 启动 5 项严重缺陷及加固项专项深度回归与攻防渗透测试');\nconsole.log('===============================================================\\n');\n\n// -------------------------------------------------------------\n// 【测试 1】微信安全检测 config.json 配置文件物理核验\n// -------------------------------------------------------------\nconsole.log('【阶段一】核验 cloudfunctions 安全权限配置 config.json');\n\nconst customDishConfigPath = path.resolve('cloudfunctions/customDish/config.json');\nassert(fs.existsSync(customDishConfigPath), 'cloudfunctions/customDish/config.json 必须物理存在');\nconst customDishConfig = JSON.parse(fs.readFileSync(customDishConfigPath, 'utf8'));\nassert(\n  customDishConfig.permissions?.openapi?.includes('security.msgSecCheck'),\n  'customDish/config.json 必须声明 security.msgSecCheck 权限'\n);\n\nconst familyManageConfigPath = path.resolve('cloudfunctions/familyManage/config.json');\nassert(fs.existsSync(familyManageConfigPath), 'cloudfunctions/familyManage/config.json 必须物理存在');\nconst familyManageConfig = JSON.parse(fs.readFileSync(familyManageConfigPath, 'utf8'));\nassert(\n  familyManageConfig.permissions?.openapi?.includes('security.msgSecCheck'),\n  'familyManage/config.json 必须声明 security.msgSecCheck 权限'\n);\n\nconsole.log('✅ cloudfunctions/customDish 与 familyManage 的 config.json 声明完全合规！\\n');\n\n// -------------------------------------------------------------\n// 【测试 2】彻底修复网络错误降级导致“假成功永不上云”\n// -------------------------------------------------------------\nconsole.log('【阶段二】测试真实小程序环境网络报错严禁降级返回 Mock 假成功');\n\n// 模拟原生小程序环境\nconst storage = new Map();\nlet networkChangeListener = null;\n\nglobal.wx = {\n  getStorageSync: (key) => storage.get(key) || null,\n  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n  removeStorageSync: (key) => storage.delete(key),\n  clearStorageSync: () => storage.clear(),\n  onNetworkStatusChange: (fn) => { networkChangeListener = fn; },\n  showLoading: () => {},\n  hideLoading: () => {},\n  showToast: () => {}\n};\n\nconst { cloudService } = await import('../miniprogram/services/cloudService.js');\nconst { familyService } = await import('../miniprogram/services/familyService.js');\nconst { historyService } = await import('../miniprogram/services/historyService.js');\n\n// 模拟真实微信环境注入 wx.cloud\nlet callFunctionError = null;\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    if (callFunctionError) {\n      throw callFunctionError;\n    }\n    return {\n      result: {\n        success: true,\n        cloudResult: true\n      }\n    };\n  }\n};\n\n/**\n * Claude 终审提出的 3 项细节安全加固专项自动化测试\n * \n * 1. upsertMeal: doc().set() 剔除冗余 _id，confirmedByName 优先从 family.members 取核验昵称\n * 2. familyManage: createFamily 退出旧家庭失败中断防跨两家，joinFamily 5次防刷限频防暴力枚举，doc().set() 剔除冗余 _id\n * 3. historyService: 离线队列明确拒绝错误直接出队并标记为 failed，网络故障保持 pending，FIFO 队列防并发丢失\n */\n\nimport assert from 'assert/strict';\nimport fs from 'fs';\nimport path from 'path';\n\nconsole.log('===============================================================');\nconsole.log('🔒 启动 Claude 终审 3 项细节安全加固专项自动化审计测试');\nconsole.log('===============================================================\\n');\n\n// 模拟原生小程序环境\nconst storage = new Map();\nglobal.wx = {\n  getStorageSync: (key) => storage.get(key) || null,\n  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n  removeStorageSync: (key) => storage.delete(key),\n  clearStorageSync: () => storage.clear(),\n  onNetworkStatusChange: () => {},\n  showLoading: () => {},\n  hideLoading: () => {},\n  showToast: () => {}\n};\n\nprocess.env.NODE_ENV = 'test';\n\nconst { cloudService } = await import('../miniprogram/services/cloudService.js');\nconst { familyService } = await import('../miniprogram/services/familyService.js');\nconst { historyService } = await import('../miniprogram/services/historyService.js');\nconst upsertMealModule = await import('../cloudfunctions/upsertMeal/index.js');\nconst familyManageModule = await import('../cloudfunctions/familyManage/index.js');\nconst wxServerSdk = await import('wx-server-sdk');\n\n// -------------------------------------------------------------\n// 【加固项 1】upsertMeal 服务端核验昵称优先 & 剔除 _id 字段\n// -------------------------------------------------------------\nconsole.log('【加固项 1】验证 upsertMeal 服务端昵称防伪造与 set() 数据结构');\n\n// 1.1 验证 cloudfunctions/upsertMeal/index.js 源码中 doc().set() 没有冗余 _id\nconst upsertSource = fs.readFileSync(path.resolve('cloudfunctions/upsertMeal/index.js'), 'utf-8');\nassert(!upsertSource.includes('_id: docId'), 'doc().set() data 中严禁包含冗余 _id: docId');\nassert(upsertSource.includes('verifiedMember'), '必须包含 verifiedMember 服务端已核验昵称检索');\nconsole.log('✅ upsertMeal/index.js 源码剔除 _id: docId 并增加 verifiedMember 校验核验通过！');\n\n// 1.2 运行时端到端验证：服务端 family.members 真实昵称优先覆盖客户端恶意传入的 nickName\ncloudService.setForceMock(true);\nconst mockDb = cloudService.getMockDb();\nmockDb.clearAll();\n\n// 房主创建家庭，真实昵称为 \"正版大厨爸爸\"\nconst famRes = mockDb.handleFamilyManage({\n  action: 'createFamily',\n  name: '安全实验家庭',\n  nickName: '正版大厨爸爸',\n  mockOpenid: 'openid_real_dad'\n});\nassert(famRes.success, '创建实验家庭成功');\nconst familyId = famRes.family.id;\n\n// 模拟客户端恶意篡改 confirmedByName 为 \"黑客盗版昵称\"\nconst upsertRes = mockDb.handleUpsertMeal({\n  action: 'upsertMeal',\n  familyId,\n  date: '2026-10-15',\n  mockOpenid: 'openid_real_dad',\n  meal: {\n    mealId: 'm_safe_test_01',\n    mealType: '午餐',\n    mode: 'routine_2_1',\n    confirmedByName: '黑客盗版昵称',\n    dishes: [{ name: '清蒸大闸蟹', category: 'seafood' }]\n  }\n});\n\nassert(upsertRes.success, 'upsertMeal 成功');\nassert.equal(\n  upsertRes.meal.confirmedByName,\n  '正版大厨爸爸',\n  'confirmedByName 必须优先采用服务端 family.members 中已核验的昵称，绝不可被客户端篡改'\n);\n\n// 1.3 直接针对实际云函数 index.js 执行真实调用测试\nif (typeof wxServerSdk.default?.resetMemoryStore === 'function') {\n  wxServerSdk.default.resetMemoryStore();\n}\n/**\n * 微信小程序全量页面原生运行时模拟质检 (Pages Runtime Test)\n * 验证 4 个主 Tab + 3 个核心业务子页面在 JS 运行时环境下 0 报错、0 白屏\n */\nimport assert from 'assert/strict';\n\n// 1. 模拟微信小程序原生环境\nconst storage = new Map();\nlet registeredPages = {};\n\nglobal.wx = {\n  getStorageSync: (key) => storage.get(key) || null,\n  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n  removeStorageSync: (key) => storage.delete(key),\n  clearStorageSync: () => storage.clear(),\n  showLoading: () => {},\n  hideLoading: () => {},\n  showToast: () => {},\n  showModal: ({ success }) => success && success({ confirm: true }),\n  vibrateShort: () => {},\n  setClipboardData: ({ success }) => success && success({ errMsg: 'setClipboardData:ok' }),\n  navigateTo: () => {}\n};\n\nconst appInstance = {\n  globalData: {\n    currentMenu: null,\n    version: '2.05'\n  }\n};\nglobal.getApp = () => appInstance;\nglobal.App = (options) => {\n  if (options.onLaunch) options.onLaunch();\n};\n\nlet currentPageName = '';\nglobal.Page = (options) => {\n  registeredPages[currentPageName] = options;\n};\n\nconsole.log('====== 开始微信小程序 7 大核心页面原生 JS 运行时全量质检 ======\\n');\n\n// 测试 App.js\ncurrentPageName = 'app';\nawait import('../miniprogram/app.js');\nconsole.log('✅ app.js 成功执行 onLaunch，无异常');\nconsole.log('《四季三餐·好好吃饭》小程序 V2.04 启动中...');\n\n// 辅助页面创建函数\nfunction instantiatePage(name) {\n  const definition = registeredPages[name];\n  assert(definition, `页面 ${name} 必须成功调用 Page() 注册`);\n  const page = {\n    data: JSON.parse(JSON.stringify(definition.data || {})),\n    setData(newData, callback) {\n      Object.assign(this.data, newData);\n      if (typeof callback === 'function') callback();\n    },\n    ...definition\n  };\n  return page;\n}\n\n// 1. Tab 1: pages/index/index (点菜)\ncurrentPageName = 'pages/index/index';\nawait import('../miniprogram/pages/index/index.js');\nconst indexPage = instantiatePage('pages/index/index');\nindexPage.onLoad();\nindexPage.onShow();\nconsole.log(`✅ Tab 1 [点菜] (pages/index) 渲染成功: 季节=${indexPage.data.seasonName}, 时令食材数=${indexPage.data.seasonalIngredients.length}`);\nassert(indexPage.data.seasonalIngredients.length > 0, '时令食材列表不应为空');\nassert(indexPage.data.tomorrowText.length > 0, '明日日期文案不应为空');\nassert(indexPage.data.inspirationDishes.length >= 4, '今日主厨灵感尝鲜至少应推荐 4 道时令大图美食');\nassert(indexPage.data.solarTermText.length > 0, '节气物候文本不应为空');\nassert(indexPage.data.greetingText.length > 0, '晨昏问候文本不应为空');\n\n// 测试快速调味胶囊切换\nindexPage.toggleQuickFlavor({ currentTarget: { dataset: { flavor: 'light_healthy' } } });\nassert.equal(indexPage.data.selectedFlavor, 'light_healthy', '快速调味应切换为 light_healthy');\n\n// 测试灵感菜品弹窗与指定排餐\nconst firstInspire = indexPage.data.inspirationDishes[0];\nindexPage.openDishPreview({ currentTarget: { dataset: { id: firstInspire.id } } });\nassert(indexPage.data.showDishModal, '点击灵感菜品应打开详情弹窗');\nindexPage.preventBubble();\nindexPage.togglePinPreviewDish();\nassert.equal(indexPage.data.pinnedDishId, firstInspire.id, '应成功指定排入该灵感菜品');\n\n// 触发生成菜单\nindexPage.handleGenerateMenu();\nassert(appInstance.globalData.currentMenu, '生成菜单后全局 globalData 必须有 currentMenu');\nconst generatedMenu = appInstance.globalData.currentMenu;\nassert(generatedMenu.slots.some(s => s.dish.id === firstInspire.id), '指定排餐的灵感菜品必须出现在生成的菜单中');\nconsole.log(`✅ Tab 1 [点菜] 成功生成包含指定排餐【${firstInspire.name}】的菜单: ${generatedMenu.slots.map(s => s.dish.name).join(' + ')}`);\n\n\n// 2. Tab 2: pages/dishes/index (菜库)\ncurrentPageName = 'pages/dishes/index';\nawait import('../miniprogram/pages/dishes/index.js');\nconst dishesPage = instantiatePage('pages/dishes/index');\ndishesPage.onShow();\nconsole.log(`✅ Tab 2 [菜库] (pages/dishes) 渲染成功: 总菜品数=${dishesPage.data.allDishes.length}, 过滤菜品数=${dishesPage.data.filteredDishes.length}`);\nassert.equal(dishesPage.data.allDishes.length, 125, '菜品库应为 125 道菜');\nassert.equal(dishesPage.data.filteredDishes.length, 125, '默认全部分类展示菜品应为 125 道');\n\n{\n  \"name\": \"customDish\",\n  \"version\": \"1.0.0\",\n  \"description\": \"微信云函数: 纯文字私房菜录入、文本安全msgSecCheck审核与家庭菜谱共享\",\n  \"main\": \"index.js\",\n  \"dependencies\": {\n    \"wx-server-sdk\": \"~2.6.3\"\n  }\n}\n{\n  \"name\": \"familyManage\",\n  \"version\": \"1.0.0\",\n  \"description\": \"微信云函数: 4人家庭事务控制、动态口令与一人一家庭互斥管理\",\n  \"main\": \"index.js\",\n  \"dependencies\": {\n    \"wx-server-sdk\": \"~2.6.3\"\n  }\n}\n{\n  \"name\": \"upsertMeal\",\n  \"version\": \"1.0.0\",\n  \"description\": \"微信云函数: 共享历史记录原子追加与同日多餐独立同步\",\n  \"main\": \"index.js\",\n  \"dependencies\": {\n    \"wx-server-sdk\": \"~2.6.3\"\n  }\n}\n{\n  \"name\": \"userAuth\",\n  \"version\": \"1.0.0\",\n  \"description\": \"微信云函数: 用户静默鉴权与档案维护\",\n  \"main\": \"index.js\",\n  \"dependencies\": {\n    \"wx-server-sdk\": \"~2.6.3\"\n  }\n}\n","exit_code":0,"status":"completed"}}
