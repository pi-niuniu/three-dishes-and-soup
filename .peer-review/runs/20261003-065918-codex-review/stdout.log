,'\\\\''utf8'\\\\''),{require:()=>({...sdk,database:()=>wrapped}),exports:exp,process,console});\nconst write=await exp.main({familyId:'\\\\''probe_family'\\\\'',date:'\\\\''2026-10-03'\\\\'',mockOpenid:'\\\\''probe_user'\\\\'',meal:{mealId:'\\\\''dinner'\\\\''}},{});\nconsole.log('\\\\''Transient read failure overwrites:'\\\\'',write.success,(await db.collection('\\\\''meal_history'\\\\'').doc(docId).get()).data.meals.map(x=>x.mealId));\nconst storage=new Map();\nglobalThis.wx={getStorageSync:k=>storage.get(k),setStorageSync:(k,v)=>storage.set(k,structuredClone(v)),removeStorageSync:k=>storage.delete(k)};\nconst {historyService}=await import('\\\\''./miniprogram/services/historyService.js'\\\\'');\nconst {dataProvider}=await import('\\\\''./miniprogram/services/dataProvider.js'\\\\'');\nconst {familyService}=await import('\\\\''./miniprogram/services/familyService.js'\\\\'');\nhistoryService.recordMeal('\\\\''hearty_3_1'\\\\'',[],'\\\\''2026-10-03'\\\\'','\\\\''same-menu'\\\\'','\\\\''午餐'\\\\'');\nhistoryService.recordMeal('\\\\''hearty_3_1'\\\\'',[],'\\\\''2026-10-03'\\\\'','\\\\''same-menu'\\\\'','\\\\''晚餐'\\\\'');\nconsole.log('\\\\''Same menu lunch/dinner records:'\\\\'',historyService.getHistory().map(x=>x.mealType));\nconst added=await dataProvider.addCustomDish({name:'\\\\''测试个人私房菜'\\\\''});\ndataProvider.clearCustomDishes();\nconsole.log('\\\\''Personal cloud dish exists but sync restores:'\\\\'',(await dataProvider.syncCloudCustomDishes()).length);\nconsole.log('\\\\''E2E fish fixture id actual:'\\\\'',dataProvider.getDishById('\\\\''d_fish_01'\\\\'')?.name,'\\\\''real matching id:'\\\\'',dataProvider.getAllDishes().find(x=>x.name==='\\\\''清蒸鲈鱼'\\\\'')?.id);\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
