{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba cloudfunctions/familyManage/index.js | sed -n '142,430p'\"","aggregated_output":"   142\texports.main = async (event, context) => {\n   143\t  const wxContext = cloud.getWXContext();\n   144\t  let openid = wxContext && wxContext.OPENID;\n   145\t\n   146\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n   147\t  if (!openid) {\n   148\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n   149\t      openid = event.mockOpenid || 'mock_openid_default';\n   150\t    } else {\n   151\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n   152\t    }\n   153\t  }\n   154\t\n   155\t  const { action } = event;\n   156\t  const now = Date.now();\n   157\t\n   158\t  try {\n   159\t    switch (action) {\n   160\t      /**\n   161\t       * 1. 创建家庭空间\n   162\t       */\n   163\t      case 'createFamily': {\n   164\t        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n   165\t        const nickName = (event.nickName || '房主').trim();\n   166\t\n   167\t        // 安全合规校验：家庭名称与昵称\n   168\t        const nameSec = await checkTextSecurity(familyName, openid);\n   169\t        if (!nameSec.pass) return { success: false, error: nameSec.error };\n   170\t\n   171\t        const nickSec = await checkTextSecurity(nickName, openid);\n   172\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n   173\t\n   174\t        const userDocRef = db.collection('users').doc(`user_${openid}`);\n   175\t        \n   176\t        let user;\n   177\t        try {\n   178\t          const uRes = await userDocRef.get();\n   179\t          user = (uRes && uRes.data) ? uRes.data : null;\n   180\t        } catch (e) {\n   181\t          user = null;\n   182\t        }\n   183\t        if (!user) {\n   184\t          user = { _openid: openid, nickName: nickName || '房主' };\n   185\t        }\n   186\t\n   187\t        // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n   188\t        if (user.familyId) {\n   189\t          try {\n   190\t            await leaveCurrentFamilyInternal(openid, user.familyId);\n   191\t          } catch (e) {\n   192\t            console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n   193\t            throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n   194\t          }\n   195\t        }\n   196\t\n   197\t        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n   198\t        const inviteCode = await generateUniqueInviteCode();\n   199\t        const inviteExpiredAt = now + 24 * 60 * 60 * 1000; // 24小时过期\n   200\t\n   201\t        const newFamily = {\n   202\t          _id: familyId,\n   203\t          name: familyName,\n   204\t          creatorOpenid: openid,\n   205\t          members: [\n   206\t            {\n   207\t              openid,\n   208\t              nickName: nickName || user.nickName || '房主',\n   209\t              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n   210\t              role: 'creator',\n   211\t              joinedAt: now\n   212\t            }\n   213\t          ],\n   214\t          memberOpenids: [openid],\n   215\t          inviteCode,\n   216\t          inviteExpiredAt,\n   217\t          createdAt: now,\n   218\t          updatedAt: now\n   219\t        };\n   220\t\n   221\t        await db.collection('families').add({ data: newFamily });\n   222\t\n   223\t        // 更新用户档案 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n   224\t        await db.collection('users').doc(`user_${openid}`).set({\n   225\t          data: {\n   226\t            _openid: openid,\n   227\t            nickName: nickName || user.nickName || '房主',\n   228\t            avatarUrl: event.avatarUrl || user.avatarUrl || '',\n   229\t            familyId,\n   230\t            role: 'creator',\n   231\t            updatedAt: now\n   232\t          }\n   233\t        });\n   234\t\n   235\t        return {\n   236\t          success: true,\n   237\t          family: newFamily\n   238\t        };\n   239\t      }\n   240\t\n   241\t      /**\n   242\t       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n   243\t       */\n   244\t      case 'joinFamily': {\n   245\t        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n   246\t        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n   247\t        if (!rateLimitCheck.allowed) {\n   248\t          return { success: false, error: rateLimitCheck.error };\n   249\t        }\n   250\t\n   251\t        const inviteCode = String(event.inviteCode || '').trim();\n   252\t        if (!inviteCode || inviteCode.length !== 6) {\n   253\t          await recordJoinFailure(openid, now);\n   254\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n   255\t        }\n   256\t\n   257\t        const memberNickName = (event.nickName || '家人').trim();\n   258\t        const nickSec = await checkTextSecurity(memberNickName, openid);\n   259\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n   260\t\n   261\t        // 1. 查询有效且未过期的邀请码\n   262\t        const queryRes = await db.collection('families').where({\n   263\t          inviteCode,\n   264\t          inviteExpiredAt: _.gt(now)\n   265\t        }).get();\n   266\t\n   267\t        if (!queryRes.data || queryRes.data.length === 0) {\n   268\t          await recordJoinFailure(openid, now);\n   269\t          // 区分是过期还是根本不存在\n   270\t          const anyRes = await db.collection('families').where({ inviteCode }).get().catch(() => null);\n   271\t          if (anyRes && anyRes.data && anyRes.data.length > 0) {\n   272\t            return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n   273\t          }\n   274\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n   275\t        }\n   276\t\n   277\t        const targetFamilyId = queryRes.data[0]._id;\n   278\t\n   279\t        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n   280\t        try {\n   281\t          return await db.runTransaction(async transaction => {\n   282\t            const famDoc = await transaction.collection('families').doc(targetFamilyId).get().catch(() => null);\n   283\t            if (!famDoc || !famDoc.data) {\n   284\t              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n   285\t              throw new Error('未找到该邀请口令对应的家庭厨房');\n   286\t            }\n   287\t\n   288\t            const family = famDoc.data;\n   289\t\n   290\t            // 校验 1: 口令是否已过期 (24 小时有效)\n   291\t            if (now > family.inviteExpiredAt) {\n   292\t              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n   293\t              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n   294\t            }\n   295\t\n   296\t            // 校验 2: 是否已经在该家庭中\n   297\t            if (family.memberOpenids && family.memberOpenids.includes(openid)) {\n   298\t              return {\n   299\t                success: true,\n   300\t                family,\n   301\t                message: '您已经在该家庭厨房中'\n   302\t              };\n   303\t            }\n   304\t\n   305\t            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n   306\t            if ((family.memberOpenids || []).length >= 4) {\n   307\t              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n   308\t              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n   309\t            }\n   310\t\n   311\t            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n   312\t            const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n   313\t            const oldFamilyId = userDoc?.data?.familyId;\n   314\t            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n   315\t              const oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get().catch(() => null);\n   316\t              if (oldFamDoc?.data) {\n   317\t                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n   318\t                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n   319\t\n   320\t                if (remainingMembers.length === 0) {\n   321\t                  await transaction.collection('families').doc(oldFamilyId).remove();\n   322\t                } else {\n   323\t                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n   324\t                    ? remainingMembers[0].openid\n   325\t                    : oldFamDoc.data.creatorOpenid;\n   326\t\n   327\t                  if (oldFamDoc.data.creatorOpenid === openid) {\n   328\t                    remainingMembers[0].role = 'creator';\n   329\t                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n   330\t                      data: { role: 'creator', updatedAt: now }\n   331\t                    }).catch(() => {});\n   332\t                  }\n   333\t\n   334\t                  await transaction.collection('families').doc(oldFamilyId).update({\n   335\t                    data: {\n   336\t                      creatorOpenid: newCreator,\n   337\t                      members: remainingMembers,\n   338\t                      memberOpenids: remainingOpenids,\n   339\t                      updatedAt: now\n   340\t                    }\n   341\t                  });\n   342\t                }\n   343\t              }\n   344\t            }\n   345\t\n   346\t            // 加入新家庭\n   347\t            const newMember = {\n   348\t              openid,\n   349\t              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n   350\t              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n   351\t              role: 'member',\n   352\t              joinedAt: now\n   353\t            };\n   354\t\n   355\t            const updatedMembers = [...(family.members || []), newMember];\n   356\t            const updatedOpenids = [...(family.memberOpenids || []), openid];\n   357\t\n   358\t            await transaction.collection('families').doc(targetFamilyId).update({\n   359\t              data: {\n   360\t                members: updatedMembers,\n   361\t                memberOpenids: updatedOpenids,\n   362\t                updatedAt: now\n   363\t              }\n   364\t            });\n   365\t\n   366\t            // 更新用户档案并重置防刷计数 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n   367\t            await transaction.collection('users').doc(`user_${openid}`).set({\n   368\t              data: {\n   369\t                _openid: openid,\n   370\t                nickName: newMember.nickName,\n   371\t                avatarUrl: newMember.avatarUrl,\n   372\t                familyId: targetFamilyId,\n   373\t                role: 'member',\n   374\t                joinFailCount: 0,\n   375\t                joinFailLastTime: 0,\n   376\t                updatedAt: now\n   377\t              }\n   378\t            });\n   379\t\n   380\t            return {\n   381\t              success: true,\n   382\t              family: {\n   383\t                ...family,\n   384\t                members: updatedMembers,\n   385\t                memberOpenids: updatedOpenids,\n   386\t                updatedAt: now\n   387\t              }\n   388\t            };\n   389\t          });\n   390\t        } catch (trxErr) {\n   391\t          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n   392\t          return {\n   393\t            success: false,\n   394\t            error: errMsg\n   395\t          };\n   396\t        }\n   397\t      }\n   398\t\n   399\t      /**\n   400\t       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n   401\t       */\n   402\t      case 'leaveFamily': {\n   403\t        return await db.runTransaction(async transaction => {\n   404\t          const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n   405\t          const user = userDoc?.data;\n   406\t\n   407\t          if (!user || !user.familyId) {\n   408\t            return { success: true, message: '当前未加入任何家庭' };\n   409\t          }\n   410\t\n   411\t          const familyId = user.familyId;\n   412\t          const famDoc = await transaction.collection('families').doc(familyId).get().catch(() => null);\n   413\t\n   414\t          if (famDoc && famDoc.data) {\n   415\t            const family = famDoc.data;\n   416\t            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n   417\t            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n   418\t\n   419\t            if (remainingMembers.length === 0) {\n   420\t              await transaction.collection('families').doc(familyId).remove();\n   421\t            } else {\n   422\t              let newCreatorOpenid = family.creatorOpenid;\n   423\t              if (family.creatorOpenid === openid) {\n   424\t                newCreatorOpenid = remainingMembers[0].openid;\n   425\t                remainingMembers[0].role = 'creator';\n   426\t                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n   427\t                  data: { role: 'creator', updatedAt: now }\n   428\t                }).catch(() => {});\n   429\t              }\n   430\t\n","exit_code":0,"status":"completed"}}
