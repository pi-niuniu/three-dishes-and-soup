{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WRNkex7yqC2kveXLXGErbc","type":"tool_result","content":"1\t/**\n2\t * 针对用户批准的 5 项严重缺陷及加固项的专项深度审计与自动化回归测试\n3\t * \n4\t * 1. 网络错误降级防“假成功”测试\n5\t * 2. 事务回滚防继续执行与防脏写测试\n6\t * 3. 服务端越权与成员鉴权漏洞防范测试\n7\t * 4. 个人菜桶 personal_${openid} 隔离防泄露测试\n8\t * 5. 微信安全检测与 config.json 声明核验\n9\t * 6. 退出家庭原子事务与并发防竞态测试\n10\t * 7. 动态口令唯一性与过期校验测试\n11\t * 8. 连网状态监听 wx.onNetworkStatusChange 自动排空测试\n12\t * 9. 生产环境缺失 OPENID 坚决拒绝伪造测试\n13\t */\n14\t\n15\timport assert from 'assert/strict';\n16\timport fs from 'fs';\n17\timport path from 'path';\n18\t\n19\tconsole.log('===============================================================');\n20\tconsole.log('🛡️ 启动 5 项严重缺陷及加固项专项深度回归与攻防渗透测试');\n21\tconsole.log('===============================================================\\n');\n22\t\n23\t// -------------------------------------------------------------\n24\t// 【测试 1】微信安全检测 config.json 配置文件物理核验\n25\t// -------------------------------------------------------------\n26\tconsole.log('【阶段一】核验 cloudfunctions 安全权限配置 config.json');\n27\t\n28\tconst customDishConfigPath = path.resolve('cloudfunctions/customDish/config.json');\n29\tassert(fs.existsSync(customDishConfigPath), 'cloudfunctions/customDish/config.json 必须物理存在');\n30\tconst customDishConfig = JSON.parse(fs.readFileSync(customDishConfigPath, 'utf8'));\n31\tassert(\n32\t  customDishConfig.permissions?.openapi?.includes('security.msgSecCheck'),\n33\t  'customDish/config.json 必须声明 security.msgSecCheck 权限'\n34\t);\n35\t\n36\tconst familyManageConfigPath = path.resolve('cloudfunctions/familyManage/config.json');\n37\tassert(fs.existsSync(familyManageConfigPath), 'cloudfunctions/familyManage/config.json 必须物理存在');\n38\tconst familyManageConfig = JSON.parse(fs.readFileSync(familyManageConfigPath, 'utf8'));\n39\tassert(\n40\t  familyManageConfig.permissions?.openapi?.includes('security.msgSecCheck'),\n41\t  'familyManage/config.json 必须声明 security.msgSecCheck 权限'\n42\t);\n43\t\n44\tconsole.log('✅ cloudfunctions/customDish 与 familyManage 的 config.json 声明完全合规！\\n');\n45\t\n46\t// -------------------------------------------------------------\n47\t// 【测试 2】彻底修复网络错误降级导致“假成功永不上云”\n48\t// -------------------------------------------------------------\n49\tconsole.log('【阶段二】测试真实小程序环境网络报错严禁降级返回 Mock 假成功');\n50\t\n51\t// 模拟原生小程序环境\n52\tconst storage = new Map();\n53\tlet networkChangeListener = null;\n54\t\n55\tglobal.wx = {\n56\t  getStorageSync: (key) => storage.get(key) || null,\n57\t  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n58\t  removeStorageSync: (key) => storage.delete(key),\n59\t  clearStorageSync: () => storage.clear(),\n60\t  onNetworkStatusChange: (fn) => { networkChangeListener = fn; },\n61\t  showLoading: () => {},\n62\t  hideLoading: () => {},\n63\t  showToast: () => {}\n64\t};\n65\t\n66\tconst { cloudService } = await import('../miniprogram/services/cloudService.js');\n67\tconst { familyService } = await import('../miniprogram/services/familyService.js');\n68\tconst { historyService } = await import('../miniprogram/services/historyService.js');\n69\t\n70\t// 模拟真实微信环境注入 wx.cloud\n71\tlet callFunctionError = null;\n72\tglobal.wx.cloud = {\n73\t  callFunction: async ({ name, data }) => {\n74\t    if (callFunctionError) {\n75\t      throw callFunctionError;\n76\t    }\n77\t    return {\n78\t      result: {\n79\t        success: true,\n80\t        cloudResult: true\n81\t      }\n82\t    };\n83\t  }\n84\t};\n85\t\n86\tcloudService.resetAvailability();\n87\tassert.equal(cloudService.checkCloudAvailability(), true, 'wx.cloud 存在时必须识别为微信云开发可用环境');\n88\t\n89\t// 模拟网络故障异常抛错\n90\tcallFunctionError = new Error('request:fail timeout or offline');\n91\tconst failedRes = await cloudService.callFunction('upsertMeal', { action: 'upsertMeal' });\n92\t\n93\t// 核心断言：严禁降级返回 Mock 的 success=true！一律返回 success=false\n94\tassert.equal(failedRes.success, false, '真实环境云函数网络报错时，严禁降级返回 Mock 的 success！');\n95\tassert(failedRes.error && failedRes.error.includes('request:fail'), '必须返回真实底层网络错误信息交由队列重试');\n96\tconsole.log('✅ 真实微信环境网络超时拦截断言成功：绝无 Mock 假成功，正确返回错误！');\n97\t\n98\t// 验证离线持久化队列不会被“假成功”误标记为 synced\n99\tfamilyService.setMockCurrentUser('openid_test_offline', '离线测试员');\n100\tconst testDish = { id: 'd_test_01', name: '离线土豆丝', category: 'vegetable' };\n101\tconst offlineMeal = historyService.recordMeal('routine_2_1', [testDish], '2026-10-09', 'menu_off_1', '午餐');\n102\t\n103\t// 验证此时由于云调用失败，未被误清空\n104\tassert.equal(offlineMeal.syncStatus, 'synced' /* no family yet */);\n105\t\n106\t// 绑定家庭以激活离线队列\n107\tfamilyService.setMockCurrentUser('openid_test_offline', '离线测试员');\n108\tcallFunctionError = null;\n109\tglobal.wx.cloud = {\n110\t  callFunction: async ({ name, data }) => {\n111\t    if (callFunctionError) throw callFunctionError;\n112\t    if (name === 'familyManage') return { result: cloudService.getMockDb().handleFamilyManage(data) };\n113\t    if (name === 'upsertMeal') return { result: cloudService.getMockDb().handleUpsertMeal(data) };\n114\t    return { result: { success: true } };\n115\t  }\n116\t};\n117\tawait familyService.createFamily('离线测试家庭');\n118\t\n119\t// 再次开启网络故障\n120\tcallFunctionError = new Error('request:fail timeout or offline');\n121\t\n122\t// 产生带有 familyId 的离线记录\n123\tconst queuedMeal = historyService.recordMeal('routine_2_1', [testDish], '2026-10-09', 'menu_off_2', '晚餐');\n124\tassert.equal(queuedMeal.syncStatus, 'pending', '处于家庭中的离线记录状态应为 pending');\n125\t\n126\t// 当云函数恢复时\n127\tcallFunctionError = null;\n128\tconsole.log('✅ 离线队列防“假成功”持久化状态机校验通过！\\n');\n129\t\n130\t// -------------------------------------------------------------\n131\t// 【测试 3】连网状态监听 wx.onNetworkStatusChange 自动静默上报\n132\t// -------------------------------------------------------------\n133\tconsole.log('【阶段三】测试 wx.onNetworkStatusChange 连网自动排空离线队列');\n134\t\n135\tassert(networkChangeListener !== null, 'historyService 初始化必须注册 wx.onNetworkStatusChange 监听');\n136\t\n137\tlet flushedQueue = false;\n138\tconst originalFlush = historyService.flushPendingQueue.bind(historyService);\n139\thistoryService.flushPendingQueue = async () => {\n140\t  flushedQueue = true;\n141\t  return originalFlush();\n142\t};\n143\t\n144\t// 触发连网事件\n145\tnetworkChangeListener({ isConnected: true, networkType: 'wifi' });\n146\tassert.equal(flushedQueue, true, '网络恢复为 isConnected: true 时必须自动触发 flushPendingQueue');\n147\tconsole.log('✅ 连网事件已成功触发离线队列静默自动上报！\\n');\n148\t\n149\t// 恢复原始方法\n150\thistoryService.flushPendingQueue = originalFlush;\n151\t\n152\t// -------------------------------------------------------------\n153\t// 【测试 4】单人私房菜 personal_${openid} 隔离桶防泄露测试\n154\t// -------------------------------------------------------------\n155\tconsole.log('【阶段四】测试自选私房菜 personal_${openid} 隔离桶');\n156\t\n157\tcloudService.setForceMock(true); // 切换到 mockDb 进行业务边界验证\n158\tconst mockDb = cloudService.getMockDb();\n159\tmockDb.clearAll();\n160\t\n161\t// 1. 用户张三 (未入家庭) 录入私房菜\n162\tconst dishZhang = mockDb.handleCustomDish({\n163\t  action: 'addDish',\n164\t  name: '张三秘制辣椒炒肉',\n165\t  category: 'secondary_meat',\n166\t  mockOpenid: 'openid_zhangsan'\n167\t});\n168\tassert(dishZhang.success, '张三录入私房菜成功');\n169\tassert.equal(dishZhang.dish.familyId, 'personal_openid_zhangsan', '未入家庭必须使用 personal_${openid} 独立隔离桶');\n170\t\n171\t// 2. 用户李四 (未入家庭) 录入私房菜\n172\tconst dishLi = mockDb.handleCustomDish({\n173\t  action: 'addDish',\n174\t  name: '李四独家香椿炒蛋',\n175\t  category: 'egg',\n176\t  mockOpenid: 'openid_lisi'\n177\t});\n178\tassert(dishLi.success, '李四录入私房菜成功');\n179\tassert.equal(dishLi.dish.familyId, 'personal_openid_lisi', '未入家庭必须使用 personal_${openid} 独立隔离桶');\n180\t\n181\t// 3. 用户李四拉取自己的私房菜列表\n182\tconst lisiDishes = mockDb.handleCustomDish({\n183\t  action: 'getDishes',\n184\t  mockOpenid: 'openid_lisi'\n185\t});\n186\tassert.equal(lisiDishes.dishes.length, 1);\n187\tassert.equal(lisiDishes.dishes[0].name, '李四独家香椿炒蛋');\n188\tassert(!lisiDishes.dishes.some(d => d.name === '张三秘制辣椒炒肉'), '李四严禁查看到张三的私房菜！');\n189\t\n190\t// 4. 用户张三拉取自己的私房菜列表\n191\tconst zhangDishes = mockDb.handleCustomDish({\n192\t  action: 'getDishes',\n193\t  mockOpenid: 'openid_zhangsan'\n194\t});\n195\tassert.equal(zhangDishes.dishes.length, 1);\n196\tassert.equal(zhangDishes.dishes[0].name, '张三秘制辣椒炒肉');\n197\tassert(!zhangDishes.dishes.some(d => d.name === '李四独家香椿炒蛋'), '张三严禁查看到李四的私房菜！');\n198\t\n199\tconsole.log('✅ personal_${openid} 隔离桶严密生效：彻底杜绝所有单人用户共用 personal 桶导致的串味泄露！\\n');\n200\t\n201\t// -------------------------------------------------------------\n202\t// 【测试 5】服务端越权与家庭成员鉴权漏洞防范\n203\t// -------------------------------------------------------------\n204\tconsole.log('【阶段五】测试服务端越权与家庭成员鉴权防御');\n205\t\n206\t// 创建家庭 A (成员: 爸爸)\n207\tconst famA = mockDb.handleFamilyManage({\n208\t  action: 'createFamily',\n209\t  name: '家庭A',\n210\t  mockOpenid: 'openid_dad'\n211\t}).family;\n212\t\n213\t// 1. 越权测试：陌生人黑客尝试向家庭 A 写入做菜历史\n214\tconst hackerUpsert = mockDb.handleUpsertMeal({\n215\t  action: 'upsertMeal',\n216\t  familyId: famA.id,\n217\t  date: '2026-10-10',\n218\t  meal: { mealId: 'm_hack', dishes: [] },\n219\t  mockOpenid: 'openid_hacker'\n220\t});\n221\tassert.equal(hackerUpsert.success, false, '非家庭成员向该家庭写历史必须被服务端拦截');\n222\tassert(hackerUpsert.error.includes('越权') || hackerUpsert.error.includes('不属于'), `应返回越权提示: ${hackerUpsert.error}`);\n223\t\n224\t// 2. 越权测试：陌生人黑客尝试拉取家庭 A 的做菜历史\n225\tconst hackerGetHistory = mockDb.handleUpsertMeal({\n226\t  action: 'getHistory',\n227\t  familyId: famA.id,\n228\t  mockOpenid: 'openid_hacker'\n229\t});\n230\tassert.equal(hackerGetHistory.success, false, '非家庭成员拉取该家庭做菜历史必须被服务端拦截');\n231\t\n232\t// 3. 越权测试：陌生人黑客尝试向家庭 A 写入私房菜\n233\tconst hackerAddDish = mockDb.handleCustomDish({\n234\t  action: 'addDish',\n235\t  name: '恶意植入黑客菜',\n236\t  familyId: famA.id,\n237\t  mockOpenid: 'openid_hacker'\n238\t});\n239\tassert.equal(hackerAddDish.success, false, '非家庭成员向他人家庭写入私房菜必须被服务端拦截');\n240\t\n241\t// 4. 越权测试：陌生人黑客尝试拉取家庭 A 的私房菜\n242\tconst hackerGetDishes = mockDb.handleCustomDish({\n243\t  action: 'getDishes',\n244\t  familyId: famA.id,\n245\t  mockOpenid: 'openid_hacker'\n246\t});\n247\tassert.equal(hackerGetDishes.success, false, '非家庭成员拉取他人家庭私房菜必须被服务端拦截');\n248\t\n249\t// 5. 敏感信息保护：非家庭成员调用 getFamily 必须拒绝并杜绝泄露邀请码\n250\tconst hackerGetFam = mockDb.handleFamilyManage({\n251\t  action: 'getFamily',\n252\t  familyId: famA.id,\n253\t  mockOpenid: 'openid_hacker'\n254\t});\n255\tassert.equal(hackerGetFam.success, false, '非家庭成员查看家庭空间详情必须被拒绝');\n256\tassert(hackerGetFam.error.includes('无权') || hackerGetFam.error.includes('越权'), '应返回无权提示');\n257\t\n258\tconsole.log('✅ upsertMeal、customDish 与 getFamily 的服务端横向越权拦截 100% 达标！\\n');\n259\t\n260\t// -------------------------------------------------------------\n261\t// 【测试 6】文本合规与敏感内容全面校验 (家庭名称/昵称/私房菜)\n262\t// -------------------------------------------------------------\n263\tconsole.log('【阶段六】测试文本合规校验 (家庭名/昵称/私房菜)');\n264\t\n265\t// 1. 创建家庭名称包含广告/发票/敏感词\n266\tconst badFamName = mockDb.handleFamilyManage({\n267\t  action: 'createFamily',\n268\t  name: '代开发票代理公司',\n269\t  mockOpenid: 'openid_user_x'\n270\t});\n271\tassert.equal(badFamName.success, false, '包含发票广告的家庭名称必须被拒绝');\n272\t\n273\t// 2. 昵称包含涉黄/敏感词\n274\tconst badNickName = mockDb.handleFamilyManage({\n275\t  action: 'createFamily',\n276\t  name: '阳光小食堂',\n277\t  nickName: '低息贷款专员',\n278\t  mockOpenid: 'openid_user_x'\n279\t});\n280\tassert.equal(badNickName.success, false, '包含低息贷款等违规内容的昵称必须被拒绝');\n281\t\n282\t// 3. 加入家庭时昵称包含违规\n283\tconst badJoinNick = mockDb.handleFamilyManage({\n284\t  action: 'joinFamily',\n285\t  inviteCode: famA.inviteCode,\n286\t  nickName: '网络赌博客服',\n287\t  mockOpenid: 'openid_user_y'\n288\t});\n289\tassert.equal(badJoinNick.success, false, '加入家庭时昵称包含违禁内容必须被拒绝');\n290\t\n291\tconsole.log('✅ 家庭名与成员昵称安全合规校验全部生效！\\n');\n292\t\n293\t// -------------------------------------------------------------\n294\t// 【测试 7】生产环境缺失 OPENID 拒绝对比测试\n295\t// -------------------------------------------------------------\n296\tconsole.log('【阶段七】测试生产环境缺失 OPENID 坚决拒绝伪造');\n297\t\n298\tconst familyManageModule = await import('../cloudfunctions/familyManage/index.js');\n299\tconst upsertMealModule = await import('../cloudfunctions/upsertMeal/index.js');\n300\tconst customDishModule = await import('../cloudfunctions/customDish/index.js');\n301\tconst userAuthModule = await import('../cloudfunctions/userAuth/index.js');\n302\t\n303\t// 模拟生产环境 (NODE_ENV !== 'test', 无 OPENID, 未带 _testMock)\n304\tconst originalNodeEnv = process.env.NODE_ENV;\n305\tdelete process.env.NODE_ENV;\n306\t\n307\tconst fakeEvent = {\n308\t  action: 'createFamily',\n309\t  name: '黑客伪造家庭',\n310\t  mockOpenid: 'victim_user'\n311\t};\n312\t\n313\tconst famResultProd = await familyManageModule.main(fakeEvent, {});\n314\tassert.equal(famResultProd.success, false, '生产环境无真实 OPENID 且未通过鉴权网关时必须拒绝');\n315\tassert(famResultProd.error.includes('OPENID 缺失') || famResultProd.error.includes('有效身份'), '应提示 OPENID 缺失');\n316\t\n317\tconst mealResultProd = await upsertMealModule.main(fakeEvent, {});\n318\tassert.equal(mealResultProd.success, false, 'upsertMeal 生产环境无 OPENID 必须直接拒绝');\n319\t\n320\tconst dishResultProd = await customDishModule.main(fakeEvent, {});\n321\tassert.equal(dishResultProd.success, false, 'customDish 生产环境无 OPENID 必须直接拒绝');\n322\t\n323\tconst authResultProd = await userAuthModule.main(fakeEvent, {});\n324\tassert.equal(authResultProd.success, false, 'userAuth 生产环境无 OPENID 必须直接拒绝');\n325\t\n326\t// 恢复环境变量\n327\tprocess.env.NODE_ENV = originalNodeEnv;\n328\tconsole.log('✅ 生产环境缺失 OPENID 鉴权凭据安全防线 100% 坚不可摧！\\n');\n329\t\n330\tconsole.log('===============================================================');\n331\tconsole.log('🏆 所有 5 项严重问题修复与加固项专项深度回归测试 100% 通过！');\n332\tconsole.log('===============================================================\\n');\n333\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"57a25a8d-bc39-4c56-9768-23fcd789aa0c","timestamp":"2026-10-02T13:34:12.055Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/test/security_hardening_audit_test.mjs","content":"/**\n * 针对用户批准的 5 项严重缺陷及加固项的专项深度审计与自动化回归测试\n * \n * 1. 网络错误降级防“假成功”测试\n * 2. 事务回滚防继续执行与防脏写测试\n * 3. 服务端越权与成员鉴权漏洞防范测试\n * 4. 个人菜桶 personal_${openid} 隔离防泄露测试\n * 5. 微信安全检测与 config.json 声明核验\n * 6. 退出家庭原子事务与并发防竞态测试\n * 7. 动态口令唯一性与过期校验测试\n * 8. 连网状态监听 wx.onNetworkStatusChange 自动排空测试\n * 9. 生产环境缺失 OPENID 坚决拒绝伪造测试\n */\n\nimport assert from 'assert/strict';\nimport fs from 'fs';\nimport path from 'path';\n\nconsole.log('===============================================================');\nconsole.log('🛡️ 启动 5 项严重缺陷及加固项专项深度回归与攻防渗透测试');\nconsole.log('===============================================================\\n');\n\n// -------------------------------------------------------------\n// 【测试 1】微信安全检测 config.json 配置文件物理核验\n// -------------------------------------------------------------\nconsole.log('【阶段一】核验 cloudfunctions 安全权限配置 config.json');\n\nconst customDishConfigPath = path.resolve('cloudfunctions/customDish/config.json');\nassert(fs.existsSync(customDishConfigPath), 'cloudfunctions/customDish/config.json 必须物理存在');\nconst customDishConfig = JSON.parse(fs.readFileSync(customDishConfigPath, 'utf8'));\nassert(\n  customDishConfig.permissions?.openapi?.includes('security.msgSecCheck'),\n  'customDish/config.json 必须声明 security.msgSecCheck 权限'\n);\n\nconst familyManageConfigPath = path.resolve('cloudfunctions/familyManage/config.json');\nassert(fs.existsSync(familyManageConfigPath), 'cloudfunctions/familyManage/config.json 必须物理存在');\nconst familyManageConfig = JSON.parse(fs.readFileSync(familyManageConfigPath, 'utf8'));\nassert(\n  familyManageConfig.permissions?.openapi?.includes('security.msgSecCheck'),\n  'familyManage/config.json 必须声明 security.msgSecCheck 权限'\n);\n\nconsole.log('✅ cloudfunctions/customDish 与 familyManage 的 config.json 声明完全合规！\\n');\n\n// -------------------------------------------------------------\n// 【测试 2】彻底修复网络错误降级导致“假成功永不上云”\n// -------------------------------------------------------------\nconsole.log('【阶段二】测试真实小程序环境网络报错严禁降级返回 Mock 假成功');\n\n// 模拟原生小程序环境\nconst storage = new Map();\nlet networkChangeListener = null;\n\nglobal.wx = {\n  getStorageSync: (key) => storage.get(key) || null,\n  setStorageSync: (key, val) => storage.set(key, JSON.parse(JSON.stringify(val))),\n  removeStorageSync: (key) => storage.delete(key),\n  clearStorageSync: () => storage.clear(),\n  onNetworkStatusChange: (fn) => { networkChangeListener = fn; },\n  showLoading: () => {},\n  hideLoading: () => {},\n  showToast: () => {}\n};\n\nconst { cloudService } = await import('../miniprogram/services/cloudService.js');\nconst { familyService } = await import('../miniprogram/services/familyService.js');\nconst { historyService } = await import('../miniprogram/services/historyService.js');\n\n// 模拟真实微信环境注入 wx.cloud\nlet callFunctionError = null;\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    if (callFunctionError) {\n      throw callFunctionError;\n    }\n    return {\n      result: {\n        success: true,\n        cloudResult: true\n      }\n    };\n  }\n};\n\ncloudService.resetAvailability();\nassert.equal(cloudService.checkCloudAvailability(), true, 'wx.cloud 存在时必须识别为微信云开发可用环境');\n\n// 模拟网络故障异常抛错\ncallFunctionError = new Error('request:fail timeout or offline');\nconst failedRes = await cloudService.callFunction('upsertMeal', { action: 'upsertMeal' });\n\n// 核心断言：严禁降级返回 Mock 的 success=true！一律返回 success=false\nassert.equal(failedRes.success, false, '真实环境云函数网络报错时，严禁降级返回 Mock 的 success！');\nassert(failedRes.error && failedRes.error.includes('request:fail'), '必须返回真实底层网络错误信息交由队列重试');\nconsole.log('✅ 真实微信环境网络超时拦截断言成功：绝无 Mock 假成功，正确返回错误！');\n\n// 验证离线持久化队列不会被“假成功”误标记为 synced\nfamilyService.setMockCurrentUser('openid_test_offline', '离线测试员');\nconst testDish = { id: 'd_test_01', name: '离线土豆丝', category: 'vegetable' };\nconst offlineMeal = historyService.recordMeal('routine_2_1', [testDish], '2026-10-09', 'menu_off_1', '午餐');\n\n// 验证此时由于云调用失败，未被误清空\nassert.equal(offlineMeal.syncStatus, 'synced' /* no family yet */);\n\n// 绑定家庭以激活离线队列\nfamilyService.setMockCurrentUser('openid_test_offline', '离线测试员');\ncallFunctionError = null;\nglobal.wx.cloud = {\n  callFunction: async ({ name, data }) => {\n    if (callFunctionError) throw callFunctionError;\n    if (name === 'familyManage') return { result: cloudService.getMockDb().handleFamilyManage(data) };\n    if (name === 'upsertMeal') return { result: cloudService.getMockDb().handleUpsertMeal(data) };\n    return { result: { success: true } };\n  }\n};\nawait familyService.createFamily('离线测试家庭');\n\n// 再次开启网络故障\ncallFunctionError = new Error('request:fail timeout or offline');\n\n// 产生带有 familyId 的离线记录\nconst queuedMeal = historyService.recordMeal('routine_2_1', [testDish], '2026-10-09', 'menu_off_2', '晚餐');\nassert.equal(queuedMeal.syncStatus, 'pending', '处于家庭中的离线记录状态应为 pending');\n\n// 当云函数恢复时\ncallFunctionError = null;\nconsole.log('✅ 离线队列防“假成功”持久化状态机校验通过！\\n');\n\n// -------------------------------------------------------------\n// 【测试 3】连网状态监听 wx.onNetworkStatusChange 自动静默上报\n// -------------------------------------------------------------\nconsole.log('【阶段三】测试 wx.onNetworkStatusChange 连网自动排空离线队列');\n\nassert(networkChangeListener !== null, 'historyService 初始化必须注册 wx.onNetworkStatusChange 监听');\n\nlet flushedQueue = false;\nconst originalFlush = historyService.flushPendingQueue.bind(historyService);\nhistoryService.flushPendingQueue = async () => {\n  flushedQueue = true;\n  return originalFlush();\n};\n\n// 触发连网事件\nnetworkChangeListener({ isConnected: true, networkType: 'wifi' });\nassert.equal(flushedQueue, true, '网络恢复为 isConnected: true 时必须自动触发 flushPendingQueue');\nconsole.log('✅ 连网事件已成功触发离线队列静默自动上报！\\n');\n\n// 恢复原始方法\nhistoryService.flushPendingQueue = originalFlush;\n\n// -------------------------------------------------------------\n// 【测试 4】单人私房菜 personal_${openid} 隔离桶防泄露测试\n// -------------------------------------------------------------\nconsole.log('【阶段四】测试自选私房菜 personal_${openid} 隔离桶');\n\ncloudService.setForceMock(true); // 切换到 mockDb 进行业务边界验证\nconst mockDb = cloudService.getMockDb();\nmockDb.clearAll();\n\n// 1. 用户张三 (未入家庭) 录入私房菜\nconst dishZhang = mockDb.handleCustomDish({\n  action: 'addDish',\n  name: '张三秘制辣椒炒肉',\n  category: 'secondary_meat',\n  mockOpenid: 'openid_zhangsan'\n});\nassert(dishZhang.success, '张三录入私房菜成功');\nassert.equal(dishZhang.dish.familyId, 'personal_openid_zhangsan', '未入家庭必须使用 personal_${openid} 独立隔离桶');\n\n// 2. 用户李四 (未入家庭) 录入私房菜\nconst dishLi = mockDb.handleCustomDish({\n  action: 'addDish',\n  name: '李四独家香椿炒蛋',\n  category: 'egg',\n  mockOpenid: 'openid_lisi'\n});\nassert(dishLi.success, '李四录入私房菜成功');\nassert.equal(dishLi.dish.familyId, 'personal_openid_lisi', '未入家庭必须使用 personal_${openid} 独立隔离桶');\n\n// 3. 用户李四拉取自己的私房菜列表\nconst lisiDishes = mockDb.handleCustomDish({\n  action: 'getDishes',\n  mockOpenid: 'openid_lisi'\n});\nassert.equal(lisiDishes.dishes.length, 1);\nassert.equal(lisiDishes.dishes[0].name, '李四独家香椿炒蛋');\nassert(!lisiDishes.dishes.some(d => d.name === '张三秘制辣椒炒肉'), '李四严禁查看到张三的私房菜！');\n\n// 4. 用户张三拉取自己的私房菜列表\nconst zhangDishes = mockDb.handleCustomDish({\n  action: 'getDishes',\n  mockOpenid: 'openid_zhangsan'\n});\nassert.equal(zhangDishes.dishes.length, 1);\nassert.equal(zhangDishes.dishes[0].name, '张三秘制辣椒炒肉');\nassert(!zhangDishes.dishes.some(d => d.name === '李四独家香椿炒蛋'), '张三严禁查看到李四的私房菜！');\n\nconsole.log('✅ personal_${openid} 隔离桶严密生效：彻底杜绝所有单人用户共用 personal 桶导致的串味泄露！\\n');\n\n// -------------------------------------------------------------\n// 【测试 5】服务端越权与家庭成员鉴权漏洞防范\n// -------------------------------------------------------------\nconsole.log('【阶段五】测试服务端越权与家庭成员鉴权防御');\n\n// 创建家庭 A (成员: 爸爸)\nconst famA = mockDb.handleFamilyManage({\n  action: 'createFamily',\n  name: '家庭A',\n  mockOpenid: 'openid_dad'\n}).family;\n\n// 1. 越权测试：陌生人黑客尝试向家庭 A 写入做菜历史\nconst hackerUpsert = mockDb.handleUpsertMeal({\n  action: 'upsertMeal',\n  familyId: famA.id,\n  date: '2026-10-10',\n  meal: { mealId: 'm_hack', dishes: [] },\n  mockOpenid: 'openid_hacker'\n});\nassert.equal(hackerUpsert.success, false, '非家庭成员向该家庭写历史必须被服务端拦截');\nassert(hackerUpsert.error.includes('越权') || hackerUpsert.error.includes('不属于'), `应返回越权提示: ${hackerUpsert.error}`);\n\n// 2. 越权测试：陌生人黑客尝试拉取家庭 A 的做菜历史\nconst hackerGetHistory = mockDb.handleUpsertMeal({\n  action: 'getHistory',\n  familyId: famA.id,\n  mockOpenid: 'openid_hacker'\n});\nassert.equal(hackerGetHistory.success, false, '非家庭成员拉取该家庭做菜历史必须被服务端拦截');\n\n// 3. 越权测试：陌生人黑客尝试向家庭 A 写入私房菜\nconst hackerAddDish = mockDb.handleCustomDish({\n  action: 'addDish',\n  name: '恶意植入黑客菜',\n  familyId: famA.id,\n  mockOpenid: 'openid_hacker'\n});\nassert.equal(hackerAddDish.success, false, '非家庭成员向他人家庭写入私房菜必须被服务端拦截');\n\n// 4. 越权测试：陌生人黑客尝试拉取家庭 A 的私房菜\nconst hackerGetDishes = mockDb.handleCustomDish({\n  action: 'getDishes',\n  familyId: famA.id,\n  mockOpenid: 'openid_hacker'\n});\nassert.equal(hackerGetDishes.success, false, '非家庭成员拉取他人家庭私房菜必须被服务端拦截');\n\n// 5. 敏感信息保护：非家庭成员调用 getFamily 必须拒绝并杜绝泄露邀请码\nconst hackerGetFam = mockDb.handleFamilyManage({\n  action: 'getFamily',\n  familyId: famA.id,\n  mockOpenid: 'openid_hacker'\n});\nassert.equal(hackerGetFam.success, false, '非家庭成员查看家庭空间详情必须被拒绝');\nassert(hackerGetFam.error.includes('无权') || hackerGetFam.error.includes('越权'), '应返回无权提示');\n\nconsole.log('✅ upsertMeal、customDish 与 getFamily 的服务端横向越权拦截 100% 达标！\\n');\n\n// -------------------------------------------------------------\n// 【测试 6】文本合规与敏感内容全面校验 (家庭名称/昵称/私房菜)\n// -------------------------------------------------------------\nconsole.log('【阶段六】测试文本合规校验 (家庭名/昵称/私房菜)');\n\n// 1. 创建家庭名称包含广告/发票/敏感词\nconst badFamName = mockDb.handleFamilyManage({\n  action: 'createFamily',\n  name: '代开发票代理公司',\n  mockOpenid: 'openid_user_x'\n});\nassert.equal(badFamName.success, false, '包含发票广告的家庭名称必须被拒绝');\n\n// 2. 昵称包含涉黄/敏感词\nconst badNickName = mockDb.handleFamilyManage({\n  action: 'createFamily',\n  name: '阳光小食堂',\n  nickName: '低息贷款专员',\n  mockOpenid: 'openid_user_x'\n});\nassert.equal(badNickName.success, false, '包含低息贷款等违规内容的昵称必须被拒绝');\n\n// 3. 加入家庭时昵称包含违规\nconst badJoinNick = mockDb.handleFamilyManage({\n  action: 'joinFamily',\n  inviteCode: famA.inviteCode,\n  nickName: '网络赌博客服',\n  mockOpenid: 'openid_user_y'\n});\nassert.equal(badJoinNick.success, false, '加入家庭时昵称包含违禁内容必须被拒绝');\n\nconsole.log('✅ 家庭名与成员昵称安全合规校验全部生效！\\n');\n\n// -------------------------------------------------------------\n// 【测试 7】生产环境缺失 OPENID 拒绝对比测试\n// -------------------------------------------------------------\nconsole.log('【阶段七】测试生产环境缺失 OPENID 坚决拒绝伪造');\n\nconst familyManageModule = await import('../cloudfunctions/familyManage/index.js');\nconst upsertMealModule = await import('../cloudfunctions/upsertMeal/index.js');\nconst customDishModule = await import('../cloudfunctions/customDish/index.js');\nconst userAuthModule = await import('../cloudfunctions/userAuth/index.js');\n\n// 模拟生产环境 (NODE_ENV !== 'test', 无 OPENID, 未带 _testMock)\nconst originalNodeEnv = process.env.NODE_ENV;\ndelete process.env.NODE_ENV;\n\nconst fakeEvent = {\n  action: 'createFamily',\n  name: '黑客伪造家庭',\n  mockOpenid: 'victim_user'\n};\n\nconst famResultProd = await familyManageModule.main(fakeEvent, {});\nassert.equal(famResultProd.success, false, '生产环境无真实 OPENID 且未通过鉴权网关时必须拒绝');\nassert(famResultProd.error.includes('OPENID 缺失') || famResultProd.error.includes('有效身份'), '应提示 OPENID 缺失');\n\nconst mealResultProd = await upsertMealModule.main(fakeEvent, {});\nassert.equal(mealResultProd.success, false, 'upsertMeal 生产环境无 OPENID 必须直接拒绝');\n\nconst dishResultProd = await customDishModule.main(fakeEvent, {});\nassert.equal(dishResultProd.success, false, 'customDish 生产环境无 OPENID 必须直接拒绝');\n\nconst authResultProd = await userAuthModule.main(fakeEvent, {});\nassert.equal(authResultProd.success, false, 'userAuth 生产环境无 OPENID 必须直接拒绝');\n\n// 恢复环境变量\nprocess.env.NODE_ENV = originalNodeEnv;\nconsole.log('✅ 生产环境缺失 OPENID 鉴权凭据安全防线 100% 坚不可摧！\\n');\n\nconsole.log('===============================================================');\nconsole.log('🏆 所有 5 项严重问题修复与加固项专项深度回归测试 100% 通过！');\nconsole.log('===============================================================\\n');\n","numLines":333,"startLine":1,"totalLines":333}}}
