{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015MRmjhW8YSYAFzkDmFGqqD","type":"tool_result","content":"1\t/**\n2\t * 微信云开发服务网关 (CloudService)\n3\t * 职责：\n4\t * 1. 统一封装 wx.cloud.callFunction 调用\n5\t * 2. 真实小程序环境下云函数报错严禁降级返回 Mock 假成功，一律返回失败交由离线队列重试\n6\t * 3. 在无微信环境（Node.js 单测）或强制模拟模式下，提供高保真本地 Mock 状态机仿真\n7\t * 4. 严格保障 4 人上限、24小时邀请码、一人一家庭排他与同日多餐写入\n8\t */\n9\t\n10\timport type { FamilySpace, UserProfile, SingleMealItem, CustomDishRecord } from '../types/family.js';\n11\t\n12\tinterface CloudResponse<T = any> {\n13\t  success: boolean;\n14\t  result?: T;\n15\t  error?: string;\n16\t  [key: string]: any;\n17\t}\n18\t\n19\tclass LocalCloudMockDatabase {\n20\t  private users = new Map<string, any>();\n21\t  private families = new Map<string, any>();\n22\t  private mealHistory = new Map<string, any>(); // key: meal_${familyId}_${date}\n23\t  private customDishes = new Map<string, any[]>(); // key: familyId -> dish[]\n24\t  private sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n25\t\n26\t  constructor() {\n27\t    this.restoreFromStorage();\n28\t  }\n29\t\n30\t  private hasSensitiveContent(text: string): boolean {\n31\t    if (!text) return false;\n32\t    const str = String(text);\n33\t    return this.sensitiveWords.some(w => str.includes(w));\n34\t  }\n35\t\n36\t  private generateUniqueInviteCode(): string {\n37\t    const now = Date.now();\n38\t    for (let attempt = 0; attempt < 10; attempt++) {\n39\t      const code = String(Math.floor(100000 + Math.random() * 900000));\n40\t      let isDuplicate = false;\n41\t      for (const fam of this.families.values()) {\n42\t        if (fam.inviteCode === code && fam.inviteExpiredAt > now) {\n43\t          isDuplicate = true;\n44\t          break;\n45\t        }\n46\t      }\n47\t      if (!isDuplicate) return code;\n48\t    }\n49\t    return String(Math.floor(100000 + Math.random() * 900000));\n50\t  }\n51\t\n52\t  private getOpenid(data: any): string {\n53\t    if (data?.mockOpenid) return data.mockOpenid;\n54\t    try {\n55\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n56\t        const user = wx.getStorageSync('current_user_profile');\n57\t        if (user && user.openid) return user.openid;\n58\t      }\n59\t    } catch (e) {}\n60\t    return 'mock_openid_default';\n61\t  }\n62\t\n63\t  private restoreFromStorage() {\n64\t    try {\n65\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n66\t        const storedUsers = wx.getStorageSync('mock_db_users');\n67\t        if (storedUsers) this.users = new Map(Object.entries(storedUsers));\n68\t\n69\t        const storedFamilies = wx.getStorageSync('mock_db_families');\n70\t        if (storedFamilies) this.families = new Map(Object.entries(storedFamilies));\n71\t\n72\t        const storedHistory = wx.getStorageSync('mock_db_history');\n73\t        if (storedHistory) this.mealHistory = new Map(Object.entries(storedHistory));\n74\t\n75\t        const storedDishes = wx.getStorageSync('mock_db_custom_dishes');\n76\t        if (storedDishes) this.customDishes = new Map(Object.entries(storedDishes));\n77\t      }\n78\t    } catch (e) {}\n79\t  }\n80\t\n81\t  private persist() {\n82\t    try {\n83\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n84\t        wx.setStorageSync('mock_db_users', Object.fromEntries(this.users));\n85\t        wx.setStorageSync('mock_db_families', Object.fromEntries(this.families));\n86\t        wx.setStorageSync('mock_db_history', Object.fromEntries(this.mealHistory));\n87\t        wx.setStorageSync('mock_db_custom_dishes', Object.fromEntries(this.customDishes));\n88\t      }\n89\t    } catch (e) {}\n90\t  }\n91\t\n92\t  public clearAll() {\n93\t    this.users.clear();\n94\t    this.families.clear();\n95\t    this.mealHistory.clear();\n96\t    this.customDishes.clear();\n97\t    this.persist();\n98\t  }\n99\t\n100\t  public handleUserAuth(data: any): any {\n101\t    const openid = this.getOpenid(data);\n102\t    const now = Date.now();\n103\t    let user = this.users.get(`user_${openid}`);\n104\t\n105\t    if (!user) {\n106\t      user = {\n107\t        _id: `user_${openid}`,\n108\t        _openid: openid,\n109\t        nickName: data?.nickName || '家人',\n110\t        avatarUrl: data?.avatarUrl || '',\n111\t        familyId: null,\n112\t        role: null,\n113\t        createdAt: now,\n114\t        updatedAt: now\n115\t      };\n116\t      this.users.set(`user_${openid}`, user);\n117\t    } else {\n118\t      if (data?.nickName) user.nickName = data.nickName;\n119\t      if (data?.avatarUrl) user.avatarUrl = data.avatarUrl;\n120\t      user.updatedAt = now;\n121\t    }\n122\t\n123\t    let family = null;\n124\t    if (user.familyId) {\n125\t      family = this.families.get(user.familyId) || null;\n126\t      if (!family) {\n127\t        user.familyId = null;\n128\t        user.role = null;\n129\t      }\n130\t    }\n131\t\n132\t    this.persist();\n133\t    return { success: true, openid, user, family };\n134\t  }\n135\t\n136\t  public handleFamilyManage(data: any): any {\n137\t    const { action } = data;\n138\t    const openid = this.getOpenid(data);\n139\t    const now = Date.now();\n140\t\n141\t    switch (action) {\n142\t      case 'createFamily': {\n143\t        const familyName = (data.name || '温馨小家食堂').trim().slice(0, 15);\n144\t        const nickName = data.nickName || '房主';\n145\t\n146\t        // 文本合规检验\n147\t        if (this.hasSensitiveContent(familyName) || this.hasSensitiveContent(nickName)) {\n148\t          return { success: false, error: '家庭名称或昵称包含敏感词，请修改后重试' };\n149\t        }\n150\t\n151\t        let user = this.users.get(`user_${openid}`) || {\n152\t          _id: `user_${openid}`,\n153\t          _openid: openid,\n154\t          nickName,\n155\t          familyId: null\n156\t        };\n157\t\n158\t        // 如果用户在旧家庭中，先退出\n159\t        if (user.familyId && this.families.has(user.familyId)) {\n160\t          this.leaveFamilyInternal(openid, user.familyId);\n161\t        }\n162\t\n163\t        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n164\t        const inviteCode = this.generateUniqueInviteCode();\n165\t        const inviteExpiredAt = now + 24 * 60 * 60 * 1000;\n166\t\n167\t        const newFamily: FamilySpace = {\n168\t          id: familyId,\n169\t          name: familyName,\n170\t          creatorOpenid: openid,\n171\t          members: [\n172\t            {\n173\t              openid,\n174\t              nickName: nickName || user.nickName || '房主',\n175\t              avatarUrl: data.avatarUrl || user.avatarUrl || '',\n176\t              role: 'creator',\n177\t              joinedAt: now\n178\t            }\n179\t          ],\n180\t          memberOpenids: [openid],\n181\t          inviteCode,\n182\t          inviteExpiredAt,\n183\t          createdAt: now,\n184\t          updatedAt: now\n185\t        };\n186\t\n187\t        this.families.set(familyId, newFamily);\n188\t        user.familyId = familyId;\n189\t        user.role = 'creator';\n190\t        user.updatedAt = now;\n191\t        this.users.set(`user_${openid}`, user);\n192\t\n193\t        this.persist();\n194\t        return { success: true, family: newFamily };\n195\t      }\n196\t\n197\t      case 'joinFamily': {\n198\t        const inviteCode = String(data.inviteCode || '').trim();\n199\t        if (!inviteCode || inviteCode.length !== 6) {\n200\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n201\t        }\n202\t\n203\t        const nickName = data.nickName || '家人';\n204\t        if (this.hasSensitiveContent(nickName)) {\n205\t          return { success: false, error: '成员昵称包含敏感词，请修改后重试' };\n206\t        }\n207\t\n208\t        let targetFamily: FamilySpace | null = null;\n209\t        for (const fam of this.families.values()) {\n210\t          if (fam.inviteCode === inviteCode) {\n211\t            targetFamily = fam;\n212\t            break;\n213\t          }\n214\t        }\n215\t\n216\t        if (!targetFamily) {\n217\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n218\t        }\n219\t\n220\t        if (now > targetFamily.inviteExpiredAt) {\n221\t          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n222\t        }\n223\t\n224\t        if (targetFamily.memberOpenids.includes(openid)) {\n225\t          return { success: true, family: targetFamily, message: '您已经在该家庭厨房中' };\n226\t        }\n227\t\n228\t        // 严格 4 人限制 (易错点 2 防御)\n229\t        if (targetFamily.memberOpenids.length >= 4) {\n230\t          return { success: false, error: '该家庭厨房成员已满（上限4人），无法继续加入' };\n231\t        }\n232\t\n233\t        // 一人一家庭排他 (易错点 3 防御)\n234\t        let user = this.users.get(`user_${openid}`) || {\n235\t          _id: `user_${openid}`,\n236\t          _openid: openid,\n237\t          nickName,\n238\t          familyId: null\n239\t        };\n240\t        if (user.familyId && user.familyId !== targetFamily.id && this.families.has(user.familyId)) {\n241\t          this.leaveFamilyInternal(openid, user.familyId);\n242\t        }\n243\t\n244\t        const newMember = {\n245\t          openid,\n246\t          nickName: nickName || user.nickName || '家人',\n247\t          avatarUrl: data.avatarUrl || user.avatarUrl || '',\n248\t          role: 'member' as const,\n249\t          joinedAt: now\n250\t        };\n251\t\n252\t        targetFamily.members.push(newMember);\n253\t        targetFamily.memberOpenids.push(openid);\n254\t        targetFamily.updatedAt = now;\n255\t\n256\t        user.familyId = targetFamily.id;\n257\t        user.role = 'member';\n258\t        user.updatedAt = now;\n259\t        this.users.set(`user_${openid}`, user);\n260\t\n261\t        this.persist();\n262\t        return { success: true, family: targetFamily };\n263\t      }\n264\t\n265\t      case 'leaveFamily': {\n266\t        let user = this.users.get(`user_${openid}`);\n267\t        if (!user || !user.familyId) {\n268\t          return { success: true, message: '当前未加入任何家庭' };\n269\t        }\n270\t        this.leaveFamilyInternal(openid, user.familyId);\n271\t        user.familyId = null;\n272\t        user.role = null;\n273\t        user.updatedAt = now;\n274\t        this.users.set(`user_${openid}`, user);\n275\t        this.persist();\n276\t        return { success: true, message: '已退出家庭厨房空间' };\n277\t      }\n278\t\n279\t      case 'refreshInviteCode': {\n280\t        const { familyId } = data;\n281\t        const family = this.families.get(familyId);\n282\t        if (!family) return { success: false, error: '家庭不存在' };\n283\t\n284\t        if (!family.memberOpenids.includes(openid)) {\n285\t          return { success: false, error: '无权操作非本人所属家庭' };\n286\t        }\n287\t\n288\t        const newCode = this.generateUniqueInviteCode();\n289\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n290\t        family.inviteCode = newCode;\n291\t        family.inviteExpiredAt = newExpiry;\n292\t        family.updatedAt = now;\n293\t\n294\t        this.persist();\n295\t        return { success: true, inviteCode: newCode, inviteExpiredAt: newExpiry };\n296\t      }\n297\t\n298\t      case 'getFamily': {\n299\t        const { familyId } = data;\n300\t        const family = this.families.get(familyId);\n301\t        if (!family) return { success: false, error: '家庭不存在' };\n302\t\n303\t        // 敏感信息保护：非家庭成员不泄露敏感的邀请码与成员详情\n304\t        if (data.mockOpenid && (!family.memberOpenids || !family.memberOpenids.includes(data.mockOpenid))) {\n305\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n306\t        }\n307\t\n308\t        return { success: true, family };\n309\t      }\n310\t\n311\t      default:\n312\t        return { success: false, error: `不支持的操作类型: ${action}` };\n313\t    }\n314\t  }\n315\t\n316\t  private leaveFamilyInternal(openid: string, familyId: string) {\n317\t    const family = this.families.get(familyId);\n318\t    if (!family) return;\n319\t    family.members = family.members.filter(m => m.openid !== openid);\n320\t    family.memberOpenids = family.memberOpenids.filter(id => id !== openid);\n321\t    if (family.members.length === 0) {\n322\t      this.families.delete(familyId);\n323\t    } else {\n324\t      if (family.creatorOpenid === openid) {\n325\t        family.creatorOpenid = family.members[0].openid;\n326\t        family.members[0].role = 'creator';\n327\t      }\n328\t      family.updatedAt = Date.now();\n329\t    }\n330\t  }\n331\t\n332\t  public handleUpsertMeal(data: any): any {\n333\t    const { action = 'upsertMeal' } = data;\n334\t    const openid = this.getOpenid(data);\n335\t    const now = Date.now();\n336\t\n337\t    switch (action) {\n338\t      case 'upsertMeal': {\n339\t        const { familyId, date, meal } = data;\n340\t        if (!familyId || !date || !meal) {\n341\t          return { success: false, error: '缺少参数 familyId/date/meal' };\n342\t        }\n343\t\n344\t        // 服务端鉴权：确认该用户确实属于该家庭\n345\t        const family = this.families.get(familyId);\n346\t        if (family && !family.memberOpenids.includes(openid)) {\n347\t          return { success: false, error: '越权操作：您不属于该家庭空间' };\n348\t        }\n349\t\n350\t        const docKey = `meal_${familyId}_${date}`;\n351\t        let doc = this.mealHistory.get(docKey);\n352\t\n353\t        const mealSnapshot: SingleMealItem = {\n354\t          mealId: meal.mealId || `m_${now}`,\n355\t          mealType: meal.mealType || '午餐',\n356\t          mode: meal.mode || 'hearty_3_1',\n357\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n358\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n359\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n360\t          confirmedBy: openid,\n361\t          confirmedByName: meal.confirmedByName || data.nickName || '家人',\n362\t          timestamp: meal.timestamp || now\n363\t        };\n364\t\n365\t        if (!doc) {\n366\t          doc = {\n367\t            _id: docKey,\n368\t            familyId,\n369\t            date,\n370\t            meals: [mealSnapshot],\n371\t            updatedAt: now\n372\t          };\n373\t        } else {\n374\t          const meals = doc.meals || [];\n375\t          const idx = meals.findIndex((m: any) => m.mealId === mealSnapshot.mealId);\n376\t          if (idx >= 0) {\n377\t            meals[idx] = mealSnapshot;\n378\t          } else {\n379\t            meals.push(mealSnapshot);\n380\t          }\n381\t          doc.meals = meals;\n382\t          doc.updatedAt = now;\n383\t        }\n384\t\n385\t        this.mealHistory.set(docKey, doc);\n386\t        this.persist();\n387\t        return { success: true, docId: docKey, meal: mealSnapshot };\n388\t      }\n389\t\n390\t      case 'getHistory': {\n391\t        const { familyId, limitDays = 60 } = data;\n392\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n393\t\n394\t        // 鉴权检查：如果传入了 mockOpenid 或有当前身份，校验是否在家庭中\n395\t        if (data.mockOpenid) {\n396\t          const family = this.families.get(familyId);\n397\t          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n398\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n399\t          }\n400\t        }\n401\t\n402\t        const allMeals: any[] = [];\n403\t        for (const [key, doc] of this.mealHistory.entries()) {\n404\t          if (doc.familyId === familyId) {\n405\t            for (const m of (doc.meals || [])) {\n406\t              allMeals.push({\n407\t                id: m.mealId,\n408\t                menuId: m.mealId,\n409\t                mealId: m.mealId,\n410\t                date: doc.date,\n411\t                timestamp: m.timestamp,\n412\t                mode: m.mode,\n413\t                mealType: m.mealType,\n414\t                dishIds: m.dishIds,\n415\t                dishNames: m.dishNames,\n416\t                dishes: m.dishes,\n417\t                confirmedBy: m.confirmedBy,\n418\t                confirmedByName: m.confirmedByName,\n419\t                familyId: doc.familyId,\n420\t                syncStatus: 'synced'\n421\t              });\n422\t            }\n423\t          }\n424\t        }\n425\t\n426\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n427\t        return { success: true, records: allMeals.slice(0, limitDays * 3) };\n428\t      }\n429\t\n430\t      default:\n431\t        return { success: false, error: `不支持的操作类型: ${action}` };\n432\t    }\n433\t  }\n434\t\n435\t  public handleCustomDish(data: any): any {\n436\t    const { action = 'addDish' } = data;\n437\t    const openid = this.getOpenid(data);\n438\t    const now = Date.now();\n439\t\n440\t    switch (action) {\n441\t      case 'addDish': {\n442\t        const name = String(data.name || '').trim();\n443\t        if (!name) return { success: false, error: '菜品名称不能为空' };\n444\t        if (name.length > 20) return { success: false, error: '菜品名称不能超过20个字' };\n445\t\n446\t        // 敏感词检测 (易错点 7 防御)\n447\t        const checkText = `${name} ${(data.taste || []).join(' ')} ${(data.ingredients || []).join(' ')}`;\n448\t        if (this.hasSensitiveContent(name) || this.hasSensitiveContent(checkText)) {\n449\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n450\t        }\n451\t\n452\t        // 隔离桶：未加入家庭的私房菜使用 personal_${openid}，严禁所有单人用户共用 'personal' 桶\n453\t        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n454\t        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n455\t\n456\t        // 服务端家庭鉴权\n457\t        if (!isPersonal) {\n458\t          const family = this.families.get(familyId);\n459\t          if (family && !family.memberOpenids.includes(openid)) {\n460\t            return { success: false, error: '越权操作：您不属于该家庭空间' };\n461\t          }\n462\t        }\n463\t\n464\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n465\t        const category = data.category || 'secondary_meat';\n466\t\n467\t        const newDish = {\n468\t          _id: dishId,\n469\t          id: dishId,\n470\t          familyId,\n471\t          creatorOpenid: openid,\n472\t          creatorName: data.creatorName || data.nickName || '家人',\n473\t          name,\n474\t          category,\n475\t          taste: Array.isArray(data.taste) ? data.taste : ['家常'],\n476\t          cookingTimeMinutes: Number(data.cookingTimeMinutes) || 25,\n477\t          ingredients: Array.isArray(data.ingredients) ? data.ingredients : [],\n478\t          enabled: true,\n479\t          isCustom: true,\n480\t          createdAt: now\n481\t        };\n482\t\n483\t        const list = this.customDishes.get(familyId) || [];\n484\t        list.unshift(newDish);\n485\t        this.customDishes.set(familyId, list);\n486\t        this.persist();\n487\t\n488\t        return { success: true, dish: newDish };\n489\t      }\n490\t\n491\t      case 'getDishes': {\n492\t        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n493\t        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n494\t\n495\t        // 服务端家庭鉴权\n496\t        if (!isPersonal && data.mockOpenid) {\n497\t          const family = this.families.get(familyId);\n498\t          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n499\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n500\t          }\n501\t        }\n502\t\n503\t        const list = this.customDishes.get(familyId) || [];\n504\t        return { success: true, dishes: list };\n505\t      }\n506\t\n507\t      default:\n508\t        return { success: false, error: `不支持的操作类型: ${action}` };\n509\t    }\n510\t  }\n511\t}\n512\t\n513\texport class CloudService {\n514\t  private mockDb = new LocalCloudMockDatabase();\n515\t  private isCloudAvailable: boolean | null = null;\n516\t  private forceMock: boolean = false;\n517\t\n518\t  public getMockDb() {\n519\t    return this.mockDb;\n520\t  }\n521\t\n522\t  public setForceMock(mock: boolean) {\n523\t    this.forceMock = mock;\n524\t  }\n525\t\n526\t  public resetAvailability() {\n527\t    this.isCloudAvailable = null;\n528\t  }\n529\t\n530\t  /**\n531\t   * 判断当前微信环境是否真正支持并开通了云开发\n532\t   */\n533\t  public checkCloudAvailability(): boolean {\n534\t    if (this.forceMock) return false;\n535\t    if (this.isCloudAvailable !== null) return this.isCloudAvailable;\n536\t    if (typeof wx !== 'undefined' && wx.cloud && typeof wx.cloud.callFunction === 'function') {\n537\t      this.isCloudAvailable = true;\n538\t    } else {\n539\t      this.isCloudAvailable = false;\n540\t    }\n541\t    return this.isCloudAvailable;\n542\t  }\n543\t\n544\t  /**\n545\t   * 统一云函数调用方法\n546\t   * 真实微信小程序环境下：严禁网络报错后假成功降级返回 Mock！一律返回失败交由离线待同步队列重试。\n547\t   * 本地仿真 Mock 仅在无微信环境（Node.js 本地单测）或本地强制模拟模式下生效。\n548\t   */\n549\t  public async callFunction<T = any>(name: string, data: any = {}): Promise<CloudResponse<T>> {\n550\t    const hasCloud = this.checkCloudAvailability();\n551\t\n552\t    if (hasCloud) {\n553\t      try {\n554\t        const res = await wx.cloud.callFunction({\n555\t          name,\n556\t          data\n557\t        });\n558\t        if (res && res.result) {\n559\t          return res.result as CloudResponse<T>;\n560\t        }\n561\t        return { success: false, error: '云函数返回空结果' };\n562\t      } catch (err: any) {\n563\t        const errMsg = err?.errMsg || err?.message || String(err);\n564\t        console.warn(`[CloudService] 云函数 ${name} 线上调用失败:`, errMsg);\n565\t        // 严格遵循第 1 项要求：严禁降级返回 Mock 的 success！一律返回 { success: false, error: err.message }\n566\t        return { success: false, error: err?.message || errMsg };\n567\t      }\n568\t    }\n569\t\n570\t    // 本地仿真降级处理 (仅在无微信环境下使用)\n571\t    return this.invokeLocalMock(name, data);\n572\t  }\n573\t\n574\t  /**\n575\t   * 本地 Mock 逻辑分发\n576\t   */\n577\t  private invokeLocalMock(name: string, data: any): CloudResponse<any> {\n578\t    switch (name) {\n579\t      case 'userAuth':\n580\t        return this.mockDb.handleUserAuth(data);\n581\t      case 'familyManage':\n582\t        return this.mockDb.handleFamilyManage(data);\n583\t      case 'upsertMeal':\n584\t        return this.mockDb.handleUpsertMeal(data);\n585\t      case 'customDish':\n586\t        return this.mockDb.handleCustomDish(data);\n587\t      default:\n588\t        return { success: false, error: `未知云函数: ${name}` };\n589\t    }\n590\t  }\n591\t}\n592\t\n593\texport const cloudService = new CloudService();\n594\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"0bf0f78b-86f7-4a74-aad5-528404a1c7d1","timestamp":"2026-10-02T13:33:46.453Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/cloudService.ts","content":"/**\n * 微信云开发服务网关 (CloudService)\n * 职责：\n * 1. 统一封装 wx.cloud.callFunction 调用\n * 2. 真实小程序环境下云函数报错严禁降级返回 Mock 假成功，一律返回失败交由离线队列重试\n * 3. 在无微信环境（Node.js 单测）或强制模拟模式下，提供高保真本地 Mock 状态机仿真\n * 4. 严格保障 4 人上限、24小时邀请码、一人一家庭排他与同日多餐写入\n */\n\nimport type { FamilySpace, UserProfile, SingleMealItem, CustomDishRecord } from '../types/family.js';\n\ninterface CloudResponse<T = any> {\n  success: boolean;\n  result?: T;\n  error?: string;\n  [key: string]: any;\n}\n\nclass LocalCloudMockDatabase {\n  private users = new Map<string, any>();\n  private families = new Map<string, any>();\n  private mealHistory = new Map<string, any>(); // key: meal_${familyId}_${date}\n  private customDishes = new Map<string, any[]>(); // key: familyId -> dish[]\n  private sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n  constructor() {\n    this.restoreFromStorage();\n  }\n\n  private hasSensitiveContent(text: string): boolean {\n    if (!text) return false;\n    const str = String(text);\n    return this.sensitiveWords.some(w => str.includes(w));\n  }\n\n  private generateUniqueInviteCode(): string {\n    const now = Date.now();\n    for (let attempt = 0; attempt < 10; attempt++) {\n      const code = String(Math.floor(100000 + Math.random() * 900000));\n      let isDuplicate = false;\n      for (const fam of this.families.values()) {\n        if (fam.inviteCode === code && fam.inviteExpiredAt > now) {\n          isDuplicate = true;\n          break;\n        }\n      }\n      if (!isDuplicate) return code;\n    }\n    return String(Math.floor(100000 + Math.random() * 900000));\n  }\n\n  private getOpenid(data: any): string {\n    if (data?.mockOpenid) return data.mockOpenid;\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const user = wx.getStorageSync('current_user_profile');\n        if (user && user.openid) return user.openid;\n      }\n    } catch (e) {}\n    return 'mock_openid_default';\n  }\n\n  private restoreFromStorage() {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const storedUsers = wx.getStorageSync('mock_db_users');\n        if (storedUsers) this.users = new Map(Object.entries(storedUsers));\n\n        const storedFamilies = wx.getStorageSync('mock_db_families');\n        if (storedFamilies) this.families = new Map(Object.entries(storedFamilies));\n\n        const storedHistory = wx.getStorageSync('mock_db_history');\n        if (storedHistory) this.mealHistory = new Map(Object.entries(storedHistory));\n\n        const storedDishes = wx.getStorageSync('mock_db_custom_dishes');\n        if (storedDishes) this.customDishes = new Map(Object.entries(storedDishes));\n      }\n    } catch (e) {}\n  }\n\n  private persist() {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync('mock_db_users', Object.fromEntries(this.users));\n        wx.setStorageSync('mock_db_families', Object.fromEntries(this.families));\n        wx.setStorageSync('mock_db_history', Object.fromEntries(this.mealHistory));\n        wx.setStorageSync('mock_db_custom_dishes', Object.fromEntries(this.customDishes));\n      }\n    } catch (e) {}\n  }\n\n  public clearAll() {\n    this.users.clear();\n    this.families.clear();\n    this.mealHistory.clear();\n    this.customDishes.clear();\n    this.persist();\n  }\n\n  public handleUserAuth(data: any): any {\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n    let user = this.users.get(`user_${openid}`);\n\n    if (!user) {\n      user = {\n        _id: `user_${openid}`,\n        _openid: openid,\n        nickName: data?.nickName || '家人',\n        avatarUrl: data?.avatarUrl || '',\n        familyId: null,\n        role: null,\n        createdAt: now,\n        updatedAt: now\n      };\n      this.users.set(`user_${openid}`, user);\n    } else {\n      if (data?.nickName) user.nickName = data.nickName;\n      if (data?.avatarUrl) user.avatarUrl = data.avatarUrl;\n      user.updatedAt = now;\n    }\n\n    let family = null;\n    if (user.familyId) {\n      family = this.families.get(user.familyId) || null;\n      if (!family) {\n        user.familyId = null;\n        user.role = null;\n      }\n    }\n\n    this.persist();\n    return { success: true, openid, user, family };\n  }\n\n  public handleFamilyManage(data: any): any {\n    const { action } = data;\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n\n    switch (action) {\n      case 'createFamily': {\n        const familyName = (data.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = data.nickName || '房主';\n\n        // 文本合规检验\n        if (this.hasSensitiveContent(familyName) || this.hasSensitiveContent(nickName)) {\n          return { success: false, error: '家庭名称或昵称包含敏感词，请修改后重试' };\n        }\n\n        let user = this.users.get(`user_${openid}`) || {\n          _id: `user_${openid}`,\n          _openid: openid,\n          nickName,\n          familyId: null\n        };\n\n        // 如果用户在旧家庭中，先退出\n        if (user.familyId && this.families.has(user.familyId)) {\n          this.leaveFamilyInternal(openid, user.familyId);\n        }\n\n        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const inviteCode = this.generateUniqueInviteCode();\n        const inviteExpiredAt = now + 24 * 60 * 60 * 1000;\n\n        const newFamily: FamilySpace = {\n          id: familyId,\n          name: familyName,\n          creatorOpenid: openid,\n          members: [\n            {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: data.avatarUrl || user.avatarUrl || '',\n              role: 'creator',\n              joinedAt: now\n            }\n          ],\n          memberOpenids: [openid],\n          inviteCode,\n          inviteExpiredAt,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        this.families.set(familyId, newFamily);\n        user.familyId = familyId;\n        user.role = 'creator';\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n\n        this.persist();\n        return { success: true, family: newFamily };\n      }\n\n      case 'joinFamily': {\n        const inviteCode = String(data.inviteCode || '').trim();\n        if (!inviteCode || inviteCode.length !== 6) {\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const nickName = data.nickName || '家人';\n        if (this.hasSensitiveContent(nickName)) {\n          return { success: false, error: '成员昵称包含敏感词，请修改后重试' };\n        }\n\n        let targetFamily: FamilySpace | null = null;\n        for (const fam of this.families.values()) {\n          if (fam.inviteCode === inviteCode) {\n            targetFamily = fam;\n            break;\n          }\n        }\n\n        if (!targetFamily) {\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        if (now > targetFamily.inviteExpiredAt) {\n          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n        }\n\n        if (targetFamily.memberOpenids.includes(openid)) {\n          return { success: true, family: targetFamily, message: '您已经在该家庭厨房中' };\n        }\n\n        // 严格 4 人限制 (易错点 2 防御)\n        if (targetFamily.memberOpenids.length >= 4) {\n          return { success: false, error: '该家庭厨房成员已满（上限4人），无法继续加入' };\n        }\n\n        // 一人一家庭排他 (易错点 3 防御)\n        let user = this.users.get(`user_${openid}`) || {\n          _id: `user_${openid}`,\n          _openid: openid,\n          nickName,\n          familyId: null\n        };\n        if (user.familyId && user.familyId !== targetFamily.id && this.families.has(user.familyId)) {\n          this.leaveFamilyInternal(openid, user.familyId);\n        }\n\n        const newMember = {\n          openid,\n          nickName: nickName || user.nickName || '家人',\n          avatarUrl: data.avatarUrl || user.avatarUrl || '',\n          role: 'member' as const,\n          joinedAt: now\n        };\n\n        targetFamily.members.push(newMember);\n        targetFamily.memberOpenids.push(openid);\n        targetFamily.updatedAt = now;\n\n        user.familyId = targetFamily.id;\n        user.role = 'member';\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n\n        this.persist();\n        return { success: true, family: targetFamily };\n      }\n\n      case 'leaveFamily': {\n        let user = this.users.get(`user_${openid}`);\n        if (!user || !user.familyId) {\n          return { success: true, message: '当前未加入任何家庭' };\n        }\n        this.leaveFamilyInternal(openid, user.familyId);\n        user.familyId = null;\n        user.role = null;\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n        this.persist();\n        return { success: true, message: '已退出家庭厨房空间' };\n      }\n\n      case 'refreshInviteCode': {\n        const { familyId } = data;\n        const family = this.families.get(familyId);\n        if (!family) return { success: false, error: '家庭不存在' };\n\n        if (!family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = this.generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n        family.inviteCode = newCode;\n        family.inviteExpiredAt = newExpiry;\n        family.updatedAt = now;\n\n        this.persist();\n        return { success: true, inviteCode: newCode, inviteExpiredAt: newExpiry };\n      }\n\n      case 'getFamily': {\n        const { familyId } = data;\n        const family = this.families.get(familyId);\n        if (!family) return { success: false, error: '家庭不存在' };\n\n        // 敏感信息保护：非家庭成员不泄露敏感的邀请码与成员详情\n        if (data.mockOpenid && (!family.memberOpenids || !family.memberOpenids.includes(data.mockOpenid))) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return { success: true, family };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n\n  private leaveFamilyInternal(openid: string, familyId: string) {\n    const family = this.families.get(familyId);\n    if (!family) return;\n    family.members = family.members.filter(m => m.openid !== openid);\n    family.memberOpenids = family.memberOpenids.filter(id => id !== openid);\n    if (family.members.length === 0) {\n      this.families.delete(familyId);\n    } else {\n      if (family.creatorOpenid === openid) {\n        family.creatorOpenid = family.members[0].openid;\n        family.members[0].role = 'creator';\n      }\n      family.updatedAt = Date.now();\n    }\n  }\n\n  public handleUpsertMeal(data: any): any {\n    const { action = 'upsertMeal' } = data;\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n\n    switch (action) {\n      case 'upsertMeal': {\n        const { familyId, date, meal } = data;\n        if (!familyId || !date || !meal) {\n          return { success: false, error: '缺少参数 familyId/date/meal' };\n        }\n\n        // 服务端鉴权：确认该用户确实属于该家庭\n        const family = this.families.get(familyId);\n        if (family && !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '越权操作：您不属于该家庭空间' };\n        }\n\n        const docKey = `meal_${familyId}_${date}`;\n        let doc = this.mealHistory.get(docKey);\n\n        const mealSnapshot: SingleMealItem = {\n          mealId: meal.mealId || `m_${now}`,\n          mealType: meal.mealType || '午餐',\n          mode: meal.mode || 'hearty_3_1',\n          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n          confirmedBy: openid,\n          confirmedByName: meal.confirmedByName || data.nickName || '家人',\n          timestamp: meal.timestamp || now\n        };\n\n        if (!doc) {\n          doc = {\n            _id: docKey,\n            familyId,\n            date,\n            meals: [mealSnapshot],\n            updatedAt: now\n          };\n        } else {\n          const meals = doc.meals || [];\n          const idx = meals.findIndex((m: any) => m.mealId === mealSnapshot.mealId);\n          if (idx >= 0) {\n            meals[idx] = mealSnapshot;\n          } else {\n            meals.push(mealSnapshot);\n          }\n          doc.meals = meals;\n          doc.updatedAt = now;\n        }\n\n        this.mealHistory.set(docKey, doc);\n        this.persist();\n        return { success: true, docId: docKey, meal: mealSnapshot };\n      }\n\n      case 'getHistory': {\n        const { familyId, limitDays = 60 } = data;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        // 鉴权检查：如果传入了 mockOpenid 或有当前身份，校验是否在家庭中\n        if (data.mockOpenid) {\n          const family = this.families.get(familyId);\n          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n            return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n          }\n        }\n\n        const allMeals: any[] = [];\n        for (const [key, doc] of this.mealHistory.entries()) {\n          if (doc.familyId === familyId) {\n            for (const m of (doc.meals || [])) {\n              allMeals.push({\n                id: m.mealId,\n                menuId: m.mealId,\n                mealId: m.mealId,\n                date: doc.date,\n                timestamp: m.timestamp,\n                mode: m.mode,\n                mealType: m.mealType,\n                dishIds: m.dishIds,\n                dishNames: m.dishNames,\n                dishes: m.dishes,\n                confirmedBy: m.confirmedBy,\n                confirmedByName: m.confirmedByName,\n                familyId: doc.familyId,\n                syncStatus: 'synced'\n              });\n            }\n          }\n        }\n\n        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n        return { success: true, records: allMeals.slice(0, limitDays * 3) };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n\n  public handleCustomDish(data: any): any {\n    const { action = 'addDish' } = data;\n    const openid = this.getOpenid(data);\n    const now = Date.now();\n\n    switch (action) {\n      case 'addDish': {\n        const name = String(data.name || '').trim();\n        if (!name) return { success: false, error: '菜品名称不能为空' };\n        if (name.length > 20) return { success: false, error: '菜品名称不能超过20个字' };\n\n        // 敏感词检测 (易错点 7 防御)\n        const checkText = `${name} ${(data.taste || []).join(' ')} ${(data.ingredients || []).join(' ')}`;\n        if (this.hasSensitiveContent(name) || this.hasSensitiveContent(checkText)) {\n          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n        }\n\n        // 隔离桶：未加入家庭的私房菜使用 personal_${openid}，严禁所有单人用户共用 'personal' 桶\n        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n\n        // 服务端家庭鉴权\n        if (!isPersonal) {\n          const family = this.families.get(familyId);\n          if (family && !family.memberOpenids.includes(openid)) {\n            return { success: false, error: '越权操作：您不属于该家庭空间' };\n          }\n        }\n\n        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const category = data.category || 'secondary_meat';\n\n        const newDish = {\n          _id: dishId,\n          id: dishId,\n          familyId,\n          creatorOpenid: openid,\n          creatorName: data.creatorName || data.nickName || '家人',\n          name,\n          category,\n          taste: Array.isArray(data.taste) ? data.taste : ['家常'],\n          cookingTimeMinutes: Number(data.cookingTimeMinutes) || 25,\n          ingredients: Array.isArray(data.ingredients) ? data.ingredients : [],\n          enabled: true,\n          isCustom: true,\n          createdAt: now\n        };\n\n        const list = this.customDishes.get(familyId) || [];\n        list.unshift(newDish);\n        this.customDishes.set(familyId, list);\n        this.persist();\n\n        return { success: true, dish: newDish };\n      }\n\n      case 'getDishes': {\n        const isPersonal = !data.familyId || data.familyId === 'personal' || data.familyId.startsWith('personal_');\n        const familyId = isPersonal ? `personal_${openid}` : data.familyId;\n\n        // 服务端家庭鉴权\n        if (!isPersonal && data.mockOpenid) {\n          const family = this.families.get(familyId);\n          if (family && !family.memberOpenids.includes(data.mockOpenid)) {\n            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n          }\n        }\n\n        const list = this.customDishes.get(familyId) || [];\n        return { success: true, dishes: list };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n}\n\nexport class CloudService {\n  private mockDb = new LocalCloudMockDatabase();\n  private isCloudAvailable: boolean | null = null;\n  private forceMock: boolean = false;\n\n  public getMockDb() {\n    return this.mockDb;\n  }\n\n  public setForceMock(mock: boolean) {\n    this.forceMock = mock;\n  }\n\n  public resetAvailability() {\n    this.isCloudAvailable = null;\n  }\n\n  /**\n   * 判断当前微信环境是否真正支持并开通了云开发\n   */\n  public checkCloudAvailability(): boolean {\n    if (this.forceMock) return false;\n    if (this.isCloudAvailable !== null) return this.isCloudAvailable;\n    if (typeof wx !== 'undefined' && wx.cloud && typeof wx.cloud.callFunction === 'function') {\n      this.isCloudAvailable = true;\n    } else {\n      this.isCloudAvailable = false;\n    }\n    return this.isCloudAvailable;\n  }\n\n  /**\n   * 统一云函数调用方法\n   * 真实微信小程序环境下：严禁网络报错后假成功降级返回 Mock！一律返回失败交由离线待同步队列重试。\n   * 本地仿真 Mock 仅在无微信环境（Node.js 本地单测）或本地强制模拟模式下生效。\n   */\n  public async callFunction<T = any>(name: string, data: any = {}): Promise<CloudResponse<T>> {\n    const hasCloud = this.checkCloudAvailability();\n\n    if (hasCloud) {\n      try {\n        const res = await wx.cloud.callFunction({\n          name,\n          data\n        });\n        if (res && res.result) {\n          return res.result as CloudResponse<T>;\n        }\n        return { success: false, error: '云函数返回空结果' };\n      } catch (err: any) {\n        const errMsg = err?.errMsg || err?.message || String(err);\n        console.warn(`[CloudService] 云函数 ${name} 线上调用失败:`, errMsg);\n        // 严格遵循第 1 项要求：严禁降级返回 Mock 的 success！一律返回 { success: false, error: err.message }\n        return { success: false, error: err?.message || errMsg };\n      }\n    }\n\n    // 本地仿真降级处理 (仅在无微信环境下使用)\n    return this.invokeLocalMock(name, data);\n  }\n\n  /**\n   * 本地 Mock 逻辑分发\n   */\n  private invokeLocalMock(name: string, data: any): CloudResponse<any> {\n    switch (name) {\n      case 'userAuth':\n        return this.mockDb.handleUserAuth(data);\n      case 'familyManage':\n        return this.mockDb.handleFamilyManage(data);\n      case 'upsertMeal':\n        return this.mockDb.handleUpsertMeal(data);\n      case 'customDish':\n        return this.mockDb.handleCustomDish(data);\n      default:\n        return { success: false, error: `未知云函数: ${name}` };\n    }\n  }\n}\n\nexport const cloudService = new CloudService();\n","numLines":594,"startLine":1,"totalLines":594}}}
