{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UPKNxu5A86MseTQn77FLcf","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\tconst _ = db.command;\n9\t\n10\texports.main = async (event, context) => {\n11\t  const wxContext = cloud.getWXContext();\n12\t  let openid = wxContext && wxContext.OPENID;\n13\t\n14\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n15\t  if (!openid) {\n16\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n17\t      openid = event.mockOpenid || 'mock_openid_default';\n18\t    } else {\n19\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n20\t    }\n21\t  }\n22\t\n23\t  const { action = 'upsertMeal' } = event;\n24\t  const now = Date.now();\n25\t\n26\t  try {\n27\t    switch (action) {\n28\t      /**\n29\t       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n30\t       * 彻底杜绝同日多次做菜被覆盖问题\n31\t       */\n32\t      case 'upsertMeal': {\n33\t        const { familyId, date, meal } = event;\n34\t        if (!familyId || !date || !meal) {\n35\t          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n36\t        }\n37\t\n38\t        // 服务端鉴权：验证 openid 确实属于该家庭\n39\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n40\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n41\t          return { success: false, error: '越权操作：您不属于该家庭空间' };\n42\t        }\n43\t\n44\t        const docId = `meal_${familyId}_${date}`;\n45\t\n46\t        // 规范化单餐快照数据\n47\t        const mealSnapshot = {\n48\t          mealId: meal.mealId || `m_${now}`,\n49\t          mealType: meal.mealType || '午餐',\n50\t          mode: meal.mode || 'hearty_3_1',\n51\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n52\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n53\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n54\t          confirmedBy: openid,\n55\t          confirmedByName: meal.confirmedByName || event.nickName || '家人',\n56\t          timestamp: meal.timestamp || now\n57\t        };\n58\t\n59\t        return await db.runTransaction(async transaction => {\n60\t          const docRef = transaction.collection('meal_history').doc(docId);\n61\t          const existingDoc = await docRef.get().catch(() => null);\n62\t\n63\t          if (!existingDoc || !existingDoc.data) {\n64\t            // 该日首次开饭，创建日文档\n65\t            await docRef.set({\n66\t              data: {\n67\t                _id: docId,\n68\t                familyId,\n69\t                date,\n70\t                meals: [mealSnapshot],\n71\t                updatedAt: now\n72\t              }\n73\t            });\n74\t          } else {\n75\t            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n76\t            const existingMeals = existingDoc.data.meals || [];\n77\t            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n78\t\n79\t            let updatedMeals;\n80\t            if (mealIndex >= 0) {\n81\t              // 同一餐次就地更新 (如反复确认)\n82\t              updatedMeals = [...existingMeals];\n83\t              updatedMeals[mealIndex] = mealSnapshot;\n84\t            } else {\n85\t              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n86\t              updatedMeals = [...existingMeals, mealSnapshot];\n87\t            }\n88\t\n89\t            await docRef.update({\n90\t              data: {\n91\t                meals: updatedMeals,\n92\t                updatedAt: now\n93\t              }\n94\t            });\n95\t          }\n96\t\n97\t          return {\n98\t            success: true,\n99\t            docId,\n100\t            meal: mealSnapshot\n101\t          };\n102\t        });\n103\t      }\n104\t\n105\t      /**\n106\t       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n107\t       */\n108\t      case 'getHistory': {\n109\t        const { familyId, limitDays = 60 } = event;\n110\t        if (!familyId) {\n111\t          return { success: false, error: '缺少 familyId' };\n112\t        }\n113\t\n114\t        // 服务端鉴权：验证 openid 确实属于该家庭\n115\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n116\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n117\t          return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n118\t        }\n119\t\n120\t        // 查询该家庭最近的日文档\n121\t        const res = await db.collection('meal_history')\n122\t          .where({ familyId })\n123\t          .orderBy('date', 'desc')\n124\t          .limit(limitDays)\n125\t          .get();\n126\t\n127\t        const docs = res.data || [];\n128\t        // 展平为有序餐次列表供客户端秒级合并\n129\t        const allMeals = [];\n130\t        for (const doc of docs) {\n131\t          for (const m of (doc.meals || [])) {\n132\t            allMeals.push({\n133\t              id: m.mealId,\n134\t              menuId: m.mealId,\n135\t              mealId: m.mealId,\n136\t              date: doc.date,\n137\t              timestamp: m.timestamp,\n138\t              mode: m.mode,\n139\t              mealType: m.mealType,\n140\t              dishIds: m.dishIds,\n141\t              dishNames: m.dishNames,\n142\t              dishes: m.dishes,\n143\t              confirmedBy: m.confirmedBy,\n144\t              confirmedByName: m.confirmedByName,\n145\t              familyId: doc.familyId,\n146\t              syncStatus: 'synced'\n147\t            });\n148\t          }\n149\t        }\n150\t\n151\t        // 按时间戳倒序排列\n152\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n153\t\n154\t        return {\n155\t          success: true,\n156\t          records: allMeals,\n157\t          docs\n158\t        };\n159\t      }\n160\t\n161\t      default:\n162\t        return { success: false, error: `不支持的操作类型: ${action}` };\n163\t    }\n164\t  } catch (err) {\n165\t    return {\n166\t      success: false,\n167\t      error: err.message || '历史记录同步失败'\n168\t    };\n169\t  }\n170\t};\n171\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"42299bcd-21d4-4ed0-b771-6a0d54815458","timestamp":"2026-10-02T13:33:18.479Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/upsertMeal/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action = 'upsertMeal' } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n       * 彻底杜绝同日多次做菜被覆盖问题\n       */\n      case 'upsertMeal': {\n        const { familyId, date, meal } = event;\n        if (!familyId || !date || !meal) {\n          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n        }\n\n        // 服务端鉴权：验证 openid 确实属于该家庭\n        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n          return { success: false, error: '越权操作：您不属于该家庭空间' };\n        }\n\n        const docId = `meal_${familyId}_${date}`;\n\n        // 规范化单餐快照数据\n        const mealSnapshot = {\n          mealId: meal.mealId || `m_${now}`,\n          mealType: meal.mealType || '午餐',\n          mode: meal.mode || 'hearty_3_1',\n          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n          confirmedBy: openid,\n          confirmedByName: meal.confirmedByName || event.nickName || '家人',\n          timestamp: meal.timestamp || now\n        };\n\n        return await db.runTransaction(async transaction => {\n          const docRef = transaction.collection('meal_history').doc(docId);\n          const existingDoc = await docRef.get().catch(() => null);\n\n          if (!existingDoc || !existingDoc.data) {\n            // 该日首次开饭，创建日文档\n            await docRef.set({\n              data: {\n                _id: docId,\n                familyId,\n                date,\n                meals: [mealSnapshot],\n                updatedAt: now\n              }\n            });\n          } else {\n            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n            const existingMeals = existingDoc.data.meals || [];\n            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n\n            let updatedMeals;\n            if (mealIndex >= 0) {\n              // 同一餐次就地更新 (如反复确认)\n              updatedMeals = [...existingMeals];\n              updatedMeals[mealIndex] = mealSnapshot;\n            } else {\n              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n              updatedMeals = [...existingMeals, mealSnapshot];\n            }\n\n            await docRef.update({\n              data: {\n                meals: updatedMeals,\n                updatedAt: now\n              }\n            });\n          }\n\n          return {\n            success: true,\n            docId,\n            meal: mealSnapshot\n          };\n        });\n      }\n\n      /**\n       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n       */\n      case 'getHistory': {\n        const { familyId, limitDays = 60 } = event;\n        if (!familyId) {\n          return { success: false, error: '缺少 familyId' };\n        }\n\n        // 服务端鉴权：验证 openid 确实属于该家庭\n        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n          return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n        }\n\n        // 查询该家庭最近的日文档\n        const res = await db.collection('meal_history')\n          .where({ familyId })\n          .orderBy('date', 'desc')\n          .limit(limitDays)\n          .get();\n\n        const docs = res.data || [];\n        // 展平为有序餐次列表供客户端秒级合并\n        const allMeals = [];\n        for (const doc of docs) {\n          for (const m of (doc.meals || [])) {\n            allMeals.push({\n              id: m.mealId,\n              menuId: m.mealId,\n              mealId: m.mealId,\n              date: doc.date,\n              timestamp: m.timestamp,\n              mode: m.mode,\n              mealType: m.mealType,\n              dishIds: m.dishIds,\n              dishNames: m.dishNames,\n              dishes: m.dishes,\n              confirmedBy: m.confirmedBy,\n              confirmedByName: m.confirmedByName,\n              familyId: doc.familyId,\n              syncStatus: 'synced'\n            });\n          }\n        }\n\n        // 按时间戳倒序排列\n        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n\n        return {\n          success: true,\n          records: allMeals,\n          docs\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '历史记录同步失败'\n    };\n  }\n};\n","numLines":171,"startLine":1,"totalLines":171}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N26dVHJNKPPehm975hqAKt","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\tconst _ = db.command;\n9\t\n10\tconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n11\t\n12\t/**\n13\t * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n14\t */\n15\tasync function checkTextSecurity(text, openid) {\n16\t  if (!text) return { pass: true };\n17\t  const str = String(text).trim();\n18\t  if (!str) return { pass: true };\n19\t\n20\t  // 1. 本地兜底敏感词拦截\n21\t  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n22\t    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n23\t  }\n24\t\n25\t  // 2. 微信官方 msgSecCheck 2.0 规范检测\n26\t  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n27\t    try {\n28\t      const res = await cloud.openapi.security.msgSecCheck({\n29\t        version: 2,\n30\t        scene: 1, // 1: 资料/昵称/家庭名称等\n31\t        openid,\n32\t        content: str\n33\t      });\n34\t      if (!res || !res.result || res.result.suggest !== 'pass') {\n35\t        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n36\t      }\n37\t    } catch (err) {\n38\t      console.error('[familyManage] msgSecCheck 异常:', err);\n39\t      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n40\t    }\n41\t  }\n42\t\n43\t  return { pass: true };\n44\t}\n45\t\n46\t/**\n47\t * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n48\t */\n49\tasync function generateUniqueInviteCode() {\n50\t  const now = Date.now();\n51\t  for (let attempt = 0; attempt < 10; attempt++) {\n52\t    const code = String(Math.floor(100000 + Math.random() * 900000));\n53\t    const existing = await db.collection('families').where({\n54\t      inviteCode: code,\n55\t      inviteExpiredAt: _.gt(now)\n56\t    }).count().catch(() => null);\n57\t\n58\t    if (!existing || existing.total === 0) {\n59\t      return code;\n60\t    }\n61\t  }\n62\t  return String(Math.floor(100000 + Math.random() * 900000));\n63\t}\n64\t\n65\texports.main = async (event, context) => {\n66\t  const wxContext = cloud.getWXContext();\n67\t  let openid = wxContext && wxContext.OPENID;\n68\t\n69\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n70\t  if (!openid) {\n71\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n72\t      openid = event.mockOpenid || 'mock_openid_default';\n73\t    } else {\n74\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n75\t    }\n76\t  }\n77\t\n78\t  const { action } = event;\n79\t  const now = Date.now();\n80\t\n81\t  try {\n82\t    switch (action) {\n83\t      /**\n84\t       * 1. 创建家庭空间\n85\t       */\n86\t      case 'createFamily': {\n87\t        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n88\t        const nickName = (event.nickName || '房主').trim();\n89\t\n90\t        // 安全合规校验：家庭名称与昵称\n91\t        const nameSec = await checkTextSecurity(familyName, openid);\n92\t        if (!nameSec.pass) return { success: false, error: nameSec.error };\n93\t\n94\t        const nickSec = await checkTextSecurity(nickName, openid);\n95\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n96\t\n97\t        const userDocRef = db.collection('users').doc(`user_${openid}`);\n98\t        \n99\t        let user;\n100\t        try {\n101\t          const uRes = await userDocRef.get();\n102\t          user = uRes.data;\n103\t        } catch (e) {\n104\t          user = { _id: `user_${openid}`, _openid: openid, nickName };\n105\t        }\n106\t\n107\t        // 如果用户已在旧家庭中，先处理退出旧家庭\n108\t        if (user.familyId) {\n109\t          try {\n110\t            await leaveCurrentFamilyInternal(openid, user.familyId);\n111\t          } catch (e) {\n112\t            console.warn('退出旧家庭警告', e);\n113\t          }\n114\t        }\n115\t\n116\t        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n117\t        const inviteCode = await generateUniqueInviteCode();\n118\t        const inviteExpiredAt = now + 24 * 60 * 60 * 1000; // 24小时过期\n119\t\n120\t        const newFamily = {\n121\t          _id: familyId,\n122\t          name: familyName,\n123\t          creatorOpenid: openid,\n124\t          members: [\n125\t            {\n126\t              openid,\n127\t              nickName: nickName || user.nickName || '房主',\n128\t              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n129\t              role: 'creator',\n130\t              joinedAt: now\n131\t            }\n132\t          ],\n133\t          memberOpenids: [openid],\n134\t          inviteCode,\n135\t          inviteExpiredAt,\n136\t          createdAt: now,\n137\t          updatedAt: now\n138\t        };\n139\t\n140\t        await db.collection('families').add({ data: newFamily });\n141\t\n142\t        // 更新用户档案\n143\t        await db.collection('users').doc(`user_${openid}`).set({\n144\t          data: {\n145\t            _id: `user_${openid}`,\n146\t            _openid: openid,\n147\t            nickName: nickName || user.nickName || '房主',\n148\t            avatarUrl: event.avatarUrl || user.avatarUrl || '',\n149\t            familyId,\n150\t            role: 'creator',\n151\t            updatedAt: now\n152\t          }\n153\t        });\n154\t\n155\t        return {\n156\t          success: true,\n157\t          family: newFamily\n158\t        };\n159\t      }\n160\t\n161\t      /**\n162\t       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n163\t       */\n164\t      case 'joinFamily': {\n165\t        const inviteCode = String(event.inviteCode || '').trim();\n166\t        if (!inviteCode || inviteCode.length !== 6) {\n167\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n168\t        }\n169\t\n170\t        const memberNickName = (event.nickName || '家人').trim();\n171\t        const nickSec = await checkTextSecurity(memberNickName, openid);\n172\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n173\t\n174\t        // 1. 查询有效且未过期的邀请码\n175\t        const queryRes = await db.collection('families').where({\n176\t          inviteCode,\n177\t          inviteExpiredAt: _.gt(now)\n178\t        }).get();\n179\t\n180\t        if (!queryRes.data || queryRes.data.length === 0) {\n181\t          // 区分是过期还是根本不存在\n182\t          const anyRes = await db.collection('families').where({ inviteCode }).get().catch(() => null);\n183\t          if (anyRes && anyRes.data && anyRes.data.length > 0) {\n184\t            return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n185\t          }\n186\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n187\t        }\n188\t\n189\t        const targetFamilyId = queryRes.data[0]._id;\n190\t\n191\t        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n192\t        try {\n193\t          return await db.runTransaction(async transaction => {\n194\t            const famDoc = await transaction.collection('families').doc(targetFamilyId).get().catch(() => null);\n195\t            if (!famDoc || !famDoc.data) {\n196\t              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n197\t              throw new Error('未找到该邀请口令对应的家庭厨房');\n198\t            }\n199\t\n200\t            const family = famDoc.data;\n201\t\n202\t            // 校验 1: 口令是否已过期 (24 小时有效)\n203\t            if (now > family.inviteExpiredAt) {\n204\t              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n205\t              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n206\t            }\n207\t\n208\t            // 校验 2: 是否已经在该家庭中\n209\t            if (family.memberOpenids && family.memberOpenids.includes(openid)) {\n210\t              return {\n211\t                success: true,\n212\t                family,\n213\t                message: '您已经在该家庭厨房中'\n214\t              };\n215\t            }\n216\t\n217\t            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n218\t            if ((family.memberOpenids || []).length >= 4) {\n219\t              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n220\t              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n221\t            }\n222\t\n223\t            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n224\t            const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n225\t            const oldFamilyId = userDoc?.data?.familyId;\n226\t            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n227\t              const oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get().catch(() => null);\n228\t              if (oldFamDoc?.data) {\n229\t                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n230\t                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n231\t\n232\t                if (remainingMembers.length === 0) {\n233\t                  await transaction.collection('families').doc(oldFamilyId).remove();\n234\t                } else {\n235\t                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n236\t                    ? remainingMembers[0].openid\n237\t                    : oldFamDoc.data.creatorOpenid;\n238\t\n239\t                  if (oldFamDoc.data.creatorOpenid === openid) {\n240\t                    remainingMembers[0].role = 'creator';\n241\t                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n242\t                      data: { role: 'creator', updatedAt: now }\n243\t                    }).catch(() => {});\n244\t                  }\n245\t\n246\t                  await transaction.collection('families').doc(oldFamilyId).update({\n247\t                    data: {\n248\t                      creatorOpenid: newCreator,\n249\t                      members: remainingMembers,\n250\t                      memberOpenids: remainingOpenids,\n251\t                      updatedAt: now\n252\t                    }\n253\t                  });\n254\t                }\n255\t              }\n256\t            }\n257\t\n258\t            // 加入新家庭\n259\t            const newMember = {\n260\t              openid,\n261\t              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n262\t              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n263\t              role: 'member',\n264\t              joinedAt: now\n265\t            };\n266\t\n267\t            const updatedMembers = [...(family.members || []), newMember];\n268\t            const updatedOpenids = [...(family.memberOpenids || []), openid];\n269\t\n270\t            await transaction.collection('families').doc(targetFamilyId).update({\n271\t              data: {\n272\t                members: updatedMembers,\n273\t                memberOpenids: updatedOpenids,\n274\t                updatedAt: now\n275\t              }\n276\t            });\n277\t\n278\t            // 更新用户档案\n279\t            await transaction.collection('users').doc(`user_${openid}`).set({\n280\t              data: {\n281\t                _id: `user_${openid}`,\n282\t                _openid: openid,\n283\t                nickName: newMember.nickName,\n284\t                avatarUrl: newMember.avatarUrl,\n285\t                familyId: targetFamilyId,\n286\t                role: 'member',\n287\t                updatedAt: now\n288\t              }\n289\t            });\n290\t\n291\t            return {\n292\t              success: true,\n293\t              family: {\n294\t                ...family,\n295\t                members: updatedMembers,\n296\t                memberOpenids: updatedOpenids,\n297\t                updatedAt: now\n298\t              }\n299\t            };\n300\t          });\n301\t        } catch (trxErr) {\n302\t          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n303\t          return {\n304\t            success: false,\n305\t            error: errMsg\n306\t          };\n307\t        }\n308\t      }\n309\t\n310\t      /**\n311\t       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n312\t       */\n313\t      case 'leaveFamily': {\n314\t        return await db.runTransaction(async transaction => {\n315\t          const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n316\t          const user = userDoc?.data;\n317\t\n318\t          if (!user || !user.familyId) {\n319\t            return { success: true, message: '当前未加入任何家庭' };\n320\t          }\n321\t\n322\t          const familyId = user.familyId;\n323\t          const famDoc = await transaction.collection('families').doc(familyId).get().catch(() => null);\n324\t\n325\t          if (famDoc && famDoc.data) {\n326\t            const family = famDoc.data;\n327\t            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n328\t            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n329\t\n330\t            if (remainingMembers.length === 0) {\n331\t              await transaction.collection('families').doc(familyId).remove();\n332\t            } else {\n333\t              let newCreatorOpenid = family.creatorOpenid;\n334\t              if (family.creatorOpenid === openid) {\n335\t                newCreatorOpenid = remainingMembers[0].openid;\n336\t                remainingMembers[0].role = 'creator';\n337\t                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n338\t                  data: { role: 'creator', updatedAt: now }\n339\t                }).catch(() => {});\n340\t              }\n341\t\n342\t              await transaction.collection('families').doc(familyId).update({\n343\t                data: {\n344\t                  creatorOpenid: newCreatorOpenid,\n345\t                  members: remainingMembers,\n346\t                  memberOpenids: remainingOpenids,\n347\t                  updatedAt: now\n348\t                }\n349\t              });\n350\t            }\n351\t          }\n352\t\n353\t          // 重置用户家庭归属\n354\t          await transaction.collection('users').doc(`user_${openid}`).update({\n355\t            data: {\n356\t              familyId: null,\n357\t              role: null,\n358\t              updatedAt: now\n359\t            }\n360\t          });\n361\t\n362\t          return { success: true, message: '已退出家庭厨房空间' };\n363\t        });\n364\t      }\n365\t\n366\t      /**\n367\t       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n368\t       */\n369\t      case 'refreshInviteCode': {\n370\t        const { familyId } = event;\n371\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n372\t\n373\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n374\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n375\t\n376\t        const family = famRes.data;\n377\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n378\t          return { success: false, error: '无权操作非本人所属家庭' };\n379\t        }\n380\t\n381\t        const newCode = await generateUniqueInviteCode();\n382\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n383\t\n384\t        await db.collection('families').doc(familyId).update({\n385\t          data: {\n386\t            inviteCode: newCode,\n387\t            inviteExpiredAt: newExpiry,\n388\t            updatedAt: now\n389\t          }\n390\t        });\n391\t\n392\t        return {\n393\t          success: true,\n394\t          inviteCode: newCode,\n395\t          inviteExpiredAt: newExpiry\n396\t        };\n397\t      }\n398\t\n399\t      /**\n400\t       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n401\t       */\n402\t      case 'getFamily': {\n403\t        const { familyId } = event;\n404\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n405\t\n406\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n407\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n408\t\n409\t        const family = famRes.data;\n410\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n411\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n412\t        }\n413\t\n414\t        return {\n415\t          success: true,\n416\t          family\n417\t        };\n418\t      }\n419\t\n420\t      default:\n421\t        return { success: false, error: `不支持的操作类型: ${action}` };\n422\t    }\n423\t  } catch (err) {\n424\t    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n425\t    return {\n426\t      success: false,\n427\t      error: errMsg\n428\t    };\n429\t  }\n430\t};\n431\t\n432\t// 内部事务辅助：退出或重置家庭成员\n433\tasync function leaveCurrentFamilyInternal(openid, familyId) {\n434\t  return await db.runTransaction(async transaction => {\n435\t    const famDocRef = transaction.collection('families').doc(familyId);\n436\t    const famRes = await famDocRef.get().catch(() => null);\n437\t    if (!famRes || !famRes.data) return;\n438\t\n439\t    const family = famRes.data;\n440\t    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n441\t    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n442\t\n443\t    if (remainingMembers.length === 0) {\n444\t      await famDocRef.remove();\n445\t    } else {\n446\t      let newCreatorOpenid = family.creatorOpenid;\n447\t      if (family.creatorOpenid === openid) {\n448\t        newCreatorOpenid = remainingMembers[0].openid;\n449\t        remainingMembers[0].role = 'creator';\n450\t        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n451\t          data: { role: 'creator', updatedAt: Date.now() }\n452\t        }).catch(() => {});\n453\t      }\n454\t\n455\t      await famDocRef.update({\n456\t        data: {\n457\t          creatorOpenid: newCreatorOpenid,\n458\t          members: remainingMembers,\n459\t          memberOpenids: remainingOpenids,\n460\t          updatedAt: Date.now()\n461\t        }\n462\t      });\n463\t    }\n464\t  });\n465\t}\n466\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"812e450a-9f3c-4ad3-955d-7f46d3e0e233","timestamp":"2026-10-02T13:33:18.480Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n/**\n * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n */\nasync function checkTextSecurity(text, openid) {\n  if (!text) return { pass: true };\n  const str = String(text).trim();\n  if (!str) return { pass: true };\n\n  // 1. 本地兜底敏感词拦截\n  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n  }\n\n  // 2. 微信官方 msgSecCheck 2.0 规范检测\n  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    try {\n      const res = await cloud.openapi.security.msgSecCheck({\n        version: 2,\n        scene: 1, // 1: 资料/昵称/家庭名称等\n        openid,\n        content: str\n      });\n      if (!res || !res.result || res.result.suggest !== 'pass') {\n        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n      }\n    } catch (err) {\n      console.error('[familyManage] msgSecCheck 异常:', err);\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n    }\n  }\n\n  return { pass: true };\n}\n\n/**\n * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n */\nasync function generateUniqueInviteCode() {\n  const now = Date.now();\n  for (let attempt = 0; attempt < 10; attempt++) {\n    const code = String(Math.floor(100000 + Math.random() * 900000));\n    const existing = await db.collection('families').where({\n      inviteCode: code,\n      inviteExpiredAt: _.gt(now)\n    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {\n      return code;\n    }\n  }\n  return String(Math.floor(100000 + Math.random() * 900000));\n}\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 创建家庭空间\n       */\n      case 'createFamily': {\n        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = (event.nickName || '房主').trim();\n\n        // 安全合规校验：家庭名称与昵称\n        const nameSec = await checkTextSecurity(familyName, openid);\n        if (!nameSec.pass) return { success: false, error: nameSec.error };\n\n        const nickSec = await checkTextSecurity(nickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        const userDocRef = db.collection('users').doc(`user_${openid}`);\n        \n        let user;\n        try {\n          const uRes = await userDocRef.get();\n          user = uRes.data;\n        } catch (e) {\n          user = { _id: `user_${openid}`, _openid: openid, nickName };\n        }\n\n        // 如果用户已在旧家庭中，先处理退出旧家庭\n        if (user.familyId) {\n          try {\n            await leaveCurrentFamilyInternal(openid, user.familyId);\n          } catch (e) {\n            console.warn('退出旧家庭警告', e);\n          }\n        }\n\n        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const inviteCode = await generateUniqueInviteCode();\n        const inviteExpiredAt = now + 24 * 60 * 60 * 1000; // 24小时过期\n\n        const newFamily = {\n          _id: familyId,\n          name: familyName,\n          creatorOpenid: openid,\n          members: [\n            {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n              role: 'creator',\n              joinedAt: now\n            }\n          ],\n          memberOpenids: [openid],\n          inviteCode,\n          inviteExpiredAt,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        await db.collection('families').add({ data: newFamily });\n\n        // 更新用户档案\n        await db.collection('users').doc(`user_${openid}`).set({\n          data: {\n            _id: `user_${openid}`,\n            _openid: openid,\n            nickName: nickName || user.nickName || '房主',\n            avatarUrl: event.avatarUrl || user.avatarUrl || '',\n            familyId,\n            role: 'creator',\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          family: newFamily\n        };\n      }\n\n      /**\n       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n       */\n      case 'joinFamily': {\n        const inviteCode = String(event.inviteCode || '').trim();\n        if (!inviteCode || inviteCode.length !== 6) {\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const memberNickName = (event.nickName || '家人').trim();\n        const nickSec = await checkTextSecurity(memberNickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 1. 查询有效且未过期的邀请码\n        const queryRes = await db.collection('families').where({\n          inviteCode,\n          inviteExpiredAt: _.gt(now)\n        }).get();\n\n        if (!queryRes.data || queryRes.data.length === 0) {\n          // 区分是过期还是根本不存在\n          const anyRes = await db.collection('families').where({ inviteCode }).get().catch(() => null);\n          if (anyRes && anyRes.data && anyRes.data.length > 0) {\n            return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n          }\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        const targetFamilyId = queryRes.data[0]._id;\n\n        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n        try {\n          return await db.runTransaction(async transaction => {\n            const famDoc = await transaction.collection('families').doc(targetFamilyId).get().catch(() => null);\n            if (!famDoc || !famDoc.data) {\n              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n              throw new Error('未找到该邀请口令对应的家庭厨房');\n            }\n\n            const family = famDoc.data;\n\n            // 校验 1: 口令是否已过期 (24 小时有效)\n            if (now > family.inviteExpiredAt) {\n              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n            }\n\n            // 校验 2: 是否已经在该家庭中\n            if (family.memberOpenids && family.memberOpenids.includes(openid)) {\n              return {\n                success: true,\n                family,\n                message: '您已经在该家庭厨房中'\n              };\n            }\n\n            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n            if ((family.memberOpenids || []).length >= 4) {\n              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n            }\n\n            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n            const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n            const oldFamilyId = userDoc?.data?.familyId;\n            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n              const oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get().catch(() => null);\n              if (oldFamDoc?.data) {\n                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await transaction.collection('families').doc(oldFamilyId).remove();\n                } else {\n                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n                    ? remainingMembers[0].openid\n                    : oldFamDoc.data.creatorOpenid;\n\n                  if (oldFamDoc.data.creatorOpenid === openid) {\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await transaction.collection('families').doc(oldFamilyId).update({\n                    data: {\n                      creatorOpenid: newCreator,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            }\n\n            // 加入新家庭\n            const newMember = {\n              openid,\n              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n              role: 'member',\n              joinedAt: now\n            };\n\n            const updatedMembers = [...(family.members || []), newMember];\n            const updatedOpenids = [...(family.memberOpenids || []), openid];\n\n            await transaction.collection('families').doc(targetFamilyId).update({\n              data: {\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            });\n\n            // 更新用户档案\n            await transaction.collection('users').doc(`user_${openid}`).set({\n              data: {\n                _id: `user_${openid}`,\n                _openid: openid,\n                nickName: newMember.nickName,\n                avatarUrl: newMember.avatarUrl,\n                familyId: targetFamilyId,\n                role: 'member',\n                updatedAt: now\n              }\n            });\n\n            return {\n              success: true,\n              family: {\n                ...family,\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            };\n          });\n        } catch (trxErr) {\n          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n          return {\n            success: false,\n            error: errMsg\n          };\n        }\n      }\n\n      /**\n       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n       */\n      case 'leaveFamily': {\n        return await db.runTransaction(async transaction => {\n          const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n          const user = userDoc?.data;\n\n          if (!user || !user.familyId) {\n            return { success: true, message: '当前未加入任何家庭' };\n          }\n\n          const familyId = user.familyId;\n          const famDoc = await transaction.collection('families').doc(familyId).get().catch(() => null);\n\n          if (famDoc && famDoc.data) {\n            const family = famDoc.data;\n            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n            if (remainingMembers.length === 0) {\n              await transaction.collection('families').doc(familyId).remove();\n            } else {\n              let newCreatorOpenid = family.creatorOpenid;\n              if (family.creatorOpenid === openid) {\n                newCreatorOpenid = remainingMembers[0].openid;\n                remainingMembers[0].role = 'creator';\n                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                  data: { role: 'creator', updatedAt: now }\n                }).catch(() => {});\n              }\n\n              await transaction.collection('families').doc(familyId).update({\n                data: {\n                  creatorOpenid: newCreatorOpenid,\n                  members: remainingMembers,\n                  memberOpenids: remainingOpenids,\n                  updatedAt: now\n                }\n              });\n            }\n          }\n\n          // 重置用户家庭归属\n          await transaction.collection('users').doc(`user_${openid}`).update({\n            data: {\n              familyId: null,\n              role: null,\n              updatedAt: now\n            }\n          });\n\n          return { success: true, message: '已退出家庭厨房空间' };\n        });\n      }\n\n      /**\n       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n       */\n      case 'refreshInviteCode': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = await generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n\n        await db.collection('families').doc(familyId).update({\n          data: {\n            inviteCode: newCode,\n            inviteExpiredAt: newExpiry,\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          inviteCode: newCode,\n          inviteExpiredAt: newExpiry\n        };\n      }\n\n      /**\n       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n       */\n      case 'getFamily': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return {\n          success: true,\n          family\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n    return {\n      success: false,\n      error: errMsg\n    };\n  }\n};\n\n// 内部事务辅助：退出或重置家庭成员\nasync function leaveCurrentFamilyInternal(openid, familyId) {\n  return await db.runTransaction(async transaction => {\n    const famDocRef = transaction.collection('families').doc(familyId);\n    const famRes = await famDocRef.get().catch(() => null);\n    if (!famRes || !famRes.data) return;\n\n    const family = famRes.data;\n    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n    if (remainingMembers.length === 0) {\n      await famDocRef.remove();\n    } else {\n      let newCreatorOpenid = family.creatorOpenid;\n      if (family.creatorOpenid === openid) {\n        newCreatorOpenid = remainingMembers[0].openid;\n        remainingMembers[0].role = 'creator';\n        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n          data: { role: 'creator', updatedAt: Date.now() }\n        }).catch(() => {});\n      }\n\n      await famDocRef.update({\n        data: {\n          creatorOpenid: newCreatorOpenid,\n          members: remainingMembers,\n          memberOpenids: remainingOpenids,\n          updatedAt: Date.now()\n        }\n      });\n    }\n  });\n}\n","numLines":466,"startLine":1,"totalLines":466}}}
