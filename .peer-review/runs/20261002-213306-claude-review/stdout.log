{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NbmePd1yD3U6vFwkDvgSaZ","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\t\n9\t/**\n10\t * userAuth 云函数：用户静默鉴权与档案获取\n11\t */\n12\texports.main = async (event, context) => {\n13\t  const wxContext = cloud.getWXContext();\n14\t  let openid = wxContext && wxContext.OPENID;\n15\t\n16\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n17\t  if (!openid) {\n18\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n19\t      openid = event.mockOpenid || 'mock_openid_default';\n20\t    } else {\n21\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n22\t    }\n23\t  }\n24\t\n25\t  const now = Date.now();\n26\t\n27\t  try {\n28\t    const userDocRef = db.collection('users').doc(`user_${openid}`);\n29\t    let user = null;\n30\t\n31\t    try {\n32\t      const res = await userDocRef.get();\n33\t      user = res.data;\n34\t    } catch (e) {\n35\t      // 用户首次访问，自动创建档案\n36\t      const newUser = {\n37\t        _id: `user_${openid}`,\n38\t        _openid: openid,\n39\t        nickName: event.nickName || '家人',\n40\t        avatarUrl: event.avatarUrl || '',\n41\t        familyId: null,\n42\t        role: null,\n43\t        createdAt: now,\n44\t        updatedAt: now\n45\t      };\n46\t      await db.collection('users').add({ data: newUser });\n47\t      user = newUser;\n48\t    }\n49\t\n50\t    // 更新昵称/头像\n51\t    if (event.nickName || event.avatarUrl) {\n52\t      const updateData = { updatedAt: now };\n53\t      if (event.nickName) updateData.nickName = event.nickName;\n54\t      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n55\t      await userDocRef.update({ data: updateData });\n56\t      user = { ...user, ...updateData };\n57\t    }\n58\t\n59\t    // 若绑定了家庭，获取家庭最新信息\n60\t    let family = null;\n61\t    if (user.familyId) {\n62\t      try {\n63\t        const famRes = await db.collection('families').doc(user.familyId).get();\n64\t        family = famRes.data;\n65\t      } catch (err) {\n66\t        console.warn('获取用户所属家庭失败或家庭已解散', err);\n67\t        // 如果家庭已被解散，重置用户的 familyId\n68\t        await userDocRef.update({\n69\t          data: { familyId: null, role: null, updatedAt: now }\n70\t        });\n71\t        user.familyId = null;\n72\t        user.role = null;\n73\t      }\n74\t    }\n75\t\n76\t    return {\n77\t      success: true,\n78\t      openid,\n79\t      user,\n80\t      family\n81\t    };\n82\t  } catch (err) {\n83\t    return {\n84\t      success: false,\n85\t      error: err.message || '用户鉴权失败'\n86\t    };\n87\t  }\n88\t};\n89\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"d4f3c669-9dfb-47be-9e85-0b8de6b5e803","timestamp":"2026-10-02T13:33:19.636Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/userAuth/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\n/**\n * userAuth 云函数：用户静默鉴权与档案获取\n */\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const now = Date.now();\n\n  try {\n    const userDocRef = db.collection('users').doc(`user_${openid}`);\n    let user = null;\n\n    try {\n      const res = await userDocRef.get();\n      user = res.data;\n    } catch (e) {\n      // 用户首次访问，自动创建档案\n      const newUser = {\n        _id: `user_${openid}`,\n        _openid: openid,\n        nickName: event.nickName || '家人',\n        avatarUrl: event.avatarUrl || '',\n        familyId: null,\n        role: null,\n        createdAt: now,\n        updatedAt: now\n      };\n      await db.collection('users').add({ data: newUser });\n      user = newUser;\n    }\n\n    // 更新昵称/头像\n    if (event.nickName || event.avatarUrl) {\n      const updateData = { updatedAt: now };\n      if (event.nickName) updateData.nickName = event.nickName;\n      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n      await userDocRef.update({ data: updateData });\n      user = { ...user, ...updateData };\n    }\n\n    // 若绑定了家庭，获取家庭最新信息\n    let family = null;\n    if (user.familyId) {\n      try {\n        const famRes = await db.collection('families').doc(user.familyId).get();\n        family = famRes.data;\n      } catch (err) {\n        console.warn('获取用户所属家庭失败或家庭已解散', err);\n        // 如果家庭已被解散，重置用户的 familyId\n        await userDocRef.update({\n          data: { familyId: null, role: null, updatedAt: now }\n        });\n        user.familyId = null;\n        user.role = null;\n      }\n    }\n\n    return {\n      success: true,\n      openid,\n      user,\n      family\n    };\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '用户鉴权失败'\n    };\n  }\n};\n","numLines":89,"startLine":1,"totalLines":89}}}
