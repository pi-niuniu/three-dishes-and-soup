{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T7baQzttXwZeP5ArAsc7Br","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\t\n9\t// 预设分类生活美学图标与默认大图映射\n10\tconst CATEGORY_DEFAULT_CONFIG = {\n11\t  main_meat: { icon: '🥩', theme: 'theme_main_meat', thumb: '/assets/dishes/default_main.jpg' },\n12\t  secondary_meat: { icon: '🥘', theme: 'theme_secondary_meat', thumb: '/assets/dishes/default_secondary.jpg' },\n13\t  egg: { icon: '🍳', theme: 'theme_egg', thumb: '/assets/dishes/default_egg.jpg' },\n14\t  tofu: { icon: '🧊', theme: 'theme_tofu', thumb: '/assets/dishes/default_tofu.jpg' },\n15\t  vegetable: { icon: '🥬', theme: 'theme_vegetable', thumb: '/assets/dishes/default_vegetable.jpg' },\n16\t  soup: { icon: '🍲', theme: 'theme_soup', thumb: '/assets/dishes/default_soup.jpg' },\n17\t  staple_sauce: { icon: '🍚', theme: 'theme_staple_sauce', thumb: '/assets/dishes/default_dish.jpg' },\n18\t  default: { icon: '🍽️', theme: 'theme_default', thumb: '/assets/dishes/default_dish.jpg' }\n19\t};\n20\t\n21\t// 根据菜名特征智能匹配生动 Emoji\n22\tfunction matchEmoji(name, category) {\n23\t  if (!name) return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n24\t  if (name.includes('土豆')) return '🥔';\n25\t  if (name.includes('番茄') || name.includes('西红柿')) return '🍅';\n26\t  if (name.includes('虾')) return '🦐';\n27\t  if (name.includes('鱼')) return '🐟';\n28\t  if (name.includes('鸡') || name.includes('鸭')) return '🍗';\n29\t  if (name.includes('牛') || name.includes('羊') || name.includes('排骨') || name.includes('肉')) return '🥩';\n30\t  if (name.includes('蛋')) return '🍳';\n31\t  if (name.includes('豆腐')) return '🧊';\n32\t  if (name.includes('蘑菇') || name.includes('菌') || name.includes('菇')) return '🍄';\n33\t  if (name.includes('茄子')) return '🍆';\n34\t  if (name.includes('玉米')) return '🌽';\n35\t  if (name.includes('面') || name.includes('粉')) return '🍜';\n36\t  if (name.includes('饭')) return '🍚';\n37\t  if (name.includes('饺') || name.includes('抄手')) return '🥟';\n38\t  if (name.includes('汤')) return '🍲';\n39\t  if (name.includes('菜') || name.includes('笋') || name.includes('瓜')) return '🥬';\n40\t  return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n41\t}\n42\t\n43\texports.main = async (event, context) => {\n44\t  const wxContext = cloud.getWXContext();\n45\t  let openid = wxContext && wxContext.OPENID;\n46\t\n47\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n48\t  if (!openid) {\n49\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n50\t      openid = event.mockOpenid || 'mock_openid_default';\n51\t    } else {\n52\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n53\t    }\n54\t  }\n55\t\n56\t  const { action = 'addDish' } = event;\n57\t  const now = Date.now();\n58\t\n59\t  try {\n60\t    switch (action) {\n61\t      /**\n62\t       * 1. 录入纯文字私房菜 (强制文本安全检查，禁止图片上传)\n63\t       */\n64\t      case 'addDish': {\n65\t        const name = String(event.name || '').trim();\n66\t        if (!name) {\n67\t          return { success: false, error: '菜品名称不能为空' };\n68\t        }\n69\t        if (name.length > 20) {\n70\t          return { success: false, error: '菜品名称不能超过20个字' };\n71\t        }\n72\t\n73\t        const category = event.category || 'secondary_meat';\n74\t        const taste = Array.isArray(event.taste) ? event.taste : (event.taste ? [event.taste] : ['家常']);\n75\t        const cookingTimeMinutes = Number(event.cookingTimeMinutes) || 25;\n76\t        const ingredients = Array.isArray(event.ingredients) ? event.ingredients : [];\n77\t\n78\t        // 文本合规检验：结合菜名、口味与食材\n79\t        const checkContent = `${name} ${taste.join(' ')} ${ingredients.join(' ')}`;\n80\t\n81\t        // 1. 本地/弱网兜底敏感词检测 (易错点 7 防线)\n82\t        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n83\t        if (sensitiveWords.some(w => name.includes(w) || checkContent.includes(w))) {\n84\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n85\t        }\n86\t\n87\t        // 2. 升级微信官方文本合规检测 msgSecCheck 2.0 规范\n88\t        if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n89\t          try {\n90\t            const secRes = await cloud.openapi.security.msgSecCheck({\n91\t              version: 2,\n92\t              scene: 1, // 资料类\n93\t              openid,\n94\t              content: checkContent\n95\t            });\n96\t            if (!secRes || !secRes.result || secRes.result.suggest !== 'pass') {\n97\t              return { success: false, error: '菜品名称或描述包含敏感内容，请修改后重试' };\n98\t            }\n99\t          } catch (secErr) {\n100\t            console.error('微信 msgSecCheck 检测异常:', secErr);\n101\t            // 真实生产环境若检测接口异常也坚决拦截入库\n102\t            return { success: false, error: '内容安全检测未通过或服务暂时不可用，请稍后重试' };\n103\t          }\n104\t        }\n105\t\n106\t        // 桶隔离：未加入家庭的私房菜使用 personal_${openid}，禁止所有单人用户共用 'personal' 桶\n107\t        const rawFamilyId = event.familyId;\n108\t        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n109\t        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n110\t\n111\t        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n112\t        if (!isPersonal) {\n113\t          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n114\t          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n115\t            return { success: false, error: '越权操作：您不属于该家庭空间' };\n116\t          }\n117\t        }\n118\t\n119\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n120\t        const cfg = CATEGORY_DEFAULT_CONFIG[category] || CATEGORY_DEFAULT_CONFIG.default;\n121\t        const emoji = matchEmoji(name, category);\n122\t\n123\t        const newDish = {\n124\t          _id: dishId,\n125\t          id: dishId,\n126\t          familyId,\n127\t          creatorOpenid: openid,\n128\t          creatorName: event.creatorName || event.nickName || '家人',\n129\t          name,\n130\t          category,\n131\t          taste,\n132\t          cookingTimeMinutes,\n133\t          defaultIcon: emoji,\n134\t          defaultTheme: cfg.theme,\n135\t          thumbUrl: cfg.thumb,\n136\t          ingredients, // 空食材保留空数组，严禁无中生有\n137\t          enabled: true,\n138\t          isCustom: true,\n139\t          createdAt: now\n140\t        };\n141\t\n142\t        await db.collection('custom_dishes').add({ data: newDish });\n143\t\n144\t        return {\n145\t          success: true,\n146\t          dish: newDish\n147\t        };\n148\t      }\n149\t\n150\t      /**\n151\t       * 2. 查询家庭私房菜列表\n152\t       */\n153\t      case 'getDishes': {\n154\t        const rawFamilyId = event.familyId;\n155\t        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n156\t        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n157\t\n158\t        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n159\t        if (!isPersonal) {\n160\t          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n161\t          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n162\t            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n163\t          }\n164\t        }\n165\t\n166\t        const res = await db.collection('custom_dishes')\n167\t          .where({\n168\t            familyId,\n169\t            enabled: true\n170\t          })\n171\t          .orderBy('createdAt', 'desc')\n172\t          .get();\n173\t\n174\t        return {\n175\t          success: true,\n176\t          dishes: res.data || []\n177\t        };\n178\t      }\n179\t\n180\t      default:\n181\t        return { success: false, error: `不支持的操作类型: ${action}` };\n182\t    }\n183\t  } catch (err) {\n184\t    return {\n185\t      success: false,\n186\t      error: err.message || '自选私房菜操作失败'\n187\t    };\n188\t  }\n189\t};\n190\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"8809767f-0ec8-42c3-a31d-8cd0bc41e365","timestamp":"2026-10-02T13:33:19.057Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/customDish/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\n// 预设分类生活美学图标与默认大图映射\nconst CATEGORY_DEFAULT_CONFIG = {\n  main_meat: { icon: '🥩', theme: 'theme_main_meat', thumb: '/assets/dishes/default_main.jpg' },\n  secondary_meat: { icon: '🥘', theme: 'theme_secondary_meat', thumb: '/assets/dishes/default_secondary.jpg' },\n  egg: { icon: '🍳', theme: 'theme_egg', thumb: '/assets/dishes/default_egg.jpg' },\n  tofu: { icon: '🧊', theme: 'theme_tofu', thumb: '/assets/dishes/default_tofu.jpg' },\n  vegetable: { icon: '🥬', theme: 'theme_vegetable', thumb: '/assets/dishes/default_vegetable.jpg' },\n  soup: { icon: '🍲', theme: 'theme_soup', thumb: '/assets/dishes/default_soup.jpg' },\n  staple_sauce: { icon: '🍚', theme: 'theme_staple_sauce', thumb: '/assets/dishes/default_dish.jpg' },\n  default: { icon: '🍽️', theme: 'theme_default', thumb: '/assets/dishes/default_dish.jpg' }\n};\n\n// 根据菜名特征智能匹配生动 Emoji\nfunction matchEmoji(name, category) {\n  if (!name) return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n  if (name.includes('土豆')) return '🥔';\n  if (name.includes('番茄') || name.includes('西红柿')) return '🍅';\n  if (name.includes('虾')) return '🦐';\n  if (name.includes('鱼')) return '🐟';\n  if (name.includes('鸡') || name.includes('鸭')) return '🍗';\n  if (name.includes('牛') || name.includes('羊') || name.includes('排骨') || name.includes('肉')) return '🥩';\n  if (name.includes('蛋')) return '🍳';\n  if (name.includes('豆腐')) return '🧊';\n  if (name.includes('蘑菇') || name.includes('菌') || name.includes('菇')) return '🍄';\n  if (name.includes('茄子')) return '🍆';\n  if (name.includes('玉米')) return '🌽';\n  if (name.includes('面') || name.includes('粉')) return '🍜';\n  if (name.includes('饭')) return '🍚';\n  if (name.includes('饺') || name.includes('抄手')) return '🥟';\n  if (name.includes('汤')) return '🍲';\n  if (name.includes('菜') || name.includes('笋') || name.includes('瓜')) return '🥬';\n  return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n}\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action = 'addDish' } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 录入纯文字私房菜 (强制文本安全检查，禁止图片上传)\n       */\n      case 'addDish': {\n        const name = String(event.name || '').trim();\n        if (!name) {\n          return { success: false, error: '菜品名称不能为空' };\n        }\n        if (name.length > 20) {\n          return { success: false, error: '菜品名称不能超过20个字' };\n        }\n\n        const category = event.category || 'secondary_meat';\n        const taste = Array.isArray(event.taste) ? event.taste : (event.taste ? [event.taste] : ['家常']);\n        const cookingTimeMinutes = Number(event.cookingTimeMinutes) || 25;\n        const ingredients = Array.isArray(event.ingredients) ? event.ingredients : [];\n\n        // 文本合规检验：结合菜名、口味与食材\n        const checkContent = `${name} ${taste.join(' ')} ${ingredients.join(' ')}`;\n\n        // 1. 本地/弱网兜底敏感词检测 (易错点 7 防线)\n        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n        if (sensitiveWords.some(w => name.includes(w) || checkContent.includes(w))) {\n          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n        }\n\n        // 2. 升级微信官方文本合规检测 msgSecCheck 2.0 规范\n        if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n          try {\n            const secRes = await cloud.openapi.security.msgSecCheck({\n              version: 2,\n              scene: 1, // 资料类\n              openid,\n              content: checkContent\n            });\n            if (!secRes || !secRes.result || secRes.result.suggest !== 'pass') {\n              return { success: false, error: '菜品名称或描述包含敏感内容，请修改后重试' };\n            }\n          } catch (secErr) {\n            console.error('微信 msgSecCheck 检测异常:', secErr);\n            // 真实生产环境若检测接口异常也坚决拦截入库\n            return { success: false, error: '内容安全检测未通过或服务暂时不可用，请稍后重试' };\n          }\n        }\n\n        // 桶隔离：未加入家庭的私房菜使用 personal_${openid}，禁止所有单人用户共用 'personal' 桶\n        const rawFamilyId = event.familyId;\n        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n\n        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n        if (!isPersonal) {\n          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n            return { success: false, error: '越权操作：您不属于该家庭空间' };\n          }\n        }\n\n        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const cfg = CATEGORY_DEFAULT_CONFIG[category] || CATEGORY_DEFAULT_CONFIG.default;\n        const emoji = matchEmoji(name, category);\n\n        const newDish = {\n          _id: dishId,\n          id: dishId,\n          familyId,\n          creatorOpenid: openid,\n          creatorName: event.creatorName || event.nickName || '家人',\n          name,\n          category,\n          taste,\n          cookingTimeMinutes,\n          defaultIcon: emoji,\n          defaultTheme: cfg.theme,\n          thumbUrl: cfg.thumb,\n          ingredients, // 空食材保留空数组，严禁无中生有\n          enabled: true,\n          isCustom: true,\n          createdAt: now\n        };\n\n        await db.collection('custom_dishes').add({ data: newDish });\n\n        return {\n          success: true,\n          dish: newDish\n        };\n      }\n\n      /**\n       * 2. 查询家庭私房菜列表\n       */\n      case 'getDishes': {\n        const rawFamilyId = event.familyId;\n        const isPersonal = !rawFamilyId || rawFamilyId === 'personal' || rawFamilyId.startsWith('personal_');\n        const familyId = isPersonal ? `personal_${openid}` : rawFamilyId;\n\n        // 服务端家庭鉴权：非个人桶必须确认该用户确实属于该家庭\n        if (!isPersonal) {\n          const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n          if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n            return { success: false, error: '越权操作：无权查看非本人所属家庭的私房菜' };\n          }\n        }\n\n        const res = await db.collection('custom_dishes')\n          .where({\n            familyId,\n            enabled: true\n          })\n          .orderBy('createdAt', 'desc')\n          .get();\n\n        return {\n          success: true,\n          dishes: res.data || []\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '自选私房菜操作失败'\n    };\n  }\n};\n","numLines":190,"startLine":1,"totalLines":190}}}
