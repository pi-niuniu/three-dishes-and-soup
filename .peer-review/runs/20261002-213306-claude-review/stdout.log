{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011XZxyXnHP7nFa7GAz6CueX","type":"tool_result","content":"340\t  console.log('===============================================================\\n');\n341\t\n342\t  const hub = new MockCloudBaseHub();\n343\t\n344\t  // 设备定义：爸爸、妈妈、大宝、奶奶、邻居\n345\t  const deviceDad = new MockWechatDevice('openid_dad', '老爸大厨');\n346\t  const deviceMom = new MockWechatDevice('openid_mom', '老妈');\n347\t  const deviceKid = new MockWechatDevice('openid_kid', '大宝');\n348\t  const deviceGrandma = new MockWechatDevice('openid_grandma', '奶奶');\n349\t  const deviceNeighbor = new MockWechatDevice('openid_neighbor', '隔壁老王');\n350\t\n351\t  let currentActiveDevice = deviceDad;\n352\t\n353\t  const globalNetworkListeners = [];\n354\t  function setNetworkStatus(isConnected) {\n355\t    currentActiveDevice.isOnline = isConnected;\n356\t    for (const cb of globalNetworkListeners) {\n357\t      cb({ isConnected, networkType: isConnected ? 'wifi' : 'none' });\n358\t    }\n359\t  }\n360\t\n361\t  // 关键：在 import 业务服务之前预置完整 global.wx，确保构造函数正确注册网络监听器\n362\t  global.wx = {\n363\t    getStorageSync: (k) => currentActiveDevice.getStorageSync(k),\n364\t    setStorageSync: (k, v) => currentActiveDevice.setStorageSync(k, v),\n365\t    removeStorageSync: (k) => currentActiveDevice.removeStorageSync(k),\n366\t    clearStorageSync: () => currentActiveDevice.clearStorageSync(),\n367\t    setClipboardData: (opts) => currentActiveDevice.setClipboardData(opts),\n368\t    onNetworkStatusChange: (cb) => globalNetworkListeners.push(cb),\n369\t    showToast: () => {},\n370\t    showModal: ({ success }) => success && success({ confirm: true }),\n371\t    showLoading: () => {},\n372\t    hideLoading: () => {},\n373\t    cloud: {\n374\t      callFunction: async ({ name, data }) => {\n375\t        if (!currentActiveDevice.isOnline) {\n376\t          throw new Error('request:fail timeout or offline');\n377\t        }\n378\t        const res = await hub.callFunction({ name, data }, currentActiveDevice.openid);\n379\t        return { result: res };\n380\t      }\n381\t    }\n382\t  };\n383\t\n384\t  // 导入真实业务模块 (此时 global.wx 已就绪)\n385\t  const { dataProvider } = await import('../miniprogram/services/dataProvider.js');\n386\t  const { historyService } = await import('../miniprogram/services/historyService.js');\n387\t  const { familyService } = await import('../miniprogram/services/familyService.js');\n388\t  const { menuRecommendationEngine } = await import('../miniprogram/services/menuRecommendation.js');\n389\t  const { shoppingListService } = await import('../miniprogram/services/shoppingListService.js');\n390\t\n391\t  // 辅助函数：切换当前操作设备并同步该设备的微信登录态\n392\t  async function switchDevice(device) {\n393\t    currentActiveDevice = device;\n394\t    await familyService.syncUserAuth();\n395\t  }\n396\t\n397\t  // -------------------------------------------------------------\n398\t  // 【阶段 1】房主 (爸爸) 静默鉴权、创建家庭厨房与生成邀请码\n399\t  // -------------------------------------------------------------\n400\t  console.log('【阶段 1】房主 (爸爸) 登录并创建家庭厨房空间');\n401\t  await switchDevice(deviceDad);\n402\t  assert.equal(familyService.getCurrentUser().openid, 'openid_dad');\n403\t\n404\t  const createRes = await familyService.createFamily('温馨四口之家食堂');\n405\t  assert(createRes.success, '房主创建家庭成功');\n406\t  const familyId = createRes.family.id;\n407\t  const inviteCode = createRes.family.inviteCode;\n408\t  console.log(`✅ 房主创建家庭成功: 【${createRes.family.name}】(ID: ${familyId}), 6位口令: ${inviteCode}`);\n409\t  assert.equal(inviteCode.length, 6, '邀请码应为 6 位数字');\n410\t\n411\t  // -------------------------------------------------------------\n412\t  // 【阶段 2】4 人逐一绑定加入，并发防超员拦截第 5 人 (攻防测试)\n413\t  // -------------------------------------------------------------\n414\t  console.log('\\n【阶段 2】全家 4 人逐一绑定，并发防超员拦截第 5 人');\n415\t\n416\t  // 妈妈加入\n417\t  await switchDevice(deviceMom);\n418\t  const momJoin = await familyService.joinFamily(inviteCode);\n419\t  assert(momJoin.success, '妈妈加入家庭成功');\n420\t  console.log('✅ 妈妈成功加入绑定！');\n421\t\n422\t  // 大宝加入\n423\t  await switchDevice(deviceKid);\n424\t  const kidJoin = await familyService.joinFamily(inviteCode);\n425\t  assert(kidJoin.success, '大宝加入家庭成功');\n426\t  console.log('✅ 大宝成功加入绑定！');\n427\t\n428\t  // 奶奶加入\n429\t  await switchDevice(deviceGrandma);\n430\t  const grandmaJoin = await familyService.joinFamily(inviteCode);\n431\t  assert(grandmaJoin.success, '奶奶加入家庭成功');\n432\t  console.log('✅ 奶奶成功加入绑定！当前成员已达上限 4 人');\n433\t\n434\t  // 第 5 人 (隔壁老王) 尝试加入\n435\t  await switchDevice(deviceNeighbor);\n436\t  const neighborJoin = await familyService.joinFamily(inviteCode);\n437\t  assert.equal(neighborJoin.success, false, '第 5 人加入必须被拦截');\n438\t  assert(neighborJoin.error.includes('已满') || neighborJoin.error.includes('上限4人'), '必须返回成员已满提示');\n439\t  console.log(`✅ 拦截第 5 人并发加入成功: \"${neighborJoin.error}\"`);\n440\t\n441\t  // -------------------------------------------------------------\n442\t  // 【阶段 3】奶奶录入纯文字自选私房菜，全家共享可见\n443\t  // -------------------------------------------------------------\n444\t  console.log('\\n【阶段 3】奶奶纯文字录入私房菜 (零图片上传) 并全家共享');\n445\t  await switchDevice(deviceGrandma);\n446\t\n447\t  // 模拟敏感词被拒\n448\t  const badDishRes = await dataProvider.addCustomDish({\n449\t    name: '低息贷款特级炒肉',\n450\t    category: 'main_meat'\n451\t  }).catch(e => ({ success: false, error: e.message }));\n452\t  assert.equal(badDishRes.success, false, '敏感词录入必须被前端/服务端双重拦截');\n453\t  console.log('✅ 违规内容拦截测试通过！');\n454\t\n455\t  // 正常录入纯文字私房菜\n456\t  const addDishRes = await dataProvider.addCustomDish({\n457\t    name: '奶奶牌秘制东坡肉',\n458\t    category: 'main_meat',\n459\t    taste: ['浓郁', '酸甜'],\n460\t    cookingTimeMinutes: 60,\n461\t    tags: ['拿手大菜', '秘制']\n462\t  });\n463\t  assert(addDishRes && addDishRes.name === '奶奶牌秘制东坡肉', '奶奶牌东坡肉录入成功');\n464\t  const dongpoDish = addDishRes;\n465\t  assert.equal(dongpoDish.thumbUrl, '/assets/dishes/default_main.jpg', '自动匹配主荤美学大图');\n466\t  assert(dongpoDish.dishEmoji, '自动匹配专属 Emoji 图标');\n467\t  assert(Array.isArray(dongpoDish.ingredients) && dongpoDish.ingredients.length === 0, '未录入食材必须为空数组，坚决不虚构克重');\n468\t  console.log(`✅ 奶奶成功录入纯文字私房菜: 【${dongpoDish.name}】(${dongpoDish.dishEmoji})`);\n469\t\n470\t  // 验证爸爸端拉取私房菜库\n471\t  await switchDevice(deviceDad);\n472\t  await dataProvider.syncCloudCustomDishes();\n473\t  const dadDishes = dataProvider.getAllDishes();\n474\t  const foundInDad = dadDishes.find(d => d.name === '奶奶牌秘制东坡肉');\n475\t  assert(foundInDad, '爸爸端必须能查看到奶奶录入的私房菜！');\n476\t  console.log('✅ 爸爸端无缝共享查看到奶奶的私房菜，全家私房菜库打通！');\n477\t\n478\t  // -------------------------------------------------------------\n479\t  // 【阶段 4】妈妈安排【今日午餐】并确认开饭\n480\t  // -------------------------------------------------------------\n481\t  console.log('\\n【阶段 4】妈妈安排【今日午餐】并确认开饭');\n482\t  await switchDevice(deviceMom);\n483\t  historyService.clearHistory();\n484\t\n485\t  const lunchDishes = [\n486\t    dongpoDish, // 奶奶的私房菜\n487\t    dataProvider.getDishById('d_pork_02') || { id: 'd_pork_02', name: '青椒肉丝' },\n488\t    dataProvider.getDishById('d_veg_01') || { id: 'd_veg_01', name: '清炒菜心' }\n489\t  ];\n490\t\n491\t  const lunchRecord = historyService.recordMeal('hearty_3_1', lunchDishes, '2026-10-02', 'menu_lunch_01', '午餐');\n492\t  assert.equal(lunchRecord.mealType, '午餐');\n493\t  await historyService.flushPendingQueue();\n494\t  console.log('✅ 妈妈成功记录【2026-10-02 午餐】: 奶奶牌秘制东坡肉 + 青椒肉丝 + 清炒菜心');\n495\t\n496\t  // -------------------------------------------------------------\n497\t  // 【阶段 5】爸爸安排【今日晚餐】并确认开饭 (同日多餐 0 覆盖测试)\n498\t  // -------------------------------------------------------------\n499\t  console.log('\\n【阶段 5】爸爸安排【今日晚餐】并确认开饭 (同日多餐 0 覆盖检验)');\n500\t  await switchDevice(deviceDad);\n501\t  // 爸爸拉取云端历史\n502\t  await historyService.syncCloudHistory();\n503\t\n504\t  const dinnerDishes = [\n505\t    dataProvider.getDishById('d_beef_01') || { id: 'd_beef_01', name: '番茄炖牛腩' },\n506\t    dataProvider.getDishById('d_fish_01') || { id: 'd_fish_01', name: '清蒸鲈鱼' },\n507\t    dataProvider.getDishById('d_soup_01') || { id: 'd_soup_01', name: '冬瓜排骨汤' }\n508\t  ];\n509\t\n510\t  const dinnerRecord = historyService.recordMeal('hearty_3_1', dinnerDishes, '2026-10-02', 'menu_dinner_01', '晚餐');\n511\t  assert.equal(dinnerRecord.mealType, '晚餐');\n512\t  await historyService.flushPendingQueue();\n513\t\n514\t  // 验证爸爸本地历史中午餐与晚餐并存\n515\t  const dadHistory = historyService.getHistory();\n516\t  const todayMeals = dadHistory.filter(h => h.date === '2026-10-02');\n517\t  assert.equal(todayMeals.length, 2, '同日必须并存午餐与晚餐 2 条记录，坚决杜绝覆盖写！');\n518\t  assert(todayMeals.some(m => m.mealType === '午餐'), '午餐记录完好保留');\n519\t  assert(todayMeals.some(m => m.mealType === '晚餐'), '晚餐记录完好保留');\n520\t  console.log('✅ 爸爸端检验：同日多餐午餐与晚餐 100% 独立并存，0 覆盖！');\n521\t\n522\t  // 验证大宝手机端也同步看到了全家两餐\n523\t  await switchDevice(deviceKid);\n524\t  historyService.clearHistory();\n525\t  await historyService.syncCloudHistory();\n526\t  const kidHistory = historyService.getHistory();\n527\t  assert.equal(kidHistory.filter(h => h.date === '2026-10-02').length, 2, '大宝端拉取全家历史必须呈现 2 顿记录');\n528\t  console.log('✅ 大宝端拉取检验：同样完整看到全家今天的午餐与晚餐！');\n529\t\n530\t  // -------------------------------------------------------------\n531\t  // 【阶段 6】次日排餐智能避重穿透检验\n532\t  // -------------------------------------------------------------\n533\t  console.log('\\n【阶段 6】次日 (10月3日) 排餐读取全家共享历史避重');\n534\t  await switchDevice(deviceDad);\n535\t  const tomorrowMenu = menuRecommendationEngine.generateMenu({\n536\t    mode: 'hearty_3_1',\n537\t    currentMonth: 10,\n538\t    preferences: {\n539\t      mode: 'hearty_3_1',\n540\t      spicyLevel: 0,\n541\t      dislikedIngredients: [],\n542\t      customDietaryTags: []\n543\t    },\n544\t    history: historyService.getHistory(),\n545\t    allDishes: dataProvider.getAllDishes(),\n546\t    targetDateDay: 'tomorrow'\n547\t  });\n548\t\n549\t  const tomorrowDishNames = tomorrowMenu.slots.map(s => s.dish.name);\n550\t  console.log('明天自动排餐结果:', tomorrowDishNames.join(' + '));\n551\t  // 验证昨日吃过的菜绝不重复出现在明天菜单中\n552\t  assert(!tomorrowDishNames.includes('奶奶牌秘制东坡肉'), '昨日吃过的奶奶私房菜应被避重');\n553\t  assert(!tomorrowDishNames.includes('青椒肉丝'), '昨日吃过的青椒肉丝应被避重');\n554\t  assert(!tomorrowDishNames.includes('清蒸鲈鱼'), '昨日吃过的清蒸鲈鱼应被避重');\n555\t  console.log('✅ 智能排餐成功避开全家昨日午餐和晚餐吃过的全部菜品！');\n556\t\n557\t  // -------------------------------------------------------------\n558\t  // 【阶段 7】大厨交付中心买菜清单与微信卡片免密扫码还原\n559\t  // -------------------------------------------------------------\n560\t  console.log('\\n【阶段 7】交付中心买菜清单与大厨端免密扫码还原');\n561\t  const shoppingList = shoppingListService.generateShoppingList(tomorrowMenu.slots.map(s => s.dish));\n562\t  assert(shoppingList.length > 0, '买菜清单生成成功');\n563\t  console.log(`✅ 自动生成买菜食材项: ${shoppingList.length} 样 (包含菜场口语化斤两)`);\n564\t\n565\t  const shareParam = shoppingListService.serializeMenuForShare(tomorrowMenu);\n566\t  assert(shareParam.length <= 1500, '微信分享参数在 2048 安全限制内');\n567\t\n568\t  // 大厨免密还原\n569\t  const restoredMenu = shoppingListService.deserializeSharedMenu(shareParam, dataProvider.getAllDishes());\n570\t  assert.equal(restoredMenu.slots.length, tomorrowMenu.slots.length, '大厨端完美秒开还原菜单');\n571\t  console.log('✅ 大厨端微信免密秒开 100% 还原成功！');\n572\t\n573\t  // -------------------------------------------------------------\n574\t  // 【阶段 8】断网离线 SWR、离线队列入队与网络恢复自动同步\n575\t  // -------------------------------------------------------------\n576\t  console.log('\\n【阶段 8】断网离线模式 SWR 秒开与连网静默自动恢复');\n577\t  await switchDevice(deviceDad);\n578\t\n579\t  // 1. 断网离线\n580\t  setNetworkStatus(false);\n581\t  console.log('📴 模拟手机切入飞行模式 (断网离线)...');\n582\t\n583\t  // 2. 离线查看历史：SWR 本地优先，0 延迟秒开\n584\t  const offlineHist = historyService.getHistory();\n585\t  assert(offlineHist.length >= 2, '断网下依然秒开查看本地缓存历史');\n586\t  console.log('✅ SWR 离线秒开验证通过：0 毫秒首屏直出！');\n587\t\n588\t  // 3. 离线确认开饭 (第三餐: 夜宵)\n589\t  const supperDishes = [{ id: 'd_egg_01', name: '西红柿炒鸡蛋' }];\n590\t  const supperRecord = historyService.recordMeal('routine_2_1', supperDishes, '2026-10-02', 'menu_supper_01', '夜宵');\n591\t  assert.equal(supperRecord.syncStatus, 'pending', '离线开饭标记为待同步');\n592\t\n593\t  // 等待离线调用完成结算并释放 isSyncing 状态锁\n594\t  await new Promise(r => setTimeout(r, 50));\n595\t\n596\t  // 4. 恢复网络连接\n597\t  console.log('📶 模拟网络恢复 (连接 Wi-Fi)...');\n598\t  setNetworkStatus(true);\n599\t\n600\t  // 等待网络恢复触发的异步排空队列完成\n601\t  await new Promise(r => setTimeout(r, 100));\n602\t\n603\t  const syncedHist = historyService.getHistory();\n604\t  const supperSynced = syncedHist.find(h => h.mealType === '夜宵');\n605\t  assert.equal(supperSynced.syncStatus, 'synced', '连网后离线队列自动上报完成并标记为 synced');\n606\t  console.log('✅ 网络恢复监听生效：离线记录已自动静默同步至云端！');\n607\t\n608\t  // -------------------------------------------------------------\n609\t  // 【阶段 9】成员 (大宝) 退出家庭，数据纯净复位单人模式\n610\t  // -------------------------------------------------------------\n611\t  console.log('\\n【阶段 9】成员 (大宝) 退出家庭与纯净复位');\n612\t  await switchDevice(deviceKid);\n613\t\n614\t  const leaveRes = await familyService.leaveFamily();\n615\t  assert(leaveRes.success, '大宝退出家庭成功');\n616\t  assert.equal(familyService.getCurrentUser().familyId, null, '大宝已恢复为个人模式');\n617\t\n618\t  historyService.clearHistory();\n619\t  dataProvider.clearCustomDishes();\n620\t  assert.equal(historyService.getHistory().length, 0, '大宝本地历史已纯净清空');\n621\t  console.log('✅ 大宝成功退出家庭，本地数据纯净复位，不影响原家庭！');\n622\t\n623\t  // 验证爸爸端家庭空间成员变为 3 人，爸爸仍为房主\n624\t  await switchDevice(deviceDad);\n625\t  const famAfterLeave = hub.families.get(familyId);\n626\t  assert.equal(famAfterLeave.members.length, 3, '家庭成员人数正确减为 3 人');\n627\t  assert.equal(famAfterLeave.creatorOpenid, 'openid_dad', '爸爸房主权属完好保持');\n628\t  console.log('✅ 房主端核查：家庭成员正确缩容为 3 人，房主权属坚如磐石！');\n629\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"5c3dcfd3-ae4a-41ff-92b2-b17d0940ea4e","timestamp":"2026-10-02T13:34:24.671Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/test/e2e_family_custom_full_flow_test.mjs","content":"  console.log('===============================================================\\n');\n\n  const hub = new MockCloudBaseHub();\n\n  // 设备定义：爸爸、妈妈、大宝、奶奶、邻居\n  const deviceDad = new MockWechatDevice('openid_dad', '老爸大厨');\n  const deviceMom = new MockWechatDevice('openid_mom', '老妈');\n  const deviceKid = new MockWechatDevice('openid_kid', '大宝');\n  const deviceGrandma = new MockWechatDevice('openid_grandma', '奶奶');\n  const deviceNeighbor = new MockWechatDevice('openid_neighbor', '隔壁老王');\n\n  let currentActiveDevice = deviceDad;\n\n  const globalNetworkListeners = [];\n  function setNetworkStatus(isConnected) {\n    currentActiveDevice.isOnline = isConnected;\n    for (const cb of globalNetworkListeners) {\n      cb({ isConnected, networkType: isConnected ? 'wifi' : 'none' });\n    }\n  }\n\n  // 关键：在 import 业务服务之前预置完整 global.wx，确保构造函数正确注册网络监听器\n  global.wx = {\n    getStorageSync: (k) => currentActiveDevice.getStorageSync(k),\n    setStorageSync: (k, v) => currentActiveDevice.setStorageSync(k, v),\n    removeStorageSync: (k) => currentActiveDevice.removeStorageSync(k),\n    clearStorageSync: () => currentActiveDevice.clearStorageSync(),\n    setClipboardData: (opts) => currentActiveDevice.setClipboardData(opts),\n    onNetworkStatusChange: (cb) => globalNetworkListeners.push(cb),\n    showToast: () => {},\n    showModal: ({ success }) => success && success({ confirm: true }),\n    showLoading: () => {},\n    hideLoading: () => {},\n    cloud: {\n      callFunction: async ({ name, data }) => {\n        if (!currentActiveDevice.isOnline) {\n          throw new Error('request:fail timeout or offline');\n        }\n        const res = await hub.callFunction({ name, data }, currentActiveDevice.openid);\n        return { result: res };\n      }\n    }\n  };\n\n  // 导入真实业务模块 (此时 global.wx 已就绪)\n  const { dataProvider } = await import('../miniprogram/services/dataProvider.js');\n  const { historyService } = await import('../miniprogram/services/historyService.js');\n  const { familyService } = await import('../miniprogram/services/familyService.js');\n  const { menuRecommendationEngine } = await import('../miniprogram/services/menuRecommendation.js');\n  const { shoppingListService } = await import('../miniprogram/services/shoppingListService.js');\n\n  // 辅助函数：切换当前操作设备并同步该设备的微信登录态\n  async function switchDevice(device) {\n    currentActiveDevice = device;\n    await familyService.syncUserAuth();\n  }\n\n  // -------------------------------------------------------------\n  // 【阶段 1】房主 (爸爸) 静默鉴权、创建家庭厨房与生成邀请码\n  // -------------------------------------------------------------\n  console.log('【阶段 1】房主 (爸爸) 登录并创建家庭厨房空间');\n  await switchDevice(deviceDad);\n  assert.equal(familyService.getCurrentUser().openid, 'openid_dad');\n\n  const createRes = await familyService.createFamily('温馨四口之家食堂');\n  assert(createRes.success, '房主创建家庭成功');\n  const familyId = createRes.family.id;\n  const inviteCode = createRes.family.inviteCode;\n  console.log(`✅ 房主创建家庭成功: 【${createRes.family.name}】(ID: ${familyId}), 6位口令: ${inviteCode}`);\n  assert.equal(inviteCode.length, 6, '邀请码应为 6 位数字');\n\n  // -------------------------------------------------------------\n  // 【阶段 2】4 人逐一绑定加入，并发防超员拦截第 5 人 (攻防测试)\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 2】全家 4 人逐一绑定，并发防超员拦截第 5 人');\n\n  // 妈妈加入\n  await switchDevice(deviceMom);\n  const momJoin = await familyService.joinFamily(inviteCode);\n  assert(momJoin.success, '妈妈加入家庭成功');\n  console.log('✅ 妈妈成功加入绑定！');\n\n  // 大宝加入\n  await switchDevice(deviceKid);\n  const kidJoin = await familyService.joinFamily(inviteCode);\n  assert(kidJoin.success, '大宝加入家庭成功');\n  console.log('✅ 大宝成功加入绑定！');\n\n  // 奶奶加入\n  await switchDevice(deviceGrandma);\n  const grandmaJoin = await familyService.joinFamily(inviteCode);\n  assert(grandmaJoin.success, '奶奶加入家庭成功');\n  console.log('✅ 奶奶成功加入绑定！当前成员已达上限 4 人');\n\n  // 第 5 人 (隔壁老王) 尝试加入\n  await switchDevice(deviceNeighbor);\n  const neighborJoin = await familyService.joinFamily(inviteCode);\n  assert.equal(neighborJoin.success, false, '第 5 人加入必须被拦截');\n  assert(neighborJoin.error.includes('已满') || neighborJoin.error.includes('上限4人'), '必须返回成员已满提示');\n  console.log(`✅ 拦截第 5 人并发加入成功: \"${neighborJoin.error}\"`);\n\n  // -------------------------------------------------------------\n  // 【阶段 3】奶奶录入纯文字自选私房菜，全家共享可见\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 3】奶奶纯文字录入私房菜 (零图片上传) 并全家共享');\n  await switchDevice(deviceGrandma);\n\n  // 模拟敏感词被拒\n  const badDishRes = await dataProvider.addCustomDish({\n    name: '低息贷款特级炒肉',\n    category: 'main_meat'\n  }).catch(e => ({ success: false, error: e.message }));\n  assert.equal(badDishRes.success, false, '敏感词录入必须被前端/服务端双重拦截');\n  console.log('✅ 违规内容拦截测试通过！');\n\n  // 正常录入纯文字私房菜\n  const addDishRes = await dataProvider.addCustomDish({\n    name: '奶奶牌秘制东坡肉',\n    category: 'main_meat',\n    taste: ['浓郁', '酸甜'],\n    cookingTimeMinutes: 60,\n    tags: ['拿手大菜', '秘制']\n  });\n  assert(addDishRes && addDishRes.name === '奶奶牌秘制东坡肉', '奶奶牌东坡肉录入成功');\n  const dongpoDish = addDishRes;\n  assert.equal(dongpoDish.thumbUrl, '/assets/dishes/default_main.jpg', '自动匹配主荤美学大图');\n  assert(dongpoDish.dishEmoji, '自动匹配专属 Emoji 图标');\n  assert(Array.isArray(dongpoDish.ingredients) && dongpoDish.ingredients.length === 0, '未录入食材必须为空数组，坚决不虚构克重');\n  console.log(`✅ 奶奶成功录入纯文字私房菜: 【${dongpoDish.name}】(${dongpoDish.dishEmoji})`);\n\n  // 验证爸爸端拉取私房菜库\n  await switchDevice(deviceDad);\n  await dataProvider.syncCloudCustomDishes();\n  const dadDishes = dataProvider.getAllDishes();\n  const foundInDad = dadDishes.find(d => d.name === '奶奶牌秘制东坡肉');\n  assert(foundInDad, '爸爸端必须能查看到奶奶录入的私房菜！');\n  console.log('✅ 爸爸端无缝共享查看到奶奶的私房菜，全家私房菜库打通！');\n\n  // -------------------------------------------------------------\n  // 【阶段 4】妈妈安排【今日午餐】并确认开饭\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 4】妈妈安排【今日午餐】并确认开饭');\n  await switchDevice(deviceMom);\n  historyService.clearHistory();\n\n  const lunchDishes = [\n    dongpoDish, // 奶奶的私房菜\n    dataProvider.getDishById('d_pork_02') || { id: 'd_pork_02', name: '青椒肉丝' },\n    dataProvider.getDishById('d_veg_01') || { id: 'd_veg_01', name: '清炒菜心' }\n  ];\n\n  const lunchRecord = historyService.recordMeal('hearty_3_1', lunchDishes, '2026-10-02', 'menu_lunch_01', '午餐');\n  assert.equal(lunchRecord.mealType, '午餐');\n  await historyService.flushPendingQueue();\n  console.log('✅ 妈妈成功记录【2026-10-02 午餐】: 奶奶牌秘制东坡肉 + 青椒肉丝 + 清炒菜心');\n\n  // -------------------------------------------------------------\n  // 【阶段 5】爸爸安排【今日晚餐】并确认开饭 (同日多餐 0 覆盖测试)\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 5】爸爸安排【今日晚餐】并确认开饭 (同日多餐 0 覆盖检验)');\n  await switchDevice(deviceDad);\n  // 爸爸拉取云端历史\n  await historyService.syncCloudHistory();\n\n  const dinnerDishes = [\n    dataProvider.getDishById('d_beef_01') || { id: 'd_beef_01', name: '番茄炖牛腩' },\n    dataProvider.getDishById('d_fish_01') || { id: 'd_fish_01', name: '清蒸鲈鱼' },\n    dataProvider.getDishById('d_soup_01') || { id: 'd_soup_01', name: '冬瓜排骨汤' }\n  ];\n\n  const dinnerRecord = historyService.recordMeal('hearty_3_1', dinnerDishes, '2026-10-02', 'menu_dinner_01', '晚餐');\n  assert.equal(dinnerRecord.mealType, '晚餐');\n  await historyService.flushPendingQueue();\n\n  // 验证爸爸本地历史中午餐与晚餐并存\n  const dadHistory = historyService.getHistory();\n  const todayMeals = dadHistory.filter(h => h.date === '2026-10-02');\n  assert.equal(todayMeals.length, 2, '同日必须并存午餐与晚餐 2 条记录，坚决杜绝覆盖写！');\n  assert(todayMeals.some(m => m.mealType === '午餐'), '午餐记录完好保留');\n  assert(todayMeals.some(m => m.mealType === '晚餐'), '晚餐记录完好保留');\n  console.log('✅ 爸爸端检验：同日多餐午餐与晚餐 100% 独立并存，0 覆盖！');\n\n  // 验证大宝手机端也同步看到了全家两餐\n  await switchDevice(deviceKid);\n  historyService.clearHistory();\n  await historyService.syncCloudHistory();\n  const kidHistory = historyService.getHistory();\n  assert.equal(kidHistory.filter(h => h.date === '2026-10-02').length, 2, '大宝端拉取全家历史必须呈现 2 顿记录');\n  console.log('✅ 大宝端拉取检验：同样完整看到全家今天的午餐与晚餐！');\n\n  // -------------------------------------------------------------\n  // 【阶段 6】次日排餐智能避重穿透检验\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 6】次日 (10月3日) 排餐读取全家共享历史避重');\n  await switchDevice(deviceDad);\n  const tomorrowMenu = menuRecommendationEngine.generateMenu({\n    mode: 'hearty_3_1',\n    currentMonth: 10,\n    preferences: {\n      mode: 'hearty_3_1',\n      spicyLevel: 0,\n      dislikedIngredients: [],\n      customDietaryTags: []\n    },\n    history: historyService.getHistory(),\n    allDishes: dataProvider.getAllDishes(),\n    targetDateDay: 'tomorrow'\n  });\n\n  const tomorrowDishNames = tomorrowMenu.slots.map(s => s.dish.name);\n  console.log('明天自动排餐结果:', tomorrowDishNames.join(' + '));\n  // 验证昨日吃过的菜绝不重复出现在明天菜单中\n  assert(!tomorrowDishNames.includes('奶奶牌秘制东坡肉'), '昨日吃过的奶奶私房菜应被避重');\n  assert(!tomorrowDishNames.includes('青椒肉丝'), '昨日吃过的青椒肉丝应被避重');\n  assert(!tomorrowDishNames.includes('清蒸鲈鱼'), '昨日吃过的清蒸鲈鱼应被避重');\n  console.log('✅ 智能排餐成功避开全家昨日午餐和晚餐吃过的全部菜品！');\n\n  // -------------------------------------------------------------\n  // 【阶段 7】大厨交付中心买菜清单与微信卡片免密扫码还原\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 7】交付中心买菜清单与大厨端免密扫码还原');\n  const shoppingList = shoppingListService.generateShoppingList(tomorrowMenu.slots.map(s => s.dish));\n  assert(shoppingList.length > 0, '买菜清单生成成功');\n  console.log(`✅ 自动生成买菜食材项: ${shoppingList.length} 样 (包含菜场口语化斤两)`);\n\n  const shareParam = shoppingListService.serializeMenuForShare(tomorrowMenu);\n  assert(shareParam.length <= 1500, '微信分享参数在 2048 安全限制内');\n\n  // 大厨免密还原\n  const restoredMenu = shoppingListService.deserializeSharedMenu(shareParam, dataProvider.getAllDishes());\n  assert.equal(restoredMenu.slots.length, tomorrowMenu.slots.length, '大厨端完美秒开还原菜单');\n  console.log('✅ 大厨端微信免密秒开 100% 还原成功！');\n\n  // -------------------------------------------------------------\n  // 【阶段 8】断网离线 SWR、离线队列入队与网络恢复自动同步\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 8】断网离线模式 SWR 秒开与连网静默自动恢复');\n  await switchDevice(deviceDad);\n\n  // 1. 断网离线\n  setNetworkStatus(false);\n  console.log('📴 模拟手机切入飞行模式 (断网离线)...');\n\n  // 2. 离线查看历史：SWR 本地优先，0 延迟秒开\n  const offlineHist = historyService.getHistory();\n  assert(offlineHist.length >= 2, '断网下依然秒开查看本地缓存历史');\n  console.log('✅ SWR 离线秒开验证通过：0 毫秒首屏直出！');\n\n  // 3. 离线确认开饭 (第三餐: 夜宵)\n  const supperDishes = [{ id: 'd_egg_01', name: '西红柿炒鸡蛋' }];\n  const supperRecord = historyService.recordMeal('routine_2_1', supperDishes, '2026-10-02', 'menu_supper_01', '夜宵');\n  assert.equal(supperRecord.syncStatus, 'pending', '离线开饭标记为待同步');\n\n  // 等待离线调用完成结算并释放 isSyncing 状态锁\n  await new Promise(r => setTimeout(r, 50));\n\n  // 4. 恢复网络连接\n  console.log('📶 模拟网络恢复 (连接 Wi-Fi)...');\n  setNetworkStatus(true);\n\n  // 等待网络恢复触发的异步排空队列完成\n  await new Promise(r => setTimeout(r, 100));\n\n  const syncedHist = historyService.getHistory();\n  const supperSynced = syncedHist.find(h => h.mealType === '夜宵');\n  assert.equal(supperSynced.syncStatus, 'synced', '连网后离线队列自动上报完成并标记为 synced');\n  console.log('✅ 网络恢复监听生效：离线记录已自动静默同步至云端！');\n\n  // -------------------------------------------------------------\n  // 【阶段 9】成员 (大宝) 退出家庭，数据纯净复位单人模式\n  // -------------------------------------------------------------\n  console.log('\\n【阶段 9】成员 (大宝) 退出家庭与纯净复位');\n  await switchDevice(deviceKid);\n\n  const leaveRes = await familyService.leaveFamily();\n  assert(leaveRes.success, '大宝退出家庭成功');\n  assert.equal(familyService.getCurrentUser().familyId, null, '大宝已恢复为个人模式');\n\n  historyService.clearHistory();\n  dataProvider.clearCustomDishes();\n  assert.equal(historyService.getHistory().length, 0, '大宝本地历史已纯净清空');\n  console.log('✅ 大宝成功退出家庭，本地数据纯净复位，不影响原家庭！');\n\n  // 验证爸爸端家庭空间成员变为 3 人，爸爸仍为房主\n  await switchDevice(deviceDad);\n  const famAfterLeave = hub.families.get(familyId);\n  assert.equal(famAfterLeave.members.length, 3, '家庭成员人数正确减为 3 人');\n  assert.equal(famAfterLeave.creatorOpenid, 'openid_dad', '爸爸房主权属完好保持');\n  console.log('✅ 房主端核查：家庭成员正确缩容为 3 人，房主权属坚如磐石！');\n","numLines":290,"startLine":340,"totalLines":639}}}
