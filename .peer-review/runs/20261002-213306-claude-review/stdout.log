{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BwqVvu46jVT7zN8DcZHmhr","type":"tool_result","content":"1\timport type { MealHistoryRecord, MealMode } from '../types/user.js';\n2\timport type { Dish } from '../types/dish.js';\n3\timport { familyService } from './familyService.js';\n4\timport { cloudService } from './cloudService.js';\n5\t\n6\tconst STORAGE_KEY = 'meal_history_records';\n7\tconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n8\t\n9\tinterface PendingSyncItem {\n10\t  targetFamilyId: string;\n11\t  authorOpenid: string;\n12\t  record: MealHistoryRecord;\n13\t}\n14\t\n15\ttype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n16\t\n17\tclass HistoryService {\n18\t  private memoryHistory: MealHistoryRecord[] = [];\n19\t  private pendingQueue: PendingSyncItem[] = [];\n20\t  private listeners: Set<HistoryChangeListener> = new Set();\n21\t  private isSyncing = false;\n22\t\n23\t  constructor() {\n24\t    this.restoreFromStorage();\n25\t    this.initNetworkListener();\n26\t  }\n27\t\n28\t  /**\n29\t   * 监听网络状态变化：当连网时自动静默上报离线待同步队列\n30\t   */\n31\t  private initNetworkListener() {\n32\t    if (typeof wx !== 'undefined' && typeof wx.onNetworkStatusChange === 'function') {\n33\t      wx.onNetworkStatusChange((res: { isConnected: boolean; networkType: string }) => {\n34\t        if (res && res.isConnected) {\n35\t          console.log('[HistoryService] 网络连接已恢复，自动触发待同步离线队列上报...');\n36\t          this.flushPendingQueue().catch(err => {\n37\t            console.warn('[HistoryService] 连网自动上报待同步队列异常:', err);\n38\t          });\n39\t        }\n40\t      });\n41\t    }\n42\t  }\n43\t\n44\t  private restoreFromStorage() {\n45\t    try {\n46\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n47\t        const stored = wx.getStorageSync(STORAGE_KEY);\n48\t        if (stored && Array.isArray(stored)) {\n49\t          this.memoryHistory = stored;\n50\t        }\n51\t        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n52\t        if (queued && Array.isArray(queued)) {\n53\t          this.pendingQueue = queued;\n54\t        }\n55\t      }\n56\t    } catch (e) {\n57\t      console.warn('读取本地历史失败，使用内存降级', e);\n58\t    }\n59\t  }\n60\t\n61\t  /**\n62\t   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n63\t   */\n64\t  public subscribe(listener: HistoryChangeListener): () => void {\n65\t    this.listeners.add(listener);\n66\t    return () => this.listeners.delete(listener);\n67\t  }\n68\t\n69\t  private notifyListeners(): void {\n70\t    const list = this.getHistory();\n71\t    for (const listener of this.listeners) {\n72\t      try {\n73\t        listener(list);\n74\t      } catch (err) {\n75\t        console.error('历史状态订阅回调异常', err);\n76\t      }\n77\t    }\n78\t  }\n79\t\n80\t  /**\n81\t   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n82\t   */\n83\t  public getHistory(): MealHistoryRecord[] {\n84\t    try {\n85\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n86\t        const stored = wx.getStorageSync(STORAGE_KEY);\n87\t        if (stored && Array.isArray(stored)) {\n88\t          return stored;\n89\t        }\n90\t      }\n91\t    } catch (e) {\n92\t      console.warn('读取本地历史失败，使用内存降级', e);\n93\t    }\n94\t    return this.memoryHistory;\n95\t  }\n96\t\n97\t  /**\n98\t   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n99\t   */\n100\t  public deduceMealType(dateObj = new Date()): string {\n101\t    const hour = dateObj.getHours();\n102\t    if (hour >= 5 && hour < 10) return '早餐';\n103\t    if (hour >= 10 && hour < 15) return '午餐';\n104\t    if (hour >= 15 && hour < 21) return '晚餐';\n105\t    return '加餐';\n106\t  }\n107\t\n108\t  /**\n109\t   * 确认开饭：将菜单正式写入就餐历史\n110\t   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n111\t   */\n112\t  public recordMeal(\n113\t    mode: MealMode,\n114\t    dishes: Dish[],\n115\t    dateStr?: string,\n116\t    menuId?: string,\n117\t    mealType?: string\n118\t  ): MealHistoryRecord {\n119\t    const history = this.getHistory();\n120\t    const now = new Date();\n121\t    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n122\t    const targetDate = dateStr || localDate;\n123\t    const resolvedMealType = mealType || this.deduceMealType(now);\n124\t    const randSuffix = Math.random().toString(36).slice(2, 6);\n125\t    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n126\t\n127\t    const currentUser = familyService.getCurrentUser();\n128\t    const currentFamily = familyService.getCurrentFamily();\n129\t    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n130\t\n131\t    const newRecord: MealHistoryRecord = {\n132\t      id: mealId,\n133\t      menuId,\n134\t      mealId,\n135\t      date: targetDate,\n136\t      timestamp: now.getTime(),\n137\t      mode,\n138\t      mealType: resolvedMealType,\n139\t      dishIds: dishes.map(d => d.id),\n140\t      dishNames: dishes.map(d => d.name),\n141\t      dishes: dishes.map(d => ({\n142\t        id: d.id,\n143\t        name: d.name,\n144\t        category: d.category,\n145\t        thumbUrl: d.thumbUrl,\n146\t        dishEmoji: d.dishEmoji,\n147\t        isCustom: (d as any).isCustom\n148\t      })),\n149\t      confirmedBy: currentUser.openid,\n150\t      confirmedByName: currentUser.nickName || '家人',\n151\t      familyId,\n152\t      syncStatus: familyId ? 'pending' : 'synced'\n153\t    };\n154\t\n155\t    // 智能去重判断：\n156\t    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n157\t    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n158\t    const existingIndex = history.findIndex(r =>\n159\t      r.id === mealId ||\n160\t      (Boolean(menuId) && r.menuId === menuId) ||\n161\t      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n162\t    );\n163\t\n164\t    let updated: MealHistoryRecord[];\n165\t    if (existingIndex >= 0) {\n166\t      updated = [...history];\n167\t      updated[existingIndex] = newRecord;\n168\t    } else {\n169\t      updated = [newRecord, ...history].slice(0, 60);\n170\t    }\n171\t\n172\t    this.saveHistory(updated);\n173\t\n174\t    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n175\t    if (familyId) {\n176\t      this.enqueuePendingSync({\n177\t        targetFamilyId: familyId,\n178\t        authorOpenid: currentUser.openid,\n179\t        record: newRecord\n180\t      });\n181\t      // 触发后台静默同步\n182\t      this.flushPendingQueue().catch(() => {});\n183\t    }\n184\t\n185\t    return newRecord;\n186\t  }\n187\t\n188\t  /**\n189\t   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n190\t   */\n191\t  private enqueuePendingSync(item: PendingSyncItem) {\n192\t    this.pendingQueue.push(item);\n193\t    this.savePendingQueue();\n194\t  }\n195\t\n196\t  private savePendingQueue() {\n197\t    try {\n198\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n199\t        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n200\t      }\n201\t    } catch (e) {}\n202\t  }\n203\t\n204\t  /**\n205\t   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n206\t   */\n207\t  public async flushPendingQueue(): Promise<void> {\n208\t    if (this.isSyncing || this.pendingQueue.length === 0) return;\n209\t    this.isSyncing = true;\n210\t\n211\t    try {\n212\t      const currentFamily = familyService.getCurrentFamily();\n213\t      const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n214\t\n215\t      const remainingQueue: PendingSyncItem[] = [];\n216\t\n217\t      for (const item of this.pendingQueue) {\n218\t        // 关键防御：如果当前家庭与离线时所属家庭不一致，判定为废弃记录，安全丢弃，绝不上报！\n219\t        if (!currentFamilyId || currentFamilyId !== item.targetFamilyId) {\n220\t          console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n221\t          continue;\n222\t        }\n223\t\n224\t        const res = await cloudService.callFunction('upsertMeal', {\n225\t          action: 'upsertMeal',\n226\t          familyId: item.targetFamilyId,\n227\t          date: item.record.date,\n228\t          mockOpenid: item.authorOpenid,\n229\t          meal: {\n230\t            mealId: item.record.mealId || item.record.id,\n231\t            mealType: item.record.mealType,\n232\t            mode: item.record.mode,\n233\t            dishes: item.record.dishes,\n234\t            dishIds: item.record.dishIds,\n235\t            dishNames: item.record.dishNames,\n236\t            confirmedByName: item.record.confirmedByName,\n237\t            timestamp: item.record.timestamp\n238\t          }\n239\t        });\n240\t\n241\t        if (res.success) {\n242\t          // 标记本地记录为已同步\n243\t          const history = this.getHistory();\n244\t          const target = history.find(r => r.id === item.record.id);\n245\t          if (target) {\n246\t            target.syncStatus = 'synced';\n247\t            this.saveHistory([...history]);\n248\t            this.notifyListeners();\n249\t          }\n250\t        } else {\n251\t          // 提交失败，保留在队列中等待下次重试\n252\t          remainingQueue.push(item);\n253\t        }\n254\t      }\n255\t\n256\t      this.pendingQueue = remainingQueue;\n257\t      this.savePendingQueue();\n258\t    } finally {\n259\t      this.isSyncing = false;\n260\t    }\n261\t  }\n262\t\n263\t  /**\n264\t   * SWR 增量拉取家庭共享历史并合并到本地\n265\t   */\n266\t  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n267\t    const currentFamily = familyService.getCurrentFamily();\n268\t    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n269\t    if (!familyId) {\n270\t      return this.getHistory();\n271\t    }\n272\t\n273\t    // 先刷新离线待上报队列\n274\t    await this.flushPendingQueue();\n275\t\n276\t    const currentUser = familyService.getCurrentUser();\n277\t    const res = await cloudService.callFunction('upsertMeal', {\n278\t      action: 'getHistory',\n279\t      familyId,\n280\t      mockOpenid: currentUser.openid,\n281\t      limitDays: 60\n282\t    });\n283\t\n284\t    if (res.success && Array.isArray(res.records)) {\n285\t      const cloudRecords: MealHistoryRecord[] = res.records;\n286\t      const localRecords = this.getHistory();\n287\t\n288\t      // 双向合并：以餐次 mealId 为唯一标识\n289\t      const recordMap = new Map<string, MealHistoryRecord>();\n290\t\n291\t      // 先放入云端记录\n292\t      for (const cr of cloudRecords) {\n293\t        const key = cr.mealId || cr.id;\n294\t        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n295\t      }\n296\t\n297\t      // 再放入本地未同步或更新的属于当前家庭的记录\n298\t      for (const lr of localRecords) {\n299\t        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n300\t        if (lr.familyId && lr.familyId !== familyId) {\n301\t          continue;\n302\t        }\n303\t        const key = lr.mealId || lr.id;\n304\t        if (!recordMap.has(key)) {\n305\t          recordMap.set(key, lr);\n306\t        } else {\n307\t          // 如果本地是 pending，优先以本地为准\n308\t          if (lr.syncStatus === 'pending') {\n309\t            recordMap.set(key, lr);\n310\t          }\n311\t        }\n312\t      }\n313\t\n314\t      const merged = Array.from(recordMap.values());\n315\t      merged.sort((a, b) => b.timestamp - a.timestamp);\n316\t      const finalRecords = merged.slice(0, 60);\n317\t\n318\t      this.saveHistory(finalRecords);\n319\t      this.notifyListeners();\n320\t      return finalRecords;\n321\t    }\n322\t\n323\t    return this.getHistory();\n324\t  }\n325\t\n326\t  /**\n327\t   * 清空或重置历史 (用于测试或用户重置)\n328\t   */\n329\t  public clearHistory(): void {\n330\t    this.pendingQueue = [];\n331\t    this.savePendingQueue();\n332\t    this.saveHistory([]);\n333\t    this.notifyListeners();\n334\t  }\n335\t\n336\t  private saveHistory(records: MealHistoryRecord[]): void {\n337\t    this.memoryHistory = records;\n338\t    try {\n339\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n340\t        wx.setStorageSync(STORAGE_KEY, records);\n341\t      }\n342\t    } catch (e) {\n343\t      console.warn('保存本地历史失败', e);\n344\t    }\n345\t  }\n346\t}\n347\t\n348\texport const historyService = new HistoryService();\n349\t"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"2b543a4e-87f8-45dc-bf8c-6fda1b96c0e9","timestamp":"2026-10-02T13:33:46.968Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/historyService.ts","content":"import type { MealHistoryRecord, MealMode } from '../types/user.js';\nimport type { Dish } from '../types/dish.js';\nimport { familyService } from './familyService.js';\nimport { cloudService } from './cloudService.js';\n\nconst STORAGE_KEY = 'meal_history_records';\nconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n\ninterface PendingSyncItem {\n  targetFamilyId: string;\n  authorOpenid: string;\n  record: MealHistoryRecord;\n}\n\ntype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n\nclass HistoryService {\n  private memoryHistory: MealHistoryRecord[] = [];\n  private pendingQueue: PendingSyncItem[] = [];\n  private listeners: Set<HistoryChangeListener> = new Set();\n  private isSyncing = false;\n\n  constructor() {\n    this.restoreFromStorage();\n    this.initNetworkListener();\n  }\n\n  /**\n   * 监听网络状态变化：当连网时自动静默上报离线待同步队列\n   */\n  private initNetworkListener() {\n    if (typeof wx !== 'undefined' && typeof wx.onNetworkStatusChange === 'function') {\n      wx.onNetworkStatusChange((res: { isConnected: boolean; networkType: string }) => {\n        if (res && res.isConnected) {\n          console.log('[HistoryService] 网络连接已恢复，自动触发待同步离线队列上报...');\n          this.flushPendingQueue().catch(err => {\n            console.warn('[HistoryService] 连网自动上报待同步队列异常:', err);\n          });\n        }\n      });\n    }\n  }\n\n  private restoreFromStorage() {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(STORAGE_KEY);\n        if (stored && Array.isArray(stored)) {\n          this.memoryHistory = stored;\n        }\n        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n        if (queued && Array.isArray(queued)) {\n          this.pendingQueue = queued;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地历史失败，使用内存降级', e);\n    }\n  }\n\n  /**\n   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n   */\n  public subscribe(listener: HistoryChangeListener): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  private notifyListeners(): void {\n    const list = this.getHistory();\n    for (const listener of this.listeners) {\n      try {\n        listener(list);\n      } catch (err) {\n        console.error('历史状态订阅回调异常', err);\n      }\n    }\n  }\n\n  /**\n   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n   */\n  public getHistory(): MealHistoryRecord[] {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(STORAGE_KEY);\n        if (stored && Array.isArray(stored)) {\n          return stored;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地历史失败，使用内存降级', e);\n    }\n    return this.memoryHistory;\n  }\n\n  /**\n   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n   */\n  public deduceMealType(dateObj = new Date()): string {\n    const hour = dateObj.getHours();\n    if (hour >= 5 && hour < 10) return '早餐';\n    if (hour >= 10 && hour < 15) return '午餐';\n    if (hour >= 15 && hour < 21) return '晚餐';\n    return '加餐';\n  }\n\n  /**\n   * 确认开饭：将菜单正式写入就餐历史\n   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n   */\n  public recordMeal(\n    mode: MealMode,\n    dishes: Dish[],\n    dateStr?: string,\n    menuId?: string,\n    mealType?: string\n  ): MealHistoryRecord {\n    const history = this.getHistory();\n    const now = new Date();\n    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n    const targetDate = dateStr || localDate;\n    const resolvedMealType = mealType || this.deduceMealType(now);\n    const randSuffix = Math.random().toString(36).slice(2, 6);\n    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n\n    const currentUser = familyService.getCurrentUser();\n    const currentFamily = familyService.getCurrentFamily();\n    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n\n    const newRecord: MealHistoryRecord = {\n      id: mealId,\n      menuId,\n      mealId,\n      date: targetDate,\n      timestamp: now.getTime(),\n      mode,\n      mealType: resolvedMealType,\n      dishIds: dishes.map(d => d.id),\n      dishNames: dishes.map(d => d.name),\n      dishes: dishes.map(d => ({\n        id: d.id,\n        name: d.name,\n        category: d.category,\n        thumbUrl: d.thumbUrl,\n        dishEmoji: d.dishEmoji,\n        isCustom: (d as any).isCustom\n      })),\n      confirmedBy: currentUser.openid,\n      confirmedByName: currentUser.nickName || '家人',\n      familyId,\n      syncStatus: familyId ? 'pending' : 'synced'\n    };\n\n    // 智能去重判断：\n    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n    const existingIndex = history.findIndex(r =>\n      r.id === mealId ||\n      (Boolean(menuId) && r.menuId === menuId) ||\n      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n    );\n\n    let updated: MealHistoryRecord[];\n    if (existingIndex >= 0) {\n      updated = [...history];\n      updated[existingIndex] = newRecord;\n    } else {\n      updated = [newRecord, ...history].slice(0, 60);\n    }\n\n    this.saveHistory(updated);\n\n    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n    if (familyId) {\n      this.enqueuePendingSync({\n        targetFamilyId: familyId,\n        authorOpenid: currentUser.openid,\n        record: newRecord\n      });\n      // 触发后台静默同步\n      this.flushPendingQueue().catch(() => {});\n    }\n\n    return newRecord;\n  }\n\n  /**\n   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n   */\n  private enqueuePendingSync(item: PendingSyncItem) {\n    this.pendingQueue.push(item);\n    this.savePendingQueue();\n  }\n\n  private savePendingQueue() {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n      }\n    } catch (e) {}\n  }\n\n  /**\n   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n   */\n  public async flushPendingQueue(): Promise<void> {\n    if (this.isSyncing || this.pendingQueue.length === 0) return;\n    this.isSyncing = true;\n\n    try {\n      const currentFamily = familyService.getCurrentFamily();\n      const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n\n      const remainingQueue: PendingSyncItem[] = [];\n\n      for (const item of this.pendingQueue) {\n        // 关键防御：如果当前家庭与离线时所属家庭不一致，判定为废弃记录，安全丢弃，绝不上报！\n        if (!currentFamilyId || currentFamilyId !== item.targetFamilyId) {\n          console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n          continue;\n        }\n\n        const res = await cloudService.callFunction('upsertMeal', {\n          action: 'upsertMeal',\n          familyId: item.targetFamilyId,\n          date: item.record.date,\n          mockOpenid: item.authorOpenid,\n          meal: {\n            mealId: item.record.mealId || item.record.id,\n            mealType: item.record.mealType,\n            mode: item.record.mode,\n            dishes: item.record.dishes,\n            dishIds: item.record.dishIds,\n            dishNames: item.record.dishNames,\n            confirmedByName: item.record.confirmedByName,\n            timestamp: item.record.timestamp\n          }\n        });\n\n        if (res.success) {\n          // 标记本地记录为已同步\n          const history = this.getHistory();\n          const target = history.find(r => r.id === item.record.id);\n          if (target) {\n            target.syncStatus = 'synced';\n            this.saveHistory([...history]);\n            this.notifyListeners();\n          }\n        } else {\n          // 提交失败，保留在队列中等待下次重试\n          remainingQueue.push(item);\n        }\n      }\n\n      this.pendingQueue = remainingQueue;\n      this.savePendingQueue();\n    } finally {\n      this.isSyncing = false;\n    }\n  }\n\n  /**\n   * SWR 增量拉取家庭共享历史并合并到本地\n   */\n  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n    const currentFamily = familyService.getCurrentFamily();\n    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n    if (!familyId) {\n      return this.getHistory();\n    }\n\n    // 先刷新离线待上报队列\n    await this.flushPendingQueue();\n\n    const currentUser = familyService.getCurrentUser();\n    const res = await cloudService.callFunction('upsertMeal', {\n      action: 'getHistory',\n      familyId,\n      mockOpenid: currentUser.openid,\n      limitDays: 60\n    });\n\n    if (res.success && Array.isArray(res.records)) {\n      const cloudRecords: MealHistoryRecord[] = res.records;\n      const localRecords = this.getHistory();\n\n      // 双向合并：以餐次 mealId 为唯一标识\n      const recordMap = new Map<string, MealHistoryRecord>();\n\n      // 先放入云端记录\n      for (const cr of cloudRecords) {\n        const key = cr.mealId || cr.id;\n        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n      }\n\n      // 再放入本地未同步或更新的属于当前家庭的记录\n      for (const lr of localRecords) {\n        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n        if (lr.familyId && lr.familyId !== familyId) {\n          continue;\n        }\n        const key = lr.mealId || lr.id;\n        if (!recordMap.has(key)) {\n          recordMap.set(key, lr);\n        } else {\n          // 如果本地是 pending，优先以本地为准\n          if (lr.syncStatus === 'pending') {\n            recordMap.set(key, lr);\n          }\n        }\n      }\n\n      const merged = Array.from(recordMap.values());\n      merged.sort((a, b) => b.timestamp - a.timestamp);\n      const finalRecords = merged.slice(0, 60);\n\n      this.saveHistory(finalRecords);\n      this.notifyListeners();\n      return finalRecords;\n    }\n\n    return this.getHistory();\n  }\n\n  /**\n   * 清空或重置历史 (用于测试或用户重置)\n   */\n  public clearHistory(): void {\n    this.pendingQueue = [];\n    this.savePendingQueue();\n    this.saveHistory([]);\n    this.notifyListeners();\n  }\n\n  private saveHistory(records: MealHistoryRecord[]): void {\n    this.memoryHistory = records;\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(STORAGE_KEY, records);\n      }\n    } catch (e) {\n      console.warn('保存本地历史失败', e);\n    }\n  }\n}\n\nexport const historyService = new HistoryService();\n","numLines":349,"startLine":1,"totalLines":349}}}
