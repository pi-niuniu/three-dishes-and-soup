{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0145MoPVcY1AkVQLJTSVeVr8","type":"tool_result","content":"60\t  }\n61\t\n62\t  simulateNetworkChange(isConnected) {\n63\t    this.isOnline = isConnected;\n64\t    for (const cb of this.networkListeners) {\n65\t      cb({ isConnected, networkType: isConnected ? 'wifi' : 'none' });\n66\t    }\n67\t  }\n68\t}\n69\t\n70\t// 2. 模拟微信云端数据库与云函数中心 (CloudBase Central Hub)\n71\tclass MockCloudBaseHub {\n72\t  constructor() {\n73\t    this.users = new Map();\n74\t    this.families = new Map();\n75\t    this.mealHistories = new Map(); // key: meal_${familyId}_${date}\n76\t    this.customDishes = new Map(); // key: dishId\n77\t    this.sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n78\t  }\n79\t\n80\t  async callFunction({ name, data }, callerOpenid) {\n81\t    const now = Date.now();\n82\t\n83\t    if (name === 'userAuth') {\n84\t      const openid = callerOpenid;\n85\t      let user = this.users.get(openid);\n86\t      if (!user) {\n87\t        user = {\n88\t          _id: `user_${openid}`,\n89\t          openid,\n90\t          nickName: data.nickName || '微信用户',\n91\t          familyId: null,\n92\t          role: 'personal',\n93\t          createdAt: now\n94\t        };\n95\t        this.users.set(openid, user);\n96\t      }\n97\t      let family = null;\n98\t      if (user.familyId) {\n99\t        family = this.families.get(user.familyId) || null;\n100\t      }\n101\t      return { success: true, user, family, openid };\n102\t    }\n103\t\n104\t    if (name === 'familyManage') {\n105\t      const openid = callerOpenid;\n106\t      const { action } = data;\n107\t\n108\t      if (action === 'createFamily') {\n109\t        const name = (data.name || '我的家庭厨房').trim();\n110\t        if (this.sensitiveWords.some(w => name.includes(w))) {\n111\t          return { success: false, error: '家庭名称包含敏感词' };\n112\t        }\n113\t        const famId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n114\t        const inviteCode = String(Math.floor(100000 + Math.random() * 900000));\n115\t        const family = {\n116\t          _id: famId,\n117\t          id: famId,\n118\t          name,\n119\t          creatorOpenid: openid,\n120\t          members: [{ openid, nickName: data.nickName || '房主', role: 'creator', joinedAt: now }],\n121\t          memberOpenids: [openid],\n122\t          inviteCode,\n123\t          inviteExpiredAt: now + 24 * 3600 * 1000,\n124\t          updatedAt: now\n125\t        };\n126\t        this.families.set(famId, family);\n127\t\n128\t        // 更新用户归属\n129\t        const user = this.users.get(openid) || { _id: `user_${openid}`, openid };\n130\t        user.familyId = famId;\n131\t        user.role = 'creator';\n132\t        this.users.set(openid, user);\n133\t\n134\t        return { success: true, family };\n135\t      }\n136\t\n137\t      if (action === 'joinFamily') {\n138\t        const { inviteCode, nickName = '家庭成员' } = data;\n139\t        let targetFam = null;"}]},"parent_tool_use_id":null,"session_id":"6b5e7858-15b0-4878-b3cb-fa7a55140242","uuid":"66b04146-43f9-462e-ae8d-3b7dbc43e2b6","timestamp":"2026-10-02T13:34:37.161Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/test/e2e_family_custom_full_flow_test.mjs","content":"  }\n\n  simulateNetworkChange(isConnected) {\n    this.isOnline = isConnected;\n    for (const cb of this.networkListeners) {\n      cb({ isConnected, networkType: isConnected ? 'wifi' : 'none' });\n    }\n  }\n}\n\n// 2. 模拟微信云端数据库与云函数中心 (CloudBase Central Hub)\nclass MockCloudBaseHub {\n  constructor() {\n    this.users = new Map();\n    this.families = new Map();\n    this.mealHistories = new Map(); // key: meal_${familyId}_${date}\n    this.customDishes = new Map(); // key: dishId\n    this.sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n  }\n\n  async callFunction({ name, data }, callerOpenid) {\n    const now = Date.now();\n\n    if (name === 'userAuth') {\n      const openid = callerOpenid;\n      let user = this.users.get(openid);\n      if (!user) {\n        user = {\n          _id: `user_${openid}`,\n          openid,\n          nickName: data.nickName || '微信用户',\n          familyId: null,\n          role: 'personal',\n          createdAt: now\n        };\n        this.users.set(openid, user);\n      }\n      let family = null;\n      if (user.familyId) {\n        family = this.families.get(user.familyId) || null;\n      }\n      return { success: true, user, family, openid };\n    }\n\n    if (name === 'familyManage') {\n      const openid = callerOpenid;\n      const { action } = data;\n\n      if (action === 'createFamily') {\n        const name = (data.name || '我的家庭厨房').trim();\n        if (this.sensitiveWords.some(w => name.includes(w))) {\n          return { success: false, error: '家庭名称包含敏感词' };\n        }\n        const famId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const inviteCode = String(Math.floor(100000 + Math.random() * 900000));\n        const family = {\n          _id: famId,\n          id: famId,\n          name,\n          creatorOpenid: openid,\n          members: [{ openid, nickName: data.nickName || '房主', role: 'creator', joinedAt: now }],\n          memberOpenids: [openid],\n          inviteCode,\n          inviteExpiredAt: now + 24 * 3600 * 1000,\n          updatedAt: now\n        };\n        this.families.set(famId, family);\n\n        // 更新用户归属\n        const user = this.users.get(openid) || { _id: `user_${openid}`, openid };\n        user.familyId = famId;\n        user.role = 'creator';\n        this.users.set(openid, user);\n\n        return { success: true, family };\n      }\n\n      if (action === 'joinFamily') {\n        const { inviteCode, nickName = '家庭成员' } = data;\n        let targetFam = null;","numLines":80,"startLine":60,"totalLines":639}}}
