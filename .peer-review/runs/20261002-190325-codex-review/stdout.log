{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"for task_file in miniprogram/services/historyService.ts miniprogram/services/dataProvider.ts miniprogram/services/preferenceService.ts miniprogram/types/user.ts miniprogram/types/dish.ts; do printf '\\\\n%s\\\\n' \\\"\"'$task_file\"; nl -ba \"$task_file\"; done'","aggregated_output":"\nminiprogram/services/historyService.ts\n     1\timport type { MealHistoryRecord, MealMode } from '../types/user.js';\n     2\timport type { Dish } from '../types/dish.js';\n     3\t\n     4\tconst STORAGE_KEY = 'meal_history_records';\n     5\t\n     6\tclass HistoryService {\n     7\t  private memoryHistory: MealHistoryRecord[] = [];\n     8\t\n     9\t  /**\n    10\t   * 获取最近的就餐历史 (默认 30 天)\n    11\t   */\n    12\t  public getHistory(): MealHistoryRecord[] {\n    13\t    try {\n    14\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    15\t        const stored = wx.getStorageSync(STORAGE_KEY);\n    16\t        if (stored && Array.isArray(stored)) {\n    17\t          return stored;\n    18\t        }\n    19\t      }\n    20\t    } catch (e) {\n    21\t      console.warn('读取本地历史失败，使用内存降级', e);\n    22\t    }\n    23\t    return this.memoryHistory;\n    24\t  }\n    25\t\n    26\t  /**\n    27\t   * 确认开饭：将菜单正式写入历史记录 (防重门禁)\n    28\t   */\n    29\t  public recordMeal(mode: MealMode, dishes: Dish[], dateStr?: string, menuId?: string): MealHistoryRecord {\n    30\t    const history = this.getHistory();\n    31\t    const now = new Date();\n    32\t    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n    33\t    const targetDate = dateStr || localDate;\n    34\t    const recordId = menuId ? `hist_${menuId}` : `hist_${Date.now()}`;\n    35\t\n    36\t    const newRecord: MealHistoryRecord = {\n    37\t      id: recordId,\n    38\t      menuId,\n    39\t      date: targetDate,\n    40\t      timestamp: Date.now(),\n    41\t      mode,\n    42\t      dishIds: dishes.map(d => d.id),\n    43\t      dishNames: dishes.map(d => d.name)\n    44\t    };\n    45\t\n    46\t    // 如果当前菜单已记录过（如反复进出结果页与交付中心），就地更新防止历史列表堆积重复记录\n    47\t    const existingIndex = history.findIndex(r => r.id === recordId || (r.date === targetDate && r.dishNames.join(',') === newRecord.dishNames.join(',')));\n    48\t    let updated: MealHistoryRecord[];\n    49\t    if (existingIndex >= 0) {\n    50\t      updated = [...history];\n    51\t      updated[existingIndex] = newRecord;\n    52\t    } else {\n    53\t      updated = [newRecord, ...history].slice(0, 60);\n    54\t    }\n    55\t\n    56\t    this.saveHistory(updated);\n    57\t    return newRecord;\n    58\t  }\n    59\t\n    60\t  /**\n    61\t   * 清空或重置历史 (用于测试或用户重置)\n    62\t   */\n    63\t  public clearHistory(): void {\n    64\t    this.saveHistory([]);\n    65\t  }\n    66\t\n    67\t  private saveHistory(records: MealHistoryRecord[]): void {\n    68\t    this.memoryHistory = records;\n    69\t    try {\n    70\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n    71\t        wx.setStorageSync(STORAGE_KEY, records);\n    72\t      }\n    73\t    } catch (e) {\n    74\t      console.warn('保存本地历史失败', e);\n    75\t    }\n    76\t  }\n    77\t}\n    78\t\n    79\texport const historyService = new HistoryService();\n\nminiprogram/services/dataProvider.ts\n     1\timport type { Dish } from '../types/dish.js';\n     2\timport type { SeasonalIngredient } from '../types/ingredient.js';\n     3\timport { defaultDishes } from '../data/dishesData.js';\n     4\timport { defaultIngredients } from '../data/ingredientsData.js';\n     5\t\n     6\t/**\n     7\t * 数据提供层服务 (DataProvider)\n     8\t * 职责：统一管理菜品库、时令库的加载，初期为本地静态加载，后续平滑扩充云数据库同步\n     9\t */\n    10\tclass DataProvider {\n    11\t  private dishes: Dish[] = [];\n    12\t  private ingredients: SeasonalIngredient[] = [];\n    13\t  private initialized = false;\n    14\t\n    15\t  constructor() {\n    16\t    this.init();\n    17\t  }\n    18\t\n    19\t  public init(): void {\n    20\t    if (this.initialized) return;\n    21\t    this.dishes = defaultDishes;\n    22\t    this.ingredients = defaultIngredients;\n    23\t    this.initialized = true;\n    24\t  }\n    25\t\n    26\t  /**\n    27\t   * 获取所有启用的菜品\n    28\t   */\n    29\t  public getAllDishes(): Dish[] {\n    30\t    return this.dishes.filter(d => d.enabled);\n    31\t  }\n    32\t\n    33\t  /**\n    34\t   * 根据 ID 查找菜品\n    35\t   */\n    36\t  public getDishById(id: string): Dish | undefined {\n    37\t    return this.dishes.find(d => d.id === id);\n    38\t  }\n    39\t\n    40\t  /**\n    41\t   * 获取当前月份的最佳时令食材\n    42\t   */\n    43\t  public getSeasonalIngredients(month: number): SeasonalIngredient[] {\n    44\t    return this.ingredients.filter(ing => ing.bestMonths.includes(month));\n    45\t  }\n    46\t\n    47\t  /**\n    48\t   * 获取所有时令食材列表\n    49\t   */\n    50\t  public getAllIngredients(): SeasonalIngredient[] {\n    51\t    return this.ingredients;\n    52\t  }\n    53\t}\n    54\t\n    55\texport const dataProvider = new DataProvider();\n\nminiprogram/services/preferenceService.ts\n     1\timport type { UserPreferences } from '../types/user.js';\n     2\t\n     3\tconst PREF_STORAGE_KEY = 'user_diet_preferences';\n     4\t\n     5\tconst DEFAULT_PREFERENCES: UserPreferences = {\n     6\t  peopleCount: 2,\n     7\t  defaultMode: 'hearty_3_1',\n     8\t  spicyLevel: 1, // 默认微辣\n     9\t  dislikedIngredients: [],\n    10\t  favoriteDishIds: [],\n    11\t  blockedDishIds: [],\n    12\t  region: '川渝'\n    13\t};\n    14\t\n    15\tclass PreferenceService {\n    16\t  private memoryPref: UserPreferences = { ...DEFAULT_PREFERENCES };\n    17\t\n    18\t  public getPreferences(): UserPreferences {\n    19\t    try {\n    20\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n    21\t        const stored = wx.getStorageSync(PREF_STORAGE_KEY);\n    22\t        if (stored) {\n    23\t          return { ...DEFAULT_PREFERENCES, ...stored };\n    24\t        }\n    25\t      }\n    26\t    } catch (e) {\n    27\t      console.warn('读取本地偏好失败，使用内存降级', e);\n    28\t    }\n    29\t    return this.memoryPref;\n    30\t  }\n    31\t\n    32\t  public savePreferences(pref: Partial<UserPreferences>): UserPreferences {\n    33\t    const current = this.getPreferences();\n    34\t    const updated = { ...current, ...pref };\n    35\t    this.memoryPref = updated;\n    36\t    try {\n    37\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n    38\t        wx.setStorageSync(PREF_STORAGE_KEY, updated);\n    39\t      }\n    40\t    } catch (e) {\n    41\t      console.warn('保存偏好失败', e);\n    42\t    }\n    43\t    return updated;\n    44\t  }\n    45\t\n    46\t  public toggleFavorite(dishId: string): boolean {\n    47\t    const pref = this.getPreferences();\n    48\t    const favs = new Set(pref.favoriteDishIds || []);\n    49\t    let isFav = false;\n    50\t    if (favs.has(dishId)) {\n    51\t      favs.delete(dishId);\n    52\t      isFav = false;\n    53\t    } else {\n    54\t      favs.add(dishId);\n    55\t      isFav = true;\n    56\t    }\n    57\t    this.savePreferences({ favoriteDishIds: Array.from(favs) });\n    58\t    return isFav;\n    59\t  }\n    60\t}\n    61\t\n    62\texport const preferenceService = new PreferenceService();\n\nminiprogram/types/user.ts\n     1\timport type { MealMode } from './menu.js';\n     2\texport type { MealMode };\n     3\t\n     4\t/**\n     5\t * 用户饮食偏好设置\n     6\t */\n     7\texport interface UserPreferences {\n     8\t  peopleCount: number;             // 用餐人数，默认 2\n     9\t  defaultMode: MealMode;           // 默认模式: routine_2_1 或 hearty_3_1\n    10\t  spicyLevel: 0 | 1 | 2 | 3;       // 最大可接受辣度 (0-不辣, 1-微辣, 2-中辣, 3-重辣)\n    11\t  dislikedIngredients: string[];   // 忌口/不吃食材，如 [\"香菜\", \"内脏\", \"羊肉\", \"苦瓜\"]\n    12\t  favoriteDishIds: string[];       // 收藏菜品ID列表\n    13\t  blockedDishIds: string[];        // 黑名单/永不推荐菜品ID列表\n    14\t  region: string;                  // 默认地区，默认 \"川渝\"\n    15\t}\n    16\t\n    17\t/**\n    18\t * 吃饭历史记录项\n    19\t */\n    20\texport interface MealHistoryRecord {\n    21\t  id: string;                      // 记录ID\n    22\t  menuId?: string;                 // 关联的菜单生成ID\n    23\t  date: string;                    // 就餐日期 \"YYYY-MM-DD\"\n    24\t  timestamp: number;               // 毫秒时间戳\n    25\t  mode: MealMode;                  // 模式\n    26\t  dishIds: string[];               // 菜品ID列表\n    27\t  dishNames: string[];             // 菜品名称快照 (用于直接展示)\n    28\t}\n\nminiprogram/types/dish.ts\n     1\t/**\n     2\t * 菜品分类枚举\n     3\t * main_meat: 主荤 (如红烧排骨、水煮牛肉、回锅肉等)\n     4\t * secondary_meat: 副荤/小荤 (如青椒肉丝、肉沫茄子、宫保鸡丁等)\n     5\t * egg: 蛋类 (如番茄炒蛋、肉沫蒸蛋等)\n     6\t * tofu: 豆制品 (如家常豆腐、麻婆豆腐等)\n     7\t * vegetable: 素菜 (绿叶菜、瓜类、根茎、菌菇)\n     8\t * soup: 汤类 (排骨汤、圆子汤、冬瓜汤、蛋花汤等)\n     9\t */\n    10\texport type DishCategory =\n    11\t  | 'main_meat'\n    12\t  | 'secondary_meat'\n    13\t  | 'egg'\n    14\t  | 'tofu'\n    15\t  | 'vegetable'\n    16\t  | 'soup'\n    17\t  | 'staple_sauce';\n    18\t\n    19\t/**\n    20\t * 烹饪方式\n    21\t */\n    22\texport type CookingMethod =\n    23\t  | 'stir_fry'    // 炒 / 爆炒\n    24\t  | 'clear_fry'   // 清炒\n    25\t  | 'braise'      // 红烧 / 酱烧\n    26\t  | 'stew'        // 炖 / 煨\n    27\t  | 'steam'       // 蒸\n    28\t  | 'boil_soup';  // 煮汤 / 滚汤\n    29\t\n    30\t/**\n    31\t * 菜品配方食材\n    32\t */\n    33\texport interface RecipeIngredient {\n    34\t  name: string;        // 食材标准名，如 \"猪里脊\"\n    35\t  amount: number;      // 2人份数值，如 200\n    36\t  unit: string;        // 计量单位，如 \"g\", \"个\", \"根\", \"适量\"\n    37\t  isMain?: boolean;    // 是否为核心主料\n    38\t}\n    39\t\n    40\t/**\n    41\t * 菜品完整数据结构\n    42\t */\n    43\texport interface Dish {\n    44\t  id: string;                      // 唯一ID\n    45\t  name: string;                    // 菜名\n    46\t  category: DishCategory;          // 核心分类\n    47\t  cookingMethod: CookingMethod;    // 烹饪方式\n    48\t  taste: string[];                 // 口味标签: [\"微辣\", \"下饭\", \"咸鲜\"]\n    49\t  spicyLevel: 0 | 1 | 2 | 3;       // 辣度: 0-不辣, 1-微辣, 2-中辣, 3-重辣\n    50\t  \n    51\t  ingredients: RecipeIngredient[];  // 配料明细 (两人份标准)\n    52\t  mainIngredient: string;          // 核心主食材 (用于防一桌重复，如 \"猪肉\")\n    53\t  \n    54\t  bestMonths: number[];            // 最佳月份 (1-12)\n    55\t  availableMonths: number[];       // 正常上市/适宜月份 (1-12)\n    56\t  regions: string[];               // 适用地区，如 [\"川渝\", \"全国\"]\n    57\t  \n    58\t  cookingTimeMinutes: number;      // 烹饪制作耗时 (分钟)\n    59\t  difficulty: 1 | 2 | 3;           // 难度: 1-快手菜, 2-日常家常, 3-功夫菜\n    60\t  estimatedCostLevel: 1 | 2 | 3;   // 预算等级: 1-平价经济, 2-家常适中, 3-偏高\n    61\t  \n    62\t  recommendedForTwo: boolean;      // 是否适宜两人份\n    63\t  tags: string[];                  // 特色标签: [\"当季推荐\", \"大厨拿手\", \"快手菜\"]\n    64\t  enabled: boolean;                // 是否启用\n    65\t\n    66\t  // V2.0 菜品缩略图与生活美学资产体系\n    67\t  thumbUrl?: string;               // 本地内置缩略图路径 (例如 /assets/dishes/dish_001.jpg)\n    68\t  imageUrl?: string;               // 远程高清大图 URL (可选)\n    69\t  dishEmoji?: string;              // 兜底可爱食材/分类微标 (如 🥩, 🥬, 🍲, 🍳)\n    70\t}\n","exit_code":0,"status":"completed"}}
