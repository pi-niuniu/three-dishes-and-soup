{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba miniprogram/services/menuRecommendation.ts | sed -n '329,432p'; rg --files miniprogram/pages/menu miniprogram/services -g '*Service.ts' -g '*.ts' -g '\"'!*.js'\"'\"","aggregated_output":"   329\t        return ['main_meat', 'vegetable', 'soup'];\n   330\t      case 'three_dishes':\n   331\t        return ['main_meat', 'secondary_meat', 'vegetable'];\n   332\t      case 'three_stir_fries':\n   333\t        return ['main_meat', 'secondary_meat', 'vegetable'];\n   334\t      default:\n   335\t        return ['main_meat', 'secondary_meat', 'vegetable', 'soup'];\n   336\t    }\n   337\t  }\n   338\t\n   339\t  public filterDishes(dishes: Dish[], preferences: UserPreferences): Dish[] {\n   340\t    return dishes.filter(dish => {\n   341\t      if (!dish.enabled) return false;\n   342\t      if (preferences.blockedDishIds?.includes(dish.id)) return false;\n   343\t      if (dish.spicyLevel > preferences.spicyLevel) return false;\n   344\t\n   345\t      if (preferences.dislikedIngredients?.length > 0) {\n   346\t        const containsDisliked = (dish.ingredients || []).some(ing =>\n   347\t          preferences.dislikedIngredients.some(disliked => {\n   348\t            if (disliked === '鱼/海鲜' || disliked === '海鲜' || disliked === '虾/海鲜') {\n   349\t              return ing.name.includes('虾') || ing.name.includes('鱼') || dish.mainIngredient?.includes('虾') || dish.mainIngredient?.includes('鱼');\n   350\t            }\n   351\t            if (disliked === '牛肉') {\n   352\t              return ing.name.includes('牛') || dish.mainIngredient?.includes('牛');\n   353\t            }\n   354\t            if (disliked === '鸡肉') {\n   355\t              return ing.name.includes('鸡') || dish.mainIngredient?.includes('鸡');\n   356\t            }\n   357\t            if (disliked === '内脏') {\n   358\t              return ing.name.includes('肠') || ing.name.includes('肝') || ing.name.includes('肚') || ing.name.includes('腰') || ing.name.includes('心');\n   359\t            }\n   360\t            return ing.name.includes(disliked) || disliked.includes(ing.name) || (dish.mainIngredient && dish.mainIngredient.includes(disliked));\n   361\t          })\n   362\t        );\n   363\t        if (containsDisliked) return false;\n   364\t      }\n   365\t\n   366\t      return true;\n   367\t    });\n   368\t  }\n   369\t\n   370\t  public scoreDish(\n   371\t    dish: Dish,\n   372\t    currentMonth: number,\n   373\t    preferences: UserPreferences,\n   374\t    history: MealHistoryRecord[],\n   375\t    mode?: MealMode,\n   376\t    relaxRate: number = 1.0\n   377\t  ): number {\n   378\t    const seasonScore = this.calculateSeasonScore(dish, currentMonth);\n   379\t    const prefScore = this.calculatePreferenceScore(dish, preferences);\n   380\t    \n   381\t    // 动态保底：如果历史记录已很满，对惩罚做平滑补偿\n   382\t    const rawPenalty = this.calculateHistoryPenalty(dish.id, history);\n   383\t    const historyPenalty = 1.0 - (1.0 - rawPenalty) * relaxRate;\n   384\t\n   385\t    const favoriteBoost = preferences.favoriteDishIds?.includes(dish.id) ? 1.2 : 1.0;\n   386\t    const difficultyScore = dish.difficulty === 1 ? 1.1 : (dish.difficulty === 2 ? 1.0 : 0.9);\n   387\t    const jitter = 0.95 + Math.random() * 0.1;\n   388\t\n   389\t    let stirFriesBoost = 1.0;\n   390\t    if (mode === 'three_stir_fries' && (dish.cookingMethod === 'stir_fry' || dish.cookingMethod === 'clear_fry')) {\n   391\t      stirFriesBoost = 1.3;\n   392\t    }\n   393\t\n   394\t    const baseScore =\n   395\t      (seasonScore * 0.30) +\n   396\t      (prefScore * 0.20) +\n   397\t      (historyPenalty * 0.25) +\n   398\t      (difficultyScore * 0.10) +\n   399\t      (dish.tags.includes('大厨拿手') ? 0.15 : 0.05);\n   400\t\n   401\t    return baseScore * favoriteBoost * stirFriesBoost * jitter;\n   402\t  }\n   403\t\n   404\t  public calculateSeasonScore(dish: Dish, currentMonth: number): number {\n   405\t    if (dish.bestMonths.includes(currentMonth)) return 1.0;\n   406\t    if (dish.availableMonths.includes(currentMonth)) return 0.7;\n   407\t    return 0.3;\n   408\t  }\n   409\t\n   410\t  public calculatePreferenceScore(dish: Dish, preferences: UserPreferences): number {\n   411\t    let score = 0.7;\n   412\t    if (dish.spicyLevel === preferences.spicyLevel) score += 0.2;\n   413\t    return Math.min(score, 1.0);\n   414\t  }\n   415\t\n   416\t  public calculateHistoryPenalty(dishId: string, history: MealHistoryRecord[]): number {\n   417\t    if (!history || history.length === 0) return 1.0;\n   418\t    const now = Date.now();\n   419\t    let minDaysAgo = 999;\n   420\t    for (const record of history) {\n   421\t      if (record.dishIds.includes(dishId)) {\n   422\t        const daysAgo = Math.floor((now - record.timestamp) / (1000 * 60 * 60 * 24));\n   423\t        if (daysAgo < minDaysAgo) {\n   424\t          minDaysAgo = daysAgo;\n   425\t        }\n   426\t      }\n   427\t    }\n   428\t    if (minDaysAgo <= 3) return 0.1;\n   429\t    if (minDaysAgo <= 7) return 0.4;\n   430\t    if (minDaysAgo <= 14) return 0.7;\n   431\t    return 1.0;\n   432\t  }\nminiprogram/services/dataProvider.ts\nminiprogram/services/menuRecommendation.ts\nminiprogram/services/shoppingListService.ts\nminiprogram/services/preferenceService.ts\nminiprogram/services/imageService.ts\nminiprogram/services/historyService.ts\nminiprogram/pages/menu/shopping/index.ts\nminiprogram/pages/menu/result/index.ts\n","exit_code":0,"status":"completed"}}
