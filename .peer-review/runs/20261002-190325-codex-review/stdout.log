{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '91,330p' docs/technical-design.md | nl -ba -v91\"","aggregated_output":"    91\t## 三、 TypeScript 核心类型定义 (Type Interfaces)\n    92\t\n    93\t### 3.1 菜品定义 (`types/dish.ts`)\n    94\t```typescript\n    95\t/** 菜品分类枚举 */\n    96\texport type DishCategory = \n    97\t  | 'main_meat'       // 主荤 (大肉/排骨/整鸡/大鱼等)\n    98\t  | 'secondary_meat'  // 副荤/小荤 (肉丝/肉沫/鸡丁等半荤半素)\n    99\t  | 'egg'             // 蛋类 (番茄炒蛋/蒸水蛋等)\n   100\t  | 'tofu'            // 豆制品 (家常豆腐/麻婆豆腐等)\n   101\t  | 'vegetable'       // 素菜 (绿叶蔬菜/瓜类/菌菇/根茎)\n   102\t  | 'soup';           // 汤类 (排骨汤/圆子汤/青菜钵等)\n   103\t\n   104\t/** 烹饪方式枚举 */\n   105\texport type CookingMethod = \n   106\t  | 'stir_fry'        // 炒 / 爆炒\n   107\t  | 'clear_fry'       // 清炒\n   108\t  | 'braise'          // 红烧 / 酱烧\n   109\t  | 'stew'            // 炖 / 煨\n   110\t  | 'steam'           // 蒸\n   111\t  | 'boil_soup';      // 煮汤 / 滚汤\n   112\t\n   113\t/** 菜品主料辅料结构 */\n   114\texport interface RecipeIngredient {\n   115\t  name: string;       // 食材标准化名称，如 \"猪里脊\"\n   116\t  amount: number;     // 2人份基准数值，如 200\n   117\t  unit: string;       // 计量单位，如 \"g\", \"个\", \"根\", \"适量\"\n   118\t  isMain: boolean;    // 是否为核心主要食材\n   119\t}\n   120\t\n   121\t/** 完整菜品结构 */\n   122\texport interface Dish {\n   123\t  id: string;                    // 唯一标识\n   124\t  name: string;                  // 菜名，如 \"青椒肉丝\"\n   125\t  category: DishCategory;        // 分类\n   126\t  cookingMethod: CookingMethod;  // 烹饪方式\n   127\t  taste: string[];               // 口味标签: [\"微辣\", \"下饭\", \"咸鲜\"]\n   128\t  spicyLevel: 0 | 1 | 2 | 3;     // 辣度: 0-不辣, 1-微辣, 2-中辣, 3-重辣\n   129\t  \n   130\t  ingredients: RecipeIngredient[];// 配方食材明细\n   131\t  mainIngredient: string;        // 核心主食材 (用于防重复计算，如 \"猪肉\")\n   132\t  \n   133\t  bestMonths: number[];          // 最佳月份 (1-12)\n   134\t  availableMonths: number[];     // 正常应季/常见月份 (1-12)\n   135\t  regions: string[];             // 适用地区: [\"川渝\", \"全国\"]\n   136\t  \n   137\t  cookingTimeMinutes: number;    // 制作耗时 (分钟)\n   138\t  difficulty: 1 | 2 | 3;         // 难度等级: 1-快手, 2-一般, 3-功夫菜\n   139\t  estimatedCostLevel: 1 | 2 | 3; // 预算成本等级: 1-经济, 2-适中, 3-较高\n   140\t  \n   141\t  recommendedForTwo: boolean;    // 是否适合 2 人分量 (V1 为 true)\n   142\t  tags: string[];                // 标签: [\"快手\", \"当季推荐\", \"大厨拿手\"]\n   143\t  enabled: boolean;              // 是否启用状态\n   144\t}\n   145\t```\n   146\t\n   147\t### 3.2 时令食材定义 (`types/ingredient.ts`)\n   148\t```typescript\n   149\texport interface SeasonalIngredient {\n   150\t  id: string;\n   151\t  name: string;                  // 食材名称，如 \"莲藕\"\n   152\t  category: 'leaf' | 'melon' | 'root' | 'fungus' | 'meat' | 'aquatic';\n   153\t  bestMonths: number[];          // 最佳品尝月，如 [9, 10, 11, 12]\n   154\t  availableMonths: number[];     // 常见月\n   155\t  regions: string[];             // [\"川渝\", \"全国\"]\n   156\t  seasonWeight: number;          // 时令推荐系数 (1.0 ~ 1.5)\n   157\t  description?: string;          // 时令说明 (如 \"秋季莲藕脆甜粉糯\")\n   158\t}\n   159\t```\n   160\t\n   161\t### 3.3 餐桌与菜单组合定义 (`types/menu.ts`)\n   162\t```typescript\n   163\t/** 餐桌模式 */\n   164\texport type MealMode = 'routine_2_1' | 'hearty_3_1'; // 2菜1汤 vs 3菜1汤\n   165\t\n   166\t/** 槽位菜品包装 (支持锁定机制) */\n   167\texport interface TableSlot {\n   168\t  slotIndex: number;             // 槽位序号 (0, 1, 2, 3)\n   169\t  slotRole: 'main_meat' | 'sub_meat_or_tofu' | 'vegetable' | 'soup';\n   170\t  dish: Dish;                    // 对应菜品\n   171\t  isLocked: boolean;             // 是否被锁定\n   172\t}\n   173\t\n   174\t/** 完整生成的餐桌菜单 */\n   175\texport interface TableMenu {\n   176\t  id: string;\n   177\t  mode: MealMode;\n   178\t  date: string;                  // \"YYYY-MM-DD\"\n   179\t  month: number;\n   180\t  slots: TableSlot[];            // 菜品槽位列表\n   181\t  totalTimeMinutes: number;      // 预估烹饪时间\n   182\t  createdAt: number;\n   183\t}\n   184\t```\n   185\t\n   186\t---\n   187\t\n   188\t## 四、 数据库 Schema 设计 (CloudBase Collections)\n   189\t\n   190\t### 4.1 集合清单\n   191\t1. **`dishes`**：菜品库（云端权威数据源，只读/管理员可写）。\n   192\t2. **`ingredients`**：时令食材字典库。\n   193\t3. **`users`**：用户基本信息（微信 OpenID、昵称、注册时间）。\n   194\t4. **`preferences`**：用户口味、辣度、忌口与默认设置。\n   195\t5. **`meal_history`**：用户正式确认开饭的就餐历史。\n   196\t6. **`favorites`**：用户收藏菜品。\n   197\t\n   198\t### 4.2 核心集合字段规格\n   199\t\n   200\t#### `preferences` 集合\n   201\t```json\n   202\t{\n   203\t  \"_id\": \"pref_openid_xxxx\",\n   204\t  \"_openid\": \"wx_openid_12345\",\n   205\t  \"peopleCount\": 2,\n   206\t  \"defaultMealMode\": \"hearty_3_1\",\n   207\t  \"spicyLevel\": 1,\n   208\t  \"dislikedIngredients\": [\"香菜\", \"羊肉\", \"苦瓜\", \"内脏\"],\n   209\t  \"favoriteCategories\": [\"main_meat\", \"vegetable\"],\n   210\t  \"blockedDishIds\": [\"dish_089\"],\n   211\t  \"region\": \"川渝\",\n   212\t  \"updatedAt\": 1727236800000\n   213\t}\n   214\t```\n   215\t\n   216\t#### `meal_history` 集合\n   217\t```json\n   218\t{\n   219\t  \"_id\": \"hist_20260925_xxxx\",\n   220\t  \"_openid\": \"wx_openid_12345\",\n   221\t  \"date\": \"2026-09-25\",\n   222\t  \"dishIds\": [\"dish_001\", \"dish_015\", \"dish_042\", \"dish_078\"],\n   223\t  \"mealMode\": \"hearty_3_1\",\n   224\t  \"createdAt\": 1727236800000\n   225\t}\n   226\t```\n   227\t\n   228\t---\n   229\t\n   230\t## 五、 推荐算法引擎架构设计 (`menuRecommendation.ts`)\n   231\t\n   232\t```\n   233\t                  ┌──────────────────────┐\n   234\t                  │ 菜品全库 (200道家常菜) │\n   235\t                  └──────────┬───────────┘\n   236\t                             │\n   237\t                             ▼\n   238\t         [ 阶段一：硬过滤管道 (Hard Filter Pipeline) ]\n   239\t         • 排除启用状态为 false 的菜品\n   240\t         • 排除用户黑名单 / 永不推荐菜 (blockedDishes)\n   241\t         • 排除用户忌口食材 (dislikedIngredients)\n   242\t         • 排除辣度超标菜 (spicyLevel > userMaxSpicy)\n   243\t         • 仅保留适合 2 人份菜品 (recommendedForTwo == true)\n   244\t                             │\n   245\t                             ▼\n   246\t         [ 阶段二：多维权重评分器 (Multi-Factor Scoring) ]\n   247\t         • 时令得分 (Season Score): 最佳月 1.0 / 常见月 0.7 / 反季 0.3 (占比 30%)\n   248\t         • 用户偏好 (Preference Score): 口味标签契合度 (占比 20%)\n   249\t         • 历史去重 (History Recency Penalty): \n   250\t           - 3天内吃过: 系数 0.1 (严重降权)\n   251\t           - 7天内吃过: 系数 0.4 (明显降权)\n   252\t           - 14天内吃过: 系数 0.7 (轻度降权)\n   253\t           - >14天: 系数 1.0 (正常) (占比 20%)\n   254\t         • 收藏加权 (Favorite Boost): +5%\n   255\t         • 制作难度与耗时平滑 (Difficulty & Time): 适中加权 (占比 10%)\n   256\t                             │\n   257\t                             ▼\n   258\t         [ 阶段三：餐桌结构组合求解器 (Combination Solver) ]\n   259\t         • 槽位分配：\n   260\t           - 2菜1汤：[主荤/副荤] + [素菜/蛋/豆腐] + [汤]\n   261\t           - 3菜1汤：[主荤] + [副荤/蛋/豆腐] + [素菜] + [汤]\n   262\t         • 锁定保护：已锁定槽位原样保留\n   263\t         • 主食材防重检查：同一主要食材 (如\"猪肉\") 全桌不得超过 2 次；主素菜主料不得重复\n   264\t         • 烹饪方式均衡：避免全桌皆红烧或全桌皆油炸，保证清炒+炖/烧+汤的和谐搭配\n   265\t                             │\n   266\t                             ▼\n   267\t                  ┌──────────────────────┐\n   268\t                  │ 完美今日菜单 TableMenu│\n   269\t                  └──────────────────────┘\n   270\t```\n   271\t\n   272\t### 5.1 时令匹配分计算公式\n   273\t```typescript\n   274\tfunction calculateSeasonScore(dish: Dish, currentMonth: number): number {\n   275\t  if (dish.bestMonths.includes(currentMonth)) {\n   276\t    return 1.0; // 当季黄金时期\n   277\t  }\n   278\t  if (dish.availableMonths.includes(currentMonth)) {\n   279\t    return 0.7; // 正常上市供应期\n   280\t  }\n   281\t  return 0.3;   // 反季/非旺季 (降权但不彻底禁止，保证候选池充盈)\n   282\t}\n   283\t```\n   284\t\n   285\t### 5.2 历史降权衰减系数公式\n   286\t```typescript\n   287\tfunction calculateHistoryPenalty(dishId: string, historyRecords: MealRecord[]): number {\n   288\t  const daysDiff = getDaysSinceLastEaten(dishId, historyRecords);\n   289\t  if (daysDiff === -1 || daysDiff > 14) return 1.0;  // 14天外或从未吃过，无惩罚\n   290\t  if (daysDiff <= 3) return 0.1;                     // 3天内吃过，90% 降权\n   291\t  if (daysDiff <= 7) return 0.4;                     // 7天内吃过，60% 降权\n   292\t  return 0.7;                                        // 8-14天内吃过，30% 降权\n   293\t}\n   294\t```\n   295\t\n   296\t### 5.3 综合得分计算\n   297\t$$\\text{TotalScore} = (S_{\\text{season}} \\times 0.30) + (S_{\\text{pref}} \\times 0.20) + (P_{\\text{history}} \\times 0.20) + (S_{\\text{match}} \\times 0.15) + (S_{\\text{fav}} \\times 0.05) + (S_{\\text{cost}} \\times 0.05) + (S_{\\text{diff}} \\times 0.05)$$\n   298\t\n   299\t---\n   300\t\n   301\t## 六、 采购清单合并服务设计 (`shoppingListService.ts`)\n   302\t\n   303\t```typescript\n   304\texport interface MergedIngredientItem {\n   305\t  name: string;        // 食材标准名，如 \"猪肉\"\n   306\t  displayAmount: string;// 展示文案，如 \"约 350g\" 或 \"2 个\"\n   307\t  subNotes: string[];  // 来源菜品标注，如 [\"青椒肉丝 200g\", \"芹菜肉丝 150g\"]\n   308\t}\n   309\t\n   310\texport function aggregateShoppingList(dishes: Dish[]): MergedIngredientItem[] {\n   311\t  // 1. 扁平化所有菜品的配料列表\n   312\t  // 2. 根据食材别名与标准化字典归一 (如 \"猪里脊\" 与 \"后腿肉\" 均归到 \"猪肉\")\n   313\t  // 3. 数值相加并格式化输出\n   314\t  // 4. 生成适合微信粘贴的纯文本格式\n   315\t}\n   316\t```\n   317\t\n   318\t---\n   319\t\n   320\t## 七、 界面 UI 与视觉规范\n   321\t\n   322\t- **基调**：简单、温暖、生活化、烟火气、干净舒服。\n   323\t- **色彩体系**：\n   324\t  - 主背景色：`#FAF8F5` (温润米白，护眼舒适)\n   325\t  - 卡片底色：`#FFFFFF` (纯白圆角轻投影)\n   326\t  - 核心主色：`#4A7C59` (青翠浅绿，代表新鲜时蔬与健康)\n   327\t  - 暖调强调色：`#E88D38` (落日暖橙，用于点菜按钮与高亮行动点)\n   328\t  - 辅助浅黄：`#F7E7CE` (用于节气与当季标签底色)\n   329\t  - 主字色：`#2D312E` (深黛墨色，非生硬纯黑，阅读柔和)\n   330\t- **字体与排版**：圆角卡片（`border-radius: 16rpx`），大触控热区（按钮高度 $\\ge 88\\text{rpx}$），拒绝拥挤与过度渐变。\n","exit_code":0,"status":"completed"}}
