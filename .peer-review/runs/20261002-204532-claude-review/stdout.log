{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011rbEskE46JdLuw8C8X1k1s","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\t\n9\t// 预设分类生活美学图标与默认大图映射\n10\tconst CATEGORY_DEFAULT_CONFIG = {\n11\t  main_meat: { icon: '🥩', theme: 'theme_main_meat', thumb: '/assets/dishes/default_main.jpg' },\n12\t  secondary_meat: { icon: '🥘', theme: 'theme_secondary_meat', thumb: '/assets/dishes/default_secondary.jpg' },\n13\t  egg: { icon: '🍳', theme: 'theme_egg', thumb: '/assets/dishes/default_egg.jpg' },\n14\t  tofu: { icon: '🧊', theme: 'theme_tofu', thumb: '/assets/dishes/default_tofu.jpg' },\n15\t  vegetable: { icon: '🥬', theme: 'theme_vegetable', thumb: '/assets/dishes/default_vegetable.jpg' },\n16\t  soup: { icon: '🍲', theme: 'theme_soup', thumb: '/assets/dishes/default_soup.jpg' },\n17\t  staple_sauce: { icon: '🍚', theme: 'theme_staple_sauce', thumb: '/assets/dishes/default_dish.jpg' },\n18\t  default: { icon: '🍽️', theme: 'theme_default', thumb: '/assets/dishes/default_dish.jpg' }\n19\t};\n20\t\n21\t// 根据菜名特征智能匹配生动 Emoji\n22\tfunction matchEmoji(name, category) {\n23\t  if (!name) return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n24\t  if (name.includes('土豆')) return '🥔';\n25\t  if (name.includes('番茄') || name.includes('西红柿')) return '🍅';\n26\t  if (name.includes('虾')) return '🦐';\n27\t  if (name.includes('鱼')) return '🐟';\n28\t  if (name.includes('鸡') || name.includes('鸭')) return '🍗';\n29\t  if (name.includes('牛') || name.includes('羊') || name.includes('排骨') || name.includes('肉')) return '🥩';\n30\t  if (name.includes('蛋')) return '🍳';\n31\t  if (name.includes('豆腐')) return '🧊';\n32\t  if (name.includes('蘑菇') || name.includes('菌') || name.includes('菇')) return '🍄';\n33\t  if (name.includes('茄子')) return '🍆';\n34\t  if (name.includes('玉米')) return '🌽';\n35\t  if (name.includes('面') || name.includes('粉')) return '🍜';\n36\t  if (name.includes('饭')) return '🍚';\n37\t  if (name.includes('饺') || name.includes('抄手')) return '🥟';\n38\t  if (name.includes('汤')) return '🍲';\n39\t  if (name.includes('菜') || name.includes('笋') || name.includes('瓜')) return '🥬';\n40\t  return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n41\t}\n42\t\n43\texports.main = async (event, context) => {\n44\t  const wxContext = cloud.getWXContext();\n45\t  const openid = wxContext.OPENID || event.mockOpenid || 'mock_openid_default';\n46\t  const { action = 'addDish' } = event;\n47\t  const now = Date.now();\n48\t\n49\t  try {\n50\t    switch (action) {\n51\t      /**\n52\t       * 1. 录入纯文字私房菜 (强制文本安全检查，禁止图片上传)\n53\t       */\n54\t      case 'addDish': {\n55\t        const name = String(event.name || '').trim();\n56\t        if (!name) {\n57\t          return { success: false, error: '菜品名称不能为空' };\n58\t        }\n59\t        if (name.length > 20) {\n60\t          return { success: false, error: '菜品名称不能超过20个字' };\n61\t        }\n62\t\n63\t        // 本地/弱网兜底敏感词检测 (易错点 7 防线)\n64\t        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄'];\n65\t        if (sensitiveWords.some(w => name.includes(w))) {\n66\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n67\t        }\n68\t\n69\t        const category = event.category || 'secondary_meat';\n70\t        const taste = Array.isArray(event.taste) ? event.taste : (event.taste ? [event.taste] : ['家常']);\n71\t        const cookingTimeMinutes = Number(event.cookingTimeMinutes) || 25;\n72\t        const ingredients = Array.isArray(event.ingredients) ? event.ingredients : [];\n73\t\n74\t        // 严格微信官方文本合规检测 msgSecCheck\n75\t        const checkContent = `${name} ${taste.join(' ')} ${ingredients.join(' ')}`;\n76\t        try {\n77\t          if (cloud.openapi && cloud.openapi.security && cloud.openapi.security.msgSecCheck) {\n78\t            const secRes = await cloud.openapi.security.msgSecCheck({\n79\t              content: checkContent\n80\t            });\n81\t            if (secRes && secRes.errCode && secRes.errCode !== 0) {\n82\t              return { success: false, error: '菜品名称或描述包含敏感内容，请修改后重试' };\n83\t            }\n84\t          }\n85\t        } catch (secErr) {\n86\t          // 如果命中违规拦截\n87\t          if (secErr.errCode === 87014) {\n88\t            return { success: false, error: '菜品名称包含敏感内容，请修改' };\n89\t          }\n90\t          console.warn('微信 msgSecCheck 检查跳过或异常 (本地测试环境忽略):', secErr.message);\n91\t        }\n92\t\n93\t        const familyId = event.familyId || 'personal';\n94\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n95\t        const cfg = CATEGORY_DEFAULT_CONFIG[category] || CATEGORY_DEFAULT_CONFIG.default;\n96\t        const emoji = matchEmoji(name, category);\n97\t\n98\t        const newDish = {\n99\t          _id: dishId,\n100\t          id: dishId,\n101\t          familyId,\n102\t          creatorOpenid: openid,\n103\t          creatorName: event.creatorName || event.nickName || '家人',\n104\t          name,\n105\t          category,\n106\t          taste,\n107\t          cookingTimeMinutes,\n108\t          defaultIcon: emoji,\n109\t          defaultTheme: cfg.theme,\n110\t          thumbUrl: cfg.thumb,\n111\t          ingredients, // 空食材保留空数组，严禁无中生有\n112\t          enabled: true,\n113\t          isCustom: true,\n114\t          createdAt: now\n115\t        };\n116\t\n117\t        await db.collection('custom_dishes').add({ data: newDish });\n118\t\n119\t        return {\n120\t          success: true,\n121\t          dish: newDish\n122\t        };\n123\t      }\n124\t\n125\t      /**\n126\t       * 2. 查询家庭私房菜列表\n127\t       */\n128\t      case 'getDishes': {\n129\t        const { familyId } = event;\n130\t        if (!familyId) {\n131\t          return { success: false, error: '缺少 familyId' };\n132\t        }\n133\t\n134\t        const res = await db.collection('custom_dishes')\n135\t          .where({\n136\t            familyId,\n137\t            enabled: true\n138\t          })\n139\t          .orderBy('createdAt', 'desc')\n140\t          .get();\n141\t\n142\t        return {\n143\t          success: true,\n144\t          dishes: res.data || []\n145\t        };\n146\t      }\n147\t\n148\t      default:\n149\t        return { success: false, error: `不支持的操作类型: ${action}` };\n150\t    }\n151\t  } catch (err) {\n152\t    return {\n153\t      success: false,\n154\t      error: err.message || '自选私房菜操作失败'\n155\t    };\n156\t  }\n157\t};\n158\t"}]},"parent_tool_use_id":null,"session_id":"dcb23375-9639-4e07-812d-47e9f86cdae9","uuid":"2817570e-cf89-43eb-b719-13ecf4079a25","timestamp":"2026-10-02T12:45:47.065Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/customDish/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\n// 预设分类生活美学图标与默认大图映射\nconst CATEGORY_DEFAULT_CONFIG = {\n  main_meat: { icon: '🥩', theme: 'theme_main_meat', thumb: '/assets/dishes/default_main.jpg' },\n  secondary_meat: { icon: '🥘', theme: 'theme_secondary_meat', thumb: '/assets/dishes/default_secondary.jpg' },\n  egg: { icon: '🍳', theme: 'theme_egg', thumb: '/assets/dishes/default_egg.jpg' },\n  tofu: { icon: '🧊', theme: 'theme_tofu', thumb: '/assets/dishes/default_tofu.jpg' },\n  vegetable: { icon: '🥬', theme: 'theme_vegetable', thumb: '/assets/dishes/default_vegetable.jpg' },\n  soup: { icon: '🍲', theme: 'theme_soup', thumb: '/assets/dishes/default_soup.jpg' },\n  staple_sauce: { icon: '🍚', theme: 'theme_staple_sauce', thumb: '/assets/dishes/default_dish.jpg' },\n  default: { icon: '🍽️', theme: 'theme_default', thumb: '/assets/dishes/default_dish.jpg' }\n};\n\n// 根据菜名特征智能匹配生动 Emoji\nfunction matchEmoji(name, category) {\n  if (!name) return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n  if (name.includes('土豆')) return '🥔';\n  if (name.includes('番茄') || name.includes('西红柿')) return '🍅';\n  if (name.includes('虾')) return '🦐';\n  if (name.includes('鱼')) return '🐟';\n  if (name.includes('鸡') || name.includes('鸭')) return '🍗';\n  if (name.includes('牛') || name.includes('羊') || name.includes('排骨') || name.includes('肉')) return '🥩';\n  if (name.includes('蛋')) return '🍳';\n  if (name.includes('豆腐')) return '🧊';\n  if (name.includes('蘑菇') || name.includes('菌') || name.includes('菇')) return '🍄';\n  if (name.includes('茄子')) return '🍆';\n  if (name.includes('玉米')) return '🌽';\n  if (name.includes('面') || name.includes('粉')) return '🍜';\n  if (name.includes('饭')) return '🍚';\n  if (name.includes('饺') || name.includes('抄手')) return '🥟';\n  if (name.includes('汤')) return '🍲';\n  if (name.includes('菜') || name.includes('笋') || name.includes('瓜')) return '🥬';\n  return CATEGORY_DEFAULT_CONFIG[category]?.icon || '🍽️';\n}\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  const openid = wxContext.OPENID || event.mockOpenid || 'mock_openid_default';\n  const { action = 'addDish' } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 录入纯文字私房菜 (强制文本安全检查，禁止图片上传)\n       */\n      case 'addDish': {\n        const name = String(event.name || '').trim();\n        if (!name) {\n          return { success: false, error: '菜品名称不能为空' };\n        }\n        if (name.length > 20) {\n          return { success: false, error: '菜品名称不能超过20个字' };\n        }\n\n        // 本地/弱网兜底敏感词检测 (易错点 7 防线)\n        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄'];\n        if (sensitiveWords.some(w => name.includes(w))) {\n          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n        }\n\n        const category = event.category || 'secondary_meat';\n        const taste = Array.isArray(event.taste) ? event.taste : (event.taste ? [event.taste] : ['家常']);\n        const cookingTimeMinutes = Number(event.cookingTimeMinutes) || 25;\n        const ingredients = Array.isArray(event.ingredients) ? event.ingredients : [];\n\n        // 严格微信官方文本合规检测 msgSecCheck\n        const checkContent = `${name} ${taste.join(' ')} ${ingredients.join(' ')}`;\n        try {\n          if (cloud.openapi && cloud.openapi.security && cloud.openapi.security.msgSecCheck) {\n            const secRes = await cloud.openapi.security.msgSecCheck({\n              content: checkContent\n            });\n            if (secRes && secRes.errCode && secRes.errCode !== 0) {\n              return { success: false, error: '菜品名称或描述包含敏感内容，请修改后重试' };\n            }\n          }\n        } catch (secErr) {\n          // 如果命中违规拦截\n          if (secErr.errCode === 87014) {\n            return { success: false, error: '菜品名称包含敏感内容，请修改' };\n          }\n          console.warn('微信 msgSecCheck 检查跳过或异常 (本地测试环境忽略):', secErr.message);\n        }\n\n        const familyId = event.familyId || 'personal';\n        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const cfg = CATEGORY_DEFAULT_CONFIG[category] || CATEGORY_DEFAULT_CONFIG.default;\n        const emoji = matchEmoji(name, category);\n\n        const newDish = {\n          _id: dishId,\n          id: dishId,\n          familyId,\n          creatorOpenid: openid,\n          creatorName: event.creatorName || event.nickName || '家人',\n          name,\n          category,\n          taste,\n          cookingTimeMinutes,\n          defaultIcon: emoji,\n          defaultTheme: cfg.theme,\n          thumbUrl: cfg.thumb,\n          ingredients, // 空食材保留空数组，严禁无中生有\n          enabled: true,\n          isCustom: true,\n          createdAt: now\n        };\n\n        await db.collection('custom_dishes').add({ data: newDish });\n\n        return {\n          success: true,\n          dish: newDish\n        };\n      }\n\n      /**\n       * 2. 查询家庭私房菜列表\n       */\n      case 'getDishes': {\n        const { familyId } = event;\n        if (!familyId) {\n          return { success: false, error: '缺少 familyId' };\n        }\n\n        const res = await db.collection('custom_dishes')\n          .where({\n            familyId,\n            enabled: true\n          })\n          .orderBy('createdAt', 'desc')\n          .get();\n\n        return {\n          success: true,\n          dishes: res.data || []\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '自选私房菜操作失败'\n    };\n  }\n};\n","numLines":158,"startLine":1,"totalLines":158}}}
