{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EgoDgCD447fq4jRy2KWAHf","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\t\n9\t/**\n10\t * userAuth 云函数：用户静默鉴权与档案获取\n11\t */\n12\texports.main = async (event, context) => {\n13\t  const wxContext = cloud.getWXContext();\n14\t  const openid = wxContext.OPENID || event.mockOpenid || 'mock_openid_default';\n15\t  const now = Date.now();\n16\t\n17\t  try {\n18\t    const userDocRef = db.collection('users').doc(`user_${openid}`);\n19\t    let user = null;\n20\t\n21\t    try {\n22\t      const res = await userDocRef.get();\n23\t      user = res.data;\n24\t    } catch (e) {\n25\t      // 用户首次访问，自动创建档案\n26\t      const newUser = {\n27\t        _id: `user_${openid}`,\n28\t        _openid: openid,\n29\t        nickName: event.nickName || '家人',\n30\t        avatarUrl: event.avatarUrl || '',\n31\t        familyId: null,\n32\t        role: null,\n33\t        createdAt: now,\n34\t        updatedAt: now\n35\t      };\n36\t      await db.collection('users').add({ data: newUser });\n37\t      user = newUser;\n38\t    }\n39\t\n40\t    // 更新昵称/头像\n41\t    if (event.nickName || event.avatarUrl) {\n42\t      const updateData = { updatedAt: now };\n43\t      if (event.nickName) updateData.nickName = event.nickName;\n44\t      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n45\t      await userDocRef.update({ data: updateData });\n46\t      user = { ...user, ...updateData };\n47\t    }\n48\t\n49\t    // 若绑定了家庭，获取家庭最新信息\n50\t    let family = null;\n51\t    if (user.familyId) {\n52\t      try {\n53\t        const famRes = await db.collection('families').doc(user.familyId).get();\n54\t        family = famRes.data;\n55\t      } catch (err) {\n56\t        console.warn('获取用户所属家庭失败或家庭已解散', err);\n57\t        // 如果家庭已被解散，重置用户的 familyId\n58\t        await userDocRef.update({\n59\t          data: { familyId: null, role: null, updatedAt: now }\n60\t        });\n61\t        user.familyId = null;\n62\t        user.role = null;\n63\t      }\n64\t    }\n65\t\n66\t    return {\n67\t      success: true,\n68\t      openid,\n69\t      user,\n70\t      family\n71\t    };\n72\t  } catch (err) {\n73\t    return {\n74\t      success: false,\n75\t      error: err.message || '用户鉴权失败'\n76\t    };\n77\t  }\n78\t};\n79\t"}]},"parent_tool_use_id":null,"session_id":"dcb23375-9639-4e07-812d-47e9f86cdae9","uuid":"c7f61ba5-c040-4a36-83ab-77cbe8490c88","timestamp":"2026-10-02T12:45:47.202Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/userAuth/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\n/**\n * userAuth 云函数：用户静默鉴权与档案获取\n */\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  const openid = wxContext.OPENID || event.mockOpenid || 'mock_openid_default';\n  const now = Date.now();\n\n  try {\n    const userDocRef = db.collection('users').doc(`user_${openid}`);\n    let user = null;\n\n    try {\n      const res = await userDocRef.get();\n      user = res.data;\n    } catch (e) {\n      // 用户首次访问，自动创建档案\n      const newUser = {\n        _id: `user_${openid}`,\n        _openid: openid,\n        nickName: event.nickName || '家人',\n        avatarUrl: event.avatarUrl || '',\n        familyId: null,\n        role: null,\n        createdAt: now,\n        updatedAt: now\n      };\n      await db.collection('users').add({ data: newUser });\n      user = newUser;\n    }\n\n    // 更新昵称/头像\n    if (event.nickName || event.avatarUrl) {\n      const updateData = { updatedAt: now };\n      if (event.nickName) updateData.nickName = event.nickName;\n      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n      await userDocRef.update({ data: updateData });\n      user = { ...user, ...updateData };\n    }\n\n    // 若绑定了家庭，获取家庭最新信息\n    let family = null;\n    if (user.familyId) {\n      try {\n        const famRes = await db.collection('families').doc(user.familyId).get();\n        family = famRes.data;\n      } catch (err) {\n        console.warn('获取用户所属家庭失败或家庭已解散', err);\n        // 如果家庭已被解散，重置用户的 familyId\n        await userDocRef.update({\n          data: { familyId: null, role: null, updatedAt: now }\n        });\n        user.familyId = null;\n        user.role = null;\n      }\n    }\n\n    return {\n      success: true,\n      openid,\n      user,\n      family\n    };\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '用户鉴权失败'\n    };\n  }\n};\n","numLines":79,"startLine":1,"totalLines":79}}}
