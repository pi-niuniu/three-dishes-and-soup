{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ChWsfmiVJWNAo7kBTgKqZL","type":"tool_result","content":"1\timport type { MealHistoryRecord, MealMode } from '../types/user.js';\n2\timport type { Dish } from '../types/dish.js';\n3\timport { familyService } from './familyService.js';\n4\timport { cloudService } from './cloudService.js';\n5\t\n6\tconst STORAGE_KEY = 'meal_history_records';\n7\tconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n8\t\n9\tinterface PendingSyncItem {\n10\t  targetFamilyId: string;\n11\t  authorOpenid: string;\n12\t  record: MealHistoryRecord;\n13\t}\n14\t\n15\ttype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n16\t\n17\tclass HistoryService {\n18\t  private memoryHistory: MealHistoryRecord[] = [];\n19\t  private pendingQueue: PendingSyncItem[] = [];\n20\t  private listeners: Set<HistoryChangeListener> = new Set();\n21\t  private isSyncing = false;\n22\t\n23\t  constructor() {\n24\t    this.restoreFromStorage();\n25\t  }\n26\t\n27\t  private restoreFromStorage() {\n28\t    try {\n29\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n30\t        const stored = wx.getStorageSync(STORAGE_KEY);\n31\t        if (stored && Array.isArray(stored)) {\n32\t          this.memoryHistory = stored;\n33\t        }\n34\t        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n35\t        if (queued && Array.isArray(queued)) {\n36\t          this.pendingQueue = queued;\n37\t        }\n38\t      }\n39\t    } catch (e) {\n40\t      console.warn('读取本地历史失败，使用内存降级', e);\n41\t    }\n42\t  }\n43\t\n44\t  /**\n45\t   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n46\t   */\n47\t  public subscribe(listener: HistoryChangeListener): () => void {\n48\t    this.listeners.add(listener);\n49\t    return () => this.listeners.delete(listener);\n50\t  }\n51\t\n52\t  private notifyListeners(): void {\n53\t    const list = this.getHistory();\n54\t    for (const listener of this.listeners) {\n55\t      try {\n56\t        listener(list);\n57\t      } catch (err) {\n58\t        console.error('历史状态订阅回调异常', err);\n59\t      }\n60\t    }\n61\t  }\n62\t\n63\t  /**\n64\t   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n65\t   */\n66\t  public getHistory(): MealHistoryRecord[] {\n67\t    try {\n68\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n69\t        const stored = wx.getStorageSync(STORAGE_KEY);\n70\t        if (stored && Array.isArray(stored)) {\n71\t          return stored;\n72\t        }\n73\t      }\n74\t    } catch (e) {\n75\t      console.warn('读取本地历史失败，使用内存降级', e);\n76\t    }\n77\t    return this.memoryHistory;\n78\t  }\n79\t\n80\t  /**\n81\t   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n82\t   */\n83\t  public deduceMealType(dateObj = new Date()): string {\n84\t    const hour = dateObj.getHours();\n85\t    if (hour >= 5 && hour < 10) return '早餐';\n86\t    if (hour >= 10 && hour < 15) return '午餐';\n87\t    if (hour >= 15 && hour < 21) return '晚餐';\n88\t    return '加餐';\n89\t  }\n90\t\n91\t  /**\n92\t   * 确认开饭：将菜单正式写入就餐历史\n93\t   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n94\t   */\n95\t  public recordMeal(\n96\t    mode: MealMode,\n97\t    dishes: Dish[],\n98\t    dateStr?: string,\n99\t    menuId?: string,\n100\t    mealType?: string\n101\t  ): MealHistoryRecord {\n102\t    const history = this.getHistory();\n103\t    const now = new Date();\n104\t    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n105\t    const targetDate = dateStr || localDate;\n106\t    const resolvedMealType = mealType || this.deduceMealType(now);\n107\t    const randSuffix = Math.random().toString(36).slice(2, 6);\n108\t    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n109\t\n110\t    const currentUser = familyService.getCurrentUser();\n111\t    const currentFamily = familyService.getCurrentFamily();\n112\t    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n113\t\n114\t    const newRecord: MealHistoryRecord = {\n115\t      id: mealId,\n116\t      menuId,\n117\t      mealId,\n118\t      date: targetDate,\n119\t      timestamp: now.getTime(),\n120\t      mode,\n121\t      mealType: resolvedMealType,\n122\t      dishIds: dishes.map(d => d.id),\n123\t      dishNames: dishes.map(d => d.name),\n124\t      dishes: dishes.map(d => ({\n125\t        id: d.id,\n126\t        name: d.name,\n127\t        category: d.category,\n128\t        thumbUrl: d.thumbUrl,\n129\t        dishEmoji: d.dishEmoji,\n130\t        isCustom: (d as any).isCustom\n131\t      })),\n132\t      confirmedBy: currentUser.openid,\n133\t      confirmedByName: currentUser.nickName || '家人',\n134\t      familyId,\n135\t      syncStatus: familyId ? 'pending' : 'synced'\n136\t    };\n137\t\n138\t    // 智能去重判断：\n139\t    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n140\t    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n141\t    const existingIndex = history.findIndex(r =>\n142\t      r.id === mealId ||\n143\t      (Boolean(menuId) && r.menuId === menuId) ||\n144\t      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n145\t    );\n146\t\n147\t    let updated: MealHistoryRecord[];\n148\t    if (existingIndex >= 0) {\n149\t      updated = [...history];\n150\t      updated[existingIndex] = newRecord;\n151\t    } else {\n152\t      updated = [newRecord, ...history].slice(0, 60);\n153\t    }\n154\t\n155\t    this.saveHistory(updated);\n156\t\n157\t    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n158\t    if (familyId) {\n159\t      this.enqueuePendingSync({\n160\t        targetFamilyId: familyId,\n161\t        authorOpenid: currentUser.openid,\n162\t        record: newRecord\n163\t      });\n164\t      // 触发后台静默同步\n165\t      this.flushPendingQueue().catch(() => {});\n166\t    }\n167\t\n168\t    return newRecord;\n169\t  }\n170\t\n171\t  /**\n172\t   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n173\t   */\n174\t  private enqueuePendingSync(item: PendingSyncItem) {\n175\t    this.pendingQueue.push(item);\n176\t    this.savePendingQueue();\n177\t  }\n178\t\n179\t  private savePendingQueue() {\n180\t    try {\n181\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n182\t        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n183\t      }\n184\t    } catch (e) {}\n185\t  }\n186\t\n187\t  /**\n188\t   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n189\t   */\n190\t  public async flushPendingQueue(): Promise<void> {\n191\t    if (this.isSyncing || this.pendingQueue.length === 0) return;\n192\t    this.isSyncing = true;\n193\t\n194\t    try {\n195\t      const currentFamily = familyService.getCurrentFamily();\n196\t      const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n197\t\n198\t      const remainingQueue: PendingSyncItem[] = [];\n199\t\n200\t      for (const item of this.pendingQueue) {\n201\t        // 关键防御：如果当前家庭与离线时所属家庭不一致，判定为废弃记录，安全丢弃，绝不上报！\n202\t        if (!currentFamilyId || currentFamilyId !== item.targetFamilyId) {\n203\t          console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n204\t          continue;\n205\t        }\n206\t\n207\t        const res = await cloudService.callFunction('upsertMeal', {\n208\t          action: 'upsertMeal',\n209\t          familyId: item.targetFamilyId,\n210\t          date: item.record.date,\n211\t          meal: {\n212\t            mealId: item.record.mealId || item.record.id,\n213\t            mealType: item.record.mealType,\n214\t            mode: item.record.mode,\n215\t            dishes: item.record.dishes,\n216\t            dishIds: item.record.dishIds,\n217\t            dishNames: item.record.dishNames,\n218\t            confirmedByName: item.record.confirmedByName,\n219\t            timestamp: item.record.timestamp\n220\t          }\n221\t        });\n222\t\n223\t        if (res.success) {\n224\t          // 标记本地记录为已同步\n225\t          const history = this.getHistory();\n226\t          const target = history.find(r => r.id === item.record.id);\n227\t          if (target) {\n228\t            target.syncStatus = 'synced';\n229\t            this.saveHistory([...history]);\n230\t            this.notifyListeners();\n231\t          }\n232\t        } else {\n233\t          // 提交失败，保留在队列中等待下次重试\n234\t          remainingQueue.push(item);\n235\t        }\n236\t      }\n237\t\n238\t      this.pendingQueue = remainingQueue;\n239\t      this.savePendingQueue();\n240\t    } finally {\n241\t      this.isSyncing = false;\n242\t    }\n243\t  }\n244\t\n245\t  /**\n246\t   * SWR 增量拉取家庭共享历史并合并到本地\n247\t   */\n248\t  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n249\t    const currentFamily = familyService.getCurrentFamily();\n250\t    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n251\t    if (!familyId) {\n252\t      return this.getHistory();\n253\t    }\n254\t\n255\t    // 先刷新离线待上报队列\n256\t    await this.flushPendingQueue();\n257\t\n258\t    const res = await cloudService.callFunction('upsertMeal', {\n259\t      action: 'getHistory',\n260\t      familyId,\n261\t      limitDays: 60\n262\t    });\n263\t\n264\t    if (res.success && Array.isArray(res.records)) {\n265\t      const cloudRecords: MealHistoryRecord[] = res.records;\n266\t      const localRecords = this.getHistory();\n267\t\n268\t      // 双向合并：以餐次 mealId 为唯一标识\n269\t      const recordMap = new Map<string, MealHistoryRecord>();\n270\t\n271\t      // 先放入云端记录\n272\t      for (const cr of cloudRecords) {\n273\t        const key = cr.mealId || cr.id;\n274\t        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n275\t      }\n276\t\n277\t      // 再放入本地未同步或更新的属于当前家庭的记录\n278\t      for (const lr of localRecords) {\n279\t        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n280\t        if (lr.familyId && lr.familyId !== familyId) {\n281\t          continue;\n282\t        }\n283\t        const key = lr.mealId || lr.id;\n284\t        if (!recordMap.has(key)) {\n285\t          recordMap.set(key, lr);\n286\t        } else {\n287\t          // 如果本地是 pending，优先以本地为准\n288\t          if (lr.syncStatus === 'pending') {\n289\t            recordMap.set(key, lr);\n290\t          }\n291\t        }\n292\t      }\n293\t\n294\t      const merged = Array.from(recordMap.values());\n295\t      merged.sort((a, b) => b.timestamp - a.timestamp);\n296\t      const finalRecords = merged.slice(0, 60);\n297\t\n298\t      this.saveHistory(finalRecords);\n299\t      this.notifyListeners();\n300\t      return finalRecords;\n301\t    }\n302\t\n303\t    return this.getHistory();\n304\t  }\n305\t\n306\t  /**\n307\t   * 清空或重置历史 (用于测试或用户重置)\n308\t   */\n309\t  public clearHistory(): void {\n310\t    this.pendingQueue = [];\n311\t    this.savePendingQueue();\n312\t    this.saveHistory([]);\n313\t    this.notifyListeners();\n314\t  }\n315\t\n316\t  private saveHistory(records: MealHistoryRecord[]): void {\n317\t    this.memoryHistory = records;\n318\t    try {\n319\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n320\t        wx.setStorageSync(STORAGE_KEY, records);\n321\t      }\n322\t    } catch (e) {\n323\t      console.warn('保存本地历史失败', e);\n324\t    }\n325\t  }\n326\t}\n327\t\n328\texport const historyService = new HistoryService();\n329\t"}]},"parent_tool_use_id":null,"session_id":"dcb23375-9639-4e07-812d-47e9f86cdae9","uuid":"40008eae-d0a5-4c24-af26-02eb8efa7bbb","timestamp":"2026-10-02T12:46:21.921Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/historyService.ts","content":"import type { MealHistoryRecord, MealMode } from '../types/user.js';\nimport type { Dish } from '../types/dish.js';\nimport { familyService } from './familyService.js';\nimport { cloudService } from './cloudService.js';\n\nconst STORAGE_KEY = 'meal_history_records';\nconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n\ninterface PendingSyncItem {\n  targetFamilyId: string;\n  authorOpenid: string;\n  record: MealHistoryRecord;\n}\n\ntype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n\nclass HistoryService {\n  private memoryHistory: MealHistoryRecord[] = [];\n  private pendingQueue: PendingSyncItem[] = [];\n  private listeners: Set<HistoryChangeListener> = new Set();\n  private isSyncing = false;\n\n  constructor() {\n    this.restoreFromStorage();\n  }\n\n  private restoreFromStorage() {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(STORAGE_KEY);\n        if (stored && Array.isArray(stored)) {\n          this.memoryHistory = stored;\n        }\n        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n        if (queued && Array.isArray(queued)) {\n          this.pendingQueue = queued;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地历史失败，使用内存降级', e);\n    }\n  }\n\n  /**\n   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n   */\n  public subscribe(listener: HistoryChangeListener): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  private notifyListeners(): void {\n    const list = this.getHistory();\n    for (const listener of this.listeners) {\n      try {\n        listener(list);\n      } catch (err) {\n        console.error('历史状态订阅回调异常', err);\n      }\n    }\n  }\n\n  /**\n   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n   */\n  public getHistory(): MealHistoryRecord[] {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(STORAGE_KEY);\n        if (stored && Array.isArray(stored)) {\n          return stored;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地历史失败，使用内存降级', e);\n    }\n    return this.memoryHistory;\n  }\n\n  /**\n   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n   */\n  public deduceMealType(dateObj = new Date()): string {\n    const hour = dateObj.getHours();\n    if (hour >= 5 && hour < 10) return '早餐';\n    if (hour >= 10 && hour < 15) return '午餐';\n    if (hour >= 15 && hour < 21) return '晚餐';\n    return '加餐';\n  }\n\n  /**\n   * 确认开饭：将菜单正式写入就餐历史\n   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n   */\n  public recordMeal(\n    mode: MealMode,\n    dishes: Dish[],\n    dateStr?: string,\n    menuId?: string,\n    mealType?: string\n  ): MealHistoryRecord {\n    const history = this.getHistory();\n    const now = new Date();\n    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n    const targetDate = dateStr || localDate;\n    const resolvedMealType = mealType || this.deduceMealType(now);\n    const randSuffix = Math.random().toString(36).slice(2, 6);\n    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n\n    const currentUser = familyService.getCurrentUser();\n    const currentFamily = familyService.getCurrentFamily();\n    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n\n    const newRecord: MealHistoryRecord = {\n      id: mealId,\n      menuId,\n      mealId,\n      date: targetDate,\n      timestamp: now.getTime(),\n      mode,\n      mealType: resolvedMealType,\n      dishIds: dishes.map(d => d.id),\n      dishNames: dishes.map(d => d.name),\n      dishes: dishes.map(d => ({\n        id: d.id,\n        name: d.name,\n        category: d.category,\n        thumbUrl: d.thumbUrl,\n        dishEmoji: d.dishEmoji,\n        isCustom: (d as any).isCustom\n      })),\n      confirmedBy: currentUser.openid,\n      confirmedByName: currentUser.nickName || '家人',\n      familyId,\n      syncStatus: familyId ? 'pending' : 'synced'\n    };\n\n    // 智能去重判断：\n    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n    const existingIndex = history.findIndex(r =>\n      r.id === mealId ||\n      (Boolean(menuId) && r.menuId === menuId) ||\n      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n    );\n\n    let updated: MealHistoryRecord[];\n    if (existingIndex >= 0) {\n      updated = [...history];\n      updated[existingIndex] = newRecord;\n    } else {\n      updated = [newRecord, ...history].slice(0, 60);\n    }\n\n    this.saveHistory(updated);\n\n    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n    if (familyId) {\n      this.enqueuePendingSync({\n        targetFamilyId: familyId,\n        authorOpenid: currentUser.openid,\n        record: newRecord\n      });\n      // 触发后台静默同步\n      this.flushPendingQueue().catch(() => {});\n    }\n\n    return newRecord;\n  }\n\n  /**\n   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n   */\n  private enqueuePendingSync(item: PendingSyncItem) {\n    this.pendingQueue.push(item);\n    this.savePendingQueue();\n  }\n\n  private savePendingQueue() {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n      }\n    } catch (e) {}\n  }\n\n  /**\n   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n   */\n  public async flushPendingQueue(): Promise<void> {\n    if (this.isSyncing || this.pendingQueue.length === 0) return;\n    this.isSyncing = true;\n\n    try {\n      const currentFamily = familyService.getCurrentFamily();\n      const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n\n      const remainingQueue: PendingSyncItem[] = [];\n\n      for (const item of this.pendingQueue) {\n        // 关键防御：如果当前家庭与离线时所属家庭不一致，判定为废弃记录，安全丢弃，绝不上报！\n        if (!currentFamilyId || currentFamilyId !== item.targetFamilyId) {\n          console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n          continue;\n        }\n\n        const res = await cloudService.callFunction('upsertMeal', {\n          action: 'upsertMeal',\n          familyId: item.targetFamilyId,\n          date: item.record.date,\n          meal: {\n            mealId: item.record.mealId || item.record.id,\n            mealType: item.record.mealType,\n            mode: item.record.mode,\n            dishes: item.record.dishes,\n            dishIds: item.record.dishIds,\n            dishNames: item.record.dishNames,\n            confirmedByName: item.record.confirmedByName,\n            timestamp: item.record.timestamp\n          }\n        });\n\n        if (res.success) {\n          // 标记本地记录为已同步\n          const history = this.getHistory();\n          const target = history.find(r => r.id === item.record.id);\n          if (target) {\n            target.syncStatus = 'synced';\n            this.saveHistory([...history]);\n            this.notifyListeners();\n          }\n        } else {\n          // 提交失败，保留在队列中等待下次重试\n          remainingQueue.push(item);\n        }\n      }\n\n      this.pendingQueue = remainingQueue;\n      this.savePendingQueue();\n    } finally {\n      this.isSyncing = false;\n    }\n  }\n\n  /**\n   * SWR 增量拉取家庭共享历史并合并到本地\n   */\n  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n    const currentFamily = familyService.getCurrentFamily();\n    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n    if (!familyId) {\n      return this.getHistory();\n    }\n\n    // 先刷新离线待上报队列\n    await this.flushPendingQueue();\n\n    const res = await cloudService.callFunction('upsertMeal', {\n      action: 'getHistory',\n      familyId,\n      limitDays: 60\n    });\n\n    if (res.success && Array.isArray(res.records)) {\n      const cloudRecords: MealHistoryRecord[] = res.records;\n      const localRecords = this.getHistory();\n\n      // 双向合并：以餐次 mealId 为唯一标识\n      const recordMap = new Map<string, MealHistoryRecord>();\n\n      // 先放入云端记录\n      for (const cr of cloudRecords) {\n        const key = cr.mealId || cr.id;\n        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n      }\n\n      // 再放入本地未同步或更新的属于当前家庭的记录\n      for (const lr of localRecords) {\n        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n        if (lr.familyId && lr.familyId !== familyId) {\n          continue;\n        }\n        const key = lr.mealId || lr.id;\n        if (!recordMap.has(key)) {\n          recordMap.set(key, lr);\n        } else {\n          // 如果本地是 pending，优先以本地为准\n          if (lr.syncStatus === 'pending') {\n            recordMap.set(key, lr);\n          }\n        }\n      }\n\n      const merged = Array.from(recordMap.values());\n      merged.sort((a, b) => b.timestamp - a.timestamp);\n      const finalRecords = merged.slice(0, 60);\n\n      this.saveHistory(finalRecords);\n      this.notifyListeners();\n      return finalRecords;\n    }\n\n    return this.getHistory();\n  }\n\n  /**\n   * 清空或重置历史 (用于测试或用户重置)\n   */\n  public clearHistory(): void {\n    this.pendingQueue = [];\n    this.savePendingQueue();\n    this.saveHistory([]);\n    this.notifyListeners();\n  }\n\n  private saveHistory(records: MealHistoryRecord[]): void {\n    this.memoryHistory = records;\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(STORAGE_KEY, records);\n      }\n    } catch (e) {\n      console.warn('保存本地历史失败', e);\n    }\n  }\n}\n\nexport const historyService = new HistoryService();\n","numLines":329,"startLine":1,"totalLines":329}}}
