{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FB9oRvonS9nbKPZhAdhLuv","type":"tool_result","content":"1\timport { cloudService } from './cloudService.js';\n2\timport type { FamilySpace, UserProfile } from '../types/family.js';\n3\t\n4\tconst STORAGE_KEY_USER = 'current_user_profile';\n5\tconst STORAGE_KEY_FAMILY = 'current_family_space';\n6\t\n7\ttype FamilyChangeListener = (family: FamilySpace | null) => void;\n8\t\n9\tclass FamilyService {\n10\t  private currentUser: UserProfile = {\n11\t    openid: 'wx_user_default',\n12\t    nickName: '我',\n13\t    avatarUrl: '',\n14\t    familyId: null,\n15\t    role: null,\n16\t    createdAt: Date.now(),\n17\t    updatedAt: Date.now()\n18\t  };\n19\t\n20\t  private currentFamily: FamilySpace | null = null;\n21\t  private listeners: Set<FamilyChangeListener> = new Set();\n22\t  private initialized = false;\n23\t\n24\t  constructor() {\n25\t    this.restoreFromStorage();\n26\t  }\n27\t\n28\t  public init(): void {\n29\t    if (this.initialized) return;\n30\t    this.restoreFromStorage();\n31\t    this.initialized = true;\n32\t  }\n33\t\n34\t  private restoreFromStorage(): void {\n35\t    try {\n36\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n37\t        const storedUser = wx.getStorageSync(STORAGE_KEY_USER);\n38\t        if (storedUser) {\n39\t          this.currentUser = { ...this.currentUser, ...storedUser };\n40\t        }\n41\t        const storedFam = wx.getStorageSync(STORAGE_KEY_FAMILY);\n42\t        if (storedFam) {\n43\t          this.currentFamily = storedFam;\n44\t        }\n45\t      }\n46\t    } catch (e) {\n47\t      console.warn('读取本地家庭缓存失败', e);\n48\t    }\n49\t  }\n50\t\n51\t  private persist(): void {\n52\t    try {\n53\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n54\t        wx.setStorageSync(STORAGE_KEY_USER, this.currentUser);\n55\t        if (this.currentFamily) {\n56\t          wx.setStorageSync(STORAGE_KEY_FAMILY, this.currentFamily);\n57\t        } else {\n58\t          wx.removeStorageSync(STORAGE_KEY_FAMILY);\n59\t        }\n60\t      }\n61\t    } catch (e) {\n62\t      console.warn('持久化本地家庭缓存失败', e);\n63\t    }\n64\t    this.notifyListeners();\n65\t  }\n66\t\n67\t  public subscribe(listener: FamilyChangeListener): () => void {\n68\t    this.listeners.add(listener);\n69\t    return () => this.listeners.delete(listener);\n70\t  }\n71\t\n72\t  private notifyListeners(): void {\n73\t    for (const listener of this.listeners) {\n74\t      try {\n75\t        listener(this.currentFamily);\n76\t      } catch (err) {\n77\t        console.error('家庭状态订阅回调异常', err);\n78\t      }\n79\t    }\n80\t  }\n81\t\n82\t  public getCurrentUser(): UserProfile {\n83\t    return this.currentUser;\n84\t  }\n85\t\n86\t  public getCurrentFamily(): FamilySpace | null {\n87\t    return this.currentFamily;\n88\t  }\n89\t\n90\t  public setMockCurrentUser(openid: string, nickName: string = '家人'): void {\n91\t    this.currentUser.openid = openid;\n92\t    this.currentUser.nickName = nickName;\n93\t    this.currentUser.familyId = null;\n94\t    this.currentUser.role = null;\n95\t    this.currentFamily = null;\n96\t    this.persist();\n97\t  }\n98\t\n99\t  /**\n100\t   * 静默登录与鉴权同步\n101\t   */\n102\t  public async syncUserAuth(): Promise<UserProfile> {\n103\t    const res = await cloudService.callFunction('userAuth', {\n104\t      mockOpenid: this.currentUser.openid,\n105\t      nickName: this.currentUser.nickName,\n106\t      avatarUrl: this.currentUser.avatarUrl\n107\t    });\n108\t\n109\t    if (res.success && res.user) {\n110\t      this.currentUser = {\n111\t        openid: res.openid || this.currentUser.openid,\n112\t        nickName: res.user.nickName || this.currentUser.nickName,\n113\t        avatarUrl: res.user.avatarUrl || '',\n114\t        familyId: res.user.familyId || null,\n115\t        role: res.user.role || null,\n116\t        createdAt: res.user.createdAt || Date.now(),\n117\t        updatedAt: res.user.updatedAt || Date.now()\n118\t      };\n119\t      if (res.family) {\n120\t        this.currentFamily = res.family;\n121\t      } else if (!this.currentUser.familyId) {\n122\t        this.currentFamily = null;\n123\t      }\n124\t      this.persist();\n125\t    }\n126\t\n127\t    return this.currentUser;\n128\t  }\n129\t\n130\t  /**\n131\t   * 1. 创建家庭空间\n132\t   */\n133\t  public async createFamily(name = '温馨小家食堂', nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n134\t    const callerNick = nickName || this.currentUser.nickName || '房主';\n135\t    const res = await cloudService.callFunction('familyManage', {\n136\t      action: 'createFamily',\n137\t      mockOpenid: this.currentUser.openid,\n138\t      name,\n139\t      nickName: callerNick,\n140\t      avatarUrl: this.currentUser.avatarUrl\n141\t    });\n142\t\n143\t    if (res.success && res.family) {\n144\t      this.currentFamily = res.family;\n145\t      this.currentUser.familyId = res.family.id || res.family._id;\n146\t      this.currentUser.role = 'creator';\n147\t      this.currentUser.nickName = callerNick;\n148\t      this.persist();\n149\t      return { success: true, family: res.family };\n150\t    }\n151\t\n152\t    return { success: false, error: res.error || '创建家庭空间失败' };\n153\t  }\n154\t\n155\t  /**\n156\t   * 2. 口令加入家庭 (云端事务，上限 4 人，一人一家庭互斥)\n157\t   */\n158\t  public async joinFamily(inviteCode: string, nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n159\t    const code = inviteCode.trim();\n160\t    if (!code || code.length !== 6) {\n161\t      return { success: false, error: '请输入正确的6位数字邀请码' };\n162\t    }\n163\t\n164\t    const callerNick = nickName || this.currentUser.nickName || '家人';\n165\t    const res = await cloudService.callFunction('familyManage', {\n166\t      action: 'joinFamily',\n167\t      mockOpenid: this.currentUser.openid,\n168\t      inviteCode: code,\n169\t      nickName: callerNick,\n170\t      avatarUrl: this.currentUser.avatarUrl\n171\t    });\n172\t\n173\t    if (res.success && res.family) {\n174\t      this.currentFamily = res.family;\n175\t      this.currentUser.familyId = res.family.id || res.family._id;\n176\t      this.currentUser.role = 'member';\n177\t      this.currentUser.nickName = callerNick;\n178\t      this.persist();\n179\t      return { success: true, family: res.family };\n180\t    }\n181\t\n182\t    return { success: false, error: res.error || '加入家庭空间失败' };\n183\t  }\n184\t\n185\t  /**\n186\t   * 3. 退出 / 解散家庭\n187\t   */\n188\t  public async leaveFamily(): Promise<{ success: boolean; error?: string }> {\n189\t    const res = await cloudService.callFunction('familyManage', {\n190\t      action: 'leaveFamily',\n191\t      mockOpenid: this.currentUser.openid\n192\t    });\n193\t\n194\t    if (res.success) {\n195\t      this.currentUser.familyId = null;\n196\t      this.currentUser.role = null;\n197\t      this.currentFamily = null;\n198\t      this.persist();\n199\t      return { success: true };\n200\t    }\n201\t\n202\t    return { success: false, error: res.error || '退出家庭失败' };\n203\t  }\n204\t\n205\t  /**\n206\t   * 4. 刷新 24 小时动态口令\n207\t   */\n208\t  public async refreshInviteCode(): Promise<{ success: boolean; inviteCode?: string; error?: string }> {\n209\t    if (!this.currentFamily) {\n210\t      return { success: false, error: '尚未加入家庭' };\n211\t    }\n212\t\n213\t    const res = await cloudService.callFunction('familyManage', {\n214\t      action: 'refreshInviteCode',\n215\t      mockOpenid: this.currentUser.openid,\n216\t      familyId: this.currentFamily.id || (this.currentFamily as any)._id\n217\t    });\n218\t\n219\t    if (res.success && res.inviteCode) {\n220\t      this.currentFamily.inviteCode = res.inviteCode;\n221\t      this.currentFamily.inviteExpiredAt = res.inviteExpiredAt;\n222\t      this.persist();\n223\t      return { success: true, inviteCode: res.inviteCode };\n224\t    }\n225\t\n226\t    return { success: false, error: res.error || '刷新邀请码失败' };\n227\t  }\n228\t}\n229\t\n230\texport const familyService = new FamilyService();\n231\t"}]},"parent_tool_use_id":null,"session_id":"dcb23375-9639-4e07-812d-47e9f86cdae9","uuid":"e11defad-c68a-4abe-a874-96053d124f26","timestamp":"2026-10-02T12:46:22.645Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/familyService.ts","content":"import { cloudService } from './cloudService.js';\nimport type { FamilySpace, UserProfile } from '../types/family.js';\n\nconst STORAGE_KEY_USER = 'current_user_profile';\nconst STORAGE_KEY_FAMILY = 'current_family_space';\n\ntype FamilyChangeListener = (family: FamilySpace | null) => void;\n\nclass FamilyService {\n  private currentUser: UserProfile = {\n    openid: 'wx_user_default',\n    nickName: '我',\n    avatarUrl: '',\n    familyId: null,\n    role: null,\n    createdAt: Date.now(),\n    updatedAt: Date.now()\n  };\n\n  private currentFamily: FamilySpace | null = null;\n  private listeners: Set<FamilyChangeListener> = new Set();\n  private initialized = false;\n\n  constructor() {\n    this.restoreFromStorage();\n  }\n\n  public init(): void {\n    if (this.initialized) return;\n    this.restoreFromStorage();\n    this.initialized = true;\n  }\n\n  private restoreFromStorage(): void {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const storedUser = wx.getStorageSync(STORAGE_KEY_USER);\n        if (storedUser) {\n          this.currentUser = { ...this.currentUser, ...storedUser };\n        }\n        const storedFam = wx.getStorageSync(STORAGE_KEY_FAMILY);\n        if (storedFam) {\n          this.currentFamily = storedFam;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地家庭缓存失败', e);\n    }\n  }\n\n  private persist(): void {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(STORAGE_KEY_USER, this.currentUser);\n        if (this.currentFamily) {\n          wx.setStorageSync(STORAGE_KEY_FAMILY, this.currentFamily);\n        } else {\n          wx.removeStorageSync(STORAGE_KEY_FAMILY);\n        }\n      }\n    } catch (e) {\n      console.warn('持久化本地家庭缓存失败', e);\n    }\n    this.notifyListeners();\n  }\n\n  public subscribe(listener: FamilyChangeListener): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  private notifyListeners(): void {\n    for (const listener of this.listeners) {\n      try {\n        listener(this.currentFamily);\n      } catch (err) {\n        console.error('家庭状态订阅回调异常', err);\n      }\n    }\n  }\n\n  public getCurrentUser(): UserProfile {\n    return this.currentUser;\n  }\n\n  public getCurrentFamily(): FamilySpace | null {\n    return this.currentFamily;\n  }\n\n  public setMockCurrentUser(openid: string, nickName: string = '家人'): void {\n    this.currentUser.openid = openid;\n    this.currentUser.nickName = nickName;\n    this.currentUser.familyId = null;\n    this.currentUser.role = null;\n    this.currentFamily = null;\n    this.persist();\n  }\n\n  /**\n   * 静默登录与鉴权同步\n   */\n  public async syncUserAuth(): Promise<UserProfile> {\n    const res = await cloudService.callFunction('userAuth', {\n      mockOpenid: this.currentUser.openid,\n      nickName: this.currentUser.nickName,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.user) {\n      this.currentUser = {\n        openid: res.openid || this.currentUser.openid,\n        nickName: res.user.nickName || this.currentUser.nickName,\n        avatarUrl: res.user.avatarUrl || '',\n        familyId: res.user.familyId || null,\n        role: res.user.role || null,\n        createdAt: res.user.createdAt || Date.now(),\n        updatedAt: res.user.updatedAt || Date.now()\n      };\n      if (res.family) {\n        this.currentFamily = res.family;\n      } else if (!this.currentUser.familyId) {\n        this.currentFamily = null;\n      }\n      this.persist();\n    }\n\n    return this.currentUser;\n  }\n\n  /**\n   * 1. 创建家庭空间\n   */\n  public async createFamily(name = '温馨小家食堂', nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n    const callerNick = nickName || this.currentUser.nickName || '房主';\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'createFamily',\n      mockOpenid: this.currentUser.openid,\n      name,\n      nickName: callerNick,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.family) {\n      this.currentFamily = res.family;\n      this.currentUser.familyId = res.family.id || res.family._id;\n      this.currentUser.role = 'creator';\n      this.currentUser.nickName = callerNick;\n      this.persist();\n      return { success: true, family: res.family };\n    }\n\n    return { success: false, error: res.error || '创建家庭空间失败' };\n  }\n\n  /**\n   * 2. 口令加入家庭 (云端事务，上限 4 人，一人一家庭互斥)\n   */\n  public async joinFamily(inviteCode: string, nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n    const code = inviteCode.trim();\n    if (!code || code.length !== 6) {\n      return { success: false, error: '请输入正确的6位数字邀请码' };\n    }\n\n    const callerNick = nickName || this.currentUser.nickName || '家人';\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'joinFamily',\n      mockOpenid: this.currentUser.openid,\n      inviteCode: code,\n      nickName: callerNick,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.family) {\n      this.currentFamily = res.family;\n      this.currentUser.familyId = res.family.id || res.family._id;\n      this.currentUser.role = 'member';\n      this.currentUser.nickName = callerNick;\n      this.persist();\n      return { success: true, family: res.family };\n    }\n\n    return { success: false, error: res.error || '加入家庭空间失败' };\n  }\n\n  /**\n   * 3. 退出 / 解散家庭\n   */\n  public async leaveFamily(): Promise<{ success: boolean; error?: string }> {\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'leaveFamily',\n      mockOpenid: this.currentUser.openid\n    });\n\n    if (res.success) {\n      this.currentUser.familyId = null;\n      this.currentUser.role = null;\n      this.currentFamily = null;\n      this.persist();\n      return { success: true };\n    }\n\n    return { success: false, error: res.error || '退出家庭失败' };\n  }\n\n  /**\n   * 4. 刷新 24 小时动态口令\n   */\n  public async refreshInviteCode(): Promise<{ success: boolean; inviteCode?: string; error?: string }> {\n    if (!this.currentFamily) {\n      return { success: false, error: '尚未加入家庭' };\n    }\n\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'refreshInviteCode',\n      mockOpenid: this.currentUser.openid,\n      familyId: this.currentFamily.id || (this.currentFamily as any)._id\n    });\n\n    if (res.success && res.inviteCode) {\n      this.currentFamily.inviteCode = res.inviteCode;\n      this.currentFamily.inviteExpiredAt = res.inviteExpiredAt;\n      this.persist();\n      return { success: true, inviteCode: res.inviteCode };\n    }\n\n    return { success: false, error: res.error || '刷新邀请码失败' };\n  }\n}\n\nexport const familyService = new FamilyService();\n","numLines":231,"startLine":1,"totalLines":231}}}
