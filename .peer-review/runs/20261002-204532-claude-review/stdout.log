{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CDCW5XmJDaYobH5xdyJkJJ","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\tconst _ = db.command;\n9\t\n10\texports.main = async (event, context) => {\n11\t  const wxContext = cloud.getWXContext();\n12\t  const openid = wxContext.OPENID || event.mockOpenid || 'mock_openid_default';\n13\t  const { action = 'upsertMeal' } = event;\n14\t  const now = Date.now();\n15\t\n16\t  try {\n17\t    switch (action) {\n18\t      /**\n19\t       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n20\t       * 彻底杜绝同日多次做菜被覆盖问题\n21\t       */\n22\t      case 'upsertMeal': {\n23\t        const { familyId, date, meal } = event;\n24\t        if (!familyId || !date || !meal) {\n25\t          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n26\t        }\n27\t\n28\t        const docId = `meal_${familyId}_${date}`;\n29\t\n30\t        // 规范化单餐快照数据\n31\t        const mealSnapshot = {\n32\t          mealId: meal.mealId || `m_${now}`,\n33\t          mealType: meal.mealType || '午餐',\n34\t          mode: meal.mode || 'hearty_3_1',\n35\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n36\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n37\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n38\t          confirmedBy: openid,\n39\t          confirmedByName: meal.confirmedByName || event.nickName || '家人',\n40\t          timestamp: meal.timestamp || now\n41\t        };\n42\t\n43\t        return await db.runTransaction(async transaction => {\n44\t          const docRef = transaction.collection('meal_history').doc(docId);\n45\t          const existingDoc = await docRef.get().catch(() => null);\n46\t\n47\t          if (!existingDoc || !existingDoc.data) {\n48\t            // 该日首次开饭，创建日文档\n49\t            await docRef.set({\n50\t              data: {\n51\t                _id: docId,\n52\t                familyId,\n53\t                date,\n54\t                meals: [mealSnapshot],\n55\t                updatedAt: now\n56\t              }\n57\t            });\n58\t          } else {\n59\t            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n60\t            const existingMeals = existingDoc.data.meals || [];\n61\t            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n62\t\n63\t            let updatedMeals;\n64\t            if (mealIndex >= 0) {\n65\t              // 同一餐次就地更新 (如反复确认)\n66\t              updatedMeals = [...existingMeals];\n67\t              updatedMeals[mealIndex] = mealSnapshot;\n68\t            } else {\n69\t              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n70\t              updatedMeals = [...existingMeals, mealSnapshot];\n71\t            }\n72\t\n73\t            await docRef.update({\n74\t              data: {\n75\t                meals: updatedMeals,\n76\t                updatedAt: now\n77\t              }\n78\t            });\n79\t          }\n80\t\n81\t          return {\n82\t            success: true,\n83\t            docId,\n84\t            meal: mealSnapshot\n85\t          };\n86\t        });\n87\t      }\n88\t\n89\t      /**\n90\t       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n91\t       */\n92\t      case 'getHistory': {\n93\t        const { familyId, limitDays = 60 } = event;\n94\t        if (!familyId) {\n95\t          return { success: false, error: '缺少 familyId' };\n96\t        }\n97\t\n98\t        // 查询该家庭最近的日文档\n99\t        const res = await db.collection('meal_history')\n100\t          .where({ familyId })\n101\t          .orderBy('date', 'desc')\n102\t          .limit(limitDays)\n103\t          .get();\n104\t\n105\t        const docs = res.data || [];\n106\t        // 展平为有序餐次列表供客户端秒级合并\n107\t        const allMeals = [];\n108\t        for (const doc of docs) {\n109\t          for (const m of (doc.meals || [])) {\n110\t            allMeals.push({\n111\t              id: m.mealId,\n112\t              menuId: m.mealId,\n113\t              mealId: m.mealId,\n114\t              date: doc.date,\n115\t              timestamp: m.timestamp,\n116\t              mode: m.mode,\n117\t              mealType: m.mealType,\n118\t              dishIds: m.dishIds,\n119\t              dishNames: m.dishNames,\n120\t              dishes: m.dishes,\n121\t              confirmedBy: m.confirmedBy,\n122\t              confirmedByName: m.confirmedByName,\n123\t              familyId: doc.familyId,\n124\t              syncStatus: 'synced'\n125\t            });\n126\t          }\n127\t        }\n128\t\n129\t        // 按时间戳倒序排列\n130\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n131\t\n132\t        return {\n133\t          success: true,\n134\t          records: allMeals,\n135\t          docs\n136\t        };\n137\t      }\n138\t\n139\t      default:\n140\t        return { success: false, error: `不支持的操作类型: ${action}` };\n141\t    }\n142\t  } catch (err) {\n143\t    return {\n144\t      success: false,\n145\t      error: err.message || '历史记录同步失败'\n146\t    };\n147\t  }\n148\t};\n149\t"}]},"parent_tool_use_id":null,"session_id":"dcb23375-9639-4e07-812d-47e9f86cdae9","uuid":"065a8978-ca88-45cf-8ad4-70a268e21893","timestamp":"2026-10-02T12:45:45.983Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/upsertMeal/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  const openid = wxContext.OPENID || event.mockOpenid || 'mock_openid_default';\n  const { action = 'upsertMeal' } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n       * 彻底杜绝同日多次做菜被覆盖问题\n       */\n      case 'upsertMeal': {\n        const { familyId, date, meal } = event;\n        if (!familyId || !date || !meal) {\n          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n        }\n\n        const docId = `meal_${familyId}_${date}`;\n\n        // 规范化单餐快照数据\n        const mealSnapshot = {\n          mealId: meal.mealId || `m_${now}`,\n          mealType: meal.mealType || '午餐',\n          mode: meal.mode || 'hearty_3_1',\n          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n          confirmedBy: openid,\n          confirmedByName: meal.confirmedByName || event.nickName || '家人',\n          timestamp: meal.timestamp || now\n        };\n\n        return await db.runTransaction(async transaction => {\n          const docRef = transaction.collection('meal_history').doc(docId);\n          const existingDoc = await docRef.get().catch(() => null);\n\n          if (!existingDoc || !existingDoc.data) {\n            // 该日首次开饭，创建日文档\n            await docRef.set({\n              data: {\n                _id: docId,\n                familyId,\n                date,\n                meals: [mealSnapshot],\n                updatedAt: now\n              }\n            });\n          } else {\n            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n            const existingMeals = existingDoc.data.meals || [];\n            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n\n            let updatedMeals;\n            if (mealIndex >= 0) {\n              // 同一餐次就地更新 (如反复确认)\n              updatedMeals = [...existingMeals];\n              updatedMeals[mealIndex] = mealSnapshot;\n            } else {\n              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n              updatedMeals = [...existingMeals, mealSnapshot];\n            }\n\n            await docRef.update({\n              data: {\n                meals: updatedMeals,\n                updatedAt: now\n              }\n            });\n          }\n\n          return {\n            success: true,\n            docId,\n            meal: mealSnapshot\n          };\n        });\n      }\n\n      /**\n       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n       */\n      case 'getHistory': {\n        const { familyId, limitDays = 60 } = event;\n        if (!familyId) {\n          return { success: false, error: '缺少 familyId' };\n        }\n\n        // 查询该家庭最近的日文档\n        const res = await db.collection('meal_history')\n          .where({ familyId })\n          .orderBy('date', 'desc')\n          .limit(limitDays)\n          .get();\n\n        const docs = res.data || [];\n        // 展平为有序餐次列表供客户端秒级合并\n        const allMeals = [];\n        for (const doc of docs) {\n          for (const m of (doc.meals || [])) {\n            allMeals.push({\n              id: m.mealId,\n              menuId: m.mealId,\n              mealId: m.mealId,\n              date: doc.date,\n              timestamp: m.timestamp,\n              mode: m.mode,\n              mealType: m.mealType,\n              dishIds: m.dishIds,\n              dishNames: m.dishNames,\n              dishes: m.dishes,\n              confirmedBy: m.confirmedBy,\n              confirmedByName: m.confirmedByName,\n              familyId: doc.familyId,\n              syncStatus: 'synced'\n            });\n          }\n        }\n\n        // 按时间戳倒序排列\n        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n\n        return {\n          success: true,\n          records: allMeals,\n          docs\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '历史记录同步失败'\n    };\n  }\n};\n","numLines":149,"startLine":1,"totalLines":149}}}
