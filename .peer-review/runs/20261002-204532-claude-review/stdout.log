{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DjXVVUU6QZtdXBi3M59Z1a","type":"tool_result","content":"1\t/**\n2\t * 微信云开发服务网关 (CloudService)\n3\t * 职责：\n4\t * 1. 统一封装 wx.cloud.callFunction 调用\n5\t * 2. 在离线环境、本地单测与弱网环境下，提供高保真本地 Mock 状态机仿真\n6\t * 3. 严格保障 4 人上限、24小时邀请码、一人一家庭排他与同日多餐写入\n7\t */\n8\t\n9\timport type { FamilySpace, UserProfile, SingleMealItem, CustomDishRecord } from '../types/family.js';\n10\t\n11\tinterface CloudResponse<T = any> {\n12\t  success: boolean;\n13\t  result?: T;\n14\t  error?: string;\n15\t  [key: string]: any;\n16\t}\n17\t\n18\tclass LocalCloudMockDatabase {\n19\t  private users = new Map<string, any>();\n20\t  private families = new Map<string, any>();\n21\t  private mealHistory = new Map<string, any>(); // key: meal_${familyId}_${date}\n22\t  private customDishes = new Map<string, any[]>(); // key: familyId -> dish[]\n23\t\n24\t  constructor() {\n25\t    this.restoreFromStorage();\n26\t  }\n27\t\n28\t  private restoreFromStorage() {\n29\t    try {\n30\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n31\t        const storedUsers = wx.getStorageSync('mock_db_users');\n32\t        if (storedUsers) this.users = new Map(Object.entries(storedUsers));\n33\t\n34\t        const storedFamilies = wx.getStorageSync('mock_db_families');\n35\t        if (storedFamilies) this.families = new Map(Object.entries(storedFamilies));\n36\t\n37\t        const storedHistory = wx.getStorageSync('mock_db_history');\n38\t        if (storedHistory) this.mealHistory = new Map(Object.entries(storedHistory));\n39\t\n40\t        const storedDishes = wx.getStorageSync('mock_db_custom_dishes');\n41\t        if (storedDishes) this.customDishes = new Map(Object.entries(storedDishes));\n42\t      }\n43\t    } catch (e) {}\n44\t  }\n45\t\n46\t  private persist() {\n47\t    try {\n48\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n49\t        wx.setStorageSync('mock_db_users', Object.fromEntries(this.users));\n50\t        wx.setStorageSync('mock_db_families', Object.fromEntries(this.families));\n51\t        wx.setStorageSync('mock_db_history', Object.fromEntries(this.mealHistory));\n52\t        wx.setStorageSync('mock_db_custom_dishes', Object.fromEntries(this.customDishes));\n53\t      }\n54\t    } catch (e) {}\n55\t  }\n56\t\n57\t  public clearAll() {\n58\t    this.users.clear();\n59\t    this.families.clear();\n60\t    this.mealHistory.clear();\n61\t    this.customDishes.clear();\n62\t    this.persist();\n63\t  }\n64\t\n65\t  public handleUserAuth(data: any): any {\n66\t    const openid = data?.mockOpenid || 'mock_openid_default';\n67\t    const now = Date.now();\n68\t    let user = this.users.get(`user_${openid}`);\n69\t\n70\t    if (!user) {\n71\t      user = {\n72\t        _id: `user_${openid}`,\n73\t        _openid: openid,\n74\t        nickName: data?.nickName || '家人',\n75\t        avatarUrl: data?.avatarUrl || '',\n76\t        familyId: null,\n77\t        role: null,\n78\t        createdAt: now,\n79\t        updatedAt: now\n80\t      };\n81\t      this.users.set(`user_${openid}`, user);\n82\t    } else {\n83\t      if (data?.nickName) user.nickName = data.nickName;\n84\t      if (data?.avatarUrl) user.avatarUrl = data.avatarUrl;\n85\t      user.updatedAt = now;\n86\t    }\n87\t\n88\t    let family = null;\n89\t    if (user.familyId) {\n90\t      family = this.families.get(user.familyId) || null;\n91\t      if (!family) {\n92\t        user.familyId = null;\n93\t        user.role = null;\n94\t      }\n95\t    }\n96\t\n97\t    this.persist();\n98\t    return { success: true, openid, user, family };\n99\t  }\n100\t\n101\t  public handleFamilyManage(data: any): any {\n102\t    const { action } = data;\n103\t    const openid = data?.mockOpenid || 'mock_openid_default';\n104\t    const now = Date.now();\n105\t\n106\t    switch (action) {\n107\t      case 'createFamily': {\n108\t        const familyName = (data.name || '温馨小家食堂').trim().slice(0, 15);\n109\t        let user = this.users.get(`user_${openid}`) || {\n110\t          _id: `user_${openid}`,\n111\t          _openid: openid,\n112\t          nickName: data.nickName || '房主',\n113\t          familyId: null\n114\t        };\n115\t\n116\t        // 如果用户在旧家庭中，先退出\n117\t        if (user.familyId && this.families.has(user.familyId)) {\n118\t          this.leaveFamilyInternal(openid, user.familyId);\n119\t        }\n120\t\n121\t        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n122\t        const inviteCode = String(Math.floor(100000 + Math.random() * 900000));\n123\t        const inviteExpiredAt = now + 24 * 60 * 60 * 1000;\n124\t\n125\t        const newFamily: FamilySpace = {\n126\t          id: familyId,\n127\t          name: familyName,\n128\t          creatorOpenid: openid,\n129\t          members: [\n130\t            {\n131\t              openid,\n132\t              nickName: data.nickName || user.nickName || '房主',\n133\t              avatarUrl: data.avatarUrl || user.avatarUrl || '',\n134\t              role: 'creator',\n135\t              joinedAt: now\n136\t            }\n137\t          ],\n138\t          memberOpenids: [openid],\n139\t          inviteCode,\n140\t          inviteExpiredAt,\n141\t          createdAt: now,\n142\t          updatedAt: now\n143\t        };\n144\t\n145\t        this.families.set(familyId, newFamily);\n146\t        user.familyId = familyId;\n147\t        user.role = 'creator';\n148\t        user.updatedAt = now;\n149\t        this.users.set(`user_${openid}`, user);\n150\t\n151\t        this.persist();\n152\t        return { success: true, family: newFamily };\n153\t      }\n154\t\n155\t      case 'joinFamily': {\n156\t        const inviteCode = String(data.inviteCode || '').trim();\n157\t        if (!inviteCode || inviteCode.length !== 6) {\n158\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n159\t        }\n160\t\n161\t        let targetFamily: FamilySpace | null = null;\n162\t        for (const fam of this.families.values()) {\n163\t          if (fam.inviteCode === inviteCode) {\n164\t            targetFamily = fam;\n165\t            break;\n166\t          }\n167\t        }\n168\t\n169\t        if (!targetFamily) {\n170\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n171\t        }\n172\t\n173\t        if (now > targetFamily.inviteExpiredAt) {\n174\t          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n175\t        }\n176\t\n177\t        if (targetFamily.memberOpenids.includes(openid)) {\n178\t          return { success: true, family: targetFamily, message: '您已经在该家庭厨房中' };\n179\t        }\n180\t\n181\t        // 严格 4 人限制 (易错点 2 防御)\n182\t        if (targetFamily.memberOpenids.length >= 4) {\n183\t          return { success: false, error: '该家庭厨房成员已满（上限4人），无法继续加入' };\n184\t        }\n185\t\n186\t        // 一人一家庭排他 (易错点 3 防御)\n187\t        let user = this.users.get(`user_${openid}`) || {\n188\t          _id: `user_${openid}`,\n189\t          _openid: openid,\n190\t          nickName: data.nickName || '家人',\n191\t          familyId: null\n192\t        };\n193\t        if (user.familyId && user.familyId !== targetFamily.id && this.families.has(user.familyId)) {\n194\t          this.leaveFamilyInternal(openid, user.familyId);\n195\t        }\n196\t\n197\t        const newMember = {\n198\t          openid,\n199\t          nickName: data.nickName || user.nickName || '家人',\n200\t          avatarUrl: data.avatarUrl || user.avatarUrl || '',\n201\t          role: 'member' as const,\n202\t          joinedAt: now\n203\t        };\n204\t\n205\t        targetFamily.members.push(newMember);\n206\t        targetFamily.memberOpenids.push(openid);\n207\t        targetFamily.updatedAt = now;\n208\t\n209\t        user.familyId = targetFamily.id;\n210\t        user.role = 'member';\n211\t        user.updatedAt = now;\n212\t        this.users.set(`user_${openid}`, user);\n213\t\n214\t        this.persist();\n215\t        return { success: true, family: targetFamily };\n216\t      }\n217\t\n218\t      case 'leaveFamily': {\n219\t        let user = this.users.get(`user_${openid}`);\n220\t        if (!user || !user.familyId) {\n221\t          return { success: true, message: '当前未加入任何家庭' };\n222\t        }\n223\t        this.leaveFamilyInternal(openid, user.familyId);\n224\t        user.familyId = null;\n225\t        user.role = null;\n226\t        user.updatedAt = now;\n227\t        this.users.set(`user_${openid}`, user);\n228\t        this.persist();\n229\t        return { success: true, message: '已退出家庭厨房空间' };\n230\t      }\n231\t\n232\t      case 'refreshInviteCode': {\n233\t        const { familyId } = data;\n234\t        const family = this.families.get(familyId);\n235\t        if (!family) return { success: false, error: '家庭不存在' };\n236\t\n237\t        const newCode = String(Math.floor(100000 + Math.random() * 900000));\n238\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n239\t        family.inviteCode = newCode;\n240\t        family.inviteExpiredAt = newExpiry;\n241\t        family.updatedAt = now;\n242\t\n243\t        this.persist();\n244\t        return { success: true, inviteCode: newCode, inviteExpiredAt: newExpiry };\n245\t      }\n246\t\n247\t      case 'getFamily': {\n248\t        const { familyId } = data;\n249\t        const family = this.families.get(familyId);\n250\t        if (!family) return { success: false, error: '家庭不存在' };\n251\t        return { success: true, family };\n252\t      }\n253\t\n254\t      default:\n255\t        return { success: false, error: `不支持的操作类型: ${action}` };\n256\t    }\n257\t  }\n258\t\n259\t  private leaveFamilyInternal(openid: string, familyId: string) {\n260\t    const family = this.families.get(familyId);\n261\t    if (!family) return;\n262\t    family.members = family.members.filter(m => m.openid !== openid);\n263\t    family.memberOpenids = family.memberOpenids.filter(id => id !== openid);\n264\t    if (family.members.length === 0) {\n265\t      this.families.delete(familyId);\n266\t    } else {\n267\t      if (family.creatorOpenid === openid) {\n268\t        family.creatorOpenid = family.members[0].openid;\n269\t        family.members[0].role = 'creator';\n270\t      }\n271\t      family.updatedAt = Date.now();\n272\t    }\n273\t  }\n274\t\n275\t  public handleUpsertMeal(data: any): any {\n276\t    const { action = 'upsertMeal' } = data;\n277\t    const openid = data?.mockOpenid || 'mock_openid_default';\n278\t    const now = Date.now();\n279\t\n280\t    switch (action) {\n281\t      case 'upsertMeal': {\n282\t        const { familyId, date, meal } = data;\n283\t        if (!familyId || !date || !meal) {\n284\t          return { success: false, error: '缺少参数 familyId/date/meal' };\n285\t        }\n286\t\n287\t        const docKey = `meal_${familyId}_${date}`;\n288\t        let doc = this.mealHistory.get(docKey);\n289\t\n290\t        const mealSnapshot: SingleMealItem = {\n291\t          mealId: meal.mealId || `m_${now}`,\n292\t          mealType: meal.mealType || '午餐',\n293\t          mode: meal.mode || 'hearty_3_1',\n294\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n295\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n296\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n297\t          confirmedBy: openid,\n298\t          confirmedByName: meal.confirmedByName || data.nickName || '家人',\n299\t          timestamp: meal.timestamp || now\n300\t        };\n301\t\n302\t        if (!doc) {\n303\t          doc = {\n304\t            _id: docKey,\n305\t            familyId,\n306\t            date,\n307\t            meals: [mealSnapshot],\n308\t            updatedAt: now\n309\t          };\n310\t        } else {\n311\t          const meals = doc.meals || [];\n312\t          const idx = meals.findIndex((m: any) => m.mealId === mealSnapshot.mealId);\n313\t          if (idx >= 0) {\n314\t            meals[idx] = mealSnapshot;\n315\t          } else {\n316\t            meals.push(mealSnapshot);\n317\t          }\n318\t          doc.meals = meals;\n319\t          doc.updatedAt = now;\n320\t        }\n321\t\n322\t        this.mealHistory.set(docKey, doc);\n323\t        this.persist();\n324\t        return { success: true, docId: docKey, meal: mealSnapshot };\n325\t      }\n326\t\n327\t      case 'getHistory': {\n328\t        const { familyId, limitDays = 60 } = data;\n329\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n330\t\n331\t        const allMeals: any[] = [];\n332\t        for (const [key, doc] of this.mealHistory.entries()) {\n333\t          if (doc.familyId === familyId) {\n334\t            for (const m of (doc.meals || [])) {\n335\t              allMeals.push({\n336\t                id: m.mealId,\n337\t                menuId: m.mealId,\n338\t                mealId: m.mealId,\n339\t                date: doc.date,\n340\t                timestamp: m.timestamp,\n341\t                mode: m.mode,\n342\t                mealType: m.mealType,\n343\t                dishIds: m.dishIds,\n344\t                dishNames: m.dishNames,\n345\t                dishes: m.dishes,\n346\t                confirmedBy: m.confirmedBy,\n347\t                confirmedByName: m.confirmedByName,\n348\t                familyId: doc.familyId,\n349\t                syncStatus: 'synced'\n350\t              });\n351\t            }\n352\t          }\n353\t        }\n354\t\n355\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n356\t        return { success: true, records: allMeals.slice(0, limitDays * 3) };\n357\t      }\n358\t\n359\t      default:\n360\t        return { success: false, error: `不支持的操作类型: ${action}` };\n361\t    }\n362\t  }\n363\t\n364\t  public handleCustomDish(data: any): any {\n365\t    const { action = 'addDish' } = data;\n366\t    const openid = data?.mockOpenid || 'mock_openid_default';\n367\t    const now = Date.now();\n368\t\n369\t    switch (action) {\n370\t      case 'addDish': {\n371\t        const name = String(data.name || '').trim();\n372\t        if (!name) return { success: false, error: '菜品名称不能为空' };\n373\t        if (name.length > 20) return { success: false, error: '菜品名称不能超过20个字' };\n374\t\n375\t        // 模拟敏感词检测 (易错点 7 防御)\n376\t        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄'];\n377\t        if (sensitiveWords.some(w => name.includes(w))) {\n378\t          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n379\t        }\n380\t\n381\t        const familyId = data.familyId || 'personal';\n382\t        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n383\t        const category = data.category || 'secondary_meat';\n384\t\n385\t        const newDish = {\n386\t          _id: dishId,\n387\t          id: dishId,\n388\t          familyId,\n389\t          creatorOpenid: openid,\n390\t          creatorName: data.creatorName || data.nickName || '家人',\n391\t          name,\n392\t          category,\n393\t          taste: Array.isArray(data.taste) ? data.taste : ['家常'],\n394\t          cookingTimeMinutes: Number(data.cookingTimeMinutes) || 25,\n395\t          ingredients: Array.isArray(data.ingredients) ? data.ingredients : [],\n396\t          enabled: true,\n397\t          isCustom: true,\n398\t          createdAt: now\n399\t        };\n400\t\n401\t        const list = this.customDishes.get(familyId) || [];\n402\t        list.unshift(newDish);\n403\t        this.customDishes.set(familyId, list);\n404\t        this.persist();\n405\t\n406\t        return { success: true, dish: newDish };\n407\t      }\n408\t\n409\t      case 'getDishes': {\n410\t        const { familyId } = data;\n411\t        const list = this.customDishes.get(familyId || 'personal') || [];\n412\t        return { success: true, dishes: list };\n413\t      }\n414\t\n415\t      default:\n416\t        return { success: false, error: `不支持的操作类型: ${action}` };\n417\t    }\n418\t  }\n419\t}\n420\t\n421\texport class CloudService {\n422\t  private mockDb = new LocalCloudMockDatabase();\n423\t  private isCloudAvailable: boolean | null = null;\n424\t\n425\t  public getMockDb() {\n426\t    return this.mockDb;\n427\t  }\n428\t\n429\t  /**\n430\t   * 判断当前微信环境是否真正支持并开通了云开发\n431\t   */\n432\t  private checkCloudAvailability(): boolean {\n433\t    if (this.isCloudAvailable !== null) return this.isCloudAvailable;\n434\t    if (typeof wx !== 'undefined' && wx.cloud && typeof wx.cloud.callFunction === 'function') {\n435\t      this.isCloudAvailable = true;\n436\t    } else {\n437\t      this.isCloudAvailable = false;\n438\t    }\n439\t    return this.isCloudAvailable;\n440\t  }\n441\t\n442\t  /**\n443\t   * 统一云函数调用方法 (双轨容灾：云端优先，异常或无云环境时自动降级到 Local Mock)\n444\t   */\n445\t  public async callFunction<T = any>(name: string, data: any = {}): Promise<CloudResponse<T>> {\n446\t    const hasCloud = this.checkCloudAvailability();\n447\t\n448\t    if (hasCloud) {\n449\t      try {\n450\t        const res = await wx.cloud.callFunction({\n451\t          name,\n452\t          data\n453\t        });\n454\t        if (res && res.result) {\n455\t          return res.result as CloudResponse<T>;\n456\t        }\n457\t      } catch (err: any) {\n458\t        console.warn(`[CloudService] 云函数 ${name} 线上调用失败，降级本地状态机:`, err?.message || err);\n459\t      }\n460\t    }\n461\t\n462\t    // 本地仿真降级处理\n463\t    return this.invokeLocalMock(name, data);\n464\t  }\n465\t\n466\t  /**\n467\t   * 本地 Mock 逻辑分发\n468\t   */\n469\t  private invokeLocalMock(name: string, data: any): CloudResponse<any> {\n470\t    switch (name) {\n471\t      case 'userAuth':\n472\t        return this.mockDb.handleUserAuth(data);\n473\t      case 'familyManage':\n474\t        return this.mockDb.handleFamilyManage(data);\n475\t      case 'upsertMeal':\n476\t        return this.mockDb.handleUpsertMeal(data);\n477\t      case 'customDish':\n478\t        return this.mockDb.handleCustomDish(data);\n479\t      default:\n480\t        return { success: false, error: `未知云函数: ${name}` };\n481\t    }\n482\t  }\n483\t}\n484\t\n485\texport const cloudService = new CloudService();\n486\t"}]},"parent_tool_use_id":null,"session_id":"dcb23375-9639-4e07-812d-47e9f86cdae9","uuid":"a02eb789-31b9-4a12-882a-8f1b3c64a9b1","timestamp":"2026-10-02T12:46:36.046Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/cloudService.ts","content":"/**\n * 微信云开发服务网关 (CloudService)\n * 职责：\n * 1. 统一封装 wx.cloud.callFunction 调用\n * 2. 在离线环境、本地单测与弱网环境下，提供高保真本地 Mock 状态机仿真\n * 3. 严格保障 4 人上限、24小时邀请码、一人一家庭排他与同日多餐写入\n */\n\nimport type { FamilySpace, UserProfile, SingleMealItem, CustomDishRecord } from '../types/family.js';\n\ninterface CloudResponse<T = any> {\n  success: boolean;\n  result?: T;\n  error?: string;\n  [key: string]: any;\n}\n\nclass LocalCloudMockDatabase {\n  private users = new Map<string, any>();\n  private families = new Map<string, any>();\n  private mealHistory = new Map<string, any>(); // key: meal_${familyId}_${date}\n  private customDishes = new Map<string, any[]>(); // key: familyId -> dish[]\n\n  constructor() {\n    this.restoreFromStorage();\n  }\n\n  private restoreFromStorage() {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const storedUsers = wx.getStorageSync('mock_db_users');\n        if (storedUsers) this.users = new Map(Object.entries(storedUsers));\n\n        const storedFamilies = wx.getStorageSync('mock_db_families');\n        if (storedFamilies) this.families = new Map(Object.entries(storedFamilies));\n\n        const storedHistory = wx.getStorageSync('mock_db_history');\n        if (storedHistory) this.mealHistory = new Map(Object.entries(storedHistory));\n\n        const storedDishes = wx.getStorageSync('mock_db_custom_dishes');\n        if (storedDishes) this.customDishes = new Map(Object.entries(storedDishes));\n      }\n    } catch (e) {}\n  }\n\n  private persist() {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync('mock_db_users', Object.fromEntries(this.users));\n        wx.setStorageSync('mock_db_families', Object.fromEntries(this.families));\n        wx.setStorageSync('mock_db_history', Object.fromEntries(this.mealHistory));\n        wx.setStorageSync('mock_db_custom_dishes', Object.fromEntries(this.customDishes));\n      }\n    } catch (e) {}\n  }\n\n  public clearAll() {\n    this.users.clear();\n    this.families.clear();\n    this.mealHistory.clear();\n    this.customDishes.clear();\n    this.persist();\n  }\n\n  public handleUserAuth(data: any): any {\n    const openid = data?.mockOpenid || 'mock_openid_default';\n    const now = Date.now();\n    let user = this.users.get(`user_${openid}`);\n\n    if (!user) {\n      user = {\n        _id: `user_${openid}`,\n        _openid: openid,\n        nickName: data?.nickName || '家人',\n        avatarUrl: data?.avatarUrl || '',\n        familyId: null,\n        role: null,\n        createdAt: now,\n        updatedAt: now\n      };\n      this.users.set(`user_${openid}`, user);\n    } else {\n      if (data?.nickName) user.nickName = data.nickName;\n      if (data?.avatarUrl) user.avatarUrl = data.avatarUrl;\n      user.updatedAt = now;\n    }\n\n    let family = null;\n    if (user.familyId) {\n      family = this.families.get(user.familyId) || null;\n      if (!family) {\n        user.familyId = null;\n        user.role = null;\n      }\n    }\n\n    this.persist();\n    return { success: true, openid, user, family };\n  }\n\n  public handleFamilyManage(data: any): any {\n    const { action } = data;\n    const openid = data?.mockOpenid || 'mock_openid_default';\n    const now = Date.now();\n\n    switch (action) {\n      case 'createFamily': {\n        const familyName = (data.name || '温馨小家食堂').trim().slice(0, 15);\n        let user = this.users.get(`user_${openid}`) || {\n          _id: `user_${openid}`,\n          _openid: openid,\n          nickName: data.nickName || '房主',\n          familyId: null\n        };\n\n        // 如果用户在旧家庭中，先退出\n        if (user.familyId && this.families.has(user.familyId)) {\n          this.leaveFamilyInternal(openid, user.familyId);\n        }\n\n        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const inviteCode = String(Math.floor(100000 + Math.random() * 900000));\n        const inviteExpiredAt = now + 24 * 60 * 60 * 1000;\n\n        const newFamily: FamilySpace = {\n          id: familyId,\n          name: familyName,\n          creatorOpenid: openid,\n          members: [\n            {\n              openid,\n              nickName: data.nickName || user.nickName || '房主',\n              avatarUrl: data.avatarUrl || user.avatarUrl || '',\n              role: 'creator',\n              joinedAt: now\n            }\n          ],\n          memberOpenids: [openid],\n          inviteCode,\n          inviteExpiredAt,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        this.families.set(familyId, newFamily);\n        user.familyId = familyId;\n        user.role = 'creator';\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n\n        this.persist();\n        return { success: true, family: newFamily };\n      }\n\n      case 'joinFamily': {\n        const inviteCode = String(data.inviteCode || '').trim();\n        if (!inviteCode || inviteCode.length !== 6) {\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        let targetFamily: FamilySpace | null = null;\n        for (const fam of this.families.values()) {\n          if (fam.inviteCode === inviteCode) {\n            targetFamily = fam;\n            break;\n          }\n        }\n\n        if (!targetFamily) {\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        if (now > targetFamily.inviteExpiredAt) {\n          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n        }\n\n        if (targetFamily.memberOpenids.includes(openid)) {\n          return { success: true, family: targetFamily, message: '您已经在该家庭厨房中' };\n        }\n\n        // 严格 4 人限制 (易错点 2 防御)\n        if (targetFamily.memberOpenids.length >= 4) {\n          return { success: false, error: '该家庭厨房成员已满（上限4人），无法继续加入' };\n        }\n\n        // 一人一家庭排他 (易错点 3 防御)\n        let user = this.users.get(`user_${openid}`) || {\n          _id: `user_${openid}`,\n          _openid: openid,\n          nickName: data.nickName || '家人',\n          familyId: null\n        };\n        if (user.familyId && user.familyId !== targetFamily.id && this.families.has(user.familyId)) {\n          this.leaveFamilyInternal(openid, user.familyId);\n        }\n\n        const newMember = {\n          openid,\n          nickName: data.nickName || user.nickName || '家人',\n          avatarUrl: data.avatarUrl || user.avatarUrl || '',\n          role: 'member' as const,\n          joinedAt: now\n        };\n\n        targetFamily.members.push(newMember);\n        targetFamily.memberOpenids.push(openid);\n        targetFamily.updatedAt = now;\n\n        user.familyId = targetFamily.id;\n        user.role = 'member';\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n\n        this.persist();\n        return { success: true, family: targetFamily };\n      }\n\n      case 'leaveFamily': {\n        let user = this.users.get(`user_${openid}`);\n        if (!user || !user.familyId) {\n          return { success: true, message: '当前未加入任何家庭' };\n        }\n        this.leaveFamilyInternal(openid, user.familyId);\n        user.familyId = null;\n        user.role = null;\n        user.updatedAt = now;\n        this.users.set(`user_${openid}`, user);\n        this.persist();\n        return { success: true, message: '已退出家庭厨房空间' };\n      }\n\n      case 'refreshInviteCode': {\n        const { familyId } = data;\n        const family = this.families.get(familyId);\n        if (!family) return { success: false, error: '家庭不存在' };\n\n        const newCode = String(Math.floor(100000 + Math.random() * 900000));\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n        family.inviteCode = newCode;\n        family.inviteExpiredAt = newExpiry;\n        family.updatedAt = now;\n\n        this.persist();\n        return { success: true, inviteCode: newCode, inviteExpiredAt: newExpiry };\n      }\n\n      case 'getFamily': {\n        const { familyId } = data;\n        const family = this.families.get(familyId);\n        if (!family) return { success: false, error: '家庭不存在' };\n        return { success: true, family };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n\n  private leaveFamilyInternal(openid: string, familyId: string) {\n    const family = this.families.get(familyId);\n    if (!family) return;\n    family.members = family.members.filter(m => m.openid !== openid);\n    family.memberOpenids = family.memberOpenids.filter(id => id !== openid);\n    if (family.members.length === 0) {\n      this.families.delete(familyId);\n    } else {\n      if (family.creatorOpenid === openid) {\n        family.creatorOpenid = family.members[0].openid;\n        family.members[0].role = 'creator';\n      }\n      family.updatedAt = Date.now();\n    }\n  }\n\n  public handleUpsertMeal(data: any): any {\n    const { action = 'upsertMeal' } = data;\n    const openid = data?.mockOpenid || 'mock_openid_default';\n    const now = Date.now();\n\n    switch (action) {\n      case 'upsertMeal': {\n        const { familyId, date, meal } = data;\n        if (!familyId || !date || !meal) {\n          return { success: false, error: '缺少参数 familyId/date/meal' };\n        }\n\n        const docKey = `meal_${familyId}_${date}`;\n        let doc = this.mealHistory.get(docKey);\n\n        const mealSnapshot: SingleMealItem = {\n          mealId: meal.mealId || `m_${now}`,\n          mealType: meal.mealType || '午餐',\n          mode: meal.mode || 'hearty_3_1',\n          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n          confirmedBy: openid,\n          confirmedByName: meal.confirmedByName || data.nickName || '家人',\n          timestamp: meal.timestamp || now\n        };\n\n        if (!doc) {\n          doc = {\n            _id: docKey,\n            familyId,\n            date,\n            meals: [mealSnapshot],\n            updatedAt: now\n          };\n        } else {\n          const meals = doc.meals || [];\n          const idx = meals.findIndex((m: any) => m.mealId === mealSnapshot.mealId);\n          if (idx >= 0) {\n            meals[idx] = mealSnapshot;\n          } else {\n            meals.push(mealSnapshot);\n          }\n          doc.meals = meals;\n          doc.updatedAt = now;\n        }\n\n        this.mealHistory.set(docKey, doc);\n        this.persist();\n        return { success: true, docId: docKey, meal: mealSnapshot };\n      }\n\n      case 'getHistory': {\n        const { familyId, limitDays = 60 } = data;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const allMeals: any[] = [];\n        for (const [key, doc] of this.mealHistory.entries()) {\n          if (doc.familyId === familyId) {\n            for (const m of (doc.meals || [])) {\n              allMeals.push({\n                id: m.mealId,\n                menuId: m.mealId,\n                mealId: m.mealId,\n                date: doc.date,\n                timestamp: m.timestamp,\n                mode: m.mode,\n                mealType: m.mealType,\n                dishIds: m.dishIds,\n                dishNames: m.dishNames,\n                dishes: m.dishes,\n                confirmedBy: m.confirmedBy,\n                confirmedByName: m.confirmedByName,\n                familyId: doc.familyId,\n                syncStatus: 'synced'\n              });\n            }\n          }\n        }\n\n        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n        return { success: true, records: allMeals.slice(0, limitDays * 3) };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n\n  public handleCustomDish(data: any): any {\n    const { action = 'addDish' } = data;\n    const openid = data?.mockOpenid || 'mock_openid_default';\n    const now = Date.now();\n\n    switch (action) {\n      case 'addDish': {\n        const name = String(data.name || '').trim();\n        if (!name) return { success: false, error: '菜品名称不能为空' };\n        if (name.length > 20) return { success: false, error: '菜品名称不能超过20个字' };\n\n        // 模拟敏感词检测 (易错点 7 防御)\n        const sensitiveWords = ['违禁', '敏感', '广告', '赌博', '涉黄'];\n        if (sensitiveWords.some(w => name.includes(w))) {\n          return { success: false, error: '菜品名称包含敏感内容，请修改' };\n        }\n\n        const familyId = data.familyId || 'personal';\n        const dishId = `custom_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const category = data.category || 'secondary_meat';\n\n        const newDish = {\n          _id: dishId,\n          id: dishId,\n          familyId,\n          creatorOpenid: openid,\n          creatorName: data.creatorName || data.nickName || '家人',\n          name,\n          category,\n          taste: Array.isArray(data.taste) ? data.taste : ['家常'],\n          cookingTimeMinutes: Number(data.cookingTimeMinutes) || 25,\n          ingredients: Array.isArray(data.ingredients) ? data.ingredients : [],\n          enabled: true,\n          isCustom: true,\n          createdAt: now\n        };\n\n        const list = this.customDishes.get(familyId) || [];\n        list.unshift(newDish);\n        this.customDishes.set(familyId, list);\n        this.persist();\n\n        return { success: true, dish: newDish };\n      }\n\n      case 'getDishes': {\n        const { familyId } = data;\n        const list = this.customDishes.get(familyId || 'personal') || [];\n        return { success: true, dishes: list };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  }\n}\n\nexport class CloudService {\n  private mockDb = new LocalCloudMockDatabase();\n  private isCloudAvailable: boolean | null = null;\n\n  public getMockDb() {\n    return this.mockDb;\n  }\n\n  /**\n   * 判断当前微信环境是否真正支持并开通了云开发\n   */\n  private checkCloudAvailability(): boolean {\n    if (this.isCloudAvailable !== null) return this.isCloudAvailable;\n    if (typeof wx !== 'undefined' && wx.cloud && typeof wx.cloud.callFunction === 'function') {\n      this.isCloudAvailable = true;\n    } else {\n      this.isCloudAvailable = false;\n    }\n    return this.isCloudAvailable;\n  }\n\n  /**\n   * 统一云函数调用方法 (双轨容灾：云端优先，异常或无云环境时自动降级到 Local Mock)\n   */\n  public async callFunction<T = any>(name: string, data: any = {}): Promise<CloudResponse<T>> {\n    const hasCloud = this.checkCloudAvailability();\n\n    if (hasCloud) {\n      try {\n        const res = await wx.cloud.callFunction({\n          name,\n          data\n        });\n        if (res && res.result) {\n          return res.result as CloudResponse<T>;\n        }\n      } catch (err: any) {\n        console.warn(`[CloudService] 云函数 ${name} 线上调用失败，降级本地状态机:`, err?.message || err);\n      }\n    }\n\n    // 本地仿真降级处理\n    return this.invokeLocalMock(name, data);\n  }\n\n  /**\n   * 本地 Mock 逻辑分发\n   */\n  private invokeLocalMock(name: string, data: any): CloudResponse<any> {\n    switch (name) {\n      case 'userAuth':\n        return this.mockDb.handleUserAuth(data);\n      case 'familyManage':\n        return this.mockDb.handleFamilyManage(data);\n      case 'upsertMeal':\n        return this.mockDb.handleUpsertMeal(data);\n      case 'customDish':\n        return this.mockDb.handleCustomDish(data);\n      default:\n        return { success: false, error: `未知云函数: ${name}` };\n    }\n  }\n}\n\nexport const cloudService = new CloudService();\n","numLines":486,"startLine":1,"totalLines":486}}}
