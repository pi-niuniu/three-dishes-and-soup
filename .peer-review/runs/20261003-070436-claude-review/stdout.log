{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B8VGWNFx9AsAZmtAG4HTBf","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\tconst _ = db.command;\n9\t\n10\texports.main = async (event, context) => {\n11\t  const wxContext = cloud.getWXContext();\n12\t  let openid = wxContext && wxContext.OPENID;\n13\t\n14\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n15\t  if (!openid) {\n16\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n17\t      openid = event.mockOpenid || 'mock_openid_default';\n18\t    } else {\n19\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n20\t    }\n21\t  }\n22\t\n23\t  const { action = 'upsertMeal' } = event;\n24\t  const now = Date.now();\n25\t\n26\t  try {\n27\t    switch (action) {\n28\t      /**\n29\t       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n30\t       * 彻底杜绝同日多次做菜被覆盖问题\n31\t       */\n32\t      case 'upsertMeal': {\n33\t        const { familyId, date, meal } = event;\n34\t        if (!familyId || !date || !meal) {\n35\t          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n36\t        }\n37\t\n38\t        // 服务端鉴权：验证 openid 确实属于该家庭\n39\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n40\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n41\t          return { success: false, error: '越权操作：您不属于该家庭空间' };\n42\t        }\n43\t\n44\t        const docId = `meal_${familyId}_${date}`;\n45\t\n46\t        // 服务端已核验昵称：优先从 family.members 取真实成员昵称，杜绝客户端伪造\n47\t        const verifiedMember = (famDoc.data.members || []).find(m => m.openid === openid);\n48\t        const verifiedNickName = (verifiedMember && verifiedMember.nickName && verifiedMember.nickName.trim())\n49\t          ? verifiedMember.nickName.trim()\n50\t          : (meal.confirmedByName || event.nickName || '家人');\n51\t\n52\t        // 规范化单餐快照数据\n53\t        const mealSnapshot = {\n54\t          mealId: meal.mealId || `m_${now}`,\n55\t          mealType: meal.mealType || '午餐',\n56\t          mode: meal.mode || 'hearty_3_1',\n57\t          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n58\t          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n59\t          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n60\t          confirmedBy: openid,\n61\t          confirmedByName: verifiedNickName,\n62\t          timestamp: meal.timestamp || now\n63\t        };\n64\t\n65\t        return await db.runTransaction(async transaction => {\n66\t          const docRef = transaction.collection('meal_history').doc(docId);\n67\t          const existingDoc = await docRef.get().catch(() => null);\n68\t\n69\t          if (!existingDoc || !existingDoc.data) {\n70\t            // 该日首次开饭，创建日文档 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n71\t            await docRef.set({\n72\t              data: {\n73\t                familyId,\n74\t                date,\n75\t                meals: [mealSnapshot],\n76\t                updatedAt: now\n77\t              }\n78\t            });\n79\t          } else {\n80\t            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n81\t            const existingMeals = existingDoc.data.meals || [];\n82\t            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n83\t\n84\t            let updatedMeals;\n85\t            if (mealIndex >= 0) {\n86\t              // 同一餐次就地更新 (如反复确认)\n87\t              updatedMeals = [...existingMeals];\n88\t              updatedMeals[mealIndex] = mealSnapshot;\n89\t            } else {\n90\t              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n91\t              updatedMeals = [...existingMeals, mealSnapshot];\n92\t            }\n93\t\n94\t            await docRef.update({\n95\t              data: {\n96\t                meals: updatedMeals,\n97\t                updatedAt: now\n98\t              }\n99\t            });\n100\t          }\n101\t\n102\t          return {\n103\t            success: true,\n104\t            docId,\n105\t            meal: mealSnapshot\n106\t          };\n107\t        });\n108\t      }\n109\t\n110\t      /**\n111\t       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n112\t       */\n113\t      case 'getHistory': {\n114\t        const { familyId, limitDays = 60 } = event;\n115\t        if (!familyId) {\n116\t          return { success: false, error: '缺少 familyId' };\n117\t        }\n118\t\n119\t        // 服务端鉴权：验证 openid 确实属于该家庭\n120\t        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n121\t        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n122\t          return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n123\t        }\n124\t\n125\t        // 查询该家庭最近的日文档\n126\t        const res = await db.collection('meal_history')\n127\t          .where({ familyId })\n128\t          .orderBy('date', 'desc')\n129\t          .limit(limitDays)\n130\t          .get();\n131\t\n132\t        const docs = res.data || [];\n133\t        // 展平为有序餐次列表供客户端秒级合并\n134\t        const allMeals = [];\n135\t        for (const doc of docs) {\n136\t          for (const m of (doc.meals || [])) {\n137\t            allMeals.push({\n138\t              id: m.mealId,\n139\t              menuId: m.mealId,\n140\t              mealId: m.mealId,\n141\t              date: doc.date,\n142\t              timestamp: m.timestamp,\n143\t              mode: m.mode,\n144\t              mealType: m.mealType,\n145\t              dishIds: m.dishIds,\n146\t              dishNames: m.dishNames,\n147\t              dishes: m.dishes,\n148\t              confirmedBy: m.confirmedBy,\n149\t              confirmedByName: m.confirmedByName,\n150\t              familyId: doc.familyId,\n151\t              syncStatus: 'synced'\n152\t            });\n153\t          }\n154\t        }\n155\t\n156\t        // 按时间戳倒序排列\n157\t        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n158\t\n159\t        return {\n160\t          success: true,\n161\t          records: allMeals,\n162\t          docs\n163\t        };\n164\t      }\n165\t\n166\t      default:\n167\t        return { success: false, error: `不支持的操作类型: ${action}` };\n168\t    }\n169\t  } catch (err) {\n170\t    return {\n171\t      success: false,\n172\t      error: err.message || '历史记录同步失败'\n173\t    };\n174\t  }\n175\t};\n176\t"}]},"parent_tool_use_id":null,"session_id":"0c1182a9-4dae-4f8c-a8ee-a60a88fe0888","uuid":"a56f4cd5-c03c-471f-a641-bd16d1877377","timestamp":"2026-10-02T23:04:45.949Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/upsertMeal/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action = 'upsertMeal' } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 原子追加或就地更新单餐做菜记录 (主键: meal_${familyId}_${date})\n       * 彻底杜绝同日多次做菜被覆盖问题\n       */\n      case 'upsertMeal': {\n        const { familyId, date, meal } = event;\n        if (!familyId || !date || !meal) {\n          return { success: false, error: '缺少必要参数: familyId, date, meal' };\n        }\n\n        // 服务端鉴权：验证 openid 确实属于该家庭\n        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n          return { success: false, error: '越权操作：您不属于该家庭空间' };\n        }\n\n        const docId = `meal_${familyId}_${date}`;\n\n        // 服务端已核验昵称：优先从 family.members 取真实成员昵称，杜绝客户端伪造\n        const verifiedMember = (famDoc.data.members || []).find(m => m.openid === openid);\n        const verifiedNickName = (verifiedMember && verifiedMember.nickName && verifiedMember.nickName.trim())\n          ? verifiedMember.nickName.trim()\n          : (meal.confirmedByName || event.nickName || '家人');\n\n        // 规范化单餐快照数据\n        const mealSnapshot = {\n          mealId: meal.mealId || `m_${now}`,\n          mealType: meal.mealType || '午餐',\n          mode: meal.mode || 'hearty_3_1',\n          dishes: Array.isArray(meal.dishes) ? meal.dishes : [],\n          dishIds: Array.isArray(meal.dishIds) ? meal.dishIds : [],\n          dishNames: Array.isArray(meal.dishNames) ? meal.dishNames : [],\n          confirmedBy: openid,\n          confirmedByName: verifiedNickName,\n          timestamp: meal.timestamp || now\n        };\n\n        return await db.runTransaction(async transaction => {\n          const docRef = transaction.collection('meal_history').doc(docId);\n          const existingDoc = await docRef.get().catch(() => null);\n\n          if (!existingDoc || !existingDoc.data) {\n            // 该日首次开饭，创建日文档 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n            await docRef.set({\n              data: {\n                familyId,\n                date,\n                meals: [mealSnapshot],\n                updatedAt: now\n              }\n            });\n          } else {\n            // 该日已有开饭记录，比对 mealId 决定是追加还是更新\n            const existingMeals = existingDoc.data.meals || [];\n            const mealIndex = existingMeals.findIndex(m => m.mealId === mealSnapshot.mealId);\n\n            let updatedMeals;\n            if (mealIndex >= 0) {\n              // 同一餐次就地更新 (如反复确认)\n              updatedMeals = [...existingMeals];\n              updatedMeals[mealIndex] = mealSnapshot;\n            } else {\n              // 新餐次 (如晚上做了清蒸鲈鱼，中午做了番茄牛腩)，原子追加\n              updatedMeals = [...existingMeals, mealSnapshot];\n            }\n\n            await docRef.update({\n              data: {\n                meals: updatedMeals,\n                updatedAt: now\n              }\n            });\n          }\n\n          return {\n            success: true,\n            docId,\n            meal: mealSnapshot\n          };\n        });\n      }\n\n      /**\n       * 2. 拉取家庭共享历史数据 (按最近 60 天)\n       */\n      case 'getHistory': {\n        const { familyId, limitDays = 60 } = event;\n        if (!familyId) {\n          return { success: false, error: '缺少 familyId' };\n        }\n\n        // 服务端鉴权：验证 openid 确实属于该家庭\n        const famDoc = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famDoc || !famDoc.data || !(famDoc.data.memberOpenids || []).includes(openid)) {\n          return { success: false, error: '越权操作：无权查看非本人所属家庭的就餐历史' };\n        }\n\n        // 查询该家庭最近的日文档\n        const res = await db.collection('meal_history')\n          .where({ familyId })\n          .orderBy('date', 'desc')\n          .limit(limitDays)\n          .get();\n\n        const docs = res.data || [];\n        // 展平为有序餐次列表供客户端秒级合并\n        const allMeals = [];\n        for (const doc of docs) {\n          for (const m of (doc.meals || [])) {\n            allMeals.push({\n              id: m.mealId,\n              menuId: m.mealId,\n              mealId: m.mealId,\n              date: doc.date,\n              timestamp: m.timestamp,\n              mode: m.mode,\n              mealType: m.mealType,\n              dishIds: m.dishIds,\n              dishNames: m.dishNames,\n              dishes: m.dishes,\n              confirmedBy: m.confirmedBy,\n              confirmedByName: m.confirmedByName,\n              familyId: doc.familyId,\n              syncStatus: 'synced'\n            });\n          }\n        }\n\n        // 按时间戳倒序排列\n        allMeals.sort((a, b) => b.timestamp - a.timestamp);\n\n        return {\n          success: true,\n          records: allMeals,\n          docs\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '历史记录同步失败'\n    };\n  }\n};\n","numLines":176,"startLine":1,"totalLines":176}}}
