{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RCBLZtsnPGgSp438jhZF8n","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\tconst _ = db.command;\n9\t\n10\tconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n11\t\n12\t/**\n13\t * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n14\t */\n15\tasync function checkTextSecurity(text, openid) {\n16\t  if (!text) return { pass: true };\n17\t  const str = String(text).trim();\n18\t  if (!str) return { pass: true };\n19\t\n20\t  // 1. 本地兜底敏感词拦截\n21\t  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n22\t    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n23\t  }\n24\t\n25\t  // 2. 微信官方 msgSecCheck 2.0 规范检测\n26\t  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n27\t    try {\n28\t      const res = await cloud.openapi.security.msgSecCheck({\n29\t        version: 2,\n30\t        scene: 1, // 1: 资料/昵称/家庭名称等\n31\t        openid,\n32\t        content: str\n33\t      });\n34\t      if (!res || !res.result || res.result.suggest !== 'pass') {\n35\t        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n36\t      }\n37\t    } catch (err) {\n38\t      console.error('[familyManage] msgSecCheck 异常:', err);\n39\t      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n40\t    }\n41\t  }\n42\t\n43\t  return { pass: true };\n44\t}\n45\t\n46\t/**\n47\t * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n48\t */\n49\tasync function generateUniqueInviteCode() {\n50\t  const now = Date.now();\n51\t  for (let attempt = 0; attempt < 10; attempt++) {\n52\t    const code = String(Math.floor(100000 + Math.random() * 900000));\n53\t    const existing = await db.collection('families').where({\n54\t      inviteCode: code,\n55\t      inviteExpiredAt: _.gt(now)\n56\t    }).count().catch(() => null);\n57\t\n58\t    if (!existing || existing.total === 0) {\n59\t      return code;\n60\t    }\n61\t  }\n62\t  return String(Math.floor(100000 + Math.random() * 900000));\n63\t}\n64\t\n65\tconst JOIN_RATE_LIMIT = {\n66\t  MAX_FAILURES: 5,\n67\t  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n68\t};\n69\t\n70\t/**\n71\t * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n72\t */\n73\tasync function checkJoinRateLimit(openid, now) {\n74\t  try {\n75\t    const userDoc = await db.collection('users').doc(`user_${openid}`).get().catch(() => null);\n76\t    const data = userDoc?.data;\n77\t    if (!data) return { allowed: true };\n78\t\n79\t    const failCount = data.joinFailCount || 0;\n80\t    const lastFailTime = data.joinFailLastTime || 0;\n81\t\n82\t    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n83\t      return { allowed: true };\n84\t    }\n85\t\n86\t    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n87\t      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n88\t      return {\n89\t        allowed: false,\n90\t        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n91\t      };\n92\t    }\n93\t  } catch (err) {\n94\t    console.warn('[familyManage] 检查防刷限频异常:', err);\n95\t  }\n96\t  return { allowed: true };\n97\t}\n98\t\n99\t/**\n100\t * 记录一次加入失败尝试 (按 openid 累加失败计数并更新时间戳)\n101\t */\n102\tasync function recordJoinFailure(openid, now) {\n103\t  try {\n104\t    const userDocRef = db.collection('users').doc(`user_${openid}`);\n105\t    const userRes = await userDocRef.get().catch(() => null);\n106\t    const data = userRes?.data;\n107\t    const lastFailTime = data?.joinFailLastTime || 0;\n108\t    const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n109\t    const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n110\t\n111\t    if (userRes && userRes.data) {\n112\t      await userDocRef.update({\n113\t        data: {\n114\t          joinFailCount: newCount,\n115\t          joinFailLastTime: now\n116\t        }\n117\t      }).catch(async () => {\n118\t        const cleanData = { ...(data || {}) };\n119\t        delete cleanData._id;\n120\t        await userDocRef.set({\n121\t          data: {\n122\t            ...cleanData,\n123\t            joinFailCount: newCount,\n124\t            joinFailLastTime: now\n125\t          }\n126\t        }).catch(() => {});\n127\t      });\n128\t    } else {\n129\t      await userDocRef.set({\n130\t        data: {\n131\t          _openid: openid,\n132\t          joinFailCount: newCount,\n133\t          joinFailLastTime: now\n134\t        }\n135\t      }).catch(() => {});\n136\t    }\n137\t  } catch (err) {\n138\t    console.warn('[familyManage] 记录加入失败计数异常:', err);\n139\t  }\n140\t}\n141\t\n142\texports.main = async (event, context) => {\n143\t  const wxContext = cloud.getWXContext();\n144\t  let openid = wxContext && wxContext.OPENID;\n145\t\n146\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n147\t  if (!openid) {\n148\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n149\t      openid = event.mockOpenid || 'mock_openid_default';\n150\t    } else {\n151\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n152\t    }\n153\t  }\n154\t\n155\t  const { action } = event;\n156\t  const now = Date.now();\n157\t\n158\t  try {\n159\t    switch (action) {\n160\t      /**\n161\t       * 1. 创建家庭空间\n162\t       */\n163\t      case 'createFamily': {\n164\t        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n165\t        const nickName = (event.nickName || '房主').trim();\n166\t\n167\t        // 安全合规校验：家庭名称与昵称\n168\t        const nameSec = await checkTextSecurity(familyName, openid);\n169\t        if (!nameSec.pass) return { success: false, error: nameSec.error };\n170\t\n171\t        const nickSec = await checkTextSecurity(nickName, openid);\n172\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n173\t\n174\t        const userDocRef = db.collection('users').doc(`user_${openid}`);\n175\t        \n176\t        let user;\n177\t        try {\n178\t          const uRes = await userDocRef.get();\n179\t          user = (uRes && uRes.data) ? uRes.data : null;\n180\t        } catch (e) {\n181\t          user = null;\n182\t        }\n183\t        if (!user) {\n184\t          user = { _openid: openid, nickName: nickName || '房主' };\n185\t        }\n186\t\n187\t        // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n188\t        if (user.familyId) {\n189\t          try {\n190\t            await leaveCurrentFamilyInternal(openid, user.familyId);\n191\t          } catch (e) {\n192\t            console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n193\t            throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n194\t          }\n195\t        }\n196\t\n197\t        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n198\t        const inviteCode = await generateUniqueInviteCode();\n199\t        const inviteExpiredAt = now + 24 * 60 * 60 * 1000; // 24小时过期\n200\t\n201\t        const newFamily = {\n202\t          _id: familyId,\n203\t          name: familyName,\n204\t          creatorOpenid: openid,\n205\t          members: [\n206\t            {\n207\t              openid,\n208\t              nickName: nickName || user.nickName || '房主',\n209\t              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n210\t              role: 'creator',\n211\t              joinedAt: now\n212\t            }\n213\t          ],\n214\t          memberOpenids: [openid],\n215\t          inviteCode,\n216\t          inviteExpiredAt,\n217\t          createdAt: now,\n218\t          updatedAt: now\n219\t        };\n220\t\n221\t        await db.collection('families').add({ data: newFamily });\n222\t\n223\t        // 更新用户档案 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n224\t        await db.collection('users').doc(`user_${openid}`).set({\n225\t          data: {\n226\t            _openid: openid,\n227\t            nickName: nickName || user.nickName || '房主',\n228\t            avatarUrl: event.avatarUrl || user.avatarUrl || '',\n229\t            familyId,\n230\t            role: 'creator',\n231\t            updatedAt: now\n232\t          }\n233\t        });\n234\t\n235\t        return {\n236\t          success: true,\n237\t          family: newFamily\n238\t        };\n239\t      }\n240\t\n241\t      /**\n242\t       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n243\t       */\n244\t      case 'joinFamily': {\n245\t        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n246\t        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n247\t        if (!rateLimitCheck.allowed) {\n248\t          return { success: false, error: rateLimitCheck.error };\n249\t        }\n250\t\n251\t        const inviteCode = String(event.inviteCode || '').trim();\n252\t        if (!inviteCode || inviteCode.length !== 6) {\n253\t          await recordJoinFailure(openid, now);\n254\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n255\t        }\n256\t\n257\t        const memberNickName = (event.nickName || '家人').trim();\n258\t        const nickSec = await checkTextSecurity(memberNickName, openid);\n259\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n260\t\n261\t        // 1. 查询有效且未过期的邀请码\n262\t        const queryRes = await db.collection('families').where({\n263\t          inviteCode,\n264\t          inviteExpiredAt: _.gt(now)\n265\t        }).get();\n266\t\n267\t        if (!queryRes.data || queryRes.data.length === 0) {\n268\t          await recordJoinFailure(openid, now);\n269\t          // 区分是过期还是根本不存在\n270\t          const anyRes = await db.collection('families').where({ inviteCode }).get().catch(() => null);\n271\t          if (anyRes && anyRes.data && anyRes.data.length > 0) {\n272\t            return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n273\t          }\n274\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n275\t        }\n276\t\n277\t        const targetFamilyId = queryRes.data[0]._id;\n278\t\n279\t        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n280\t        try {\n281\t          return await db.runTransaction(async transaction => {\n282\t            const famDoc = await transaction.collection('families').doc(targetFamilyId).get().catch(() => null);\n283\t            if (!famDoc || !famDoc.data) {\n284\t              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n285\t              throw new Error('未找到该邀请口令对应的家庭厨房');\n286\t            }\n287\t\n288\t            const family = famDoc.data;\n289\t\n290\t            // 校验 1: 口令是否已过期 (24 小时有效)\n291\t            if (now > family.inviteExpiredAt) {\n292\t              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n293\t              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n294\t            }\n295\t\n296\t            // 校验 2: 是否已经在该家庭中\n297\t            if (family.memberOpenids && family.memberOpenids.includes(openid)) {\n298\t              return {\n299\t                success: true,\n300\t                family,\n301\t                message: '您已经在该家庭厨房中'\n302\t              };\n303\t            }\n304\t\n305\t            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n306\t            if ((family.memberOpenids || []).length >= 4) {\n307\t              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n308\t              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n309\t            }\n310\t\n311\t            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n312\t            const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n313\t            const oldFamilyId = userDoc?.data?.familyId;\n314\t            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n315\t              const oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get().catch(() => null);\n316\t              if (oldFamDoc?.data) {\n317\t                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n318\t                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n319\t\n320\t                if (remainingMembers.length === 0) {\n321\t                  await transaction.collection('families').doc(oldFamilyId).remove();\n322\t                } else {\n323\t                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n324\t                    ? remainingMembers[0].openid\n325\t                    : oldFamDoc.data.creatorOpenid;\n326\t\n327\t                  if (oldFamDoc.data.creatorOpenid === openid) {\n328\t                    remainingMembers[0].role = 'creator';\n329\t                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n330\t                      data: { role: 'creator', updatedAt: now }\n331\t                    }).catch(() => {});\n332\t                  }\n333\t\n334\t                  await transaction.collection('families').doc(oldFamilyId).update({\n335\t                    data: {\n336\t                      creatorOpenid: newCreator,\n337\t                      members: remainingMembers,\n338\t                      memberOpenids: remainingOpenids,\n339\t                      updatedAt: now\n340\t                    }\n341\t                  });\n342\t                }\n343\t              }\n344\t            }\n345\t\n346\t            // 加入新家庭\n347\t            const newMember = {\n348\t              openid,\n349\t              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n350\t              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n351\t              role: 'member',\n352\t              joinedAt: now\n353\t            };\n354\t\n355\t            const updatedMembers = [...(family.members || []), newMember];\n356\t            const updatedOpenids = [...(family.memberOpenids || []), openid];\n357\t\n358\t            await transaction.collection('families').doc(targetFamilyId).update({\n359\t              data: {\n360\t                members: updatedMembers,\n361\t                memberOpenids: updatedOpenids,\n362\t                updatedAt: now\n363\t              }\n364\t            });\n365\t\n366\t            // 更新用户档案并重置防刷计数 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n367\t            await transaction.collection('users').doc(`user_${openid}`).set({\n368\t              data: {\n369\t                _openid: openid,\n370\t                nickName: newMember.nickName,\n371\t                avatarUrl: newMember.avatarUrl,\n372\t                familyId: targetFamilyId,\n373\t                role: 'member',\n374\t                joinFailCount: 0,\n375\t                joinFailLastTime: 0,\n376\t                updatedAt: now\n377\t              }\n378\t            });\n379\t\n380\t            return {\n381\t              success: true,\n382\t              family: {\n383\t                ...family,\n384\t                members: updatedMembers,\n385\t                memberOpenids: updatedOpenids,\n386\t                updatedAt: now\n387\t              }\n388\t            };\n389\t          });\n390\t        } catch (trxErr) {\n391\t          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n392\t          return {\n393\t            success: false,\n394\t            error: errMsg\n395\t          };\n396\t        }\n397\t      }\n398\t\n399\t      /**\n400\t       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n401\t       */\n402\t      case 'leaveFamily': {\n403\t        return await db.runTransaction(async transaction => {\n404\t          const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n405\t          const user = userDoc?.data;\n406\t\n407\t          if (!user || !user.familyId) {\n408\t            return { success: true, message: '当前未加入任何家庭' };\n409\t          }\n410\t\n411\t          const familyId = user.familyId;\n412\t          const famDoc = await transaction.collection('families').doc(familyId).get().catch(() => null);\n413\t\n414\t          if (famDoc && famDoc.data) {\n415\t            const family = famDoc.data;\n416\t            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n417\t            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n418\t\n419\t            if (remainingMembers.length === 0) {\n420\t              await transaction.collection('families').doc(familyId).remove();\n421\t            } else {\n422\t              let newCreatorOpenid = family.creatorOpenid;\n423\t              if (family.creatorOpenid === openid) {\n424\t                newCreatorOpenid = remainingMembers[0].openid;\n425\t                remainingMembers[0].role = 'creator';\n426\t                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n427\t                  data: { role: 'creator', updatedAt: now }\n428\t                }).catch(() => {});\n429\t              }\n430\t\n431\t              await transaction.collection('families').doc(familyId).update({\n432\t                data: {\n433\t                  creatorOpenid: newCreatorOpenid,\n434\t                  members: remainingMembers,\n435\t                  memberOpenids: remainingOpenids,\n436\t                  updatedAt: now\n437\t                }\n438\t              });\n439\t            }\n440\t          }\n441\t\n442\t          // 重置用户家庭归属\n443\t          await transaction.collection('users').doc(`user_${openid}`).update({\n444\t            data: {\n445\t              familyId: null,\n446\t              role: null,\n447\t              updatedAt: now\n448\t            }\n449\t          });\n450\t\n451\t          return { success: true, message: '已退出家庭厨房空间' };\n452\t        });\n453\t      }\n454\t\n455\t      /**\n456\t       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n457\t       */\n458\t      case 'refreshInviteCode': {\n459\t        const { familyId } = event;\n460\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n461\t\n462\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n463\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n464\t\n465\t        const family = famRes.data;\n466\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n467\t          return { success: false, error: '无权操作非本人所属家庭' };\n468\t        }\n469\t\n470\t        const newCode = await generateUniqueInviteCode();\n471\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n472\t\n473\t        await db.collection('families').doc(familyId).update({\n474\t          data: {\n475\t            inviteCode: newCode,\n476\t            inviteExpiredAt: newExpiry,\n477\t            updatedAt: now\n478\t          }\n479\t        });\n480\t\n481\t        return {\n482\t          success: true,\n483\t          inviteCode: newCode,\n484\t          inviteExpiredAt: newExpiry\n485\t        };\n486\t      }\n487\t\n488\t      /**\n489\t       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n490\t       */\n491\t      case 'getFamily': {\n492\t        const { familyId } = event;\n493\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n494\t\n495\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n496\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n497\t\n498\t        const family = famRes.data;\n499\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n500\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n501\t        }\n502\t\n503\t        return {\n504\t          success: true,\n505\t          family\n506\t        };\n507\t      }\n508\t\n509\t      default:\n510\t        return { success: false, error: `不支持的操作类型: ${action}` };\n511\t    }\n512\t  } catch (err) {\n513\t    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n514\t    return {\n515\t      success: false,\n516\t      error: errMsg\n517\t    };\n518\t  }\n519\t};\n520\t\n521\t// 内部事务辅助：退出或重置家庭成员\n522\tasync function leaveCurrentFamilyInternal(openid, familyId) {\n523\t  return await db.runTransaction(async transaction => {\n524\t    const famDocRef = transaction.collection('families').doc(familyId);\n525\t    const famRes = await famDocRef.get().catch(() => null);\n526\t    if (!famRes || !famRes.data) return;\n527\t\n528\t    const family = famRes.data;\n529\t    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n530\t    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n531\t\n532\t    if (remainingMembers.length === 0) {\n533\t      await famDocRef.remove();\n534\t    } else {\n535\t      let newCreatorOpenid = family.creatorOpenid;\n536\t      if (family.creatorOpenid === openid) {\n537\t        newCreatorOpenid = remainingMembers[0].openid;\n538\t        remainingMembers[0].role = 'creator';\n539\t        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n540\t          data: { role: 'creator', updatedAt: Date.now() }\n541\t        }).catch(() => {});\n542\t      }\n543\t\n544\t      await famDocRef.update({\n545\t        data: {\n546\t          creatorOpenid: newCreatorOpenid,\n547\t          members: remainingMembers,\n548\t          memberOpenids: remainingOpenids,\n549\t          updatedAt: Date.now()\n550\t        }\n551\t      });\n552\t    }\n553\t  });\n554\t}\n555\t"}]},"parent_tool_use_id":null,"session_id":"0c1182a9-4dae-4f8c-a8ee-a60a88fe0888","uuid":"8ea83754-e2cd-4f52-9558-4521f9da7c91","timestamp":"2026-10-02T23:04:46.186Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n/**\n * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n */\nasync function checkTextSecurity(text, openid) {\n  if (!text) return { pass: true };\n  const str = String(text).trim();\n  if (!str) return { pass: true };\n\n  // 1. 本地兜底敏感词拦截\n  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n  }\n\n  // 2. 微信官方 msgSecCheck 2.0 规范检测\n  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    try {\n      const res = await cloud.openapi.security.msgSecCheck({\n        version: 2,\n        scene: 1, // 1: 资料/昵称/家庭名称等\n        openid,\n        content: str\n      });\n      if (!res || !res.result || res.result.suggest !== 'pass') {\n        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n      }\n    } catch (err) {\n      console.error('[familyManage] msgSecCheck 异常:', err);\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n    }\n  }\n\n  return { pass: true };\n}\n\n/**\n * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n */\nasync function generateUniqueInviteCode() {\n  const now = Date.now();\n  for (let attempt = 0; attempt < 10; attempt++) {\n    const code = String(Math.floor(100000 + Math.random() * 900000));\n    const existing = await db.collection('families').where({\n      inviteCode: code,\n      inviteExpiredAt: _.gt(now)\n    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {\n      return code;\n    }\n  }\n  return String(Math.floor(100000 + Math.random() * 900000));\n}\n\nconst JOIN_RATE_LIMIT = {\n  MAX_FAILURES: 5,\n  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n};\n\n/**\n * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n */\nasync function checkJoinRateLimit(openid, now) {\n  try {\n    const userDoc = await db.collection('users').doc(`user_${openid}`).get().catch(() => null);\n    const data = userDoc?.data;\n    if (!data) return { allowed: true };\n\n    const failCount = data.joinFailCount || 0;\n    const lastFailTime = data.joinFailLastTime || 0;\n\n    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n      return { allowed: true };\n    }\n\n    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n      return {\n        allowed: false,\n        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n      };\n    }\n  } catch (err) {\n    console.warn('[familyManage] 检查防刷限频异常:', err);\n  }\n  return { allowed: true };\n}\n\n/**\n * 记录一次加入失败尝试 (按 openid 累加失败计数并更新时间戳)\n */\nasync function recordJoinFailure(openid, now) {\n  try {\n    const userDocRef = db.collection('users').doc(`user_${openid}`);\n    const userRes = await userDocRef.get().catch(() => null);\n    const data = userRes?.data;\n    const lastFailTime = data?.joinFailLastTime || 0;\n    const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n    const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n\n    if (userRes && userRes.data) {\n      await userDocRef.update({\n        data: {\n          joinFailCount: newCount,\n          joinFailLastTime: now\n        }\n      }).catch(async () => {\n        const cleanData = { ...(data || {}) };\n        delete cleanData._id;\n        await userDocRef.set({\n          data: {\n            ...cleanData,\n            joinFailCount: newCount,\n            joinFailLastTime: now\n          }\n        }).catch(() => {});\n      });\n    } else {\n      await userDocRef.set({\n        data: {\n          _openid: openid,\n          joinFailCount: newCount,\n          joinFailLastTime: now\n        }\n      }).catch(() => {});\n    }\n  } catch (err) {\n    console.warn('[familyManage] 记录加入失败计数异常:', err);\n  }\n}\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 创建家庭空间\n       */\n      case 'createFamily': {\n        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = (event.nickName || '房主').trim();\n\n        // 安全合规校验：家庭名称与昵称\n        const nameSec = await checkTextSecurity(familyName, openid);\n        if (!nameSec.pass) return { success: false, error: nameSec.error };\n\n        const nickSec = await checkTextSecurity(nickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        const userDocRef = db.collection('users').doc(`user_${openid}`);\n        \n        let user;\n        try {\n          const uRes = await userDocRef.get();\n          user = (uRes && uRes.data) ? uRes.data : null;\n        } catch (e) {\n          user = null;\n        }\n        if (!user) {\n          user = { _openid: openid, nickName: nickName || '房主' };\n        }\n\n        // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n        if (user.familyId) {\n          try {\n            await leaveCurrentFamilyInternal(openid, user.familyId);\n          } catch (e) {\n            console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n            throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n          }\n        }\n\n        const familyId = `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        const inviteCode = await generateUniqueInviteCode();\n        const inviteExpiredAt = now + 24 * 60 * 60 * 1000; // 24小时过期\n\n        const newFamily = {\n          _id: familyId,\n          name: familyName,\n          creatorOpenid: openid,\n          members: [\n            {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n              role: 'creator',\n              joinedAt: now\n            }\n          ],\n          memberOpenids: [openid],\n          inviteCode,\n          inviteExpiredAt,\n          createdAt: now,\n          updatedAt: now\n        };\n\n        await db.collection('families').add({ data: newFamily });\n\n        // 更新用户档案 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n        await db.collection('users').doc(`user_${openid}`).set({\n          data: {\n            _openid: openid,\n            nickName: nickName || user.nickName || '房主',\n            avatarUrl: event.avatarUrl || user.avatarUrl || '',\n            familyId,\n            role: 'creator',\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          family: newFamily\n        };\n      }\n\n      /**\n       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n       */\n      case 'joinFamily': {\n        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n        if (!rateLimitCheck.allowed) {\n          return { success: false, error: rateLimitCheck.error };\n        }\n\n        const inviteCode = String(event.inviteCode || '').trim();\n        if (!inviteCode || inviteCode.length !== 6) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const memberNickName = (event.nickName || '家人').trim();\n        const nickSec = await checkTextSecurity(memberNickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 1. 查询有效且未过期的邀请码\n        const queryRes = await db.collection('families').where({\n          inviteCode,\n          inviteExpiredAt: _.gt(now)\n        }).get();\n\n        if (!queryRes.data || queryRes.data.length === 0) {\n          await recordJoinFailure(openid, now);\n          // 区分是过期还是根本不存在\n          const anyRes = await db.collection('families').where({ inviteCode }).get().catch(() => null);\n          if (anyRes && anyRes.data && anyRes.data.length > 0) {\n            return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n          }\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        const targetFamilyId = queryRes.data[0]._id;\n\n        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n        try {\n          return await db.runTransaction(async transaction => {\n            const famDoc = await transaction.collection('families').doc(targetFamilyId).get().catch(() => null);\n            if (!famDoc || !famDoc.data) {\n              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n              throw new Error('未找到该邀请口令对应的家庭厨房');\n            }\n\n            const family = famDoc.data;\n\n            // 校验 1: 口令是否已过期 (24 小时有效)\n            if (now > family.inviteExpiredAt) {\n              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n            }\n\n            // 校验 2: 是否已经在该家庭中\n            if (family.memberOpenids && family.memberOpenids.includes(openid)) {\n              return {\n                success: true,\n                family,\n                message: '您已经在该家庭厨房中'\n              };\n            }\n\n            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n            if ((family.memberOpenids || []).length >= 4) {\n              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n            }\n\n            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n            const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n            const oldFamilyId = userDoc?.data?.familyId;\n            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n              const oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get().catch(() => null);\n              if (oldFamDoc?.data) {\n                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await transaction.collection('families').doc(oldFamilyId).remove();\n                } else {\n                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n                    ? remainingMembers[0].openid\n                    : oldFamDoc.data.creatorOpenid;\n\n                  if (oldFamDoc.data.creatorOpenid === openid) {\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await transaction.collection('families').doc(oldFamilyId).update({\n                    data: {\n                      creatorOpenid: newCreator,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            }\n\n            // 加入新家庭\n            const newMember = {\n              openid,\n              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n              role: 'member',\n              joinedAt: now\n            };\n\n            const updatedMembers = [...(family.members || []), newMember];\n            const updatedOpenids = [...(family.memberOpenids || []), openid];\n\n            await transaction.collection('families').doc(targetFamilyId).update({\n              data: {\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            });\n\n            // 更新用户档案并重置防刷计数 (剔除冗余 _id 字段，避免老版本云开发 SDK 报 cannot update _id 错误)\n            await transaction.collection('users').doc(`user_${openid}`).set({\n              data: {\n                _openid: openid,\n                nickName: newMember.nickName,\n                avatarUrl: newMember.avatarUrl,\n                familyId: targetFamilyId,\n                role: 'member',\n                joinFailCount: 0,\n                joinFailLastTime: 0,\n                updatedAt: now\n              }\n            });\n\n            return {\n              success: true,\n              family: {\n                ...family,\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            };\n          });\n        } catch (trxErr) {\n          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n          return {\n            success: false,\n            error: errMsg\n          };\n        }\n      }\n\n      /**\n       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n       */\n      case 'leaveFamily': {\n        return await db.runTransaction(async transaction => {\n          const userDoc = await transaction.collection('users').doc(`user_${openid}`).get().catch(() => null);\n          const user = userDoc?.data;\n\n          if (!user || !user.familyId) {\n            return { success: true, message: '当前未加入任何家庭' };\n          }\n\n          const familyId = user.familyId;\n          const famDoc = await transaction.collection('families').doc(familyId).get().catch(() => null);\n\n          if (famDoc && famDoc.data) {\n            const family = famDoc.data;\n            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n            if (remainingMembers.length === 0) {\n              await transaction.collection('families').doc(familyId).remove();\n            } else {\n              let newCreatorOpenid = family.creatorOpenid;\n              if (family.creatorOpenid === openid) {\n                newCreatorOpenid = remainingMembers[0].openid;\n                remainingMembers[0].role = 'creator';\n                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                  data: { role: 'creator', updatedAt: now }\n                }).catch(() => {});\n              }\n\n              await transaction.collection('families').doc(familyId).update({\n                data: {\n                  creatorOpenid: newCreatorOpenid,\n                  members: remainingMembers,\n                  memberOpenids: remainingOpenids,\n                  updatedAt: now\n                }\n              });\n            }\n          }\n\n          // 重置用户家庭归属\n          await transaction.collection('users').doc(`user_${openid}`).update({\n            data: {\n              familyId: null,\n              role: null,\n              updatedAt: now\n            }\n          });\n\n          return { success: true, message: '已退出家庭厨房空间' };\n        });\n      }\n\n      /**\n       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n       */\n      case 'refreshInviteCode': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = await generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n\n        await db.collection('families').doc(familyId).update({\n          data: {\n            inviteCode: newCode,\n            inviteExpiredAt: newExpiry,\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          inviteCode: newCode,\n          inviteExpiredAt: newExpiry\n        };\n      }\n\n      /**\n       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n       */\n      case 'getFamily': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return {\n          success: true,\n          family\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n    return {\n      success: false,\n      error: errMsg\n    };\n  }\n};\n\n// 内部事务辅助：退出或重置家庭成员\nasync function leaveCurrentFamilyInternal(openid, familyId) {\n  return await db.runTransaction(async transaction => {\n    const famDocRef = transaction.collection('families').doc(familyId);\n    const famRes = await famDocRef.get().catch(() => null);\n    if (!famRes || !famRes.data) return;\n\n    const family = famRes.data;\n    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n    if (remainingMembers.length === 0) {\n      await famDocRef.remove();\n    } else {\n      let newCreatorOpenid = family.creatorOpenid;\n      if (family.creatorOpenid === openid) {\n        newCreatorOpenid = remainingMembers[0].openid;\n        remainingMembers[0].role = 'creator';\n        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n          data: { role: 'creator', updatedAt: Date.now() }\n        }).catch(() => {});\n      }\n\n      await famDocRef.update({\n        data: {\n          creatorOpenid: newCreatorOpenid,\n          members: remainingMembers,\n          memberOpenids: remainingOpenids,\n          updatedAt: Date.now()\n        }\n      });\n    }\n  });\n}\n","numLines":555,"startLine":1,"totalLines":555}}}
