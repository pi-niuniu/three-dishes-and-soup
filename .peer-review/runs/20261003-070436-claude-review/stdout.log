{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WKd9u12Q2WuaqG4db6uPfZ","type":"tool_result","content":"1\timport type { MealHistoryRecord, MealMode } from '../types/user.js';\n2\timport type { Dish } from '../types/dish.js';\n3\timport { familyService } from './familyService.js';\n4\timport { cloudService } from './cloudService.js';\n5\t\n6\tconst STORAGE_KEY = 'meal_history_records';\n7\tconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n8\t\n9\tinterface PendingSyncItem {\n10\t  targetFamilyId: string;\n11\t  authorOpenid: string;\n12\t  record: MealHistoryRecord;\n13\t}\n14\t\n15\ttype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n16\t\n17\tclass HistoryService {\n18\t  private memoryHistory: MealHistoryRecord[] = [];\n19\t  private pendingQueue: PendingSyncItem[] = [];\n20\t  private listeners: Set<HistoryChangeListener> = new Set();\n21\t  private isSyncing = false;\n22\t  private syncPromise: Promise<void> | null = null;\n23\t\n24\t  constructor() {\n25\t    this.restoreFromStorage();\n26\t    this.initNetworkListener();\n27\t  }\n28\t\n29\t  /**\n30\t   * 监听网络状态变化：当连网时自动静默上报离线待同步队列\n31\t   */\n32\t  private initNetworkListener() {\n33\t    if (typeof wx !== 'undefined' && typeof wx.onNetworkStatusChange === 'function') {\n34\t      wx.onNetworkStatusChange((res: { isConnected: boolean; networkType: string }) => {\n35\t        if (res && res.isConnected) {\n36\t          console.log('[HistoryService] 网络连接已恢复，自动触发待同步离线队列上报...');\n37\t          this.flushPendingQueue().catch(err => {\n38\t            console.warn('[HistoryService] 连网自动上报待同步队列异常:', err);\n39\t          });\n40\t        }\n41\t      });\n42\t    }\n43\t  }\n44\t\n45\t  private restoreFromStorage() {\n46\t    try {\n47\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n48\t        const stored = wx.getStorageSync(STORAGE_KEY);\n49\t        if (stored && Array.isArray(stored)) {\n50\t          this.memoryHistory = stored;\n51\t        }\n52\t        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n53\t        if (queued && Array.isArray(queued)) {\n54\t          this.pendingQueue = queued;\n55\t        }\n56\t      }\n57\t    } catch (e) {\n58\t      console.warn('读取本地历史失败，使用内存降级', e);\n59\t    }\n60\t  }\n61\t\n62\t  /**\n63\t   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n64\t   */\n65\t  public subscribe(listener: HistoryChangeListener): () => void {\n66\t    this.listeners.add(listener);\n67\t    return () => this.listeners.delete(listener);\n68\t  }\n69\t\n70\t  private notifyListeners(): void {\n71\t    const list = this.getHistory();\n72\t    for (const listener of this.listeners) {\n73\t      try {\n74\t        listener(list);\n75\t      } catch (err) {\n76\t        console.error('历史状态订阅回调异常', err);\n77\t      }\n78\t    }\n79\t  }\n80\t\n81\t  /**\n82\t   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n83\t   */\n84\t  public getHistory(): MealHistoryRecord[] {\n85\t    try {\n86\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n87\t        const stored = wx.getStorageSync(STORAGE_KEY);\n88\t        if (stored && Array.isArray(stored)) {\n89\t          return stored;\n90\t        }\n91\t      }\n92\t    } catch (e) {\n93\t      console.warn('读取本地历史失败，使用内存降级', e);\n94\t    }\n95\t    return this.memoryHistory;\n96\t  }\n97\t\n98\t  /**\n99\t   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n100\t   */\n101\t  public deduceMealType(dateObj = new Date()): string {\n102\t    const hour = dateObj.getHours();\n103\t    if (hour >= 5 && hour < 10) return '早餐';\n104\t    if (hour >= 10 && hour < 15) return '午餐';\n105\t    if (hour >= 15 && hour < 21) return '晚餐';\n106\t    return '加餐';\n107\t  }\n108\t\n109\t  /**\n110\t   * 确认开饭：将菜单正式写入就餐历史\n111\t   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n112\t   */\n113\t  public recordMeal(\n114\t    mode: MealMode,\n115\t    dishes: Dish[],\n116\t    dateStr?: string,\n117\t    menuId?: string,\n118\t    mealType?: string\n119\t  ): MealHistoryRecord {\n120\t    const history = this.getHistory();\n121\t    const now = new Date();\n122\t    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n123\t    const targetDate = dateStr || localDate;\n124\t    const resolvedMealType = mealType || this.deduceMealType(now);\n125\t    const randSuffix = Math.random().toString(36).slice(2, 6);\n126\t    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n127\t\n128\t    const currentUser = familyService.getCurrentUser();\n129\t    const currentFamily = familyService.getCurrentFamily();\n130\t    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n131\t\n132\t    const newRecord: MealHistoryRecord = {\n133\t      id: mealId,\n134\t      menuId,\n135\t      mealId,\n136\t      date: targetDate,\n137\t      timestamp: now.getTime(),\n138\t      mode,\n139\t      mealType: resolvedMealType,\n140\t      dishIds: dishes.map(d => d.id),\n141\t      dishNames: dishes.map(d => d.name),\n142\t      dishes: dishes.map(d => ({\n143\t        id: d.id,\n144\t        name: d.name,\n145\t        category: d.category,\n146\t        thumbUrl: d.thumbUrl,\n147\t        dishEmoji: d.dishEmoji,\n148\t        isCustom: (d as any).isCustom\n149\t      })),\n150\t      confirmedBy: currentUser.openid,\n151\t      confirmedByName: currentUser.nickName || '家人',\n152\t      familyId,\n153\t      syncStatus: familyId ? 'pending' : 'synced'\n154\t    };\n155\t\n156\t    // 智能去重判断：\n157\t    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n158\t    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n159\t    const existingIndex = history.findIndex(r =>\n160\t      r.id === mealId ||\n161\t      (Boolean(menuId) && r.menuId === menuId) ||\n162\t      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n163\t    );\n164\t\n165\t    let updated: MealHistoryRecord[];\n166\t    if (existingIndex >= 0) {\n167\t      updated = [...history];\n168\t      updated[existingIndex] = newRecord;\n169\t    } else {\n170\t      updated = [newRecord, ...history].slice(0, 60);\n171\t    }\n172\t\n173\t    this.saveHistory(updated);\n174\t\n175\t    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n176\t    if (familyId) {\n177\t      this.enqueuePendingSync({\n178\t        targetFamilyId: familyId,\n179\t        authorOpenid: currentUser.openid,\n180\t        record: newRecord\n181\t      });\n182\t      // 触发后台静默同步\n183\t      this.flushPendingQueue().catch(() => {});\n184\t    }\n185\t\n186\t    return newRecord;\n187\t  }\n188\t\n189\t  /**\n190\t   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n191\t   */\n192\t  private enqueuePendingSync(item: PendingSyncItem) {\n193\t    this.pendingQueue.push(item);\n194\t    this.savePendingQueue();\n195\t  }\n196\t\n197\t  private savePendingQueue() {\n198\t    try {\n199\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n200\t        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n201\t      }\n202\t    } catch (e) {}\n203\t  }\n204\t\n205\t  /**\n206\t   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n207\t   */\n208\t  public async flushPendingQueue(): Promise<void> {\n209\t    if (this.syncPromise) {\n210\t      return this.syncPromise;\n211\t    }\n212\t    if (this.pendingQueue.length === 0) return;\n213\t    this.isSyncing = true;\n214\t\n215\t    this.syncPromise = (async () => {\n216\t      try {\n217\t        while (this.pendingQueue.length > 0) {\n218\t          const item = this.pendingQueue[0];\n219\t          const currentFamily = familyService.getCurrentFamily();\n220\t          const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n221\t\n222\t          // 关键防御：如果当前明确处于另一不同家庭，判定为跨家庭废弃记录，安全出队丢弃，绝不上报！\n223\t          if (currentFamilyId && currentFamilyId !== item.targetFamilyId) {\n224\t            console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n225\t            this.pendingQueue.shift();\n226\t            this.savePendingQueue();\n227\t            continue;\n228\t          }\n229\t\n230\t          // 若当前家庭信息尚未加载就绪，暂缓上报，保留在队列中等待家庭就绪\n231\t          if (!currentFamilyId) {\n232\t            break;\n233\t          }\n234\t\n235\t          const res = await cloudService.callFunction('upsertMeal', {\n236\t            action: 'upsertMeal',\n237\t            familyId: item.targetFamilyId,\n238\t            date: item.record.date,\n239\t            mockOpenid: item.authorOpenid,\n240\t            meal: {\n241\t              mealId: item.record.mealId || item.record.id,\n242\t              mealType: item.record.mealType,\n243\t              mode: item.record.mode,\n244\t              dishes: item.record.dishes,\n245\t              dishIds: item.record.dishIds,\n246\t              dishNames: item.record.dishNames,\n247\t              confirmedByName: item.record.confirmedByName,\n248\t              timestamp: item.record.timestamp\n249\t            }\n250\t          });\n251\t\n252\t          if (res.success) {\n253\t            // 标记本地记录为已同步并从队列出队\n254\t            this.pendingQueue.shift();\n255\t            this.savePendingQueue();\n256\t\n257\t            const history = this.getHistory();\n258\t            const target = history.find(r =>\n259\t              r.id === item.record.id ||\n260\t              (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n261\t              (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n262\t            );\n263\t            if (target) {\n264\t              target.syncStatus = 'synced';\n265\t              this.saveHistory([...history]);\n266\t              this.notifyListeners();\n267\t            }\n268\t          } else {\n269\t            const errorMsg = res.error || '';\n270\t            const lower = errorMsg.toLowerCase();\n271\t            const isTransientNetwork =\n272\t              lower.includes('request:fail') ||\n273\t              lower.includes('timeout') ||\n274\t              lower.includes('offline') ||\n275\t              lower.includes('network') ||\n276\t              lower.includes('fail connect') ||\n277\t              lower.includes('socket closed') ||\n278\t              lower.includes('econnaborted') ||\n279\t              lower.includes('econnreset') ||\n280\t              lower.includes('etimedout');\n281\t\n282\t            const isExplicitRejection =\n283\t              lower.includes('越权') ||\n284\t              lower.includes('不属于') ||\n285\t              lower.includes('无权') ||\n286\t              lower.includes('权限') ||\n287\t              lower.includes('缺少') ||\n288\t              lower.includes('参数') ||\n289\t              lower.includes('非法') ||\n290\t              lower.includes('openid') ||\n291\t              lower.includes('身份凭据') ||\n292\t              lower.includes('不支持') ||\n293\t              lower.includes('敏感') ||\n294\t              lower.includes('违规') ||\n295\t              lower.includes('合规') ||\n296\t              lower.includes('家庭不存在') ||\n297\t              lower.includes('不存在') ||\n298\t              lower.includes('未找到') ||\n299\t              lower.includes('已满') ||\n300\t              lower.includes('上限') ||\n301\t              lower.includes('锁定') ||\n302\t              lower.includes('防刷') ||\n303\t              lower.includes('防暴力枚举') ||\n304\t              lower.includes('已失效') ||\n305\t              lower.includes('过期') ||\n306\t              lower.includes('cannot update _id') ||\n307\t              lower.includes('errcode');\n308\t\n309\t            if (!isTransientNetwork && isExplicitRejection) {\n310\t              // 服务端业务明确拒绝错误（越权、参数非法等）：直接出队并标记为 failed，避免死循环重试\n311\t              console.warn(`[HistoryService] 离线同步记录 ${item.record.id} 遭服务端明确拒绝，已出队并标记为 failed: ${errorMsg}`);\n312\t              this.pendingQueue.shift();\n313\t              this.savePendingQueue();\n314\t\n315\t              const history = this.getHistory();\n316\t              const target = history.find(r =>\n317\t                r.id === item.record.id ||\n318\t                (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n319\t                (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n320\t              );\n321\t              if (target) {\n322\t                target.syncStatus = 'failed';\n323\t                this.saveHistory([...history]);\n324\t                this.notifyListeners();\n325\t              }\n326\t            } else {\n327\t              // 提交失败（网络或瞬时异常），保留在队列头部中断当前轮次等待下次重试\n328\t              break;\n329\t            }\n330\t          }\n331\t        }\n332\t      } finally {\n333\t        this.isSyncing = false;\n334\t        this.syncPromise = null;\n335\t      }\n336\t    })();\n337\t\n338\t    return this.syncPromise;\n339\t  }\n340\t\n341\t  /**\n342\t   * SWR 增量拉取家庭共享历史并合并到本地\n343\t   */\n344\t  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n345\t    const currentFamily = familyService.getCurrentFamily();\n346\t    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n347\t    if (!familyId) {\n348\t      return this.getHistory();\n349\t    }\n350\t\n351\t    // 先刷新离线待上报队列\n352\t    await this.flushPendingQueue();\n353\t\n354\t    const currentUser = familyService.getCurrentUser();\n355\t    const res = await cloudService.callFunction('upsertMeal', {\n356\t      action: 'getHistory',\n357\t      familyId,\n358\t      mockOpenid: currentUser.openid,\n359\t      limitDays: 60\n360\t    });\n361\t\n362\t    if (res.success && Array.isArray(res.records)) {\n363\t      const cloudRecords: MealHistoryRecord[] = res.records;\n364\t      const localRecords = this.getHistory();\n365\t\n366\t      // 双向合并：以餐次 mealId 为唯一标识\n367\t      const recordMap = new Map<string, MealHistoryRecord>();\n368\t\n369\t      // 先放入云端记录\n370\t      for (const cr of cloudRecords) {\n371\t        const key = cr.mealId || cr.id;\n372\t        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n373\t      }\n374\t\n375\t      // 再放入本地未同步或更新的属于当前家庭的记录\n376\t      for (const lr of localRecords) {\n377\t        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n378\t        if (lr.familyId && lr.familyId !== familyId) {\n379\t          continue;\n380\t        }\n381\t        const key = lr.mealId || lr.id;\n382\t        if (!recordMap.has(key)) {\n383\t          recordMap.set(key, lr);\n384\t        } else {\n385\t          // 如果本地是 pending，优先以本地为准\n386\t          if (lr.syncStatus === 'pending') {\n387\t            recordMap.set(key, lr);\n388\t          }\n389\t        }\n390\t      }\n391\t\n392\t      const merged = Array.from(recordMap.values());\n393\t      merged.sort((a, b) => b.timestamp - a.timestamp);\n394\t      const finalRecords = merged.slice(0, 60);\n395\t\n396\t      this.saveHistory(finalRecords);\n397\t      this.notifyListeners();\n398\t      return finalRecords;\n399\t    }\n400\t\n401\t    return this.getHistory();\n402\t  }\n403\t\n404\t  /**\n405\t   * 清空或重置历史 (用于测试或用户重置)\n406\t   */\n407\t  public clearHistory(): void {\n408\t    this.pendingQueue = [];\n409\t    this.savePendingQueue();\n410\t    this.saveHistory([]);\n411\t    this.notifyListeners();\n412\t  }\n413\t\n414\t  private saveHistory(records: MealHistoryRecord[]): void {\n415\t    this.memoryHistory = records;\n416\t    try {\n417\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n418\t        wx.setStorageSync(STORAGE_KEY, records);\n419\t      }\n420\t    } catch (e) {\n421\t      console.warn('保存本地历史失败', e);\n422\t    }\n423\t  }\n424\t}\n425\t\n426\texport const historyService = new HistoryService();\n427\t"}]},"parent_tool_use_id":null,"session_id":"0c1182a9-4dae-4f8c-a8ee-a60a88fe0888","uuid":"ada563f7-395b-4bef-9ceb-e0a40d1bc26e","timestamp":"2026-10-02T23:04:50.874Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/historyService.ts","content":"import type { MealHistoryRecord, MealMode } from '../types/user.js';\nimport type { Dish } from '../types/dish.js';\nimport { familyService } from './familyService.js';\nimport { cloudService } from './cloudService.js';\n\nconst STORAGE_KEY = 'meal_history_records';\nconst QUEUE_STORAGE_KEY = 'pending_meal_sync_queue';\n\ninterface PendingSyncItem {\n  targetFamilyId: string;\n  authorOpenid: string;\n  record: MealHistoryRecord;\n}\n\ntype HistoryChangeListener = (records: MealHistoryRecord[]) => void;\n\nclass HistoryService {\n  private memoryHistory: MealHistoryRecord[] = [];\n  private pendingQueue: PendingSyncItem[] = [];\n  private listeners: Set<HistoryChangeListener> = new Set();\n  private isSyncing = false;\n  private syncPromise: Promise<void> | null = null;\n\n  constructor() {\n    this.restoreFromStorage();\n    this.initNetworkListener();\n  }\n\n  /**\n   * 监听网络状态变化：当连网时自动静默上报离线待同步队列\n   */\n  private initNetworkListener() {\n    if (typeof wx !== 'undefined' && typeof wx.onNetworkStatusChange === 'function') {\n      wx.onNetworkStatusChange((res: { isConnected: boolean; networkType: string }) => {\n        if (res && res.isConnected) {\n          console.log('[HistoryService] 网络连接已恢复，自动触发待同步离线队列上报...');\n          this.flushPendingQueue().catch(err => {\n            console.warn('[HistoryService] 连网自动上报待同步队列异常:', err);\n          });\n        }\n      });\n    }\n  }\n\n  private restoreFromStorage() {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(STORAGE_KEY);\n        if (stored && Array.isArray(stored)) {\n          this.memoryHistory = stored;\n        }\n        const queued = wx.getStorageSync(QUEUE_STORAGE_KEY);\n        if (queued && Array.isArray(queued)) {\n          this.pendingQueue = queued;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地历史失败，使用内存降级', e);\n    }\n  }\n\n  /**\n   * 监听历史数据变化 (SWR 后台增量拉取完成后自动触发页面重绘)\n   */\n  public subscribe(listener: HistoryChangeListener): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  private notifyListeners(): void {\n    const list = this.getHistory();\n    for (const listener of this.listeners) {\n      try {\n        listener(list);\n      } catch (err) {\n        console.error('历史状态订阅回调异常', err);\n      }\n    }\n  }\n\n  /**\n   * 获取最近的就餐历史 (同步直出，0 毫秒秒开，保障离线与页面性能)\n   */\n  public getHistory(): MealHistoryRecord[] {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(STORAGE_KEY);\n        if (stored && Array.isArray(stored)) {\n          return stored;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地历史失败，使用内存降级', e);\n    }\n    return this.memoryHistory;\n  }\n\n  /**\n   * 判断餐次类型 (按确认开饭时的自然时间段自适应识别，也可显式指定)\n   */\n  public deduceMealType(dateObj = new Date()): string {\n    const hour = dateObj.getHours();\n    if (hour >= 5 && hour < 10) return '早餐';\n    if (hour >= 10 && hour < 15) return '午餐';\n    if (hour >= 15 && hour < 21) return '晚餐';\n    return '加餐';\n  }\n\n  /**\n   * 确认开饭：将菜单正式写入就餐历史\n   * 支持同日多餐（午餐与晚餐独立记录，拒绝整日覆盖）\n   */\n  public recordMeal(\n    mode: MealMode,\n    dishes: Dish[],\n    dateStr?: string,\n    menuId?: string,\n    mealType?: string\n  ): MealHistoryRecord {\n    const history = this.getHistory();\n    const now = new Date();\n    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n    const targetDate = dateStr || localDate;\n    const resolvedMealType = mealType || this.deduceMealType(now);\n    const randSuffix = Math.random().toString(36).slice(2, 6);\n    const mealId = menuId ? `hist_${menuId}` : `hist_${now.getTime()}_${randSuffix}`;\n\n    const currentUser = familyService.getCurrentUser();\n    const currentFamily = familyService.getCurrentFamily();\n    const familyId = currentFamily?.id || (currentFamily as any)?._id || undefined;\n\n    const newRecord: MealHistoryRecord = {\n      id: mealId,\n      menuId,\n      mealId,\n      date: targetDate,\n      timestamp: now.getTime(),\n      mode,\n      mealType: resolvedMealType,\n      dishIds: dishes.map(d => d.id),\n      dishNames: dishes.map(d => d.name),\n      dishes: dishes.map(d => ({\n        id: d.id,\n        name: d.name,\n        category: d.category,\n        thumbUrl: d.thumbUrl,\n        dishEmoji: d.dishEmoji,\n        isCustom: (d as any).isCustom\n      })),\n      confirmedBy: currentUser.openid,\n      confirmedByName: currentUser.nickName || '家人',\n      familyId,\n      syncStatus: familyId ? 'pending' : 'synced'\n    };\n\n    // 智能去重判断：\n    // 若同一餐次（同一有效 menuId 或 同一日期且相同餐次标签且相同菜名）已记录过，就地更新防止重复\n    // 若同一天是不同餐次（如午餐与晚餐），则独立并存，绝不覆盖！\n    const existingIndex = history.findIndex(r =>\n      r.id === mealId ||\n      (Boolean(menuId) && r.menuId === menuId) ||\n      (r.date === targetDate && r.mealType === resolvedMealType && r.dishNames.join(',') === newRecord.dishNames.join(','))\n    );\n\n    let updated: MealHistoryRecord[];\n    if (existingIndex >= 0) {\n      updated = [...history];\n      updated[existingIndex] = newRecord;\n    } else {\n      updated = [newRecord, ...history].slice(0, 60);\n    }\n\n    this.saveHistory(updated);\n\n    // 如果处于家庭空间中，入队离线待同步队列并后台异步提交\n    if (familyId) {\n      this.enqueuePendingSync({\n        targetFamilyId: familyId,\n        authorOpenid: currentUser.openid,\n        record: newRecord\n      });\n      // 触发后台静默同步\n      this.flushPendingQueue().catch(() => {});\n    }\n\n    return newRecord;\n  }\n\n  /**\n   * 离线写入队列入队 (携带 targetFamilyId 与 authorOpenid 防止串门污染)\n   */\n  private enqueuePendingSync(item: PendingSyncItem) {\n    this.pendingQueue.push(item);\n    this.savePendingQueue();\n  }\n\n  private savePendingQueue() {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(QUEUE_STORAGE_KEY, this.pendingQueue);\n      }\n    } catch (e) {}\n  }\n\n  /**\n   * 后台排空待同步离线队列 (易错点 6 防御：家庭变更时严防跨家庭串门污染)\n   */\n  public async flushPendingQueue(): Promise<void> {\n    if (this.syncPromise) {\n      return this.syncPromise;\n    }\n    if (this.pendingQueue.length === 0) return;\n    this.isSyncing = true;\n\n    this.syncPromise = (async () => {\n      try {\n        while (this.pendingQueue.length > 0) {\n          const item = this.pendingQueue[0];\n          const currentFamily = familyService.getCurrentFamily();\n          const currentFamilyId = currentFamily?.id || (currentFamily as any)?._id;\n\n          // 关键防御：如果当前明确处于另一不同家庭，判定为跨家庭废弃记录，安全出队丢弃，绝不上报！\n          if (currentFamilyId && currentFamilyId !== item.targetFamilyId) {\n            console.warn(`[HistoryService] 丢弃跨家庭离线记录: 所属 ${item.targetFamilyId}, 当前 ${currentFamilyId}`);\n            this.pendingQueue.shift();\n            this.savePendingQueue();\n            continue;\n          }\n\n          // 若当前家庭信息尚未加载就绪，暂缓上报，保留在队列中等待家庭就绪\n          if (!currentFamilyId) {\n            break;\n          }\n\n          const res = await cloudService.callFunction('upsertMeal', {\n            action: 'upsertMeal',\n            familyId: item.targetFamilyId,\n            date: item.record.date,\n            mockOpenid: item.authorOpenid,\n            meal: {\n              mealId: item.record.mealId || item.record.id,\n              mealType: item.record.mealType,\n              mode: item.record.mode,\n              dishes: item.record.dishes,\n              dishIds: item.record.dishIds,\n              dishNames: item.record.dishNames,\n              confirmedByName: item.record.confirmedByName,\n              timestamp: item.record.timestamp\n            }\n          });\n\n          if (res.success) {\n            // 标记本地记录为已同步并从队列出队\n            this.pendingQueue.shift();\n            this.savePendingQueue();\n\n            const history = this.getHistory();\n            const target = history.find(r =>\n              r.id === item.record.id ||\n              (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n              (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n            );\n            if (target) {\n              target.syncStatus = 'synced';\n              this.saveHistory([...history]);\n              this.notifyListeners();\n            }\n          } else {\n            const errorMsg = res.error || '';\n            const lower = errorMsg.toLowerCase();\n            const isTransientNetwork =\n              lower.includes('request:fail') ||\n              lower.includes('timeout') ||\n              lower.includes('offline') ||\n              lower.includes('network') ||\n              lower.includes('fail connect') ||\n              lower.includes('socket closed') ||\n              lower.includes('econnaborted') ||\n              lower.includes('econnreset') ||\n              lower.includes('etimedout');\n\n            const isExplicitRejection =\n              lower.includes('越权') ||\n              lower.includes('不属于') ||\n              lower.includes('无权') ||\n              lower.includes('权限') ||\n              lower.includes('缺少') ||\n              lower.includes('参数') ||\n              lower.includes('非法') ||\n              lower.includes('openid') ||\n              lower.includes('身份凭据') ||\n              lower.includes('不支持') ||\n              lower.includes('敏感') ||\n              lower.includes('违规') ||\n              lower.includes('合规') ||\n              lower.includes('家庭不存在') ||\n              lower.includes('不存在') ||\n              lower.includes('未找到') ||\n              lower.includes('已满') ||\n              lower.includes('上限') ||\n              lower.includes('锁定') ||\n              lower.includes('防刷') ||\n              lower.includes('防暴力枚举') ||\n              lower.includes('已失效') ||\n              lower.includes('过期') ||\n              lower.includes('cannot update _id') ||\n              lower.includes('errcode');\n\n            if (!isTransientNetwork && isExplicitRejection) {\n              // 服务端业务明确拒绝错误（越权、参数非法等）：直接出队并标记为 failed，避免死循环重试\n              console.warn(`[HistoryService] 离线同步记录 ${item.record.id} 遭服务端明确拒绝，已出队并标记为 failed: ${errorMsg}`);\n              this.pendingQueue.shift();\n              this.savePendingQueue();\n\n              const history = this.getHistory();\n              const target = history.find(r =>\n                r.id === item.record.id ||\n                (Boolean(item.record.mealId) && r.mealId === item.record.mealId) ||\n                (Boolean(item.record.menuId) && r.menuId === item.record.menuId)\n              );\n              if (target) {\n                target.syncStatus = 'failed';\n                this.saveHistory([...history]);\n                this.notifyListeners();\n              }\n            } else {\n              // 提交失败（网络或瞬时异常），保留在队列头部中断当前轮次等待下次重试\n              break;\n            }\n          }\n        }\n      } finally {\n        this.isSyncing = false;\n        this.syncPromise = null;\n      }\n    })();\n\n    return this.syncPromise;\n  }\n\n  /**\n   * SWR 增量拉取家庭共享历史并合并到本地\n   */\n  public async syncCloudHistory(): Promise<MealHistoryRecord[]> {\n    const currentFamily = familyService.getCurrentFamily();\n    const familyId = currentFamily?.id || (currentFamily as any)?._id;\n    if (!familyId) {\n      return this.getHistory();\n    }\n\n    // 先刷新离线待上报队列\n    await this.flushPendingQueue();\n\n    const currentUser = familyService.getCurrentUser();\n    const res = await cloudService.callFunction('upsertMeal', {\n      action: 'getHistory',\n      familyId,\n      mockOpenid: currentUser.openid,\n      limitDays: 60\n    });\n\n    if (res.success && Array.isArray(res.records)) {\n      const cloudRecords: MealHistoryRecord[] = res.records;\n      const localRecords = this.getHistory();\n\n      // 双向合并：以餐次 mealId 为唯一标识\n      const recordMap = new Map<string, MealHistoryRecord>();\n\n      // 先放入云端记录\n      for (const cr of cloudRecords) {\n        const key = cr.mealId || cr.id;\n        recordMap.set(key, { ...cr, syncStatus: 'synced' });\n      }\n\n      // 再放入本地未同步或更新的属于当前家庭的记录\n      for (const lr of localRecords) {\n        // 关键防御：如果该本地记录显式归属于其他家庭，绝不合并到当前家庭！\n        if (lr.familyId && lr.familyId !== familyId) {\n          continue;\n        }\n        const key = lr.mealId || lr.id;\n        if (!recordMap.has(key)) {\n          recordMap.set(key, lr);\n        } else {\n          // 如果本地是 pending，优先以本地为准\n          if (lr.syncStatus === 'pending') {\n            recordMap.set(key, lr);\n          }\n        }\n      }\n\n      const merged = Array.from(recordMap.values());\n      merged.sort((a, b) => b.timestamp - a.timestamp);\n      const finalRecords = merged.slice(0, 60);\n\n      this.saveHistory(finalRecords);\n      this.notifyListeners();\n      return finalRecords;\n    }\n\n    return this.getHistory();\n  }\n\n  /**\n   * 清空或重置历史 (用于测试或用户重置)\n   */\n  public clearHistory(): void {\n    this.pendingQueue = [];\n    this.savePendingQueue();\n    this.saveHistory([]);\n    this.notifyListeners();\n  }\n\n  private saveHistory(records: MealHistoryRecord[]): void {\n    this.memoryHistory = records;\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(STORAGE_KEY, records);\n      }\n    } catch (e) {\n      console.warn('保存本地历史失败', e);\n    }\n  }\n}\n\nexport const historyService = new HistoryService();\n","numLines":427,"startLine":1,"totalLines":427}}}
