{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014W8ucW5APfSzhjQeM1y1mQ","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\tconst _ = db.command;\n9\t\n10\tconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n11\t\n12\t/**\n13\t * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n14\t */\n15\tasync function checkTextSecurity(text, openid) {\n16\t  if (!text) return { pass: true };\n17\t  const str = String(text).trim();\n18\t  if (!str) return { pass: true };\n19\t\n20\t  // 1. 本地兜底敏感词拦截\n21\t  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n22\t    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n23\t  }\n24\t\n25\t  // 2. 微信官方 msgSecCheck 2.0 规范检测\n26\t  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n27\t    try {\n28\t      const res = await cloud.openapi.security.msgSecCheck({\n29\t        version: 2,\n30\t        scene: 1, // 1: 资料/昵称/家庭名称等\n31\t        openid,\n32\t        content: str\n33\t      });\n34\t      if (!res || !res.result || res.result.suggest !== 'pass') {\n35\t        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n36\t      }\n37\t    } catch (err) {\n38\t      console.error('[familyManage] msgSecCheck 异常:', err);\n39\t      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n40\t    }\n41\t  }\n42\t\n43\t  return { pass: true };\n44\t}\n45\t\n46\t/**\n47\t * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n48\t */\n49\tasync function generateUniqueInviteCode() {\n50\t  const now = Date.now();\n51\t  for (let attempt = 0; attempt < 10; attempt++) {\n52\t    const code = String(Math.floor(100000 + Math.random() * 900000));\n53\t    const existing = await db.collection('families').where({\n54\t      inviteCode: code,\n55\t      inviteExpiredAt: _.gt(now)\n56\t    }).count().catch(() => null);\n57\t\n58\t    if (!existing || existing.total === 0) {\n59\t      return code;\n60\t    }\n61\t  }\n62\t  return String(Math.floor(100000 + Math.random() * 900000));\n63\t}\n64\t\n65\t/**\n66\t * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n67\t */\n68\tfunction normalizeInviteCode(input) {\n69\t  if (!input) return '';\n70\t  let str = String(input).trim();\n71\t  // 全角数字转换为半角 (０-９ -> 0-9)\n72\t  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n73\t  // 提取纯数字\n74\t  const digits = str.replace(/\\D/g, '');\n75\t  if (digits.length === 6) return digits;\n76\t  if (digits.length > 6) {\n77\t    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n78\t    if (match) return match[0];\n79\t  }\n80\t  return digits.slice(0, 6);\n81\t}\n82\t\n83\tconst JOIN_RATE_LIMIT = {\n84\t  MAX_FAILURES: 5,\n85\t  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n86\t};\n87\t\n88\t/**\n89\t * 判断云开发数据库错误是否为文档不存在\n90\t */\n91\tfunction isNotFoundError(err) {\n92\t  if (!err) return false;\n93\t  const code = err?.errCode ?? err?.code;\n94\t  if (code === -502005 || String(code) === '-502005') return true;\n95\t  const msg = String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n96\t  return (\n97\t    msg.includes('does not exist') ||\n98\t    msg.includes('not exist') ||\n99\t    msg.includes('not found') ||\n100\t    msg.includes('-502005')\n101\t  );\n102\t}\n103\t\n104\t/**\n105\t * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n106\t * 严格 fail-closed：查询异常时拒绝放行\n107\t */\n108\tasync function checkJoinRateLimit(openid, now) {\n109\t  try {\n110\t    let userDoc = null;\n111\t    try {\n112\t      userDoc = await db.collection('users').doc(`user_${openid}`).get();\n113\t    } catch (docErr) {\n114\t      // 用户文档尚不存在属于正常初次状态，不当作异常\n115\t      if (isNotFoundError(docErr)) {\n116\t        return { allowed: true };\n117\t      }\n118\t      throw docErr;\n119\t    }\n120\t\n121\t    const data = userDoc?.data;\n122\t    if (!data) return { allowed: true };\n123\t\n124\t    const failCount = data.joinFailCount || 0;\n125\t    const lastFailTime = data.joinFailLastTime || 0;\n126\t\n127\t    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n128\t      return { allowed: true };\n129\t    }\n130\t\n131\t    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n132\t      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n133\t      return {\n134\t        allowed: false,\n135\t        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n136\t      };\n137\t    }\n138\t    return { allowed: true };\n139\t  } catch (err) {\n140\t    console.error('[familyManage] 检查防刷限频异常 (严格 fail-closed 拦截):', err);\n141\t    return {\n142\t      allowed: false,\n143\t      error: '安全防刷限频服务异常，请稍后重试'\n144\t    };\n145\t  }\n146\t}\n147\t\n148\t/**\n149\t * 记录一次加入失败尝试 (在事务内原子更新失败计数与时间戳，防止并发竞态丢失计数)\n150\t */\n151\tasync function recordJoinFailure(openid, now) {\n152\t  try {\n153\t    await db.runTransaction(async transaction => {\n154\t      const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n155\t      let userRes = null;\n156\t      try {\n157\t        userRes = await userDocRef.get();\n158\t      } catch (err) {\n159\t        if (!isNotFoundError(err)) {\n160\t          throw err;\n161\t        }\n162\t      }\n163\t\n164\t      const data = userRes?.data;\n165\t      const lastFailTime = data?.joinFailLastTime || 0;\n166\t      const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n167\t      const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n168\t\n169\t      if (data) {\n170\t        await userDocRef.update({\n171\t          data: {\n172\t            joinFailCount: newCount,\n173\t            joinFailLastTime: now\n174\t          }\n175\t        });\n176\t      } else {\n177\t        await userDocRef.set({\n178\t          data: {\n179\t            openid,\n180\t            nickName: '家人',\n181\t            familyId: null,\n182\t            role: null,\n183\t            joinFailCount: newCount,\n184\t            joinFailLastTime: now,\n185\t            createdAt: now,\n186\t            updatedAt: now\n187\t          }\n188\t        });\n189\t      }\n190\t    });\n191\t  } catch (err) {\n192\t    console.warn('[familyManage] 事务记录加入失败计数异常:', err);\n193\t  }\n194\t}\n195\t\n196\texports.main = async (event, context) => {\n197\t  const wxContext = cloud.getWXContext();\n198\t  let openid = wxContext && wxContext.OPENID;\n199\t\n200\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n201\t  if (!openid) {\n202\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n203\t      openid = event.mockOpenid || 'mock_openid_default';\n204\t    } else {\n205\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n206\t    }\n207\t  }\n208\t\n209\t  const { action } = event;\n210\t  const now = Date.now();\n211\t\n212\t  try {\n213\t    switch (action) {\n214\t      /**\n215\t       * 1. 创建家庭空间\n216\t       */\n217\t      case 'createFamily': {\n218\t        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n219\t        const nickName = (event.nickName || '房主').trim();\n220\t\n221\t        // 安全合规校验：家庭名称与昵称\n222\t        const nameSec = await checkTextSecurity(familyName, openid);\n223\t        if (!nameSec.pass) return { success: false, error: nameSec.error };\n224\t\n225\t        const nickSec = await checkTextSecurity(nickName, openid);\n226\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n227\t\n228\t        // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n229\t        const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n230\t        let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n231\t          ? String(event.inviteCode).trim()\n232\t          : null;\n233\t        if (inviteCode) {\n234\t          const dupRes = await db.collection('families').where({\n235\t            inviteCode,\n236\t            inviteExpiredAt: _.gt(now)\n237\t          }).get().catch(() => null);\n238\t          if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n239\t            inviteCode = await generateUniqueInviteCode();\n240\t          }\n241\t        } else {\n242\t          inviteCode = await generateUniqueInviteCode();\n243\t        }\n244\t        const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n245\t          ? Number(event.inviteExpiredAt)\n246\t          : (now + 24 * 60 * 60 * 1000); // 24小时过期\n247\t\n248\t        return await db.runTransaction(async transaction => {\n249\t          const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n250\t          \n251\t          let user = null;\n252\t          try {\n253\t            const uRes = await userDocRef.get();\n254\t            user = (uRes && uRes.data) ? uRes.data : null;\n255\t          } catch (e) {\n256\t            if (isNotFoundError(e)) {\n257\t              user = null;\n258\t            } else {\n259\t              console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n260\t              throw e;\n261\t            }\n262\t          }\n263\t          if (!user) {\n264\t            user = { openid, nickName: nickName || '房主' };\n265\t          }\n266\t\n267\t          // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n268\t          if (user.familyId) {\n269\t            try {\n270\t              const oldFamilyId = user.familyId;\n271\t              const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n272\t              let oldFamRes = null;\n273\t              try {\n274\t                oldFamRes = await oldFamDocRef.get();\n275\t              } catch (famErr) {\n276\t                if (isNotFoundError(famErr)) {\n277\t                  oldFamRes = null;\n278\t                } else {\n279\t                  throw famErr;\n280\t                }\n281\t              }\n282\t              if (oldFamRes && oldFamRes.data) {\n283\t                const oldFamily = oldFamRes.data;\n284\t                const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n285\t                const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n286\t\n287\t                if (remainingMembers.length === 0) {\n288\t                  await oldFamDocRef.remove();\n289\t                } else {\n290\t                  let newCreatorOpenid = oldFamily.creatorOpenid;\n291\t                  if (oldFamily.creatorOpenid === openid) {\n292\t                    newCreatorOpenid = remainingMembers[0].openid;\n293\t                    remainingMembers[0].role = 'creator';\n294\t                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n295\t                      data: { role: 'creator', updatedAt: now }\n296\t                    }).catch(() => {});\n297\t                  }\n298\t\n299\t                  await oldFamDocRef.update({\n300\t                    data: {\n301\t                      creatorOpenid: newCreatorOpenid,\n302\t                      members: remainingMembers,\n303\t                      memberOpenids: remainingOpenids,\n304\t                      updatedAt: now\n305\t                    }\n306\t                  });\n307\t                }\n308\t              }\n309\t            } catch (e) {\n310\t              console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n311\t              throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n312\t            }\n313\t          }\n314\t\n315\t          const familyData = {\n316\t            id: familyId,\n317\t            name: familyName,\n318\t            creatorOpenid: openid,\n319\t            members: [\n320\t              {\n321\t                openid,\n322\t                nickName: nickName || user.nickName || '房主',\n323\t                avatarUrl: event.avatarUrl || user.avatarUrl || '',\n324\t                role: 'creator',\n325\t                joinedAt: now\n326\t              }\n327\t            ],\n328\t            memberOpenids: [openid],\n329\t            inviteCode,\n330\t            inviteExpiredAt,\n331\t            createdAt: now,\n332\t            updatedAt: now\n333\t          };\n334\t\n335\t          // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n336\t          await transaction.collection('families').doc(familyId).set({ data: familyData });\n337\t\n338\t          // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n339\t          await transaction.collection('users').doc(`user_${openid}`).set({\n340\t            data: {\n341\t              openid,\n342\t              nickName: nickName || user.nickName || '房主',\n343\t              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n344\t              familyId,\n345\t              role: 'creator',\n346\t              createdAt: (user && user.createdAt) || now,\n347\t              updatedAt: now\n348\t            }\n349\t          });\n350\t\n351\t          return {\n352\t            success: true,\n353\t            openid,\n354\t            family: {\n355\t              id: familyId,\n356\t              _id: familyId,\n357\t              ...familyData\n358\t            }\n359\t          };\n360\t        });\n361\t      }\n362\t\n363\t      /**\n364\t       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n365\t       */\n366\t      case 'joinFamily': {\n367\t        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n368\t        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n369\t        if (!rateLimitCheck.allowed) {\n370\t          return { success: false, error: rateLimitCheck.error };\n371\t        }\n372\t\n373\t        const cleanCode = normalizeInviteCode(event.inviteCode);\n374\t        if (!cleanCode || cleanCode.length !== 6) {\n375\t          await recordJoinFailure(openid, now);\n376\t          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n377\t        }\n378\t\n379\t        const memberNickName = (event.nickName || '家人').trim();\n380\t        const nickSec = await checkTextSecurity(memberNickName, openid);\n381\t        if (!nickSec.pass) return { success: false, error: nickSec.error };\n382\t\n383\t        // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n384\t        const codeStr = String(cleanCode);\n385\t        const codeNum = Number(cleanCode);\n386\t\n387\t        let matchedFamilies = [];\n388\t        const strRes = await db.collection('families').where({ inviteCode: codeStr }).get().catch(() => null);\n389\t        if (strRes && strRes.data && strRes.data.length > 0) {\n390\t          matchedFamilies = matchedFamilies.concat(strRes.data);\n391\t        }\n392\t\n393\t        if (!isNaN(codeNum)) {\n394\t          const numRes = await db.collection('families').where({ inviteCode: codeNum }).get().catch(() => null);\n395\t          if (numRes && numRes.data && numRes.data.length > 0) {\n396\t            for (const doc of numRes.data) {\n397\t              const docId = doc._id || doc.id;\n398\t              if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n399\t                matchedFamilies.push(doc);\n400\t              }\n401\t            }\n402\t          }\n403\t        }\n404\t\n405\t        if (matchedFamilies.length === 0) {\n406\t          await recordJoinFailure(openid, now);\n407\t          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n408\t        }\n409\t\n410\t        // 筛选未过期家庭 (按更新时间倒序优先取最新)\n411\t        matchedFamilies.sort((a, b) => (b.updatedAt || b.createdAt || 0) - (a.updatedAt || a.createdAt || 0));\n412\t        const activeFamily = matchedFamilies.find(f => !f.inviteExpiredAt || Number(f.inviteExpiredAt) > now);\n413\t\n414\t        if (!activeFamily) {\n415\t          await recordJoinFailure(openid, now);\n416\t          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n417\t        }\n418\t\n419\t        const targetFamilyId = activeFamily._id || activeFamily.id;\n420\t\n421\t        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n422\t        try {\n423\t          return await db.runTransaction(async transaction => {\n424\t            let famDoc = null;\n425\t            try {\n426\t              famDoc = await transaction.collection('families').doc(targetFamilyId).get();\n427\t            } catch (e) {\n428\t              if (isNotFoundError(e)) {\n429\t                famDoc = null;\n430\t              } else {\n431\t                throw e;\n432\t              }\n433\t            }\n434\t            if (!famDoc || !famDoc.data) {\n435\t              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n436\t              throw new Error('未找到该邀请口令对应的家庭厨房');\n437\t            }\n438\t\n439\t            const family = famDoc.data;\n440\t\n441\t            // 校验 1: 口令是否已过期 (24 小时有效)\n442\t            if (family.inviteExpiredAt && Number(family.inviteExpiredAt) <= now) {\n443\t              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n444\t              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n445\t            }\n446\t\n447\t            // 校验 2: 是否已经在该家庭中\n448\t            const isAlreadyMember = (family.memberOpenids && family.memberOpenids.includes(openid)) ||\n449\t              (family.members && family.members.some(m => m.openid === openid));\n450\t            if (isAlreadyMember) {\n451\t              // 确保用户档案同步归属\n452\t              await transaction.collection('users').doc(`user_${openid}`).update({\n453\t                data: {\n454\t                  familyId: targetFamilyId,\n455\t                  role: family.creatorOpenid === openid ? 'creator' : 'member',\n456\t                  updatedAt: now\n457\t                }\n458\t              }).catch(() => {});\n459\t\n460\t              return {\n461\t                success: true,\n462\t                openid,\n463\t                family: {\n464\t                  id: family._id || targetFamilyId,\n465\t                  _id: family._id || targetFamilyId,\n466\t                  ...family\n467\t                },\n468\t                message: '您已经在该家庭厨房中'\n469\t              };\n470\t            }\n471\t\n472\t            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n473\t            const memberCount = Math.max((family.memberOpenids || []).length, (family.members || []).length);\n474\t            if (memberCount >= 4) {\n475\t              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n476\t              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n477\t            }\n478\t\n479\t            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n480\t            let userDoc = null;\n481\t            try {\n482\t              userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n483\t            } catch (e) {\n484\t              if (isNotFoundError(e)) {\n485\t                userDoc = null;\n486\t              } else {\n487\t                throw e;\n488\t              }\n489\t            }\n490\t            const oldFamilyId = userDoc?.data?.familyId;\n491\t            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n492\t              let oldFamDoc = null;\n493\t              try {\n494\t                oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get();\n495\t              } catch (e) {\n496\t                if (isNotFoundError(e)) {\n497\t                  oldFamDoc = null;\n498\t                } else {\n499\t                  throw e;\n500\t                }\n501\t              }\n502\t              if (oldFamDoc?.data) {\n503\t                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n504\t                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n505\t\n506\t                if (remainingMembers.length === 0) {\n507\t                  await transaction.collection('families').doc(oldFamilyId).remove();\n508\t                } else {\n509\t                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n510\t                    ? remainingMembers[0].openid\n511\t                    : oldFamDoc.data.creatorOpenid;\n512\t\n513\t                  if (oldFamDoc.data.creatorOpenid === openid) {\n514\t                    remainingMembers[0].role = 'creator';\n515\t                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n516\t                      data: { role: 'creator', updatedAt: now }\n517\t                    }).catch(() => {});\n518\t                  }\n519\t\n520\t                  await transaction.collection('families').doc(oldFamilyId).update({\n521\t                    data: {\n522\t                      creatorOpenid: newCreator,\n523\t                      members: remainingMembers,\n524\t                      memberOpenids: remainingOpenids,\n525\t                      updatedAt: now\n526\t                    }\n527\t                  });\n528\t                }\n529\t              }\n530\t            }\n531\t\n532\t            // 加入新家庭\n533\t            const newMember = {\n534\t              openid,\n535\t              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n536\t              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n537\t              role: 'member',\n538\t              joinedAt: now\n539\t            };\n540\t\n541\t            const updatedMembers = [...(family.members || []), newMember];\n542\t            const updatedOpenids = Array.from(new Set([...(family.memberOpenids || []), openid]));\n543\t\n544\t            await transaction.collection('families').doc(targetFamilyId).update({\n545\t              data: {\n546\t                members: updatedMembers,\n547\t                memberOpenids: updatedOpenids,\n548\t                updatedAt: now\n549\t              }\n550\t            });\n551\t\n552\t            // 更新用户档案并重置防刷计数 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n553\t            await transaction.collection('users').doc(`user_${openid}`).set({\n554\t              data: {\n555\t                openid,\n556\t                nickName: newMember.nickName,\n557\t                avatarUrl: newMember.avatarUrl,\n558\t                familyId: targetFamilyId,\n559\t                role: 'member',\n560\t                joinFailCount: 0,\n561\t                joinFailLastTime: 0,\n562\t                createdAt: userDoc?.data?.createdAt || now,\n563\t                updatedAt: now\n564\t              }\n565\t            });\n566\t\n567\t            return {\n568\t              success: true,\n569\t              openid,\n570\t              family: {\n571\t                id: targetFamilyId,\n572\t                _id: targetFamilyId,\n573\t                ...family,\n574\t                members: updatedMembers,\n575\t                memberOpenids: updatedOpenids,\n576\t                updatedAt: now\n577\t              }\n578\t            };\n579\t          });\n580\t        } catch (trxErr) {\n581\t          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n582\t          return {\n583\t            success: false,\n584\t            error: errMsg\n585\t          };\n586\t        }\n587\t      }\n588\t\n589\t      /**\n590\t       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n591\t       */\n592\t      case 'leaveFamily': {\n593\t        return await db.runTransaction(async transaction => {\n594\t          let userDoc = null;\n595\t          try {\n596\t            userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n597\t          } catch (e) {\n598\t            if (isNotFoundError(e)) {\n599\t              userDoc = null;\n600\t            } else {\n601\t              throw e;\n602\t            }\n603\t          }\n604\t          const user = userDoc?.data;\n605\t\n606\t          if (!user || !user.familyId) {\n607\t            return { success: true, message: '当前未加入任何家庭' };\n608\t          }\n609\t\n610\t          const familyId = user.familyId;\n611\t          let famDoc = null;\n612\t          try {\n613\t            famDoc = await transaction.collection('families').doc(familyId).get();\n614\t          } catch (e) {\n615\t            if (isNotFoundError(e)) {\n616\t              famDoc = null;\n617\t            } else {\n618\t              throw e;\n619\t            }\n620\t          }\n621\t\n622\t          if (famDoc && famDoc.data) {\n623\t            const family = famDoc.data;\n624\t            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n625\t            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n626\t\n627\t            if (remainingMembers.length === 0) {\n628\t              await transaction.collection('families').doc(familyId).remove();\n629\t            } else {\n630\t              let newCreatorOpenid = family.creatorOpenid;\n631\t              if (family.creatorOpenid === openid) {\n632\t                newCreatorOpenid = remainingMembers[0].openid;\n633\t                remainingMembers[0].role = 'creator';\n634\t                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n635\t                  data: { role: 'creator', updatedAt: now }\n636\t                }).catch(() => {});\n637\t              }\n638\t\n639\t              await transaction.collection('families').doc(familyId).update({\n640\t                data: {\n641\t                  creatorOpenid: newCreatorOpenid,\n642\t                  members: remainingMembers,\n643\t                  memberOpenids: remainingOpenids,\n644\t                  updatedAt: now\n645\t                }\n646\t              });\n647\t            }\n648\t          }\n649\t\n650\t          // 重置用户家庭归属\n651\t          await transaction.collection('users').doc(`user_${openid}`).update({\n652\t            data: {\n653\t              familyId: null,\n654\t              role: null,\n655\t              updatedAt: now\n656\t            }\n657\t          });\n658\t\n659\t          return { success: true, message: '已退出家庭厨房空间' };\n660\t        });\n661\t      }\n662\t\n663\t      /**\n664\t       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n665\t       */\n666\t      case 'refreshInviteCode': {\n667\t        const { familyId } = event;\n668\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n669\t\n670\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n671\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n672\t\n673\t        const family = famRes.data;\n674\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n675\t          return { success: false, error: '无权操作非本人所属家庭' };\n676\t        }\n677\t\n678\t        const newCode = await generateUniqueInviteCode();\n679\t        const newExpiry = now + 24 * 60 * 60 * 1000;\n680\t\n681\t        await db.collection('families').doc(familyId).update({\n682\t          data: {\n683\t            inviteCode: newCode,\n684\t            inviteExpiredAt: newExpiry,\n685\t            updatedAt: now\n686\t          }\n687\t        });\n688\t\n689\t        return {\n690\t          success: true,\n691\t          inviteCode: newCode,\n692\t          inviteExpiredAt: newExpiry\n693\t        };\n694\t      }\n695\t\n696\t      /**\n697\t       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n698\t       */\n699\t      case 'getFamily': {\n700\t        const { familyId } = event;\n701\t        if (!familyId) return { success: false, error: '缺少 familyId' };\n702\t\n703\t        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n704\t        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n705\t\n706\t        const family = famRes.data;\n707\t        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n708\t          return { success: false, error: '无权查看非本人所属家庭详情' };\n709\t        }\n710\t\n711\t        return {\n712\t          success: true,\n713\t          family: {\n714\t            id: family._id || familyId,\n715\t            _id: family._id || familyId,\n716\t            ...family\n717\t          }\n718\t        };\n719\t      }\n720\t\n721\t      default:\n722\t        return { success: false, error: `不支持的操作类型: ${action}` };\n723\t    }\n724\t  } catch (err) {\n725\t    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n726\t    return {\n727\t      success: false,\n728\t      error: errMsg\n729\t    };\n730\t  }\n731\t};\n732\t\n733\t// 内部事务辅助：退出或重置家庭成员\n734\tasync function leaveCurrentFamilyInternal(openid, familyId) {\n735\t  return await db.runTransaction(async transaction => {\n736\t    const famDocRef = transaction.collection('families').doc(familyId);\n737\t    let famRes = null;\n738\t    try {\n739\t      famRes = await famDocRef.get();\n740\t    } catch (e) {\n741\t      if (isNotFoundError(e)) {\n742\t        famRes = null;\n743\t      } else {\n744\t        throw e;\n745\t      }\n746\t    }\n747\t    if (!famRes || !famRes.data) return;\n748\t\n749\t    const family = famRes.data;\n750\t    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n751\t    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n752\t\n753\t    if (remainingMembers.length === 0) {\n754\t      await famDocRef.remove();\n755\t    } else {\n756\t      let newCreatorOpenid = family.creatorOpenid;\n757\t      if (family.creatorOpenid === openid) {\n758\t        newCreatorOpenid = remainingMembers[0].openid;\n759\t        remainingMembers[0].role = 'creator';\n760\t        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n761\t          data: { role: 'creator', updatedAt: Date.now() }\n762\t        }).catch(() => {});\n763\t      }\n764\t\n765\t      await famDocRef.update({\n766\t        data: {\n767\t          creatorOpenid: newCreatorOpenid,\n768\t          members: remainingMembers,\n769\t          memberOpenids: remainingOpenids,\n770\t          updatedAt: Date.now()\n771\t        }\n772\t      });\n773\t    }\n774\t  });\n775\t}\n776\t"}]},"parent_tool_use_id":null,"session_id":"baef6729-a90b-47cf-88f2-f3c7ba7b69e3","uuid":"956aab3b-1272-4958-b8b3-5d35144ed21a","timestamp":"2026-10-06T06:08:26.510Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/familyManage/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\nconst _ = db.command;\n\nconst SENSITIVE_WORDS = ['违禁', '敏感', '广告', '赌博', '涉黄', '发票', '贷款'];\n\n/**\n * 文本内容安全合规检验 (微信 msgSecCheck 2.0 与本地安全防线)\n */\nasync function checkTextSecurity(text, openid) {\n  if (!text) return { pass: true };\n  const str = String(text).trim();\n  if (!str) return { pass: true };\n\n  // 1. 本地兜底敏感词拦截\n  if (SENSITIVE_WORDS.some(w => str.includes(w))) {\n    return { pass: false, error: '内容包含敏感词或广告违规信息，请修改后重试' };\n  }\n\n  // 2. 微信官方 msgSecCheck 2.0 规范检测\n  if (cloud.openapi && cloud.openapi.security && typeof cloud.openapi.security.msgSecCheck === 'function') {\n    try {\n      const res = await cloud.openapi.security.msgSecCheck({\n        version: 2,\n        scene: 1, // 1: 资料/昵称/家庭名称等\n        openid,\n        content: str\n      });\n      if (!res || !res.result || res.result.suggest !== 'pass') {\n        return { pass: false, error: '内容未能通过微信安全合规检测，请修改后重试' };\n      }\n    } catch (err) {\n      console.error('[familyManage] msgSecCheck 异常:', err);\n      return { pass: false, error: '内容安全检测服务异常，请稍后重试' };\n    }\n  }\n\n  return { pass: true };\n}\n\n/**\n * 生成 6 位唯一随机数字邀请码 (生成时查重防碰撞)\n */\nasync function generateUniqueInviteCode() {\n  const now = Date.now();\n  for (let attempt = 0; attempt < 10; attempt++) {\n    const code = String(Math.floor(100000 + Math.random() * 900000));\n    const existing = await db.collection('families').where({\n      inviteCode: code,\n      inviteExpiredAt: _.gt(now)\n    }).count().catch(() => null);\n\n    if (!existing || existing.total === 0) {\n      return code;\n    }\n  }\n  return String(Math.floor(100000 + Math.random() * 900000));\n}\n\n/**\n * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n */\nfunction normalizeInviteCode(input) {\n  if (!input) return '';\n  let str = String(input).trim();\n  // 全角数字转换为半角 (０-９ -> 0-9)\n  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n  // 提取纯数字\n  const digits = str.replace(/\\D/g, '');\n  if (digits.length === 6) return digits;\n  if (digits.length > 6) {\n    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n    if (match) return match[0];\n  }\n  return digits.slice(0, 6);\n}\n\nconst JOIN_RATE_LIMIT = {\n  MAX_FAILURES: 5,\n  WINDOW_MS: 15 * 60 * 1000 // 15分钟窗口\n};\n\n/**\n * 判断云开发数据库错误是否为文档不存在\n */\nfunction isNotFoundError(err) {\n  if (!err) return false;\n  const code = err?.errCode ?? err?.code;\n  if (code === -502005 || String(code) === '-502005') return true;\n  const msg = String(err?.errMsg || err?.message || (typeof err === 'object' ? JSON.stringify(err) : err) || '').toLowerCase();\n  return (\n    msg.includes('does not exist') ||\n    msg.includes('not exist') ||\n    msg.includes('not found') ||\n    msg.includes('-502005')\n  );\n}\n\n/**\n * 检查 openid 的口令尝试防刷限频（按 openid 记录失败尝试，防止暴力枚举）\n * 严格 fail-closed：查询异常时拒绝放行\n */\nasync function checkJoinRateLimit(openid, now) {\n  try {\n    let userDoc = null;\n    try {\n      userDoc = await db.collection('users').doc(`user_${openid}`).get();\n    } catch (docErr) {\n      // 用户文档尚不存在属于正常初次状态，不当作异常\n      if (isNotFoundError(docErr)) {\n        return { allowed: true };\n      }\n      throw docErr;\n    }\n\n    const data = userDoc?.data;\n    if (!data) return { allowed: true };\n\n    const failCount = data.joinFailCount || 0;\n    const lastFailTime = data.joinFailLastTime || 0;\n\n    if (now - lastFailTime > JOIN_RATE_LIMIT.WINDOW_MS) {\n      return { allowed: true };\n    }\n\n    if (failCount >= JOIN_RATE_LIMIT.MAX_FAILURES) {\n      const remainingMinutes = Math.max(1, Math.ceil((JOIN_RATE_LIMIT.WINDOW_MS - (now - lastFailTime)) / 60000));\n      return {\n        allowed: false,\n        error: `邀请口令尝试失败次数过多，已被安全锁定，请 ${remainingMinutes} 分钟后再试（防暴力枚举）`\n      };\n    }\n    return { allowed: true };\n  } catch (err) {\n    console.error('[familyManage] 检查防刷限频异常 (严格 fail-closed 拦截):', err);\n    return {\n      allowed: false,\n      error: '安全防刷限频服务异常，请稍后重试'\n    };\n  }\n}\n\n/**\n * 记录一次加入失败尝试 (在事务内原子更新失败计数与时间戳，防止并发竞态丢失计数)\n */\nasync function recordJoinFailure(openid, now) {\n  try {\n    await db.runTransaction(async transaction => {\n      const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n      let userRes = null;\n      try {\n        userRes = await userDocRef.get();\n      } catch (err) {\n        if (!isNotFoundError(err)) {\n          throw err;\n        }\n      }\n\n      const data = userRes?.data;\n      const lastFailTime = data?.joinFailLastTime || 0;\n      const isExpired = (now - lastFailTime) > JOIN_RATE_LIMIT.WINDOW_MS;\n      const newCount = isExpired ? 1 : ((data?.joinFailCount || 0) + 1);\n\n      if (data) {\n        await userDocRef.update({\n          data: {\n            joinFailCount: newCount,\n            joinFailLastTime: now\n          }\n        });\n      } else {\n        await userDocRef.set({\n          data: {\n            openid,\n            nickName: '家人',\n            familyId: null,\n            role: null,\n            joinFailCount: newCount,\n            joinFailLastTime: now,\n            createdAt: now,\n            updatedAt: now\n          }\n        });\n      }\n    });\n  } catch (err) {\n    console.warn('[familyManage] 事务记录加入失败计数异常:', err);\n  }\n}\n\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const { action } = event;\n  const now = Date.now();\n\n  try {\n    switch (action) {\n      /**\n       * 1. 创建家庭空间\n       */\n      case 'createFamily': {\n        const familyName = (event.name || '温馨小家食堂').trim().slice(0, 15);\n        const nickName = (event.nickName || '房主').trim();\n\n        // 安全合规校验：家庭名称与昵称\n        const nameSec = await checkTextSecurity(familyName, openid);\n        if (!nameSec.pass) return { success: false, error: nameSec.error };\n\n        const nickSec = await checkTextSecurity(nickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 口令与 familyId 在事务外预先生成 (防并发碰撞与事务内网络等待)\n        const familyId = event.familyId || `fam_${now}_${Math.random().toString(36).slice(2, 6)}`;\n        let inviteCode = (event.inviteCode && String(event.inviteCode).trim().length === 6)\n          ? String(event.inviteCode).trim()\n          : null;\n        if (inviteCode) {\n          const dupRes = await db.collection('families').where({\n            inviteCode,\n            inviteExpiredAt: _.gt(now)\n          }).get().catch(() => null);\n          if (dupRes && dupRes.data && dupRes.data.length > 0 && dupRes.data[0]._id !== familyId && dupRes.data[0].id !== familyId) {\n            inviteCode = await generateUniqueInviteCode();\n          }\n        } else {\n          inviteCode = await generateUniqueInviteCode();\n        }\n        const inviteExpiredAt = (event.inviteExpiredAt && Number(event.inviteExpiredAt) > now)\n          ? Number(event.inviteExpiredAt)\n          : (now + 24 * 60 * 60 * 1000); // 24小时过期\n\n        return await db.runTransaction(async transaction => {\n          const userDocRef = transaction.collection('users').doc(`user_${openid}`);\n          \n          let user = null;\n          try {\n            const uRes = await userDocRef.get();\n            user = (uRes && uRes.data) ? uRes.data : null;\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              user = null;\n            } else {\n              console.error('[familyManage] createFamily 读取用户文档异常，回滚事务:', e);\n              throw e;\n            }\n          }\n          if (!user) {\n            user = { openid, nickName: nickName || '房主' };\n          }\n\n          // 如果用户已在旧家庭中，先处理退出旧家庭（失败直接中断抛错，严防一人跨两家）\n          if (user.familyId) {\n            try {\n              const oldFamilyId = user.familyId;\n              const oldFamDocRef = transaction.collection('families').doc(oldFamilyId);\n              let oldFamRes = null;\n              try {\n                oldFamRes = await oldFamDocRef.get();\n              } catch (famErr) {\n                if (isNotFoundError(famErr)) {\n                  oldFamRes = null;\n                } else {\n                  throw famErr;\n                }\n              }\n              if (oldFamRes && oldFamRes.data) {\n                const oldFamily = oldFamRes.data;\n                const remainingMembers = (oldFamily.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamily.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await oldFamDocRef.remove();\n                } else {\n                  let newCreatorOpenid = oldFamily.creatorOpenid;\n                  if (oldFamily.creatorOpenid === openid) {\n                    newCreatorOpenid = remainingMembers[0].openid;\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await oldFamDocRef.update({\n                    data: {\n                      creatorOpenid: newCreatorOpenid,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            } catch (e) {\n              console.error('[familyManage] 退出旧家庭失败，已中断创建新家庭以防一人跨两家:', e);\n              throw new Error(`退出原有家庭失败，中断创建新家庭: ${e?.message || e}`);\n            }\n          }\n\n          const familyData = {\n            id: familyId,\n            name: familyName,\n            creatorOpenid: openid,\n            members: [\n              {\n                openid,\n                nickName: nickName || user.nickName || '房主',\n                avatarUrl: event.avatarUrl || user.avatarUrl || '',\n                role: 'creator',\n                joinedAt: now\n              }\n            ],\n            memberOpenids: [openid],\n            inviteCode,\n            inviteExpiredAt,\n            createdAt: now,\n            updatedAt: now\n          };\n\n          // 剔除冗余 _id 字段，避免微信云开发报 document.set:fail -501007 invalid parameters. 不能指定 _id 错误\n          await transaction.collection('families').doc(familyId).set({ data: familyData });\n\n          // 更新用户档案 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n          await transaction.collection('users').doc(`user_${openid}`).set({\n            data: {\n              openid,\n              nickName: nickName || user.nickName || '房主',\n              avatarUrl: event.avatarUrl || user.avatarUrl || '',\n              familyId,\n              role: 'creator',\n              createdAt: (user && user.createdAt) || now,\n              updatedAt: now\n            }\n          });\n\n          return {\n            success: true,\n            openid,\n            family: {\n              id: familyId,\n              _id: familyId,\n              ...familyData\n            }\n          };\n        });\n      }\n\n      /**\n       * 2. 口令加入家庭 (云端事务控制，严格上限 4 人，一人一家庭排他)\n       */\n      case 'joinFamily': {\n        // 防刷限频检验：先检查该 openid 是否因频繁输错口令已被锁定（防止暴力枚举 6 位口令）\n        const rateLimitCheck = await checkJoinRateLimit(openid, now);\n        if (!rateLimitCheck.allowed) {\n          return { success: false, error: rateLimitCheck.error };\n        }\n\n        const cleanCode = normalizeInviteCode(event.inviteCode);\n        if (!cleanCode || cleanCode.length !== 6) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '请输入正确的6位家庭邀请口令' };\n        }\n\n        const memberNickName = (event.nickName || '家人').trim();\n        const nickSec = await checkTextSecurity(memberNickName, openid);\n        if (!nickSec.pass) return { success: false, error: nickSec.error };\n\n        // 1. 查询该邀请口令对应的所有家庭 (支持字符串与数值型双重兼容)\n        const codeStr = String(cleanCode);\n        const codeNum = Number(cleanCode);\n\n        let matchedFamilies = [];\n        const strRes = await db.collection('families').where({ inviteCode: codeStr }).get().catch(() => null);\n        if (strRes && strRes.data && strRes.data.length > 0) {\n          matchedFamilies = matchedFamilies.concat(strRes.data);\n        }\n\n        if (!isNaN(codeNum)) {\n          const numRes = await db.collection('families').where({ inviteCode: codeNum }).get().catch(() => null);\n          if (numRes && numRes.data && numRes.data.length > 0) {\n            for (const doc of numRes.data) {\n              const docId = doc._id || doc.id;\n              if (!matchedFamilies.some(m => (m._id || m.id) === docId)) {\n                matchedFamilies.push(doc);\n              }\n            }\n          }\n        }\n\n        if (matchedFamilies.length === 0) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '未找到该邀请口令对应的家庭厨房' };\n        }\n\n        // 筛选未过期家庭 (按更新时间倒序优先取最新)\n        matchedFamilies.sort((a, b) => (b.updatedAt || b.createdAt || 0) - (a.updatedAt || a.createdAt || 0));\n        const activeFamily = matchedFamilies.find(f => !f.inviteExpiredAt || Number(f.inviteExpiredAt) > now);\n\n        if (!activeFamily) {\n          await recordJoinFailure(openid, now);\n          return { success: false, error: '该邀请口令已失效（有效期24小时），请让房主重新刷新口令' };\n        }\n\n        const targetFamilyId = activeFamily._id || activeFamily.id;\n\n        // 2. 进入原子数据库事务锁定文档并校验 4 人并发上限\n        try {\n          return await db.runTransaction(async transaction => {\n            let famDoc = null;\n            try {\n              famDoc = await transaction.collection('families').doc(targetFamilyId).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                famDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            if (!famDoc || !famDoc.data) {\n              await transaction.rollback('未找到该邀请口令对应的家庭厨房').catch(() => {});\n              throw new Error('未找到该邀请口令对应的家庭厨房');\n            }\n\n            const family = famDoc.data;\n\n            // 校验 1: 口令是否已过期 (24 小时有效)\n            if (family.inviteExpiredAt && Number(family.inviteExpiredAt) <= now) {\n              await transaction.rollback('该邀请口令已失效（有效期24小时），请让房主重新刷新口令').catch(() => {});\n              throw new Error('该邀请口令已失效（有效期24小时），请让房主重新刷新口令');\n            }\n\n            // 校验 2: 是否已经在该家庭中\n            const isAlreadyMember = (family.memberOpenids && family.memberOpenids.includes(openid)) ||\n              (family.members && family.members.some(m => m.openid === openid));\n            if (isAlreadyMember) {\n              // 确保用户档案同步归属\n              await transaction.collection('users').doc(`user_${openid}`).update({\n                data: {\n                  familyId: targetFamilyId,\n                  role: family.creatorOpenid === openid ? 'creator' : 'member',\n                  updatedAt: now\n                }\n              }).catch(() => {});\n\n              return {\n                success: true,\n                openid,\n                family: {\n                  id: family._id || targetFamilyId,\n                  _id: family._id || targetFamilyId,\n                  ...family\n                },\n                message: '您已经在该家庭厨房中'\n              };\n            }\n\n            // 校验 3: 严格并发防超员，上限 4 人 (易错点 2 防御)\n            const memberCount = Math.max((family.memberOpenids || []).length, (family.members || []).length);\n            if (memberCount >= 4) {\n              await transaction.rollback('该家庭厨房成员已满（上限4人），无法继续加入').catch(() => {});\n              throw new Error('该家庭厨房成员已满（上限4人），无法继续加入');\n            }\n\n            // 用户一人一家庭互斥：查询并清理原有家庭归属 (易错点 3 防御)\n            let userDoc = null;\n            try {\n              userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n            } catch (e) {\n              if (isNotFoundError(e)) {\n                userDoc = null;\n              } else {\n                throw e;\n              }\n            }\n            const oldFamilyId = userDoc?.data?.familyId;\n            if (oldFamilyId && oldFamilyId !== targetFamilyId) {\n              let oldFamDoc = null;\n              try {\n                oldFamDoc = await transaction.collection('families').doc(oldFamilyId).get();\n              } catch (e) {\n                if (isNotFoundError(e)) {\n                  oldFamDoc = null;\n                } else {\n                  throw e;\n                }\n              }\n              if (oldFamDoc?.data) {\n                const remainingMembers = (oldFamDoc.data.members || []).filter(m => m.openid !== openid);\n                const remainingOpenids = (oldFamDoc.data.memberOpenids || []).filter(id => id !== openid);\n\n                if (remainingMembers.length === 0) {\n                  await transaction.collection('families').doc(oldFamilyId).remove();\n                } else {\n                  const newCreator = oldFamDoc.data.creatorOpenid === openid\n                    ? remainingMembers[0].openid\n                    : oldFamDoc.data.creatorOpenid;\n\n                  if (oldFamDoc.data.creatorOpenid === openid) {\n                    remainingMembers[0].role = 'creator';\n                    await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                      data: { role: 'creator', updatedAt: now }\n                    }).catch(() => {});\n                  }\n\n                  await transaction.collection('families').doc(oldFamilyId).update({\n                    data: {\n                      creatorOpenid: newCreator,\n                      members: remainingMembers,\n                      memberOpenids: remainingOpenids,\n                      updatedAt: now\n                    }\n                  });\n                }\n              }\n            }\n\n            // 加入新家庭\n            const newMember = {\n              openid,\n              nickName: memberNickName || userDoc?.data?.nickName || '家人',\n              avatarUrl: event.avatarUrl || userDoc?.data?.avatarUrl || '',\n              role: 'member',\n              joinedAt: now\n            };\n\n            const updatedMembers = [...(family.members || []), newMember];\n            const updatedOpenids = Array.from(new Set([...(family.memberOpenids || []), openid]));\n\n            await transaction.collection('families').doc(targetFamilyId).update({\n              data: {\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            });\n\n            // 更新用户档案并重置防刷计数 (剔除冗余 _id 与保留字段 _openid，保留原始 createdAt，避免微信云开发报 document.set:fail -501007 invalid parameters 错误)\n            await transaction.collection('users').doc(`user_${openid}`).set({\n              data: {\n                openid,\n                nickName: newMember.nickName,\n                avatarUrl: newMember.avatarUrl,\n                familyId: targetFamilyId,\n                role: 'member',\n                joinFailCount: 0,\n                joinFailLastTime: 0,\n                createdAt: userDoc?.data?.createdAt || now,\n                updatedAt: now\n              }\n            });\n\n            return {\n              success: true,\n              openid,\n              family: {\n                id: targetFamilyId,\n                _id: targetFamilyId,\n                ...family,\n                members: updatedMembers,\n                memberOpenids: updatedOpenids,\n                updatedAt: now\n              }\n            };\n          });\n        } catch (trxErr) {\n          const errMsg = typeof trxErr === 'string' ? trxErr : (trxErr?.message || '加入家庭厨房失败');\n          return {\n            success: false,\n            error: errMsg\n          };\n        }\n      }\n\n      /**\n       * 3. 退出 / 解散家庭空间 (纳入事务控制，杜绝并发竞态覆盖)\n       */\n      case 'leaveFamily': {\n        return await db.runTransaction(async transaction => {\n          let userDoc = null;\n          try {\n            userDoc = await transaction.collection('users').doc(`user_${openid}`).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              userDoc = null;\n            } else {\n              throw e;\n            }\n          }\n          const user = userDoc?.data;\n\n          if (!user || !user.familyId) {\n            return { success: true, message: '当前未加入任何家庭' };\n          }\n\n          const familyId = user.familyId;\n          let famDoc = null;\n          try {\n            famDoc = await transaction.collection('families').doc(familyId).get();\n          } catch (e) {\n            if (isNotFoundError(e)) {\n              famDoc = null;\n            } else {\n              throw e;\n            }\n          }\n\n          if (famDoc && famDoc.data) {\n            const family = famDoc.data;\n            const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n            const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n            if (remainingMembers.length === 0) {\n              await transaction.collection('families').doc(familyId).remove();\n            } else {\n              let newCreatorOpenid = family.creatorOpenid;\n              if (family.creatorOpenid === openid) {\n                newCreatorOpenid = remainingMembers[0].openid;\n                remainingMembers[0].role = 'creator';\n                await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n                  data: { role: 'creator', updatedAt: now }\n                }).catch(() => {});\n              }\n\n              await transaction.collection('families').doc(familyId).update({\n                data: {\n                  creatorOpenid: newCreatorOpenid,\n                  members: remainingMembers,\n                  memberOpenids: remainingOpenids,\n                  updatedAt: now\n                }\n              });\n            }\n          }\n\n          // 重置用户家庭归属\n          await transaction.collection('users').doc(`user_${openid}`).update({\n            data: {\n              familyId: null,\n              role: null,\n              updatedAt: now\n            }\n          });\n\n          return { success: true, message: '已退出家庭厨房空间' };\n        });\n      }\n\n      /**\n       * 4. 刷新 24 小时动态口令 (仅家庭成员可操作，生成时查重)\n       */\n      case 'refreshInviteCode': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权操作非本人所属家庭' };\n        }\n\n        const newCode = await generateUniqueInviteCode();\n        const newExpiry = now + 24 * 60 * 60 * 1000;\n\n        await db.collection('families').doc(familyId).update({\n          data: {\n            inviteCode: newCode,\n            inviteExpiredAt: newExpiry,\n            updatedAt: now\n          }\n        });\n\n        return {\n          success: true,\n          inviteCode: newCode,\n          inviteExpiredAt: newExpiry\n        };\n      }\n\n      /**\n       * 5. 获取家庭空间最新信息 (严禁向非家庭成员泄露邀请码与成员敏感信息)\n       */\n      case 'getFamily': {\n        const { familyId } = event;\n        if (!familyId) return { success: false, error: '缺少 familyId' };\n\n        const famRes = await db.collection('families').doc(familyId).get().catch(() => null);\n        if (!famRes || !famRes.data) return { success: false, error: '家庭不存在' };\n\n        const family = famRes.data;\n        if (!family.memberOpenids || !family.memberOpenids.includes(openid)) {\n          return { success: false, error: '无权查看非本人所属家庭详情' };\n        }\n\n        return {\n          success: true,\n          family: {\n            id: family._id || familyId,\n            _id: family._id || familyId,\n            ...family\n          }\n        };\n      }\n\n      default:\n        return { success: false, error: `不支持的操作类型: ${action}` };\n    }\n  } catch (err) {\n    const errMsg = typeof err === 'string' ? err : (err?.message || '家庭空间管理失败');\n    return {\n      success: false,\n      error: errMsg\n    };\n  }\n};\n\n// 内部事务辅助：退出或重置家庭成员\nasync function leaveCurrentFamilyInternal(openid, familyId) {\n  return await db.runTransaction(async transaction => {\n    const famDocRef = transaction.collection('families').doc(familyId);\n    let famRes = null;\n    try {\n      famRes = await famDocRef.get();\n    } catch (e) {\n      if (isNotFoundError(e)) {\n        famRes = null;\n      } else {\n        throw e;\n      }\n    }\n    if (!famRes || !famRes.data) return;\n\n    const family = famRes.data;\n    const remainingMembers = (family.members || []).filter(m => m.openid !== openid);\n    const remainingOpenids = (family.memberOpenids || []).filter(id => id !== openid);\n\n    if (remainingMembers.length === 0) {\n      await famDocRef.remove();\n    } else {\n      let newCreatorOpenid = family.creatorOpenid;\n      if (family.creatorOpenid === openid) {\n        newCreatorOpenid = remainingMembers[0].openid;\n        remainingMembers[0].role = 'creator';\n        await transaction.collection('users').doc(`user_${remainingMembers[0].openid}`).update({\n          data: { role: 'creator', updatedAt: Date.now() }\n        }).catch(() => {});\n      }\n\n      await famDocRef.update({\n        data: {\n          creatorOpenid: newCreatorOpenid,\n          members: remainingMembers,\n          memberOpenids: remainingOpenids,\n          updatedAt: Date.now()\n        }\n      });\n    }\n  });\n}\n","numLines":776,"startLine":1,"totalLines":776}}}
