{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FpVuuHcYtuc3PZQhgV8eb9","type":"tool_result","content":"1\timport { cloudService } from './cloudService.js';\n2\timport type { FamilySpace, UserProfile } from '../types/family.js';\n3\t\n4\tconst STORAGE_KEY_USER = 'current_user_profile';\n5\tconst STORAGE_KEY_FAMILY = 'current_family_space';\n6\t\n7\ttype FamilyChangeListener = (family: FamilySpace | null) => void;\n8\t\n9\t/**\n10\t * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n11\t */\n12\texport function cleanInviteCode(input: any): string {\n13\t  if (!input) return '';\n14\t  let str = String(input).trim();\n15\t  // 全角数字转换为半角 (０-９ -> 0-9)\n16\t  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n17\t  // 提取纯数字\n18\t  const digits = str.replace(/\\D/g, '');\n19\t  if (digits.length === 6) return digits;\n20\t  if (digits.length > 6) {\n21\t    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n22\t    if (match) return match[0];\n23\t  }\n24\t  return digits.slice(0, 6);\n25\t}\n26\t\n27\tclass FamilyService {\n28\t  private currentUser: UserProfile = {\n29\t    openid: 'wx_user_default',\n30\t    nickName: '我',\n31\t    avatarUrl: '',\n32\t    familyId: null,\n33\t    role: null,\n34\t    createdAt: Date.now(),\n35\t    updatedAt: Date.now()\n36\t  };\n37\t\n38\t  private currentFamily: FamilySpace | null = null;\n39\t  private listeners: Set<FamilyChangeListener> = new Set();\n40\t  private initialized = false;\n41\t\n42\t  constructor() {\n43\t    this.restoreFromStorage();\n44\t  }\n45\t\n46\t  public init(): void {\n47\t    if (this.initialized) return;\n48\t    this.restoreFromStorage();\n49\t    this.initialized = true;\n50\t  }\n51\t\n52\t  private restoreFromStorage(): void {\n53\t    try {\n54\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n55\t        const storedUser = wx.getStorageSync(STORAGE_KEY_USER);\n56\t        if (storedUser) {\n57\t          this.currentUser = { ...this.currentUser, ...storedUser };\n58\t        }\n59\t        const storedFam = wx.getStorageSync(STORAGE_KEY_FAMILY);\n60\t        if (storedFam) {\n61\t          this.currentFamily = storedFam;\n62\t        }\n63\t      }\n64\t    } catch (e) {\n65\t      console.warn('读取本地家庭缓存失败', e);\n66\t    }\n67\t  }\n68\t\n69\t  private persist(): void {\n70\t    try {\n71\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n72\t        wx.setStorageSync(STORAGE_KEY_USER, this.currentUser);\n73\t        if (this.currentFamily) {\n74\t          wx.setStorageSync(STORAGE_KEY_FAMILY, this.currentFamily);\n75\t        } else {\n76\t          wx.removeStorageSync(STORAGE_KEY_FAMILY);\n77\t        }\n78\t      }\n79\t    } catch (e) {\n80\t      console.warn('持久化本地家庭缓存失败', e);\n81\t    }\n82\t    this.notifyListeners();\n83\t  }\n84\t\n85\t  public subscribe(listener: FamilyChangeListener): () => void {\n86\t    this.listeners.add(listener);\n87\t    return () => this.listeners.delete(listener);\n88\t  }\n89\t\n90\t  private notifyListeners(): void {\n91\t    for (const listener of this.listeners) {\n92\t      try {\n93\t        listener(this.currentFamily);\n94\t      } catch (err) {\n95\t        console.error('家庭状态订阅回调异常', err);\n96\t      }\n97\t    }\n98\t  }\n99\t\n100\t  public getCurrentUser(): UserProfile {\n101\t    return this.currentUser;\n102\t  }\n103\t\n104\t  public getCurrentFamily(): FamilySpace | null {\n105\t    return this.currentFamily;\n106\t  }\n107\t\n108\t  public setMockCurrentUser(openid: string, nickName: string = '家人'): void {\n109\t    this.currentUser.openid = openid;\n110\t    this.currentUser.nickName = nickName;\n111\t    this.currentUser.familyId = null;\n112\t    this.currentUser.role = null;\n113\t    this.currentFamily = null;\n114\t    this.persist();\n115\t  }\n116\t\n117\t  /**\n118\t   * 静默登录与鉴权同步\n119\t   */\n120\t  public async syncUserAuth(): Promise<UserProfile> {\n121\t    const res = await cloudService.callFunction('userAuth', {\n122\t      mockOpenid: this.currentUser.openid,\n123\t      nickName: this.currentUser.nickName,\n124\t      avatarUrl: this.currentUser.avatarUrl\n125\t    });\n126\t\n127\t    if (res.success && res.user) {\n128\t      this.currentUser = {\n129\t        openid: res.openid || this.currentUser.openid,\n130\t        nickName: res.user.nickName || this.currentUser.nickName,\n131\t        avatarUrl: res.user.avatarUrl || '',\n132\t        familyId: res.user.familyId || null,\n133\t        role: res.user.role || null,\n134\t        createdAt: res.user.createdAt || Date.now(),\n135\t        updatedAt: res.user.updatedAt || Date.now()\n136\t      };\n137\t      if (res.family) {\n138\t        this.currentFamily = res.family;\n139\t      } else if (!this.currentUser.familyId) {\n140\t        // 若云端未关联家庭，但本地存在此前离线或降级创建的家庭，且当前用户是房主\n141\t        if (this.currentFamily && (this.currentFamily.creatorOpenid === this.currentUser.openid || this.currentUser.role === 'creator')) {\n142\t          // 自动向云端静默补全注册，确保云端具备该邀请码供家人加入\n143\t          cloudService.callFunction('familyManage', {\n144\t            action: 'createFamily',\n145\t            _syncToCloud: true,\n146\t            mockOpenid: this.currentUser.openid,\n147\t            familyId: this.currentFamily.id || (this.currentFamily as any)._id,\n148\t            name: this.currentFamily.name,\n149\t            inviteCode: this.currentFamily.inviteCode,\n150\t            inviteExpiredAt: this.currentFamily.inviteExpiredAt,\n151\t            nickName: this.currentUser.nickName,\n152\t            avatarUrl: this.currentUser.avatarUrl\n153\t          }).then(syncRes => {\n154\t            if (syncRes.success && syncRes.family) {\n155\t              this.currentFamily = syncRes.family;\n156\t              this.currentUser.familyId = syncRes.family.id || syncRes.family._id;\n157\t              this.currentUser.role = 'creator';\n158\t              this.persist();\n159\t            }\n160\t          }).catch(() => {});\n161\t        } else {\n162\t          this.currentFamily = null;\n163\t        }\n164\t      }\n165\t      this.persist();\n166\t    }\n167\t\n168\t    return this.currentUser;\n169\t  }\n170\t\n171\t  /**\n172\t   * 1. 创建家庭空间\n173\t   */\n174\t  public async createFamily(name = '温馨小家食堂', nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n175\t    const callerNick = nickName || this.currentUser.nickName || '房主';\n176\t    const res = await cloudService.callFunction('familyManage', {\n177\t      action: 'createFamily',\n178\t      mockOpenid: this.currentUser.openid,\n179\t      name,\n180\t      nickName: callerNick,\n181\t      avatarUrl: this.currentUser.avatarUrl\n182\t    });\n183\t\n184\t    if (res.success && res.family) {\n185\t      this.currentFamily = res.family;\n186\t      if (res.openid) {\n187\t        this.currentUser.openid = res.openid;\n188\t      }\n189\t      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n190\t      this.currentUser.role = 'creator';\n191\t      this.currentUser.nickName = callerNick;\n192\t      this.persist();\n193\t      return { success: true, family: res.family };\n194\t    }\n195\t\n196\t    return { success: false, error: res.error || '创建家庭空间失败' };\n197\t  }\n198\t\n199\t  /**\n200\t   * 2. 口令加入家庭 (云端事务，上限 4 人，一人一家庭互斥)\n201\t   */\n202\t  public async joinFamily(inviteCode: string | number, nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n203\t    const code = cleanInviteCode(inviteCode);\n204\t    if (!code || code.length !== 6) {\n205\t      return { success: false, error: '请输入正确的6位数字邀请码' };\n206\t    }\n207\t\n208\t    const callerNick = nickName || this.currentUser.nickName || '家人';\n209\t    const res = await cloudService.callFunction('familyManage', {\n210\t      action: 'joinFamily',\n211\t      mockOpenid: this.currentUser.openid,\n212\t      inviteCode: code,\n213\t      nickName: callerNick,\n214\t      avatarUrl: this.currentUser.avatarUrl\n215\t    });\n216\t\n217\t    if (res.success && res.family) {\n218\t      this.currentFamily = res.family;\n219\t      if (res.openid) {\n220\t        this.currentUser.openid = res.openid;\n221\t      }\n222\t      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n223\t      this.currentUser.role = 'member';\n224\t      this.currentUser.nickName = callerNick;\n225\t      this.persist();\n226\t      return { success: true, family: res.family };\n227\t    }\n228\t\n229\t    return { success: false, error: res.error || '加入家庭空间失败' };\n230\t  }\n231\t\n232\t  /**\n233\t   * 3. 退出 / 解散家庭\n234\t   */\n235\t  public async leaveFamily(): Promise<{ success: boolean; error?: string }> {\n236\t    const res = await cloudService.callFunction('familyManage', {\n237\t      action: 'leaveFamily',\n238\t      mockOpenid: this.currentUser.openid\n239\t    });\n240\t\n241\t    if (res.success) {\n242\t      this.currentUser.familyId = null;\n243\t      this.currentUser.role = null;\n244\t      this.currentFamily = null;\n245\t      this.persist();\n246\t      return { success: true };\n247\t    }\n248\t\n249\t    return { success: false, error: res.error || '退出家庭失败' };\n250\t  }\n251\t\n252\t  /**\n253\t   * 4. 刷新 24 小时动态口令\n254\t   */\n255\t  public async refreshInviteCode(): Promise<{ success: boolean; inviteCode?: string; error?: string }> {\n256\t    if (!this.currentFamily) {\n257\t      return { success: false, error: '尚未加入家庭' };\n258\t    }\n259\t\n260\t    const res = await cloudService.callFunction('familyManage', {\n261\t      action: 'refreshInviteCode',\n262\t      mockOpenid: this.currentUser.openid,\n263\t      familyId: this.currentFamily.id || (this.currentFamily as any)._id\n264\t    });\n265\t\n266\t    if (res.success && res.inviteCode) {\n267\t      this.currentFamily.inviteCode = res.inviteCode;\n268\t      this.currentFamily.inviteExpiredAt = res.inviteExpiredAt;\n269\t      this.persist();\n270\t      return { success: true, inviteCode: res.inviteCode };\n271\t    }\n272\t\n273\t    return { success: false, error: res.error || '刷新邀请码失败' };\n274\t  }\n275\t}\n276\t\n277\texport const familyService = new FamilyService();\n278\t"}]},"parent_tool_use_id":null,"session_id":"baef6729-a90b-47cf-88f2-f3c7ba7b69e3","uuid":"8a2fdab2-fb7a-45ee-9dd7-1f013417db15","timestamp":"2026-10-06T06:08:42.246Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/familyService.ts","content":"import { cloudService } from './cloudService.js';\nimport type { FamilySpace, UserProfile } from '../types/family.js';\n\nconst STORAGE_KEY_USER = 'current_user_profile';\nconst STORAGE_KEY_FAMILY = 'current_family_space';\n\ntype FamilyChangeListener = (family: FamilySpace | null) => void;\n\n/**\n * 规范化 6 位家庭邀请口令：过滤空白、符号，兼容全角数字与复制带前后缀的文本\n */\nexport function cleanInviteCode(input: any): string {\n  if (!input) return '';\n  let str = String(input).trim();\n  // 全角数字转换为半角 (０-９ -> 0-9)\n  str = str.replace(/[\\uFF10-\\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));\n  // 提取纯数字\n  const digits = str.replace(/\\D/g, '');\n  if (digits.length === 6) return digits;\n  if (digits.length > 6) {\n    const match = str.match(/\\b\\d{6}\\b/) || str.match(/\\d{6}/);\n    if (match) return match[0];\n  }\n  return digits.slice(0, 6);\n}\n\nclass FamilyService {\n  private currentUser: UserProfile = {\n    openid: 'wx_user_default',\n    nickName: '我',\n    avatarUrl: '',\n    familyId: null,\n    role: null,\n    createdAt: Date.now(),\n    updatedAt: Date.now()\n  };\n\n  private currentFamily: FamilySpace | null = null;\n  private listeners: Set<FamilyChangeListener> = new Set();\n  private initialized = false;\n\n  constructor() {\n    this.restoreFromStorage();\n  }\n\n  public init(): void {\n    if (this.initialized) return;\n    this.restoreFromStorage();\n    this.initialized = true;\n  }\n\n  private restoreFromStorage(): void {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const storedUser = wx.getStorageSync(STORAGE_KEY_USER);\n        if (storedUser) {\n          this.currentUser = { ...this.currentUser, ...storedUser };\n        }\n        const storedFam = wx.getStorageSync(STORAGE_KEY_FAMILY);\n        if (storedFam) {\n          this.currentFamily = storedFam;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地家庭缓存失败', e);\n    }\n  }\n\n  private persist(): void {\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(STORAGE_KEY_USER, this.currentUser);\n        if (this.currentFamily) {\n          wx.setStorageSync(STORAGE_KEY_FAMILY, this.currentFamily);\n        } else {\n          wx.removeStorageSync(STORAGE_KEY_FAMILY);\n        }\n      }\n    } catch (e) {\n      console.warn('持久化本地家庭缓存失败', e);\n    }\n    this.notifyListeners();\n  }\n\n  public subscribe(listener: FamilyChangeListener): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  private notifyListeners(): void {\n    for (const listener of this.listeners) {\n      try {\n        listener(this.currentFamily);\n      } catch (err) {\n        console.error('家庭状态订阅回调异常', err);\n      }\n    }\n  }\n\n  public getCurrentUser(): UserProfile {\n    return this.currentUser;\n  }\n\n  public getCurrentFamily(): FamilySpace | null {\n    return this.currentFamily;\n  }\n\n  public setMockCurrentUser(openid: string, nickName: string = '家人'): void {\n    this.currentUser.openid = openid;\n    this.currentUser.nickName = nickName;\n    this.currentUser.familyId = null;\n    this.currentUser.role = null;\n    this.currentFamily = null;\n    this.persist();\n  }\n\n  /**\n   * 静默登录与鉴权同步\n   */\n  public async syncUserAuth(): Promise<UserProfile> {\n    const res = await cloudService.callFunction('userAuth', {\n      mockOpenid: this.currentUser.openid,\n      nickName: this.currentUser.nickName,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.user) {\n      this.currentUser = {\n        openid: res.openid || this.currentUser.openid,\n        nickName: res.user.nickName || this.currentUser.nickName,\n        avatarUrl: res.user.avatarUrl || '',\n        familyId: res.user.familyId || null,\n        role: res.user.role || null,\n        createdAt: res.user.createdAt || Date.now(),\n        updatedAt: res.user.updatedAt || Date.now()\n      };\n      if (res.family) {\n        this.currentFamily = res.family;\n      } else if (!this.currentUser.familyId) {\n        // 若云端未关联家庭，但本地存在此前离线或降级创建的家庭，且当前用户是房主\n        if (this.currentFamily && (this.currentFamily.creatorOpenid === this.currentUser.openid || this.currentUser.role === 'creator')) {\n          // 自动向云端静默补全注册，确保云端具备该邀请码供家人加入\n          cloudService.callFunction('familyManage', {\n            action: 'createFamily',\n            _syncToCloud: true,\n            mockOpenid: this.currentUser.openid,\n            familyId: this.currentFamily.id || (this.currentFamily as any)._id,\n            name: this.currentFamily.name,\n            inviteCode: this.currentFamily.inviteCode,\n            inviteExpiredAt: this.currentFamily.inviteExpiredAt,\n            nickName: this.currentUser.nickName,\n            avatarUrl: this.currentUser.avatarUrl\n          }).then(syncRes => {\n            if (syncRes.success && syncRes.family) {\n              this.currentFamily = syncRes.family;\n              this.currentUser.familyId = syncRes.family.id || syncRes.family._id;\n              this.currentUser.role = 'creator';\n              this.persist();\n            }\n          }).catch(() => {});\n        } else {\n          this.currentFamily = null;\n        }\n      }\n      this.persist();\n    }\n\n    return this.currentUser;\n  }\n\n  /**\n   * 1. 创建家庭空间\n   */\n  public async createFamily(name = '温馨小家食堂', nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n    const callerNick = nickName || this.currentUser.nickName || '房主';\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'createFamily',\n      mockOpenid: this.currentUser.openid,\n      name,\n      nickName: callerNick,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.family) {\n      this.currentFamily = res.family;\n      if (res.openid) {\n        this.currentUser.openid = res.openid;\n      }\n      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n      this.currentUser.role = 'creator';\n      this.currentUser.nickName = callerNick;\n      this.persist();\n      return { success: true, family: res.family };\n    }\n\n    return { success: false, error: res.error || '创建家庭空间失败' };\n  }\n\n  /**\n   * 2. 口令加入家庭 (云端事务，上限 4 人，一人一家庭互斥)\n   */\n  public async joinFamily(inviteCode: string | number, nickName?: string): Promise<{ success: boolean; family?: FamilySpace; error?: string }> {\n    const code = cleanInviteCode(inviteCode);\n    if (!code || code.length !== 6) {\n      return { success: false, error: '请输入正确的6位数字邀请码' };\n    }\n\n    const callerNick = nickName || this.currentUser.nickName || '家人';\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'joinFamily',\n      mockOpenid: this.currentUser.openid,\n      inviteCode: code,\n      nickName: callerNick,\n      avatarUrl: this.currentUser.avatarUrl\n    });\n\n    if (res.success && res.family) {\n      this.currentFamily = res.family;\n      if (res.openid) {\n        this.currentUser.openid = res.openid;\n      }\n      this.currentUser.familyId = res.family.id || (res.family as any)._id;\n      this.currentUser.role = 'member';\n      this.currentUser.nickName = callerNick;\n      this.persist();\n      return { success: true, family: res.family };\n    }\n\n    return { success: false, error: res.error || '加入家庭空间失败' };\n  }\n\n  /**\n   * 3. 退出 / 解散家庭\n   */\n  public async leaveFamily(): Promise<{ success: boolean; error?: string }> {\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'leaveFamily',\n      mockOpenid: this.currentUser.openid\n    });\n\n    if (res.success) {\n      this.currentUser.familyId = null;\n      this.currentUser.role = null;\n      this.currentFamily = null;\n      this.persist();\n      return { success: true };\n    }\n\n    return { success: false, error: res.error || '退出家庭失败' };\n  }\n\n  /**\n   * 4. 刷新 24 小时动态口令\n   */\n  public async refreshInviteCode(): Promise<{ success: boolean; inviteCode?: string; error?: string }> {\n    if (!this.currentFamily) {\n      return { success: false, error: '尚未加入家庭' };\n    }\n\n    const res = await cloudService.callFunction('familyManage', {\n      action: 'refreshInviteCode',\n      mockOpenid: this.currentUser.openid,\n      familyId: this.currentFamily.id || (this.currentFamily as any)._id\n    });\n\n    if (res.success && res.inviteCode) {\n      this.currentFamily.inviteCode = res.inviteCode;\n      this.currentFamily.inviteExpiredAt = res.inviteExpiredAt;\n      this.persist();\n      return { success: true, inviteCode: res.inviteCode };\n    }\n\n    return { success: false, error: res.error || '刷新邀请码失败' };\n  }\n}\n\nexport const familyService = new FamilyService();\n","numLines":278,"startLine":1,"totalLines":278}}}
