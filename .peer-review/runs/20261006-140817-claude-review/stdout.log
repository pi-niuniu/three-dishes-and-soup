{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017dT3QFxZ7PJmnry9NcNmcC","type":"tool_result","content":"1\tconst cloud = require('wx-server-sdk');\n2\t\n3\tcloud.init({\n4\t  env: cloud.DYNAMIC_CURRENT_ENV\n5\t});\n6\t\n7\tconst db = cloud.database();\n8\t\n9\t/**\n10\t * userAuth 云函数：用户静默鉴权与档案获取\n11\t */\n12\texports.main = async (event, context) => {\n13\t  const wxContext = cloud.getWXContext();\n14\t  let openid = wxContext && wxContext.OPENID;\n15\t\n16\t  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n17\t  if (!openid) {\n18\t    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n19\t      openid = event.mockOpenid || 'mock_openid_default';\n20\t    } else {\n21\t      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n22\t    }\n23\t  }\n24\t\n25\t  const now = Date.now();\n26\t\n27\t  try {\n28\t    const userDocRef = db.collection('users').doc(`user_${openid}`);\n29\t    let user = null;\n30\t\n31\t    try {\n32\t      const res = await userDocRef.get();\n33\t      user = res.data;\n34\t    } catch (e) {\n35\t      // 用户首次访问，自动创建档案\n36\t      const userData = {\n37\t        openid,\n38\t        nickName: event.nickName || '家人',\n39\t        avatarUrl: event.avatarUrl || '',\n40\t        familyId: null,\n41\t        role: null,\n42\t        createdAt: now,\n43\t        updatedAt: now\n44\t      };\n45\t      await userDocRef.set({ data: userData });\n46\t      user = { _id: `user_${openid}`, ...userData };\n47\t    }\n48\t\n49\t    // 更新昵称/头像\n50\t    if (event.nickName || event.avatarUrl) {\n51\t      const updateData = { updatedAt: now };\n52\t      if (event.nickName) updateData.nickName = event.nickName;\n53\t      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n54\t      await userDocRef.update({ data: updateData });\n55\t      user = { ...user, ...updateData };\n56\t    }\n57\t\n58\t    // 若绑定了家庭，获取家庭最新信息\n59\t    let family = null;\n60\t    if (user.familyId) {\n61\t      try {\n62\t        const famRes = await db.collection('families').doc(user.familyId).get();\n63\t        if (famRes && famRes.data) {\n64\t          family = {\n65\t            id: famRes.data._id || user.familyId,\n66\t            _id: famRes.data._id || user.familyId,\n67\t            ...famRes.data\n68\t          };\n69\t        }\n70\t      } catch (err) {\n71\t        console.warn('获取用户所属家庭失败或家庭已解散', err);\n72\t        // 如果家庭已被解散，重置用户的 familyId\n73\t        await userDocRef.update({\n74\t          data: { familyId: null, role: null, updatedAt: now }\n75\t        });\n76\t        user.familyId = null;\n77\t        user.role = null;\n78\t      }\n79\t    }\n80\t\n81\t    return {\n82\t      success: true,\n83\t      openid,\n84\t      user,\n85\t      family\n86\t    };\n87\t  } catch (err) {\n88\t    return {\n89\t      success: false,\n90\t      error: err.message || '用户鉴权失败'\n91\t    };\n92\t  }\n93\t};\n94\t"}]},"parent_tool_use_id":null,"session_id":"baef6729-a90b-47cf-88f2-f3c7ba7b69e3","uuid":"388c73d2-40fa-4b0f-b82e-7a3ab72ebc10","timestamp":"2026-10-06T06:09:04.146Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/cloudfunctions/userAuth/index.js","content":"const cloud = require('wx-server-sdk');\n\ncloud.init({\n  env: cloud.DYNAMIC_CURRENT_ENV\n});\n\nconst db = cloud.database();\n\n/**\n * userAuth 云函数：用户静默鉴权与档案获取\n */\nexports.main = async (event, context) => {\n  const wxContext = cloud.getWXContext();\n  let openid = wxContext && wxContext.OPENID;\n\n  // 生产环境中如果拿不到 wxContext.OPENID 直接报错拒绝，杜绝伪造\n  if (!openid) {\n    if (process.env.NODE_ENV === 'test' || event._testMock || process.env.IS_LOCAL_TEST) {\n      openid = event.mockOpenid || 'mock_openid_default';\n    } else {\n      return { success: false, error: '未获取到微信用户有效身份凭据 (OPENID 缺失)' };\n    }\n  }\n\n  const now = Date.now();\n\n  try {\n    const userDocRef = db.collection('users').doc(`user_${openid}`);\n    let user = null;\n\n    try {\n      const res = await userDocRef.get();\n      user = res.data;\n    } catch (e) {\n      // 用户首次访问，自动创建档案\n      const userData = {\n        openid,\n        nickName: event.nickName || '家人',\n        avatarUrl: event.avatarUrl || '',\n        familyId: null,\n        role: null,\n        createdAt: now,\n        updatedAt: now\n      };\n      await userDocRef.set({ data: userData });\n      user = { _id: `user_${openid}`, ...userData };\n    }\n\n    // 更新昵称/头像\n    if (event.nickName || event.avatarUrl) {\n      const updateData = { updatedAt: now };\n      if (event.nickName) updateData.nickName = event.nickName;\n      if (event.avatarUrl) updateData.avatarUrl = event.avatarUrl;\n      await userDocRef.update({ data: updateData });\n      user = { ...user, ...updateData };\n    }\n\n    // 若绑定了家庭，获取家庭最新信息\n    let family = null;\n    if (user.familyId) {\n      try {\n        const famRes = await db.collection('families').doc(user.familyId).get();\n        if (famRes && famRes.data) {\n          family = {\n            id: famRes.data._id || user.familyId,\n            _id: famRes.data._id || user.familyId,\n            ...famRes.data\n          };\n        }\n      } catch (err) {\n        console.warn('获取用户所属家庭失败或家庭已解散', err);\n        // 如果家庭已被解散，重置用户的 familyId\n        await userDocRef.update({\n          data: { familyId: null, role: null, updatedAt: now }\n        });\n        user.familyId = null;\n        user.role = null;\n      }\n    }\n\n    return {\n      success: true,\n      openid,\n      user,\n      family\n    };\n  } catch (err) {\n    return {\n      success: false,\n      error: err.message || '用户鉴权失败'\n    };\n  }\n};\n","numLines":94,"startLine":1,"totalLines":94}}}
