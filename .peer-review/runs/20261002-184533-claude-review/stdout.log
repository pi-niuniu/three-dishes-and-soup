{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012MeiFC2g3RnhAshm6Gfrah","type":"tool_result","content":"1\timport type { MealHistoryRecord, MealMode } from '../types/user.js';\n2\timport type { Dish } from '../types/dish.js';\n3\t\n4\tconst STORAGE_KEY = 'meal_history_records';\n5\t\n6\tclass HistoryService {\n7\t  private memoryHistory: MealHistoryRecord[] = [];\n8\t\n9\t  /**\n10\t   * 获取最近的就餐历史 (默认 30 天)\n11\t   */\n12\t  public getHistory(): MealHistoryRecord[] {\n13\t    try {\n14\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n15\t        const stored = wx.getStorageSync(STORAGE_KEY);\n16\t        if (stored && Array.isArray(stored)) {\n17\t          return stored;\n18\t        }\n19\t      }\n20\t    } catch (e) {\n21\t      console.warn('读取本地历史失败，使用内存降级', e);\n22\t    }\n23\t    return this.memoryHistory;\n24\t  }\n25\t\n26\t  /**\n27\t   * 确认开饭：将菜单正式写入历史记录 (防重门禁)\n28\t   */\n29\t  public recordMeal(mode: MealMode, dishes: Dish[], dateStr?: string, menuId?: string): MealHistoryRecord {\n30\t    const history = this.getHistory();\n31\t    const now = new Date();\n32\t    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n33\t    const targetDate = dateStr || localDate;\n34\t    const recordId = menuId ? `hist_${menuId}` : `hist_${Date.now()}`;\n35\t\n36\t    const newRecord: MealHistoryRecord = {\n37\t      id: recordId,\n38\t      menuId,\n39\t      date: targetDate,\n40\t      timestamp: Date.now(),\n41\t      mode,\n42\t      dishIds: dishes.map(d => d.id),\n43\t      dishNames: dishes.map(d => d.name)\n44\t    };\n45\t\n46\t    // 如果当前菜单已记录过（如反复进出结果页与交付中心），就地更新防止历史列表堆积重复记录\n47\t    const existingIndex = history.findIndex(r => r.id === recordId || (r.date === targetDate && r.dishNames.join(',') === newRecord.dishNames.join(',')));\n48\t    let updated: MealHistoryRecord[];\n49\t    if (existingIndex >= 0) {\n50\t      updated = [...history];\n51\t      updated[existingIndex] = newRecord;\n52\t    } else {\n53\t      updated = [newRecord, ...history].slice(0, 60);\n54\t    }\n55\t\n56\t    this.saveHistory(updated);\n57\t    return newRecord;\n58\t  }\n59\t\n60\t  /**\n61\t   * 清空或重置历史 (用于测试或用户重置)\n62\t   */\n63\t  public clearHistory(): void {\n64\t    this.saveHistory([]);\n65\t  }\n66\t\n67\t  private saveHistory(records: MealHistoryRecord[]): void {\n68\t    this.memoryHistory = records;\n69\t    try {\n70\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n71\t        wx.setStorageSync(STORAGE_KEY, records);\n72\t      }\n73\t    } catch (e) {\n74\t      console.warn('保存本地历史失败', e);\n75\t    }\n76\t  }\n77\t}\n78\t\n79\texport const historyService = new HistoryService();\n80\t"}]},"parent_tool_use_id":null,"session_id":"bbd1474c-773c-4640-b863-6a85e2236161","uuid":"8a805839-5f8b-4c6b-9022-c9bf10b33561","timestamp":"2026-10-02T10:45:46.215Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/historyService.ts","content":"import type { MealHistoryRecord, MealMode } from '../types/user.js';\nimport type { Dish } from '../types/dish.js';\n\nconst STORAGE_KEY = 'meal_history_records';\n\nclass HistoryService {\n  private memoryHistory: MealHistoryRecord[] = [];\n\n  /**\n   * 获取最近的就餐历史 (默认 30 天)\n   */\n  public getHistory(): MealHistoryRecord[] {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(STORAGE_KEY);\n        if (stored && Array.isArray(stored)) {\n          return stored;\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地历史失败，使用内存降级', e);\n    }\n    return this.memoryHistory;\n  }\n\n  /**\n   * 确认开饭：将菜单正式写入历史记录 (防重门禁)\n   */\n  public recordMeal(mode: MealMode, dishes: Dish[], dateStr?: string, menuId?: string): MealHistoryRecord {\n    const history = this.getHistory();\n    const now = new Date();\n    const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;\n    const targetDate = dateStr || localDate;\n    const recordId = menuId ? `hist_${menuId}` : `hist_${Date.now()}`;\n\n    const newRecord: MealHistoryRecord = {\n      id: recordId,\n      menuId,\n      date: targetDate,\n      timestamp: Date.now(),\n      mode,\n      dishIds: dishes.map(d => d.id),\n      dishNames: dishes.map(d => d.name)\n    };\n\n    // 如果当前菜单已记录过（如反复进出结果页与交付中心），就地更新防止历史列表堆积重复记录\n    const existingIndex = history.findIndex(r => r.id === recordId || (r.date === targetDate && r.dishNames.join(',') === newRecord.dishNames.join(',')));\n    let updated: MealHistoryRecord[];\n    if (existingIndex >= 0) {\n      updated = [...history];\n      updated[existingIndex] = newRecord;\n    } else {\n      updated = [newRecord, ...history].slice(0, 60);\n    }\n\n    this.saveHistory(updated);\n    return newRecord;\n  }\n\n  /**\n   * 清空或重置历史 (用于测试或用户重置)\n   */\n  public clearHistory(): void {\n    this.saveHistory([]);\n  }\n\n  private saveHistory(records: MealHistoryRecord[]): void {\n    this.memoryHistory = records;\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(STORAGE_KEY, records);\n      }\n    } catch (e) {\n      console.warn('保存本地历史失败', e);\n    }\n  }\n}\n\nexport const historyService = new HistoryService();\n","numLines":80,"startLine":1,"totalLines":80}}}
