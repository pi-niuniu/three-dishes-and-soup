{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D2Snk7gvgH5A1b4DbybPXo","type":"tool_result","content":"1\timport type { UserPreferences } from '../types/user.js';\n2\t\n3\tconst PREF_STORAGE_KEY = 'user_diet_preferences';\n4\t\n5\tconst DEFAULT_PREFERENCES: UserPreferences = {\n6\t  peopleCount: 2,\n7\t  defaultMode: 'hearty_3_1',\n8\t  spicyLevel: 1, // 默认微辣\n9\t  dislikedIngredients: [],\n10\t  favoriteDishIds: [],\n11\t  blockedDishIds: [],\n12\t  region: '川渝'\n13\t};\n14\t\n15\tclass PreferenceService {\n16\t  private memoryPref: UserPreferences = { ...DEFAULT_PREFERENCES };\n17\t\n18\t  public getPreferences(): UserPreferences {\n19\t    try {\n20\t      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n21\t        const stored = wx.getStorageSync(PREF_STORAGE_KEY);\n22\t        if (stored) {\n23\t          return { ...DEFAULT_PREFERENCES, ...stored };\n24\t        }\n25\t      }\n26\t    } catch (e) {\n27\t      console.warn('读取本地偏好失败，使用内存降级', e);\n28\t    }\n29\t    return this.memoryPref;\n30\t  }\n31\t\n32\t  public savePreferences(pref: Partial<UserPreferences>): UserPreferences {\n33\t    const current = this.getPreferences();\n34\t    const updated = { ...current, ...pref };\n35\t    this.memoryPref = updated;\n36\t    try {\n37\t      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n38\t        wx.setStorageSync(PREF_STORAGE_KEY, updated);\n39\t      }\n40\t    } catch (e) {\n41\t      console.warn('保存偏好失败', e);\n42\t    }\n43\t    return updated;\n44\t  }\n45\t\n46\t  public toggleFavorite(dishId: string): boolean {\n47\t    const pref = this.getPreferences();\n48\t    const favs = new Set(pref.favoriteDishIds || []);\n49\t    let isFav = false;\n50\t    if (favs.has(dishId)) {\n51\t      favs.delete(dishId);\n52\t      isFav = false;\n53\t    } else {\n54\t      favs.add(dishId);\n55\t      isFav = true;\n56\t    }\n57\t    this.savePreferences({ favoriteDishIds: Array.from(favs) });\n58\t    return isFav;\n59\t  }\n60\t}\n61\t\n62\texport const preferenceService = new PreferenceService();\n63\t"}]},"parent_tool_use_id":null,"session_id":"bbd1474c-773c-4640-b863-6a85e2236161","uuid":"5709ebe1-f50e-4ec8-b321-3db36eda0a61","timestamp":"2026-10-02T10:45:52.708Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/zhuangxiji/Desktop/CC/一日三餐/miniprogram/services/preferenceService.ts","content":"import type { UserPreferences } from '../types/user.js';\n\nconst PREF_STORAGE_KEY = 'user_diet_preferences';\n\nconst DEFAULT_PREFERENCES: UserPreferences = {\n  peopleCount: 2,\n  defaultMode: 'hearty_3_1',\n  spicyLevel: 1, // 默认微辣\n  dislikedIngredients: [],\n  favoriteDishIds: [],\n  blockedDishIds: [],\n  region: '川渝'\n};\n\nclass PreferenceService {\n  private memoryPref: UserPreferences = { ...DEFAULT_PREFERENCES };\n\n  public getPreferences(): UserPreferences {\n    try {\n      if (typeof wx !== 'undefined' && wx.getStorageSync) {\n        const stored = wx.getStorageSync(PREF_STORAGE_KEY);\n        if (stored) {\n          return { ...DEFAULT_PREFERENCES, ...stored };\n        }\n      }\n    } catch (e) {\n      console.warn('读取本地偏好失败，使用内存降级', e);\n    }\n    return this.memoryPref;\n  }\n\n  public savePreferences(pref: Partial<UserPreferences>): UserPreferences {\n    const current = this.getPreferences();\n    const updated = { ...current, ...pref };\n    this.memoryPref = updated;\n    try {\n      if (typeof wx !== 'undefined' && wx.setStorageSync) {\n        wx.setStorageSync(PREF_STORAGE_KEY, updated);\n      }\n    } catch (e) {\n      console.warn('保存偏好失败', e);\n    }\n    return updated;\n  }\n\n  public toggleFavorite(dishId: string): boolean {\n    const pref = this.getPreferences();\n    const favs = new Set(pref.favoriteDishIds || []);\n    let isFav = false;\n    if (favs.has(dishId)) {\n      favs.delete(dishId);\n      isFav = false;\n    } else {\n      favs.add(dishId);\n      isFav = true;\n    }\n    this.savePreferences({ favoriteDishIds: Array.from(favs) });\n    return isFav;\n  }\n}\n\nexport const preferenceService = new PreferenceService();\n","numLines":63,"startLine":1,"totalLines":63}}}
